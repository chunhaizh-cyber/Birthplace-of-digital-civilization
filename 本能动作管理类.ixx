// 功能：执行任务、方法或动作的主体逻辑。
const 语素入口节点类* 本能动作执行缺口类型_按码(std::int64_t 运行码) noexcept
{
    switch (运行码) {
    case 本能动作运行结果_成功:
        return 本能动作无执行缺口词();
    case 本能动作错误_方法首节点缺失:
    case 本能动作错误_方法节点类型错误:
        return 本能动作执行缺口_当前方法缺失词();
    case 本能动作错误_未注册:
    case 本能动作错误_缺动作入口:
    case 本能动作错误_动作入口不归本类执行:
        return 本能动作执行缺口_当前方法无执行入口词();
    case 本能动作错误_输入参数场景缺失:
        return 本能动作执行缺口_可执行输入参数场景缺失词();
    case 本能动作错误_输入参数不满足:
    case 本能方法结果_任务缺条件需自我线程:
        return 本能动作执行缺口_当前方法条件不满足词();
    case 本能动作错误_执行失败:
    case 本能动作错误_动作异常:
    case 本能动作错误_动作未知异常:
        return 本能动作执行缺口_当前方法执行失败词();
    default:
        return 运行码 < 0 ? 本能动作执行缺口_当前方法执行失败词() : 本能动作无执行缺口词();
    }
}

// 功能：按函数名执行对应处理。
const 语素入口节点类* 本能动作后续承接方式_按码(std::int64_t 运行码) noexcept
{
    switch (运行码) {
    case 本能动作运行结果_成功:
        return 本能动作承接_无缺口词();
    case 本能动作错误_方法首节点缺失:
    case 本能动作错误_方法节点类型错误:
    case 本能动作错误_未注册:
    case 本能动作错误_缺动作入口:
    case 本能动作错误_动作入口不归本类执行:
    case 本能动作错误_输入参数场景缺失:
    case 本能动作错误_输入参数不满足:
    case 本能方法结果_任务缺条件需自我线程:
        return 本能动作承接_重筹办词();
    default:
        return 运行码 < 0 ? 本能动作承接_异常处理词() : 本能动作承接_无缺口词();
    }
}

// 功能：执行对应模块、线程或方法的运行逻辑。
inline const char* 本能动作运行结果语义_按码(std::int64_t 运行码) noexcept
{
    switch (运行码) {
    case 本能动作运行结果_成功: return "运行成功";
    case 本能动作错误_未注册: return "本能动作未注册";
    case 本能动作错误_执行失败: return "执行失败";
    case 本能动作错误_动作异常: return "执行异常";
    case 本能动作错误_动作未知异常: return "执行未知异常";
    case 本能动作错误_方法首节点缺失: return "方法首节点缺失";
    case 本能动作错误_方法节点类型错误: return "方法节点类型错误";
    case 本能动作错误_缺动作入口: return "动作入口缺失";
    case 本能动作错误_动作入口不归本类执行: return "动作入口不归本类执行";
    case 本能动作错误_输入参数场景缺失: return "输入参数场景缺失";
    case 本能动作错误_输入参数不满足: return "输入参数不满足";
    case 本能方法结果_任务筹办已建立方法头待重入: return "任务筹办待重入";
    case 本能方法结果_任务缺条件需自我线程: return "任务缺条件";
    default: return 运行码 < 0 ? "运行失败" : "运行成功";
    }
}

基础信息节点类* 本能动作运行结果宿主(
    方法类::节点类* 方法首节点,
    场景节点类* 输出结果场景,
    时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
{
    if (方法类::方法是首节点(方法首节点)) {
        if (auto* 方法虚拟存在 = 方法类::方法虚拟存在只读(方法首节点)) {
            return reinterpret_cast<基础信息节点类*>(方法虚拟存在);
        }
        if (auto* 方法虚拟存在 = 方法虚拟存在服务类::取或创建方法虚拟存在(方法首节点, nullptr, now)) {
            return reinterpret_cast<基础信息节点类*>(方法虚拟存在);
        }
    }
    if (auto* 自我存在 = 世界树.取或创建自我存在()) {
        if (auto* 自我内部世界 = 世界树.取或创建存在内部世界(自我存在)) {
            return reinterpret_cast<基础信息节点类*>(自我内部世界);
        }
    }
    if (!世界树.虚拟世界) {
        世界树.初始化默认世界();
    }
    return reinterpret_cast<基础信息节点类*>(世界树.虚拟世界);
}

void 写入本能动作运行场景事实(
    存在节点类* 运行结果存在,
    场景节点类* 输入参数场景,
    场景节点类* 输出结果场景,
    时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
{
    auto* 宿主 = reinterpret_cast<基础信息节点类*>(运行结果存在);
    if (!宿主) {
        return;
    }
    if (输入参数场景) {
        (void)世界树.写入特征_指针(
            宿主,
            本能动作输入参数场景特征词(),
            输入参数场景,
            now);
    }
    if (输出结果场景) {
        (void)世界树.写入特征_指针(
            宿主,
            本能动作输出结果场景特征词(),
            输出结果场景,
            now);
    }
}

存在节点类* 创建本能动作运行结果实例(
    方法类::节点类* 方法首节点,
    场景节点类* 输出结果场景,
    const char* 语义,
    std::int64_t 运行码,
    时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
{
    auto* 宿主 = 本能动作运行结果宿主(方法首节点, 输出结果场景, now);
    if (!宿主) {
        return nullptr;
    }
    auto* 运行存在 = 世界树.取或创建子存在_按类型并按特征I64(
        宿主,
        本能动作运行虚拟存在类型词(),
        本能动作运行开始时间特征词(),
        static_cast<I64>(now));
    if (!运行存在) {
        return nullptr;
    }
    (void)世界树.写入特征_I64(
        reinterpret_cast<基础信息节点类*>(运行存在),
        本能动作运行结果码特征词(),
        static_cast<I64>(运行码),
        now);
    const auto* 方法执行情况 = 运行码 == 本能动作运行结果_成功
        ? 本能动作执行成功词()
        : 本能动作运行结果语义词(语义);
    (void)世界树.写入特征_指针(
        reinterpret_cast<基础信息节点类*>(运行存在),
        本能动作方法执行情况特征词(),
        方法执行情况,
        now);
    if (auto* 执行缺口类型 = 本能动作执行缺口类型_按码(运行码)) {
        (void)世界树.写入特征_指针(
            reinterpret_cast<基础信息节点类*>(运行存在),
            本能动作执行缺口类型特征词(),
            执行缺口类型,
            now);
        if (执行缺口类型 != 本能动作无执行缺口词()) {
            (void)世界树.写入特征_指针(
                reinterpret_cast<基础信息节点类*>(运行存在),
                本能动作失败原因特征词(),
                执行缺口类型,
                now);
        }
    }
    if (auto* 承接方式 = 本能动作后续承接方式_按码(运行码)) {
        (void)世界树.写入特征_指针(
            reinterpret_cast<基础信息节点类*>(运行存在),
            本能动作后续承接方式特征词(),
            承接方式,
            now);
    }
    写入本能动作运行场景事实(运行存在, nullptr, 输出结果场景, now);
    return 运行存在;
}

存在节点类* 创建本能动作运行结果实例_按码(
    方法类::节点类* 方法首节点,
    场景节点类* 输出结果场景,
    std::int64_t 运行码,
    时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
{
    return 创建本能动作运行结果实例(
        方法首节点,
        输出结果场景,
        本能动作运行结果语义_按码(运行码),
        运行码,
        now);
}

struct 结构_本能方法运行闭环视图 {
    bool 运行存在有效 = false;
    bool 方法执行情况已读 = false;
    bool 方法执行成功 = false;
    bool 方法执行失败 = false;
    bool 调试运行码已读 = false;
    std::int64_t 调试运行码 = 本能动作运行结果_未知;
    const 语素入口节点类* 方法执行情况 = nullptr;
    const 语素入口节点类* 失败原因 = nullptr;
    const 语素入口节点类* 执行缺口类型 = nullptr;
    const 语素入口节点类* 后续承接方式 = nullptr;
    场景节点类* 输入参数场景 = nullptr;
    场景节点类* 输出结果场景 = nullptr;

    // 功能：执行任务、方法或动作的主体逻辑。
    bool 有执行缺口() const noexcept
    {
        return 执行缺口类型 && 执行缺口类型 != 本能动作无执行缺口词();
    }

};

// 功能：执行任务、方法或动作的主体逻辑。
inline bool 本能动作语素入口是执行缺口(const 语素入口节点类* 词) noexcept
{
    if (!词) return false;
    const auto 主键 = 词->获取主键();
    return 主键.rfind("执行缺口_", 0) == 0;
}

// 功能：按函数名执行对应处理。
inline std::string 本能动作基础节点指针文本(const 基础信息节点类* 节点)
{
    return 节点
        ? std::to_string(reinterpret_cast<std::uintptr_t>(节点))
        : std::string("空");
}

// 功能：按函数名执行对应处理。
inline bool 本能动作基础节点属于当前世界树(const 基础信息节点类* 节点) noexcept
{
    if (!节点) return false;
    const auto* 根节点 = 世界树.世界根();
    if (节点 == 根节点) return true;
    return 世界树.基础节点属于当前世界树(节点);
}

// 功能：记录日志、动态、证据或运行痕迹。
inline void 本能动作记录无效闭环宿主(
    const char* 阶段,
    const 基础信息节点类* 宿主) noexcept
{
    std::ostringstream 输出;
    输出 << "本能动作管理/闭环视图无效基础宿主"
        << " | 阶段=" << (阶段 ? 阶段 : "未定义")
        << " | 宿主指针=" << 本能动作基础节点指针文本(宿主)
        << " | 处理=拒绝读取闭环指针事实";
    项目运行错误日志(输出.str());
}

// 功能：按函数名执行对应处理。
inline bool 本能动作读指针特征(
    const 基础信息节点类* 宿主,
    const 语素入口节点类* 特征类型,
    void*& 输出指针) noexcept
{
    输出指针 = nullptr;
    return 宿主
        && 特征类型
        && 世界树.读取特征_指针(宿主, 特征类型, 输出指针)
        && 输出指针;
}

// 功能：按函数名执行对应处理。
inline void 本能动作补读闭环指针事实(
    const 基础信息节点类* 宿主,
    结构_本能方法运行闭环视图& 视图) noexcept
{
    if (!宿主) return;
    if (!本能动作基础节点属于当前世界树(宿主)) {
        本能动作记录无效闭环宿主("补读闭环指针事实", 宿主);
        return;
    }
    void* 指针 = nullptr;
    if (!视图.方法执行情况
        && 本能动作读指针特征(宿主, 本能动作方法执行情况特征词(), 指针)) {
        视图.方法执行情况 = reinterpret_cast<const 语素入口节点类*>(指针);
        视图.方法执行情况已读 = true;
    }
    if (!视图.失败原因
        && 本能动作读指针特征(宿主, 本能动作失败原因特征词(), 指针)) {
        视图.失败原因 = reinterpret_cast<const 语素入口节点类*>(指针);
    }
    if (!视图.执行缺口类型
        && 本能动作读指针特征(宿主, 本能动作执行缺口类型特征词(), 指针)) {
        视图.执行缺口类型 = reinterpret_cast<const 语素入口节点类*>(指针);
    }
    if (!视图.后续承接方式
        && 本能动作读指针特征(宿主, 本能动作后续承接方式特征词(), 指针)) {
        视图.后续承接方式 = reinterpret_cast<const 语素入口节点类*>(指针);
    }
    if (!视图.输入参数场景
        && 本能动作读指针特征(宿主, 本能动作输入参数场景特征词(), 指针)) {
        视图.输入参数场景 = reinterpret_cast<场景节点类*>(指针);
    }
    if (!视图.输入参数场景
        && 本能动作读指针特征(宿主, 本能动作返回参数信息特征词(), 指针)) {
        视图.输入参数场景 = reinterpret_cast<场景节点类*>(指针);
    }
    if (!视图.输出结果场景
        && 本能动作读指针特征(宿主, 本能动作输出结果场景特征词(), 指针)) {
        视图.输出结果场景 = reinterpret_cast<场景节点类*>(指针);
    }
    if (!视图.输出结果场景
        && 本能动作读指针特征(宿主, 本能动作返回场景信息特征词(), 指针)) {
        视图.输出结果场景 = reinterpret_cast<场景节点类*>(指针);
    }
}

结构_本能方法运行闭环视图 读取本能方法运行闭环视图(
    const 存在节点类* 运行结果存在,
    const 场景节点类* 显式输出结果场景 = nullptr) noexcept
{
    结构_本能方法运行闭环视图 视图{};
    视图.运行存在有效 = 运行结果存在 != nullptr;
    if (显式输出结果场景) {
        视图.输出结果场景 = const_cast<场景节点类*>(显式输出结果场景);
    }
    if (!运行结果存在) {
        return 视图;
    }

    auto* 运行宿主 = reinterpret_cast<const 基础信息节点类*>(运行结果存在);
    I64 运行码 = 本能动作运行结果_未知;
    if (世界树.读取特征_I64(
            运行宿主,
            本能动作运行结果码特征词(),
            运行码)
        || 世界树.读取特征_I64(运行结果存在, 运行码)) {
        视图.调试运行码已读 = true;
        视图.调试运行码 = static_cast<std::int64_t>(运行码);
    }

    本能动作补读闭环指针事实(运行宿主, 视图);
    if (视图.输出结果场景) {
        本能动作补读闭环指针事实(
            reinterpret_cast<const 基础信息节点类*>(视图.输出结果场景),
            视图);
    }

    if (!视图.执行缺口类型 && 本能动作语素入口是执行缺口(视图.失败原因)) {
        视图.执行缺口类型 = 视图.失败原因;
    }
    if (!视图.执行缺口类型 && 视图.调试运行码已读) {
        视图.执行缺口类型 = 本能动作执行缺口类型_按码(视图.调试运行码);
    }
    if (!视图.后续承接方式 && 视图.调试运行码已读) {
        视图.后续承接方式 = 本能动作后续承接方式_按码(视图.调试运行码);
    }

    视图.方法执行成功 =
        语素入口同一(视图.方法执行情况, 本能动作执行成功词())
        || (!视图.方法执行情况已读
            && 视图.调试运行码已读
            && 视图.调试运行码 == 本能动作运行结果_成功);
    视图.方法执行失败 =
        视图.方法执行情况已读
        && !视图.方法执行成功;
    return 视图;
}

// 功能：执行对应模块、线程或方法的运行逻辑。
std::int64_t 本能动作运行结果值(const 存在节点类* 运行结果存在) noexcept
{
    if (!运行结果存在) {
        return 本能动作运行结果_未知;
    }
    I64 输出值 = 本能动作运行结果_未知;
    if (世界树.读取特征_I64(
            reinterpret_cast<const 基础信息节点类*>(运行结果存在),
            本能动作运行结果码特征词(),
            输出值)) {
        return static_cast<std::int64_t>(输出值);
    }
    if (世界树.读取特征_I64(运行结果存在, 输出值)) {
        return static_cast<std::int64_t>(输出值);
    }

    void* 执行情况 = nullptr;
    if (世界树.读取特征_指针(
            reinterpret_cast<const 基础信息节点类*>(运行结果存在),
            本能动作方法执行情况特征词(),
            执行情况)) {
        return 执行情况 == 本能动作执行成功词()
            ? 本能动作运行结果_成功
            : 本能动作运行结果_未知;
    }
    return 本能动作运行结果_未知;
}

// 功能：执行对应模块、线程或方法的运行逻辑。
bool 本能动作运行成功(const 存在节点类* 运行结果存在) noexcept
{
    const auto 视图 = 读取本能方法运行闭环视图(运行结果存在);
    return 视图.方法执行成功 && !视图.有执行缺口();
}

using 本能动作函数 = std::function<存在节点类*(
    方法类::节点类* 方法首节点,
    场景节点类* 输入参数场景,
    场景节点类* 输出结果场景)>;
using 本能函数 = 本能动作函数;

struct 结构体_本能动作登记信息 {
    本能动作函数 动作函数{};
    方法类::节点类* 方法信息首节点 = nullptr;
};

class 本能动作管理类 {
public:
    bool 注册(
        枚举_本能动作ID 动作ID,
        本能动作函数 动作函数,
        方法类::节点类* 方法首节点 = nullptr)
    {
        if (动作ID == 枚举_本能动作ID::未定义) return false;
        if (!本能方法类::是有效本能方法能力值(static_cast<I64>(动作ID))) return false;
        if (!动作函数) return false;

        结构体_本能动作登记信息 登记信息{};
        登记信息.动作函数 = std::move(动作函数);
        登记信息.方法信息首节点 = 方法首节点;

        std::lock_guard 锁(mu_);
        表_[动作ID] = std::move(登记信息);
        return true;
    }

    // 功能：按函数名执行对应处理。
    bool 有(枚举_本能动作ID 动作ID) const
    {
        std::lock_guard 锁(mu_);
        return 表_.find(动作ID) != 表_.end();
    }

    // 功能：按函数名执行对应处理。
    std::optional<结构体_本能动作登记信息> 查询(枚举_本能动作ID 动作ID) const
    {
        std::lock_guard 锁(mu_);
        const auto it = 表_.find(动作ID);
        if (it == 表_.end()) return std::nullopt;
        return it->second;
    }

    // 功能：注册方法、模板、对象或运行入口。
    std::vector<枚举_本能动作ID> 枚举已注册ID() const
    {
        std::vector<枚举_本能动作ID> 输出{};
        std::lock_guard 锁(mu_);
        输出.reserve(表_.size());
        for (const auto& [动作ID, _] : 表_) {
            输出.push_back(动作ID);
        }
        std::sort(输出.begin(), 输出.end(), [](const auto 左, const auto 右) {
            return static_cast<std::uint32_t>(左) < static_cast<std::uint32_t>(右);
        });
        return 输出;
    }

    存在节点类* 检查是否可调用(
        枚举_本能动作ID 动作ID,
        方法类::节点类* 方法首节点,
        场景节点类* 输入参数场景,
        场景节点类* 输出结果场景 = nullptr) const noexcept
    {
        auto 设置结果 = [&](std::int64_t 运行码) {
            return 创建本能动作运行结果实例_按码(
                方法首节点,
                输出结果场景,
                运行码);
        };

        if (动作ID == 枚举_本能动作ID::未定义) {
            return 设置结果(本能动作错误_未注册);
        }

        const auto 已注册动作 = 查询(动作ID);
        if (!已注册动作.has_value() || !已注册动作->动作函数) {
            return 设置结果(本能动作错误_未注册);
        }

        auto* 方法 = 方法首节点 ? 方法首节点 : 已注册动作->方法信息首节点;
        if (!方法) {
            return 设置结果(本能动作错误_方法首节点缺失);
        }
        if (!方法类::方法是首节点(方法)) {
            return 设置结果(本能动作错误_方法节点类型错误);
        }

        if (!方法类::方法有动作(方法)) {
            return 设置结果(本能动作错误_缺动作入口);
        }

        const auto 动作句柄 = 方法类::方法动作句柄(方法);
        if (动作句柄.有效()) {
            if (动作句柄.类型 != 枚举_动作句柄类型::本能函数ID) {
                return 设置结果(本能动作错误_动作入口不归本类执行);
            }
            if (动作句柄.本能ID == 0 || static_cast<枚举_本能动作ID>(动作句柄.本能ID) != 动作ID) {
                return 设置结果(本能动作错误_缺动作入口);
            }
        }
        else {
            return 设置结果(本能动作错误_缺动作入口);
        }

        场景节点类* 条件场景 = nullptr;
        bool 有条件判定索引 = false;
        if (auto* 条件节点信息 = 方法->主信息.取条件节点信息()) {
            条件场景 = 条件节点信息->条件场景.指针;
            有条件判定索引 = !条件节点信息->条件判定索引.empty();
        }
        auto 子节点数 = [](const 基础信息节点类* 父) noexcept -> std::size_t {
            return 世界树.获取子节点(父).size();
        };
        auto 节点主键 = [](const 基础信息节点类* 节点) -> std::string {
            return 节点 ? 节点->获取主键() : std::string("空");
        };
        auto 节点类型主键 = [](const 基础信息节点类* 节点) -> std::string {
            const auto* 类型 = 节点 && 节点->主信息 ? 节点->主信息->类型 : nullptr;
            return 类型 ? 类型->获取主键() : std::string("空");
        };
        auto 需要动作调用诊断 = [&]() noexcept {
            return 动作ID == 枚举_本能动作ID::提交_当前观察范围可观测单位存在对应事实
                || 动作ID == 枚举_本能动作ID::自我_观察单个空间候选并组合存在假设;
        };
        auto 记录动作检查失败 = [&](
            const char* 原因,
            const 本能动作类::结构体_场景模式匹配结果* 匹配 = nullptr) noexcept {
            if (!需要动作调用诊断()) {
                return;
            }
            const auto* 输入基础 = reinterpret_cast<const 基础信息节点类*>(输入参数场景);
            const auto* 条件基础 = reinterpret_cast<const 基础信息节点类*>(条件场景);
            const 基础信息节点类* 首个未满足 = nullptr;
            if (匹配 && !匹配->未满足模式节点.empty()) {
                首个未满足 = 匹配->未满足模式节点.front();
            }
            std::ostringstream 日志;
            日志 << "本能动作管理/动作检查失败诊断"
                << " | 原因=" << (原因 ? 原因 : "未知")
                << " | 本能ID=" << static_cast<std::uint32_t>(动作ID)
                << " | 方法=" << (方法 ? 方法->获取主键() : std::string("空"))
                << " | 输入场景=" << 节点主键(输入基础)
                << " | 条件场景=" << 节点主键(条件基础)
                << " | 输入子节点数=" << 子节点数(输入基础)
                << " | 条件子节点数=" << 子节点数(条件基础)
                << " | 未满足模式节点数=" << (匹配 ? 匹配->未满足模式节点.size() : 0)
                << " | 首个未满足模式节点=" << 节点主键(首个未满足)
                << " | 首个未满足类型=" << 节点类型主键(首个未满足)
                << " | 只诊断不改变判定=1";
            项目运行日志(日志.str());
        };
        const bool 需要输入参数 = 条件场景 || 有条件判定索引;
        if (!需要输入参数) {
            return 创建本能动作运行结果实例(方法, 输出结果场景, "运行准备完成", 本能动作运行结果_成功);
        }
        if (!条件场景) {
            记录动作检查失败("条件场景缺失");
            return 设置结果(本能动作错误_输入参数不满足);
        }
        if (!输入参数场景) {
            记录动作检查失败("输入参数场景缺失");
            return 设置结果(本能动作错误_输入参数场景缺失);
        }

        const auto 匹配结果 = 本能动作类::场景_模式匹配(输入参数场景, 条件场景);
        if (!匹配结果.匹配成功) {
            记录动作检查失败("场景模式匹配失败", &匹配结果);
            return 设置结果(本能动作错误_输入参数不满足);
        }
        return 创建本能动作运行结果实例(方法, 输出结果场景, "运行准备完成", 本能动作运行结果_成功);
    }

    // 功能：执行任务、方法或动作的主体逻辑。
    存在节点类* 执行功能函数(
        枚举_本能动作ID 动作ID,
        方法类::节点类* 方法首节点,
        场景节点类* 输入参数场景,
        场景节点类* 输出结果场景) const noexcept
    {
        const auto 总开始 = std::chrono::steady_clock::now();
        std::uint64_t 检查耗时微秒 = 0;
        std::uint64_t 查询耗时微秒 = 0;
        std::uint64_t 动作函数耗时微秒 = 0;
        std::uint64_t 运行码写回耗时微秒 = 0;
        方法类::节点类* 方法 = 方法首节点;
        auto 耗时微秒 = [](const auto 开始) noexcept -> std::uint64_t {
            return static_cast<std::uint64_t>(
                std::chrono::duration_cast<std::chrono::microseconds>(
                    std::chrono::steady_clock::now() - 开始).count());
        };
        auto 输出慢执行日志 = [&](
            const char* 结果,
            std::int64_t 运行码) noexcept {
            if (动作ID != 枚举_本能动作ID::自我_提交任务状态变化) {
                return;
            }
            const auto 总耗时微秒 = 耗时微秒(总开始);
            if (总耗时微秒 < 10000
                && 检查耗时微秒 < 10000
                && 查询耗时微秒 < 10000
                && 动作函数耗时微秒 < 10000
                && 运行码写回耗时微秒 < 10000) {
                return;
            }

            std::string 最慢阶段 = "检查是否可调用";
            std::uint64_t 最慢阶段耗时微秒 = 检查耗时微秒;
            auto 记录最慢 = [&最慢阶段, &最慢阶段耗时微秒](
                const char* 阶段,
                std::uint64_t 耗时) {
                if (耗时 > 最慢阶段耗时微秒) {
                    最慢阶段 = 阶段;
                    最慢阶段耗时微秒 = 耗时;
                }
            };
            记录最慢("查询已注册动作", 查询耗时微秒);
            记录最慢("动作函数调用", 动作函数耗时微秒);
            记录最慢("运行码写回", 运行码写回耗时微秒);

            std::ostringstream 日志;
            日志 << "本能动作管理/执行功能函数/阶段耗时"
                << " | 本能ID=" << static_cast<std::uint32_t>(动作ID)
                << " | 方法=" << (方法 ? 方法->获取主键() : std::string("空"))
                << " | 结果=" << (结果 ? 结果 : "未知")
                << " | 运行码=" << 运行码
                << " | 总耗时微秒=" << 总耗时微秒
                << " | 最慢阶段=" << 最慢阶段
                << " | 最慢阶段耗时微秒=" << 最慢阶段耗时微秒
                << " | 检查是否可调用=" << 检查耗时微秒
                << " | 查询已注册动作=" << 查询耗时微秒
                << " | 动作函数调用=" << 动作函数耗时微秒
                << " | 运行码写回=" << 运行码写回耗时微秒;
            项目运行日志(日志.str());
        };
        auto 节点主键 = [](const 基础信息节点类* 节点) -> std::string {
            return 节点 ? 节点->获取主键() : std::string("空");
        };
        auto 需要动作调用诊断 = [&]() noexcept {
            return 动作ID == 枚举_本能动作ID::提交_当前观察范围可观测单位存在对应事实
                || 动作ID == 枚举_本能动作ID::自我_观察单个空间候选并组合存在假设;
        };
        auto 记录动作集诊断 = [&](
            const char* 阶段,
            const std::optional<结构体_本能动作登记信息>& 已注册动作,
            const 存在节点类* 运行结果,
            std::int64_t 运行码,
            bool 已进入动作函数) noexcept {
            if (!需要动作调用诊断()) {
                return;
            }
            std::ostringstream 日志;
            const auto* 注册动作名 = 本能方法类::查询默认动作名称(动作ID);
            日志 << "本能动作管理/动作集入口诊断"
                << " | 阶段=" << (阶段 ? 阶段 : "未知")
                << " | 本能ID=" << static_cast<std::uint32_t>(动作ID)
                << " | 方法=" << (方法 ? 方法->获取主键() : std::string("空"))
                << " | 输入场景=" << 节点主键(reinterpret_cast<const 基础信息节点类*>(输入参数场景))
                << " | 输出场景=" << 节点主键(reinterpret_cast<const 基础信息节点类*>(输出结果场景))
                << " | 已注册=" << (已注册动作.has_value() ? 1 : 0)
                << " | 注册动作名=" << (注册动作名 ? 注册动作名 : "空")
                << " | 已进入动作函数=" << (已进入动作函数 ? 1 : 0)
                << " | 运行存在=" << 节点主键(reinterpret_cast<const 基础信息节点类*>(运行结果))
                << " | 运行码=" << 运行码
                << " | 检查耗时微秒=" << 检查耗时微秒
                << " | 查询耗时微秒=" << 查询耗时微秒
                << " | 动作函数耗时微秒=" << 动作函数耗时微秒
                << " | 运行码写回耗时微秒=" << 运行码写回耗时微秒
                << " | 只诊断不改变判定=1";
            项目运行日志(日志.str());
        };

        const auto 检查开始 = std::chrono::steady_clock::now();
        auto* 检查结果 = 检查是否可调用(动作ID, 方法首节点, 输入参数场景, 输出结果场景);
        检查耗时微秒 = 耗时微秒(检查开始);
        写入本能动作运行场景事实(
            检查结果,
            输入参数场景,
            输出结果场景);
        const auto 检查闭环视图 = 读取本能方法运行闭环视图(
            检查结果,
            输出结果场景);
        if (!(检查闭环视图.方法执行成功 && !检查闭环视图.有执行缺口())) {
            记录动作集诊断(
                "检查失败",
                std::optional<结构体_本能动作登记信息>{},
                检查结果,
                本能动作运行结果值(检查结果),
                false);
            输出慢执行日志("检查失败", 本能动作运行结果值(检查结果));
            return 检查结果;
        }

        const auto 查询开始 = std::chrono::steady_clock::now();
        const auto 已注册动作 = 查询(动作ID);
        查询耗时微秒 = 耗时微秒(查询开始);
        方法 = 方法首节点 ? 方法首节点 : (已注册动作 ? 已注册动作->方法信息首节点 : nullptr);
        if (!已注册动作.has_value() || !已注册动作->动作函数) {
            auto* 运行结果 = 创建本能动作运行结果实例_按码(
                方法,
                输出结果场景,
                本能动作错误_未注册);
            写入本能动作运行场景事实(
                运行结果,
                输入参数场景,
                输出结果场景);
            记录动作集诊断(
                "未注册",
                已注册动作,
                运行结果,
                本能动作错误_未注册,
                false);
            输出慢执行日志("未注册", 本能动作错误_未注册);
            return 运行结果;
        }
        记录动作集诊断(
            "动作函数调用前",
            已注册动作,
            nullptr,
            本能动作运行结果_未知,
            false);

        auto 动作函数开始 = std::chrono::steady_clock::time_point{};
        bool 已进入动作函数 = false;
        try {
            动作函数开始 = std::chrono::steady_clock::now();
            已进入动作函数 = true;
            if (auto* 运行结果 = 已注册动作->动作函数(方法, 输入参数场景, 输出结果场景)) {
                动作函数耗时微秒 = 耗时微秒(动作函数开始);
                const auto 运行码 = 本能动作运行结果值(运行结果);
                const auto 写回开始 = std::chrono::steady_clock::now();
                (void)世界树.写入特征_I64(
                    reinterpret_cast<基础信息节点类*>(运行结果),
                    本能动作运行结果码特征词(),
                    static_cast<I64>(运行码),
                    结构体_时间戳::当前_微秒());
                写入本能动作运行场景事实(
                    运行结果,
                    输入参数场景,
                    输出结果场景);
                运行码写回耗时微秒 = 耗时微秒(写回开始);
                记录动作集诊断(
                    "动作函数返回",
                    已注册动作,
                    运行结果,
                    运行码,
                    已进入动作函数);
                输出慢执行日志("动作函数返回", 运行码);
                return 运行结果;
            }
            动作函数耗时微秒 = 耗时微秒(动作函数开始);
            auto* 运行结果 = 创建本能动作运行结果实例(
                方法,
                输出结果场景,
                "运行结果未知",
                本能动作运行结果_未知);
            写入本能动作运行场景事实(
                运行结果,
                输入参数场景,
                输出结果场景);
            记录动作集诊断(
                "动作函数返回空",
                已注册动作,
                运行结果,
                本能动作运行结果_未知,
                已进入动作函数);
            输出慢执行日志("运行结果未知", 本能动作运行结果_未知);
            return 运行结果;
        }
        catch (const std::exception&) {
            if (已进入动作函数) {
                动作函数耗时微秒 = 耗时微秒(动作函数开始);
            }
            auto* 运行结果 = 创建本能动作运行结果实例_按码(
                方法,
                输出结果场景,
                本能动作错误_动作异常);
            写入本能动作运行场景事实(
                运行结果,
                输入参数场景,
                输出结果场景);
            输出慢执行日志("动作异常", 本能动作错误_动作异常);
            return 运行结果;
        }
        catch (...) {
            if (已进入动作函数) {
                动作函数耗时微秒 = 耗时微秒(动作函数开始);
            }
            auto* 运行结果 = 创建本能动作运行结果实例_按码(
                方法,
                输出结果场景,
                本能动作错误_动作未知异常);
            写入本能动作运行场景事实(
                运行结果,
                输入参数场景,
                输出结果场景);
            输出慢执行日志("动作未知异常", 本能动作错误_动作未知异常);
            return 运行结果;
        }
    }

private:
    mutable std::mutex mu_{};
    std::unordered_map<枚举_本能动作ID, 结构体_本能动作登记信息> 表_{};
};

// 功能：按函数名执行对应处理。
inline 本能动作管理类& 取本能动作集() noexcept
{
    static 本能动作管理类 s_实例{};
    return s_实例;
}

} // export
