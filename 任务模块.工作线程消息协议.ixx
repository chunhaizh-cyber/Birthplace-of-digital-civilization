// 功能：执行任务、方法或动作的主体逻辑。
inline bool 是否线程状态消息表示执行结束(const 结构_任务管理线程状态消息& 消息) noexcept
{
    return 消息.是否执行尝试结束
        || 消息.结束状态 == 枚举_任务管理线程结束状态::正常结束
        || 消息.结束状态 == 枚举_任务管理线程结束状态::收束结束
        || 消息.结束状态 == 枚举_任务管理线程结束状态::中断结束
        || 消息.结束状态 == 枚举_任务管理线程结束状态::故障结束
        || 消息.结束状态 == 枚举_任务管理线程结束状态::超时结束;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline std::string 构造任务管理执行尝试键(const 结构_任务管理消息头& 消息头)
{
    if (!消息头.执行尝试主键.empty()) {
        return 消息头.执行尝试主键;
    }

    std::ostringstream 输出;
    输出 << 消息头.任务管理任务主键
        << "|" << 消息头.任务主键
        << "|" << 消息头.父任务主键
        << "|" << 消息头.步骤主键
        << "|" << 消息头.路径签名
        << "|" << 消息头.执行尝试号;
    return 输出.str();
}

// 功能：按函数名执行对应处理。
inline std::string 构造任务管理线程状态消息文本(const 结构_任务管理线程状态消息& 消息)
{
    std::ostringstream 输出;
    输出 << "任务管理线程状态"
        << " | 尝试=" << 构造任务管理执行尝试键(消息.消息头)
        << " | 运行状态=" << 任务管理线程运行状态文本(消息.当前运行状态);
    if (消息.消息头.回复目标消息主键 != 0) {
        输出 << " | 回复=#" << 消息.消息头.回复目标消息主键;
    }
    if (是否线程状态消息表示执行结束(消息)) {
        输出 << " | 结束状态=" << 任务管理线程结束状态文本(消息.结束状态);
    }
    if (!消息.消息头.步骤主键.empty()) {
        输出 << " | 步骤=" << 消息.消息头.步骤主键;
    }
    if (消息.是否携带控制请求 || !消息.控制请求主键.empty()) {
        输出 << " | 控制请求=" << (消息.控制请求主键.empty() ? "未命名" : 消息.控制请求主键)
            << " | 控制意图=" << 任务管理控制意图值文本(消息.当前控制意图)
            << " | 响应=" << 任务管理控制响应状态文本(消息.当前控制响应状态)
            << " | 已执行=" << (消息.是否控制已执行完成 ? "是" : "否");
    }
    return 输出.str();
}

// 功能：按函数名执行对应处理。
inline std::string 构造任务管理派生需求消息文本(const 结构_任务管理派生需求消息& 消息)
{
    std::ostringstream 输出;
    输出 << "任务管理派生需求"
        << " | 尝试=" << 构造任务管理执行尝试键(消息.消息头)
        << " | 类型=" << 任务管理派生需求类型文本(消息.派生需求类型)
        << " | 阻塞级别=" << 任务管理阻塞级别文本(消息.阻塞级别)
        << " | 本地不可消化=" << (消息.是否本地不可消化 ? "是" : "否")
        << " | 阻塞当前步骤=" << (消息.是否阻塞当前步骤 ? "是" : "否");
    if (!消息.当前方法主键.empty()) {
        输出 << " | 方法=" << 消息.当前方法主键;
    }
    if (!消息.方法虚拟存在主键.empty()) {
        输出 << " | 方法虚拟存在=" << 消息.方法虚拟存在主键;
    }
    if (!消息.来源因果主键.empty()) {
        输出 << " | 来源因果=" << 消息.来源因果主键;
    } else if (消息.来源因果指针 != 0) {
        输出 << " | 来源因果指针=" << 消息.来源因果指针;
    }
    if (!消息.来源动态主键.empty()) {
        输出 << " | 来源动态=" << 消息.来源动态主键;
    } else if (消息.来源动态指针 != 0) {
        输出 << " | 来源动态指针=" << 消息.来源动态指针;
    }
    if (!消息.来源方法主键.empty()) {
        输出 << " | 来源方法=" << 消息.来源方法主键;
    } else if (消息.来源方法指针 != 0) {
        输出 << " | 来源方法指针=" << 消息.来源方法指针;
    }
    if (!消息.父需求主键.empty()) {
        输出 << " | 父需求=" << 消息.父需求主键;
    }
    if (消息.因果路径生成类型 != 枚举_任务管理因果路径生成类型::未定义) {
        输出 << " | 因果生成类型="
            << 任务管理因果路径生成类型文本(消息.因果路径生成类型);
    }
    if (消息.贡献层级 != 0) {
        输出 << " | 贡献层级=" << 消息.贡献层级;
    }
    if (消息.层级权重 != 0) {
        输出 << " | 层级权重=" << 消息.层级权重;
    }
    if (消息.稳定度摘要 != 0) {
        输出 << " | 稳定度=" << 消息.稳定度摘要;
    }
    if (消息.方法需求位抽象特征指针 != 0 || 消息.方法需求位值 != 0) {
        输出 << " | 方法需求位值=" << 消息.方法需求位值;
    }
    if (消息.本能能力缺口类型抽象特征指针 != 0 || 消息.本能能力缺口类型值 != 0) {
        输出 << " | 本能缺口值=" << 消息.本能能力缺口类型值;
    }
    if (!消息.需求特征类型主键.empty()) {
        输出 << " | 需求特征=" << 消息.需求特征类型主键;
    }
    if (!消息.需求目标主体主键.empty()) {
        输出 << " | 需求目标主体=" << 消息.需求目标主体主键;
    }
    if (!消息.需求当前状态主键.empty()) {
        输出 << " | 当前状态=" << 消息.需求当前状态主键;
    }
    if (!消息.需求目标状态主键.empty()) {
        输出 << " | 目标状态=" << 消息.需求目标状态主键;
    }
    if (消息.满足关系 != 0) {
        输出 << " | 满足关系=" << static_cast<int>(消息.满足关系);
    }
    return 输出.str();
}

// 功能：按函数名执行对应处理。
inline std::string 构造任务管理结果状态消息文本(const 结构_任务管理结果状态消息& 消息)
{
    std::ostringstream 输出;
    输出 << "任务管理结果状态"
        << " | 尝试=" << 构造任务管理执行尝试键(消息.消息头)
        << " | 结果=" << 任务管理结果状态文本(消息.结果状态)
        << " | 成功=" << (消息.是否成功 ? "是" : "否")
        << " | 完成度=" << 消息.完成度
        << " | 错误码=" << 消息.错误码;
    if (!消息.方法虚拟存在主键.empty()) {
        输出 << " | 方法虚拟存在=" << 消息.方法虚拟存在主键;
    }
    if (!消息.任务价值反馈.反馈事件主键.empty()
        || 消息.任务价值反馈.本次安全满足量 != 0
        || 消息.任务价值反馈.本次服务满足量 != 0
        || 消息.任务价值反馈.安全累计比例_百万分比 >= 0
        || 消息.任务价值反馈.服务累计比例_百万分比 >= 0) {
        输出 << " | 价值反馈=" << 消息.任务价值反馈.反馈事件主键
            << " | 安全满足=" << 消息.任务价值反馈.本次安全满足量
            << " | 服务满足=" << 消息.任务价值反馈.本次服务满足量
            << " | 安全比例=" << 消息.任务价值反馈.安全累计比例_百万分比
            << " | 服务比例=" << 消息.任务价值反馈.服务累计比例_百万分比;
    }
    if (消息.动作验证报告摘要.有报告) {
        输出 << " | " << 动作验证报告::摘要转日志文本(消息.动作验证报告摘要);
    }
    return 输出.str();
}

// 功能：按函数名执行对应处理。
inline std::string 构造任务管理观察事实承接请求文本(
    const 结构_任务管理观察事实承接请求& 消息)
{
    std::ostringstream 输出;
    输出 << "任务管理观察事实承接请求"
        << " | 等待项ID=" << 消息.等待项ID
        << " | 报告ID=" << 消息.报告ID
        << " | 目标观察约束ID=" << 消息.目标观察约束ID
        << " | 目标存在ID=" << (消息.目标存在ID.empty() ? std::string("空") : 消息.目标存在ID)
        << " | 目标特征类型ID=" << (消息.目标特征类型ID.empty() ? std::string("空") : 消息.目标特征类型ID)
        << " | 目标特征当前值=" << 消息.目标特征当前值
        << " | 来源外设=" << 消息.来源外设
        << " | 观察运行模式值=" << 消息.观察运行模式值
        << " | 报告类型值=" << 消息.报告类型值
        << " | 簇数量=" << 消息.观察像素簇数量
        << " | 承接报告=" << (消息.请求承接观察报告 ? "是" : "否")
        << " | 承接簇=" << (消息.请求承接观察像素簇集合 ? "是" : "否")
        << " | 生成候选=" << (消息.请求生成存在候选 ? "是" : "否")
        << " | 统计识别=" << (消息.请求统计当前帧识别情况 ? "是" : "否")
        << " | 承接稳定特征=" << (消息.请求承接稳定特征集合 ? "是" : "否");
    if (!消息.来源需求ID.empty()) {
        输出 << " | 来源需求=" << 消息.来源需求ID;
    }
    if (!消息.目标特征generation.empty()) {
        输出 << " | 目标特征generation=" << 消息.目标特征generation;
    }
    if (!消息.约束generation.empty()) {
        输出 << " | 约束generation=" << 消息.约束generation;
    }
    return 输出.str();
}

// 功能：执行任务、方法或动作的主体逻辑。
inline std::string 构造任务管理执行前许可请求文本(
    const 结构_任务管理执行前许可请求消息& 消息)
{
    std::ostringstream 输出;
    输出 << "任务管理执行前许可请求"
        << " | 请求=" << 消息.请求ID
        << " | 工作项=" << 消息.工作项ID
        << " | 任务=" << (消息.任务主键.empty() ? std::string("空") : 消息.任务主键)
        << " | 来源需求=" << (消息.来源需求主键.empty() ? std::string("空") : 消息.来源需求主键)
        << " | 当前方法=" << (消息.当前方法主键.empty() ? std::string("空") : 消息.当前方法主键)
        << " | 预计安全变化=" << 消息.预计安全变化量
        << " | 预计服务变化=" << 消息.预计服务变化量
        << " | 禁止项接口预留=" << (消息.禁止项接口已预留 ? "是" : "否")
        << " | 禁止项命中=" << (消息.禁止项命中 ? "是" : "否")
        << " | 方向证据=" << (消息.方向证据已提供 ? "已提供" : "未提供")
        << " | 方向不一致=" << (消息.方向不一致 ? "是" : "否");
    return 输出.str();
}

} // export
