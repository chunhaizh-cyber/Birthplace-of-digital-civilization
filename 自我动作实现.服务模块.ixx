    inline 特征节点类* 查找子特征(
        基础信息节点类* 宿主,
        const 语素入口节点类* 特征类型) noexcept
    {
        return 宿主 && 特征类型
            ? 世界树.特征().查找子特征_按类型(宿主, 特征类型)
            : nullptr;
    }

    inline bool 读取基础节点指针(
        基础信息节点类* 宿主,
        const 语素入口节点类* 特征类型,
        void*& 输出指针) noexcept
    {
        输出指针 = nullptr;
        return 宿主
            && 特征类型
            && 世界树.读取特征_指针(宿主, 特征类型, 输出指针)
            && 输出指针;
    }

    inline 特征节点类* 输入包根(
        场景节点类* 输入参数场景,
        const 语素入口节点类* 包类型) noexcept
    {
        return 输入参数场景 && 包类型
            ? 查找子特征(
                reinterpret_cast<基础信息节点类*>(输入参数场景),
                包类型)
            : nullptr;
    }

    inline 特征节点类* 输入条件包根(场景节点类* 输入参数场景) noexcept
    {
        if (!输入参数场景) return nullptr;
        auto* 宿主 = reinterpret_cast<基础信息节点类*>(输入参数场景);
        if (auto* 条件包 = 查找子特征(宿主, 特征_输入条件包())) return 条件包;
        if (auto* 条件包 = 查找子特征(宿主, 特征_条件集合())) return 条件包;
        return 查找子特征(宿主, 特征_运行参数());
    }

    inline bool 读取包指针(
        基础信息节点类* 包,
        const 语素入口节点类* 子类型,
        void*& 输出指针) noexcept
    {
        输出指针 = nullptr;
        auto* 子特征 = 查找子特征(包, 子类型);
        return 子特征 && 世界树.读取特征_指针(子特征, 输出指针) && 输出指针;
    }

    inline bool 读取输入包指针(
        场景节点类* 输入参数场景,
        const 语素入口节点类* 包类型,
        const 语素入口节点类* 参数类型,
        void*& 输出指针) noexcept
    {
        auto* 包根 = 输入包根(输入参数场景, 包类型);
        return 包根
            && 读取包指针(
                reinterpret_cast<基础信息节点类*>(包根),
                参数类型,
                输出指针);
    }

    inline bool 读取调用信息指针(
        场景节点类* 输入参数场景,
        const 语素入口节点类* 参数类型,
        void*& 输出指针) noexcept
    {
        return 读取输入包指针(
            输入参数场景,
            特征_调用信息(),
            参数类型,
            输出指针);
    }

    inline 任务类::节点类* 读取服务输入任务(场景节点类* 输入参数场景) noexcept
    {
        void* 指针 = nullptr;
        auto* 场景宿主 = 输入参数场景
            ? reinterpret_cast<基础信息节点类*>(输入参数场景)
            : nullptr;
        auto* 输入条件包 = reinterpret_cast<基础信息节点类*>(输入条件包根(输入参数场景));

        if (读取基础节点指针(场景宿主, 特征_任务信息节点(), 指针)
            || 读取调用信息指针(输入参数场景, 特征_任务信息节点(), 指针)
            || 读取包指针(输入条件包, 特征_任务信息节点(), 指针)) {
            return reinterpret_cast<任务类::节点类*>(指针);
        }
        return nullptr;
    }

    inline 需求节点类* 读取任务来源需求(任务类::节点类* 任务节点) noexcept
    {
        return 任务节点 ? 任务节点->主信息.对应需求.指针 : nullptr;
    }

    inline 存在节点类* 读取任务虚拟存在(任务类::节点类* 任务节点) noexcept
    {
        return 任务节点 ? 任务节点->主信息.任务虚拟存在.指针 : nullptr;
    }

    inline 基础信息节点类* 读取任务虚拟存在宿主(任务类::节点类* 任务节点) noexcept
    {
        auto* 任务存在 = 读取任务虚拟存在(任务节点);
        return 任务存在 ? reinterpret_cast<基础信息节点类*>(任务存在) : nullptr;
    }

    inline 服务字段绑定结果 取或创建任务字段特征(
        任务类::节点类* 任务节点,
        const 语素入口节点类* 字段类型) noexcept
    {
        if (!任务节点) {
            return { false, nullptr, 值_服务字段绑定任务缺失() };
        }
        if (!字段类型) {
            return { false, nullptr, 值_服务字段绑定字段类型缺失() };
        }

        auto* 宿主 = 读取任务虚拟存在宿主(任务节点);
        if (!宿主) {
            return { false, nullptr, 值_服务字段绑定任务虚拟存在缺失() };
        }

        auto* 字段特征 = 世界树.取或创建子特征_按类型(宿主, 字段类型);
        return { 字段特征 != nullptr, 字段特征, 字段特征 ? nullptr : 值_服务字段绑定写入失败() };
    }

    inline 服务字段绑定结果 绑定任务指针字段(
        任务类::节点类* 任务节点,
        const 语素入口节点类* 字段类型,
        const void* 字段值,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        auto 结果 = 取或创建任务字段特征(任务节点, 字段类型);
        if (!结果.成功) return 结果;
        if (!字段值) {
            结果.成功 = false;
            结果.失败原因 = 值_服务字段绑定字段值缺失();
            return 结果;
        }

        结果.成功 = 世界树.写入特征_指针(结果.字段特征, 字段值, now);
        if (!结果.成功) 结果.失败原因 = 值_服务字段绑定写入失败();
        return 结果;
    }

    inline 服务字段绑定结果 绑定任务I64字段(
        任务类::节点类* 任务节点,
        const 语素入口节点类* 字段类型,
        I64 字段值,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        auto 结果 = 取或创建任务字段特征(任务节点, 字段类型);
        if (!结果.成功) return 结果;

        结果.成功 = 世界树.写入特征_I64(结果.字段特征, 字段值, now);
        if (!结果.成功) 结果.失败原因 = 值_服务字段绑定写入失败();
        return 结果;
    }

    inline bool 记录任务字段来源方法(
        特征节点类* 字段特征,
        存在节点类* 来源方法虚拟存在,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        return 字段特征
            && 来源方法虚拟存在
            && 世界树.写入特征_指针(
                reinterpret_cast<基础信息节点类*>(字段特征),
                特征_字段来源方法虚拟存在(),
                来源方法虚拟存在,
                now);
    }

    inline bool 记录任务字段来源方法版本(
        特征节点类* 字段特征,
        I64 来源方法版本,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        return 字段特征
            && 世界树.写入特征_I64(
                reinterpret_cast<基础信息节点类*>(字段特征),
                特征_字段来源方法版本(),
                来源方法版本,
                now);
    }

    inline bool 记录任务字段激活信息(
        特征节点类* 字段特征,
        const 语素入口节点类* 字段角色,
        const 语素入口节点类* 激活原因,
        I64 激活阶段,
        bool 是否必需,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        if (!字段特征) return false;
        auto* 宿主 = reinterpret_cast<基础信息节点类*>(字段特征);
        bool ok = true;
        if (字段角色) {
            ok = 世界树.写入特征_指针(宿主, 特征_字段角色(), 字段角色, now) && ok;
        }
        if (激活原因) {
            ok = 世界树.写入特征_指针(宿主, 特征_字段激活原因(), 激活原因, now) && ok;
        }
        ok = 世界树.写入特征_I64(宿主, 特征_字段激活阶段(), 激活阶段, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_字段是否必需(), 是否必需 ? 1 : 0, now) && ok;
        return ok;
    }

    inline 服务字段绑定结果 绑定任务交互者(
        任务类::节点类* 任务节点,
        存在节点类* 交互者,
