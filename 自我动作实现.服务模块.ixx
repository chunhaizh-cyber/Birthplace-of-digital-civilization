    }

    enum class 枚举_服务任务字段 : std::uint8_t {
        未定义 = 0,
        交互者 = 1,
        权限者 = 2,
        服务对象 = 3,
        权限边界 = 4,
        目标宿主 = 5,
        目标特征类型 = 6,
        目标值 = 7,
        输入场景 = 8,
    };

    enum class 枚举_服务字段值类型 : std::uint8_t {
        指针 = 0,
        I64 = 1,
    };

    struct 服务字段动作结果 {
        bool 成功 = false;
        任务类::节点类* 任务节点 = nullptr;
        存在节点类* 任务虚拟存在 = nullptr;
        const 语素入口节点类* 字段类型 = nullptr;
        特征节点类* 字段特征 = nullptr;
        const void* 指针值 = nullptr;
        I64 I64值 = 0;
        枚举_服务字段值类型 值类型 = 枚举_服务字段值类型::指针;
        const 语素入口节点类* 失败原因 = nullptr;
    };

    // 功能：按函数名执行对应处理。
    inline const 语素入口节点类* 服务任务字段特征类型(枚举_服务任务字段 字段) noexcept
    {
        switch (字段) {
        case 枚举_服务任务字段::交互者:
            return 特征_交互者();
        case 枚举_服务任务字段::权限者:
            return 特征_权限者();
        case 枚举_服务任务字段::服务对象:
            return 特征_服务对象();
        case 枚举_服务任务字段::权限边界:
            return 特征_权限边界();
        case 枚举_服务任务字段::目标宿主:
            return 特征_目标宿主();
        case 枚举_服务任务字段::目标特征类型:
            return 特征_目标特征类型();
        case 枚举_服务任务字段::目标值:
            return 特征_目标值();
        case 枚举_服务任务字段::输入场景:
            return 特征_输入场景();
        default:
            return nullptr;
        }
    }

    // 功能：从指定来源读取数据或状态。
    inline bool 读取基础节点I64(
        基础信息节点类* 宿主,
        const 语素入口节点类* 特征类型,
        I64& 输出值) noexcept
    {
        输出值 = 0;
        return 宿主
            && 特征类型
            && 世界树.读取特征_I64(宿主, 特征类型, 输出值);
    }

    // 功能：从指定来源读取数据或状态。
    inline bool 读取输入包I64(
        场景节点类* 输入参数场景,
        const 语素入口节点类* 包类型,
        const 语素入口节点类* 参数类型,
        I64& 输出值) noexcept
    {
        auto* 包根 = 输入包根(输入参数场景, 包类型);
        return 包根
            && 读取基础节点I64(
                reinterpret_cast<基础信息节点类*>(包根),
                参数类型,
                输出值);
    }

    // 功能：从指定来源读取数据或状态。
    inline bool 读取调用信息I64(
        场景节点类* 输入参数场景,
        const 语素入口节点类* 参数类型,
        I64& 输出值) noexcept
    {
        return 读取输入包I64(
            输入参数场景,
            特征_调用信息(),
            参数类型,
            输出值);
    }

    // 功能：从指定来源读取数据或状态。
    inline bool 读取服务字段输入指针(
        场景节点类* 输入参数场景,
        const 语素入口节点类* 字段类型,
        void*& 输出指针) noexcept
    {
        输出指针 = nullptr;
        auto* 场景宿主 = 输入参数场景
            ? reinterpret_cast<基础信息节点类*>(输入参数场景)
            : nullptr;
        auto* 输入条件包 = reinterpret_cast<基础信息节点类*>(输入条件包根(输入参数场景));
        return 读取基础节点指针(场景宿主, 字段类型, 输出指针)
            || 读取调用信息指针(输入参数场景, 字段类型, 输出指针)
            || 读取包指针(输入条件包, 字段类型, 输出指针);
    }

    // 功能：从指定来源读取数据或状态。
    inline bool 读取服务字段输入I64(
        场景节点类* 输入参数场景,
        const 语素入口节点类* 字段类型,
        I64& 输出值) noexcept
    {
        auto* 场景宿主 = 输入参数场景
            ? reinterpret_cast<基础信息节点类*>(输入参数场景)
            : nullptr;
        auto* 输入条件包 = reinterpret_cast<基础信息节点类*>(输入条件包根(输入参数场景));
        return 读取基础节点I64(场景宿主, 字段类型, 输出值)
            || 读取调用信息I64(输入参数场景, 字段类型, 输出值)
            || 读取基础节点I64(输入条件包, 字段类型, 输出值);
    }

    inline 服务字段动作结果 执行任务字段绑定(
        枚举_服务任务字段 字段,
        场景节点类* 输入参数场景,
        存在节点类* 来源方法虚拟存在,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        服务字段动作结果 结果{};
        结果.字段类型 = 服务任务字段特征类型(字段);
        if (!结果.字段类型) {
            结果.失败原因 = 值_服务字段绑定字段类型缺失();
            return 结果;
        }

        结果.任务节点 = 读取服务输入任务(输入参数场景);
        if (!结果.任务节点) {
            结果.失败原因 = 值_服务字段绑定任务缺失();
            return 结果;
        }
        结果.任务虚拟存在 = 读取任务虚拟存在(结果.任务节点);
        if (!结果.任务虚拟存在) {
            结果.失败原因 = 值_服务字段绑定任务虚拟存在缺失();
            return 结果;
        }

        void* 指针 = nullptr;
        if (字段 == 枚举_服务任务字段::目标值
            && !读取服务字段输入指针(输入参数场景, 结果.字段类型, 指针)) {
            I64 值 = 0;
            if (!读取服务字段输入I64(输入参数场景, 结果.字段类型, 值)) {
                结果.失败原因 = 值_服务字段绑定字段值缺失();
                return 结果;
            }
            auto 绑定结果 = 绑定任务目标值I64(结果.任务节点, 值, now);
            结果.成功 = 绑定结果.成功;
            结果.字段特征 = 绑定结果.字段特征;
            结果.失败原因 = 绑定结果.失败原因;
            结果.I64值 = 值;
            结果.值类型 = 枚举_服务字段值类型::I64;
        }
        else {
            if (!指针 && !读取服务字段输入指针(输入参数场景, 结果.字段类型, 指针)) {
                结果.失败原因 = 值_服务字段绑定字段值缺失();
                return 结果;
            }

            auto 绑定结果 = 绑定任务指针字段(
                结果.任务节点,
                结果.字段类型,
                指针,
                now);
            结果.成功 = 绑定结果.成功;
            结果.字段特征 = 绑定结果.字段特征;
            结果.失败原因 = 绑定结果.失败原因;
            结果.指针值 = 指针;
            结果.值类型 = 枚举_服务字段值类型::指针;
        }

        if (结果.成功 && 来源方法虚拟存在) {
            (void)记录任务字段来源方法(结果.字段特征, 来源方法虚拟存在, now);
        }
        return 结果;
    }

    struct 服务方法声明装配结果 {
        bool 成功 = false;
        std::size_t 已扫描声明根数 = 0;
        std::size_t 已扫描字段数 = 0;
        std::size_t 已挂载字段数 = 0;
        std::size_t 写入失败字段数 = 0;
        const 语素入口节点类* 失败原因 = nullptr;
    };

    struct 服务字段检查结果 {
        bool 任务存在 = false;
        bool 任务虚拟存在存在 = false;
        bool 字段已挂载 = false;
        bool 字段有当前值 = false;
        特征节点类* 字段特征 = nullptr;
        const 语素入口节点类* 失败原因 = nullptr;
    };

    // 功能：从指定来源读取数据或状态。
    inline const 语素入口节点类* 读取声明字段类型(特征节点类* 声明字段) noexcept
    {
        const auto* 主信息 = 世界树.特征().取特征主信息(声明字段);
        return 主信息 ? 主信息->类型 : nullptr;
    }

    // 功能：从指定来源读取数据或状态。
    inline bool 读取声明字段是否必需(特征节点类* 声明字段) noexcept
    {
        I64 是否必需 = 1;
        (void)读取基础节点I64(
            reinterpret_cast<基础信息节点类*>(声明字段),
            特征_是否必需(),
            是否必需);
        return 是否必需 != 0;
    }

    inline bool 装配方法声明根特征到任务(
        任务类::节点类* 任务节点,
        存在节点类* 方法虚拟存在,
        const 语素入口节点类* 声明根类型,
        const 语素入口节点类* 字段角色,
        I64 激活阶段,
        服务方法声明装配结果& 结果,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        if (!任务节点) {
            结果.失败原因 = 值_服务字段绑定任务缺失();
            return false;
        }
        if (!读取任务虚拟存在(任务节点)) {
            结果.失败原因 = 值_服务字段绑定任务虚拟存在缺失();
            return false;
        }
        if (!方法虚拟存在 || !声明根类型 || !字段角色) {
            结果.失败原因 = 值_服务字段绑定字段类型缺失();
            return false;
        }

        auto* 方法宿主 = reinterpret_cast<基础信息节点类*>(方法虚拟存在);
        auto* 声明根 = 查找子特征(方法宿主, 声明根类型);
        if (!声明根) {
            return true;
        }

        ++结果.已扫描声明根数;
        for (auto* 声明字段 : 世界树.特征().获取子特征(reinterpret_cast<基础信息节点类*>(声明根))) {
            const auto* 字段类型 = 读取声明字段类型(声明字段);
            if (!字段类型) {
                continue;
            }

            ++结果.已扫描字段数;
            auto 挂载结果 = 取或创建任务字段特征(任务节点, 字段类型);
            if (!挂载结果.成功) {
                ++结果.写入失败字段数;
                结果.失败原因 = 挂载结果.失败原因;
                continue;
            }

            const bool 是否必需 = 读取声明字段是否必需(声明字段);
            bool ok = true;
            ok = 记录任务字段来源方法(挂载结果.字段特征, 方法虚拟存在, now) && ok;
            ok = 记录任务字段激活信息(
                挂载结果.字段特征,
                字段角色,
                值_激活原因_方法声明(),
                激活阶段,
                是否必需,
                now) && ok;
            if (ok) {
                ++结果.已挂载字段数;
            }
            else {
                ++结果.写入失败字段数;
                结果.失败原因 = 值_服务字段绑定写入失败();
            }
        }
        return true;
    }

    inline 服务方法声明装配结果 装配方法声明特征到任务(
        任务类::节点类* 任务节点,
        存在节点类* 方法虚拟存在,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        服务方法声明装配结果 结果{};
        bool ok = true;
        ok = 装配方法声明根特征到任务(
            任务节点,
            方法虚拟存在,
            特征_形参表(),
            值_输入字段角色(),
            1,
            结果,
            now) && ok;
        ok = 装配方法声明根特征到任务(
            任务节点,
            方法虚拟存在,
            特征_结果表(),
            值_输出字段角色(),
            2,
            结果,
            now) && ok;
        ok = 装配方法声明根特征到任务(
            任务节点,
            方法虚拟存在,
            特征_验证特征集合(),
            值_验证字段角色(),
            3,
            结果,
            now) && ok;
        ok = 装配方法声明根特征到任务(
            任务节点,
            方法虚拟存在,
            特征_归因特征集合(),
            值_归因字段角色(),
            4,
            结果,
            now) && ok;
        ok = 装配方法声明根特征到任务(
            任务节点,
            方法虚拟存在,
            特征_安全权限特征集合(),
            值_安全权限字段角色(),
            5,
            结果,
            now) && ok;
        ok = 装配方法声明根特征到任务(
            任务节点,
            方法虚拟存在,
            特征_失败处理特征集合(),
            值_失败处理字段角色(),
            6,
            结果,
            now) && ok;
        ok = 装配方法声明根特征到任务(
            任务节点,
            方法虚拟存在,
            特征_服务治理支撑特征集合(),
            值_服务治理支撑字段角色(),
            7,
            结果,
            now) && ok;

        结果.成功 = ok && 结果.写入失败字段数 == 0;
        return 结果;
    }

    // 功能：检查状态、条件、缺口或运行约束。
    inline 服务字段检查结果 检查服务方法输入字段(
        任务类::节点类* 任务节点,
        const 语素入口节点类* 字段类型) noexcept
    {
        服务字段检查结果 结果{};
        结果.任务存在 = 任务节点 != nullptr;
        if (!结果.任务存在) {
            结果.失败原因 = 值_服务字段绑定任务缺失();
            return 结果;
        }

        auto* 任务宿主 = 读取任务虚拟存在宿主(任务节点);
        结果.任务虚拟存在存在 = 任务宿主 != nullptr;
        if (!结果.任务虚拟存在存在) {
            结果.失败原因 = 值_服务字段绑定任务虚拟存在缺失();
            return 结果;
        }
        if (!字段类型) {
            结果.失败原因 = 值_服务字段绑定字段类型缺失();
            return 结果;
        }

        结果.字段特征 = 查找子特征(任务宿主, 字段类型);
        结果.字段已挂载 = 结果.字段特征 != nullptr;
        if (!结果.字段已挂载) {
            结果.失败原因 = 值_服务字段未挂载();
            return 结果;
        }

        const auto* 主信息 = 世界树.特征().取特征主信息(结果.字段特征);
        结果.字段有当前值 = 主信息 && 主信息->有当前值();
        if (!结果.字段有当前值) {
            结果.失败原因 = 值_服务字段绑定字段值缺失();
        }
        return 结果;
    }

    inline bool 写入服务字段缺口回执(
        基础信息节点类* 回执宿主,
        任务类::节点类* 任务节点,
        存在节点类* 方法虚拟存在,
        const 语素入口节点类* 字段类型,
        const 语素入口节点类* 失败原因,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        if (!回执宿主 || !字段类型) return false;
        auto* 缺口 = 世界树.取或创建子特征_按类型(回执宿主, 特征_服务字段缺口());
        if (!缺口) return false;

        auto* 宿主 = reinterpret_cast<基础信息节点类*>(缺口);
        bool ok = true;
        if (任务节点) {
            ok = 世界树.写入特征_指针(宿主, 特征_任务信息节点(), 任务节点, now) && ok;
        }
        if (auto* 任务存在 = 读取任务虚拟存在(任务节点)) {
            ok = 世界树.写入特征_指针(宿主, 特征_任务虚拟存在(), 任务存在, now) && ok;
        }
        if (方法虚拟存在) {
            ok = 世界树.写入特征_指针(宿主, 特征_实现方法虚拟存在(), 方法虚拟存在, now) && ok;
        }
        ok = 世界树.写入特征_指针(宿主, 特征_缺口字段类型(), 字段类型, now) && ok;
        if (失败原因) {
            ok = 世界树.写入特征_指针(宿主, 特征_字段激活原因(), 失败原因, now) && ok;
        }
        return ok;
    }

    inline 存在节点类* 创建服务方法运行存在(
        任务类::节点类* 任务节点,
        存在节点类* 方法虚拟存在,
        基础信息节点类* 承载宿主 = nullptr,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        auto* 任务存在 = 读取任务虚拟存在(任务节点);
        auto* 宿主 = 任务存在
            ? reinterpret_cast<基础信息节点类*>(任务存在)
            : (方法虚拟存在 ? reinterpret_cast<基础信息节点类*>(方法虚拟存在) : 承载宿主);
        if (!宿主) return nullptr;

        auto* 运行存在 = 世界树.取或创建子存在_按类型并按特征I64(
            宿主,
            类型_服务方法运行存在(),
            特征_开始时间(),
            static_cast<I64>(now));
        if (!运行存在) return nullptr;

        (void)世界树.写入特征_I64(
            reinterpret_cast<基础信息节点类*>(运行存在),
            特征_开始时间(),
            static_cast<I64>(now),
            now);
        if (任务节点) {
            (void)世界树.写入特征_指针(
                reinterpret_cast<基础信息节点类*>(运行存在),
                特征_任务信息节点(),
               任务节点,
                now);
        }
        if (任务存在) {
            (void)世界树.写入特征_指针(
                reinterpret_cast<基础信息节点类*>(运行存在),
                特征_任务虚拟存在(),
                任务存在,
                now);
        }
        if (方法虚拟存在) {
            (void)世界树.写入特征_指针(
                reinterpret_cast<基础信息节点类*>(运行存在),
                特征_实现方法虚拟存在(),
                方法虚拟存在,
                now);
        }
        return 运行存在;
    }

    struct 服务状态读取结果 {
        bool 成功 = false;
        基础信息节点类* 目标宿主 = nullptr;
        const 语素入口节点类* 目标特征类型 = nullptr;
        特征节点类* 目标特征 = nullptr;
        特征值 状态值{};
        const 语素入口节点类* 失败原因 = nullptr;
    };

    struct 服务前后状态比较结果 {
        bool 可比较 = false;
        bool 发生变化 = false;
        bool 相同 = false;
        特征值 服务前值{};
        特征值 服务后值{};
    };

    // 功能：从指定来源读取数据或状态。
    inline bool 读取任务指针字段(
        任务类::节点类* 任务节点,
        const 语素入口节点类* 字段类型,
        void*& 输出指针) noexcept
    {
        输出指针 = nullptr;
        auto* 宿主 = 读取任务虚拟存在宿主(任务节点);
        return 宿主
            && 字段类型
            && 世界树.读取特征_指针(宿主, 字段类型, 输出指针)
            && 输出指针;
    }

    // 功能：从指定来源读取数据或状态。
    inline bool 读取任务I64字段(
        任务类::节点类* 任务节点,
        const 语素入口节点类* 字段类型,
        I64& 输出值) noexcept
    {
        输出值 = 0;
        auto* 宿主 = 读取任务虚拟存在宿主(任务节点);
        return 宿主
            && 字段类型
            && 世界树.读取特征_I64(宿主, 字段类型, 输出值);
    }

    // 功能：从指定来源读取数据或状态。
    inline 基础信息节点类* 读取任务目标宿主(任务类::节点类* 任务节点) noexcept
    {
        void* 指针 = nullptr;
        return 读取任务指针字段(任务节点, 特征_目标宿主(), 指针)
            ? reinterpret_cast<基础信息节点类*>(指针)
            : nullptr;
    }

    // 功能：从指定来源读取数据或状态。
    inline const 语素入口节点类* 读取任务目标特征类型(任务类::节点类* 任务节点) noexcept
    {
        void* 指针 = nullptr;
        return 读取任务指针字段(任务节点, 特征_目标特征类型(), 指针)
            ? reinterpret_cast<const 语素入口节点类*>(指针)
            : nullptr;
    }

    inline bool 写入任务特征值字段(
        任务类::节点类* 任务节点,
        const 语素入口节点类* 字段类型,
        const 特征值& 值,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        auto* 宿主 = 读取任务虚拟存在宿主(任务节点);
        auto* 字段 = 宿主 && 字段类型
            ? 世界树.取或创建子特征_按类型(宿主, 字段类型)
            : nullptr;
        return 字段 && 世界树.特征().写入特征值(字段, 值, now);
    }

    // 功能：从指定来源读取数据或状态。
    inline 服务状态读取结果 读取任务目标当前状态(任务类::节点类* 任务节点) noexcept
    {
        服务状态读取结果 结果{};
        if (!任务节点) {
            结果.失败原因 = 值_服务字段绑定任务缺失();
            return 结果;
        }

        结果.目标宿主 = 读取任务目标宿主(任务节点);
        if (!结果.目标宿主) {
            结果.失败原因 = 值_服务目标宿主缺失();
            return 结果;
        }

        结果.目标特征类型 = 读取任务目标特征类型(任务节点);
        if (!结果.目标特征类型) {
            结果.失败原因 = 值_服务目标特征类型缺失();
            return 结果;
        }

        结果.目标特征 = 查找子特征(结果.目标宿主, 结果.目标特征类型);
        if (!结果.目标特征) {
            结果.失败原因 = 值_服务目标状态缺失();
            return 结果;
        }

        const auto* 主信息 = 世界树.特征().取特征主信息(结果.目标特征);
        if (!主信息 || !主信息->有当前值()) {
            结果.失败原因 = 值_服务目标状态缺失();
            return 结果;
        }

        结果.状态值 = 主信息->当前值;
        结果.成功 = !std::holds_alternative<std::monostate>(结果.状态值);
        if (!结果.成功) {
            结果.失败原因 = 值_服务目标状态缺失();
        }
        return 结果;
    }

    inline 服务状态读取结果 读取并记录服务前状态(
        任务类::节点类* 任务节点,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        auto 结果 = 读取任务目标当前状态(任务节点);
        if (结果.成功) {
            (void)写入任务特征值字段(任务节点, 特征_服务前状态(), 结果.状态值, now);
        }
        return 结果;
    }

    inline 服务状态读取结果 读取并记录服务后状态(
        任务类::节点类* 任务节点,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        auto 结果 = 读取任务目标当前状态(任务节点);
        if (结果.成功) {
            (void)写入任务特征值字段(任务节点, 特征_服务后状态(), 结果.状态值, now);
        }
        return 结果;
    }

    // 功能：比较当前值、目标值或历史基准。
    inline 服务前后状态比较结果 比较服务前后状态(
        const 特征值& 服务前值,
        const 特征值& 服务后值) noexcept
    {
        服务前后状态比较结果 结果{};
        结果.服务前值 = 服务前值;
        结果.服务后值 = 服务后值;
        const bool 前有效 = !std::holds_alternative<std::monostate>(服务前值);
        const bool 后有效 = !std::holds_alternative<std::monostate>(服务后值);
        结果.可比较 = 前有效 && 后有效 && 服务前值.index() == 服务后值.index();
        结果.相同 = 结果.可比较 && 服务前值 == 服务后值;
        结果.发生变化 = 结果.可比较 && !结果.相同;
        return 结果;
    }

    inline 服务前后状态比较结果 读取并比较任务服务前后状态(
        任务类::节点类* 任务节点,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        服务前后状态比较结果 结果{};
        auto* 宿主 = 读取任务虚拟存在宿主(任务节点);
        if (!宿主) return 结果;

        const auto 服务前值 = 世界树.读取特征快照(宿主, 特征_服务前状态());
        const auto 服务后值 = 世界树.读取特征快照(宿主, 特征_服务后状态());
        结果 = 比较服务前后状态(服务前值, 服务后值);
        (void)世界树.写入特征_I64(
            宿主,
            特征_服务前后状态可比较(),
            结果.可比较 ? 1 : 0,
            now);
        (void)世界树.写入特征_I64(
            宿主,
            特征_服务前后状态发生变化(),
            结果.发生变化 ? 1 : 0,
            now);
        return 结果;
    }

    inline bool 承接方法运行输出场景(
        存在节点类* 方法运行存在,
        任务类::节点类* 任务节点,
        场景节点类* 输出结果场景,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        if (!输出结果场景) return false;
        bool ok = true;
        if (方法运行存在) {
            ok = 世界树.写入特征_指针(
                reinterpret_cast<基础信息节点类*>(方法运行存在),
                特征_输出结果场景(),
                输出结果场景,
                now) && ok;
            ok = 世界树.写入特征_指针(
                reinterpret_cast<基础信息节点类*>(方法运行存在),
                特征_输出场景(),
                输出结果场景,
                now) && ok;
        }
        if (任务节点) {
            auto 绑定结果 = 绑定任务输出场景(任务节点, 输出结果场景, now);
            ok = 绑定结果.成功 && ok;
        }
        return ok;
    }

    struct 服务D0校验结果 {
        bool 基础合法 = false;
        bool D0存在 = false;
        bool D0主信息存在 = false;
        bool 动作主体存在 = false;
        bool 动作主体为自我 = false;
        bool 承受主体存在 = false;
        bool 来源动作存在 = false;
        bool 方法运行存在 = false;
        bool 输入场景存在 = false;
        bool 输出场景存在 = false;
        bool 目标特征存在 = false;
        bool 初始状态存在 = false;
        bool 结果状态存在 = false;
        动态节点类* D0 = nullptr;
        const 动态节点主信息类* D0主信息 = nullptr;
        基础信息节点类* 动作主体 = nullptr;
        基础信息节点类* 承受主体 = nullptr;
        方法节点类* 来源动作 = nullptr;
        存在节点类* 方法运行 = nullptr;
        场景节点类* 输入场景 = nullptr;
        场景节点类* 输出场景 = nullptr;
        特征节点类* 目标特征 = nullptr;
        状态节点类* 初始状态 = nullptr;
        状态节点类* 结果状态 = nullptr;
        const 语素入口节点类* 第一缺口 = nullptr;
    };

    // 功能：按函数名执行对应处理。
    inline 动态节点类* 归一D0动作动态指针(void* 指针) noexcept
    {
        auto* 动态 = reinterpret_cast<动态节点类*>(指针);
        return 动态 && 世界树.动态().取动态主信息(动态) ? 动态 : nullptr;
    }

    inline 动态节点类* 读取宿主D0动作动态(
        基础信息节点类* 宿主,
        bool 允许通用动作动态 = false) noexcept
    {
        if (!宿主) return nullptr;
        void* 指针 = nullptr;
        if (读取基础节点指针(宿主, 特征_服务业务动作动态(), 指针)) {
            if (auto* 动态 = 归一D0动作动态指针(指针)) return 动态;
        }
        if (读取基础节点指针(宿主, 特征_D0服务业务动作动态(), 指针)) {
            if (auto* 动态 = 归一D0动作动态指针(指针)) return 动态;
        }
        if (读取基础节点指针(宿主, 特征_方法调用动作动态(), 指针)) {
            if (auto* 动态 = 归一D0动作动态指针(指针)) return 动态;
        }
        if (读取基础节点指针(宿主, 特征_来源动作动态(), 指针)) {
            if (auto* 动态 = 归一D0动作动态指针(指针)) return 动态;
        }
        if (允许通用动作动态 && 读取基础节点指针(宿主, 特征_动作动态(), 指针)) {
            if (auto* 动态 = 归一D0动作动态指针(指针)) return 动态;
        }
        return nullptr;
    }

    // 功能：从指定来源读取数据或状态。
    inline 存在节点类* 读取任务方法运行存在(任务类::节点类* 任务节点) noexcept
    {
        void* 指针 = nullptr;
        if (读取任务指针字段(任务节点, 特征_方法运行存在(), 指针)
            || 读取任务指针字段(任务节点, 特征_当前方法运行存在(), 指针)) {
            return reinterpret_cast<存在节点类*>(指针);
        }
        return nullptr;
    }

    // 功能：从指定来源读取数据或状态。
    inline 动态节点类* 读取任务D0动作动态(任务类::节点类* 任务节点) noexcept
    {
        return 读取宿主D0动作动态(读取任务虚拟存在宿主(任务节点), false);
    }

    // 功能：从指定来源读取数据或状态。
    inline 动态节点类* 读取方法运行D0动作动态(存在节点类* 方法运行存在) noexcept
    {
        return 读取宿主D0动作动态(
            方法运行存在 ? reinterpret_cast<基础信息节点类*>(方法运行存在) : nullptr,
            true);
    }

    inline 动态节点类* 读取服务D0动作动态(
        任务类::节点类* 任务节点,
        存在节点类* 方法运行存在 = nullptr) noexcept
    {
        if (auto* 动态 = 读取任务D0动作动态(任务节点)) return 动态;
        if (!方法运行存在) {
            方法运行存在 = 读取任务方法运行存在(任务节点);
        }
        return 读取方法运行D0动作动态(方法运行存在);
    }

    // 功能：从指定来源读取数据或状态。
    inline 基础信息节点类* 读取状态主体(状态节点类* 状态) noexcept
    {
        const auto* 主信息 = 状态 ? 世界树.状态().取状态主信息(状态) : nullptr;
        return 主信息 ? 主信息->状态主体.指针 : nullptr;
    }

    // 功能：从指定来源读取数据或状态。
    inline 场景节点类* 读取方法运行场景字段(
        存在节点类* 方法运行存在,
        const 语素入口节点类* 字段类型) noexcept
    {
        void* 指针 = nullptr;
        auto* 宿主 = 方法运行存在 ? reinterpret_cast<基础信息节点类*>(方法运行存在) : nullptr;
        return 读取基础节点指针(宿主, 字段类型, 指针)
            ? reinterpret_cast<场景节点类*>(指针)
            : nullptr;
    }

    // 功能：按函数名执行对应处理。
    inline 基础信息节点类* 推断D0承受主体(
        任务类::节点类* 任务节点,
        const 动态节点主信息类* D0主信息) noexcept
    {
        void* 指针 = nullptr;
        if (读取任务指针字段(任务节点, 特征_服务对象(), 指针)) {
            return reinterpret_cast<基础信息节点类*>(指针);
        }
        if (读取任务指针字段(任务节点, 特征_目标宿主(), 指针)) {
            return reinterpret_cast<基础信息节点类*>(指针);
        }
        if (!D0主信息) return nullptr;
        if (auto* 主体 = 读取状态主体(D0主信息->结果状态.指针)) return 主体;
        return 读取状态主体(D0主信息->初始状态.指针);
    }

    // 功能：从候选集中选择当前使用对象或方法。
    inline const 语素入口节点类* 选择D0第一缺口(const 服务D0校验结果& 结果) noexcept
    {
        if (!结果.D0存在) return 值_D0动作动态缺失();
        if (!结果.D0主信息存在) return 值_D0主信息缺失();
        if (!结果.动作主体存在) return 值_D0动作主体缺失();
        if (!结果.动作主体为自我) return 值_D0动作主体非自我();
        if (!结果.承受主体存在) return 值_D0承受主体缺失();
        if (!结果.来源动作存在) return 值_D0来源动作缺失();
        if (!结果.方法运行存在) return 值_D0方法运行存在缺失();
        if (!结果.输入场景存在) return 值_D0输入场景缺失();
        if (!结果.输出场景存在) return 值_D0输出场景缺失();
        if (!结果.目标特征存在) return 值_D0目标特征缺失();
        if (!结果.初始状态存在) return 值_D0初始状态缺失();
        if (!结果.结果状态存在) return 值_D0结果状态缺失();
        return nullptr;
    }

    inline 服务D0校验结果 校验服务D0基础合法性(
        任务类::节点类* 任务节点,
        存在节点类* 方法运行存在 = nullptr,
        动态节点类* D0 = nullptr) noexcept
    {
        服务D0校验结果 结果{};
        if (!方法运行存在) {
            方法运行存在 = 读取任务方法运行存在(任务节点);
        }
        if (!D0) {
            D0 = 读取服务D0动作动态(任务节点, 方法运行存在);
        }

        结果.D0 = D0;
        结果.D0存在 = D0 != nullptr;
        结果.D0主信息 = D0 ? 世界树.动态().取动态主信息(D0) : nullptr;
        结果.D0主信息存在 = 结果.D0主信息 != nullptr;
        if (结果.D0主信息) {
            结果.动作主体 = 结果.D0主信息->动态主体.指针;
            结果.来源动作 = 结果.D0主信息->来源动作.指针;
            结果.输入场景 = 结果.D0主信息->来源输入场景.指针;
            结果.输出场景 = 结果.D0主信息->来源输出场景.指针;
            结果.目标特征 = 结果.D0主信息->动态特征.指针;
            结果.初始状态 = 结果.D0主信息->初始状态.指针;
            结果.结果状态 = 结果.D0主信息->结果状态.指针;
        }

        结果.方法运行 = 方法运行存在;
        if (!结果.输入场景) {
            结果.输入场景 = 读取方法运行场景字段(方法运行存在, 特征_输入场景());
        }
        if (!结果.输出场景) {
            结果.输出场景 = 读取方法运行场景字段(方法运行存在, 特征_输出结果场景());
        }
        if (!结果.输出场景) {
            结果.输出场景 = 读取方法运行场景字段(方法运行存在, 特征_输出场景());
        }
        if (!结果.输入场景) {
            void* 指针 = nullptr;
            if (读取任务指针字段(任务节点, 特征_输入场景(), 指针)) {
                结果.输入场景 = reinterpret_cast<场景节点类*>(指针);
            }
        }
        if (!结果.输出场景) {
            void* 指针 = nullptr;
            if (读取任务指针字段(任务节点, 特征_输出场景(), 指针)
                || 读取任务指针字段(任务节点, 特征_输出结果场景(), 指针)) {
                结果.输出场景 = reinterpret_cast<场景节点类*>(指针);
            }
        }

        结果.承受主体 = 推断D0承受主体(任务节点, 结果.D0主信息);
        结果.动作主体存在 = 结果.动作主体 != nullptr;
        结果.动作主体为自我 =
            结果.动作主体
            && 世界树.自我指针
            && 结果.动作主体 == reinterpret_cast<基础信息节点类*>(世界树.自我指针);
        结果.承受主体存在 = 结果.承受主体 != nullptr;
        结果.来源动作存在 = 结果.来源动作 != nullptr;
        结果.方法运行存在 = 结果.方法运行 != nullptr;
        结果.输入场景存在 = 结果.输入场景 != nullptr;
        结果.输出场景存在 = 结果.输出场景 != nullptr;
        结果.目标特征存在 = 结果.目标特征 != nullptr;
        结果.初始状态存在 = 结果.初始状态 != nullptr;
        结果.结果状态存在 = 结果.结果状态 != nullptr;
        结果.基础合法 =
            结果.D0存在
            && 结果.D0主信息存在
            && 结果.动作主体存在
            && 结果.动作主体为自我
            && 结果.承受主体存在
            && 结果.来源动作存在
            && 结果.方法运行存在
            && 结果.输入场景存在
            && 结果.输出场景存在
            && 结果.目标特征存在
            && 结果.初始状态存在
            && 结果.结果状态存在;
        结果.第一缺口 = 选择D0第一缺口(结果);
        return 结果;
    }

    inline bool 写入服务D0校验回执(
        基础信息节点类* 宿主,
        const 服务D0校验结果& 结果,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        if (!宿主) return false;
        bool ok = true;
        ok = 世界树.写入特征_I64(宿主, 特征_D0基础合法(), 结果.基础合法 ? 1 : 0, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_D0动作主体为自我(), 结果.动作主体为自我 ? 1 : 0, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_D0承受主体存在(), 结果.承受主体存在 ? 1 : 0, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_D0来源动作存在(), 结果.来源动作存在 ? 1 : 0, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_D0方法运行存在(), 结果.方法运行存在 ? 1 : 0, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_D0输入场景存在(), 结果.输入场景存在 ? 1 : 0, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_D0输出场景存在(), 结果.输出场景存在 ? 1 : 0, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_D0目标特征存在(), 结果.目标特征存在 ? 1 : 0, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_D0初始状态存在(), 结果.初始状态存在 ? 1 : 0, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_D0结果状态存在(), 结果.结果状态存在 ? 1 : 0, now) && ok;
        if (结果.D0) {
            ok = 世界树.写入特征_指针(宿主, 特征_D0服务业务动作动态(), 结果.D0, now) && ok;
            ok = 世界树.写入特征_指针(宿主, 特征_服务业务动作动态(), 结果.D0, now) && ok;
        }
        if (结果.第一缺口) {
            ok = 世界树.写入特征_指针(宿主, 特征_D0缺口(), 结果.第一缺口, now) && ok;
        }
        return ok;
    }

    inline bool 校验并回写任务服务D0(
        任务类::节点类* 任务节点,
        存在节点类* 方法运行存在 = nullptr,
        动态节点类* D0 = nullptr,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        auto 结果 = 校验服务D0基础合法性(任务节点, 方法运行存在, D0);
        bool ok = true;
        if (auto* 任务宿主 = 读取任务虚拟存在宿主(任务节点)) {
            ok = 写入服务D0校验回执(任务宿主, 结果, now) && ok;
        }
        if (结果.方法运行) {
            ok = 写入服务D0校验回执(
                reinterpret_cast<基础信息节点类*>(结果.方法运行),
                结果,
                now) && ok;
        }
        return ok && 结果.基础合法;
    }

    enum class 枚举_服务硬门槛状态 : std::int8_t {
        不成立 = -1,
        待确认 = 0,
        成立 = 1,
    };

    enum class 枚举_成功服务候选状态 : I64 {
        未形成 = 0,
        待确认 = 1,
        可接受候选 = 2,
        已确认 = 3,
        已否决 = 4,
        已过期 = 5,
    };

    enum class 枚举_成功服务层级 : I64 {
        L0 = 0,
        L1 = 1,
        L2 = 2,
        L3 = 3,
        L4 = 4,
        L5 = 5,
    };

    enum class 枚举_服务硬门槛 : std::uint8_t {
        人类对象成立 = 0,
        明确需求或利益 = 1,
        明确服务目标 = 2,
        权限边界成立 = 3,
        安全通过 = 4,
        服务已实际交付 = 5,
        D0自我服务业务动作存在 = 6,
        服务前后状态可比较 = 7,
        目标特征改善成立 = 8,
        改善结果可验证 = 9,
        改善可归因于自我动作 = 10,
        非重复服务 = 11,
        闭环回写成立 = 12,
    };

    struct 服务硬门槛汇总 {
        bool 有不成立 = false;
        bool 有待确认 = false;
        bool 全部成立 = false;
        std::size_t 已读取数量 = 0;
        std::size_t 成立数量 = 0;
        std::size_t 待确认数量 = 0;
        std::size_t 不成立数量 = 0;
    };

    struct 服务G0治理视图结果 {
        bool 成功 = false;
        存在节点类* 治理视图 = nullptr;
        const 语素入口节点类* 失败原因 = nullptr;
    };

    // 功能：按函数名执行对应处理。
    inline const 语素入口节点类* 服务硬门槛特征类型(枚举_服务硬门槛 门槛) noexcept
    {
        switch (门槛) {
        case 枚举_服务硬门槛::人类对象成立:
            return 特征_硬门槛_人类对象成立();
        case 枚举_服务硬门槛::明确需求或利益:
            return 特征_硬门槛_明确需求或利益();
        case 枚举_服务硬门槛::明确服务目标:
            return 特征_硬门槛_明确服务目标();
        case 枚举_服务硬门槛::权限边界成立:
            return 特征_硬门槛_权限边界成立();
        case 枚举_服务硬门槛::安全通过:
            return 特征_硬门槛_安全通过();
        case 枚举_服务硬门槛::服务已实际交付:
            return 特征_硬门槛_服务已实际交付();
        case 枚举_服务硬门槛::D0自我服务业务动作存在:
            return 特征_硬门槛_D0自我服务业务动作存在();
        case 枚举_服务硬门槛::服务前后状态可比较:
            return 特征_硬门槛_服务前后状态可比较();
        case 枚举_服务硬门槛::目标特征改善成立:
            return 特征_硬门槛_目标特征改善成立();
        case 枚举_服务硬门槛::改善结果可验证:
            return 特征_硬门槛_改善结果可验证();
        case 枚举_服务硬门槛::改善可归因于自我动作:
            return 特征_硬门槛_改善可归因于自我动作();
        case 枚举_服务硬门槛::非重复服务:
            return 特征_硬门槛_非重复服务();
        case 枚举_服务硬门槛::闭环回写成立:
            return 特征_硬门槛_闭环回写成立();
        default:
            return nullptr;
        }
    }

    // 功能：按函数名执行对应处理。
    inline 枚举_成功服务候选状态 候选状态_由硬门槛汇总(
        const 服务硬门槛汇总& 汇总) noexcept
    {
        if (汇总.有不成立) return 枚举_成功服务候选状态::已否决;
        if (汇总.有待确认 || !汇总.全部成立) return 枚举_成功服务候选状态::待确认;
        return 枚举_成功服务候选状态::可接受候选;
    }

    // 功能：从指定来源读取数据或状态。
    inline 存在节点类* 读取任务G0治理视图(任务类::节点类* 任务节点) noexcept
    {
        void* 指针 = nullptr;
        if (读取任务指针字段(任务节点, 特征_成功服务治理视图(), 指针)) {
            return reinterpret_cast<存在节点类*>(指针);
        }
        return nullptr;
    }

    inline 服务G0治理视图结果 获取或创建G0治理视图(
        任务类::节点类* 任务节点,
        存在节点类* 方法运行存在 = nullptr,
        动态节点类* D0 = nullptr,
        动态节点类* D1 = nullptr,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        服务G0治理视图结果 结果{};
        if (!任务节点) {
            结果.失败原因 = 值_服务字段绑定任务缺失();
            return 结果;
        }

        if (auto* 已有 = 读取任务G0治理视图(任务节点)) {
            结果.成功 = true;
            结果.治理视图 = 已有;
            return 结果;
        }

        auto* 任务存在 = 读取任务虚拟存在(任务节点);
        if (!任务存在) {
            结果.失败原因 = 值_服务字段绑定任务虚拟存在缺失();
            return 结果;
        }

        auto* 治理视图 = 世界树.取或创建子存在_按类型并按特征I64(
            reinterpret_cast<基础信息节点类*>(任务存在),
            类型_成功服务治理视图(),
            特征_开始时间(),
            static_cast<I64>(now));
        if (!治理视图) {
            结果.失败原因 = 值_服务字段绑定写入失败();
            return 结果;
        }

        auto* 宿主 = reinterpret_cast<基础信息节点类*>(治理视图);
        bool ok = true;
        ok = 世界树.写入特征_I64(宿主, 特征_开始时间(), static_cast<I64>(now), now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_服务定义规则版本(), 1, now) && ok;
        ok = 世界树.写入特征_I64(
            宿主,
            特征_成功服务候选状态(),
            static_cast<I64>(枚举_成功服务候选状态::未形成),
            now) && ok;
        ok = 世界树.写入特征_I64(
            宿主,
            特征_成功服务层级(),
            static_cast<I64>(枚举_成功服务层级::L0),
            now) && ok;
        ok = 世界树.写入特征_指针(宿主, 特征_任务信息节点(), 任务节点, now) && ok;
        ok = 世界树.写入特征_指针(宿主, 特征_任务虚拟存在(), 任务存在, now) && ok;
        if (auto* 来源需求 = 读取任务来源需求(任务节点)) {
            ok = 世界树.写入特征_指针(宿主, 特征_来源需求(), 来源需求, now) && ok;
        }
        if (!方法运行存在) {
            方法运行存在 = 读取任务方法运行存在(任务节点);
        }
        if (方法运行存在) {
            ok = 世界树.写入特征_指针(宿主, 特征_方法运行存在(), 方法运行存在, now) && ok;
            ok = 世界树.写入特征_指针(
                reinterpret_cast<基础信息节点类*>(方法运行存在),
                特征_成功服务治理视图(),
                治理视图,
                now) && ok;
        }
        if (!D0) {
            D0 = 读取服务D0动作动态(任务节点, 方法运行存在);
        }
        if (D0) {
            ok = 世界树.写入特征_指针(宿主, 特征_D0服务业务动作动态(), D0, now) && ok;
            ok = 世界树.写入特征_指针(宿主, 特征_服务业务动作动态(), D0, now) && ok;
        }
        if (D1) {
            ok = 世界树.写入特征_指针(宿主, 特征_D1任务状态动作动态(), D1, now) && ok;
            ok = 世界树.写入特征_指针(宿主, 特征_任务状态动作动态(), D1, now) && ok;
        }

        auto* 任务宿主 = reinterpret_cast<基础信息节点类*>(任务存在);
        ok = 世界树.写入特征_指针(任务宿主, 特征_成功服务治理视图(), 治理视图, now) && ok;
        结果.成功 = ok;
        结果.治理视图 = 治理视图;
        if (!结果.成功) {
            结果.失败原因 = 值_服务字段绑定写入失败();
        }
        return 结果;
    }

    inline bool 写入G0硬门槛状态(
        存在节点类* G0治理视图,
        枚举_服务硬门槛 门槛,
        枚举_服务硬门槛状态 状态,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        auto* 特征类型 = 服务硬门槛特征类型(门槛);
        auto* 宿主 = G0治理视图 ? reinterpret_cast<基础信息节点类*>(G0治理视图) : nullptr;
        return 宿主
            && 特征类型
            && 世界树.写入特征_I64(
                宿主,
                特征类型,
                static_cast<I64>(状态),
                now);
    }

    // 功能：从指定来源读取数据或状态。
    inline 枚举_服务硬门槛状态 读取G0硬门槛状态(
        存在节点类* G0治理视图,
        枚举_服务硬门槛 门槛) noexcept
    {
        auto* 特征类型 = 服务硬门槛特征类型(门槛);
        auto* 宿主 = G0治理视图 ? reinterpret_cast<基础信息节点类*>(G0治理视图) : nullptr;
        I64 值 = static_cast<I64>(枚举_服务硬门槛状态::待确认);
        if (!读取基础节点I64(宿主, 特征类型, 值)) {
            return 枚举_服务硬门槛状态::待确认;
        }
        if (值 > 0) return 枚举_服务硬门槛状态::成立;
        if (值 < 0) return 枚举_服务硬门槛状态::不成立;
        return 枚举_服务硬门槛状态::待确认;
    }

    // 功能：按函数名执行对应处理。
    inline 服务硬门槛汇总 汇总G0硬门槛状态(存在节点类* G0治理视图) noexcept
    {
        服务硬门槛汇总 汇总{};
        constexpr std::uint8_t 门槛数量 = 13;
        for (std::uint8_t i = 0; i < 门槛数量; ++i) {
            const auto 状态 = 读取G0硬门槛状态(
                G0治理视图,
                static_cast<枚举_服务硬门槛>(i));
            ++汇总.已读取数量;
            if (状态 == 枚举_服务硬门槛状态::成立) {
                ++汇总.成立数量;
                continue;
            }
            if (状态 == 枚举_服务硬门槛状态::不成立) {
                ++汇总.不成立数量;
                汇总.有不成立 = true;
                continue;
            }
            ++汇总.待确认数量;
            汇总.有待确认 = true;
        }
        汇总.全部成立 = 汇总.成立数量 == 门槛数量 && !汇总.有不成立 && !汇总.有待确认;
        return 汇总;
    }

    inline bool 回写G0硬门槛汇总(
        存在节点类* G0治理视图,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        if (!G0治理视图) return false;
        const auto 汇总 = 汇总G0硬门槛状态(G0治理视图);
        const auto 候选状态 = 候选状态_由硬门槛汇总(汇总);
        auto* 宿主 = reinterpret_cast<基础信息节点类*>(G0治理视图);
        return 世界树.写入特征_I64(
            宿主,
            特征_成功服务候选状态(),
            static_cast<I64>(候选状态),
            now);
    }

    constexpr I64 服务评分_满分 = 10000;
    constexpr I64 服务评分_确认阈值 = 7500;

    enum class 枚举_服务离散评分 : I64 {
        零 = 0,
        四分之一 = 2500,
        二分之一 = 5000,
        四分之三 = 7500,
        满 = 10000,
    };

    enum class 枚举_服务有效性档位 : I64 {
        无帮助 = 0,
        假定有交付 = 2500,
        部分解决需求 = 5000,
        主要解决需求 = 7500,
        明确解决需求 = 10000,
    };

    enum class 枚举_服务证据强度档位 : I64 {
        无证据 = 0,
        只有自我输出 = 2500,
        单侧状态或接受 = 5000,
        前后对比且可验证 = 7500,
        完整证据链 = 10000,
    };

    struct 服务三评分 {
        I64 完成度 = 0;
        I64 有效性 = 0;
        I64 证据强度 = 0;
        I64 基础分 = 0;
    };

    // 功能：按函数名执行对应处理。
    inline I64 约束服务评分(I64 分值) noexcept
    {
        if (分值 < 0) return 0;
        if (分值 > 服务评分_满分) return 服务评分_满分;
        return 分值;
    }

    // 功能：按函数名执行对应处理。
    inline I64 量化为服务离散评分(I64 原始分值) noexcept
    {
        const I64 分值 = 约束服务评分(原始分值);
        if (分值 <= 0) return static_cast<I64>(枚举_服务离散评分::零);
        if (分值 < 5000) return static_cast<I64>(枚举_服务离散评分::四分之一);
        if (分值 < 7000) return static_cast<I64>(枚举_服务离散评分::二分之一);
        if (分值 < 9000) return static_cast<I64>(枚举_服务离散评分::四分之三);
        return static_cast<I64>(枚举_服务离散评分::满);
    }

    // 功能：按函数名执行对应处理。
    inline I64 服务评分最小值(I64 左, I64 右) noexcept
    {
        return 左 < 右 ? 左 : 右;
    }

    // 功能：按函数名执行对应处理。
    inline long double 服务绝对差距(I64 左, I64 右) noexcept
    {
        const long double 差距 = static_cast<long double>(左) - static_cast<long double>(右);
        return 差距 >= 0.0L ? 差距 : -差距;
    }

    // 功能：计算权重、状态、差值或派生结果。
    inline I64 计算数值目标完成度评分(I64 服务前值, I64 服务后值, I64 目标值) noexcept
    {
        const long double 服务前差距 = 服务绝对差距(服务前值, 目标值);
        const long double 服务后差距 = 服务绝对差距(服务后值, 目标值);
        if (服务前差距 <= 0.0L) {
            return 服务后差距 <= 0.0L
                ? static_cast<I64>(枚举_服务离散评分::满)
                : static_cast<I64>(枚举_服务离散评分::零);
        }

        const long double 改善比例 =
            (服务前差距 - 服务后差距) / 服务前差距;
        if (改善比例 <= 0.0L) {
            return static_cast<I64>(枚举_服务离散评分::零);
        }
        const auto 原始分值 = static_cast<I64>(改善比例 * 服务评分_满分 + 0.5L);
        return 量化为服务离散评分(原始分值);
    }

    // 功能：计算权重、状态、差值或派生结果。
    inline I64 计算枚举布尔目标完成度评分(
        bool 目标达成,
        bool 阶段性改善) noexcept
    {
        if (目标达成) return static_cast<I64>(枚举_服务离散评分::满);
        if (阶段性改善) return static_cast<I64>(枚举_服务离散评分::二分之一);
        return static_cast<I64>(枚举_服务离散评分::零);
    }

    // 功能：按函数名执行对应处理。
    inline I64 有效性评分(枚举_服务有效性档位 档位) noexcept
    {
        return 约束服务评分(static_cast<I64>(档位));
    }

    // 功能：按函数名执行对应处理。
    inline I64 证据强度评分(枚举_服务证据强度档位 档位) noexcept
    {
        return 约束服务评分(static_cast<I64>(档位));
    }

    // 功能：确认候选事实、存在、状态或运行结果。
    inline bool 证据强度达到确认阈值(I64 证据强度) noexcept
    {
        return 约束服务评分(证据强度) >= 服务评分_确认阈值;
    }

    // 功能：计算权重、状态、差值或派生结果。
    inline 服务三评分 计算服务三评分(
        I64 完成度,
        I64 有效性,
        I64 证据强度) noexcept
    {
        服务三评分 结果{};
        结果.完成度 = 量化为服务离散评分(完成度);
        结果.有效性 = 量化为服务离散评分(有效性);
        结果.证据强度 = 量化为服务离散评分(证据强度);
        结果.基础分 = 服务评分最小值(
            结果.完成度,
            服务评分最小值(结果.有效性, 结果.证据强度));
        return 结果;
    }

    inline bool 写入G0三评分(
        存在节点类* G0治理视图,
        const 服务三评分& 评分,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        auto* 宿主 = G0治理视图 ? reinterpret_cast<基础信息节点类*>(G0治理视图) : nullptr;
        if (!宿主) return false;
        bool ok = true;
        ok = 世界树.写入特征_I64(宿主, 特征_完成度(), 评分.完成度, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_有效性(), 评分.有效性, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_证据强度(), 评分.证据强度, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_基础分(), 评分.基础分, now) && ok;
        return ok;
    }

    // 功能：从指定来源读取数据或状态。
    inline bool 读取G0三评分(存在节点类* G0治理视图, 服务三评分& 输出评分) noexcept
    {
        auto* 宿主 = G0治理视图 ? reinterpret_cast<基础信息节点类*>(G0治理视图) : nullptr;
        if (!宿主) return false;
        I64 完成度 = 0;
        I64 有效性 = 0;
        I64 证据强度 = 0;
        const bool ok =
            读取基础节点I64(宿主, 特征_完成度(), 完成度)
            && 读取基础节点I64(宿主, 特征_有效性(), 有效性)
            && 读取基础节点I64(宿主, 特征_证据强度(), 证据强度);
        if (!ok) return false;
        输出评分 = 计算服务三评分(完成度, 有效性, 证据强度);
        return true;
    }

    // 功能：按函数名执行对应处理。
    inline 枚举_成功服务层级 映射基础分到普通成功服务层级(I64 基础分) noexcept
    {
        const I64 分值 = 约束服务评分(基础分);
        if (分值 < 3000) return 枚举_成功服务层级::L0;
        if (分值 < 5000) return 枚举_成功服务层级::L1;
        if (分值 < 7000) return 枚举_成功服务层级::L2;
        if (分值 < 9000) return 枚举_成功服务层级::L3;
        return 枚举_成功服务层级::L4;
    }

    // 功能：按函数名执行对应处理。
    inline bool L5关键成功额外条件成立(
        bool 重大人类利益,
        bool 高级治理确认,
        bool 安全通过,
        bool 权限边界成立,
        bool 强归因成立,
        I64 证据强度,
        I64 非重复系数) noexcept
    {
        return 重大人类利益
            && 高级治理确认
            && 安全通过
            && 权限边界成立
            && 强归因成立
            && 约束服务评分(证据强度) == 服务评分_满分
            && 约束服务评分(非重复系数) >= 服务评分_确认阈值;
    }

    inline 枚举_成功服务层级 映射基础分到成功服务层级(
        I64 基础分,
        bool 允许L5关键成功 = false) noexcept
    {
        const auto 普通层级 = 映射基础分到普通成功服务层级(基础分);
        if (允许L5关键成功 && 普通层级 == 枚举_成功服务层级::L4) {
            return 枚举_成功服务层级::L5;
        }
        return 普通层级;
    }

    // 功能：按函数名执行对应处理。
    inline 枚举_成功服务候选状态 候选状态_由硬门槛评分与证据(
        const 服务硬门槛汇总& 硬门槛,
        const 服务三评分& 评分) noexcept
    {
        if (硬门槛.有不成立) {
            return 枚举_成功服务候选状态::已否决;
        }
        if (硬门槛.有待确认 || !硬门槛.全部成立) {
            return 枚举_成功服务候选状态::待确认;
        }
        if (!证据强度达到确认阈值(评分.证据强度)) {
            return 枚举_成功服务候选状态::待确认;
        }
        if (映射基础分到普通成功服务层级(评分.基础分) == 枚举_成功服务层级::L0) {
            return 枚举_成功服务候选状态::已否决;
        }
        return 枚举_成功服务候选状态::可接受候选;
    }

    inline bool 回写G0层级与候选状态(
        存在节点类* G0治理视图,
        bool 允许L5关键成功 = false,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        if (!G0治理视图) return false;
        服务三评分 评分{};
        if (!读取G0三评分(G0治理视图, 评分)) {
            return false;
        }
        const auto 硬门槛 = 汇总G0硬门槛状态(G0治理视图);
        const auto 层级 = 映射基础分到成功服务层级(评分.基础分, 允许L5关键成功);
        const auto 候选状态 = 候选状态_由硬门槛评分与证据(硬门槛, 评分);
        auto* 宿主 = reinterpret_cast<基础信息节点类*>(G0治理视图);
        bool ok = true;
        ok = 世界树.写入特征_I64(
            宿主,
            特征_成功服务层级(),
            static_cast<I64>(层级),
            now) && ok;
        ok = 世界树.写入特征_I64(
            宿主,
            特征_成功服务候选状态(),
            static_cast<I64>(候选状态),
            now) && ok;
        ok = 世界树.写入特征_I64(
            宿主,
            特征_证据强度达到确认阈值(),
            证据强度达到确认阈值(评分.证据强度) ? 1 : 0,
            now) && ok;
        ok = 世界树.写入特征_I64(
            宿主,
            特征_L5高级治理确认(),
            允许L5关键成功 ? 1 : 0,
            now) && ok;
        return ok;
    }

    struct 服务G0候选组装输入 {
        任务类::节点类* 任务节点 = nullptr;
        存在节点类* 方法运行存在 = nullptr;
        动态节点类* D0 = nullptr;
        动态节点类* D1 = nullptr;
        bool 写入评分 = false;
        服务三评分 评分{};
        枚举_服务硬门槛状态 安全通过 = 枚举_服务硬门槛状态::待确认;
        枚举_服务硬门槛状态 改善结果可验证 = 枚举_服务硬门槛状态::待确认;
        枚举_服务硬门槛状态 改善可归因于自我动作 = 枚举_服务硬门槛状态::待确认;
        枚举_服务硬门槛状态 非重复服务 = 枚举_服务硬门槛状态::待确认;
        枚举_服务硬门槛状态 闭环回写成立 = 枚举_服务硬门槛状态::待确认;
        bool 允许L5关键成功 = false;
    };

    struct 服务G0候选组装结果 {
        bool 成功 = false;
        存在节点类* G0治理视图 = nullptr;
        服务D0校验结果 D0校验{};
        服务硬门槛汇总 硬门槛{};
        服务三评分 评分{};
        枚举_成功服务候选状态 候选状态 = 枚举_成功服务候选状态::未形成;
        枚举_成功服务层级 层级 = 枚举_成功服务层级::L0;
        const 语素入口节点类* 失败原因 = nullptr;
    };

    // 功能：按函数名执行对应处理。
    inline 枚举_服务硬门槛状态 门槛状态_指针字段存在(
        任务类::节点类* 任务节点,
        const 语素入口节点类* 字段类型) noexcept
    {
        void* 指针 = nullptr;
        return 读取任务指针字段(任务节点, 字段类型, 指针)
            ? 枚举_服务硬门槛状态::成立
            : 枚举_服务硬门槛状态::待确认;
    }

    // 功能：按函数名执行对应处理。
    inline 枚举_服务硬门槛状态 门槛状态_任务字段有值(
        任务类::节点类* 任务节点,
        const 语素入口节点类* 字段类型) noexcept
    {
        const auto 检查 = 检查服务方法输入字段(任务节点, 字段类型);
        return 检查.字段有当前值
            ? 枚举_服务硬门槛状态::成立
            : 枚举_服务硬门槛状态::待确认;
    }

    // 功能：按函数名执行对应处理。
    inline 枚举_服务硬门槛状态 门槛状态_任务I64字段(
        任务类::节点类* 任务节点,
        const 语素入口节点类* 字段类型) noexcept
    {
        I64 值 = 0;
        if (!读取任务I64字段(任务节点, 字段类型, 值)) {
            return 枚举_服务硬门槛状态::待确认;
        }
        return 值 != 0
            ? 枚举_服务硬门槛状态::成立
            : 枚举_服务硬门槛状态::不成立;
    }

    // 功能：按函数名执行对应处理。
    inline 枚举_服务硬门槛状态 门槛状态_D0校验(const 服务D0校验结果& D0校验) noexcept
    {
        if (D0校验.基础合法) {
            return 枚举_服务硬门槛状态::成立;
        }
        if (D0校验.D0存在
            && D0校验.动作主体存在
            && !D0校验.动作主体为自我) {
            return 枚举_服务硬门槛状态::不成立;
        }
        return 枚举_服务硬门槛状态::待确认;
    }

    // 功能：把处理结果写入指定对象、场景或日志。
    inline bool 写入G0候选基础硬门槛(
        存在节点类* G0治理视图,
        const 服务G0候选组装输入& 输入,
        const 服务D0校验结果& D0校验,
        时间戳 now) noexcept
    {
        bool ok = true;
        const bool 有交互者 =
            门槛状态_指针字段存在(输入.任务节点, 特征_交互者()) == 枚举_服务硬门槛状态::成立;
        const bool 有服务对象 =
            门槛状态_指针字段存在(输入.任务节点, 特征_服务对象()) == 枚举_服务硬门槛状态::成立;
        ok = 写入G0硬门槛状态(
            G0治理视图,
            枚举_服务硬门槛::人类对象成立,
            (有交互者 || 有服务对象)
                ? 枚举_服务硬门槛状态::成立
                : 枚举_服务硬门槛状态::待确认,
            now) && ok;
        ok = 写入G0硬门槛状态(
            G0治理视图,
            枚举_服务硬门槛::明确需求或利益,
            读取任务来源需求(输入.任务节点)
                ? 枚举_服务硬门槛状态::成立
                : 枚举_服务硬门槛状态::待确认,
            now) && ok;
        const bool 目标字段成立 =
            门槛状态_指针字段存在(输入.任务节点, 特征_目标宿主()) == 枚举_服务硬门槛状态::成立
            && 门槛状态_指针字段存在(输入.任务节点, 特征_目标特征类型()) == 枚举_服务硬门槛状态::成立
            && 门槛状态_任务字段有值(输入.任务节点, 特征_目标值()) == 枚举_服务硬门槛状态::成立;
        ok = 写入G0硬门槛状态(
            G0治理视图,
            枚举_服务硬门槛::明确服务目标,
            目标字段成立 ? 枚举_服务硬门槛状态::成立 : 枚举_服务硬门槛状态::待确认,
            now) && ok;
        ok = 写入G0硬门槛状态(
            G0治理视图,
            枚举_服务硬门槛::权限边界成立,
            门槛状态_指针字段存在(输入.任务节点, 特征_权限边界()),
            now) && ok;
        ok = 写入G0硬门槛状态(G0治理视图, 枚举_服务硬门槛::安全通过, 输入.安全通过, now) && ok;
        ok = 写入G0硬门槛状态(
            G0治理视图,
            枚举_服务硬门槛::服务已实际交付,
            D0校验.输出场景存在 ? 枚举_服务硬门槛状态::成立 : 枚举_服务硬门槛状态::待确认,
            now) && ok;
        ok = 写入G0硬门槛状态(
            G0治理视图,
            枚举_服务硬门槛::D0自我服务业务动作存在,
            门槛状态_D0校验(D0校验),
            now) && ok;
        ok = 写入G0硬门槛状态(
            G0治理视图,
            枚举_服务硬门槛::服务前后状态可比较,
            门槛状态_任务I64字段(输入.任务节点, 特征_服务前后状态可比较()),
            now) && ok;
        ok = 写入G0硬门槛状态(
            G0治理视图,
            枚举_服务硬门槛::目标特征改善成立,
            门槛状态_任务I64字段(输入.任务节点, 特征_服务前后状态发生变化()),
            now) && ok;
        ok = 写入G0硬门槛状态(
            G0治理视图,
            枚举_服务硬门槛::改善结果可验证,
            输入.改善结果可验证,
            now) && ok;
        ok = 写入G0硬门槛状态(
            G0治理视图,
            枚举_服务硬门槛::改善可归因于自我动作,
            输入.改善可归因于自我动作,
            now) && ok;
        ok = 写入G0硬门槛状态(G0治理视图, 枚举_服务硬门槛::非重复服务, 输入.非重复服务, now) && ok;
        ok = 写入G0硬门槛状态(G0治理视图, 枚举_服务硬门槛::闭环回写成立, 输入.闭环回写成立, now) && ok;
        return ok;
    }

    inline 服务G0候选组装结果 组装G0成功服务候选(
        const 服务G0候选组装输入& 输入,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        服务G0候选组装结果 结果{};
        auto G0结果 = 获取或创建G0治理视图(
            输入.任务节点,
            输入.方法运行存在,
            输入.D0,
            输入.D1,
            now);
        结果.G0治理视图 = G0结果.治理视图;
        if (!G0结果.成功 || !结果.G0治理视图) {
            结果.失败原因 = G0结果.失败原因;
            return 结果;
        }

        结果.D0校验 = 校验服务D0基础合法性(
            输入.任务节点,
            输入.方法运行存在,
            输入.D0);
        bool ok = 写入服务D0校验回执(
            reinterpret_cast<基础信息节点类*>(结果.G0治理视图),
            结果.D0校验,
            now);
        ok = 写入G0候选基础硬门槛(结果.G0治理视图, 输入, 结果.D0校验, now) && ok;
        if (输入.写入评分) {
            结果.评分 = 计算服务三评分(
                输入.评分.完成度,
                输入.评分.有效性,
                输入.评分.证据强度);
            ok = 写入G0三评分(结果.G0治理视图, 结果.评分, now) && ok;
            ok = 回写G0层级与候选状态(
                结果.G0治理视图,
                输入.允许L5关键成功,
                now) && ok;
        }
        else {
            ok = 回写G0硬门槛汇总(结果.G0治理视图, now) && ok;
        }

        结果.硬门槛 = 汇总G0硬门槛状态(结果.G0治理视图);
        I64 候选值 = static_cast<I64>(枚举_成功服务候选状态::未形成);
        if (读取基础节点I64(
            reinterpret_cast<基础信息节点类*>(结果.G0治理视图),
            特征_成功服务候选状态(),
            候选值)) {
            结果.候选状态 = static_cast<枚举_成功服务候选状态>(候选值);
        }
        I64 层级值 = static_cast<I64>(枚举_成功服务层级::L0);
        if (读取基础节点I64(
            reinterpret_cast<基础信息节点类*>(结果.G0治理视图),
            特征_成功服务层级(),
            层级值)) {
            结果.层级 = static_cast<枚举_成功服务层级>(层级值);
        }
        结果.成功 = ok;
        if (!结果.成功) {
            结果.失败原因 = 值_服务字段绑定写入失败();
        }
        return 结果;
    }

    struct 服务候选池结果 {
        bool 成功 = false;
        存在节点类* 候选池 = nullptr;
        const 语素入口节点类* 失败原因 = nullptr;
    };

    struct 服务候选记录结果 {
        bool 成功 = false;
        存在节点类* 候选记录 = nullptr;
        const 语素入口节点类* 失败原因 = nullptr;
    };

    inline 服务候选池结果 获取或创建任务成功服务候选池(
        任务类::节点类* 任务节点,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        服务候选池结果 结果{};
        if (!任务节点) {
            结果.失败原因 = 值_服务字段绑定任务缺失();
            return 结果;
        }
        auto* 任务存在 = 读取任务虚拟存在(任务节点);
        if (!任务存在) {
            结果.失败原因 = 值_服务字段绑定任务虚拟存在缺失();
            return 结果;
        }
        void* 已有指针 = nullptr;
        auto* 任务宿主 = reinterpret_cast<基础信息节点类*>(任务存在);
        if (读取基础节点指针(任务宿主, 特征_成功服务候选池(), 已有指针)) {
            结果.成功 = true;
            结果.候选池 = reinterpret_cast<存在节点类*>(已有指针);
            return 结果;
        }

        auto* 候选池 = 世界树.取或创建子存在_按类型并按特征I64(
            任务宿主,
            类型_成功服务候选池(),
            特征_开始时间(),
            0);
        if (!候选池) {
            结果.失败原因 = 值_服务字段绑定写入失败();
            return 结果;
        }

        auto* 池宿主 = reinterpret_cast<基础信息节点类*>(候选池);
        bool ok = true;
        ok = 世界树.写入特征_I64(池宿主, 特征_开始时间(), static_cast<I64>(now), now) && ok;
        ok = 世界树.写入特征_指针(池宿主, 特征_任务信息节点(), 任务节点, now) && ok;
        ok = 世界树.写入特征_指针(池宿主, 特征_任务虚拟存在(), 任务存在, now) && ok;
        ok = 世界树.写入特征_指针(任务宿主, 特征_成功服务候选池(), 候选池, now) && ok;
        结果.成功 = ok;
        结果.候选池 = 候选池;
        if (!ok) 结果.失败原因 = 值_服务字段绑定写入失败();
        return 结果;
    }

    // 功能：从指定来源读取数据或状态。
    inline 枚举_成功服务候选状态 读取G0候选状态(存在节点类* G0治理视图) noexcept
    {
        I64 值 = static_cast<I64>(枚举_成功服务候选状态::未形成);
        auto* 宿主 = G0治理视图 ? reinterpret_cast<基础信息节点类*>(G0治理视图) : nullptr;
        if (!读取基础节点I64(宿主, 特征_成功服务候选状态(), 值)) {
            return 枚举_成功服务候选状态::未形成;
        }
        return static_cast<枚举_成功服务候选状态>(值);
    }

    // 功能：从指定来源读取数据或状态。
    inline 枚举_成功服务层级 读取G0服务层级(存在节点类* G0治理视图) noexcept
    {
        I64 值 = static_cast<I64>(枚举_成功服务层级::L0);
        auto* 宿主 = G0治理视图 ? reinterpret_cast<基础信息节点类*>(G0治理视图) : nullptr;
        if (!读取基础节点I64(宿主, 特征_成功服务层级(), 值)) {
            return 枚举_成功服务层级::L0;
        }
        return static_cast<枚举_成功服务层级>(值);
    }

    // 功能：按函数名执行对应处理。
    inline const 语素入口节点类* 推断成功服务候选证据缺口(存在节点类* G0治理视图) noexcept
    {
        服务三评分 评分{};
        if (读取G0三评分(G0治理视图, 评分)
            && !证据强度达到确认阈值(评分.证据强度)) {
            return 值_成功服务证据强度不足();
        }
        const auto 硬门槛 = 汇总G0硬门槛状态(G0治理视图);
        if (硬门槛.有待确认 || !硬门槛.全部成立) {
            return 值_成功服务硬门槛待确认();
        }
        return nullptr;
    }

    // 功能：把处理结果写入指定对象、场景或日志。
    inline bool 写入候选记录基础引用(
        基础信息节点类* 记录宿主,
        任务类::节点类* 任务节点,
        存在节点类* G0治理视图,
        时间戳 now) noexcept
    {
        if (!记录宿主 || !任务节点 || !G0治理视图) return false;
        bool ok = true;
        ok = 世界树.写入特征_指针(记录宿主, 特征_候选来源G0(), G0治理视图, now) && ok;
        ok = 世界树.写入特征_指针(记录宿主, 特征_成功服务治理视图(), G0治理视图, now) && ok;
        ok = 世界树.写入特征_指针(记录宿主, 特征_任务信息节点(), 任务节点, now) && ok;
        if (auto* 任务存在 = 读取任务虚拟存在(任务节点)) {
            ok = 世界树.写入特征_指针(记录宿主, 特征_任务虚拟存在(), 任务存在, now) && ok;
        }
        if (auto* 来源需求 = 读取任务来源需求(任务节点)) {
            ok = 世界树.写入特征_指针(记录宿主, 特征_来源需求(), 来源需求, now) && ok;
        }

        auto* G0宿主 = reinterpret_cast<基础信息节点类*>(G0治理视图);
        void* 指针 = nullptr;
        if (读取基础节点指针(G0宿主, 特征_D0服务业务动作动态(), 指针)
            || 读取基础节点指针(G0宿主, 特征_服务业务动作动态(), 指针)) {
            ok = 世界树.写入特征_指针(记录宿主, 特征_D0服务业务动作动态(), 指针, now) && ok;
        }
        指针 = nullptr;
        if (读取基础节点指针(G0宿主, 特征_D1任务状态动作动态(), 指针)
            || 读取基础节点指针(G0宿主, 特征_任务状态动作动态(), 指针)) {
            ok = 世界树.写入特征_指针(记录宿主, 特征_D1任务状态动作动态(), 指针, now) && ok;
        }
        指针 = nullptr;
        if (读取基础节点指针(G0宿主, 特征_方法运行存在(), 指针)) {
            ok = 世界树.写入特征_指针(记录宿主, 特征_方法运行存在(), 指针, now) && ok;
        }
        return ok;
    }

    inline 服务候选记录结果 登记成功服务候选记录(
        任务类::节点类* 任务节点,
        存在节点类* G0治理视图,
        I64 候选有效期 = 0,
        I64 反馈窗口 = 0,
        const 语素入口节点类* 下一步验证方法 = nullptr,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        服务候选记录结果 结果{};
        if (!任务节点) {
            结果.失败原因 = 值_服务字段绑定任务缺失();
            return 结果;
        }
        if (!G0治理视图) {
            结果.失败原因 = 值_成功服务候选不可登记();
            return 结果;
        }
        const auto 候选状态 = 读取G0候选状态(G0治理视图);
        if (候选状态 != 枚举_成功服务候选状态::待确认
            && 候选状态 != 枚举_成功服务候选状态::可接受候选) {
            结果.失败原因 = 值_成功服务候选不可登记();
            return 结果;
        }

        auto* G0宿主 = reinterpret_cast<基础信息节点类*>(G0治理视图);
        void* 已有记录指针 = nullptr;
        if (读取基础节点指针(G0宿主, 特征_成功服务候选记录(), 已有记录指针)) {
            结果.成功 = true;
            结果.候选记录 = reinterpret_cast<存在节点类*>(已有记录指针);
            return 结果;
        }

        auto 池结果 = 获取或创建任务成功服务候选池(任务节点, now);
        if (!池结果.成功 || !池结果.候选池) {
            结果.失败原因 = 池结果.失败原因;
            return 结果;
        }

        auto* 候选记录 = 世界树.取或创建子存在_按类型并按特征I64(
            reinterpret_cast<基础信息节点类*>(池结果.候选池),
            类型_成功服务候选记录(),
            特征_候选创建时间(),
            static_cast<I64>(now));
        if (!候选记录) {
            结果.失败原因 = 值_服务字段绑定写入失败();
            return 结果;
        }

        auto* 记录宿主 = reinterpret_cast<基础信息节点类*>(候选记录);
        bool ok = true;
        ok = 写入候选记录基础引用(记录宿主, 任务节点, G0治理视图, now) && ok;
        ok = 世界树.写入特征_I64(记录宿主, 特征_候选创建时间(), static_cast<I64>(now), now) && ok;
        ok = 世界树.写入特征_I64(记录宿主, 特征_成功服务候选状态(), static_cast<I64>(候选状态), now) && ok;
        ok = 世界树.写入特征_I64(记录宿主, 特征_成功服务层级(), static_cast<I64>(读取G0服务层级(G0治理视图)), now) && ok;
        if (候选有效期 > 0) {
            ok = 世界树.写入特征_I64(记录宿主, 特征_候选有效期(), 候选有效期, now) && ok;
            ok = 世界树.写入特征_I64(记录宿主, 特征_候选到期时间(), static_cast<I64>(now) + 候选有效期, now) && ok;
        }
        if (反馈窗口 > 0) {
            ok = 世界树.写入特征_I64(记录宿主, 特征_反馈窗口(), 反馈窗口, now) && ok;
        }
        if (auto* 证据缺口 = 推断成功服务候选证据缺口(G0治理视图)) {
            ok = 世界树.写入特征_指针(记录宿主, 特征_证据缺口(), 证据缺口, now) && ok;
        }
        if (下一步验证方法) {
            ok = 世界树.写入特征_指针(记录宿主, 特征_下一步验证方法(), 下一步验证方法, now) && ok;
        }
        服务三评分 评分{};
        if (读取G0三评分(G0治理视图, 评分)) {
            ok = 写入G0三评分(候选记录, 评分, now) && ok;
        }
        ok = 世界树.写入特征_指针(G0宿主, 特征_成功服务候选记录(), 候选记录, now) && ok;
        结果.成功 = ok;
        结果.候选记录 = 候选记录;
        if (!ok) 结果.失败原因 = 值_服务字段绑定写入失败();
        return 结果;
    }

    enum class 枚举_候选复核结果 : I64 {
        未定义 = 0,
        待确认 = 1,
        硬门槛失败 = 2,
        证据不足 = 3,
        层级无效 = 4,
        已过期 = 5,
        已确认可结算 = 6,
    };

    struct 服务候选复核结果 {
        bool 成功 = false;
        存在节点类* 候选记录 = nullptr;
        存在节点类* G0治理视图 = nullptr;
        枚举_候选复核结果 复核结果 = 枚举_候选复核结果::未定义;
        枚举_成功服务候选状态 候选状态 = 枚举_成功服务候选状态::未形成;
        bool 可结算 = false;
        const 语素入口节点类* 失败原因 = nullptr;
    };

    // 功能：从指定来源读取数据或状态。
    inline 存在节点类* 读取候选记录G0(存在节点类* 候选记录) noexcept
    {
        void* 指针 = nullptr;
        auto* 宿主 = 候选记录 ? reinterpret_cast<基础信息节点类*>(候选记录) : nullptr;
        if (读取基础节点指针(宿主, 特征_候选来源G0(), 指针)
            || 读取基础节点指针(宿主, 特征_成功服务治理视图(), 指针)) {
            return reinterpret_cast<存在节点类*>(指针);
        }
        return nullptr;
    }

    // 功能：记录日志、动态、证据或运行痕迹。
    inline bool 候选记录已过期(存在节点类* 候选记录, 时间戳 now) noexcept
    {
        I64 到期时间 = 0;
        auto* 宿主 = 候选记录 ? reinterpret_cast<基础信息节点类*>(候选记录) : nullptr;
        if (!读取基础节点I64(宿主, 特征_候选到期时间(), 到期时间) || 到期时间 <= 0) {
            return false;
        }
        return static_cast<I64>(now) > 到期时间;
    }

    // 功能：把处理结果写入指定对象、场景或日志。
    inline bool 写入候选复核状态(
        存在节点类* 候选记录,
        存在节点类* G0治理视图,
        枚举_候选复核结果 复核结果,
        枚举_成功服务候选状态 候选状态,
        bool 可结算,
        时间戳 now) noexcept
    {
        auto* 记录宿主 = 候选记录 ? reinterpret_cast<基础信息节点类*>(候选记录) : nullptr;
        if (!记录宿主) return false;
        bool ok = true;
        ok = 世界树.写入特征_I64(记录宿主, 特征_候选复核时间(), static_cast<I64>(now), now) && ok;
        ok = 世界树.写入特征_I64(记录宿主, 特征_候选复核结果(), static_cast<I64>(复核结果), now) && ok;
        ok = 世界树.写入特征_I64(记录宿主, 特征_成功服务候选状态(), static_cast<I64>(候选状态), now) && ok;
        ok = 世界树.写入特征_I64(记录宿主, 特征_候选可结算(), 可结算 ? 1 : 0, now) && ok;
        if (G0治理视图) {
            auto* G0宿主 = reinterpret_cast<基础信息节点类*>(G0治理视图);
            ok = 世界树.写入特征_I64(G0宿主, 特征_成功服务候选状态(), static_cast<I64>(候选状态), now) && ok;
            ok = 世界树.写入特征_I64(G0宿主, 特征_候选可结算(), 可结算 ? 1 : 0, now) && ok;
        }
        return ok;
    }

    inline 服务候选复核结果 复核成功服务候选记录(
        存在节点类* 候选记录,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        服务候选复核结果 结果{};
        结果.候选记录 = 候选记录;
        if (!候选记录) {
            结果.失败原因 = 值_成功服务候选不可登记();
            return 结果;
        }
        结果.G0治理视图 = 读取候选记录G0(候选记录);
        if (!结果.G0治理视图) {
            结果.失败原因 = 值_成功服务候选不可登记();
            return 结果;
        }

        if (候选记录已过期(候选记录, now)) {
            结果.复核结果 = 枚举_候选复核结果::已过期;
            结果.候选状态 = 枚举_成功服务候选状态::已过期;
            结果.成功 = 写入候选复核状态(
                候选记录,
                结果.G0治理视图,
                结果.复核结果,
                结果.候选状态,
                false,
                now);
            return 结果;
        }

        const auto 硬门槛 = 汇总G0硬门槛状态(结果.G0治理视图);
        if (硬门槛.有不成立) {
            结果.复核结果 = 枚举_候选复核结果::硬门槛失败;
            结果.候选状态 = 枚举_成功服务候选状态::已否决;
            结果.成功 = 写入候选复核状态(
                候选记录,
                结果.G0治理视图,
                结果.复核结果,
                结果.候选状态,
                false,
                now);
            return 结果;
        }
        if (硬门槛.有待确认 || !硬门槛.全部成立) {
            结果.复核结果 = 枚举_候选复核结果::待确认;
            结果.候选状态 = 枚举_成功服务候选状态::待确认;
            结果.成功 = 写入候选复核状态(
                候选记录,
                结果.G0治理视图,
                结果.复核结果,
                结果.候选状态,
                false,
                now);
            return 结果;
        }

        服务三评分 评分{};
        if (!读取G0三评分(结果.G0治理视图, 评分)
            || !证据强度达到确认阈值(评分.证据强度)) {
            结果.复核结果 = 枚举_候选复核结果::证据不足;
            结果.候选状态 = 枚举_成功服务候选状态::待确认;
            结果.成功 = 写入候选复核状态(
                候选记录,
                结果.G0治理视图,
                结果.复核结果,
                结果.候选状态,
                false,
                now);
            return 结果;
        }

        const auto 层级 = 读取G0服务层级(结果.G0治理视图);
        if (层级 == 枚举_成功服务层级::L0) {
            结果.复核结果 = 枚举_候选复核结果::层级无效;
            结果.候选状态 = 枚举_成功服务候选状态::已否决;
            结果.成功 = 写入候选复核状态(
                候选记录,
                结果.G0治理视图,
                结果.复核结果,
                结果.候选状态,
                false,
                now);
            return 结果;
        }

        结果.复核结果 = 枚举_候选复核结果::已确认可结算;
        结果.候选状态 = 枚举_成功服务候选状态::已确认;
        结果.可结算 = true;
        结果.成功 = 写入候选复核状态(
            候选记录,
            结果.G0治理视图,
            结果.复核结果,
            结果.候选状态,
            true,
            now);
        return 结果;
    }

    struct 服务值结算计算输入 {
        存在节点类* G0治理视图 = nullptr;
        存在节点类* 候选记录 = nullptr;
        I64 当前服务值 = 0;
        I64 服务值上限 = 0;
        I64 标准服务单位 = 0;
        I64 非重复系数 = 服务评分_满分;
        I64 安全调节 = 服务评分_满分;
        I64 单次lambda上限 = 服务评分_满分;
    };

    struct 服务值结算计算结果 {
        bool 可结算 = false;
        I64 lambda候选 = 0;
        I64 lambda使用 = 0;
        I64 结算前服务值 = 0;
        I64 服务值入账增量 = 0;
        I64 结算后服务值 = 0;
        const 语素入口节点类* 失败原因 = nullptr;
    };

    // 功能：按函数名执行对应处理。
    inline I64 成功服务层级系数(枚举_成功服务层级 层级) noexcept
    {
        switch (层级) {
        case 枚举_成功服务层级::L1:
            return 2500;
        case 枚举_成功服务层级::L2:
            return 5000;
        case 枚举_成功服务层级::L3:
            return 10000;
        case 枚举_成功服务层级::L4:
            return 20000;
        case 枚举_成功服务层级::L5:
            return 40000;
        case 枚举_成功服务层级::L0:
        default:
            return 0;
        }
    }

    // 功能：按函数名执行对应处理。
    inline I64 长双非负转I64(long double 值) noexcept
    {
        if (值 <= 0.0L) return 0;
        if (值 >= 9223372036854775807.0L) return 9223372036854775807LL;
        return static_cast<I64>(值 + 0.5L);
    }

    // 功能：记录日志、动态、证据或运行痕迹。
    inline bool 候选记录可结算(存在节点类* 候选记录) noexcept
    {
        I64 可结算 = 0;
        auto* 宿主 = 候选记录 ? reinterpret_cast<基础信息节点类*>(候选记录) : nullptr;
        return 读取基础节点I64(宿主, 特征_候选可结算(), 可结算) && 可结算 > 0;
    }

    // 功能：计算权重、状态、差值或派生结果。
    inline I64 计算成功服务lambda候选(
        I64 标准服务单位,
        枚举_成功服务层级 层级,
        I64 有效性,
        I64 证据强度,
        I64 非重复系数,
        I64 安全调节,
        I64 服务值上限) noexcept
    {
        if (标准服务单位 <= 0 || 服务值上限 <= 0) return 0;
        const long double q =
            static_cast<long double>(标准服务单位)
            * static_cast<long double>(成功服务层级系数(层级)) / 服务评分_满分
            * static_cast<long double>(约束服务评分(有效性)) / 服务评分_满分
            * static_cast<long double>(约束服务评分(证据强度)) / 服务评分_满分
            * static_cast<long double>(约束服务评分(非重复系数)) / 服务评分_满分
            * static_cast<long double>(约束服务评分(安全调节)) / 服务评分_满分;
        const long double lambda = q * 服务评分_满分 / static_cast<long double>(服务值上限);
        return 约束服务评分(长双非负转I64(lambda));
    }

    // 功能：计算权重、状态、差值或派生结果。
    inline 服务值结算计算结果 计算成功服务值饱和入账(
        const 服务值结算计算输入& 输入) noexcept
    {
        服务值结算计算结果 结果{};
        结果.结算前服务值 = 输入.当前服务值;
        结果.结算后服务值 = 输入.当前服务值;
        if (!输入.G0治理视图 || !输入.候选记录) {
            结果.失败原因 = 值_成功服务候选不可登记();
            return 结果;
        }
        if (读取G0候选状态(输入.G0治理视图) != 枚举_成功服务候选状态::已确认
            || !候选记录可结算(输入.候选记录)) {
            结果.失败原因 = 值_成功服务候选不可登记();
            return 结果;
        }
        if (输入.服务值上限 <= 0 || 输入.当前服务值 < 0 || 输入.当前服务值 >= 输入.服务值上限) {
            return 结果;
        }

        服务三评分 评分{};
        if (!读取G0三评分(输入.G0治理视图, 评分)) {
            结果.失败原因 = 值_成功服务证据强度不足();
            return 结果;
        }
        const auto 层级 = 读取G0服务层级(输入.G0治理视图);
        结果.lambda候选 = 计算成功服务lambda候选(
            输入.标准服务单位,
            层级,
            评分.有效性,
            评分.证据强度,
            输入.非重复系数,
            输入.安全调节,
            输入.服务值上限);
        结果.lambda使用 = 结果.lambda候选;
        const I64 lambda上限 = 约束服务评分(输入.单次lambda上限);
        if (lambda上限 > 0 && 结果.lambda使用 > lambda上限) {
            结果.lambda使用 = lambda上限;
        }
        if (结果.lambda使用 <= 0) {
            return 结果;
        }

        const I64 剩余空间 = 输入.服务值上限 - 输入.当前服务值;
        结果.服务值入账增量 =
            长双非负转I64(
                static_cast<long double>(剩余空间)
                * static_cast<long double>(结果.lambda使用)
                / 服务评分_满分);
        if (结果.服务值入账增量 > 剩余空间) {
            结果.服务值入账增量 = 剩余空间;
        }
        结果.结算后服务值 = 输入.当前服务值 + 结果.服务值入账增量;
        结果.可结算 = 结果.服务值入账增量 > 0;
        return 结果;
    }

    inline bool 写入服务值结算候选结果(
        基础信息节点类* 宿主,
        const 服务值结算计算输入& 输入,
        const 服务值结算计算结果& 结果,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        if (!宿主) return false;
        bool ok = true;
        ok = 世界树.写入特征_I64(宿主, 特征_标准服务单位(), 输入.标准服务单位, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_非重复系数(), 约束服务评分(输入.非重复系数), now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_安全调节(), 约束服务评分(输入.安全调节), now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_服务值上限(), 输入.服务值上限, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_lambda候选(), 结果.lambda候选, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_lambda使用(), 结果.lambda使用, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_结算前服务值(), 结果.结算前服务值, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_服务值入账增量(), 结果.服务值入账增量, now) && ok;
        ok = 世界树.写入特征_I64(宿主, 特征_结算后服务值(), 结果.结算后服务值, now) && ok;
        if (输入.G0治理视图) {
            ok = 世界树.写入特征_指针(宿主, 特征_来源治理判断(), 输入.G0治理视图, now) && ok;
        }
        return ok;
    }

    inline 动态节点类* 创建服务值结算D2动作动态(
        方法节点类* 结算方法,
        场景节点类* 结算场景,
        基础信息节点类* 值宿主,
        特征节点类* 服务值特征,
        I64 结算前服务值,
        I64 结算后服务值,
        存在节点类* G0治理视图,
        动态节点类* D0,
        动态节点类* D1,
        场景节点类* 输入场景,
        场景节点类* 输出场景,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        if (!结算方法 || !结算场景 || !值宿主 || !服务值特征 || !G0治理视图) {
            return nullptr;
        }
        auto* 前状态 = 世界树.状态().创建状态(
            结算场景,
            值宿主,
            服务值特征,
            特征值{ 结算前服务值 },
            now,
            now);
        auto* 后状态 = 世界树.状态().创建状态(
            结算场景,
            值宿主,
            服务值特征,
            特征值{ 结算后服务值 },
            now,
            now);
        auto* 动态 = 世界树.动态().创建方法动作动态(
            结算场景,
            值宿主,
            服务值特征,
            结算方法,
            nullptr,
            now,
            now,
            true,
            0,
            枚举_动作事件相位::完成,
            输入场景,
            输出场景,
            前状态,
            后状态);
        if (!动态) return nullptr;
        if (D0) {
            (void)世界树.动态().追加来源低层动态(动态, D0);
        }
        if (D1 && D1 != D0) {
            (void)世界树.动态().追加来源低层动态(动态, D1);
        }
        auto* 动态宿主 = reinterpret_cast<基础信息节点类*>(动态);
        (void)世界树.写入特征_指针(动态宿主, 特征_来源治理判断(), G0治理视图, now);
        (void)世界树.写入特征_指针(动态宿主, 特征_服务值结算动作动态(), 动态, now);
        (void)世界树.写入特征_I64(动态宿主, 特征_结算前服务值(), 结算前服务值, now);
        (void)世界树.写入特征_I64(
            动态宿主,
            特征_服务值入账增量(),
            结算后服务值 > 结算前服务值 ? 结算后服务值 - 结算前服务值 : 0,
            now);
        (void)世界树.写入特征_I64(动态宿主, 特征_结算后服务值(), 结算后服务值, now);
        return 动态;
    }

}
