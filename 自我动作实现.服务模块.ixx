    }

    enum class 枚举_服务任务字段 : std::uint8_t {
        未定义 = 0,
        交互者 = 1,
        权限者 = 2,
        服务对象 = 3,
        权限边界 = 4,
        目标宿主 = 5,
        目标特征类型 = 6,
        目标值 = 7,
        输入场景 = 8,
    };

    enum class 枚举_服务字段值类型 : std::uint8_t {
        指针 = 0,
        I64 = 1,
    };

    struct 服务字段动作结果 {
        bool 成功 = false;
        任务类::节点类* 任务节点 = nullptr;
        存在节点类* 任务虚拟存在 = nullptr;
        const 语素入口节点类* 字段类型 = nullptr;
        特征节点类* 字段特征 = nullptr;
        const void* 指针值 = nullptr;
        I64 I64值 = 0;
        枚举_服务字段值类型 值类型 = 枚举_服务字段值类型::指针;
        const 语素入口节点类* 失败原因 = nullptr;
    };

    inline const 语素入口节点类* 服务任务字段特征类型(枚举_服务任务字段 字段) noexcept
    {
        switch (字段) {
        case 枚举_服务任务字段::交互者:
            return 特征_交互者();
        case 枚举_服务任务字段::权限者:
            return 特征_权限者();
        case 枚举_服务任务字段::服务对象:
            return 特征_服务对象();
        case 枚举_服务任务字段::权限边界:
            return 特征_权限边界();
        case 枚举_服务任务字段::目标宿主:
            return 特征_目标宿主();
        case 枚举_服务任务字段::目标特征类型:
            return 特征_目标特征类型();
        case 枚举_服务任务字段::目标值:
            return 特征_目标值();
        case 枚举_服务任务字段::输入场景:
            return 特征_输入场景();
        default:
            return nullptr;
        }
    }

    inline bool 读取基础节点I64(
        基础信息节点类* 宿主,
        const 语素入口节点类* 特征类型,
        I64& 输出值) noexcept
    {
        输出值 = 0;
        return 宿主
            && 特征类型
            && 世界树.读取特征_I64(宿主, 特征类型, 输出值);
    }

    inline bool 读取输入包I64(
        场景节点类* 输入参数场景,
        const 语素入口节点类* 包类型,
        const 语素入口节点类* 参数类型,
        I64& 输出值) noexcept
    {
        auto* 包根 = 输入包根(输入参数场景, 包类型);
        return 包根
            && 读取基础节点I64(
                reinterpret_cast<基础信息节点类*>(包根),
                参数类型,
                输出值);
    }

    inline bool 读取调用信息I64(
        场景节点类* 输入参数场景,
        const 语素入口节点类* 参数类型,
        I64& 输出值) noexcept
    {
        return 读取输入包I64(
            输入参数场景,
            特征_调用信息(),
            参数类型,
            输出值);
    }

    inline bool 读取服务字段输入指针(
        场景节点类* 输入参数场景,
        const 语素入口节点类* 字段类型,
        void*& 输出指针) noexcept
    {
        输出指针 = nullptr;
        auto* 场景宿主 = 输入参数场景
            ? reinterpret_cast<基础信息节点类*>(输入参数场景)
            : nullptr;
        auto* 输入条件包 = reinterpret_cast<基础信息节点类*>(输入条件包根(输入参数场景));
        return 读取基础节点指针(场景宿主, 字段类型, 输出指针)
            || 读取调用信息指针(输入参数场景, 字段类型, 输出指针)
            || 读取包指针(输入条件包, 字段类型, 输出指针);
    }

    inline bool 读取服务字段输入I64(
        场景节点类* 输入参数场景,
        const 语素入口节点类* 字段类型,
        I64& 输出值) noexcept
    {
        auto* 场景宿主 = 输入参数场景
            ? reinterpret_cast<基础信息节点类*>(输入参数场景)
            : nullptr;
        auto* 输入条件包 = reinterpret_cast<基础信息节点类*>(输入条件包根(输入参数场景));
        return 读取基础节点I64(场景宿主, 字段类型, 输出值)
            || 读取调用信息I64(输入参数场景, 字段类型, 输出值)
            || 读取基础节点I64(输入条件包, 字段类型, 输出值);
    }

    inline 服务字段动作结果 执行任务字段绑定(
        枚举_服务任务字段 字段,
        场景节点类* 输入参数场景,
        存在节点类* 来源方法虚拟存在,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        服务字段动作结果 结果{};
        结果.字段类型 = 服务任务字段特征类型(字段);
        if (!结果.字段类型) {
            结果.失败原因 = 值_服务字段绑定字段类型缺失();
            return 结果;
        }

        结果.任务节点 = 读取服务输入任务(输入参数场景);
        if (!结果.任务节点) {
            结果.失败原因 = 值_服务字段绑定任务缺失();
            return 结果;
        }
        结果.任务虚拟存在 = 读取任务虚拟存在(结果.任务节点);
        if (!结果.任务虚拟存在) {
            结果.失败原因 = 值_服务字段绑定任务虚拟存在缺失();
            return 结果;
        }

        void* 指针 = nullptr;
        if (字段 == 枚举_服务任务字段::目标值
            && !读取服务字段输入指针(输入参数场景, 结果.字段类型, 指针)) {
            I64 值 = 0;
            if (!读取服务字段输入I64(输入参数场景, 结果.字段类型, 值)) {
                结果.失败原因 = 值_服务字段绑定字段值缺失();
                return 结果;
            }
            auto 绑定结果 = 绑定任务目标值I64(结果.任务节点, 值, now);
            结果.成功 = 绑定结果.成功;
            结果.字段特征 = 绑定结果.字段特征;
            结果.失败原因 = 绑定结果.失败原因;
            结果.I64值 = 值;
            结果.值类型 = 枚举_服务字段值类型::I64;
        }
        else {
            if (!指针 && !读取服务字段输入指针(输入参数场景, 结果.字段类型, 指针)) {
                结果.失败原因 = 值_服务字段绑定字段值缺失();
                return 结果;
            }

            auto 绑定结果 = 绑定任务指针字段(
                结果.任务节点,
                结果.字段类型,
                指针,
                now);
            结果.成功 = 绑定结果.成功;
            结果.字段特征 = 绑定结果.字段特征;
            结果.失败原因 = 绑定结果.失败原因;
            结果.指针值 = 指针;
            结果.值类型 = 枚举_服务字段值类型::指针;
        }

        if (结果.成功 && 来源方法虚拟存在) {
            (void)记录任务字段来源方法(结果.字段特征, 来源方法虚拟存在, now);
        }
        return 结果;
    }

    struct 服务方法声明装配结果 {
        bool 成功 = false;
        std::size_t 已扫描声明根数 = 0;
        std::size_t 已扫描字段数 = 0;
        std::size_t 已挂载字段数 = 0;
        std::size_t 写入失败字段数 = 0;
        const 语素入口节点类* 失败原因 = nullptr;
    };

    struct 服务字段检查结果 {
        bool 任务存在 = false;
        bool 任务虚拟存在存在 = false;
        bool 字段已挂载 = false;
        bool 字段有当前值 = false;
        特征节点类* 字段特征 = nullptr;
        const 语素入口节点类* 失败原因 = nullptr;
    };

    inline const 语素入口节点类* 读取声明字段类型(特征节点类* 声明字段) noexcept
    {
        const auto* 主信息 = 世界树.特征().取特征主信息(声明字段);
        return 主信息 ? 主信息->类型 : nullptr;
    }

    inline bool 读取声明字段是否必需(特征节点类* 声明字段) noexcept
    {
        I64 是否必需 = 1;
        (void)读取基础节点I64(
            reinterpret_cast<基础信息节点类*>(声明字段),
            特征_是否必需(),
            是否必需);
        return 是否必需 != 0;
    }

    inline bool 装配方法声明根特征到任务(
        任务类::节点类* 任务节点,
        存在节点类* 方法虚拟存在,
        const 语素入口节点类* 声明根类型,
        const 语素入口节点类* 字段角色,
        I64 激活阶段,
        服务方法声明装配结果& 结果,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        if (!任务节点) {
            结果.失败原因 = 值_服务字段绑定任务缺失();
            return false;
        }
        if (!读取任务虚拟存在(任务节点)) {
            结果.失败原因 = 值_服务字段绑定任务虚拟存在缺失();
            return false;
        }
        if (!方法虚拟存在 || !声明根类型 || !字段角色) {
            结果.失败原因 = 值_服务字段绑定字段类型缺失();
            return false;
        }

        auto* 方法宿主 = reinterpret_cast<基础信息节点类*>(方法虚拟存在);
        auto* 声明根 = 查找子特征(方法宿主, 声明根类型);
        if (!声明根) {
            return true;
        }

        ++结果.已扫描声明根数;
        for (auto* 声明字段 : 世界树.特征().获取子特征(reinterpret_cast<基础信息节点类*>(声明根))) {
            const auto* 字段类型 = 读取声明字段类型(声明字段);
            if (!字段类型) {
                continue;
            }

            ++结果.已扫描字段数;
            auto 挂载结果 = 取或创建任务字段特征(任务节点, 字段类型);
            if (!挂载结果.成功) {
                ++结果.写入失败字段数;
                结果.失败原因 = 挂载结果.失败原因;
                continue;
            }

            const bool 是否必需 = 读取声明字段是否必需(声明字段);
            bool ok = true;
            ok = 记录任务字段来源方法(挂载结果.字段特征, 方法虚拟存在, now) && ok;
            ok = 记录任务字段激活信息(
                挂载结果.字段特征,
                字段角色,
                值_激活原因_方法声明(),
                激活阶段,
                是否必需,
                now) && ok;
            if (ok) {
                ++结果.已挂载字段数;
            }
            else {
                ++结果.写入失败字段数;
                结果.失败原因 = 值_服务字段绑定写入失败();
            }
        }
        return true;
    }

    inline 服务方法声明装配结果 装配方法声明特征到任务(
        任务类::节点类* 任务节点,
        存在节点类* 方法虚拟存在,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        服务方法声明装配结果 结果{};
        bool ok = true;
        ok = 装配方法声明根特征到任务(
            任务节点,
            方法虚拟存在,
            特征_形参表(),
            值_输入字段角色(),
            1,
            结果,
            now) && ok;
        ok = 装配方法声明根特征到任务(
            任务节点,
            方法虚拟存在,
            特征_结果表(),
            值_输出字段角色(),
            2,
            结果,
            now) && ok;
        ok = 装配方法声明根特征到任务(
            任务节点,
            方法虚拟存在,
            特征_验证特征集合(),
            值_验证字段角色(),
            3,
            结果,
            now) && ok;
        ok = 装配方法声明根特征到任务(
            任务节点,
            方法虚拟存在,
            特征_归因特征集合(),
            值_归因字段角色(),
            4,
            结果,
            now) && ok;
        ok = 装配方法声明根特征到任务(
            任务节点,
            方法虚拟存在,
            特征_安全权限特征集合(),
            值_安全权限字段角色(),
            5,
            结果,
            now) && ok;
        ok = 装配方法声明根特征到任务(
            任务节点,
            方法虚拟存在,
            特征_失败处理特征集合(),
            值_失败处理字段角色(),
            6,
            结果,
            now) && ok;
        ok = 装配方法声明根特征到任务(
            任务节点,
            方法虚拟存在,
            特征_服务治理支撑特征集合(),
            值_服务治理支撑字段角色(),
            7,
            结果,
            now) && ok;

        结果.成功 = ok && 结果.写入失败字段数 == 0;
        return 结果;
    }

    inline 服务字段检查结果 检查服务方法输入字段(
        任务类::节点类* 任务节点,
        const 语素入口节点类* 字段类型) noexcept
    {
        服务字段检查结果 结果{};
        结果.任务存在 = 任务节点 != nullptr;
        if (!结果.任务存在) {
            结果.失败原因 = 值_服务字段绑定任务缺失();
            return 结果;
        }

        auto* 任务宿主 = 读取任务虚拟存在宿主(任务节点);
        结果.任务虚拟存在存在 = 任务宿主 != nullptr;
        if (!结果.任务虚拟存在存在) {
            结果.失败原因 = 值_服务字段绑定任务虚拟存在缺失();
            return 结果;
        }
        if (!字段类型) {
            结果.失败原因 = 值_服务字段绑定字段类型缺失();
            return 结果;
        }

        结果.字段特征 = 查找子特征(任务宿主, 字段类型);
        结果.字段已挂载 = 结果.字段特征 != nullptr;
        if (!结果.字段已挂载) {
            结果.失败原因 = 值_服务字段未挂载();
            return 结果;
        }

        const auto* 主信息 = 世界树.特征().取特征主信息(结果.字段特征);
        结果.字段有当前值 = 主信息 && 主信息->有当前值();
        if (!结果.字段有当前值) {
            结果.失败原因 = 值_服务字段绑定字段值缺失();
        }
        return 结果;
    }

    inline bool 写入服务字段缺口回执(
        基础信息节点类* 回执宿主,
        任务类::节点类* 任务节点,
        存在节点类* 方法虚拟存在,
        const 语素入口节点类* 字段类型,
        const 语素入口节点类* 失败原因,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        if (!回执宿主 || !字段类型) return false;
        auto* 缺口 = 世界树.取或创建子特征_按类型(回执宿主, 特征_服务字段缺口());
        if (!缺口) return false;

        auto* 宿主 = reinterpret_cast<基础信息节点类*>(缺口);
        bool ok = true;
        if (任务节点) {
            ok = 世界树.写入特征_指针(宿主, 特征_任务信息节点(), 任务节点, now) && ok;
        }
        if (auto* 任务存在 = 读取任务虚拟存在(任务节点)) {
            ok = 世界树.写入特征_指针(宿主, 特征_任务虚拟存在(), 任务存在, now) && ok;
        }
        if (方法虚拟存在) {
            ok = 世界树.写入特征_指针(宿主, 特征_实现方法虚拟存在(), 方法虚拟存在, now) && ok;
        }
        ok = 世界树.写入特征_指针(宿主, 特征_缺口字段类型(), 字段类型, now) && ok;
        if (失败原因) {
            ok = 世界树.写入特征_指针(宿主, 特征_字段激活原因(), 失败原因, now) && ok;
        }
        return ok;
    }

    inline 存在节点类* 创建服务方法运行存在(
        任务类::节点类* 任务节点,
        存在节点类* 方法虚拟存在,
        基础信息节点类* 承载宿主 = nullptr,
        时间戳 now = 结构体_时间戳::当前_微秒()) noexcept
    {
        auto* 任务存在 = 读取任务虚拟存在(任务节点);
        auto* 宿主 = 任务存在
            ? reinterpret_cast<基础信息节点类*>(任务存在)
            : (方法虚拟存在 ? reinterpret_cast<基础信息节点类*>(方法虚拟存在) : 承载宿主);
        if (!宿主) return nullptr;

        auto* 运行存在 = 世界树.取或创建子存在_按类型并按特征I64(
            宿主,
            类型_服务方法运行存在(),
            特征_开始时间(),
            static_cast<I64>(now));
        if (!运行存在) return nullptr;

        (void)世界树.写入特征_I64(
            reinterpret_cast<基础信息节点类*>(运行存在),
            特征_开始时间(),
            static_cast<I64>(now),
            now);
        if (任务节点) {
            (void)世界树.写入特征_指针(
                reinterpret_cast<基础信息节点类*>(运行存在),
                特征_任务信息节点(),
               任务节点,
                now);
        }
        if (任务存在) {
            (void)世界树.写入特征_指针(
                reinterpret_cast<基础信息节点类*>(运行存在),
                特征_任务虚拟存在(),
                任务存在,
                now);
        }
        if (方法虚拟存在) {
            (void)世界树.写入特征_指针(
                reinterpret_cast<基础信息节点类*>(运行存在),
                特征_实现方法虚拟存在(),
                方法虚拟存在,
                now);
        }
        return 运行存在;
    }
}
