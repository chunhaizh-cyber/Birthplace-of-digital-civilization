    // 功能：按函数名执行对应处理。
    std::int64_t D455_万分比(std::uint64_t 分子, std::uint64_t 分母) noexcept
    {
        if (分母 == 0) {
            return 0;
        }
        const auto 值 = (分子 * 10000ULL) / 分母;
        return static_cast<std::int64_t>((std::min<std::uint64_t>)(10000ULL, 值));
    }

    // 功能：按函数名执行对应处理。
    std::int64_t D455_限制万分值(std::int64_t 值) noexcept
    {
        return (std::min<std::int64_t>)((std::max<std::int64_t>)(0, 值), 10000);
    }

    // 功能：按函数名执行对应处理。
    std::uint64_t D455_正面积(std::int64_t 宽度, std::int64_t 高度) noexcept
    {
        if (宽度 <= 0 || 高度 <= 0) {
            return 0;
        }
        return static_cast<std::uint64_t>(宽度) * static_cast<std::uint64_t>(高度);
    }

    // 功能：从候选集中选择当前使用对象或方法。
    结构_D455迁移分割深度源 D455_选择迁移分割深度源(
        const 双目相机本能适配器::调用结果& 来源,
        std::size_t 预期像素数) noexcept
    {
        if (预期像素数 == 0) {
            return {};
        }
        if (来源.滤波深度毫米.size() == 预期像素数) {
            return { &来源.滤波深度毫米, false };
        }
        if (来源.融合深度毫米.size() == 预期像素数) {
            return { &来源.融合深度毫米, true };
        }
        if (来源.补全深度毫米.size() == 预期像素数) {
            return { &来源.补全深度毫米, true };
        }
        if (来源.原始深度毫米.size() == 预期像素数) {
            return { &来源.原始深度毫米, false };
        }
        return {};
    }

    // 功能：按函数名执行对应处理。
    bool D455_迁移分割像素在深度切片(
        const std::vector<std::int64_t>& 深度,
        std::size_t 像素索引,
        std::int64_t 切片最小深度,
        std::int64_t 切片最大深度,
        bool 最后一片) noexcept
    {
        if (像素索引 >= 深度.size()) {
            return false;
        }
        const auto 值 = 深度[像素索引];
        return 值 >= 切片最小深度
            && (最后一片 ? 值 <= 切片最大深度 : 值 < 切片最大深度);
    }

    // 功能：按函数名执行对应处理。
    bool D455_迁移分割应拒绝触边组件(
        std::int64_t 投影最小X,
        std::int64_t 投影最大X,
        std::int64_t 投影最小Y,
        std::int64_t 投影最大Y,
        std::int64_t 面积,
        std::int64_t 帧宽度,
        std::int64_t 帧高度,
        std::int64_t 最大触边面积,
        bool 近前景) noexcept
    {
        if (近前景) {
            return false;
        }
        const bool 触左 = 投影最小X <= 0;
        const bool 触上 = 投影最小Y <= 0;
        const bool 触右 = 投影最大X >= 帧宽度 - 1;
        const bool 触下 = 投影最大Y >= 帧高度 - 1;
        const auto 触边数 =
            (触左 ? 1 : 0) + (触上 ? 1 : 0) + (触右 ? 1 : 0) + (触下 ? 1 : 0);
        if ((触左 && 触右) || (触上 && 触下)) {
            return true;
        }
        return 触边数 > 0 && 面积 > 最大触边面积;
    }

    // 功能：按函数名执行对应处理。
    bool D455_迁移分割组件通过材料门(
        const 结构_D455迁移分割组件& 组件,
        std::int64_t 帧宽度,
        std::int64_t 帧高度) noexcept
    {
        const auto 面积 = static_cast<std::int64_t>(组件.像素索引.size());
        if (面积 < D455_迁移分割最小面积像素) {
            return false;
        }
        const auto 帧面积 = static_cast<std::int64_t>(
            D455_正面积(帧宽度, 帧高度));
        if (帧面积 <= 0) {
            return false;
        }

        const auto ROI面积 = static_cast<std::int64_t>(D455_正面积(
            组件.投影最大X - 组件.投影最小X + 1,
            组件.投影最大Y - 组件.投影最小Y + 1));
        const bool 近前景 =
            组件.深度最小 <= D455_迁移分割近前景保留深度mm
            || (面积 > 0 && 组件.深度合计 / 面积 <= D455_迁移分割近前景保留深度mm);

        const auto 最大面积 = 帧面积 * D455_迁移分割最大面积百分比 / 100;
        const auto 最大ROI面积 = 帧面积 * D455_迁移分割最大ROI面积百分比 / 100;
        const auto 近前景最大面积 = 帧面积 * D455_迁移分割近前景最大面积百分比 / 100;
        const auto 近前景最大ROI面积 = 帧面积 * D455_迁移分割近前景最大ROI面积百分比 / 100;
        const auto 最大材料面积 = 帧面积 * D455_迁移分割最大材料面积百分比 / 100;
        const auto 最大材料ROI面积 = 帧面积 * D455_迁移分割最大材料ROI面积百分比 / 100;
        const auto 最大边界面积 = 帧面积 * D455_迁移分割最大边界面积百分比 / 100;

        if (面积 > 最大面积 && (!近前景 || 面积 > 近前景最大面积)) {
            return false;
        }
        if (ROI面积 > 最大ROI面积 && (!近前景 || ROI面积 > 近前景最大ROI面积)) {
            return false;
        }
        if (D455_迁移分割应拒绝触边组件(
            组件.投影最小X,
            组件.投影最大X,
            组件.投影最小Y,
            组件.投影最大Y,
            面积,
            帧宽度,
            帧高度,
            最大边界面积,
            近前景)) {
            return false;
        }
        return 面积 <= 最大材料面积 && ROI面积 <= 最大材料ROI面积;
    }

    // 功能：根据当前输入生成目标数据、场景、动态或回执。
    双目相机本能适配器::空间候选摘要 D455_从迁移分割组件生成空间候选(
        const 结构_D455迁移分割组件& 组件,
        const 双目相机本能适配器::调用结果& 来源)
    {
        双目相机本能适配器::空间候选摘要 候选{};
        const auto 像素数 = static_cast<std::int64_t>(组件.像素索引.size());
        const auto ROI面积 = static_cast<std::uint64_t>(D455_正面积(
            组件.投影最大X - 组件.投影最小X + 1,
            组件.投影最大Y - 组件.投影最小Y + 1));
        const auto 平均深度 = 像素数 > 0 ? 组件.深度合计 / 像素数 : 0;
        const auto 空间有效率 = D455_万分比(
            static_cast<std::uint64_t>((std::max<std::int64_t>)(0, 组件.有效空间点数)),
            static_cast<std::uint64_t>((std::max<std::int64_t>)(1, 像素数)));
        const auto 投影覆盖率 = D455_万分比(
            static_cast<std::uint64_t>((std::max<std::int64_t>)(0, 像素数)),
            (std::max<std::uint64_t>)(1ULL, ROI面积));
        const auto 深度跨度 = D455_I64绝对差(组件.深度最大, 组件.深度最小);
        const auto 深度一致率 = D455_限制万分值(
            10000 - (深度跨度 * 10000) / (std::max<std::int64_t>)(1, D455_迁移分割深度切片mm));
        const auto 大小评分 = D455_万分比(
            static_cast<std::uint64_t>((std::max<std::int64_t>)(0, 像素数)),
            static_cast<std::uint64_t>(D455_迁移分割最小面积像素 * 2));
        const auto 轮廓置信度 = D455_限制万分值(
            (空间有效率 * 30 + 深度一致率 * 30 + 投影覆盖率 * 20 + 大小评分 * 20) / 100);

        候选.像素数量 = 像素数;
        候选.有效点比例 = 空间有效率;
        候选.中心X = 组件.有效空间点数 > 0 ? 组件.空间X合计 / 组件.有效空间点数 : 0;
        候选.中心Y = 组件.有效空间点数 > 0 ? 组件.空间Y合计 / 组件.有效空间点数 : 0;
        候选.中心Z = 组件.有效空间点数 > 0 ? 组件.空间Z合计 / 组件.有效空间点数 : 平均深度;
        候选.范围最小X = 组件.有效空间点数 > 0 ? 组件.空间最小X : 0;
        候选.范围最大X = 组件.有效空间点数 > 0 ? 组件.空间最大X : 0;
        候选.范围最小Y = 组件.有效空间点数 > 0 ? 组件.空间最小Y : 0;
        候选.范围最大Y = 组件.有效空间点数 > 0 ? 组件.空间最大Y : 0;
        候选.范围最小Z = 组件.有效空间点数 > 0 ? 组件.空间最小Z : 组件.深度最小;
        候选.范围最大Z = 组件.有效空间点数 > 0 ? 组件.空间最大Z : 组件.深度最大;
        候选.投影最小X = 组件.投影最小X;
        候选.投影最大X = 组件.投影最大X;
        候选.投影最小Y = 组件.投影最小Y;
        候选.投影最大Y = 组件.投影最大Y;
        候选.平均深度 = 平均深度;
        候选.最近深度 = 组件.深度最小;
        候选.最远深度 = 组件.深度最大;
        候选.空间连续性评分 = D455_限制万分值(6000 + (std::min<std::int64_t>)(4000, 像素数 / 2));
        候选.范围稳定性评分 = D455_限制万分值((深度一致率 + 空间有效率 + 投影覆盖率) / 3);
        候选.空间覆盖像素数 = 像素数;
        候选.空间匹配像素数 = 组件.有效空间点数;
        候选.空间冲突像素数 = (std::max<std::int64_t>)(0, 像素数 - 组件.有效空间点数);
        候选.轮廓支持像素数 = 像素数;
        候选.轮廓冲突像素数 = 0;
        候选.深度一致率 = 深度一致率;
        候选.范围内点比例 = 空间有效率;
        候选.投影覆盖率 = 投影覆盖率;
        候选.轮廓吻合率 = 投影覆盖率;
        候选.轮廓来源类型 = 1 | 2 | 4 | 8;
        候选.轮廓闭合度 = 投影覆盖率;
        候选.轮廓深度支持率 = 深度一致率;
        候选.轮廓颜色支持率 = 来源.颜色RGB结构状态 > 0 ? 5000 : 0;
        候选.轮廓空间支持率 = 空间有效率;
        候选.轮廓跨越深度断裂 = 深度跨度 > D455_迁移分割深度切片mm ? 1 : 0;
        候选.轮廓穿过深度无效区域 = 0;
        候选.轮廓依赖补全深度 = 组件.依赖补全或融合 ? 1 : 0;
        候选.轮廓置信度 = 轮廓置信度;
        候选.遮挡像素数 = 0;
        候选.未解释像素数 = 0;
        候选.像素归属验证状态 = 轮廓置信度 >= 6000 && 空间有效率 >= 3000 ? 1 : 0;
        候选.缺失原因 = 0;
        if (空间有效率 < 3000) {
            候选.缺失原因 |= D455_迁移分割_缺失原因_有效点不足;
        }
        if (深度一致率 < 4000 || 候选.轮廓跨越深度断裂) {
            候选.缺失原因 |= D455_迁移分割_缺失原因_边界不稳定;
        }
        if (组件.依赖补全或融合) {
            候选.缺失原因 |= D455_迁移分割_缺失原因_补全依赖过高;
        }
        候选.观察确认补偿状态 =
            空间有效率 < 3000
                ? D455_迁移分割_观察确认补偿状态_条件不足
                : (轮廓置信度 >= 7000
                    ? D455_迁移分割_观察确认补偿状态_部分确认
                    : D455_迁移分割_观察确认补偿状态_待验证);
        候选.补全候选状态 = 组件.依赖补全或融合 ? 1 : 0;
        候选.低置信轮廓状态 = 轮廓置信度 < 7000 || 组件.依赖补全或融合 ? 1 : 0;
        候选.待补观察区域数量 = 候选.低置信轮廓状态 ? 1 : 0;
        候选.补观察需求建议 = 0;
        if ((候选.缺失原因 & D455_迁移分割_缺失原因_有效点不足) != 0) {
            候选.补观察需求建议 |= D455_迁移分割_补观察建议_缩小ROI重新观察;
        }
        if ((候选.缺失原因 & D455_迁移分割_缺失原因_补全依赖过高) != 0) {
            候选.补观察需求建议 |= D455_迁移分割_补观察建议_融合稳定观察帧深度;
        }
        if (候选.低置信轮廓状态) {
            候选.补观察需求建议 |= D455_迁移分割_补观察建议_内部世界细分;
        }
        候选.像素索引集合.reserve(组件.像素索引.size());
        for (const auto 像素索引 : 组件.像素索引) {
            if (像素索引 <= static_cast<std::size_t>(std::numeric_limits<std::uint32_t>::max())) {
                候选.像素索引集合.push_back(static_cast<std::uint32_t>(像素索引));
            }
        }
        return 候选;
    }

    // 功能：按函数名执行对应处理。
    std::vector<双目相机本能适配器::空间候选摘要> D455_提取迁移分割空间候选(
        const 双目相机本能适配器::调用结果& 来源)
    {
        std::vector<双目相机本能适配器::空间候选摘要> 输出{};
        if (!来源.成功 || 来源.宽度 <= 0 || 来源.高度 <= 0) {
            return 输出;
        }
        const auto 宽 = 来源.宽度;
        const auto 高 = 来源.高度;
        const auto 预期像素数 = static_cast<std::size_t>(宽) * static_cast<std::size_t>(高);
        const auto 深度源 = D455_选择迁移分割深度源(来源, 预期像素数);
        if (!深度源.深度 || 深度源.深度->size() != 预期像素数) {
            return 输出;
        }
        const bool 空间坐标可用 = 来源.空间坐标毫米XYZ.size() == 预期像素数;
        std::vector<std::uint8_t> 已访问(预期像素数, 0);
        std::vector<std::size_t> 队列{};
        队列.reserve(4096);

        auto 像素索引 = [宽](int x, int y) noexcept {
            return static_cast<std::size_t>(y) * static_cast<std::size_t>(宽)
                + static_cast<std::size_t>(x);
        };

        for (std::int64_t 切片最小 = D455_迁移分割最小深度mm;
            切片最小 < D455_迁移分割最大深度mm;
            切片最小 += D455_迁移分割深度切片mm) {
            const auto 切片最大 = (std::min<std::int64_t>)(
                D455_迁移分割最大深度mm,
                切片最小 + D455_迁移分割深度切片mm);
            const bool 最后一片 = 切片最大 >= D455_迁移分割最大深度mm;
            std::fill(已访问.begin(), 已访问.end(), 0);

            for (int y = 0; y < 高; ++y) {
                for (int x = 0; x < 宽; ++x) {
                    const auto 起点 = 像素索引(x, y);
                    if (已访问[起点]
                        || !D455_迁移分割像素在深度切片(
                            *深度源.深度,
                            起点,
                            切片最小,
                            切片最大,
                            最后一片)) {
                        continue;
                    }

                    结构_D455迁移分割组件 组件{};
                    组件.切片最小深度 = 切片最小;
                    组件.切片最大深度 = 切片最大;
                    组件.投影最小X = x;
                    组件.投影最大X = x;
                    组件.投影最小Y = y;
                    组件.投影最大Y = y;
                    组件.深度最小 = std::numeric_limits<std::int64_t>::max();
                    组件.深度最大 = 0;
                    组件.空间最小X = std::numeric_limits<std::int64_t>::max();
                    组件.空间最小Y = std::numeric_limits<std::int64_t>::max();
                    组件.空间最小Z = std::numeric_limits<std::int64_t>::max();
                    组件.空间最大X = std::numeric_limits<std::int64_t>::lowest();
                    组件.空间最大Y = std::numeric_limits<std::int64_t>::lowest();
                    组件.空间最大Z = std::numeric_limits<std::int64_t>::lowest();
                    组件.依赖补全或融合 = 深度源.依赖补全或融合;

                    已访问[起点] = 1;
                    队列.clear();
                    队列.push_back(起点);
                    std::size_t 游标 = 0;

                    while (游标 < 队列.size()) {
                        const auto 当前 = 队列[游标++];
                        const int cx = static_cast<int>(当前 % static_cast<std::size_t>(宽));
                        const int cy = static_cast<int>(当前 / static_cast<std::size_t>(宽));
                        const auto 深度值 = (*深度源.深度)[当前];
                        组件.像素索引.push_back(当前);
                        组件.投影最小X = (std::min<std::int64_t>)(组件.投影最小X, cx);
                        组件.投影最大X = (std::max<std::int64_t>)(组件.投影最大X, cx);
                        组件.投影最小Y = (std::min<std::int64_t>)(组件.投影最小Y, cy);
                        组件.投影最大Y = (std::max<std::int64_t>)(组件.投影最大Y, cy);
                        组件.深度最小 = (std::min<std::int64_t>)(组件.深度最小, 深度值);
                        组件.深度最大 = (std::max<std::int64_t>)(组件.深度最大, 深度值);
                        组件.深度合计 += 深度值;

                        if (空间坐标可用) {
                            const auto& 点 = 来源.空间坐标毫米XYZ[当前];
                            if (点.Z > 0) {
                                ++组件.有效空间点数;
                                组件.空间X合计 += 点.X;
                                组件.空间Y合计 += 点.Y;
                                组件.空间Z合计 += 点.Z;
                                组件.空间最小X = (std::min<std::int64_t>)(组件.空间最小X, 点.X);
                                组件.空间最大X = (std::max<std::int64_t>)(组件.空间最大X, 点.X);
                                组件.空间最小Y = (std::min<std::int64_t>)(组件.空间最小Y, 点.Y);
                                组件.空间最大Y = (std::max<std::int64_t>)(组件.空间最大Y, 点.Y);
                                组件.空间最小Z = (std::min<std::int64_t>)(组件.空间最小Z, 点.Z);
                                组件.空间最大Z = (std::max<std::int64_t>)(组件.空间最大Z, 点.Z);
                            }
                        }

                        const int 邻居[4][2] = {
                            { cx - 1, cy },
                            { cx + 1, cy },
                            { cx, cy - 1 },
                            { cx, cy + 1 },
                        };
                        for (const auto& 坐标 : 邻居) {
                            const int nx = 坐标[0];
                            const int ny = 坐标[1];
                            if (nx < 0 || ny < 0 || nx >= 宽 || ny >= 高) {
                                continue;
                            }
                            const auto ni = 像素索引(nx, ny);
                            if (已访问[ni]
                                || !D455_迁移分割像素在深度切片(
                                    *深度源.深度,
                                    ni,
                                    切片最小,
                                    切片最大,
                                    最后一片)) {
                                continue;
                            }
                            已访问[ni] = 1;
                            队列.push_back(ni);
                        }
                    }

                    if (!D455_迁移分割组件通过材料门(组件, 宽, 高)) {
                        continue;
                    }
                    输出.push_back(D455_从迁移分割组件生成空间候选(组件, 来源));
                }
            }
        }

        std::sort(
            输出.begin(),
            输出.end(),
            [](const auto& 左, const auto& 右) noexcept {
                if (左.轮廓置信度 != 右.轮廓置信度) {
                    return 左.轮廓置信度 > 右.轮廓置信度;
                }
                return 左.像素数量 > 右.像素数量;
            });
        if (输出.size() > static_cast<std::size_t>(D455_迁移分割最大材料数)) {
            输出.resize(static_cast<std::size_t>(D455_迁移分割最大材料数));
        }
        for (std::size_t i = 0; i < 输出.size(); ++i) {
            输出[i].候选编号 = static_cast<std::int64_t>(i);
        }
        return 输出;
    }

    // 功能：按函数名执行对应处理。
    void D455_写回迁移分割空间候选(双目相机本能适配器::调用结果* 结果)
    {
        if (!结果 || !结果->成功) {
            return;
        }
        auto 候选列表 = D455_提取迁移分割空间候选(*结果);
        std::int64_t 候选像素数 = 0;
        std::int64_t 空间匹配像素数 = 0;
        std::int64_t 深度支持累计 = 0;
        std::int64_t 颜色支持累计 = 0;
        std::int64_t 空间支持累计 = 0;
        std::int64_t 置信累计 = 0;
        std::int64_t 深度稳定累计 = 0;
        std::int64_t 验证通过候选数 = 0;
        std::int64_t 条件不足候选数 = 0;
        std::int64_t 待验证候选数 = 0;
        std::int64_t 部分确认候选数 = 0;
        std::int64_t 补全候选数 = 0;
        std::int64_t 低置信候选数 = 0;
        std::int64_t 待补区域数 = 0;
        std::int64_t 补观察缺失原因 = 结果->补观察缺失原因;
        std::int64_t 补观察需求建议 = 结果->补观察需求建议;
        std::int64_t 跨越深度断裂数量 = 0;
        std::int64_t 补全依赖轮廓数量 = 0;

        for (const auto& 候选 : 候选列表) {
            候选像素数 += (std::max<std::int64_t>)(0, 候选.像素数量);
            空间匹配像素数 += (std::max<std::int64_t>)(0, 候选.空间匹配像素数);
            深度支持累计 += 候选.轮廓深度支持率;
            颜色支持累计 += 候选.轮廓颜色支持率;
            空间支持累计 += 候选.轮廓空间支持率;
            置信累计 += 候选.轮廓置信度;
            深度稳定累计 += 候选.深度一致率;
            if (候选.像素归属验证状态 > 0) {
                ++验证通过候选数;
            }
            if (候选.观察确认补偿状态 == D455_迁移分割_观察确认补偿状态_条件不足) {
                ++条件不足候选数;
            } else if (候选.观察确认补偿状态 == D455_迁移分割_观察确认补偿状态_待验证) {
                ++待验证候选数;
            } else if (候选.观察确认补偿状态 == D455_迁移分割_观察确认补偿状态_部分确认) {
                ++部分确认候选数;
            }
            if (候选.补全候选状态 > 0) {
                ++补全候选数;
            }
            if (候选.低置信轮廓状态 > 0) {
                ++低置信候选数;
            }
            if (候选.轮廓跨越深度断裂 > 0) {
                ++跨越深度断裂数量;
            }
            if (候选.轮廓依赖补全深度 > 0) {
                ++补全依赖轮廓数量;
            }
            待补区域数 += (std::max<std::int64_t>)(0, 候选.待补观察区域数量);
            补观察缺失原因 |= 候选.缺失原因;
            补观察需求建议 |= 候选.补观察需求建议;
        }

        结果->空间候选列表 = std::move(候选列表);
        结果->空间候选数量 = static_cast<std::int64_t>(结果->空间候选列表.size());
        结果->空间候选有效点数量 = 空间匹配像素数 > 0 ? 空间匹配像素数 : 候选像素数;
        结果->轮廓数量 = 结果->空间候选列表.size();
        结果->深度轮廓数量 = 结果->空间候选数量;
        结果->空间投影轮廓数量 = 结果->空间候选数量;
        结果->融合轮廓数量 = 结果->空间候选数量;
        结果->轮廓来源分层状态 = 结果->空间候选数量 > 0 ? 1 : 0;
        结果->轮廓闭合率 = 结果->空间候选数量 > 0 ? 10000 : 0;
        结果->轮廓断裂数量 = 跨越深度断裂数量;
        结果->轮廓深度支持率 = 结果->空间候选数量 > 0 ? 深度支持累计 / 结果->空间候选数量 : 0;
        结果->轮廓颜色支持率 = 结果->空间候选数量 > 0 ? 颜色支持累计 / 结果->空间候选数量 : 0;
        结果->轮廓空间支持率 = 结果->空间候选数量 > 0 ? 空间支持累计 / 结果->空间候选数量 : 0;
        结果->融合轮廓置信度 = 结果->空间候选数量 > 0 ? 置信累计 / 结果->空间候选数量 : 0;
        结果->边界深度稳定率 = 结果->空间候选数量 > 0 ? 深度稳定累计 / 结果->空间候选数量 : 0;
        结果->候选存在验证通过率 = D455_万分比(
            static_cast<std::uint64_t>((std::max<std::int64_t>)(0, 验证通过候选数)),
            static_cast<std::uint64_t>((std::max<std::int64_t>)(1, 结果->空间候选数量)));
        结果->未解释区域比例 = 结果->预期像素数量 > 0
            ? D455_万分比(
                static_cast<std::uint64_t>((std::max<std::int64_t>)(
                    0,
                    结果->预期像素数量 - (std::min<std::int64_t>)(结果->预期像素数量, 候选像素数))),
                static_cast<std::uint64_t>(结果->预期像素数量))
            : 0;
        结果->条件不足候选数量 = 条件不足候选数 + (结果->空间候选数量 == 0 ? 1 : 0);
        结果->待验证候选数量 = 待验证候选数;
        结果->部分确认候选数量 = 部分确认候选数;
        结果->补全候选数量 = 补全候选数;
        结果->低置信轮廓数量 = 低置信候选数;
        结果->跨越深度断裂轮廓数量 = 跨越深度断裂数量;
        结果->穿过深度无效区域轮廓数量 = 0;
        结果->依赖补全深度轮廓数量 = 补全依赖轮廓数量;
        结果->补观察缺口状态 = 补观察缺失原因 != 0 || 结果->空间候选数量 == 0 ? 1 : 0;
        结果->补观察缺失原因 = 补观察缺失原因;
        结果->待补观察区域数量 += 待补区域数;
        结果->补观察需求建议 = 补观察需求建议;
    }

    // 功能：按函数名执行对应处理。
    std::int64_t D455_带滞回容差(std::int64_t 基础, bool 启用滞回) noexcept
    {
        return 启用滞回 ? 基础 + 基础 / 2 : 基础;
    }

    // 功能：按函数名执行对应处理。
    std::int64_t D455_范围端点最大差(
        std::int64_t 左最小,
        std::int64_t 左最大,
        std::int64_t 右最小,
        std::int64_t 右最大) noexcept
    {
        return (std::max<std::int64_t>)(
            D455_I64绝对差(左最小, 右最小),
            D455_I64绝对差(左最大, 右最大));
    }

    // 功能：按函数名执行对应处理。
    std::int64_t D455_范围跨度容差(
        std::int64_t 左最小,
        std::int64_t 左最大,
        std::int64_t 右最小,
        std::int64_t 右最大,
        std::int64_t 最小容差) noexcept
    {
        const auto 左跨度 = D455_I64绝对差(左最大, 左最小);
        const auto 右跨度 = D455_I64绝对差(右最大, 右最小);
        return (std::max<std::int64_t>)(
            最小容差,
            (std::max<std::int64_t>)(左跨度, 右跨度) / 2);
    }

    // 功能：按函数名执行对应处理。
    std::int64_t D455_平滑I64(
        std::int64_t 旧值,
        std::int64_t 新值,
        bool 已初始化) noexcept
    {
        return 已初始化 ? (旧值 * 2 + 新值) / 3 : 新值;
    }

    // 功能：按函数名执行对应处理。
    std::int64_t D455_投影中心X(const 结构_外设观察像素簇摘要& 簇) noexcept
    {
        return (簇.投影最小X + 簇.投影最大X) / 2;
    }

    // 功能：按函数名执行对应处理。
    std::int64_t D455_投影中心Y(const 结构_外设观察像素簇摘要& 簇) noexcept
    {
        return (簇.投影最小Y + 簇.投影最大Y) / 2;
    }

    // 功能：按函数名执行对应处理。
    bool D455_观察簇投影有效(
        const 结构_外设观察像素簇摘要& 簇,
        std::int64_t 帧宽度,
        std::int64_t 帧高度) noexcept
    {
        return 帧宽度 > 0
            && 帧高度 > 0
            && 簇.像素数量 > 0
            && 簇.投影最小X >= 0
            && 簇.投影最小Y >= 0
            && 簇.投影最大X >= 簇.投影最小X
            && 簇.投影最大Y >= 簇.投影最小Y
            && 簇.投影最大X < 帧宽度
            && 簇.投影最大Y < 帧高度;
    }

    // 功能：按函数名执行对应处理。
    std::string D455_构造观察簇资源句柄(
        const char* 资源类型,
        const 双目相机本能适配器::调用结果& 来源,
        const 双目相机本能适配器::空间候选摘要& 候选)
    {
        std::ostringstream 输出;
        输出 << "d455://"
            << (资源类型 ? 资源类型 : "unknown")
            << "/depth-" << 来源.深度帧号
            << "/color-" << 来源.彩色帧号
            << "/candidate-" << 候选.候选编号
            << "?bbox="
            << 候选.投影最小X << ','
            << 候选.投影最小Y << ','
            << 候选.投影最大X << ','
            << 候选.投影最大Y;
        return 输出.str();
    }

    // 功能：按函数名执行对应处理。
    std::string D455_构造观察帧资源句柄(
        const char* 资源类型,
        const 双目相机本能适配器::调用结果& 来源)
    {
        std::ostringstream 输出;
        输出 << "d455://"
            << (资源类型 ? 资源类型 : "frame")
            << "/depth-" << 来源.深度帧号
            << "/color-" << 来源.彩色帧号
            << "?timestamp-us=" << 来源.系统到达时间_us;
        return 输出.str();
    }

    // 功能：按函数名执行对应处理。
    bool D455_跨帧簇可匹配(
        const 结构_D455跨帧观察簇缓存项& 缓存项,
        const 结构_外设观察像素簇摘要& 簇,
        std::int64_t* 输出分值) noexcept
    {
        const bool 使用平滑参考 =
            缓存项.平滑值已初始化 && 缓存项.连续命中次数 >= 2;
        const bool 启用滞回 =
            缓存项.稳定状态 > 0
            || 缓存项.丢失宽限计数 > 0
            || 缓存项.连续命中次数 >= 2;

        const auto 参考中心X = 使用平滑参考 ? 缓存项.平滑中心X : 缓存项.最近中心X;
        const auto 参考中心Y = 使用平滑参考 ? 缓存项.平滑中心Y : 缓存项.最近中心Y;
        const auto 参考中心Z = 使用平滑参考 ? 缓存项.平滑中心Z : 缓存项.最近中心Z;
        const auto 参考投影最小X = 使用平滑参考 ? 缓存项.平滑投影最小X : 缓存项.最近投影最小X;
        const auto 参考投影最大X = 使用平滑参考 ? 缓存项.平滑投影最大X : 缓存项.最近投影最大X;
        const auto 参考投影最小Y = 使用平滑参考 ? 缓存项.平滑投影最小Y : 缓存项.最近投影最小Y;
        const auto 参考投影最大Y = 使用平滑参考 ? 缓存项.平滑投影最大Y : 缓存项.最近投影最大Y;

        const auto 中心X差 = D455_I64绝对差(参考中心X, 簇.中心X);
        const auto 中心Y差 = D455_I64绝对差(参考中心Y, 簇.中心Y);
        const auto 中心Z差 = D455_I64绝对差(参考中心Z, 簇.中心Z);
        const auto 投影X差 = D455_I64绝对差(
            (参考投影最小X + 参考投影最大X) / 2,
            D455_投影中心X(簇));
        const auto 投影Y差 = D455_I64绝对差(
            (参考投影最小Y + 参考投影最大Y) / 2,
            D455_投影中心Y(簇));
        const auto 投影范围X差 = D455_范围端点最大差(
            参考投影最小X,
            参考投影最大X,
            簇.投影最小X,
            簇.投影最大X);
        const auto 投影范围Y差 = D455_范围端点最大差(
            参考投影最小Y,
            参考投影最大Y,
            簇.投影最小Y,
            簇.投影最大Y);
        const auto 空间范围X差 = D455_范围端点最大差(
            缓存项.最近空间范围最小X,
            缓存项.最近空间范围最大X,
            簇.空间范围最小X,
            簇.空间范围最大X);
        const auto 空间范围Y差 = D455_范围端点最大差(
            缓存项.最近空间范围最小Y,
            缓存项.最近空间范围最大Y,
            簇.空间范围最小Y,
            簇.空间范围最大Y);
        const auto 空间范围Z差 = D455_范围端点最大差(
            缓存项.最近空间范围最小Z,
            缓存项.最近空间范围最大Z,
            簇.空间范围最小Z,
            簇.空间范围最大Z);
        const auto 像素差 = D455_I64绝对差(缓存项.最近像素数量, 簇.像素数量);
        const auto 像素容差 = (std::max<std::int64_t>)(
            96,
            (std::max<std::int64_t>)(缓存项.最近像素数量, 簇.像素数量) * 3 / 4);

        const bool 可匹配 =
            中心X差 <= D455_带滞回容差(450, 启用滞回)
            && 中心Y差 <= D455_带滞回容差(450, 启用滞回)
            && 中心Z差 <= D455_带滞回容差(650, 启用滞回)
            && 投影X差 <= D455_带滞回容差(160, 启用滞回)
            && 投影Y差 <= D455_带滞回容差(160, 启用滞回)
            && 投影范围X差 <= D455_带滞回容差(
                D455_范围跨度容差(
                    参考投影最小X,
                    参考投影最大X,
                    簇.投影最小X,
                    簇.投影最大X,
                    180),
                启用滞回)
            && 投影范围Y差 <= D455_带滞回容差(
                D455_范围跨度容差(
                    参考投影最小Y,
                    参考投影最大Y,
                    簇.投影最小Y,
                    簇.投影最大Y,
                    180),
                启用滞回)
            && 空间范围X差 <= D455_带滞回容差(
                D455_范围跨度容差(
                    缓存项.最近空间范围最小X,
                    缓存项.最近空间范围最大X,
                    簇.空间范围最小X,
                    簇.空间范围最大X,
                    700),
                启用滞回)
            && 空间范围Y差 <= D455_带滞回容差(
                D455_范围跨度容差(
                    缓存项.最近空间范围最小Y,
                    缓存项.最近空间范围最大Y,
                    簇.空间范围最小Y,
                    簇.空间范围最大Y,
                    700),
                启用滞回)
            && 空间范围Z差 <= D455_带滞回容差(
                D455_范围跨度容差(
                    缓存项.最近空间范围最小Z,
                    缓存项.最近空间范围最大Z,
                    簇.空间范围最小Z,
                    簇.空间范围最大Z,
                    900),
                启用滞回)
            && 像素差 <= 像素容差;
        if (输出分值) {
            *输出分值 = 中心X差
                + 中心Y差
                + 中心Z差
                + 投影X差 * 3
                + 投影Y差 * 3
                + 投影范围X差
                + 投影范围Y差
                + 空间范围X差 / 2
                + 空间范围Y差 / 2
                + 空间范围Z差 / 2
                + 像素差 / 4;
        }
        return 可匹配;
    }

    // 功能：把处理结果写入指定对象、场景或日志。
    void D455_写入跨帧簇缓存项(
        结构_D455跨帧观察簇缓存项& 缓存项,
        const 结构_外设观察像素簇摘要& 簇) noexcept
    {
        缓存项.最近来源空间候选ID = 簇.来源空间候选ID;
        缓存项.最近像素数量 = 簇.像素数量;
        缓存项.最近中心X = 簇.中心X;
        缓存项.最近中心Y = 簇.中心Y;
        缓存项.最近中心Z = 簇.中心Z;
        缓存项.最近投影中心X = D455_投影中心X(簇);
        缓存项.最近投影中心Y = D455_投影中心Y(簇);
        缓存项.最近投影最小X = 簇.投影最小X;
        缓存项.最近投影最大X = 簇.投影最大X;
        缓存项.最近投影最小Y = 簇.投影最小Y;
        缓存项.最近投影最大Y = 簇.投影最大Y;
        缓存项.最近空间范围最小X = 簇.空间范围最小X;
        缓存项.最近空间范围最大X = 簇.空间范围最大X;
        缓存项.最近空间范围最小Y = 簇.空间范围最小Y;
        缓存项.最近空间范围最大Y = 簇.空间范围最大Y;
        缓存项.最近空间范围最小Z = 簇.空间范围最小Z;
        缓存项.最近空间范围最大Z = 簇.空间范围最大Z;
        缓存项.平滑中心X = D455_平滑I64(缓存项.平滑中心X, 簇.中心X, 缓存项.平滑值已初始化);
        缓存项.平滑中心Y = D455_平滑I64(缓存项.平滑中心Y, 簇.中心Y, 缓存项.平滑值已初始化);
        缓存项.平滑中心Z = D455_平滑I64(缓存项.平滑中心Z, 簇.中心Z, 缓存项.平滑值已初始化);
        缓存项.平滑投影最小X = D455_平滑I64(
            缓存项.平滑投影最小X, 簇.投影最小X, 缓存项.平滑值已初始化);
        缓存项.平滑投影最大X = D455_平滑I64(
            缓存项.平滑投影最大X, 簇.投影最大X, 缓存项.平滑值已初始化);
        缓存项.平滑投影最小Y = D455_平滑I64(
            缓存项.平滑投影最小Y, 簇.投影最小Y, 缓存项.平滑值已初始化);
        缓存项.平滑投影最大Y = D455_平滑I64(
            缓存项.平滑投影最大Y, 簇.投影最大Y, 缓存项.平滑值已初始化);
        缓存项.平滑值已初始化 = true;
    }

    // 功能：按函数名执行对应处理。
    std::string D455_构造Tracker轨迹状态generation(
        const char* 作用域,
        std::uint64_t ID,
        std::int64_t 时间戳毫秒)
    {
        std::ostringstream 输出;
        输出 << "D455Tracker轨迹状态"
            << "|作用域=" << (作用域 ? 作用域 : "未知")
            << "|ID=" << ID
            << "|时间=" << 时间戳毫秒;
        return 输出.str();
    }

    // 功能：把处理结果写入指定对象、场景或日志。
    void D455_写入簇Tracker轨迹状态(
        结构_外设观察像素簇摘要& 簇,
        枚举_外设Tracker轨迹状态 状态,
        std::int64_t 连续帧数,
        std::int64_t 时间戳毫秒)
    {
        const auto 跨帧ID = 簇.外设跨帧簇ID >= 0
            ? static_cast<std::uint64_t>(簇.外设跨帧簇ID)
            : std::uint64_t{0};
        簇.轨迹状态 = 状态;
        簇.轨迹状态generation = D455_构造Tracker轨迹状态generation(
            "观察簇",
            跨帧ID,
            时间戳毫秒);
        簇.轨迹状态连续帧数 = 连续帧数;
    }

    // 功能：把处理结果写入指定对象、场景或日志。
    void D455_写入报告Tracker轨迹状态(
        结构_外设观察报告队列项* 报告,
        枚举_外设Tracker轨迹状态 状态,
        std::int64_t 连续帧数)
    {
        if (!报告) {
            return;
        }
        报告->轨迹状态 = 状态;
        报告->轨迹状态generation = D455_构造Tracker轨迹状态generation(
            "报告",
            报告->报告ID,
            报告->时间戳毫秒);
        报告->轨迹状态连续帧数 = 连续帧数;
    }

    // 功能：更新已有对象、状态、索引或缓存。
    void D455_更新逐簇识别报告跨帧采集状态(结构_外设观察报告队列项* 报告)
    {
        if (!报告 || 报告->报告类型 != 枚举_外设观察报告类型::逐簇识别报告) {
            return;
        }

        std::lock_guard<std::mutex> 锁(D455_跨帧观察簇缓存锁());
        auto& 缓存 = D455_跨帧观察簇缓存();
        for (auto& 项 : 缓存) {
            项.本帧已匹配 = false;
        }

        std::int64_t 匹配数量 = 0;
        std::int64_t 新建数量 = 0;
        std::int64_t 稳定数量 = 0;
        std::int64_t 待发布数量 = 0;
        std::int64_t 最长轨迹连续帧数 = 0;
        for (auto& 簇 : 报告->观察像素簇集合) {
            结构_D455跨帧观察簇缓存项* 最佳项 = nullptr;
            std::int64_t 最佳分值 = 0;
            bool 已有分值 = false;
            for (auto& 项 : 缓存) {
                if (项.本帧已匹配 || 项.丢失次数 > D455_丢失宽限帧数 + 2) {
                    continue;
                }
                std::int64_t 分值 = 0;
                if (!D455_跨帧簇可匹配(项, 簇, &分值)) {
                    continue;
                }
                if (!已有分值 || 分值 < 最佳分值) {
                    最佳项 = &项;
                    最佳分值 = 分值;
                    已有分值 = true;
                }
            }

            bool 本轮新建 = false;
            if (!最佳项) {
                结构_D455跨帧观察簇缓存项 新项{};
                新项.跨帧簇ID = D455_下一跨帧观察簇ID()++;
                新项.本帧已匹配 = true;
                新项.连续命中次数 = 1;
                新项.连续稳定命中次数 = 0;
                新项.连续发布次数 = 0;
                新项.最近复现离散度 = 0;
                新项.稳定状态 = 0;
                新项.待发布状态 = 0;
                新项.丢失宽限计数 = 0;
                D455_写入跨帧簇缓存项(新项, 簇);
                缓存.push_back(新项);
                最佳项 = &缓存.back();
                本轮新建 = true;
                ++新建数量;
            } else {
                最佳项->本帧已匹配 = true;
                ++最佳项->连续命中次数;
                最佳项->丢失次数 = 0;
                最佳项->丢失宽限计数 = 0;
                最佳项->最近复现离散度 = 最佳分值;
                if (最佳项->连续命中次数 >= 2
                    && 最佳分值 <= D455_稳定复现分值阈值) {
                    ++最佳项->连续稳定命中次数;
                } else {
                    最佳项->连续稳定命中次数 = 0;
                }
                最佳项->稳定状态 =
                    最佳项->连续稳定命中次数 >= D455_稳定连续命中阈值 ? 1 : 0;
                if (最佳项->稳定状态 > 0) {
                    ++最佳项->连续发布次数;
                } else {
                    最佳项->连续发布次数 = 0;
                }
                最佳项->待发布状态 = 最佳项->稳定状态;
                D455_写入跨帧簇缓存项(*最佳项, 簇);
                ++匹配数量;
            }

            簇.外设跨帧簇ID = 最佳项->跨帧簇ID;
            簇.外设内部簇ID = 最佳项->跨帧簇ID;
            簇.跨帧匹配状态 = 最佳项->连续命中次数 >= 2 ? 1 : 0;
            簇.跨帧连续命中次数 = 最佳项->连续命中次数;
            簇.跨帧丢失次数 = 最佳项->丢失次数;
            簇.跨帧复现离散度 = 已有分值 ? 最佳分值 : 0;
            簇.跨帧连续稳定命中次数 = 最佳项->连续稳定命中次数;
            簇.跨帧连续发布次数 = 最佳项->连续发布次数;
            簇.跨帧轨迹稳定状态 = 最佳项->稳定状态;
            簇.跨帧轨迹待发布状态 = 最佳项->待发布状态;
            簇.跨帧丢失宽限状态 = 最佳项->丢失宽限计数 > 0 ? 1 : 0;
            枚举_外设Tracker轨迹状态 轨迹状态 = 枚举_外设Tracker轨迹状态::候选;
            std::int64_t 轨迹连续帧数 = 最佳项->连续命中次数;
            if (本轮新建) {
                轨迹状态 = 枚举_外设Tracker轨迹状态::新建;
                轨迹连续帧数 = 1;
            } else if (最佳项->稳定状态 > 0) {
                轨迹状态 = 枚举_外设Tracker轨迹状态::稳定;
                轨迹连续帧数 = 最佳项->连续稳定命中次数;
            }
            D455_写入簇Tracker轨迹状态(
                簇,
                轨迹状态,
                轨迹连续帧数,
                报告->时间戳毫秒);
            最长轨迹连续帧数 = (std::max<std::int64_t>)(最长轨迹连续帧数, 轨迹连续帧数);
            簇.平滑中心X = 最佳项->平滑中心X;
            簇.平滑中心Y = 最佳项->平滑中心Y;
            簇.平滑中心Z = 最佳项->平滑中心Z;
            簇.平滑投影最小X = 最佳项->平滑投影最小X;
            簇.平滑投影最大X = 最佳项->平滑投影最大X;
            簇.平滑投影最小Y = 最佳项->平滑投影最小Y;
            簇.平滑投影最大Y = 最佳项->平滑投影最大Y;
            if (簇.跨帧轨迹稳定状态 > 0) {
                ++稳定数量;
            }
            if (簇.跨帧轨迹待发布状态 > 0) {
                ++待发布数量;
            }
        }

        std::int64_t 丢失数量 = 0;
        std::int64_t 短时丢失数量 = 0;
        std::int64_t 已丢失数量 = 0;
        for (auto& 项 : 缓存) {
            if (!项.本帧已匹配) {
                ++项.丢失次数;
                项.丢失宽限计数 =
                    项.丢失次数 <= D455_丢失宽限帧数
                    ? D455_丢失宽限帧数 - 项.丢失次数 + 1
                    : 0;
                if (项.丢失宽限计数 > 0) {
                    ++短时丢失数量;
                } else {
                    ++已丢失数量;
                }
                if (项.丢失次数 > D455_丢失宽限帧数) {
                    项.连续命中次数 = 0;
                    项.连续稳定命中次数 = 0;
                    项.连续发布次数 = 0;
                    项.稳定状态 = 0;
                }
                项.待发布状态 = 0;
                ++丢失数量;
            }
        }
        缓存.erase(
            std::remove_if(
                缓存.begin(),
                缓存.end(),
                [](const auto& 项) noexcept {
                    return 项.丢失次数 > 5;
                }),
            缓存.end());

        报告->跨帧采集状态 = 1;
        报告->跨帧匹配观察像素簇数量 = 匹配数量;
        报告->跨帧新建观察像素簇数量 = 新建数量;
        报告->跨帧稳定观察像素簇数量 = 稳定数量;
        报告->跨帧丢失观察像素簇数量 = 丢失数量;
        std::ostringstream 摘要;
        摘要 << "匹配=" << 匹配数量
            << ";新建=" << 新建数量
            << ";稳定=" << 稳定数量
            << ";待发布=" << 待发布数量
            << ";短时丢失=" << 短时丢失数量
            << ";已丢失=" << 已丢失数量
            << ";丢失=" << 丢失数量;
        报告->跨帧采集摘要 = 摘要.str();
        if (稳定数量 > 0) {
            D455_写入报告Tracker轨迹状态(
                报告,
                枚举_外设Tracker轨迹状态::稳定,
                最长轨迹连续帧数);
        } else if (匹配数量 > 0) {
            D455_写入报告Tracker轨迹状态(
                报告,
                枚举_外设Tracker轨迹状态::候选,
                最长轨迹连续帧数);
        } else if (新建数量 > 0) {
            D455_写入报告Tracker轨迹状态(
                报告,
                枚举_外设Tracker轨迹状态::新建,
                1);
        } else if (短时丢失数量 > 0) {
            D455_写入报告Tracker轨迹状态(
                报告,
                枚举_外设Tracker轨迹状态::短时丢失,
                0);
        } else if (已丢失数量 > 0) {
            D455_写入报告Tracker轨迹状态(
                报告,
                枚举_外设Tracker轨迹状态::已丢失,
                0);
        }
    }

    // 功能：把处理结果写入指定对象、场景或日志。
    void D455_把跨帧采集摘要写入样本(
        const 结构_外设观察报告队列项& 报告,
        结构_D455深度相机观察样本* 样本) noexcept
    {
        if (!样本 || 报告.跨帧采集状态 <= 0) {
            return;
        }
        样本->跨帧采集可用 = true;
        样本->跨帧匹配簇数量 = 报告.跨帧匹配观察像素簇数量;
        样本->跨帧新建簇数量 = 报告.跨帧新建观察像素簇数量;
        样本->跨帧稳定簇数量 = 报告.跨帧稳定观察像素簇数量;
        样本->跨帧丢失簇数量 = 报告.跨帧丢失观察像素簇数量;
        const auto 主簇 = std::max_element(
            报告.观察像素簇集合.begin(),
            报告.观察像素簇集合.end(),
            [](const auto& 左, const auto& 右) noexcept {
                return 左.像素数量 < 右.像素数量;
            });
        if (主簇 != 报告.观察像素簇集合.end()) {
            样本->主候选跨帧簇ID = 主簇->外设跨帧簇ID;
            样本->主候选跨帧连续命中次数 = 主簇->跨帧连续命中次数;
            样本->主候选跨帧连续稳定命中次数 = 主簇->跨帧连续稳定命中次数;
            样本->主候选跨帧连续发布次数 = 主簇->跨帧连续发布次数;
            样本->主候选跨帧轨迹稳定状态 = 主簇->跨帧轨迹稳定状态;
            样本->主候选跨帧复现离散度 = 主簇->跨帧复现离散度;
            样本->主候选投影最小X = 主簇->投影最小X;
            样本->主候选投影最大X = 主簇->投影最大X;
            样本->主候选投影最小Y = 主簇->投影最小Y;
            样本->主候选投影最大Y = 主簇->投影最大Y;
        }
    }

    // 功能：根据当前输入生成目标数据、场景、动态或回执。
    结构_D455深度相机观察样本 D455_从调用结果生成样本(
        std::uint64_t 序号,
        const 双目相机本能适配器::调用结果& 来源)
    {
        结构_D455深度相机观察样本 样本{};
        样本.序号 = 序号;
        样本.采集成功 = 来源.成功;
        样本.相机已打开 = 来源.相机已打开;
        样本.失败原因 = static_cast<std::uint8_t>(来源.原因);
        样本.消息 = 来源.消息;
        样本.帧宽度 = 来源.宽度;
        样本.帧高度 = 来源.高度;
        样本.深度帧号 = 来源.深度帧号;
        样本.彩色帧号 = 来源.彩色帧号;
        样本.预期像素数量 = 来源.预期像素数量;
        样本.像素特征数量 = 来源.像素特征数量;
        样本.深度有效像素数量 = 来源.深度有效像素数量;
        样本.点云有效像素数量 = 来源.点云有效像素数量;
        样本.深度有效率 = 来源.深度有效率;
        样本.空间坐标有效率 = 来源.空间坐标有效率;
        样本.帧质量评分 = 来源.帧质量评分;
        样本.空间候选数量 = 来源.空间候选数量;

        if (!来源.空间候选列表.empty()) {
            const auto 主候选 = std::max_element(
                来源.空间候选列表.begin(),
                来源.空间候选列表.end(),
                [](const auto& 左, const auto& 右) noexcept {
                    return 左.像素数量 < 右.像素数量;
                });
            if (主候选 != 来源.空间候选列表.end()) {
                样本.主候选编号 = 主候选->候选编号;
                样本.主候选像素数量 = 主候选->像素数量;
                样本.中心X = 主候选->中心X;
                样本.中心Y = 主候选->中心Y;
                样本.中心Z = 主候选->中心Z;
                样本.范围稳定性评分 = 主候选->范围稳定性评分;
            }
        }

        样本.基础特征可比 = 样本.采集成功
            && 样本.帧宽度 > 0
            && 样本.帧高度 > 0
            && 样本.预期像素数量 > 0
            && 样本.像素特征数量 > 0;
        return 样本;
    }

    // 功能：根据当前输入生成目标数据、场景、动态或回执。
    结构_外设观察报告队列项 D455_从调用结果生成逐簇识别报告(
        const 双目相机本能适配器::调用结果& 来源)
    {
        结构_外设观察报告队列项 报告{};
        报告.来源外设ID = D455_外设ID;
        报告.观察运行模式 = 枚举_外设观察运行模式::陌生环境逐簇识别;
        报告.报告类型 = 枚举_外设观察报告类型::逐簇识别报告;
        报告.本帧处理模式 = 枚举_外设分割处理模式::全局观察;
        报告.本帧处理优先级 = 50;
        报告.时间戳毫秒 = 来源.系统到达时间_us > 0
            ? static_cast<std::int64_t>(来源.系统到达时间_us / 1000)
            : 0;
        报告.采集成功 = 来源.成功;
        报告.配置摘要 =
            "D455项目分割迁移配置;深度切片=300mm;最小材料面积=900px;最大材料数=24;外设线程内部工程代码生成逐簇识别报告";
        报告.失败原因 = 来源.成功 ? "" : 来源.消息;
        报告.帧宽度 = 来源.宽度;
        报告.帧高度 = 来源.高度;
        报告.深度帧号 = 来源.深度帧号;
        报告.彩色帧号 = 来源.彩色帧号;
        报告.原始观察帧句柄 = D455_构造观察帧资源句柄("raw-observation-frame", 来源);
        报告.深度帧句柄 = D455_构造观察帧资源句柄("depth-frame", 来源);
        报告.彩色帧句柄 = D455_构造观察帧资源句柄("color-frame", 来源);
        报告.对齐帧句柄 = D455_构造观察帧资源句柄("aligned-depth-color-frame", 来源);
        报告.空间候选队列引用 = D455_构造观察帧资源句柄("spatial-candidate-queue", 来源);
        报告.像素归属账本引用 = D455_构造观察帧资源句柄("pixel-attribution-ledger-input", 来源);
        报告.相机内参版本 = "D455默认内参";
        报告.相机外参版本 = "D455默认外参";
        报告.坐标系版本 = "D455/color-aligned-depth/v1";
        报告.主分割坐标系ID = "D455/color-aligned-depth/v1";
        报告.深度材料坐标系ID = 报告.主分割坐标系ID;
        报告.RGB裁剪材料坐标系ID = 报告.主分割坐标系ID;
        报告.像素掩码坐标系ID = 报告.主分割坐标系ID;
        报告.左红外边缘坐标系ID = "D455/left-ir/native/v1";
        报告.深度材料坐标对齐状态 = 枚举_外设坐标对齐状态::已对齐;
        报告.RGB裁剪材料坐标对齐状态 = 来源.彩色深度已对齐 > 0
            ? 枚举_外设坐标对齐状态::已对齐
            : 枚举_外设坐标对齐状态::未对齐;
        报告.像素掩码坐标对齐状态 = 枚举_外设坐标对齐状态::已对齐;
        报告.左红外边缘坐标对齐状态 = 枚举_外设坐标对齐状态::未参与;
        报告.坐标系一致性状态 = 来源.彩色深度已对齐 > 0
            ? 枚举_外设坐标系一致性状态::一致
            : 枚举_外设坐标系一致性状态::不一致;
        报告.报告生成方法ID = "D455_从迁移分割结果生成逐簇识别报告";
        报告.报告生成方法版本 = "20260614-D455项目分割迁移";
        报告.报告置信度 = 来源.成功 ? 来源.帧质量评分 : 0;
        报告.预期像素数量 = 来源.预期像素数量;
        报告.像素特征数量 = 来源.像素特征数量;
        报告.深度有效率 = 来源.深度有效率;
        报告.空间坐标有效率 = 来源.空间坐标有效率;
        报告.帧质量评分 = 来源.帧质量评分;
        报告.低质量区域数量 = 来源.诊断区域数量;
        报告.未归簇区域数量 = 来源.条件不足候选数量 + 来源.待验证候选数量;
        报告.不可观测区域数量 = 来源.深度空洞区域数量;
        报告.未解释区域比例 = 来源.未解释区域比例;
        报告.稳定锚点数量 = 来源.空间候选有效点数量;
        报告.稳定锚点密度 = 来源.预期像素数量 > 0
            ? (来源.空间候选有效点数量 * 10000) / 来源.预期像素数量
            : 0;
        报告.稳定锚点覆盖率 = 来源.深度有效率;
        报告.边界锚点覆盖率 = 来源.边界深度稳定率 > 0
            ? 来源.边界深度稳定率
            : 来源.轮廓深度支持率;

        报告.观察像素簇集合.reserve(来源.空间候选列表.size());
        for (const auto& 候选 : 来源.空间候选列表) {
            结构_外设观察像素簇摘要 簇{};
            簇.外设内部簇ID = 候选.候选编号;
            簇.来源空间候选ID = 候选.候选编号;
            簇.像素数量 = 候选.像素数量;
            簇.投影最小X = 候选.投影最小X;
            簇.投影最大X = 候选.投影最大X;
            簇.投影最小Y = 候选.投影最小Y;
            簇.投影最大Y = 候选.投影最大Y;
            簇.中心X = 候选.中心X;
            簇.中心Y = 候选.中心Y;
            簇.中心Z = 候选.中心Z;
            簇.空间范围最小X = 候选.范围最小X;
            簇.空间范围最大X = 候选.范围最大X;
            簇.空间范围最小Y = 候选.范围最小Y;
            簇.空间范围最大Y = 候选.范围最大Y;
            簇.空间范围最小Z = 候选.范围最小Z;
            簇.空间范围最大Z = 候选.范围最大Z;
            簇.深度有效率 = 候选.有效点比例;
            簇.空间坐标有效率 = 候选.有效点比例;
            簇.空间连续性评分 = 候选.空间连续性评分;
            簇.范围稳定性评分 = 候选.范围稳定性评分;
            簇.轮廓置信度 = 候选.轮廓置信度;
            簇.稳定锚点数量 = 候选.像素数量 > 0
                ? (候选.像素数量 * (std::max<std::int64_t>)(0, 候选.有效点比例)) / 10000
                : 0;
            簇.稳定锚点密度 = 候选.有效点比例;
            簇.稳定锚点覆盖率 = 候选.有效点比例;
            簇.边界锚点覆盖率 = 候选.轮廓深度支持率 > 0
                ? 候选.轮廓深度支持率
                : 候选.有效点比例;
            簇.局部图宽度 = 候选.投影最大X >= 候选.投影最小X
                ? 候选.投影最大X - 候选.投影最小X + 1
                : 0;
            簇.局部图高度 = 候选.投影最大Y >= 候选.投影最小Y
                ? 候选.投影最大Y - 候选.投影最小Y + 1
                : 0;
            簇.ROI引用 = D455_构造观察簇资源句柄(
                "cluster-roi",
                来源,
                候选);
            簇.点集引用 = D455_构造观察簇资源句柄(
                "cluster-point-set",
                来源,
                候选);
            簇.空间候选引用 = D455_构造观察簇资源句柄(
                "spatial-candidate",
                来源,
                候选);
            簇.像素归属验证材料引用 = D455_构造观察簇资源句柄(
                "pixel-attribution-material",
                来源,
                候选);
            if (D455_观察簇投影有效(簇, 来源.宽度, 来源.高度)) {
                簇.可提交观察区域 = 簇.像素数量 > 0;
                簇.像素集合掩码状态 = 1;
                簇.彩色轮廓局部图状态 = 1;
                簇.深度轮廓局部图状态 = 1;
                簇.像素集合掩码句柄 = D455_构造观察簇资源句柄(
                    "cluster-mask",
                    来源,
                    候选);
                簇.彩色轮廓局部图句柄 = D455_构造观察簇资源句柄(
                    "color-crop",
                    来源,
                    候选);
                簇.深度轮廓局部图句柄 = D455_构造观察簇资源句柄(
                    "depth-crop",
                    来源,
                    候选);
            } else {
                簇.可提交观察区域 = false;
                簇.像素集合掩码状态 = 0;
                簇.彩色轮廓局部图状态 = 0;
                簇.深度轮廓局部图状态 = 0;
                簇.失败原因 = "观察像素簇投影边界无效，无法建立掩码或局部图句柄";
            }
            报告.观察像素簇集合.push_back(std::move(簇));
        }
        return 报告;
    }

    // 功能：按函数名执行对应处理。
    std::uint64_t D455_外设帧ID_由报告(
        const 结构_外设观察报告队列项& 报告) noexcept
    {
        if (报告.深度帧号 > 0) {
            return static_cast<std::uint64_t>(报告.深度帧号);
        }
        if (报告.彩色帧号 > 0) {
            return static_cast<std::uint64_t>(报告.彩色帧号);
        }
        return 报告.报告ID;
    }

    // 功能：按函数名执行对应处理。
    bool D455_观察像素簇满足稳定子集发布门(
        const 结构_外设观察像素簇摘要& 簇) noexcept
    {
        return 簇.跨帧轨迹稳定状态 > 0
            && 簇.跨帧连续稳定命中次数 >= D455_稳定连续命中阈值
            && 簇.跨帧复现离散度 <= D455_稳定复现分值阈值;
    }

    // 功能：按函数名执行对应处理。
    bool D455_报告满足L1稳定子集口径(
        const 结构_外设观察报告队列项& 报告) noexcept
    {
        return 报告.报告类型 == 枚举_外设观察报告类型::逐簇识别报告
            && 报告.报告层级 >= 1
            && 报告.跨帧采集状态 > 0
            && 报告.跨帧稳定观察像素簇数量 > 0
            && !报告.观察像素簇集合.empty();
    }

    // 功能：从指定来源读取数据或状态。
    std::optional<结构_外设观察报告队列项> D455_读取最新L1稳定子集报告()
    {
        auto 报告 = 读取最新外设观察报告(
            D455_外设ID,
            枚举_外设观察报告类型::逐簇识别报告);
        if (报告.has_value() && D455_报告满足L1稳定子集口径(*报告)) {
            return 报告;
        }
        return std::nullopt;
    }

    // 功能：根据当前输入生成目标数据、场景、动态或回执。
    结构_外设观察报告队列项 D455_从逐簇识别报告生成稳定观察子集报告(
        const 结构_外设观察报告队列项& 原始报告)
    {
        结构_外设观察报告队列项 报告 = 原始报告;
        报告.报告ID = 0;
        报告.对应命令ID = 0;
        报告.匹配等待项ID = 0;
        报告.报告层级 = 1;
        报告.来源原始报告ID = 原始报告.报告ID;
        报告.来源外设帧ID = D455_外设帧ID_由报告(原始报告);
        报告.报告生成方法ID = "D455_从逐簇识别报告生成稳定观察子集报告";
        报告.报告生成方法版本 = "20260611-P2-L1稳定子集";
        报告.配置摘要 =
            原始报告.配置摘要
            + ";L1稳定观察子集由L0原始逐簇识别报告派生;材料句柄回查来源原始报告";
        报告.已消费 = false;
        报告.消费等待项ID = 0;
        报告.消费时间毫秒 = 0;
        报告.观察像素簇集合.clear();
        报告.观察像素簇集合.reserve(
            static_cast<std::size_t>(
                std::max<std::int64_t>(0, 原始报告.跨帧稳定观察像素簇数量)));

        for (const auto& 簇 : 原始报告.观察像素簇集合) {
            if (!D455_观察像素簇满足稳定子集发布门(簇)) {
                continue;
            }
            报告.观察像素簇集合.push_back(簇);
        }

        const auto 稳定子集数量 =
            static_cast<std::int64_t>(报告.观察像素簇集合.size());
        std::int64_t 平面轮廓稳定簇数量 = 0;
        std::int64_t 深度锚定簇数量 = 0;
        std::int64_t 空间可用簇数量 = 0;
        std::int64_t 稳定锚点数量 = 0;
        std::int64_t 总像素数量 = 0;
        std::int64_t 边界锚点覆盖率累计 = 0;
        std::int64_t 边界锚点覆盖率样本 = 0;
        for (const auto& 簇 : 报告.观察像素簇集合) {
            const bool 有平面轮廓材料 =
                簇.像素数量 > 0
                || !簇.ROI引用.empty()
                || !簇.像素集合掩码句柄.empty()
                || !簇.彩色轮廓局部图句柄.empty();
            const bool 深度锚定 =
                簇.深度有效率 >= 5000
                || 簇.深度轮廓局部图状态 > 0
                || !簇.深度轮廓局部图句柄.empty();
            const bool 空间可用 =
                簇.空间坐标有效率 >= 5000
                || !簇.空间候选引用.empty()
                || !簇.点集引用.empty();
            总像素数量 += (std::max<std::int64_t>)(0, 簇.像素数量);
            稳定锚点数量 += (std::max<std::int64_t>)(0, 簇.稳定锚点数量);
            const auto 簇边界锚点覆盖率 = 簇.边界锚点覆盖率 > 0
                ? 簇.边界锚点覆盖率
                : 簇.深度有效率;
            if (簇边界锚点覆盖率 > 0) {
                边界锚点覆盖率累计 += 簇边界锚点覆盖率;
                ++边界锚点覆盖率样本;
            }
            if (有平面轮廓材料) {
                ++平面轮廓稳定簇数量;
            }
            if (有平面轮廓材料 && 深度锚定) {
                ++深度锚定簇数量;
            }
            if (有平面轮廓材料 && 深度锚定 && 空间可用) {
                ++空间可用簇数量;
            }
        }
        const bool 平面轮廓稳定 =
            稳定子集数量 > 0
            && 平面轮廓稳定簇数量 == 稳定子集数量;
        报告.稳定锚点数量 = 稳定锚点数量;
        报告.稳定锚点密度 = 总像素数量 > 0
            ? (稳定锚点数量 * 10000) / 总像素数量
            : 0;
        报告.稳定锚点覆盖率 = 报告.稳定锚点密度;
        报告.边界锚点覆盖率 = 边界锚点覆盖率样本 > 0
            ? 边界锚点覆盖率累计 / 边界锚点覆盖率样本
            : 0;
        const bool anchor支持达标 =
            报告.稳定锚点数量 >= 16
            && 报告.稳定锚点密度 >= 3000
            && 报告.稳定锚点覆盖率 >= 3000;
        const bool 坐标系一致 =
            报告.坐标系一致性状态 == 枚举_外设坐标系一致性状态::一致;
        const bool 深度锚定 =
            平面轮廓稳定
            && anchor支持达标
            && (报告.深度有效率 >= 5000 || 深度锚定簇数量 == 稳定子集数量);
        const bool 空间可用 =
            坐标系一致
            && 深度锚定
            && (报告.空间坐标有效率 >= 5000 || 空间可用簇数量 == 稳定子集数量);
        报告.平面轮廓稳定状态 = 平面轮廓稳定 ? 1 : 0;
        报告.深度锚定状态 = 深度锚定 ? 1 : 0;
        报告.空间可用状态 = 空间可用 ? 1 : 0;
        报告.外设材料可承接状态 = 平面轮廓稳定 ? 1 : 0;
        报告.可承接能力等级 = 空间可用
            ? 枚举_外设材料能力等级::空间可用
            : (深度锚定
                ? 枚举_外设材料能力等级::深度锚定
                : (平面轮廓稳定
                    ? 枚举_外设材料能力等级::平面轮廓
                    : 枚举_外设材料能力等级::候选或缺口));
        报告.跨帧采集状态 = 原始报告.跨帧采集状态;
        报告.跨帧匹配观察像素簇数量 = 稳定子集数量;
        报告.跨帧新建观察像素簇数量 = 0;
        报告.跨帧稳定观察像素簇数量 = 稳定子集数量;
        报告.跨帧丢失观察像素簇数量 = 0;
        std::ostringstream 摘要;
        摘要 << "L1稳定观察子集"
            << ";来源原始报告ID=" << 原始报告.报告ID
            << ";来源外设帧ID=" << 报告.来源外设帧ID
            << ";原始簇=" << 原始报告.观察像素簇集合.size()
            << ";稳定子集=" << 稳定子集数量
            << ";能力等级=" << 外设材料能力等级文本(报告.可承接能力等级)
            << ";坐标系一致性=" << 外设坐标系一致性状态文本(报告.坐标系一致性状态)
            << ";anchor数量=" << 报告.稳定锚点数量
            << ";anchor密度=" << 报告.稳定锚点密度
            << ";anchor覆盖率=" << 报告.稳定锚点覆盖率
            << ";边界anchor覆盖率=" << 报告.边界锚点覆盖率
            << ";平面轮廓稳定=" << 报告.平面轮廓稳定状态
            << ";深度锚定=" << 报告.深度锚定状态
            << ";空间可用=" << 报告.空间可用状态
            << ";稳定门=连续稳定命中>=" << D455_稳定连续命中阈值
            << ",复现离散度<=" << D455_稳定复现分值阈值;
        报告.跨帧采集摘要 = 摘要.str();
        return 报告;
    }

    // 功能：按函数名执行对应处理。
    void D455_复制观察报告帧摘要(
        const 结构_外设观察报告队列项& 来源,
        结构_外设观察报告队列项* 输出) noexcept
    {
        if (!输出) {
            return;
        }
        输出->时间戳毫秒 = 来源.时间戳毫秒;
        输出->采集成功 = 来源.采集成功;
        输出->帧宽度 = 来源.帧宽度;
        输出->帧高度 = 来源.帧高度;
        输出->深度帧号 = 来源.深度帧号;
        输出->彩色帧号 = 来源.彩色帧号;
        输出->原始观察帧句柄 = 来源.原始观察帧句柄;
        输出->深度帧句柄 = 来源.深度帧句柄;
        输出->彩色帧句柄 = 来源.彩色帧句柄;
        输出->对齐帧句柄 = 来源.对齐帧句柄;
        输出->空间候选队列引用 = 来源.空间候选队列引用;
        输出->像素归属账本引用 = 来源.像素归属账本引用;
        输出->相机内参版本 = 来源.相机内参版本;
        输出->相机外参版本 = 来源.相机外参版本;
        输出->坐标系版本 = 来源.坐标系版本;
        输出->主分割坐标系ID = 来源.主分割坐标系ID;
        输出->深度材料坐标系ID = 来源.深度材料坐标系ID;
        输出->左红外边缘坐标系ID = 来源.左红外边缘坐标系ID;
        输出->RGB裁剪材料坐标系ID = 来源.RGB裁剪材料坐标系ID;
        输出->像素掩码坐标系ID = 来源.像素掩码坐标系ID;
        输出->深度材料坐标对齐状态 = 来源.深度材料坐标对齐状态;
        输出->左红外边缘坐标对齐状态 = 来源.左红外边缘坐标对齐状态;
        输出->RGB裁剪材料坐标对齐状态 = 来源.RGB裁剪材料坐标对齐状态;
        输出->像素掩码坐标对齐状态 = 来源.像素掩码坐标对齐状态;
        输出->坐标系一致性状态 = 来源.坐标系一致性状态;
        输出->报告生成方法ID = 来源.报告生成方法ID;
        输出->报告生成方法版本 = 来源.报告生成方法版本;
        输出->报告置信度 = 来源.报告置信度;
        输出->预期像素数量 = 来源.预期像素数量;
        输出->像素特征数量 = 来源.像素特征数量;
        输出->深度有效率 = 来源.深度有效率;
        输出->空间坐标有效率 = 来源.空间坐标有效率;
        输出->帧质量评分 = 来源.帧质量评分;
        输出->低质量区域数量 = 来源.低质量区域数量;
        输出->未归簇区域数量 = 来源.未归簇区域数量;
        输出->不可观测区域数量 = 来源.不可观测区域数量;
        输出->未解释区域比例 = 来源.未解释区域比例;
        输出->跨帧采集状态 = 来源.跨帧采集状态;
        输出->跨帧匹配观察像素簇数量 = 来源.跨帧匹配观察像素簇数量;
        输出->跨帧新建观察像素簇数量 = 来源.跨帧新建观察像素簇数量;
        输出->跨帧稳定观察像素簇数量 = 来源.跨帧稳定观察像素簇数量;
        输出->跨帧丢失观察像素簇数量 = 来源.跨帧丢失观察像素簇数量;
        输出->跨帧采集摘要 = 来源.跨帧采集摘要;
        输出->平面轮廓稳定状态 = 来源.平面轮廓稳定状态;
        输出->深度锚定状态 = 来源.深度锚定状态;
        输出->空间可用状态 = 来源.空间可用状态;
        输出->外设材料可承接状态 = 来源.外设材料可承接状态;
        输出->可承接能力等级 = 来源.可承接能力等级;
        输出->稳定锚点数量 = 来源.稳定锚点数量;
        输出->稳定锚点密度 = 来源.稳定锚点密度;
        输出->稳定锚点覆盖率 = 来源.稳定锚点覆盖率;
        输出->边界锚点覆盖率 = 来源.边界锚点覆盖率;
        输出->来源原始报告ID = 来源.来源原始报告ID;
        输出->来源外设帧ID = 来源.来源外设帧ID;
    }

    // 功能：按条件查找目标对象、方法或事实。
    const 结构_外设观察像素簇摘要* D455_按跨帧簇ID查找观察像素簇(
        const std::vector<结构_外设观察像素簇摘要>& 簇集合,
        std::int64_t 跨帧簇ID) noexcept
    {
        if (跨帧簇ID < 0) {
            return nullptr;
        }
        for (const auto& 簇 : 簇集合) {
            if (簇.外设跨帧簇ID == 跨帧簇ID
                || 簇.外设内部簇ID == 跨帧簇ID) {
                return &簇;
            }
        }
        return nullptr;
    }

    // 功能：按函数名执行对应处理。
    bool D455_观察像素簇存在明显变化(
        const 结构_外设观察像素簇摘要& 当前,
        const 结构_外设观察像素簇摘要& 基准) noexcept
    {
        if (当前.外设跨帧簇ID >= 0
            && 当前.外设跨帧簇ID == 基准.外设跨帧簇ID
            && 当前.跨帧匹配状态 > 0
            && 当前.跨帧连续命中次数 >= 2) {
            return false;
        }
        return D455_I64绝对差(当前.中心X, 基准.中心X) > 30
            || D455_I64绝对差(当前.中心Y, 基准.中心Y) > 30
            || D455_I64绝对差(当前.中心Z, 基准.中心Z) > 50
            || D455_I64绝对差(当前.像素数量, 基准.像素数量) > D455_计数容差(基准.像素数量)
            || D455_I64绝对差(当前.轮廓置信度, 基准.轮廓置信度) > 1500;
    }

    // 功能：按函数名执行对应处理。
    std::int64_t D455_当前时间毫秒() noexcept
    {
        const auto now = std::chrono::steady_clock::now().time_since_epoch();
        return std::chrono::duration_cast<std::chrono::milliseconds>(now).count();
    }

    // 功能：按函数名执行对应处理。
    bool D455_目标观察约束二维范围有效(const 结构_目标观察约束特征组& 约束) noexcept
    {
        return 约束.二维最大X > 约束.二维最小X
            && 约束.二维最大Y > 约束.二维最小Y;
    }

    // 功能：按函数名执行对应处理。
    bool D455_目标观察约束空间范围有效(const 结构_目标观察约束特征组& 约束) noexcept
    {
        return 约束.空间范围最大X > 约束.空间范围最小X
            && 约束.空间范围最大Y > 约束.空间范围最小Y
            && 约束.空间范围最大Z > 约束.空间范围最小Z;
    }

    // 功能：按函数名执行对应处理。
    bool D455_区间重叠(
        std::int64_t 左最小,
        std::int64_t 左最大,
        std::int64_t 右最小,
        std::int64_t 右最大,
        std::int64_t* 输出重叠长度) noexcept
    {
        const auto 重叠最小 = (std::max<std::int64_t>)(左最小, 右最小);
        const auto 重叠最大 = (std::min<std::int64_t>)(左最大, 右最大);
        const bool 有重叠 = 重叠最大 >= 重叠最小;
        if (输出重叠长度) {
            *输出重叠长度 = 有重叠 ? 重叠最大 - 重叠最小 + 1 : 0;
        }
        return 有重叠;
    }

    // 功能：按函数名执行对应处理。
    std::optional<std::int64_t> D455_按目标特征估算观察值(
        const std::string& 目标特征类型ID,
        const 结构_外设观察像素簇摘要& 簇)
    {
        if (目标特征类型ID.empty()) {
            return std::nullopt;
        }
        if (目标特征类型ID.find("像素") != std::string::npos) {
            return 簇.像素数量;
        }
        if (目标特征类型ID.find("投影中心X") != std::string::npos
            || 目标特征类型ID.find("中心X") != std::string::npos) {
            return D455_投影中心X(簇);
        }
        if (目标特征类型ID.find("投影中心Y") != std::string::npos
            || 目标特征类型ID.find("中心Y") != std::string::npos) {
            return D455_投影中心Y(簇);
        }
        if (目标特征类型ID.find("中心Z") != std::string::npos
            || 目标特征类型ID.find("距离") != std::string::npos
            || 目标特征类型ID.find("深度") != std::string::npos) {
            return 簇.中心Z;
        }
        if (目标特征类型ID.find("空间范围最小X") != std::string::npos) {
            return 簇.空间范围最小X;
        }
        if (目标特征类型ID.find("空间范围最大X") != std::string::npos) {
            return 簇.空间范围最大X;
        }
        if (目标特征类型ID.find("空间范围最小Y") != std::string::npos) {
            return 簇.空间范围最小Y;
        }
        if (目标特征类型ID.find("空间范围最大Y") != std::string::npos) {
            return 簇.空间范围最大Y;
        }
        if (目标特征类型ID.find("空间范围最小Z") != std::string::npos) {
            return 簇.空间范围最小Z;
        }
        if (目标特征类型ID.find("空间范围最大Z") != std::string::npos) {
            return 簇.空间范围最大Z;
        }
        return std::nullopt;
    }

    // 功能：按函数名执行对应处理。
    std::int64_t D455_目标约束使用状态_由判定(
        const 结构_目标观察约束可用性判定& 判定) noexcept
    {
        if (判定.可强匹配) {
            return 1;
        }
        if (判定.可降级匹配) {
            return 2;
        }
        switch (判定.状态) {
        case 枚举_目标观察约束可用性::已过期:
            return 3;
        case 枚举_目标观察约束可用性::generation失配:
            return 4;
        case 枚举_目标观察约束可用性::材料不可回查:
            return 5;
        default:
            return 6;
        }
    }

    // 功能：把处理结果写入指定对象、场景或日志。
    void D455_写入报告目标观察约束字段(
        结构_外设观察报告队列项* 报告,
        const 结构_外设观察等待项& 等待项,
        const std::optional<结构_目标观察约束特征组>& 约束,
        std::int64_t 使用状态)
    {
        if (!报告) {
            return;
        }
        报告->目标观察约束ID = 约束.has_value() ? 约束->约束ID : 等待项.目标观察约束ID;
        报告->约束generation = 约束.has_value() ? 约束->约束generation : 等待项.约束generation;
        报告->目标特征generation = 约束.has_value() ? 约束->目标特征generation : 等待项.目标特征generation;
        报告->来源材料generation = 约束.has_value() ? 约束->来源材料generation : 等待项.来源材料generation;
        报告->本帧处理模式 = 等待项.本帧处理模式;
        报告->本帧处理优先级 = 等待项.本帧处理优先级;
        报告->本帧处理掩码句柄 = 约束.has_value() && !约束->像素集合掩码句柄.empty()
            ? 约束->像素集合掩码句柄
            : 等待项.本帧处理掩码句柄;
        报告->目标约束使用状态 = 使用状态;
        报告->报告层级 = 使用状态 == 1 ? 2 : (使用状态 == 2 ? 1 : 0);
    }

    // 功能：把处理结果写入指定对象、场景或日志。
    void D455_写入目标特征观察值(
        结构_外设观察报告队列项* 报告,
        const 结构_外设观察等待项& 等待项,
        const std::optional<结构_目标观察约束特征组>& 约束,
        const 结构_外设观察像素簇摘要& 命中簇)
    {
        if (!报告) {
            return;
        }
        const auto 观察值 = D455_按目标特征估算观察值(等待项.目标特征类型ID, 命中簇);
        if (!观察值.has_value()) {
            return;
        }

        报告->目标特征当前观察值 = *观察值;
        const bool 基准是I64 = 约束.has_value()
            ? 约束->目标特征当前值类型 == 枚举_目标特征当前值类型::I64
            : 等待项.目标特征当前值类型 == 枚举_目标特征当前值类型::I64;
        if (基准是I64) {
            const auto 基准值 = 约束.has_value()
                ? 约束->目标特征当前值
                : 等待项.目标特征当前值;
            报告->目标特征误差值 = D455_I64绝对差(*观察值, 基准值);
        }
    }

    // 功能：按函数名执行对应处理。
    bool D455_观察簇命中目标约束(
        const 结构_外设观察像素簇摘要& 簇,
        const 结构_目标观察约束特征组& 约束,
        std::int64_t* 输出分值) noexcept
    {
        bool 已命中 = false;
        std::int64_t 最佳分值 = 0;

        if ((!约束.ROI引用.empty() && 约束.ROI引用 == 簇.ROI引用)
            || (!约束.像素集合掩码句柄.empty() && 约束.像素集合掩码句柄 == 簇.像素集合掩码句柄)
            || (!约束.点集引用.empty() && 约束.点集引用 == 簇.点集引用)) {
            已命中 = true;
            最佳分值 = 0;
        }

        if (D455_目标观察约束二维范围有效(约束)) {
            std::int64_t 重叠X = 0;
            std::int64_t 重叠Y = 0;
            const bool 投影重叠 = D455_区间重叠(
                    约束.二维最小X,
                    约束.二维最大X,
                    簇.投影最小X,
                    簇.投影最大X,
                    &重叠X)
                && D455_区间重叠(
                    约束.二维最小Y,
                    约束.二维最大Y,
                    簇.投影最小Y,
                    簇.投影最大Y,
                    &重叠Y);
            if (投影重叠) {
                const auto 约束中心X = (约束.二维最小X + 约束.二维最大X) / 2;
                const auto 约束中心Y = (约束.二维最小Y + 约束.二维最大Y) / 2;
                const auto 分值 =
                    D455_I64绝对差(约束中心X, D455_投影中心X(簇))
                    + D455_I64绝对差(约束中心Y, D455_投影中心Y(簇))
                    - (重叠X + 重叠Y);
                if (!已命中 || 分值 < 最佳分值) {
                    已命中 = true;
                    最佳分值 = 分值;
                }
            }
        }

        if (D455_目标观察约束空间范围有效(约束)) {
            std::int64_t 重叠X = 0;
            std::int64_t 重叠Y = 0;
            std::int64_t 重叠Z = 0;
            const bool 空间重叠 = D455_区间重叠(
                    约束.空间范围最小X,
                    约束.空间范围最大X,
                    簇.空间范围最小X,
                    簇.空间范围最大X,
                    &重叠X)
                && D455_区间重叠(
                    约束.空间范围最小Y,
                    约束.空间范围最大Y,
                    簇.空间范围最小Y,
                    簇.空间范围最大Y,
                    &重叠Y)
                && D455_区间重叠(
                    约束.空间范围最小Z,
                    约束.空间范围最大Z,
                    簇.空间范围最小Z,
                    簇.空间范围最大Z,
                    &重叠Z);
            if (空间重叠) {
                const auto 约束中心X = (约束.空间范围最小X + 约束.空间范围最大X) / 2;
                const auto 约束中心Y = (约束.空间范围最小Y + 约束.空间范围最大Y) / 2;
                const auto 约束中心Z = (约束.空间范围最小Z + 约束.空间范围最大Z) / 2;
                const auto 分值 =
                    D455_I64绝对差(约束中心X, 簇.中心X)
                    + D455_I64绝对差(约束中心Y, 簇.中心Y)
                    + D455_I64绝对差(约束中心Z, 簇.中心Z)
                    - (重叠X + 重叠Y + 重叠Z);
                if (!已命中 || 分值 < 最佳分值) {
                    已命中 = true;
                    最佳分值 = 分值;
                }
            }
        }

        if (输出分值) {
            *输出分值 = 最佳分值;
        }
        return 已命中;
    }

    // 功能：从候选集中选择当前使用对象或方法。
    const 结构_外设观察像素簇摘要* D455_选择目标约束命中簇(
        const std::vector<结构_外设观察像素簇摘要>& 簇集合,
        const 结构_目标观察约束特征组& 约束,
        std::int64_t* 输出分值) noexcept
    {
        const 结构_外设观察像素簇摘要* 最佳簇 = nullptr;
        std::int64_t 最佳分值 = 0;
        for (const auto& 簇 : 簇集合) {
            std::int64_t 分值 = 0;
            if (!D455_观察簇命中目标约束(簇, 约束, &分值)) {
                continue;
            }
            if (!最佳簇 || 分值 < 最佳分值) {
                最佳簇 = &簇;
                最佳分值 = 分值;
            }
        }
        if (输出分值) {
            *输出分值 = 最佳分值;
        }
        return 最佳簇;
    }

    // 功能：等待线程、任务、外设或条件变化。
    bool D455_扫描变化等待项前置满足(const 结构_外设观察等待项& 等待项) noexcept
    {
        if (等待项.目标观察约束ID != 0) {
            const auto 约束 = 读取目标观察约束_按等待项(等待项);
            if (!约束.has_value()) {
                return false;
            }
            const auto 判定 = 判断目标观察约束可用性(*约束, D455_当前时间毫秒(), &等待项);
            return 判定.可强匹配 || 判定.可降级匹配;
        }
        return 等待项.允许降级匹配 != 0
            && (!等待项.目标存在ID.empty() || 等待项.目标观察簇ID >= 0);
    }

    // 功能：等待线程、任务、外设或条件变化。
    bool D455_目标跟踪等待项前置满足(const 结构_外设观察等待项& 等待项) noexcept
    {
        if (等待项.目标观察约束ID != 0) {
            const auto 约束 = 读取目标观察约束_按等待项(等待项);
            if (!约束.has_value()) {
                return false;
            }
            const auto 判定 = 判断目标观察约束可用性(*约束, D455_当前时间毫秒(), &等待项);
            return 判定.可强匹配 || 判定.可降级匹配;
        }
        return 等待项.允许降级匹配 != 0
            && (!等待项.目标存在ID.empty() || 等待项.目标观察簇ID >= 0);
    }

    // 功能：根据当前输入生成目标数据、场景、动态或回执。
    结构_外设观察报告队列项 D455_从逐簇识别报告生成扫描变化报告_带上下文(
        const 结构_外设观察报告队列项& 当前逐簇识别报告,
        const std::optional<结构_外设观察报告队列项>& 基准逐簇识别报告,
        std::uint64_t 对应命令ID,
        std::uint64_t 匹配等待项ID,
        const 结构_外设观察等待项& 等待项,
        const std::optional<结构_目标观察约束特征组>& 目标约束,
        const 结构_目标观察约束可用性判定& 目标约束判定)
    {
        结构_外设观察报告队列项 报告{};
        报告.对应命令ID = 对应命令ID;
        报告.匹配等待项ID = 匹配等待项ID;
        报告.来源外设ID = D455_外设ID;
        报告.观察运行模式 = 枚举_外设观察运行模式::已识别场景扫描变化;
        报告.报告类型 = 枚举_外设观察报告类型::扫描变化报告;
        报告.配置摘要 = "D455默认采集配置;外设线程内部工程代码由L1稳定子集材料生成扫描变化报告";
        D455_复制观察报告帧摘要(当前逐簇识别报告, &报告);
        报告.报告生成方法ID = "D455_从L1稳定子集报告生成扫描变化报告";
        报告.报告生成方法版本 = "20260612-P5-L1稳定子集扫描";
        const auto 目标约束使用状态 = 目标约束.has_value()
            ? D455_目标约束使用状态_由判定(目标约束判定)
            : (等待项.允许降级匹配 != 0 ? 2 : 6);
        D455_写入报告目标观察约束字段(
            &报告,
            等待项,
            目标约束,
            目标约束使用状态);
        报告.观察像素簇集合 = 当前逐簇识别报告.观察像素簇集合;
        报告.高风险未知区域数量 =
            当前逐簇识别报告.低质量区域数量 + 当前逐簇识别报告.未归簇区域数量;

        if (目标约束.has_value()) {
            std::int64_t 约束命中分值 = 0;
            const auto* 命中簇 = D455_选择目标约束命中簇(
                当前逐簇识别报告.观察像素簇集合,
                *目标约束,
                &约束命中分值);
            if (!命中簇) {
                报告.采集成功 = false;
                报告.观察像素簇集合.clear();
                报告.失败原因 = "扫描变化等待项目标观察约束未命中当前观察簇";
                报告.差异摘要 = "约束采集失败;不生成扫描变化动态候选";
                return 报告;
            }
            报告.观察像素簇集合.assign(1, *命中簇);
            报告.深度有效率 = 命中簇->深度有效率 > 0 ? 命中簇->深度有效率 : 报告.深度有效率;
            报告.空间坐标有效率 = 命中簇->空间坐标有效率 > 0 ? 命中簇->空间坐标有效率 : 报告.空间坐标有效率;
            D455_写入目标特征观察值(&报告, 等待项, 目标约束, *命中簇);
            std::ostringstream 配置;
            配置 << 报告.配置摘要
                << ";目标观察约束使用="
                << (目标约束判定.可强匹配 ? "强匹配" : "降级匹配")
                << ";约束命中分值=" << 约束命中分值;
            报告.配置摘要 = 配置.str();
        } else {
            报告.配置摘要 += ";未绑定目标观察约束,仅按等待项目标种子降级生成扫描材料";
        }

        if (!基准逐簇识别报告.has_value()) {
            报告.扫描变化基准状态 = 枚举_扫描变化基准状态::缺少逐簇识别基准;
            报告.差异摘要 =
                "缺少上一帧L1稳定子集基准;当前扫描变化报告仅建立首帧基准;首帧只形成发现存在或发现特征候选";
            return 报告;
        }

        const auto& 基准 = *基准逐簇识别报告;
        报告.扫描变化基准状态 = 枚举_扫描变化基准状态::有可比历史;
        for (const auto& 当前簇 : 报告.观察像素簇集合) {
            const auto* 基准簇 = D455_按跨帧簇ID查找观察像素簇(
                基准.观察像素簇集合,
                当前簇.外设跨帧簇ID);
            if (!基准簇) {
                ++报告.新增观察像素簇数量;
            } else if (D455_观察像素簇存在明显变化(当前簇, *基准簇)) {
                ++报告.变化观察像素簇数量;
            }
        }
        if (!目标约束.has_value()) {
            for (const auto& 基准簇 : 基准.观察像素簇集合) {
                if (!D455_按跨帧簇ID查找观察像素簇(
                        当前逐簇识别报告.观察像素簇集合,
                        基准簇.外设跨帧簇ID)) {
                    ++报告.消失观察像素簇数量;
                }
            }
        }

        std::ostringstream 摘要;
        摘要 << "新增=" << 报告.新增观察像素簇数量
            << ";消失=" << 报告.消失观察像素簇数量
            << ";变化=" << 报告.变化观察像素簇数量
            << ";高风险未知=" << 报告.高风险未知区域数量;
        报告.差异摘要 = 摘要.str();
        return 报告;
    }

    // 功能：根据当前输入生成目标数据、场景、动态或回执。
    结构_外设观察报告队列项 D455_从逐簇识别报告生成扫描变化报告(
        const 结构_外设观察报告队列项& 当前逐簇识别报告,
        const std::optional<结构_外设观察报告队列项>& 基准逐簇识别报告,
        const 结构_外设观察等待项& 等待项)
    {
        const auto 目标约束 = 读取目标观察约束_按等待项(等待项);
        const auto 目标约束判定 = 目标约束.has_value()
            ? 判断目标观察约束可用性(*目标约束, D455_当前时间毫秒(), &等待项)
            : 结构_目标观察约束可用性判定{};
        return D455_从逐簇识别报告生成扫描变化报告_带上下文(
            当前逐簇识别报告,
            基准逐簇识别报告,
            等待项.等待项ID,
            等待项.等待项ID,
            等待项,
            目标约束,
            目标约束判定);
    }

    // 功能：记录日志、动态、证据或运行痕迹。
    void D455_记录跟踪失败到缓存(
        const 结构_外设观察等待项& 等待项,
        结构_外设观察报告队列项* 报告)
    {
        if (!报告) {
            return;
        }

        std::lock_guard<std::mutex> 锁(D455_跟踪稳定缓存锁());
        auto& 缓存项 = D455_确保跟踪稳定缓存项_已加锁(等待项);
        缓存项.连续成功次数 = 0;
        ++缓存项.失败次数;
        报告->连续成功次数 = 0;
        报告->失败次数 = 缓存项.失败次数;
        报告->稳定特征样本数量 = 0;
        const bool 已超过丢失宽限 = 缓存项.失败次数 > D455_丢失宽限帧数;
        D455_写入报告Tracker轨迹状态(
            报告,
            已超过丢失宽限
                ? 枚举_外设Tracker轨迹状态::已丢失
                : 枚举_外设Tracker轨迹状态::短时丢失,
            0);
    }

    // 功能：记录日志、动态、证据或运行痕迹。
    void D455_记录跟踪成功到缓存(
        const 结构_外设观察等待项& 等待项,
        const 结构_外设观察像素簇摘要& 命中簇,
        结构_外设观察报告队列项* 报告)
    {
        if (!报告) {
            return;
        }

        std::lock_guard<std::mutex> 锁(D455_跟踪稳定缓存锁());
        auto& 缓存项 = D455_确保跟踪稳定缓存项_已加锁(等待项);
        const bool 有上一帧 = 缓存项.有最近中心;
        const auto 坐标离散度 = 有上一帧
            ? (std::max<std::int64_t>)(
                D455_I64绝对差(缓存项.最近中心X, 命中簇.中心X),
                (std::max<std::int64_t>)(
                    D455_I64绝对差(缓存项.最近中心Y, 命中簇.中心Y),
                    D455_I64绝对差(缓存项.最近中心Z, 命中簇.中心Z)))
            : 0;

        缓存项.有最近中心 = true;
        缓存项.最近中心X = 命中簇.中心X;
        缓存项.最近中心Y = 命中簇.中心Y;
        缓存项.最近中心Z = 命中簇.中心Z;
        ++缓存项.连续成功次数;

        报告->连续成功次数 = 缓存项.连续成功次数;
        报告->失败次数 = 缓存项.失败次数;
        报告->空间坐标复现离散度 = 坐标离散度;
        报告->距离复现离散度 = 坐标离散度;
        报告->稳定特征样本数量 = 缓存项.连续成功次数;
        报告->跟踪状态值 =
            有上一帧
                && 缓存项.连续成功次数 >= 2
                && 坐标离散度 <= 150
                && 命中簇.深度有效率 >= 5000
                && 命中簇.空间坐标有效率 >= 5000
            ? 1
            : 0;
        if (报告->跟踪状态值 == 0) {
            报告->失败原因 = 有上一帧
                ? "目标簇已重见，但复现离散度或质量尚未达标"
                : "目标簇已重见，但连续样本不足以判定稳定";
            D455_写入报告Tracker轨迹状态(
                报告,
                枚举_外设Tracker轨迹状态::候选,
                缓存项.连续成功次数);
        } else {
            D455_写入报告Tracker轨迹状态(
                报告,
                枚举_外设Tracker轨迹状态::稳定,
                缓存项.连续成功次数);
        }
    }

    // 功能：根据当前输入生成目标数据、场景、动态或回执。
    结构_外设观察报告队列项 D455_从逐簇识别报告生成跟踪报告(
        const 结构_外设观察报告队列项& 逐簇识别报告,
        const 结构_外设观察等待项& 等待项)
    {
        结构_外设观察报告队列项 报告{};
        报告.对应命令ID = 等待项.等待项ID;
        报告.匹配等待项ID = 等待项.等待项ID;
        报告.来源外设ID = D455_外设ID;
        报告.观察运行模式 = 枚举_外设观察运行模式::目标跟踪观察;
        报告.报告类型 = 枚举_外设观察报告类型::跟踪报告;
        报告.配置摘要 = "D455默认采集配置;外设线程内部工程代码由L1稳定子集材料生成跟踪报告草案";
        D455_复制观察报告帧摘要(逐簇识别报告, &报告);
        报告.报告生成方法ID = "D455_从L1稳定子集报告生成跟踪报告";
        报告.报告生成方法版本 = "20260612-P5-L1稳定子集跟踪";
        报告.跟踪ID = 等待项.等待项ID;

        const auto 目标约束 = 读取目标观察约束_按等待项(等待项);
        const auto 目标约束判定 = 目标约束.has_value()
            ? 判断目标观察约束可用性(*目标约束, D455_当前时间毫秒(), &等待项)
            : 结构_目标观察约束可用性判定{};
        const auto 目标约束使用状态 = 目标约束.has_value()
            ? D455_目标约束使用状态_由判定(目标约束判定)
            : (等待项.允许降级匹配 != 0 ? 2 : 6);
        D455_写入报告目标观察约束字段(
            &报告,
            等待项,
            目标约束,
            目标约束使用状态);

        if (目标约束.has_value()) {
            std::int64_t 约束命中分值 = 0;
            const auto* 命中簇 = D455_选择目标约束命中簇(
                逐簇识别报告.观察像素簇集合,
                *目标约束,
                &约束命中分值);
            if (!命中簇) {
                报告.采集成功 = false;
                报告.跟踪状态值 = 0;
                报告.丢失状态值 = 1;
                报告.失败次数 = 1;
                报告.重捕获候选数量 =
                    static_cast<std::int64_t>(逐簇识别报告.观察像素簇集合.size());
                报告.失败原因 = "跟踪等待项目标观察约束未命中当前观察簇";
                报告.配置摘要 += ";目标观察约束使用失败,输出待重捕获材料";
                D455_记录跟踪失败到缓存(等待项, &报告);
                return 报告;
            }

            报告.采集成功 = true;
            报告.丢失状态值 = 0;
            报告.最近观测年龄毫秒 = 0;
            报告.观察像素簇集合.push_back(*命中簇);
            报告.深度有效率 = 命中簇->深度有效率 > 0 ? 命中簇->深度有效率 : 报告.深度有效率;
            报告.空间坐标有效率 = 命中簇->空间坐标有效率 > 0 ? 命中簇->空间坐标有效率 : 报告.空间坐标有效率;
            D455_写入目标特征观察值(&报告, 等待项, 目标约束, *命中簇);
            std::ostringstream 配置;
            配置 << 报告.配置摘要
                << ";目标观察约束使用="
                << (目标约束判定.可强匹配 ? "强匹配" : "降级匹配")
                << ";约束命中分值=" << 约束命中分值;
            报告.配置摘要 = 配置.str();
            D455_记录跟踪成功到缓存(等待项, *命中簇, &报告);
            return 报告;
        }

        const std::int64_t 种子簇ID = 等待项.目标观察簇ID;
        if (种子簇ID < 0) {
            报告.采集成功 = false;
            报告.跟踪状态值 = 0;
            报告.丢失状态值 = 1;
            报告.失败次数 = 1;
            报告.重捕获候选数量 =
                static_cast<std::int64_t>(逐簇识别报告.观察像素簇集合.size());
            报告.失败原因 = "跟踪等待项缺少可解析观察像素簇ID种子";
            报告.配置摘要 += ";未绑定目标观察约束,且旧目标种子不可解析";
            D455_记录跟踪失败到缓存(等待项, &报告);
            return 报告;
        }

        const 结构_外设观察像素簇摘要* 命中簇 = nullptr;
        for (const auto& 簇 : 逐簇识别报告.观察像素簇集合) {
            if (簇.外设内部簇ID == 种子簇ID
                || 簇.来源空间候选ID == 种子簇ID) {
                命中簇 = &簇;
                break;
            }
        }

        if (!命中簇) {
            报告.采集成功 = false;
            报告.跟踪状态值 = 0;
            报告.丢失状态值 = 1;
            报告.失败次数 = 1;
            报告.重捕获候选数量 =
                static_cast<std::int64_t>(逐簇识别报告.观察像素簇集合.size());
            报告.失败原因 = "当前逐簇识别材料未匹配到跟踪种子对应观察像素簇";
            报告.配置摘要 += ";未绑定目标观察约束,旧目标种子降级匹配失败";
            D455_记录跟踪失败到缓存(等待项, &报告);
            return 报告;
        }

        报告.采集成功 = true;
        报告.丢失状态值 = 0;
        报告.最近观测年龄毫秒 = 0;
        报告.观察像素簇集合.push_back(*命中簇);
        报告.配置摘要 += ";未绑定目标观察约束,按旧目标种子降级跟踪";
        D455_写入目标特征观察值(&报告, 等待项, std::nullopt, *命中簇);
        D455_记录跟踪成功到缓存(等待项, *命中簇, &报告);
        return 报告;
    }

    // 功能：按函数名执行对应处理。
    bool D455_基础采样样本对稳定(
        const 结构_D455深度相机观察样本& 左,
        const 结构_D455深度相机观察样本& 右)
    {
        if (!左.基础特征可比 || !右.基础特征可比) {
            return false;
        }
        if (左.帧宽度 != 右.帧宽度 || 左.帧高度 != 右.帧高度) {
            return false;
        }
        if (左.预期像素数量 != 右.预期像素数量
            || 左.像素特征数量 != 右.像素特征数量) {
            return false;
        }
        if (D455_I64绝对差(左.深度有效率, 右.深度有效率) > 500) {
            return false;
        }
        if (D455_I64绝对差(左.空间坐标有效率, 右.空间坐标有效率) > 500) {
            return false;
        }
        if (D455_I64绝对差(左.帧质量评分, 右.帧质量评分) > 1000) {
            return false;
        }

        return true;
    }

    // 功能：按函数名执行对应处理。
    bool D455_观察候选样本对稳定(
        const 结构_D455深度相机观察样本& 左,
        const 结构_D455深度相机观察样本& 右)
    {
        if (!D455_基础采样样本对稳定(左, 右)) {
            return false;
        }
        if (左.跨帧采集可用 && 右.跨帧采集可用) {
            if (右.跨帧稳定簇数量 > 0) {
                return true;
            }
            if (左.主候选跨帧簇ID >= 0
                && 左.主候选跨帧簇ID == 右.主候选跨帧簇ID
                && 右.主候选跨帧连续命中次数 >= 2) {
                return true;
            }
            return false;
        }

        const auto 候选容差 = D455_计数容差(左.空间候选数量);
        if (D455_I64绝对差(左.空间候选数量, 右.空间候选数量) > 候选容差) {
            return false;
        }
        if ((左.空间候选数量 > 0) != (右.空间候选数量 > 0)) {
            return false;
        }
        if (左.空间候选数量 > 0 && 右.空间候选数量 > 0) {
            if (D455_I64绝对差(左.主候选像素数量, 右.主候选像素数量)
                > D455_计数容差(左.主候选像素数量)) {
                return false;
            }
            if (D455_I64绝对差(左.中心X, 右.中心X) > 150
                || D455_I64绝对差(左.中心Y, 右.中心Y) > 150
                || D455_I64绝对差(左.中心Z, 右.中心Z) > 150) {
                return false;
            }
            if (D455_I64绝对差(左.范围稳定性评分, 右.范围稳定性评分) > 1000) {
                return false;
            }
        }

        return true;
    }

    // 功能：评估状态、风险、质量、权重或完成度。
    结构_D455深度相机线程结果 D455_评估稳定性(
        const std::vector<结构_D455深度相机观察样本>& 样本集合,
        枚举_D455深度相机线程生命周期状态 生命周期)
    {
        结构_D455深度相机线程结果 结果{};
        结果.生命周期 = 生命周期;
        结果.已启动 = 生命周期 != 枚举_D455深度相机线程生命周期状态::未启动;
        结果.已完成 = 生命周期 == 枚举_D455深度相机线程生命周期状态::已停止
            || 生命周期 == 枚举_D455深度相机线程生命周期状态::故障;
        结果.样本 = 样本集合;
        结果.样本数量 = static_cast<std::uint64_t>(样本集合.size());

        for (const auto& 样本 : 样本集合) {
            if (样本.基础特征可比) {
                ++结果.基础可比样本数量;
            }
        }
        for (std::size_t i = 1; i < 样本集合.size(); ++i) {
            if (D455_基础采样样本对稳定(样本集合[i - 1], 样本集合[i])) {
                ++结果.基础采样稳定连接数量;
            }

            if (D455_观察候选样本对稳定(样本集合[i - 1], 样本集合[i])) {
                ++结果.观察候选稳定连接数量;
            }
        }
        结果.稳定连接数量 = 结果.基础采样稳定连接数量;
        if (样本集合.size() >= 2) {
            const bool 最新基础窗口稳定 = D455_基础采样样本对稳定(
                样本集合[样本集合.size() - 2],
                样本集合[样本集合.size() - 1]);
            const bool 最新候选窗口稳定 = D455_观察候选样本对稳定(
                样本集合[样本集合.size() - 2],
                样本集合[样本集合.size() - 1]);
            结果.基础采样稳定 = 结果.基础可比样本数量 >= 2
                && 结果.基础采样稳定连接数量 >= 1
                && 最新基础窗口稳定;
            结果.观察候选稳定 = 结果.基础可比样本数量 >= 2
                && 结果.观察候选稳定连接数量 >= 1
                && 最新候选窗口稳定;
            结果.稳定 = 结果.基础采样稳定 && 结果.观察候选稳定;
        }
        return 结果;
    }

    // 功能：把处理结果写入指定对象、场景或日志。
    void D455_写入状态结果(
        const std::shared_ptr<结构_D455线程共享状态>& 状态,
        枚举_D455深度相机线程生命周期状态 生命周期)
    {
        std::lock_guard<std::mutex> 锁(状态->互斥);
        状态->生命周期 = 生命周期;
        状态->结果 = D455_评估稳定性(状态->样本, 生命周期);
    }

    // 功能：设置对象字段、状态或运行参数。
    void D455_设置结束(
        const std::shared_ptr<结构_D455线程共享状态>& 状态,
        枚举_D455深度相机线程生命周期状态 生命周期)
    {
        {
            std::lock_guard<std::mutex> 锁(状态->互斥);
            状态->生命周期 = 生命周期;
            状态->已结束 = true;
            状态->结果 = D455_评估稳定性(状态->样本, 生命周期);
        }
        状态->条件.notify_all();
    }

    // 功能：从指定来源读取数据或状态。
    结构_D455深度相机线程结果 D455_读取结果(
        const std::shared_ptr<结构_D455线程共享状态>& 状态)
    {
        std::lock_guard<std::mutex> 锁(状态->互斥);
        return 状态->结果;
    }

    constexpr std::uint64_t D455_高频日志间隔帧 = 10;

    bool D455_应输出高频日志(
        std::uint64_t 序号,
        bool 立即输出 = false) noexcept
    {
        if (立即输出) {
            return true;
        }
        return 序号 <= 3
            || (D455_高频日志间隔帧 > 0 && 序号 % D455_高频日志间隔帧 == 0);
    }

    // 功能：按函数名执行对应处理。
    std::string D455_截断日志文本(const std::string& 文本)
    {
        constexpr std::size_t 最大长度 = 64;
        if (文本.empty()) {
            return "空";
        }
        if (文本.size() <= 最大长度) {
            return 文本;
        }
        return 文本.substr(0, 最大长度) + "...";
    }

    // 功能：按函数名执行对应处理。
    std::string D455_构造逐簇稳定性诊断摘要(const 结构_外设观察报告队列项& 报告项)
    {
        std::ostringstream 输出;
        输出 << "稳定性诊断"
            << " | 原始簇=" << 报告项.观察像素簇集合.size()
            << " | 跨帧匹配=" << 报告项.跨帧匹配观察像素簇数量
            << " | 跨帧新建=" << 报告项.跨帧新建观察像素簇数量
            << " | 跨帧稳定=" << 报告项.跨帧稳定观察像素簇数量
            << " | 跨帧丢失=" << 报告项.跨帧丢失观察像素簇数量;
        const auto 主簇 = std::max_element(
            报告项.观察像素簇集合.begin(),
            报告项.观察像素簇集合.end(),
            [](const auto& 左, const auto& 右) noexcept {
                return 左.像素数量 < 右.像素数量;
            });
        if (主簇 == 报告项.观察像素簇集合.end()) {
            输出 << " | 主簇=无";
            return 输出.str();
        }

        输出 << " | 主簇跨帧ID=" << 主簇->外设跨帧簇ID
            << " | 主簇连续命中=" << 主簇->跨帧连续命中次数
            << " | 主簇稳定命中=" << 主簇->跨帧连续稳定命中次数
            << " | 主簇连续发布=" << 主簇->跨帧连续发布次数
            << " | 主簇稳定状态=" << 主簇->跨帧轨迹稳定状态
            << " | 主簇待发布=" << 主簇->跨帧轨迹待发布状态
            << " | 主簇复现离散度=" << 主簇->跨帧复现离散度
            << " | 主簇中心=(" << 主簇->中心X << ',' << 主簇->中心Y << ',' << 主簇->中心Z << ')'
            << " | 主簇平滑中心=(" << 主簇->平滑中心X << ',' << 主簇->平滑中心Y << ',' << 主簇->平滑中心Z << ')'
            << " | 主簇投影范围=(" << 主簇->投影最小X << ',' << 主簇->投影最小Y
            << ")-(" << 主簇->投影最大X << ',' << 主簇->投影最大Y << ')'
            << " | 主簇平滑投影范围=(" << 主簇->平滑投影最小X << ',' << 主簇->平滑投影最小Y
            << ")-(" << 主簇->平滑投影最大X << ',' << 主簇->平滑投影最大Y << ')'
            << " | 主簇像素=" << 主簇->像素数量;
        return 输出.str();
    }

    std::string D455_构造报告入队短摘要(
        const 结构_外设观察报告队列项& 报告项,
        std::uint64_t 抑制条数 = 0)
    {
        std::ostringstream 输出;
        输出 << "报告ID=" << 报告项.报告ID
            << " | 类型=" << 外设观察报告类型文本(报告项.报告类型)
            << " | 模式=" << 外设观察运行模式文本(报告项.观察运行模式)
            << " | 报告层级=" << 报告项.报告层级
            << " | 成功=" << (报告项.采集成功 ? 1 : 0)
            << " | 帧=" << 报告项.帧宽度 << 'x' << 报告项.帧高度
            << " | 深度帧号=" << 报告项.深度帧号
            << " | 彩色帧号=" << 报告项.彩色帧号
            << " | 像素簇=" << 报告项.观察像素簇集合.size()
            << " | 深度有效率=" << 报告项.深度有效率
            << " | 空间坐标有效率=" << 报告项.空间坐标有效率
            << " | 质量=" << 报告项.帧质量评分
            << " | 坐标系一致性状态=" << 外设坐标系一致性状态文本(报告项.坐标系一致性状态)
            << " | 稳定锚点数量=" << 报告项.稳定锚点数量
            << " | 稳定锚点密度=" << 报告项.稳定锚点密度
            << " | 稳定锚点覆盖率=" << 报告项.稳定锚点覆盖率
            << " | 可承接能力等级=" << 外设材料能力等级文本(报告项.可承接能力等级)
            << " | 平面轮廓稳定状态=" << 报告项.平面轮廓稳定状态
            << " | 深度锚定状态=" << 报告项.深度锚定状态
            << " | 空间可用状态=" << 报告项.空间可用状态
            << " | 原始帧句柄=" << (报告项.原始观察帧句柄.empty() ? 0 : 1)
            << " | 深度帧句柄=" << (报告项.深度帧句柄.empty() ? 0 : 1)
            << " | 彩色帧句柄=" << (报告项.彩色帧句柄.empty() ? 0 : 1)
            << " | 对齐帧句柄=" << (报告项.对齐帧句柄.empty() ? 0 : 1)
            << " | 空间候选队列引用=" << (报告项.空间候选队列引用.empty() ? 0 : 1);
        if (报告项.来源原始报告ID != 0 || 报告项.来源外设帧ID != 0) {
            输出 << " | 来源原始报告ID=" << 报告项.来源原始报告ID
                << " | 来源外设帧ID=" << 报告项.来源外设帧ID;
        }
        if (报告项.匹配等待项ID != 0) {
            输出 << " | 匹配等待项ID=" << 报告项.匹配等待项ID;
        }
        if (报告项.跨帧采集状态 > 0) {
            输出 << " | " << D455_构造逐簇稳定性诊断摘要(报告项);
        }
        if (报告项.目标观察约束ID != 0) {
            输出 << " | 目标观察约束ID=" << 报告项.目标观察约束ID
                << " | 目标约束使用状态=" << 报告项.目标约束使用状态;
        }
        输出 << " | 本帧处理模式=" << 外设分割处理模式文本(报告项.本帧处理模式)
            << " | 本帧处理优先级=" << 报告项.本帧处理优先级
            << " | 本帧处理掩码="
            << (报告项.本帧处理掩码句柄.empty() ? "空" : D455_截断日志文本(报告项.本帧处理掩码句柄))
            << " | 轨迹状态=" << 外设Tracker轨迹状态文本(报告项.轨迹状态)
            << " | 轨迹连续帧数=" << 报告项.轨迹状态连续帧数;
        if (抑制条数 > 0) {
            输出 << " | 抑制条数=" << 抑制条数;
        }
        if (!报告项.失败原因.empty()) {
            输出 << " | 失败原因=" << D455_截断日志文本(报告项.失败原因);
        }
        return 输出.str();
    }

    std::string D455_构造等待项短摘要(
        const 结构_外设观察等待项& 等待项,
        std::uint64_t 抑制条数 = 0)
    {
        std::ostringstream 输出;
        输出 << "等待项ID=" << 等待项.等待项ID
            << " | 模式=" << 外设观察运行模式文本(等待项.观察运行模式)
            << " | 期望报告=" << 外设观察报告类型文本(等待项.期望报告类型)
            << " | 来源需求=" << D455_截断日志文本(等待项.来源需求ID)
            << " | 目标外设=" << D455_截断日志文本(等待项.目标外设)
            << " | 目标约束ID=" << 等待项.目标观察约束ID
            << " | 目标存在=" << D455_截断日志文本(等待项.目标存在ID)
            << " | 目标特征=" << D455_截断日志文本(等待项.目标特征类型ID)
            << " | 目标观察簇ID=" << 等待项.目标观察簇ID
            << " | 本帧处理模式=" << 外设分割处理模式文本(等待项.本帧处理模式)
            << " | 本帧处理优先级=" << 等待项.本帧处理优先级
            << " | 本帧处理掩码="
            << (等待项.本帧处理掩码句柄.empty() ? "空" : D455_截断日志文本(等待项.本帧处理掩码句柄))
            << " | 允许降级=" << 等待项.允许降级匹配;
        if (抑制条数 > 0) {
            输出 << " | 抑制条数=" << 抑制条数;
        }
        return 输出.str();
    }

    std::string D455_构造采样短摘要(
        const 结构_D455深度相机观察样本& 样本,
        std::uint64_t 抑制条数 = 0)
    {
        std::ostringstream 输出;
        输出 << "序号=" << 样本.序号
            << " | 成功=" << (样本.采集成功 ? 1 : 0)
            << " | 相机已打开=" << (样本.相机已打开 ? 1 : 0)
            << " | 帧=" << 样本.帧宽度 << 'x' << 样本.帧高度
            << " | 深度帧号=" << 样本.深度帧号
            << " | 彩色帧号=" << 样本.彩色帧号
            << " | 像素特征=" << 样本.像素特征数量
            << " | 深度有效率=" << 样本.深度有效率
            << " | 空间坐标有效率=" << 样本.空间坐标有效率
            << " | 空间候选=" << 样本.空间候选数量
            << " | 主候选跨帧簇ID=" << 样本.主候选跨帧簇ID
            << " | 跨帧匹配簇=" << 样本.跨帧匹配簇数量
            << " | 跨帧新建簇=" << 样本.跨帧新建簇数量
            << " | 跨帧稳定簇=" << 样本.跨帧稳定簇数量
            << " | 跨帧丢失簇=" << 样本.跨帧丢失簇数量
            << " | 主稳定命中=" << 样本.主候选跨帧连续稳定命中次数
            << " | 主稳定状态=" << 样本.主候选跨帧轨迹稳定状态
            << " | 主复现离散度=" << 样本.主候选跨帧复现离散度;
        if (抑制条数 > 0) {
            输出 << " | 抑制条数=" << 抑制条数;
        }
        if (!样本.消息.empty()) {
            输出 << " | 消息=" << D455_截断日志文本(样本.消息);
        }
        return 输出.str();
    }

    struct 结构_D455等待项分组 {
        std::vector<结构_外设观察等待项> 全部等待项{};
        std::vector<结构_外设观察等待项> 扫描变化等待项集合{};
        std::vector<结构_外设观察等待项> 跟踪等待项集合{};
    };

    struct 结构_D455本帧报告组 {
        std::optional<结构_外设观察报告队列项> 逐簇识别报告{};
        结构_外设观察报告队列项 稳定子集报告{};
    };

    // 功能：从指定来源读取数据或状态。
    结构_D455等待项分组 D455_读取并分组等待项()
    {
        结构_D455等待项分组 分组{};
        分组.全部等待项 = 读取外设观察等待项集合(
            D455_外设ID,
            枚举_外设观察运行模式::未指定);
        分组.扫描变化等待项集合.reserve(分组.全部等待项.size());
        分组.跟踪等待项集合.reserve(分组.全部等待项.size());
        for (const auto& 等待项 : 分组.全部等待项) {
            if (等待项.观察运行模式 == 枚举_外设观察运行模式::已识别场景扫描变化) {
                分组.扫描变化等待项集合.push_back(等待项);
            } else if (等待项.观察运行模式 == 枚举_外设观察运行模式::目标跟踪观察) {
                分组.跟踪等待项集合.push_back(等待项);
            }
        }
        return 分组;
    }

    // 功能：按函数名执行对应处理。
    结构_D455本帧报告组 D455_发布本帧逐簇与稳定子集报告(
        const 双目相机本能适配器::调用结果& 采集结果,
        const 结构_D455等待项分组& 等待项分组,
        std::uint64_t 序号,
        std::uint64_t& 逐簇识别报告入队日志抑制条数,
        std::uint64_t& 稳定子集报告跳过日志抑制条数)
    {
        结构_D455本帧报告组 报告组{};
        auto 逐簇识别报告 = D455_从调用结果生成逐簇识别报告(采集结果);
        D455_更新逐簇识别报告跨帧采集状态(&逐簇识别报告);

        const bool 有D455等待项 = !等待项分组.全部等待项.empty();
        const auto 报告ID = 提交外设观察报告(逐簇识别报告);
        逐簇识别报告.报告ID = 报告ID;
        const bool 材料页已提交 = 提交D455短期观察材料页(
            报告ID,
            采集结果,
            逐簇识别报告);
        if constexpr (D455_调试日志输出启用()) {
            if (D455_应输出高频日志(序号, !材料页已提交)) {
                项目运行日志(
                    "外设线程_D455深度相机/逐簇识别报告入队 | 日志模式=节流短摘要 | 生产口径=外设侧有数据即入队 | "
                    + D455_构造报告入队短摘要(
                        逐簇识别报告,
                        逐簇识别报告入队日志抑制条数)
                    + " | 短期观察材料页提交="
                    + std::to_string(材料页已提交 ? 1 : 0)
                    + " | 活跃等待项="
                    + std::to_string(有D455等待项 ? 1 : 0)
                    + " | D455等待项数="
                    + std::to_string(等待项分组.全部等待项.size()));
                逐簇识别报告入队日志抑制条数 = 0;
            } else {
                ++逐簇识别报告入队日志抑制条数;
            }
        }

        auto 稳定子集报告 = D455_从逐簇识别报告生成稳定观察子集报告(逐簇识别报告);
        if (!稳定子集报告.观察像素簇集合.empty()) {
            const auto 稳定子集报告ID = 提交外设观察报告(稳定子集报告);
            稳定子集报告.报告ID = 稳定子集报告ID;
            项目运行日志(
                "外设线程_D455深度相机/稳定子集报告入队 | 日志模式=短摘要 | 生产口径=L1稳定观察子集正式承接候选 | "
                + D455_构造报告入队短摘要(
                    稳定子集报告,
                    稳定子集报告跳过日志抑制条数)
                + " | 来源原始报告ID="
                + std::to_string(逐簇识别报告.报告ID)
                + " | 原始簇数量="
                + std::to_string(逐簇识别报告.观察像素簇集合.size())
                + " | 稳定子集簇数量="
                + std::to_string(稳定子集报告.观察像素簇集合.size()));
            稳定子集报告跳过日志抑制条数 = 0;
        } else {
            if constexpr (D455_调试日志输出启用()) {
                if (D455_应输出高频日志(序号)) {
                    项目运行日志(
                        "外设线程_D455深度相机/稳定子集报告跳过 | 原因=本帧无达到L1稳定门簇 | 日志模式=节流短摘要 | 来源原始报告ID="
                        + std::to_string(逐簇识别报告.报告ID)
                        + " | 原始簇数量="
                        + std::to_string(逐簇识别报告.观察像素簇集合.size())
                        + " | 跨帧稳定簇="
                        + std::to_string(逐簇识别报告.跨帧稳定观察像素簇数量)
                        + " | 抑制条数="
                        + std::to_string(稳定子集报告跳过日志抑制条数));
                    稳定子集报告跳过日志抑制条数 = 0;
                } else {
                    ++稳定子集报告跳过日志抑制条数;
                }
            }
        }

        报告组.逐簇识别报告 = std::move(逐簇识别报告);
        报告组.稳定子集报告 = std::move(稳定子集报告);
        return 报告组;
    }

    // 功能：执行扫描相关材料获取、比较或提交逻辑。
    void D455_发布扫描变化报告(
        const 结构_外设观察报告队列项& 逐簇识别报告,
        const 结构_外设观察报告队列项& 稳定子集报告,
        const std::optional<结构_外设观察报告队列项>& 上一稳定子集报告,
        const std::vector<结构_外设观察等待项>& 扫描变化等待项集合,
        std::uint64_t 序号,
        std::uint64_t& 扫描跳过日志抑制条数,
        std::uint64_t& 扫描样本卡日志抑制条数)
    {
        for (const auto& 等待项 : 扫描变化等待项集合) {
            if (!D455_扫描变化等待项前置满足(等待项)) {
                if constexpr (D455_调试日志输出启用()) {
                    if (D455_应输出高频日志(序号)) {
                        项目运行日志(
                            "外设线程_D455深度相机/扫描变化报告跳过 | 原因=缺少已识别场景基准或目标区域 | 日志模式=节流短摘要 | "
                            + D455_构造等待项短摘要(等待项, 扫描跳过日志抑制条数));
                        扫描跳过日志抑制条数 = 0;
                    } else {
                        ++扫描跳过日志抑制条数;
                    }
                }
                continue;
            }
            if (!D455_报告满足L1稳定子集口径(稳定子集报告)) {
                if constexpr (D455_调试日志输出启用()) {
                    if (D455_应输出高频日志(序号)) {
                        项目运行日志(
                            "外设线程_D455深度相机/扫描变化报告跳过 | 原因=本帧缺L1稳定子集材料 | 日志模式=节流短摘要 | "
                            + D455_构造等待项短摘要(等待项, 扫描跳过日志抑制条数)
                            + " | 原始报告ID="
                            + std::to_string(逐簇识别报告.报告ID)
                            + " | 原始簇数量="
                            + std::to_string(逐簇识别报告.观察像素簇集合.size())
                            + " | 稳定子集簇数量="
                            + std::to_string(稳定子集报告.观察像素簇集合.size()));
                        扫描跳过日志抑制条数 = 0;
                    } else {
                        ++扫描跳过日志抑制条数;
                    }
                }
                continue;
            }
            auto 扫描变化报告 = D455_从逐簇识别报告生成扫描变化报告(
                稳定子集报告,
                上一稳定子集报告,
                等待项);
            const auto 扫描变化报告ID = 提交外设观察报告(扫描变化报告);
            扫描变化报告.报告ID = 扫描变化报告ID;
            项目运行日志(
                "外设线程_D455深度相机/扫描变化报告入队 | 日志模式=短摘要 | "
                + D455_构造报告入队短摘要(扫描变化报告)
                + " | 等待项ID="
                + std::to_string(等待项.等待项ID));
            if constexpr (D455_调试日志输出启用()) {
                if (D455_应输出高频日志(序号)) {
                    项目运行日志(
                        "外设线程_D455深度相机/扫描变化样本卡 | "
                        + 构造D455扫描变化样本卡摘要(扫描变化报告)
                        + " | 等待项ID="
                        + std::to_string(等待项.等待项ID)
                        + " | 抑制条数="
                        + std::to_string(扫描样本卡日志抑制条数));
                    扫描样本卡日志抑制条数 = 0;
                } else {
                    ++扫描样本卡日志抑制条数;
                }
            }
        }
    }

    // 功能：执行跟踪相关定位、匹配或结果输出逻辑。
    void D455_发布目标跟踪报告(
        const 结构_外设观察报告队列项& 逐簇识别报告,
        const 结构_外设观察报告队列项& 稳定子集报告,
        const std::vector<结构_外设观察等待项>& 跟踪等待项集合,
        std::uint64_t 序号,
        std::uint64_t& 跟踪跳过日志抑制条数)
    {
        bool 本帧已生成主动跟踪报告 = false;
        for (const auto& 等待项 : 跟踪等待项集合) {
            if (!D455_目标跟踪等待项前置满足(等待项)) {
                if constexpr (D455_调试日志输出启用()) {
                    if (D455_应输出高频日志(序号)) {
                        项目运行日志(
                            "外设线程_D455深度相机/跟踪报告跳过 | 原因=缺少目标种子 | 日志模式=节流短摘要 | "
                            + D455_构造等待项短摘要(等待项, 跟踪跳过日志抑制条数));
                        跟踪跳过日志抑制条数 = 0;
                    } else {
                        ++跟踪跳过日志抑制条数;
                    }
                }
                continue;
            }
            if (本帧已生成主动跟踪报告) {
                if constexpr (D455_调试日志输出启用()) {
                    if (D455_应输出高频日志(序号)) {
                        项目运行日志(
                            "外设线程_D455深度相机/跟踪报告跳过 | 原因=本帧已有主动目标跟踪报告 | 日志模式=节流短摘要 | "
                            + D455_构造等待项短摘要(等待项, 跟踪跳过日志抑制条数));
                        跟踪跳过日志抑制条数 = 0;
                    } else {
                        ++跟踪跳过日志抑制条数;
                    }
                }
                continue;
            }
            if (!D455_报告满足L1稳定子集口径(稳定子集报告)) {
                if constexpr (D455_调试日志输出启用()) {
                    if (D455_应输出高频日志(序号)) {
                        项目运行日志(
                            "外设线程_D455深度相机/跟踪报告跳过 | 原因=本帧缺L1稳定子集材料 | 日志模式=节流短摘要 | "
                            + D455_构造等待项短摘要(等待项, 跟踪跳过日志抑制条数)
                            + " | 原始报告ID="
                            + std::to_string(逐簇识别报告.报告ID)
                            + " | 原始簇数量="
                            + std::to_string(逐簇识别报告.观察像素簇集合.size())
                            + " | 稳定子集簇数量="
                            + std::to_string(稳定子集报告.观察像素簇集合.size()));
                        跟踪跳过日志抑制条数 = 0;
                    } else {
                        ++跟踪跳过日志抑制条数;
                    }
                }
                continue;
            }
            auto 跟踪报告 = D455_从逐簇识别报告生成跟踪报告(稳定子集报告, 等待项);
            const auto 跟踪报告ID = 提交外设观察报告(跟踪报告);
            跟踪报告.报告ID = 跟踪报告ID;
            本帧已生成主动跟踪报告 = true;
            项目运行日志(
                "外设线程_D455深度相机/跟踪报告入队 | 日志模式=短摘要 | "
                + D455_构造报告入队短摘要(跟踪报告)
                + " | 等待项ID="
                + std::to_string(等待项.等待项ID));
        }
    }

    // 功能：按函数名执行对应处理。
    std::optional<结构_外设观察报告队列项> D455_发布采集成功后的报告编排(
        const 双目相机本能适配器::调用结果& 采集结果,
        std::uint64_t 序号,
        std::uint64_t& 逐簇识别报告入队日志抑制条数,
        std::uint64_t& 稳定子集报告跳过日志抑制条数,
        std::uint64_t& 扫描跳过日志抑制条数,
        std::uint64_t& 扫描样本卡日志抑制条数,
        std::uint64_t& 跟踪跳过日志抑制条数)
    {
        const auto 上一稳定子集报告 = D455_读取最新L1稳定子集报告();
        const auto 等待项分组 = D455_读取并分组等待项();
        auto 报告组 = D455_发布本帧逐簇与稳定子集报告(
            采集结果,
            等待项分组,
            序号,
            逐簇识别报告入队日志抑制条数,
            稳定子集报告跳过日志抑制条数);
        if (!报告组.逐簇识别报告.has_value()) {
            return std::nullopt;
        }
        D455_发布扫描变化报告(
            *报告组.逐簇识别报告,
            报告组.稳定子集报告,
            上一稳定子集报告,
            等待项分组.扫描变化等待项集合,
            序号,
            扫描跳过日志抑制条数,
            扫描样本卡日志抑制条数);
        D455_发布目标跟踪报告(
            *报告组.逐簇识别报告,
            报告组.稳定子集报告,
            等待项分组.跟踪等待项集合,
            序号,
            跟踪跳过日志抑制条数);
        return 报告组.逐簇识别报告;
    }

    // 功能：按函数名执行对应处理。
    void D455_线程主循环(std::shared_ptr<结构_D455线程共享状态> 状态) noexcept
    {
        try {
            D455_写入状态结果(状态, 枚举_D455深度相机线程生命周期状态::启动中);
            项目运行日志("外设线程_D455深度相机/启动 | 目标=持续取得D455深度相机观察样本");
            D455_清空跟踪稳定缓存();
            D455_清空跨帧观察簇缓存();

            const auto 配置 = [&]() {
                std::lock_guard<std::mutex> 锁(状态->互斥);
                return 状态->配置;
            }();

            if (配置.启动时打开相机) {
                const auto 打开结果 = 双目相机本能适配器::打开();
                if (!打开结果.成功) {
                    auto 样本 = D455_从调用结果生成样本(0, 打开结果);
                    样本.消息 = "启动时打开相机失败: " + 打开结果.消息;
                    {
                        std::lock_guard<std::mutex> 锁(状态->互斥);
                        状态->样本.push_back(std::move(样本));
                    }
                    项目运行错误日志("外设线程_D455深度相机/打开失败 | 原因=" + 打开结果.消息);
                    D455_设置结束(状态, 枚举_D455深度相机线程生命周期状态::故障);
                    return;
                }
            }

            D455_写入状态结果(状态, 枚举_D455深度相机线程生命周期状态::运行中);

            std::uint64_t 序号 = 0;
            std::uint64_t 逐簇识别报告入队日志抑制条数 = 0;
            std::uint64_t 稳定子集报告跳过日志抑制条数 = 0;
            std::uint64_t 采样日志抑制条数 = 0;
            std::uint64_t 扫描跳过日志抑制条数 = 0;
            std::uint64_t 跟踪跳过日志抑制条数 = 0;
            std::uint64_t 扫描样本卡日志抑制条数 = 0;
            while (true) {
                {
                    std::lock_guard<std::mutex> 锁(状态->互斥);
                    if (状态->停止请求) {
                        break;
                    }
                    if (配置.目标样本数量 > 0 && 序号 >= 配置.目标样本数量) {
                        break;
                    }
                }

                ++序号;
                auto 采集结果 = 双目相机本能适配器::采集一帧();
                std::optional<结构_外设观察报告队列项> 本帧逐簇识别报告{};
                if (采集结果.成功) {
                    D455_写回迁移分割空间候选(&采集结果);
                    本帧逐簇识别报告 = D455_发布采集成功后的报告编排(
                        采集结果,
                        序号,
                        逐簇识别报告入队日志抑制条数,
                        稳定子集报告跳过日志抑制条数,
                        扫描跳过日志抑制条数,
                        扫描样本卡日志抑制条数,
                        跟踪跳过日志抑制条数);
                }
                auto 样本 = D455_从调用结果生成样本(序号, 采集结果);
                if (本帧逐簇识别报告.has_value()) {
                    D455_把跨帧采集摘要写入样本(*本帧逐簇识别报告, &样本);
                }
                if constexpr (D455_调试日志输出启用()) {
                    if (D455_应输出高频日志(序号, !样本.采集成功)) {
                        项目运行日志(
                            "外设线程_D455深度相机/采样 | 日志模式=节流短摘要 | "
                            + D455_构造采样短摘要(样本, 采样日志抑制条数));
                        采样日志抑制条数 = 0;
                    } else {
                        ++采样日志抑制条数;
                    }
                }

                {
                    std::lock_guard<std::mutex> 锁(状态->互斥);
                    状态->样本.push_back(std::move(样本));
                    状态->结果 = D455_评估稳定性(
                        状态->样本,
                        枚举_D455深度相机线程生命周期状态::运行中);
                }

                std::unique_lock<std::mutex> 锁(状态->互斥);
                状态->条件.wait_for(
                    锁,
                    配置.采样间隔,
                    [&]() noexcept { return 状态->停止请求; });
            }

            if constexpr (D455_调试日志输出启用()) {
                if (逐簇识别报告入队日志抑制条数 > 0
                    || 采样日志抑制条数 > 0
                    || 扫描跳过日志抑制条数 > 0
                    || 跟踪跳过日志抑制条数 > 0
                    || 扫描样本卡日志抑制条数 > 0) {
                    项目运行日志(
                        "外设线程_D455深度相机/日志限流收口 | 逐簇识别报告入队抑制条数="
                        + std::to_string(逐簇识别报告入队日志抑制条数)
                        + " | 采样抑制条数="
                        + std::to_string(采样日志抑制条数)
                        + " | 扫描跳过抑制条数="
                        + std::to_string(扫描跳过日志抑制条数)
                        + " | 跟踪跳过抑制条数="
                        + std::to_string(跟踪跳过日志抑制条数)
                        + " | 扫描样本卡抑制条数="
                        + std::to_string(扫描样本卡日志抑制条数));
                }
            }

            if (配置.停止时释放相机) {
                (void)双目相机本能适配器::释放();
            }

            D455_设置结束(状态, 枚举_D455深度相机线程生命周期状态::已停止);
            const auto 最终结果 = D455_读取结果(状态);
            项目运行日志("外设线程_D455深度相机/停止 | " + 构造D455深度相机线程结果摘要(最终结果));
        } catch (const std::exception& 异常) {
            项目运行错误日志(std::string("外设线程_D455深度相机/异常 | 原因=") + 异常.what());
            D455_设置结束(状态, 枚举_D455深度相机线程生命周期状态::故障);
        } catch (...) {
            项目运行错误日志("外设线程_D455深度相机/未知异常");
            D455_设置结束(状态, 枚举_D455深度相机线程生命周期状态::故障);
        }
    }
}

// 功能：提交事实、动态、任务状态或运行回执。
std::string 提交D455单帧材料包证据卡(
    const 双目相机本能适配器::调用结果& 来源)
{
    if (!来源.成功) {
        return {};
    }
    auto 分割来源 = 来源;
    D455_写回迁移分割空间候选(&分割来源);

    const auto 上一逐簇识别报告 = 读取最新外设观察报告(
        D455_外设ID,
        枚举_外设观察报告类型::逐簇识别报告);
    auto 逐簇识别报告 = D455_从调用结果生成逐簇识别报告(分割来源);
    D455_更新逐簇识别报告跨帧采集状态(&逐簇识别报告);
    const auto 报告ID = 提交外设观察报告(逐簇识别报告);
    逐簇识别报告.报告ID = 报告ID;
    const bool 材料页已提交 = 提交D455短期观察材料页(
        报告ID,
        分割来源,
        逐簇识别报告);

    结构_外设观察等待项 临时扫描等待项{};
    临时扫描等待项.等待项ID = 报告ID;
    临时扫描等待项.允许降级匹配 = 1;
    auto 扫描变化报告 = D455_从逐簇识别报告生成扫描变化报告_带上下文(
        逐簇识别报告,
        上一逐簇识别报告,
        报告ID,
        0,
        临时扫描等待项,
        std::nullopt,
        结构_目标观察约束可用性判定{});
    const auto 扫描变化报告ID = 提交外设观察报告(扫描变化报告);
    扫描变化报告.报告ID = 扫描变化报告ID;

    const auto 证据卡 = 构造D455材料包证据卡摘要(逐簇识别报告);
    const auto 识别样本卡 = 构造D455逐簇识别样本卡摘要(逐簇识别报告);
    const auto 扫描样本卡 = 构造D455扫描变化样本卡摘要(扫描变化报告);
    项目运行日志(
        "外设线程_D455深度相机/单帧材料包证据卡 | "
        + 证据卡
        + " | 短期观察材料页提交="
        + std::to_string(材料页已提交 ? 1 : 0));
    项目运行日志(
        "外设线程_D455深度相机/单帧逐簇识别样本卡 | "
        + 识别样本卡);
    项目运行日志(
        "外设线程_D455深度相机/单帧扫描变化样本卡 | "
        + 扫描样本卡);
    return 证据卡
        + " | 短期观察材料页提交="
        + std::to_string(材料页已提交 ? 1 : 0)
        + " | "
        + 识别样本卡
        + " | "
        + 扫描样本卡;
}

// 功能：按函数名执行对应处理。
std::string 构造D455深度相机观察样本摘要(const 结构_D455深度相机观察样本& 样本)
{
    std::ostringstream 输出;
        输出 << "样本=" << 样本.序号
        << " | 成功=" << (样本.采集成功 ? 1 : 0)
        << " | 可比=" << (样本.基础特征可比 ? 1 : 0)
        << " | 帧=" << 样本.帧宽度 << 'x' << 样本.帧高度
        << " | 深度帧号=" << 样本.深度帧号
        << " | 彩色帧号=" << 样本.彩色帧号
        << " | 像素特征=" << 样本.像素特征数量
        << " | 预期像素=" << 样本.预期像素数量
        << " | 深度有效率=" << 样本.深度有效率
        << " | 空间坐标有效率=" << 样本.空间坐标有效率
        << " | 质量=" << 样本.帧质量评分
        << " | 空间候选=" << 样本.空间候选数量
        << " | 主候选=" << 样本.主候选编号
        << " | 主跨帧簇=" << 样本.主候选跨帧簇ID
        << " | 主候选像素=" << 样本.主候选像素数量
        << " | 中心=(" << 样本.中心X << ',' << 样本.中心Y << ',' << 样本.中心Z << ')'
        << " | 范围稳定性=" << 样本.范围稳定性评分
        << " | 跨帧匹配簇=" << 样本.跨帧匹配簇数量
        << " | 跨帧新建簇=" << 样本.跨帧新建簇数量
        << " | 跨帧稳定簇=" << 样本.跨帧稳定簇数量
        << " | 跨帧丢失簇=" << 样本.跨帧丢失簇数量
        << " | 主跨帧连续命中=" << 样本.主候选跨帧连续命中次数
        << " | 主跨帧稳定命中=" << 样本.主候选跨帧连续稳定命中次数
        << " | 主跨帧连续发布=" << 样本.主候选跨帧连续发布次数
        << " | 主跨帧稳定状态=" << 样本.主候选跨帧轨迹稳定状态
        << " | 主跨帧复现离散度=" << 样本.主候选跨帧复现离散度
        << " | 主投影范围=(" << 样本.主候选投影最小X << ',' << 样本.主候选投影最小Y
        << ")-(" << 样本.主候选投影最大X << ',' << 样本.主候选投影最大Y << ')';
    if (!样本.消息.empty()) {
        输出 << " | 消息=" << 样本.消息;
    }
    return 输出.str();
}

// 功能：按函数名执行对应处理。
std::string 构造D455深度相机线程结果摘要(const 结构_D455深度相机线程结果& 结果)
{
    std::ostringstream 输出;
    输出 << "外设线程_D455深度相机"
        << " | 生命周期=" << D455深度相机线程生命周期文本(结果.生命周期)
        << " | 已启动=" << (结果.已启动 ? 1 : 0)
        << " | 已完成=" << (结果.已完成 ? 1 : 0)
        << " | 样本=" << 结果.样本数量
        << " | 可比样本=" << 结果.基础可比样本数量
        << " | 稳定连接=" << 结果.稳定连接数量
        << " | 基础采样稳定连接=" << 结果.基础采样稳定连接数量
        << " | 观察候选稳定连接=" << 结果.观察候选稳定连接数量
        << " | 基础采样稳定=" << (结果.基础采样稳定 ? "稳定" : "不稳定")
        << " | 观察候选稳定=" << (结果.观察候选稳定 ? "稳定" : "不稳定")
        << " | 综合稳定=" << (结果.稳定 ? "稳定" : "不稳定");
    return 输出.str();
}

// 功能：初始化对象实例。
外设线程_D455深度相机类::外设线程_D455深度相机类()
    : 状态_(std::make_shared<结构_D455线程共享状态>())
{
}

// 功能：释放或收束对象资源。
外设线程_D455深度相机类::~外设线程_D455深度相机类()
{
    请求停止();
    等待停止();
}

// 功能：启动线程、模块或运行流程。
bool 外设线程_D455深度相机类::启动(const 结构_D455深度相机线程配置& 配置)
{
    if (工作线程_.joinable()) {
        return false;
    }

    状态_ = std::make_shared<结构_D455线程共享状态>();
    {
        std::lock_guard<std::mutex> 锁(状态_->互斥);
        状态_->配置 = 配置;
        状态_->生命周期 = 枚举_D455深度相机线程生命周期状态::启动中;
        状态_->结果.生命周期 = 枚举_D455深度相机线程生命周期状态::启动中;
        状态_->结果.已启动 = true;
    }
    auto 共享状态 = 状态_;
    工作线程_ = std::thread([共享状态]() noexcept {
        D455_线程主循环(共享状态);
    });
    return true;
}

// 功能：停止线程、模块或运行流程。
void 外设线程_D455深度相机类::请求停止()
{
    if (!状态_) {
        return;
    }
    {
        std::lock_guard<std::mutex> 锁(状态_->互斥);
        if (!状态_->已结束) {
            状态_->停止请求 = true;
            状态_->生命周期 = 枚举_D455深度相机线程生命周期状态::停止请求中;
            状态_->结果.生命周期 = 状态_->生命周期;
        }
    }
    状态_->条件.notify_all();
}

// 功能：停止线程、模块或运行流程。
void 外设线程_D455深度相机类::等待停止()
{
    if (工作线程_.joinable()) {
        工作线程_.join();
    }
}

// 功能：等待线程、任务、外设或条件变化。
结构_D455深度相机线程结果 外设线程_D455深度相机类::等待完成(
    std::chrono::milliseconds 等待上限)
{
    if (!状态_) {
        return {};
    }

    {
        std::unique_lock<std::mutex> 锁(状态_->互斥);
        if (!状态_->条件.wait_for(锁, 等待上限, [&]() noexcept { return 状态_->已结束; })) {
            状态_->停止请求 = true;
            状态_->生命周期 = 枚举_D455深度相机线程生命周期状态::停止请求中;
            状态_->结果 = D455_评估稳定性(状态_->样本, 状态_->生命周期);
            auto 超时结果 = 状态_->结果;
            状态_->条件.notify_all();
            if (工作线程_.joinable()) {
                工作线程_.detach();
            }
            项目运行警告日志(
                "外设线程_D455深度相机/等待超时 | 等待毫秒="
                + std::to_string(等待上限.count()));
            return 超时结果;
        }
    }

    等待停止();
    return 读取最新结果();
}

// 功能：从指定来源读取数据或状态。
枚举_D455深度相机线程生命周期状态
外设线程_D455深度相机类::读取生命周期状态() const noexcept
{
    if (!状态_) {
        return 枚举_D455深度相机线程生命周期状态::未启动;
    }
    std::lock_guard<std::mutex> 锁(状态_->互斥);
    return 状态_->生命周期;
}

// 功能：执行对应模块、线程或方法的运行逻辑。
bool 外设线程_D455深度相机类::是否运行中() const noexcept
{
    const auto 状态 = 读取生命周期状态();
    return 状态 == 枚举_D455深度相机线程生命周期状态::启动中
        || 状态 == 枚举_D455深度相机线程生命周期状态::运行中
        || 状态 == 枚举_D455深度相机线程生命周期状态::停止请求中;
}

// 功能：从指定来源读取数据或状态。
结构_D455深度相机线程结果 外设线程_D455深度相机类::读取最新结果() const
{
    if (!状态_) {
        return {};
    }
    std::lock_guard<std::mutex> 锁(状态_->互斥);
    return 状态_->结果;
}

// 功能：读取并返回指定对象、状态或运行材料。
外设线程_D455深度相机类& 获取全局外设线程_D455深度相机() noexcept
{
    static 外设线程_D455深度相机类 线程;
    return 线程;
}

// 功能：启动线程、模块或运行流程。
bool 启动外设线程_D455深度相机(const 结构_D455深度相机线程配置& 配置)
{
    return 获取全局外设线程_D455深度相机().启动(配置);
}

// 功能：停止线程、模块或运行流程。
void 停止外设线程_D455深度相机()
{
    auto& 线程 = 获取全局外设线程_D455深度相机();
    线程.请求停止();
    线程.等待停止();
}

// 功能：从指定来源读取数据或状态。
结构_D455深度相机线程结果 读取外设线程_D455深度相机结果()
{
    return 获取全局外设线程_D455深度相机().读取最新结果();
}
