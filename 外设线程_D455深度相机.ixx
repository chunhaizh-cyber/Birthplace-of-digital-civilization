export class 外设线程_D455深度相机类 {
public:
    外设线程_D455深度相机类();
    ~外设线程_D455深度相机类();

    外设线程_D455深度相机类(const 外设线程_D455深度相机类&) = delete;
    外设线程_D455深度相机类& operator=(const 外设线程_D455深度相机类&) = delete;

    bool 启动(const 结构_D455深度相机线程配置& 配置 = {});
    void 请求停止();
    void 等待停止();
    结构_D455深度相机线程结果 等待完成(std::chrono::milliseconds 等待上限);
    枚举_D455深度相机线程生命周期状态 读取生命周期状态() const noexcept;
    bool 是否运行中() const noexcept;
    结构_D455深度相机线程结果 读取最新结果() const;

private:
    std::shared_ptr<结构_D455线程共享状态> 状态_{};
    std::thread 工作线程_{};
};

export 外设线程_D455深度相机类& 获取全局外设线程_D455深度相机() noexcept;
export bool 启动外设线程_D455深度相机(const 结构_D455深度相机线程配置& 配置 = {});
export void 停止外设线程_D455深度相机();
export 结构_D455深度相机线程结果 读取外设线程_D455深度相机结果();

// 功能：按函数名执行对应处理。
const char* D455深度相机线程生命周期文本(
    枚举_D455深度相机线程生命周期状态 状态) noexcept
{
    switch (状态) {
    case 枚举_D455深度相机线程生命周期状态::未启动: return "未启动";
    case 枚举_D455深度相机线程生命周期状态::启动中: return "启动中";
    case 枚举_D455深度相机线程生命周期状态::运行中: return "运行中";
    case 枚举_D455深度相机线程生命周期状态::停止请求中: return "停止请求中";
    case 枚举_D455深度相机线程生命周期状态::已停止: return "已停止";
    case 枚举_D455深度相机线程生命周期状态::故障: return "故障";
    default: return "未知";
    }
}

struct 结构_D455线程共享状态 {
    mutable std::mutex 互斥{};
    std::condition_variable 条件{};
    结构_D455深度相机线程配置 配置{};
    枚举_D455深度相机线程生命周期状态 生命周期 =
        枚举_D455深度相机线程生命周期状态::未启动;
    bool 停止请求 = false;
    bool 已结束 = false;
    结构_D455深度相机线程结果 结果{};
    std::vector<结构_D455深度相机观察样本> 样本{};
};

