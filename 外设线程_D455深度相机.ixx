module;

#include <algorithm>
#include <chrono>
#include <condition_variable>
#include <cstdint>
#include <exception>
#include <memory>
#include <mutex>
#include <sstream>
#include <string>
#include <thread>
#include <utility>
#include <vector>

#include "双目相机本能适配器.h"

export module 外设线程_D455深度相机;

import 日志模块;

export enum class 枚举_D455深度相机线程生命周期状态 : std::uint8_t {
    未启动 = 0,
    启动中 = 1,
    运行中 = 2,
    停止请求中 = 3,
    已停止 = 4,
    故障 = 5,
};

export struct 结构_D455深度相机线程配置 {
    std::chrono::milliseconds 采样间隔{300};
    std::uint32_t 目标样本数量 = 0; // 0 表示持续采样，直到请求停止。
    bool 启动时打开相机 = true;
    bool 停止时释放相机 = true;
};

export struct 结构_D455深度相机观察样本 {
    std::uint64_t 序号 = 0;
    bool 采集成功 = false;
    bool 相机已打开 = false;
    std::uint8_t 失败原因 = 0;
    std::string 消息{};

    bool 基础特征可比 = false;
    std::int64_t 帧宽度 = 0;
    std::int64_t 帧高度 = 0;
    std::int64_t 深度帧号 = 0;
    std::int64_t 彩色帧号 = 0;
    std::int64_t 预期像素数量 = 0;
    std::int64_t 像素特征数量 = 0;
    std::int64_t 深度有效像素数量 = 0;
    std::int64_t 点云有效像素数量 = 0;
    std::int64_t 深度有效率 = 0;
    std::int64_t 空间坐标有效率 = 0;
    std::int64_t 帧质量评分 = 0;

    std::int64_t 空间候选数量 = 0;
    std::int64_t 主候选编号 = 0;
    std::int64_t 主候选像素数量 = 0;
    std::int64_t 中心X = 0;
    std::int64_t 中心Y = 0;
    std::int64_t 中心Z = 0;
    std::int64_t 范围稳定性评分 = 0;
};

export struct 结构_D455深度相机线程结果 {
    枚举_D455深度相机线程生命周期状态 生命周期 =
        枚举_D455深度相机线程生命周期状态::未启动;
    bool 已启动 = false;
    bool 已完成 = false;
    bool 稳定 = false;
    std::uint64_t 样本数量 = 0;
    std::uint64_t 基础可比样本数量 = 0;
    std::uint64_t 稳定连接数量 = 0;
    std::vector<结构_D455深度相机观察样本> 样本{};
    std::vector<std::string> 不稳定原因{};
};

export const char* D455深度相机线程生命周期文本(
    枚举_D455深度相机线程生命周期状态 状态) noexcept;
export std::string 构造D455深度相机观察样本摘要(const 结构_D455深度相机观察样本& 样本);
export std::string 构造D455深度相机线程结果摘要(const 结构_D455深度相机线程结果& 结果);

struct 结构_D455线程共享状态;

export class 外设线程_D455深度相机类 {
public:
    外设线程_D455深度相机类();
    ~外设线程_D455深度相机类();

    外设线程_D455深度相机类(const 外设线程_D455深度相机类&) = delete;
    外设线程_D455深度相机类& operator=(const 外设线程_D455深度相机类&) = delete;

    bool 启动(const 结构_D455深度相机线程配置& 配置 = {});
    void 请求停止();
    void 等待停止();
    结构_D455深度相机线程结果 等待完成(std::chrono::milliseconds 等待上限);
    枚举_D455深度相机线程生命周期状态 读取生命周期状态() const noexcept;
    bool 是否运行中() const noexcept;
    结构_D455深度相机线程结果 读取最新结果() const;

private:
    std::shared_ptr<结构_D455线程共享状态> 状态_{};
    std::thread 工作线程_{};
};

export 外设线程_D455深度相机类& 获取全局外设线程_D455深度相机() noexcept;
export bool 启动外设线程_D455深度相机(const 结构_D455深度相机线程配置& 配置 = {});
export void 停止外设线程_D455深度相机();
export 结构_D455深度相机线程结果 读取外设线程_D455深度相机结果();

const char* D455深度相机线程生命周期文本(
    枚举_D455深度相机线程生命周期状态 状态) noexcept
{
    switch (状态) {
    case 枚举_D455深度相机线程生命周期状态::未启动: return "未启动";
    case 枚举_D455深度相机线程生命周期状态::启动中: return "启动中";
    case 枚举_D455深度相机线程生命周期状态::运行中: return "运行中";
    case 枚举_D455深度相机线程生命周期状态::停止请求中: return "停止请求中";
    case 枚举_D455深度相机线程生命周期状态::已停止: return "已停止";
    case 枚举_D455深度相机线程生命周期状态::故障: return "故障";
    default: return "未知";
    }
}

struct 结构_D455线程共享状态 {
    mutable std::mutex 互斥{};
    std::condition_variable 条件{};
    结构_D455深度相机线程配置 配置{};
    枚举_D455深度相机线程生命周期状态 生命周期 =
        枚举_D455深度相机线程生命周期状态::未启动;
    bool 停止请求 = false;
    bool 已结束 = false;
    结构_D455深度相机线程结果 结果{};
    std::vector<结构_D455深度相机观察样本> 样本{};
};

namespace {
    std::int64_t D455_I64绝对差(std::int64_t 左, std::int64_t 右) noexcept
    {
        return 左 >= 右 ? 左 - 右 : 右 - 左;
    }

    std::int64_t D455_计数容差(std::int64_t 基准) noexcept
    {
        const auto 正基准 = 基准 >= 0 ? 基准 : -基准;
        return (std::max<std::int64_t>)(5, 正基准 / 20);
    }

    结构_D455深度相机观察样本 D455_从调用结果生成样本(
        std::uint64_t 序号,
        const 双目相机本能适配器::调用结果& 来源)
    {
        结构_D455深度相机观察样本 样本{};
        样本.序号 = 序号;
        样本.采集成功 = 来源.成功;
        样本.相机已打开 = 来源.相机已打开;
        样本.失败原因 = static_cast<std::uint8_t>(来源.原因);
        样本.消息 = 来源.消息;
        样本.帧宽度 = 来源.宽度;
        样本.帧高度 = 来源.高度;
        样本.深度帧号 = 来源.深度帧号;
        样本.彩色帧号 = 来源.彩色帧号;
        样本.预期像素数量 = 来源.预期像素数量;
        样本.像素特征数量 = 来源.像素特征数量;
        样本.深度有效像素数量 = 来源.深度有效像素数量;
        样本.点云有效像素数量 = 来源.点云有效像素数量;
        样本.深度有效率 = 来源.深度有效率;
        样本.空间坐标有效率 = 来源.空间坐标有效率;
        样本.帧质量评分 = 来源.帧质量评分;
        样本.空间候选数量 = 来源.空间候选数量;

        if (!来源.空间候选列表.empty()) {
            const auto 主候选 = std::max_element(
                来源.空间候选列表.begin(),
                来源.空间候选列表.end(),
                [](const auto& 左, const auto& 右) noexcept {
                    return 左.像素数量 < 右.像素数量;
                });
            if (主候选 != 来源.空间候选列表.end()) {
                样本.主候选编号 = 主候选->候选编号;
                样本.主候选像素数量 = 主候选->像素数量;
                样本.中心X = 主候选->中心X;
                样本.中心Y = 主候选->中心Y;
                样本.中心Z = 主候选->中心Z;
                样本.范围稳定性评分 = 主候选->范围稳定性评分;
            }
        }

        样本.基础特征可比 = 样本.采集成功
            && 样本.帧宽度 > 0
            && 样本.帧高度 > 0
            && 样本.预期像素数量 > 0
            && 样本.像素特征数量 > 0;
        return 样本;
    }

    bool D455_观察样本对稳定(
        const 结构_D455深度相机观察样本& 左,
        const 结构_D455深度相机观察样本& 右,
        std::string& 原因)
    {
        if (!左.基础特征可比 || !右.基础特征可比) {
            原因 = "基础观察特征不可比";
            return false;
        }
        if (左.帧宽度 != 右.帧宽度 || 左.帧高度 != 右.帧高度) {
            原因 = "帧尺寸不稳定";
            return false;
        }
        if (左.预期像素数量 != 右.预期像素数量
            || 左.像素特征数量 != 右.像素特征数量) {
            原因 = "像素特征数量不稳定";
            return false;
        }
        if (D455_I64绝对差(左.深度有效率, 右.深度有效率) > 500) {
            原因 = "深度有效率波动超过容差";
            return false;
        }
        if (D455_I64绝对差(左.空间坐标有效率, 右.空间坐标有效率) > 500) {
            原因 = "空间坐标有效率波动超过容差";
            return false;
        }
        if (D455_I64绝对差(左.帧质量评分, 右.帧质量评分) > 1000) {
            原因 = "帧质量评分波动超过容差";
            return false;
        }

        const auto 候选容差 = D455_计数容差(左.空间候选数量);
        if (D455_I64绝对差(左.空间候选数量, 右.空间候选数量) > 候选容差) {
            原因 = "空间候选数量不稳定";
            return false;
        }
        if ((左.空间候选数量 > 0) != (右.空间候选数量 > 0)) {
            原因 = "空间候选有无状态不稳定";
            return false;
        }
        if (左.空间候选数量 > 0 && 右.空间候选数量 > 0) {
            if (D455_I64绝对差(左.主候选像素数量, 右.主候选像素数量)
                > D455_计数容差(左.主候选像素数量)) {
                原因 = "主空间候选像素数量不稳定";
                return false;
            }
            if (D455_I64绝对差(左.中心X, 右.中心X) > 150
                || D455_I64绝对差(左.中心Y, 右.中心Y) > 150
                || D455_I64绝对差(左.中心Z, 右.中心Z) > 150) {
                原因 = "主空间候选中心坐标不稳定";
                return false;
            }
            if (D455_I64绝对差(左.范围稳定性评分, 右.范围稳定性评分) > 1000) {
                原因 = "空间范围稳定性评分波动超过容差";
                return false;
            }
        }

        原因 = "稳定";
        return true;
    }

    结构_D455深度相机线程结果 D455_评估稳定性(
        const std::vector<结构_D455深度相机观察样本>& 样本集合,
        枚举_D455深度相机线程生命周期状态 生命周期)
    {
        结构_D455深度相机线程结果 结果{};
        结果.生命周期 = 生命周期;
        结果.已启动 = 生命周期 != 枚举_D455深度相机线程生命周期状态::未启动;
        结果.已完成 = 生命周期 == 枚举_D455深度相机线程生命周期状态::已停止
            || 生命周期 == 枚举_D455深度相机线程生命周期状态::故障;
        结果.样本 = 样本集合;
        结果.样本数量 = static_cast<std::uint64_t>(样本集合.size());

        for (const auto& 样本 : 样本集合) {
            if (样本.基础特征可比) {
                ++结果.基础可比样本数量;
            }
        }
        for (std::size_t i = 1; i < 样本集合.size(); ++i) {
            std::string 原因;
            if (D455_观察样本对稳定(样本集合[i - 1], 样本集合[i], 原因)) {
                ++结果.稳定连接数量;
            } else {
                std::ostringstream 输出;
                输出 << "样本" << 样本集合[i - 1].序号
                    << "->" << 样本集合[i].序号
                    << ':' << 原因;
                结果.不稳定原因.push_back(输出.str());
            }
        }
        if (样本集合.size() >= 2) {
            std::string 最新原因;
            const bool 最新窗口稳定 = D455_观察样本对稳定(
                样本集合[样本集合.size() - 2],
                样本集合[样本集合.size() - 1],
                最新原因);
            结果.稳定 = 结果.基础可比样本数量 >= 2
                && 结果.稳定连接数量 >= 1
                && 最新窗口稳定;
        }
        return 结果;
    }

    void D455_写入状态结果(
        const std::shared_ptr<结构_D455线程共享状态>& 状态,
        枚举_D455深度相机线程生命周期状态 生命周期)
    {
        std::lock_guard<std::mutex> 锁(状态->互斥);
        状态->生命周期 = 生命周期;
        状态->结果 = D455_评估稳定性(状态->样本, 生命周期);
    }

    void D455_设置结束(
        const std::shared_ptr<结构_D455线程共享状态>& 状态,
        枚举_D455深度相机线程生命周期状态 生命周期)
    {
        {
            std::lock_guard<std::mutex> 锁(状态->互斥);
            状态->生命周期 = 生命周期;
            状态->已结束 = true;
            状态->结果 = D455_评估稳定性(状态->样本, 生命周期);
        }
        状态->条件.notify_all();
    }

    结构_D455深度相机线程结果 D455_读取结果(
        const std::shared_ptr<结构_D455线程共享状态>& 状态)
    {
        std::lock_guard<std::mutex> 锁(状态->互斥);
        return 状态->结果;
    }

    void D455_线程主循环(std::shared_ptr<结构_D455线程共享状态> 状态) noexcept
    {
        try {
            D455_写入状态结果(状态, 枚举_D455深度相机线程生命周期状态::启动中);
            项目运行日志("外设线程_D455深度相机/启动 | 目标=持续取得D455深度相机观察样本");

            const auto 配置 = [&]() {
                std::lock_guard<std::mutex> 锁(状态->互斥);
                return 状态->配置;
            }();

            if (配置.启动时打开相机) {
                const auto 打开结果 = 双目相机本能适配器::打开();
                if (!打开结果.成功) {
                    auto 样本 = D455_从调用结果生成样本(0, 打开结果);
                    样本.消息 = "启动时打开相机失败: " + 打开结果.消息;
                    {
                        std::lock_guard<std::mutex> 锁(状态->互斥);
                        状态->样本.push_back(std::move(样本));
                    }
                    项目运行错误日志("外设线程_D455深度相机/打开失败 | 原因=" + 打开结果.消息);
                    D455_设置结束(状态, 枚举_D455深度相机线程生命周期状态::故障);
                    return;
                }
            }

            D455_写入状态结果(状态, 枚举_D455深度相机线程生命周期状态::运行中);

            std::uint64_t 序号 = 0;
            while (true) {
                {
                    std::lock_guard<std::mutex> 锁(状态->互斥);
                    if (状态->停止请求) {
                        break;
                    }
                    if (配置.目标样本数量 > 0 && 序号 >= 配置.目标样本数量) {
                        break;
                    }
                }

                ++序号;
                const auto 采集结果 = 双目相机本能适配器::采集一帧();
                auto 样本 = D455_从调用结果生成样本(序号, 采集结果);
                项目运行日志("外设线程_D455深度相机/采样 | " + 构造D455深度相机观察样本摘要(样本));

                {
                    std::lock_guard<std::mutex> 锁(状态->互斥);
                    状态->样本.push_back(std::move(样本));
                    状态->结果 = D455_评估稳定性(
                        状态->样本,
                        枚举_D455深度相机线程生命周期状态::运行中);
                }

                std::unique_lock<std::mutex> 锁(状态->互斥);
                状态->条件.wait_for(
                    锁,
                    配置.采样间隔,
                    [&]() noexcept { return 状态->停止请求; });
            }

            if (配置.停止时释放相机) {
                (void)双目相机本能适配器::释放();
            }

            D455_设置结束(状态, 枚举_D455深度相机线程生命周期状态::已停止);
            const auto 最终结果 = D455_读取结果(状态);
            项目运行日志("外设线程_D455深度相机/停止 | " + 构造D455深度相机线程结果摘要(最终结果));
        } catch (const std::exception& 异常) {
            项目运行错误日志(std::string("外设线程_D455深度相机/异常 | 原因=") + 异常.what());
            {
                std::lock_guard<std::mutex> 锁(状态->互斥);
                状态->结果.不稳定原因.push_back(std::string("线程异常: ") + 异常.what());
            }
            D455_设置结束(状态, 枚举_D455深度相机线程生命周期状态::故障);
        } catch (...) {
            项目运行错误日志("外设线程_D455深度相机/未知异常");
            {
                std::lock_guard<std::mutex> 锁(状态->互斥);
                状态->结果.不稳定原因.push_back("线程未知异常");
            }
            D455_设置结束(状态, 枚举_D455深度相机线程生命周期状态::故障);
        }
    }
}

std::string 构造D455深度相机观察样本摘要(const 结构_D455深度相机观察样本& 样本)
{
    std::ostringstream 输出;
    输出 << "样本=" << 样本.序号
        << " | 成功=" << (样本.采集成功 ? 1 : 0)
        << " | 可比=" << (样本.基础特征可比 ? 1 : 0)
        << " | 帧=" << 样本.帧宽度 << 'x' << 样本.帧高度
        << " | 深度帧号=" << 样本.深度帧号
        << " | 彩色帧号=" << 样本.彩色帧号
        << " | 像素特征=" << 样本.像素特征数量
        << " | 预期像素=" << 样本.预期像素数量
        << " | 深度有效率=" << 样本.深度有效率
        << " | 空间坐标有效率=" << 样本.空间坐标有效率
        << " | 质量=" << 样本.帧质量评分
        << " | 空间候选=" << 样本.空间候选数量
        << " | 主候选=" << 样本.主候选编号
        << " | 主候选像素=" << 样本.主候选像素数量
        << " | 中心=(" << 样本.中心X << ',' << 样本.中心Y << ',' << 样本.中心Z << ')'
        << " | 范围稳定性=" << 样本.范围稳定性评分;
    if (!样本.消息.empty()) {
        输出 << " | 消息=" << 样本.消息;
    }
    return 输出.str();
}

std::string 构造D455深度相机线程结果摘要(const 结构_D455深度相机线程结果& 结果)
{
    std::ostringstream 输出;
    输出 << "外设线程_D455深度相机"
        << " | 生命周期=" << D455深度相机线程生命周期文本(结果.生命周期)
        << " | 已启动=" << (结果.已启动 ? 1 : 0)
        << " | 已完成=" << (结果.已完成 ? 1 : 0)
        << " | 样本=" << 结果.样本数量
        << " | 可比样本=" << 结果.基础可比样本数量
        << " | 稳定连接=" << 结果.稳定连接数量
        << " | 稳定状态=" << (结果.稳定 ? "稳定" : "不稳定");
    if (!结果.不稳定原因.empty()) {
        输出 << " | 首个不稳定原因=" << 结果.不稳定原因.front();
    }
    return 输出.str();
}

外设线程_D455深度相机类::外设线程_D455深度相机类()
    : 状态_(std::make_shared<结构_D455线程共享状态>())
{
}

外设线程_D455深度相机类::~外设线程_D455深度相机类()
{
    请求停止();
    等待停止();
}

bool 外设线程_D455深度相机类::启动(const 结构_D455深度相机线程配置& 配置)
{
    if (工作线程_.joinable()) {
        return false;
    }

    状态_ = std::make_shared<结构_D455线程共享状态>();
    {
        std::lock_guard<std::mutex> 锁(状态_->互斥);
        状态_->配置 = 配置;
        状态_->生命周期 = 枚举_D455深度相机线程生命周期状态::启动中;
        状态_->结果.生命周期 = 枚举_D455深度相机线程生命周期状态::启动中;
        状态_->结果.已启动 = true;
    }
    auto 共享状态 = 状态_;
    工作线程_ = std::thread([共享状态]() noexcept {
        D455_线程主循环(共享状态);
    });
    return true;
}

void 外设线程_D455深度相机类::请求停止()
{
    if (!状态_) {
        return;
    }
    {
        std::lock_guard<std::mutex> 锁(状态_->互斥);
        if (!状态_->已结束) {
            状态_->停止请求 = true;
            状态_->生命周期 = 枚举_D455深度相机线程生命周期状态::停止请求中;
            状态_->结果.生命周期 = 状态_->生命周期;
        }
    }
    状态_->条件.notify_all();
}

void 外设线程_D455深度相机类::等待停止()
{
    if (工作线程_.joinable()) {
        工作线程_.join();
    }
}

结构_D455深度相机线程结果 外设线程_D455深度相机类::等待完成(
    std::chrono::milliseconds 等待上限)
{
    if (!状态_) {
        return {};
    }

    {
        std::unique_lock<std::mutex> 锁(状态_->互斥);
        if (!状态_->条件.wait_for(锁, 等待上限, [&]() noexcept { return 状态_->已结束; })) {
            状态_->停止请求 = true;
            状态_->生命周期 = 枚举_D455深度相机线程生命周期状态::停止请求中;
            状态_->结果 = D455_评估稳定性(状态_->样本, 状态_->生命周期);
            状态_->结果.不稳定原因.push_back("外设线程_D455深度相机等待超时");
            auto 超时结果 = 状态_->结果;
            状态_->条件.notify_all();
            if (工作线程_.joinable()) {
                工作线程_.detach();
            }
            项目运行警告日志(
                "外设线程_D455深度相机/等待超时 | 等待毫秒="
                + std::to_string(等待上限.count()));
            return 超时结果;
        }
    }

    等待停止();
    return 读取最新结果();
}

枚举_D455深度相机线程生命周期状态
外设线程_D455深度相机类::读取生命周期状态() const noexcept
{
    if (!状态_) {
        return 枚举_D455深度相机线程生命周期状态::未启动;
    }
    std::lock_guard<std::mutex> 锁(状态_->互斥);
    return 状态_->生命周期;
}

bool 外设线程_D455深度相机类::是否运行中() const noexcept
{
    const auto 状态 = 读取生命周期状态();
    return 状态 == 枚举_D455深度相机线程生命周期状态::启动中
        || 状态 == 枚举_D455深度相机线程生命周期状态::运行中
        || 状态 == 枚举_D455深度相机线程生命周期状态::停止请求中;
}

结构_D455深度相机线程结果 外设线程_D455深度相机类::读取最新结果() const
{
    if (!状态_) {
        return {};
    }
    std::lock_guard<std::mutex> 锁(状态_->互斥);
    return 状态_->结果;
}

外设线程_D455深度相机类& 获取全局外设线程_D455深度相机() noexcept
{
    static 外设线程_D455深度相机类 线程;
    return 线程;
}

bool 启动外设线程_D455深度相机(const 结构_D455深度相机线程配置& 配置)
{
    return 获取全局外设线程_D455深度相机().启动(配置);
}

void 停止外设线程_D455深度相机()
{
    auto& 线程 = 获取全局外设线程_D455深度相机();
    线程.请求停止();
    线程.等待停止();
}

结构_D455深度相机线程结果 读取外设线程_D455深度相机结果()
{
    return 获取全局外设线程_D455深度相机().读取最新结果();
}
