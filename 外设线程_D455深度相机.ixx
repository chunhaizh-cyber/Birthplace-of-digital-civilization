export module 外设线程_D455深度相机;

import 日志模块;
import 外设观察报告队列;

export enum class 枚举_D455深度相机线程生命周期状态 : std::uint8_t {
    未启动 = 0,
    启动中 = 1,
    运行中 = 2,
    停止请求中 = 3,
    已停止 = 4,
    故障 = 5,
};

export struct 结构_D455深度相机线程配置 {
    std::chrono::milliseconds 采样间隔{300};
    std::uint32_t 目标样本数量 = 0; // 0 表示持续采样，直到请求停止。
    bool 启动时打开相机 = true;
    bool 停止时释放相机 = true;
};

export struct 结构_D455深度相机观察样本 {
    std::uint64_t 序号 = 0;
    bool 采集成功 = false;
    bool 相机已打开 = false;
    std::uint8_t 失败原因 = 0;
    std::string 消息{};

    bool 基础特征可比 = false;
    std::int64_t 帧宽度 = 0;
    std::int64_t 帧高度 = 0;
    std::int64_t 深度帧号 = 0;
    std::int64_t 彩色帧号 = 0;
    std::int64_t 预期像素数量 = 0;
    std::int64_t 像素特征数量 = 0;
    std::int64_t 深度有效像素数量 = 0;
    std::int64_t 点云有效像素数量 = 0;
    std::int64_t 深度有效率 = 0;
    std::int64_t 空间坐标有效率 = 0;
    std::int64_t 帧质量评分 = 0;

    std::int64_t 空间候选数量 = 0;
    std::int64_t 主候选编号 = 0;
    std::int64_t 主候选跨帧簇ID = -1;
    std::int64_t 主候选像素数量 = 0;
    std::int64_t 中心X = 0;
    std::int64_t 中心Y = 0;
    std::int64_t 中心Z = 0;
    std::int64_t 范围稳定性评分 = 0;
    bool 跨帧采集可用 = false;
    std::int64_t 跨帧匹配簇数量 = 0;
    std::int64_t 跨帧新建簇数量 = 0;
    std::int64_t 跨帧稳定簇数量 = 0;
    std::int64_t 跨帧丢失簇数量 = 0;
    std::int64_t 主候选跨帧连续命中次数 = 0;
    std::int64_t 主候选跨帧复现离散度 = 0;
};

export struct 结构_D455深度相机线程结果 {
    枚举_D455深度相机线程生命周期状态 生命周期 =
        枚举_D455深度相机线程生命周期状态::未启动;
    bool 已启动 = false;
    bool 已完成 = false;
    bool 稳定 = false;
    bool 基础采样稳定 = false;
    bool 观察候选稳定 = false;
    std::uint64_t 样本数量 = 0;
    std::uint64_t 基础可比样本数量 = 0;
    std::uint64_t 稳定连接数量 = 0;
    std::uint64_t 基础采样稳定连接数量 = 0;
    std::uint64_t 观察候选稳定连接数量 = 0;
    std::vector<结构_D455深度相机观察样本> 样本{};
    std::vector<std::string> 不稳定原因{};
    std::vector<std::string> 基础采样不稳定原因{};
    std::vector<std::string> 观察候选不稳定原因{};
};

export const char* D455深度相机线程生命周期文本(
    枚举_D455深度相机线程生命周期状态 状态) noexcept;
export std::string 构造D455深度相机观察样本摘要(const 结构_D455深度相机观察样本& 样本);
export std::string 构造D455深度相机线程结果摘要(const 结构_D455深度相机线程结果& 结果);

struct 结构_D455线程共享状态;

export class 外设线程_D455深度相机类 {
public:
    外设线程_D455深度相机类();
    ~外设线程_D455深度相机类();

    外设线程_D455深度相机类(const 外设线程_D455深度相机类&) = delete;
    外设线程_D455深度相机类& operator=(const 外设线程_D455深度相机类&) = delete;

    bool 启动(const 结构_D455深度相机线程配置& 配置 = {});
    void 请求停止();
    void 等待停止();
    结构_D455深度相机线程结果 等待完成(std::chrono::milliseconds 等待上限);
    枚举_D455深度相机线程生命周期状态 读取生命周期状态() const noexcept;
    bool 是否运行中() const noexcept;
    结构_D455深度相机线程结果 读取最新结果() const;

private:
    std::shared_ptr<结构_D455线程共享状态> 状态_{};
    std::thread 工作线程_{};
};

export 外设线程_D455深度相机类& 获取全局外设线程_D455深度相机() noexcept;
export bool 启动外设线程_D455深度相机(const 结构_D455深度相机线程配置& 配置 = {});
export void 停止外设线程_D455深度相机();
export 结构_D455深度相机线程结果 读取外设线程_D455深度相机结果();

const char* D455深度相机线程生命周期文本(
    枚举_D455深度相机线程生命周期状态 状态) noexcept
{
    switch (状态) {
    case 枚举_D455深度相机线程生命周期状态::未启动: return "未启动";
    case 枚举_D455深度相机线程生命周期状态::启动中: return "启动中";
    case 枚举_D455深度相机线程生命周期状态::运行中: return "运行中";
    case 枚举_D455深度相机线程生命周期状态::停止请求中: return "停止请求中";
    case 枚举_D455深度相机线程生命周期状态::已停止: return "已停止";
    case 枚举_D455深度相机线程生命周期状态::故障: return "故障";
    default: return "未知";
    }
}

struct 结构_D455线程共享状态 {
    mutable std::mutex 互斥{};
    std::condition_variable 条件{};
    结构_D455深度相机线程配置 配置{};
    枚举_D455深度相机线程生命周期状态 生命周期 =
        枚举_D455深度相机线程生命周期状态::未启动;
    bool 停止请求 = false;
    bool 已结束 = false;
    结构_D455深度相机线程结果 结果{};
    std::vector<结构_D455深度相机观察样本> 样本{};
};

namespace {
    constexpr const char* D455_外设ID = "双目相机/D455深度相机";

    struct 结构_D455跟踪稳定缓存项 {
        std::uint64_t 等待项ID = 0;
        std::string 跟踪种子{};
        bool 有最近中心 = false;
        std::int64_t 最近中心X = 0;
        std::int64_t 最近中心Y = 0;
        std::int64_t 最近中心Z = 0;
        std::int64_t 连续成功次数 = 0;
        std::int64_t 失败次数 = 0;
    };

    struct 结构_D455跨帧观察簇缓存项 {
        std::int64_t 跨帧簇ID = -1;
        bool 本帧已匹配 = false;
        std::int64_t 最近来源空间候选ID = -1;
        std::int64_t 最近像素数量 = 0;
        std::int64_t 最近中心X = 0;
        std::int64_t 最近中心Y = 0;
        std::int64_t 最近中心Z = 0;
        std::int64_t 最近投影中心X = 0;
        std::int64_t 最近投影中心Y = 0;
        std::int64_t 连续命中次数 = 0;
        std::int64_t 丢失次数 = 0;
    };

    std::mutex& D455_跟踪稳定缓存锁() noexcept
    {
        static std::mutex 锁;
        return 锁;
    }

    std::vector<结构_D455跟踪稳定缓存项>& D455_跟踪稳定缓存() noexcept
    {
        static std::vector<结构_D455跟踪稳定缓存项> 缓存;
        return 缓存;
    }

    void D455_清空跟踪稳定缓存()
    {
        std::lock_guard<std::mutex> 锁(D455_跟踪稳定缓存锁());
        D455_跟踪稳定缓存().clear();
    }

    结构_D455跟踪稳定缓存项& D455_确保跟踪稳定缓存项_已加锁(
        const 结构_外设观察等待项& 等待项)
    {
        auto& 缓存 = D455_跟踪稳定缓存();
        for (auto& 项 : 缓存) {
            if (项.等待项ID == 等待项.等待项ID
                && 项.跟踪种子 == 等待项.目标区域或目标簇) {
                return 项;
            }
        }

        结构_D455跟踪稳定缓存项 新项{};
        新项.等待项ID = 等待项.等待项ID;
        新项.跟踪种子 = 等待项.目标区域或目标簇;
        缓存.push_back(std::move(新项));
        return 缓存.back();
    }

    std::mutex& D455_跨帧观察簇缓存锁() noexcept
    {
        static std::mutex 锁;
        return 锁;
    }

    std::vector<结构_D455跨帧观察簇缓存项>& D455_跨帧观察簇缓存() noexcept
    {
        static std::vector<结构_D455跨帧观察簇缓存项> 缓存;
        return 缓存;
    }

    std::int64_t& D455_下一跨帧观察簇ID() noexcept
    {
        static std::int64_t 下一个ID = 0;
        return 下一个ID;
    }

    void D455_清空跨帧观察簇缓存()
    {
        std::lock_guard<std::mutex> 锁(D455_跨帧观察簇缓存锁());
        D455_跨帧观察簇缓存().clear();
        D455_下一跨帧观察簇ID() = 0;
    }

    std::int64_t D455_I64绝对差(std::int64_t 左, std::int64_t 右) noexcept
    {
        return 左 >= 右 ? 左 - 右 : 右 - 左;
    }

    std::int64_t D455_计数容差(std::int64_t 基准) noexcept
    {
        const auto 正基准 = 基准 >= 0 ? 基准 : -基准;
        return (std::max<std::int64_t>)(5, 正基准 / 20);
    }

    std::int64_t D455_投影中心X(const 结构_外设观察像素簇摘要& 簇) noexcept
    {
        return (簇.投影最小X + 簇.投影最大X) / 2;
    }

    std::int64_t D455_投影中心Y(const 结构_外设观察像素簇摘要& 簇) noexcept
    {
        return (簇.投影最小Y + 簇.投影最大Y) / 2;
    }

    bool D455_观察簇投影有效(
        const 结构_外设观察像素簇摘要& 簇,
        std::int64_t 帧宽度,
        std::int64_t 帧高度) noexcept
    {
        return 帧宽度 > 0
            && 帧高度 > 0
            && 簇.像素数量 > 0
            && 簇.投影最小X >= 0
            && 簇.投影最小Y >= 0
            && 簇.投影最大X >= 簇.投影最小X
            && 簇.投影最大Y >= 簇.投影最小Y
            && 簇.投影最大X < 帧宽度
            && 簇.投影最大Y < 帧高度;
    }

    std::string D455_构造观察簇资源句柄(
        const char* 资源类型,
        const 双目相机本能适配器::调用结果& 来源,
        const 双目相机本能适配器::空间候选摘要& 候选)
    {
        std::ostringstream 输出;
        输出 << "d455://"
            << (资源类型 ? 资源类型 : "unknown")
            << "/depth-" << 来源.深度帧号
            << "/color-" << 来源.彩色帧号
            << "/candidate-" << 候选.候选编号
            << "?bbox="
            << 候选.投影最小X << ','
            << 候选.投影最小Y << ','
            << 候选.投影最大X << ','
            << 候选.投影最大Y;
        return 输出.str();
    }

    std::string D455_构造观察帧资源句柄(
        const char* 资源类型,
        const 双目相机本能适配器::调用结果& 来源)
    {
        std::ostringstream 输出;
        输出 << "d455://"
            << (资源类型 ? 资源类型 : "frame")
            << "/depth-" << 来源.深度帧号
            << "/color-" << 来源.彩色帧号
            << "?timestamp-us=" << 来源.系统到达时间_us;
        return 输出.str();
    }

    bool D455_跨帧簇可匹配(
        const 结构_D455跨帧观察簇缓存项& 缓存项,
        const 结构_外设观察像素簇摘要& 簇,
        std::int64_t* 输出分值) noexcept
    {
        const auto 中心X差 = D455_I64绝对差(缓存项.最近中心X, 簇.中心X);
        const auto 中心Y差 = D455_I64绝对差(缓存项.最近中心Y, 簇.中心Y);
        const auto 中心Z差 = D455_I64绝对差(缓存项.最近中心Z, 簇.中心Z);
        const auto 投影X差 = D455_I64绝对差(缓存项.最近投影中心X, D455_投影中心X(簇));
        const auto 投影Y差 = D455_I64绝对差(缓存项.最近投影中心Y, D455_投影中心Y(簇));
        const auto 像素差 = D455_I64绝对差(缓存项.最近像素数量, 簇.像素数量);
        const auto 像素容差 = (std::max<std::int64_t>)(
            96,
            (std::max<std::int64_t>)(缓存项.最近像素数量, 簇.像素数量) * 3 / 4);

        const bool 可匹配 = 中心X差 <= 450
            && 中心Y差 <= 450
            && 中心Z差 <= 650
            && 投影X差 <= 160
            && 投影Y差 <= 160
            && 像素差 <= 像素容差;
        if (输出分值) {
            *输出分值 = 中心X差
                + 中心Y差
                + 中心Z差
                + 投影X差 * 3
                + 投影Y差 * 3
                + 像素差 / 4;
        }
        return 可匹配;
    }

    void D455_写入跨帧簇缓存项(
        结构_D455跨帧观察簇缓存项& 缓存项,
        const 结构_外设观察像素簇摘要& 簇) noexcept
    {
        缓存项.最近来源空间候选ID = 簇.来源空间候选ID;
        缓存项.最近像素数量 = 簇.像素数量;
        缓存项.最近中心X = 簇.中心X;
        缓存项.最近中心Y = 簇.中心Y;
        缓存项.最近中心Z = 簇.中心Z;
        缓存项.最近投影中心X = D455_投影中心X(簇);
        缓存项.最近投影中心Y = D455_投影中心Y(簇);
    }

    void D455_更新逐簇识别报告跨帧采集状态(结构_外设观察报告队列项* 报告)
    {
        if (!报告 || 报告->报告类型 != 枚举_外设观察报告类型::逐簇识别报告) {
            return;
        }

        std::lock_guard<std::mutex> 锁(D455_跨帧观察簇缓存锁());
        auto& 缓存 = D455_跨帧观察簇缓存();
        for (auto& 项 : 缓存) {
            项.本帧已匹配 = false;
        }

        std::int64_t 匹配数量 = 0;
        std::int64_t 新建数量 = 0;
        std::int64_t 稳定数量 = 0;
        for (auto& 簇 : 报告->观察像素簇集合) {
            结构_D455跨帧观察簇缓存项* 最佳项 = nullptr;
            std::int64_t 最佳分值 = 0;
            bool 已有分值 = false;
            for (auto& 项 : 缓存) {
                if (项.本帧已匹配 || 项.丢失次数 > 3) {
                    continue;
                }
                std::int64_t 分值 = 0;
                if (!D455_跨帧簇可匹配(项, 簇, &分值)) {
                    continue;
                }
                if (!已有分值 || 分值 < 最佳分值) {
                    最佳项 = &项;
                    最佳分值 = 分值;
                    已有分值 = true;
                }
            }

            if (!最佳项) {
                结构_D455跨帧观察簇缓存项 新项{};
                新项.跨帧簇ID = D455_下一跨帧观察簇ID()++;
                新项.本帧已匹配 = true;
                新项.连续命中次数 = 1;
                D455_写入跨帧簇缓存项(新项, 簇);
                缓存.push_back(新项);
                最佳项 = &缓存.back();
                ++新建数量;
            } else {
                最佳项->本帧已匹配 = true;
                ++最佳项->连续命中次数;
                最佳项->丢失次数 = 0;
                D455_写入跨帧簇缓存项(*最佳项, 簇);
                ++匹配数量;
            }

            簇.外设跨帧簇ID = 最佳项->跨帧簇ID;
            簇.外设内部簇ID = 最佳项->跨帧簇ID;
            簇.跨帧匹配状态 = 最佳项->连续命中次数 >= 2 ? 1 : 0;
            簇.跨帧连续命中次数 = 最佳项->连续命中次数;
            簇.跨帧丢失次数 = 最佳项->丢失次数;
            簇.跨帧复现离散度 = 已有分值 ? 最佳分值 : 0;
            if (簇.跨帧连续命中次数 >= 2) {
                ++稳定数量;
            }
        }

        std::int64_t 丢失数量 = 0;
        for (auto& 项 : 缓存) {
            if (!项.本帧已匹配) {
                ++项.丢失次数;
                项.连续命中次数 = 0;
                ++丢失数量;
            }
        }
        缓存.erase(
            std::remove_if(
                缓存.begin(),
                缓存.end(),
                [](const auto& 项) noexcept {
                    return 项.丢失次数 > 5;
                }),
            缓存.end());

        报告->跨帧采集状态 = 1;
        报告->跨帧匹配观察像素簇数量 = 匹配数量;
        报告->跨帧新建观察像素簇数量 = 新建数量;
        报告->跨帧稳定观察像素簇数量 = 稳定数量;
        报告->跨帧丢失观察像素簇数量 = 丢失数量;
        std::ostringstream 摘要;
        摘要 << "匹配=" << 匹配数量
            << ";新建=" << 新建数量
            << ";稳定=" << 稳定数量
            << ";丢失=" << 丢失数量;
        报告->跨帧采集摘要 = 摘要.str();
    }

    void D455_把跨帧采集摘要写入样本(
        const 结构_外设观察报告队列项& 报告,
        结构_D455深度相机观察样本* 样本) noexcept
    {
        if (!样本 || 报告.跨帧采集状态 <= 0) {
            return;
        }
        样本->跨帧采集可用 = true;
        样本->跨帧匹配簇数量 = 报告.跨帧匹配观察像素簇数量;
        样本->跨帧新建簇数量 = 报告.跨帧新建观察像素簇数量;
        样本->跨帧稳定簇数量 = 报告.跨帧稳定观察像素簇数量;
        样本->跨帧丢失簇数量 = 报告.跨帧丢失观察像素簇数量;
        const auto 主簇 = std::max_element(
            报告.观察像素簇集合.begin(),
            报告.观察像素簇集合.end(),
            [](const auto& 左, const auto& 右) noexcept {
                return 左.像素数量 < 右.像素数量;
            });
        if (主簇 != 报告.观察像素簇集合.end()) {
            样本->主候选跨帧簇ID = 主簇->外设跨帧簇ID;
            样本->主候选跨帧连续命中次数 = 主簇->跨帧连续命中次数;
            样本->主候选跨帧复现离散度 = 主簇->跨帧复现离散度;
        }
    }

    结构_D455深度相机观察样本 D455_从调用结果生成样本(
        std::uint64_t 序号,
        const 双目相机本能适配器::调用结果& 来源)
    {
        结构_D455深度相机观察样本 样本{};
        样本.序号 = 序号;
        样本.采集成功 = 来源.成功;
        样本.相机已打开 = 来源.相机已打开;
        样本.失败原因 = static_cast<std::uint8_t>(来源.原因);
        样本.消息 = 来源.消息;
        样本.帧宽度 = 来源.宽度;
        样本.帧高度 = 来源.高度;
        样本.深度帧号 = 来源.深度帧号;
        样本.彩色帧号 = 来源.彩色帧号;
        样本.预期像素数量 = 来源.预期像素数量;
        样本.像素特征数量 = 来源.像素特征数量;
        样本.深度有效像素数量 = 来源.深度有效像素数量;
        样本.点云有效像素数量 = 来源.点云有效像素数量;
        样本.深度有效率 = 来源.深度有效率;
        样本.空间坐标有效率 = 来源.空间坐标有效率;
        样本.帧质量评分 = 来源.帧质量评分;
        样本.空间候选数量 = 来源.空间候选数量;

        if (!来源.空间候选列表.empty()) {
            const auto 主候选 = std::max_element(
                来源.空间候选列表.begin(),
                来源.空间候选列表.end(),
                [](const auto& 左, const auto& 右) noexcept {
                    return 左.像素数量 < 右.像素数量;
                });
            if (主候选 != 来源.空间候选列表.end()) {
                样本.主候选编号 = 主候选->候选编号;
                样本.主候选像素数量 = 主候选->像素数量;
                样本.中心X = 主候选->中心X;
                样本.中心Y = 主候选->中心Y;
                样本.中心Z = 主候选->中心Z;
                样本.范围稳定性评分 = 主候选->范围稳定性评分;
            }
        }

        样本.基础特征可比 = 样本.采集成功
            && 样本.帧宽度 > 0
            && 样本.帧高度 > 0
            && 样本.预期像素数量 > 0
            && 样本.像素特征数量 > 0;
        return 样本;
    }

    结构_外设观察报告队列项 D455_从调用结果生成逐簇识别报告(
        const 双目相机本能适配器::调用结果& 来源)
    {
        结构_外设观察报告队列项 报告{};
        报告.来源外设 = D455_外设ID;
        报告.观察运行模式 = 枚举_外设观察运行模式::陌生环境逐簇识别;
        报告.报告类型 = 枚举_外设观察报告类型::逐簇识别报告;
        报告.时间戳毫秒 = 来源.系统到达时间_us > 0
            ? static_cast<std::int64_t>(来源.系统到达时间_us / 1000)
            : 0;
        报告.采集成功 = 来源.成功;
        报告.配置摘要 = "D455默认采集配置;外设线程内部工程代码生成逐簇识别报告";
        报告.失败原因 = 来源.成功 ? "" : 来源.消息;
        报告.帧宽度 = 来源.宽度;
        报告.帧高度 = 来源.高度;
        报告.深度帧号 = 来源.深度帧号;
        报告.彩色帧号 = 来源.彩色帧号;
        报告.原始观察帧句柄 = D455_构造观察帧资源句柄("raw-observation-frame", 来源);
        报告.深度帧句柄 = D455_构造观察帧资源句柄("depth-frame", 来源);
        报告.彩色帧句柄 = D455_构造观察帧资源句柄("color-frame", 来源);
        报告.对齐帧句柄 = D455_构造观察帧资源句柄("aligned-depth-color-frame", 来源);
        报告.空间候选队列引用 = D455_构造观察帧资源句柄("spatial-candidate-queue", 来源);
        报告.像素归属账本引用 = D455_构造观察帧资源句柄("pixel-attribution-ledger-input", 来源);
        报告.相机内参版本 = "D455默认内参";
        报告.相机外参版本 = "D455默认外参";
        报告.坐标系版本 = "D455相机坐标系/v1";
        报告.报告生成方法ID = "D455_从调用结果生成逐簇识别报告";
        报告.报告生成方法版本 = "20260530-C5-证据引用";
        报告.报告置信度 = 来源.成功 ? 来源.帧质量评分 : 0;
        报告.预期像素数量 = 来源.预期像素数量;
        报告.像素特征数量 = 来源.像素特征数量;
        报告.深度有效率 = 来源.深度有效率;
        报告.空间坐标有效率 = 来源.空间坐标有效率;
        报告.帧质量评分 = 来源.帧质量评分;
        报告.低质量区域数量 = 来源.诊断区域数量;
        报告.未归簇区域数量 = 来源.条件不足候选数量 + 来源.待验证候选数量;
        报告.不可观测区域数量 = 来源.深度空洞区域数量;
        报告.未解释区域比例 = 来源.未解释区域比例;

        报告.观察像素簇集合.reserve(来源.空间候选列表.size());
        for (const auto& 候选 : 来源.空间候选列表) {
            结构_外设观察像素簇摘要 簇{};
            簇.外设内部簇ID = 候选.候选编号;
            簇.来源空间候选ID = 候选.候选编号;
            簇.像素数量 = 候选.像素数量;
            簇.投影最小X = 候选.投影最小X;
            簇.投影最大X = 候选.投影最大X;
            簇.投影最小Y = 候选.投影最小Y;
            簇.投影最大Y = 候选.投影最大Y;
            簇.中心X = 候选.中心X;
            簇.中心Y = 候选.中心Y;
            簇.中心Z = 候选.中心Z;
            簇.空间范围最小X = 候选.范围最小X;
            簇.空间范围最大X = 候选.范围最大X;
            簇.空间范围最小Y = 候选.范围最小Y;
            簇.空间范围最大Y = 候选.范围最大Y;
            簇.空间范围最小Z = 候选.范围最小Z;
            簇.空间范围最大Z = 候选.范围最大Z;
            簇.深度有效率 = 候选.有效点比例;
            簇.空间坐标有效率 = 候选.有效点比例;
            簇.空间连续性评分 = 候选.空间连续性评分;
            簇.范围稳定性评分 = 候选.范围稳定性评分;
            簇.轮廓置信度 = 候选.轮廓置信度;
            簇.局部图宽度 = 候选.投影最大X >= 候选.投影最小X
                ? 候选.投影最大X - 候选.投影最小X + 1
                : 0;
            簇.局部图高度 = 候选.投影最大Y >= 候选.投影最小Y
                ? 候选.投影最大Y - 候选.投影最小Y + 1
                : 0;
            簇.ROI引用 = D455_构造观察簇资源句柄(
                "cluster-roi",
                来源,
                候选);
            簇.点集引用 = D455_构造观察簇资源句柄(
                "cluster-point-set",
                来源,
                候选);
            簇.空间候选引用 = D455_构造观察簇资源句柄(
                "spatial-candidate",
                来源,
                候选);
            簇.像素归属验证材料引用 = D455_构造观察簇资源句柄(
                "pixel-attribution-material",
                来源,
                候选);
            if (D455_观察簇投影有效(簇, 来源.宽度, 来源.高度)) {
                簇.像素集合掩码状态 = 1;
                簇.彩色轮廓局部图状态 = 1;
                簇.深度轮廓局部图状态 = 1;
                簇.像素集合掩码句柄 = D455_构造观察簇资源句柄(
                    "cluster-mask",
                    来源,
                    候选);
                簇.彩色轮廓局部图句柄 = D455_构造观察簇资源句柄(
                    "color-crop",
                    来源,
                    候选);
                簇.深度轮廓局部图句柄 = D455_构造观察簇资源句柄(
                    "depth-crop",
                    来源,
                    候选);
            } else {
                簇.像素集合掩码状态 = 0;
                簇.彩色轮廓局部图状态 = 0;
                簇.深度轮廓局部图状态 = 0;
                簇.失败原因 = "观察像素簇投影边界无效，无法建立掩码或局部图句柄";
            }
            报告.观察像素簇集合.push_back(std::move(簇));
        }
        return 报告;
    }

    void D455_复制观察报告帧摘要(
        const 结构_外设观察报告队列项& 来源,
        结构_外设观察报告队列项* 输出) noexcept
    {
        if (!输出) {
            return;
        }
        输出->时间戳毫秒 = 来源.时间戳毫秒;
        输出->采集成功 = 来源.采集成功;
        输出->帧宽度 = 来源.帧宽度;
        输出->帧高度 = 来源.帧高度;
        输出->深度帧号 = 来源.深度帧号;
        输出->彩色帧号 = 来源.彩色帧号;
        输出->原始观察帧句柄 = 来源.原始观察帧句柄;
        输出->深度帧句柄 = 来源.深度帧句柄;
        输出->彩色帧句柄 = 来源.彩色帧句柄;
        输出->对齐帧句柄 = 来源.对齐帧句柄;
        输出->空间候选队列引用 = 来源.空间候选队列引用;
        输出->像素归属账本引用 = 来源.像素归属账本引用;
        输出->相机内参版本 = 来源.相机内参版本;
        输出->相机外参版本 = 来源.相机外参版本;
        输出->坐标系版本 = 来源.坐标系版本;
        输出->报告生成方法ID = 来源.报告生成方法ID;
        输出->报告生成方法版本 = 来源.报告生成方法版本;
        输出->报告置信度 = 来源.报告置信度;
        输出->预期像素数量 = 来源.预期像素数量;
        输出->像素特征数量 = 来源.像素特征数量;
        输出->深度有效率 = 来源.深度有效率;
        输出->空间坐标有效率 = 来源.空间坐标有效率;
        输出->帧质量评分 = 来源.帧质量评分;
        输出->低质量区域数量 = 来源.低质量区域数量;
        输出->未归簇区域数量 = 来源.未归簇区域数量;
        输出->不可观测区域数量 = 来源.不可观测区域数量;
        输出->未解释区域比例 = 来源.未解释区域比例;
        输出->跨帧采集状态 = 来源.跨帧采集状态;
        输出->跨帧匹配观察像素簇数量 = 来源.跨帧匹配观察像素簇数量;
        输出->跨帧新建观察像素簇数量 = 来源.跨帧新建观察像素簇数量;
        输出->跨帧稳定观察像素簇数量 = 来源.跨帧稳定观察像素簇数量;
        输出->跨帧丢失观察像素簇数量 = 来源.跨帧丢失观察像素簇数量;
        输出->跨帧采集摘要 = 来源.跨帧采集摘要;
    }

    const 结构_外设观察像素簇摘要* D455_按簇ID查找观察像素簇(
        const std::vector<结构_外设观察像素簇摘要>& 簇集合,
        std::int64_t 簇ID) noexcept
    {
        for (const auto& 簇 : 簇集合) {
            if (簇.外设内部簇ID == 簇ID || 簇.来源空间候选ID == 簇ID) {
                return &簇;
            }
        }
        return nullptr;
    }

    const 结构_外设观察像素簇摘要* D455_按跨帧簇ID查找观察像素簇(
        const std::vector<结构_外设观察像素簇摘要>& 簇集合,
        std::int64_t 跨帧簇ID) noexcept
    {
        if (跨帧簇ID < 0) {
            return nullptr;
        }
        for (const auto& 簇 : 簇集合) {
            if (簇.外设跨帧簇ID == 跨帧簇ID
                || 簇.外设内部簇ID == 跨帧簇ID) {
                return &簇;
            }
        }
        return nullptr;
    }

    bool D455_观察像素簇存在明显变化(
        const 结构_外设观察像素簇摘要& 当前,
        const 结构_外设观察像素簇摘要& 基准) noexcept
    {
        if (当前.外设跨帧簇ID >= 0
            && 当前.外设跨帧簇ID == 基准.外设跨帧簇ID
            && 当前.跨帧匹配状态 > 0
            && 当前.跨帧连续命中次数 >= 2) {
            return false;
        }
        return D455_I64绝对差(当前.中心X, 基准.中心X) > 30
            || D455_I64绝对差(当前.中心Y, 基准.中心Y) > 30
            || D455_I64绝对差(当前.中心Z, 基准.中心Z) > 50
            || D455_I64绝对差(当前.像素数量, 基准.像素数量) > D455_计数容差(基准.像素数量)
            || D455_I64绝对差(当前.轮廓置信度, 基准.轮廓置信度) > 1500;
    }

    bool D455_文本包含线索(const std::string& 文本, const char* 线索) noexcept
    {
        return 线索 && *线索 && 文本.find(线索) != std::string::npos;
    }

    bool D455_扫描变化等待项前置满足(const 结构_外设观察等待项& 等待项) noexcept
    {
        return !等待项.目标区域或目标簇.empty()
            || D455_文本包含线索(等待项.质量要求摘要, "基准")
            || D455_文本包含线索(等待项.质量要求摘要, "已确认")
            || D455_文本包含线索(等待项.质量要求摘要, "已识别");
    }

    bool D455_目标跟踪等待项前置满足(const 结构_外设观察等待项& 等待项) noexcept
    {
        return !等待项.目标区域或目标簇.empty();
    }

    结构_外设观察报告队列项 D455_从逐簇识别报告生成扫描变化报告(
        const 结构_外设观察报告队列项& 当前逐簇识别报告,
        const std::optional<结构_外设观察报告队列项>& 基准逐簇识别报告,
        const 结构_外设观察等待项& 等待项)
    {
        结构_外设观察报告队列项 报告{};
        报告.对应命令ID = 等待项.等待项ID;
        报告.匹配等待项ID = 等待项.等待项ID;
        报告.来源外设 = D455_外设ID;
        报告.观察运行模式 = 枚举_外设观察运行模式::已识别场景扫描变化;
        报告.报告类型 = 枚举_外设观察报告类型::扫描变化报告;
        报告.配置摘要 = "D455默认采集配置;外设线程内部工程代码由逐簇识别材料生成扫描变化报告";
        D455_复制观察报告帧摘要(当前逐簇识别报告, &报告);
        报告.观察像素簇集合 = 当前逐簇识别报告.观察像素簇集合;
        报告.高风险未知区域数量 =
            当前逐簇识别报告.低质量区域数量 + 当前逐簇识别报告.未归簇区域数量;

        if (!基准逐簇识别报告.has_value()) {
            报告.新增观察像素簇数量 =
                static_cast<std::int64_t>(当前逐簇识别报告.观察像素簇集合.size());
            报告.差异摘要 = "缺少上一帧逐簇识别基准;当前扫描变化报告仅建立首帧基准";
            return 报告;
        }

        const auto& 基准 = *基准逐簇识别报告;
        for (const auto& 当前簇 : 当前逐簇识别报告.观察像素簇集合) {
            const auto* 基准簇 = D455_按跨帧簇ID查找观察像素簇(
                基准.观察像素簇集合,
                当前簇.外设跨帧簇ID);
            if (!基准簇) {
                ++报告.新增观察像素簇数量;
            } else if (D455_观察像素簇存在明显变化(当前簇, *基准簇)) {
                ++报告.变化观察像素簇数量;
            }
        }
        for (const auto& 基准簇 : 基准.观察像素簇集合) {
            if (!D455_按跨帧簇ID查找观察像素簇(
                    当前逐簇识别报告.观察像素簇集合,
                    基准簇.外设跨帧簇ID)) {
                ++报告.消失观察像素簇数量;
            }
        }

        std::ostringstream 摘要;
        摘要 << "新增=" << 报告.新增观察像素簇数量
            << ";消失=" << 报告.消失观察像素簇数量
            << ";变化=" << 报告.变化观察像素簇数量
            << ";高风险未知=" << 报告.高风险未知区域数量;
        报告.差异摘要 = 摘要.str();
        return 报告;
    }

    bool D455_尝试解析跟踪种子簇ID(
        const std::string& 文本,
        std::int64_t* 输出簇ID) noexcept
    {
        if (!输出簇ID) {
            return false;
        }

        bool 已见数字 = false;
        bool 负号 = false;
        std::int64_t 值 = 0;
        for (std::size_t 索引 = 0; 索引 < 文本.size(); ++索引) {
            const char 字符 = 文本[索引];
            if (!已见数字 && 字符 == '-') {
                负号 = true;
                continue;
            }
            if (字符 < '0' || 字符 > '9') {
                if (已见数字) {
                    break;
                }
                负号 = false;
                continue;
            }
            已见数字 = true;
            值 = 值 * 10 + static_cast<std::int64_t>(字符 - '0');
        }

        if (!已见数字) {
            return false;
        }
        *输出簇ID = 负号 ? -值 : 值;
        return true;
    }

    void D455_记录跟踪失败到缓存(
        const 结构_外设观察等待项& 等待项,
        结构_外设观察报告队列项* 报告)
    {
        if (!报告) {
            return;
        }

        std::lock_guard<std::mutex> 锁(D455_跟踪稳定缓存锁());
        auto& 缓存项 = D455_确保跟踪稳定缓存项_已加锁(等待项);
        缓存项.连续成功次数 = 0;
        ++缓存项.失败次数;
        报告->连续成功次数 = 0;
        报告->失败次数 = 缓存项.失败次数;
        报告->稳定特征样本数量 = 0;
    }

    void D455_记录跟踪成功到缓存(
        const 结构_外设观察等待项& 等待项,
        const 结构_外设观察像素簇摘要& 命中簇,
        结构_外设观察报告队列项* 报告)
    {
        if (!报告) {
            return;
        }

        std::lock_guard<std::mutex> 锁(D455_跟踪稳定缓存锁());
        auto& 缓存项 = D455_确保跟踪稳定缓存项_已加锁(等待项);
        const bool 有上一帧 = 缓存项.有最近中心;
        const auto 坐标离散度 = 有上一帧
            ? (std::max<std::int64_t>)(
                D455_I64绝对差(缓存项.最近中心X, 命中簇.中心X),
                (std::max<std::int64_t>)(
                    D455_I64绝对差(缓存项.最近中心Y, 命中簇.中心Y),
                    D455_I64绝对差(缓存项.最近中心Z, 命中簇.中心Z)))
            : 0;

        缓存项.有最近中心 = true;
        缓存项.最近中心X = 命中簇.中心X;
        缓存项.最近中心Y = 命中簇.中心Y;
        缓存项.最近中心Z = 命中簇.中心Z;
        ++缓存项.连续成功次数;

        报告->连续成功次数 = 缓存项.连续成功次数;
        报告->失败次数 = 缓存项.失败次数;
        报告->空间坐标复现离散度 = 坐标离散度;
        报告->距离复现离散度 = 坐标离散度;
        报告->稳定特征样本数量 = 缓存项.连续成功次数;
        报告->跟踪状态值 =
            有上一帧
                && 缓存项.连续成功次数 >= 2
                && 坐标离散度 <= 150
                && 命中簇.深度有效率 >= 5000
                && 命中簇.空间坐标有效率 >= 5000
            ? 1
            : 0;
        if (报告->跟踪状态值 == 0) {
            报告->失败原因 = 有上一帧
                ? "目标簇已重见，但复现离散度或质量尚未达标"
                : "目标簇已重见，但连续样本不足以判定稳定";
        }
    }

    结构_外设观察报告队列项 D455_从逐簇识别报告生成跟踪报告(
        const 结构_外设观察报告队列项& 逐簇识别报告,
        const 结构_外设观察等待项& 等待项)
    {
        结构_外设观察报告队列项 报告{};
        报告.对应命令ID = 等待项.等待项ID;
        报告.匹配等待项ID = 等待项.等待项ID;
        报告.来源外设 = D455_外设ID;
        报告.观察运行模式 = 枚举_外设观察运行模式::目标跟踪观察;
        报告.报告类型 = 枚举_外设观察报告类型::跟踪报告;
        报告.配置摘要 = "D455默认采集配置;外设线程内部工程代码由逐簇识别材料生成跟踪报告草案";
        D455_复制观察报告帧摘要(逐簇识别报告, &报告);
        报告.跟踪ID = 等待项.等待项ID;
        报告.跟踪种子 = 等待项.目标区域或目标簇;

        std::int64_t 种子簇ID = 0;
        if (!D455_尝试解析跟踪种子簇ID(等待项.目标区域或目标簇, &种子簇ID)) {
            报告.采集成功 = false;
            报告.跟踪状态值 = 0;
            报告.丢失状态值 = 1;
            报告.失败次数 = 1;
            报告.重捕获候选数量 =
                static_cast<std::int64_t>(逐簇识别报告.观察像素簇集合.size());
            报告.失败原因 = "跟踪等待项缺少可解析观察像素簇ID种子";
            D455_记录跟踪失败到缓存(等待项, &报告);
            return 报告;
        }

        const 结构_外设观察像素簇摘要* 命中簇 = nullptr;
        for (const auto& 簇 : 逐簇识别报告.观察像素簇集合) {
            if (簇.外设内部簇ID == 种子簇ID
                || 簇.来源空间候选ID == 种子簇ID) {
                命中簇 = &簇;
                break;
            }
        }

        if (!命中簇) {
            报告.采集成功 = false;
            报告.跟踪状态值 = 0;
            报告.丢失状态值 = 1;
            报告.失败次数 = 1;
            报告.重捕获候选数量 =
                static_cast<std::int64_t>(逐簇识别报告.观察像素簇集合.size());
            报告.失败原因 = "当前逐簇识别材料未匹配到跟踪种子对应观察像素簇";
            D455_记录跟踪失败到缓存(等待项, &报告);
            return 报告;
        }

        报告.采集成功 = true;
        报告.丢失状态值 = 0;
        报告.最近观测年龄毫秒 = 0;
        报告.观察像素簇集合.push_back(*命中簇);
        D455_记录跟踪成功到缓存(等待项, *命中簇, &报告);
        return 报告;
    }

    bool D455_基础采样样本对稳定(
        const 结构_D455深度相机观察样本& 左,
        const 结构_D455深度相机观察样本& 右,
        std::string& 原因)
    {
        if (!左.基础特征可比 || !右.基础特征可比) {
            原因 = "基础观察特征不可比";
            return false;
        }
        if (左.帧宽度 != 右.帧宽度 || 左.帧高度 != 右.帧高度) {
            原因 = "帧尺寸不稳定";
            return false;
        }
        if (左.预期像素数量 != 右.预期像素数量
            || 左.像素特征数量 != 右.像素特征数量) {
            原因 = "像素特征数量不稳定";
            return false;
        }
        if (D455_I64绝对差(左.深度有效率, 右.深度有效率) > 500) {
            原因 = "深度有效率波动超过容差";
            return false;
        }
        if (D455_I64绝对差(左.空间坐标有效率, 右.空间坐标有效率) > 500) {
            原因 = "空间坐标有效率波动超过容差";
            return false;
        }
        if (D455_I64绝对差(左.帧质量评分, 右.帧质量评分) > 1000) {
            原因 = "帧质量评分波动超过容差";
            return false;
        }

        原因 = "稳定";
        return true;
    }

    bool D455_观察候选样本对稳定(
        const 结构_D455深度相机观察样本& 左,
        const 结构_D455深度相机观察样本& 右,
        std::string& 原因)
    {
        std::string 基础原因;
        if (!D455_基础采样样本对稳定(左, 右, 基础原因)) {
            原因 = "基础采样未稳定:" + 基础原因;
            return false;
        }
        if (左.跨帧采集可用 && 右.跨帧采集可用) {
            if (右.跨帧稳定簇数量 > 0) {
                原因 = "跨帧稳定观察簇可复现";
                return true;
            }
            if (左.主候选跨帧簇ID >= 0
                && 左.主候选跨帧簇ID == 右.主候选跨帧簇ID
                && 右.主候选跨帧连续命中次数 >= 2) {
                原因 = "主观察簇跨帧ID连续命中";
                return true;
            }
            原因 = "跨帧稳定观察簇数量不足";
            return false;
        }

        const auto 候选容差 = D455_计数容差(左.空间候选数量);
        if (D455_I64绝对差(左.空间候选数量, 右.空间候选数量) > 候选容差) {
            原因 = "空间候选数量不稳定";
            return false;
        }
        if ((左.空间候选数量 > 0) != (右.空间候选数量 > 0)) {
            原因 = "空间候选有无状态不稳定";
            return false;
        }
        if (左.空间候选数量 > 0 && 右.空间候选数量 > 0) {
            if (D455_I64绝对差(左.主候选像素数量, 右.主候选像素数量)
                > D455_计数容差(左.主候选像素数量)) {
                原因 = "主空间候选像素数量不稳定";
                return false;
            }
            if (D455_I64绝对差(左.中心X, 右.中心X) > 150
                || D455_I64绝对差(左.中心Y, 右.中心Y) > 150
                || D455_I64绝对差(左.中心Z, 右.中心Z) > 150) {
                原因 = "主空间候选中心坐标不稳定";
                return false;
            }
            if (D455_I64绝对差(左.范围稳定性评分, 右.范围稳定性评分) > 1000) {
                原因 = "空间范围稳定性评分波动超过容差";
                return false;
            }
        }

        原因 = "稳定";
        return true;
    }

    结构_D455深度相机线程结果 D455_评估稳定性(
        const std::vector<结构_D455深度相机观察样本>& 样本集合,
        枚举_D455深度相机线程生命周期状态 生命周期)
    {
        结构_D455深度相机线程结果 结果{};
        结果.生命周期 = 生命周期;
        结果.已启动 = 生命周期 != 枚举_D455深度相机线程生命周期状态::未启动;
        结果.已完成 = 生命周期 == 枚举_D455深度相机线程生命周期状态::已停止
            || 生命周期 == 枚举_D455深度相机线程生命周期状态::故障;
        结果.样本 = 样本集合;
        结果.样本数量 = static_cast<std::uint64_t>(样本集合.size());

        for (const auto& 样本 : 样本集合) {
            if (样本.基础特征可比) {
                ++结果.基础可比样本数量;
            }
        }
        for (std::size_t i = 1; i < 样本集合.size(); ++i) {
            std::string 基础原因;
            if (D455_基础采样样本对稳定(样本集合[i - 1], 样本集合[i], 基础原因)) {
                ++结果.基础采样稳定连接数量;
            } else {
                std::ostringstream 输出;
                输出 << "样本" << 样本集合[i - 1].序号
                    << "->" << 样本集合[i].序号
                    << ':' << 基础原因;
                结果.基础采样不稳定原因.push_back(输出.str());
            }

            std::string 候选原因;
            if (D455_观察候选样本对稳定(样本集合[i - 1], 样本集合[i], 候选原因)) {
                ++结果.观察候选稳定连接数量;
            } else {
                std::ostringstream 输出;
                输出 << "样本" << 样本集合[i - 1].序号
                    << "->" << 样本集合[i].序号
                    << ':' << 候选原因;
                结果.观察候选不稳定原因.push_back(输出.str());
            }
        }
        结果.稳定连接数量 = 结果.基础采样稳定连接数量;
        结果.不稳定原因 = 结果.基础采样不稳定原因;
        if (样本集合.size() >= 2) {
            std::string 最新基础原因;
            const bool 最新基础窗口稳定 = D455_基础采样样本对稳定(
                样本集合[样本集合.size() - 2],
                样本集合[样本集合.size() - 1],
                最新基础原因);
            std::string 最新候选原因;
            const bool 最新候选窗口稳定 = D455_观察候选样本对稳定(
                样本集合[样本集合.size() - 2],
                样本集合[样本集合.size() - 1],
                最新候选原因);
            结果.基础采样稳定 = 结果.基础可比样本数量 >= 2
                && 结果.基础采样稳定连接数量 >= 1
                && 最新基础窗口稳定;
            结果.观察候选稳定 = 结果.基础可比样本数量 >= 2
                && 结果.观察候选稳定连接数量 >= 1
                && 最新候选窗口稳定;
            结果.稳定 = 结果.基础采样稳定 && 结果.观察候选稳定;
        }
        return 结果;
    }

    void D455_写入状态结果(
        const std::shared_ptr<结构_D455线程共享状态>& 状态,
        枚举_D455深度相机线程生命周期状态 生命周期)
    {
        std::lock_guard<std::mutex> 锁(状态->互斥);
        状态->生命周期 = 生命周期;
        状态->结果 = D455_评估稳定性(状态->样本, 生命周期);
    }

    void D455_设置结束(
        const std::shared_ptr<结构_D455线程共享状态>& 状态,
        枚举_D455深度相机线程生命周期状态 生命周期)
    {
        {
            std::lock_guard<std::mutex> 锁(状态->互斥);
            状态->生命周期 = 生命周期;
            状态->已结束 = true;
            状态->结果 = D455_评估稳定性(状态->样本, 生命周期);
        }
        状态->条件.notify_all();
    }

    结构_D455深度相机线程结果 D455_读取结果(
        const std::shared_ptr<结构_D455线程共享状态>& 状态)
    {
        std::lock_guard<std::mutex> 锁(状态->互斥);
        return 状态->结果;
    }

    void D455_线程主循环(std::shared_ptr<结构_D455线程共享状态> 状态) noexcept
    {
        try {
            D455_写入状态结果(状态, 枚举_D455深度相机线程生命周期状态::启动中);
            项目运行日志("外设线程_D455深度相机/启动 | 目标=持续取得D455深度相机观察样本");
            D455_清空跟踪稳定缓存();
            D455_清空跨帧观察簇缓存();

            const auto 配置 = [&]() {
                std::lock_guard<std::mutex> 锁(状态->互斥);
                return 状态->配置;
            }();

            if (配置.启动时打开相机) {
                const auto 打开结果 = 双目相机本能适配器::打开();
                if (!打开结果.成功) {
                    auto 样本 = D455_从调用结果生成样本(0, 打开结果);
                    样本.消息 = "启动时打开相机失败: " + 打开结果.消息;
                    {
                        std::lock_guard<std::mutex> 锁(状态->互斥);
                        状态->样本.push_back(std::move(样本));
                    }
                    项目运行错误日志("外设线程_D455深度相机/打开失败 | 原因=" + 打开结果.消息);
                    D455_设置结束(状态, 枚举_D455深度相机线程生命周期状态::故障);
                    return;
                }
            }

            D455_写入状态结果(状态, 枚举_D455深度相机线程生命周期状态::运行中);

            std::uint64_t 序号 = 0;
            while (true) {
                {
                    std::lock_guard<std::mutex> 锁(状态->互斥);
                    if (状态->停止请求) {
                        break;
                    }
                    if (配置.目标样本数量 > 0 && 序号 >= 配置.目标样本数量) {
                        break;
                    }
                }

                ++序号;
                const auto 采集结果 = 双目相机本能适配器::采集一帧();
                std::optional<结构_外设观察报告队列项> 本帧逐簇识别报告{};
                if (采集结果.成功) {
                    const auto 上一逐簇识别报告 = 读取最新外设观察报告(
                        D455_外设ID,
                        枚举_外设观察报告类型::逐簇识别报告);
                    auto 逐簇识别报告 = D455_从调用结果生成逐簇识别报告(采集结果);
                    D455_更新逐簇识别报告跨帧采集状态(&逐簇识别报告);
                    const auto 报告ID = 提交外设观察报告(逐簇识别报告);
                    逐簇识别报告.报告ID = 报告ID;
                    const bool 材料页已提交 = 提交D455短期观察材料页(
                        报告ID,
                        采集结果,
                        逐簇识别报告);
                    本帧逐簇识别报告 = 逐簇识别报告;
                    项目运行日志(
                        "外设线程_D455深度相机/逐簇识别报告入队 | "
                        + 构造外设观察报告摘要(逐簇识别报告)
                        + " | 短期观察材料页提交="
                        + std::to_string(材料页已提交 ? 1 : 0));
                    const auto 扫描变化等待项集合 = 读取外设观察等待项集合(
                        D455_外设ID,
                        枚举_外设观察运行模式::已识别场景扫描变化);
                    for (const auto& 等待项 : 扫描变化等待项集合) {
                        if (!D455_扫描变化等待项前置满足(等待项)) {
                            项目运行日志(
                                "外设线程_D455深度相机/扫描变化报告跳过 | 原因=缺少已识别场景基准或目标区域 | "
                                + 构造外设观察等待项摘要(等待项));
                            continue;
                        }
                        auto 扫描变化报告 = D455_从逐簇识别报告生成扫描变化报告(
                            逐簇识别报告,
                            上一逐簇识别报告,
                            等待项);
                        const auto 扫描变化报告ID = 提交外设观察报告(扫描变化报告);
                        扫描变化报告.报告ID = 扫描变化报告ID;
                        项目运行日志(
                            "外设线程_D455深度相机/扫描变化报告入队 | "
                            + 构造外设观察报告摘要(扫描变化报告)
                            + " | 等待项ID="
                            + std::to_string(等待项.等待项ID));
                    }
                    const auto 跟踪等待项集合 = 读取外设观察等待项集合(
                        D455_外设ID,
                        枚举_外设观察运行模式::目标跟踪观察);
                    bool 本帧已生成主动跟踪报告 = false;
                    for (const auto& 等待项 : 跟踪等待项集合) {
                        if (!D455_目标跟踪等待项前置满足(等待项)) {
                            项目运行日志(
                                "外设线程_D455深度相机/跟踪报告跳过 | 原因=缺少目标种子 | "
                                + 构造外设观察等待项摘要(等待项));
                            continue;
                        }
                        if (本帧已生成主动跟踪报告) {
                            项目运行日志(
                                "外设线程_D455深度相机/跟踪报告跳过 | 原因=本帧已有主动目标跟踪报告 | "
                                + 构造外设观察等待项摘要(等待项));
                            continue;
                        }
                        auto 跟踪报告 = D455_从逐簇识别报告生成跟踪报告(逐簇识别报告, 等待项);
                        const auto 跟踪报告ID = 提交外设观察报告(跟踪报告);
                        跟踪报告.报告ID = 跟踪报告ID;
                        本帧已生成主动跟踪报告 = true;
                        项目运行日志(
                            "外设线程_D455深度相机/跟踪报告入队 | "
                            + 构造外设观察报告摘要(跟踪报告)
                            + " | 等待项ID="
                            + std::to_string(等待项.等待项ID));
                    }
                }
                auto 样本 = D455_从调用结果生成样本(序号, 采集结果);
                if (本帧逐簇识别报告.has_value()) {
                    D455_把跨帧采集摘要写入样本(*本帧逐簇识别报告, &样本);
                }
                项目运行日志("外设线程_D455深度相机/采样 | " + 构造D455深度相机观察样本摘要(样本));

                {
                    std::lock_guard<std::mutex> 锁(状态->互斥);
                    状态->样本.push_back(std::move(样本));
                    状态->结果 = D455_评估稳定性(
                        状态->样本,
                        枚举_D455深度相机线程生命周期状态::运行中);
                }

                std::unique_lock<std::mutex> 锁(状态->互斥);
                状态->条件.wait_for(
                    锁,
                    配置.采样间隔,
                    [&]() noexcept { return 状态->停止请求; });
            }

            if (配置.停止时释放相机) {
                (void)双目相机本能适配器::释放();
            }

            D455_设置结束(状态, 枚举_D455深度相机线程生命周期状态::已停止);
            const auto 最终结果 = D455_读取结果(状态);
            项目运行日志("外设线程_D455深度相机/停止 | " + 构造D455深度相机线程结果摘要(最终结果));
        } catch (const std::exception& 异常) {
            项目运行错误日志(std::string("外设线程_D455深度相机/异常 | 原因=") + 异常.what());
            {
                std::lock_guard<std::mutex> 锁(状态->互斥);
                状态->结果.不稳定原因.push_back(std::string("线程异常: ") + 异常.what());
            }
            D455_设置结束(状态, 枚举_D455深度相机线程生命周期状态::故障);
        } catch (...) {
            项目运行错误日志("外设线程_D455深度相机/未知异常");
            {
                std::lock_guard<std::mutex> 锁(状态->互斥);
                状态->结果.不稳定原因.push_back("线程未知异常");
            }
            D455_设置结束(状态, 枚举_D455深度相机线程生命周期状态::故障);
        }
    }
}

std::string 构造D455深度相机观察样本摘要(const 结构_D455深度相机观察样本& 样本)
{
    std::ostringstream 输出;
        输出 << "样本=" << 样本.序号
        << " | 成功=" << (样本.采集成功 ? 1 : 0)
        << " | 可比=" << (样本.基础特征可比 ? 1 : 0)
        << " | 帧=" << 样本.帧宽度 << 'x' << 样本.帧高度
        << " | 深度帧号=" << 样本.深度帧号
        << " | 彩色帧号=" << 样本.彩色帧号
        << " | 像素特征=" << 样本.像素特征数量
        << " | 预期像素=" << 样本.预期像素数量
        << " | 深度有效率=" << 样本.深度有效率
        << " | 空间坐标有效率=" << 样本.空间坐标有效率
        << " | 质量=" << 样本.帧质量评分
        << " | 空间候选=" << 样本.空间候选数量
        << " | 主候选=" << 样本.主候选编号
        << " | 主跨帧簇=" << 样本.主候选跨帧簇ID
        << " | 主候选像素=" << 样本.主候选像素数量
        << " | 中心=(" << 样本.中心X << ',' << 样本.中心Y << ',' << 样本.中心Z << ')'
        << " | 范围稳定性=" << 样本.范围稳定性评分
        << " | 跨帧匹配簇=" << 样本.跨帧匹配簇数量
        << " | 跨帧新建簇=" << 样本.跨帧新建簇数量
        << " | 跨帧稳定簇=" << 样本.跨帧稳定簇数量
        << " | 跨帧丢失簇=" << 样本.跨帧丢失簇数量
        << " | 主跨帧连续命中=" << 样本.主候选跨帧连续命中次数
        << " | 主跨帧复现离散度=" << 样本.主候选跨帧复现离散度;
    if (!样本.消息.empty()) {
        输出 << " | 消息=" << 样本.消息;
    }
    return 输出.str();
}

std::string 构造D455深度相机线程结果摘要(const 结构_D455深度相机线程结果& 结果)
{
    std::ostringstream 输出;
    输出 << "外设线程_D455深度相机"
        << " | 生命周期=" << D455深度相机线程生命周期文本(结果.生命周期)
        << " | 已启动=" << (结果.已启动 ? 1 : 0)
        << " | 已完成=" << (结果.已完成 ? 1 : 0)
        << " | 样本=" << 结果.样本数量
        << " | 可比样本=" << 结果.基础可比样本数量
        << " | 稳定连接=" << 结果.稳定连接数量
        << " | 基础采样稳定连接=" << 结果.基础采样稳定连接数量
        << " | 观察候选稳定连接=" << 结果.观察候选稳定连接数量
        << " | 基础采样稳定=" << (结果.基础采样稳定 ? "稳定" : "不稳定")
        << " | 观察候选稳定=" << (结果.观察候选稳定 ? "稳定" : "不稳定")
        << " | 综合稳定=" << (结果.稳定 ? "稳定" : "不稳定");
    if (!结果.不稳定原因.empty()) {
        输出 << " | 首个基础采样不稳定原因=" << 结果.不稳定原因.front();
    }
    if (!结果.观察候选不稳定原因.empty()) {
        输出 << " | 首个观察候选不稳定原因=" << 结果.观察候选不稳定原因.front();
    }
    return 输出.str();
}

外设线程_D455深度相机类::外设线程_D455深度相机类()
    : 状态_(std::make_shared<结构_D455线程共享状态>())
{
}

外设线程_D455深度相机类::~外设线程_D455深度相机类()
{
    请求停止();
    等待停止();
}

bool 外设线程_D455深度相机类::启动(const 结构_D455深度相机线程配置& 配置)
{
    if (工作线程_.joinable()) {
        return false;
    }

    状态_ = std::make_shared<结构_D455线程共享状态>();
    {
        std::lock_guard<std::mutex> 锁(状态_->互斥);
        状态_->配置 = 配置;
        状态_->生命周期 = 枚举_D455深度相机线程生命周期状态::启动中;
        状态_->结果.生命周期 = 枚举_D455深度相机线程生命周期状态::启动中;
        状态_->结果.已启动 = true;
    }
    auto 共享状态 = 状态_;
    工作线程_ = std::thread([共享状态]() noexcept {
        D455_线程主循环(共享状态);
    });
    return true;
}

void 外设线程_D455深度相机类::请求停止()
{
    if (!状态_) {
        return;
    }
    {
        std::lock_guard<std::mutex> 锁(状态_->互斥);
        if (!状态_->已结束) {
            状态_->停止请求 = true;
            状态_->生命周期 = 枚举_D455深度相机线程生命周期状态::停止请求中;
            状态_->结果.生命周期 = 状态_->生命周期;
        }
    }
    状态_->条件.notify_all();
}

void 外设线程_D455深度相机类::等待停止()
{
    if (工作线程_.joinable()) {
        工作线程_.join();
    }
}

结构_D455深度相机线程结果 外设线程_D455深度相机类::等待完成(
    std::chrono::milliseconds 等待上限)
{
    if (!状态_) {
        return {};
    }

    {
        std::unique_lock<std::mutex> 锁(状态_->互斥);
        if (!状态_->条件.wait_for(锁, 等待上限, [&]() noexcept { return 状态_->已结束; })) {
            状态_->停止请求 = true;
            状态_->生命周期 = 枚举_D455深度相机线程生命周期状态::停止请求中;
            状态_->结果 = D455_评估稳定性(状态_->样本, 状态_->生命周期);
            状态_->结果.不稳定原因.push_back("外设线程_D455深度相机等待超时");
            auto 超时结果 = 状态_->结果;
            状态_->条件.notify_all();
            if (工作线程_.joinable()) {
                工作线程_.detach();
            }
            项目运行警告日志(
                "外设线程_D455深度相机/等待超时 | 等待毫秒="
                + std::to_string(等待上限.count()));
            return 超时结果;
        }
    }

    等待停止();
    return 读取最新结果();
}

枚举_D455深度相机线程生命周期状态
外设线程_D455深度相机类::读取生命周期状态() const noexcept
{
    if (!状态_) {
        return 枚举_D455深度相机线程生命周期状态::未启动;
    }
    std::lock_guard<std::mutex> 锁(状态_->互斥);
    return 状态_->生命周期;
}

bool 外设线程_D455深度相机类::是否运行中() const noexcept
{
    const auto 状态 = 读取生命周期状态();
    return 状态 == 枚举_D455深度相机线程生命周期状态::启动中
        || 状态 == 枚举_D455深度相机线程生命周期状态::运行中
        || 状态 == 枚举_D455深度相机线程生命周期状态::停止请求中;
}

结构_D455深度相机线程结果 外设线程_D455深度相机类::读取最新结果() const
{
    if (!状态_) {
        return {};
    }
    std::lock_guard<std::mutex> 锁(状态_->互斥);
    return 状态_->结果;
}

外设线程_D455深度相机类& 获取全局外设线程_D455深度相机() noexcept
{
    static 外设线程_D455深度相机类 线程;
    return 线程;
}

bool 启动外设线程_D455深度相机(const 结构_D455深度相机线程配置& 配置)
{
    return 获取全局外设线程_D455深度相机().启动(配置);
}

void 停止外设线程_D455深度相机()
{
    auto& 线程 = 获取全局外设线程_D455深度相机();
    线程.请求停止();
    线程.等待停止();
}

结构_D455深度相机线程结果 读取外设线程_D455深度相机结果()
{
    return 获取全局外设线程_D455深度相机().读取最新结果();
}
