        D455_跨帧观察簇缓存().clear();
        D455_下一跨帧观察簇ID() = 0;
    }

    // 功能：按函数名执行对应处理。
    std::int64_t D455_I64绝对差(std::int64_t 左, std::int64_t 右) noexcept
    {
        return 左 >= 右 ? 左 - 右 : 右 - 左;
    }

    // 功能：按函数名执行对应处理。
    std::int64_t D455_计数容差(std::int64_t 基准) noexcept
    {
        const auto 正基准 = 基准 >= 0 ? 基准 : -基准;
        return (std::max<std::int64_t>)(5, 正基准 / 20);
    }

