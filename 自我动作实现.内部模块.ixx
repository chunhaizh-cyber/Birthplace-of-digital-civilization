    struct 结构_任务状态被动提交请求 {
        方法类::节点类* 提交方法首节点 = nullptr;
        任务类::节点类* 任务 = nullptr;
        bool 写入任务状态 = true;
        枚举_任务状态 建议任务状态 = 枚举_任务状态::未定义;
        bool 写入任务阶段 = false;
        枚举_任务阶段 建议任务阶段 = 枚举_任务阶段::未定义;
        场景节点类* 输入参数场景 = nullptr;
        场景节点类* 输出结果场景 = nullptr;
        时间戳 当前时间 = 0;
    };

    struct 结构_任务状态被动提交结果 {
        bool 已处理 = false;
        bool 已提交 = false;
        枚举_任务状态 原任务状态 = 枚举_任务状态::未定义;
        枚举_任务状态 新任务状态 = 枚举_任务状态::未定义;
        枚举_任务阶段 原任务阶段 = 枚举_任务阶段::未定义;
        枚举_任务阶段 新任务阶段 = 枚举_任务阶段::未定义;
        动态节点类* 任务状态动作动态 = nullptr;
        const 语素入口节点类* 失败原因 = nullptr;
    };

    using 任务状态被动提交函数 =
        结构_任务状态被动提交结果 (*)(const 结构_任务状态被动提交请求& 请求) noexcept;

    inline 任务状态被动提交函数& 任务状态被动提交函数槽() noexcept
    {
        static 任务状态被动提交函数 s_函数 = nullptr;
        return s_函数;
    }

    inline void 注册任务状态被动提交函数(任务状态被动提交函数 函数) noexcept
    {
        任务状态被动提交函数槽() = 函数;
    }

    inline 结构_任务状态被动提交结果 提交任务状态被动动作(
        const 结构_任务状态被动提交请求& 请求) noexcept
    {
        auto* 函数 = 任务状态被动提交函数槽();
        return 函数 ? 函数(请求) : 结构_任务状态被动提交结果{};
    }

