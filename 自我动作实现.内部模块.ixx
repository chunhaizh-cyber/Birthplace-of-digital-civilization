module;

#include "本能方法类.h"
#include "世界树类.h"
#include "方法类.h"

export module 自我动作实现.内部模块;

import 本能动作管理模块;

export namespace 自我动作实现模块::内部模块 {
    using 本能动作函数 = 存在节点类* (*)(
        方法类::节点类* 方法首节点,
        场景节点类* 输入参数场景,
        场景节点类* 输出结果场景) noexcept;

    struct 内部本能函数集 {
        本能动作函数 练习 = nullptr;
        本能动作函数 尝试学习 = nullptr;
        本能动作函数 定向学习 = nullptr;
        本能动作函数 提交任务状态变化 = nullptr;
        本能动作函数 提交方法可执行入口 = nullptr;
        本能动作函数 建立条件结果对 = nullptr;
        本能动作函数 提交方法状态变化 = nullptr;
        本能动作函数 回写需求满足 = nullptr;
        本能动作函数 结算叶子任务价值 = nullptr;
        本能动作函数 建立观察帧存在 = nullptr;
        本能动作函数 建立观察帧到自我场景接口 = nullptr;
        本能动作函数 建立像素观察事实索引 = nullptr;
        本能动作函数 承接像素特征值 = nullptr;
        本能动作函数 校验观察事实完备性 = nullptr;
        本能动作函数 评估观察帧质量 = nullptr;
        本能动作函数 诊断观察质量缺口并派生补观察需求 = nullptr;
        本能动作函数 判断基础观察事实可用性 = nullptr;
        本能动作函数 安全评估当前场景安全性 = nullptr;
        本能动作函数 读取自我关键特征变化 = nullptr;
        本能动作函数 构造场景影响因果候选 = nullptr;
        本能动作函数 明确当前场景持续观察需求 = nullptr;
        本能动作函数 持续观察当前场景 = nullptr;
        本能动作函数 明确负向影响处置需求 = nullptr;
        本能动作函数 执行降级保护 = nullptr;
        本能动作函数 验证外设观察像素簇候选 = nullptr;
        本能动作函数 确认外设观察存在候选 = nullptr;
        本能动作函数 提交确认观察存在事实 = nullptr;
        本能动作函数 按已确认轮廓分区当前帧 = nullptr;
        本能动作函数 调整相机参数并重采样 = nullptr;
        本能动作函数 按ROI重算观察质量 = nullptr;
        本能动作函数 执行多帧重采样并择优 = nullptr;
        本能动作函数 生成低置信补偿观察候选 = nullptr;
        本能动作函数 调整外设观察姿态 = nullptr;
        本能动作函数 调整观察位置 = nullptr;
        本能动作函数 建立当前帧像素特征索引兼容入口 = nullptr;
        本能动作函数 按像素坐标回查观察事实 = nullptr;
        本能动作函数 确保存在内部世界 = nullptr;
        本能动作函数 建立存在内外场景接口 = nullptr;
        本能动作函数 将存在局部观察切片映射到内部世界 = nullptr;
        本能动作函数 在内部世界提取子候选 = nullptr;
        本能动作函数 确认内部世界子存在 = nullptr;
        本能动作函数 递归细分存在内部世界 = nullptr;
        本能动作函数 匹配当前观察存在与历史观察存在 = nullptr;
        本能动作函数 比较存在特征变化 = nullptr;
        本能动作函数 生成观察变化事件 = nullptr;
        本能动作函数 导出当前场景识别快照 = nullptr;
        本能动作函数 导出OpenGL复现数据 = nullptr;
        本能动作函数 提取空间候选 = nullptr;
        本能动作函数 判断空间候选相对独立性 = nullptr;
        本能动作函数 生成空间候选观察队列 = nullptr;
        本能动作函数 观察单个空间候选并组合存在假设 = nullptr;
        本能动作函数 用空间范围投影覆盖原帧验证像素归属 = nullptr;
    };

    inline bool 是内部变化本能方法(枚举_本能方法ID 方法ID) noexcept
    {
        switch (方法ID) {
        case 枚举_本能方法ID::自我_练习:
        case 枚举_本能方法ID::自我_尝试学习:
        case 枚举_本能方法ID::自我_定向学习:
        case 枚举_本能方法ID::自我_提交任务状态变化:
        case 枚举_本能方法ID::自我_提交方法可执行入口:
        case 枚举_本能方法ID::自我_建立条件结果对:
        case 枚举_本能方法ID::自我_提交方法状态变化:
        case 枚举_本能方法ID::自我_回写需求满足:
        case 枚举_本能方法ID::自我_结算叶子任务价值:
        case 枚举_本能方法ID::自我_建立观察帧存在:
        case 枚举_本能方法ID::自我_建立观察帧到自我场景接口:
        case 枚举_本能方法ID::自我_建立像素观察事实索引:
        case 枚举_本能方法ID::自我_承接像素特征值:
        case 枚举_本能方法ID::自我_校验观察事实完备性:
        case 枚举_本能方法ID::自我_评估观察帧质量:
        case 枚举_本能方法ID::自我_诊断观察质量缺口并派生补观察需求:
        case 枚举_本能方法ID::自我_判断基础观察事实可用性:
        case 枚举_本能方法ID::安全_评估当前场景安全性:
        case 枚举_本能方法ID::自我_读取自我关键特征变化:
        case 枚举_本能方法ID::安全_构造场景影响因果候选:
        case 枚举_本能方法ID::自我_明确当前场景持续观察需求:
        case 枚举_本能方法ID::安全_持续观察当前场景:
        case 枚举_本能方法ID::自我_明确负向影响处置需求:
        case 枚举_本能方法ID::安全_执行降级保护:
        case 枚举_本能方法ID::自我_验证外设观察像素簇候选:
        case 枚举_本能方法ID::自我_确认外设观察存在候选:
        case 枚举_本能方法ID::提交_确认观察存在事实:
        case 枚举_本能方法ID::自我_按已确认轮廓分区当前帧:
        case 枚举_本能方法ID::自我_调整相机参数并重采样:
        case 枚举_本能方法ID::自我_按ROI重算观察质量:
        case 枚举_本能方法ID::自我_执行多帧重采样并择优:
        case 枚举_本能方法ID::自我_生成低置信补偿观察候选:
        case 枚举_本能方法ID::自我_调整外设观察姿态:
        case 枚举_本能方法ID::自我_调整观察位置:
        case 枚举_本能方法ID::自我_按像素坐标回查观察事实:
        case 枚举_本能方法ID::自我_确保存在内部世界:
        case 枚举_本能方法ID::自我_建立存在内外场景接口:
        case 枚举_本能方法ID::自我_将存在局部观察切片映射到内部世界:
        case 枚举_本能方法ID::自我_在内部世界提取子候选:
        case 枚举_本能方法ID::自我_确认内部世界子存在:
        case 枚举_本能方法ID::自我_递归细分存在内部世界:
        case 枚举_本能方法ID::自我_匹配当前观察存在与历史观察存在:
        case 枚举_本能方法ID::自我_比较存在特征变化:
        case 枚举_本能方法ID::自我_生成观察变化事件:
        case 枚举_本能方法ID::自我_导出当前场景识别快照:
        case 枚举_本能方法ID::自我_导出OpenGL复现数据:
        case 枚举_本能方法ID::自我_提取空间候选:
        case 枚举_本能方法ID::自我_判断空间候选相对独立性:
        case 枚举_本能方法ID::自我_生成空间候选观察队列:
        case 枚举_本能方法ID::自我_观察单个空间候选并组合存在假设:
        case 枚举_本能方法ID::自我_用空间范围投影覆盖原帧验证像素归属:
        case 枚举_本能方法ID::双目相机_建立当前帧像素特征索引:
            return true;
        default:
            return false;
        }
    }

    inline bool 注册内部本能函数执行闭环(const 内部本能函数集& 函数集) noexcept
    {
        bool ok = true;
        ok = 函数集.练习
            && 取本能动作集().注册(枚举_本能方法ID::自我_练习, 函数集.练习)
            && ok;
        ok = 函数集.尝试学习
            && 取本能动作集().注册(枚举_本能方法ID::自我_尝试学习, 函数集.尝试学习)
            && ok;
        ok = 函数集.定向学习
            && 取本能动作集().注册(枚举_本能方法ID::自我_定向学习, 函数集.定向学习)
            && ok;
        ok = 函数集.提交任务状态变化
            && 取本能动作集().注册(枚举_本能方法ID::自我_提交任务状态变化, 函数集.提交任务状态变化)
            && ok;
        ok = 函数集.提交方法可执行入口
            && 取本能动作集().注册(枚举_本能方法ID::自我_提交方法可执行入口, 函数集.提交方法可执行入口)
            && ok;
        ok = 函数集.建立条件结果对
            && 取本能动作集().注册(枚举_本能方法ID::自我_建立条件结果对, 函数集.建立条件结果对)
            && ok;
        ok = 函数集.提交方法状态变化
            && 取本能动作集().注册(枚举_本能方法ID::自我_提交方法状态变化, 函数集.提交方法状态变化)
            && ok;
        ok = 函数集.回写需求满足
            && 取本能动作集().注册(枚举_本能方法ID::自我_回写需求满足, 函数集.回写需求满足)
            && ok;
        ok = 函数集.结算叶子任务价值
            && 取本能动作集().注册(枚举_本能方法ID::自我_结算叶子任务价值, 函数集.结算叶子任务价值)
            && ok;
        ok = 函数集.建立观察帧存在
            && 取本能动作集().注册(枚举_本能方法ID::自我_建立观察帧存在, 函数集.建立观察帧存在)
            && ok;
        ok = 函数集.建立观察帧到自我场景接口
            && 取本能动作集().注册(枚举_本能方法ID::自我_建立观察帧到自我场景接口, 函数集.建立观察帧到自我场景接口)
            && ok;
        ok = 函数集.建立像素观察事实索引
            && 取本能动作集().注册(枚举_本能方法ID::自我_建立像素观察事实索引, 函数集.建立像素观察事实索引)
            && ok;
        ok = 函数集.承接像素特征值
            && 取本能动作集().注册(枚举_本能方法ID::自我_承接像素特征值, 函数集.承接像素特征值)
            && ok;
        ok = 函数集.校验观察事实完备性
            && 取本能动作集().注册(枚举_本能方法ID::自我_校验观察事实完备性, 函数集.校验观察事实完备性)
            && ok;
        ok = 函数集.评估观察帧质量
            && 取本能动作集().注册(枚举_本能方法ID::自我_评估观察帧质量, 函数集.评估观察帧质量)
            && ok;
        ok = 函数集.诊断观察质量缺口并派生补观察需求
            && 取本能动作集().注册(枚举_本能方法ID::自我_诊断观察质量缺口并派生补观察需求, 函数集.诊断观察质量缺口并派生补观察需求)
            && ok;
        ok = 函数集.判断基础观察事实可用性
            && 取本能动作集().注册(枚举_本能方法ID::自我_判断基础观察事实可用性, 函数集.判断基础观察事实可用性)
            && ok;
        ok = 函数集.安全评估当前场景安全性
            && 取本能动作集().注册(枚举_本能方法ID::安全_评估当前场景安全性, 函数集.安全评估当前场景安全性)
            && ok;
        ok = 函数集.读取自我关键特征变化
            && 取本能动作集().注册(枚举_本能方法ID::自我_读取自我关键特征变化, 函数集.读取自我关键特征变化)
            && ok;
        ok = 函数集.构造场景影响因果候选
            && 取本能动作集().注册(枚举_本能方法ID::安全_构造场景影响因果候选, 函数集.构造场景影响因果候选)
            && ok;
        ok = 函数集.明确当前场景持续观察需求
            && 取本能动作集().注册(枚举_本能方法ID::自我_明确当前场景持续观察需求, 函数集.明确当前场景持续观察需求)
            && ok;
        ok = 函数集.持续观察当前场景
            && 取本能动作集().注册(枚举_本能方法ID::安全_持续观察当前场景, 函数集.持续观察当前场景)
            && ok;
        ok = 函数集.明确负向影响处置需求
            && 取本能动作集().注册(枚举_本能方法ID::自我_明确负向影响处置需求, 函数集.明确负向影响处置需求)
            && ok;
        ok = 函数集.执行降级保护
            && 取本能动作集().注册(枚举_本能方法ID::安全_执行降级保护, 函数集.执行降级保护)
            && ok;
        ok = 函数集.验证外设观察像素簇候选
            && 取本能动作集().注册(枚举_本能方法ID::自我_验证外设观察像素簇候选, 函数集.验证外设观察像素簇候选)
            && ok;
        ok = 函数集.确认外设观察存在候选
            && 取本能动作集().注册(枚举_本能方法ID::自我_确认外设观察存在候选, 函数集.确认外设观察存在候选)
            && ok;
        ok = 函数集.提交确认观察存在事实
            && 取本能动作集().注册(枚举_本能方法ID::提交_确认观察存在事实, 函数集.提交确认观察存在事实)
            && ok;
        ok = 函数集.按已确认轮廓分区当前帧
            && 取本能动作集().注册(枚举_本能方法ID::自我_按已确认轮廓分区当前帧, 函数集.按已确认轮廓分区当前帧)
            && ok;
        ok = 函数集.调整相机参数并重采样
            && 取本能动作集().注册(枚举_本能方法ID::自我_调整相机参数并重采样, 函数集.调整相机参数并重采样)
            && ok;
        ok = 函数集.按ROI重算观察质量
            && 取本能动作集().注册(枚举_本能方法ID::自我_按ROI重算观察质量, 函数集.按ROI重算观察质量)
            && ok;
        ok = 函数集.执行多帧重采样并择优
            && 取本能动作集().注册(枚举_本能方法ID::自我_执行多帧重采样并择优, 函数集.执行多帧重采样并择优)
            && ok;
        ok = 函数集.生成低置信补偿观察候选
            && 取本能动作集().注册(枚举_本能方法ID::自我_生成低置信补偿观察候选, 函数集.生成低置信补偿观察候选)
            && ok;
        ok = 函数集.调整外设观察姿态
            && 取本能动作集().注册(枚举_本能方法ID::自我_调整外设观察姿态, 函数集.调整外设观察姿态)
            && ok;
        ok = 函数集.调整观察位置
            && 取本能动作集().注册(枚举_本能方法ID::自我_调整观察位置, 函数集.调整观察位置)
            && ok;
        ok = 函数集.建立当前帧像素特征索引兼容入口
            && 取本能动作集().注册(枚举_本能方法ID::双目相机_建立当前帧像素特征索引, 函数集.建立当前帧像素特征索引兼容入口)
            && ok;
        ok = 函数集.按像素坐标回查观察事实
            && 取本能动作集().注册(枚举_本能方法ID::自我_按像素坐标回查观察事实, 函数集.按像素坐标回查观察事实)
            && ok;
        ok = 函数集.确保存在内部世界
            && 取本能动作集().注册(枚举_本能方法ID::自我_确保存在内部世界, 函数集.确保存在内部世界)
            && ok;
        ok = 函数集.建立存在内外场景接口
            && 取本能动作集().注册(枚举_本能方法ID::自我_建立存在内外场景接口, 函数集.建立存在内外场景接口)
            && ok;
        ok = 函数集.将存在局部观察切片映射到内部世界
            && 取本能动作集().注册(枚举_本能方法ID::自我_将存在局部观察切片映射到内部世界, 函数集.将存在局部观察切片映射到内部世界)
            && ok;
        ok = 函数集.在内部世界提取子候选
            && 取本能动作集().注册(枚举_本能方法ID::自我_在内部世界提取子候选, 函数集.在内部世界提取子候选)
            && ok;
        ok = 函数集.确认内部世界子存在
            && 取本能动作集().注册(枚举_本能方法ID::自我_确认内部世界子存在, 函数集.确认内部世界子存在)
            && ok;
        ok = 函数集.递归细分存在内部世界
            && 取本能动作集().注册(枚举_本能方法ID::自我_递归细分存在内部世界, 函数集.递归细分存在内部世界)
            && ok;
        ok = 函数集.匹配当前观察存在与历史观察存在
            && 取本能动作集().注册(枚举_本能方法ID::自我_匹配当前观察存在与历史观察存在, 函数集.匹配当前观察存在与历史观察存在)
            && ok;
        ok = 函数集.比较存在特征变化
            && 取本能动作集().注册(枚举_本能方法ID::自我_比较存在特征变化, 函数集.比较存在特征变化)
            && ok;
        ok = 函数集.生成观察变化事件
            && 取本能动作集().注册(枚举_本能方法ID::自我_生成观察变化事件, 函数集.生成观察变化事件)
            && ok;
        ok = 函数集.导出当前场景识别快照
            && 取本能动作集().注册(枚举_本能方法ID::自我_导出当前场景识别快照, 函数集.导出当前场景识别快照)
            && ok;
        ok = 函数集.导出OpenGL复现数据
            && 取本能动作集().注册(枚举_本能方法ID::自我_导出OpenGL复现数据, 函数集.导出OpenGL复现数据)
            && ok;
        ok = 函数集.提取空间候选
            && 取本能动作集().注册(枚举_本能方法ID::自我_提取空间候选, 函数集.提取空间候选)
            && ok;
        ok = 函数集.判断空间候选相对独立性
            && 取本能动作集().注册(枚举_本能方法ID::自我_判断空间候选相对独立性, 函数集.判断空间候选相对独立性)
            && ok;
        ok = 函数集.生成空间候选观察队列
            && 取本能动作集().注册(枚举_本能方法ID::自我_生成空间候选观察队列, 函数集.生成空间候选观察队列)
            && ok;
        ok = 函数集.观察单个空间候选并组合存在假设
            && 取本能动作集().注册(枚举_本能方法ID::自我_观察单个空间候选并组合存在假设, 函数集.观察单个空间候选并组合存在假设)
            && ok;
        ok = 函数集.用空间范围投影覆盖原帧验证像素归属
            && 取本能动作集().注册(枚举_本能方法ID::自我_用空间范围投影覆盖原帧验证像素归属, 函数集.用空间范围投影覆盖原帧验证像素归属)
            && ok;
        return ok;
    }
}
