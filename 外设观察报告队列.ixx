export module 外设观察报告队列;

export enum class 枚举_外设观察运行模式 : std::uint8_t {
    未指定 = 0,
    陌生环境逐簇识别 = 1,
    已识别场景扫描变化 = 2,
    目标跟踪观察 = 3,
    扫描 = 陌生环境逐簇识别,
    跟踪 = 目标跟踪观察,
};

export enum class 枚举_外设观察报告类型 : std::uint8_t {
    未指定 = 0,
    逐簇识别报告 = 1,
    扫描变化报告 = 2,
    跟踪报告 = 3,
};

