    inline bool 注册外部本能函数执行闭环() noexcept
    {
        bool ok = true;
        ok = 取本能动作集().注册(
            枚举_本能方法ID::双目相机_使达到可用状态,
            &使双目相机达到可用状态) && ok;
        ok = 取本能动作集().注册(
            枚举_本能方法ID::双目相机_释放,
            &释放双目相机) && ok;
        ok = 取本能动作集().注册(
            枚举_本能方法ID::双目相机_检查运行状态,
            &检查双目相机运行状态) && ok;
        ok = 取本能动作集().注册(
            枚举_本能方法ID::双目相机_刷新当前观察场景,
            &用双目相机刷新当前观察场景) && ok;
        ok = 取本能动作集().注册(
            枚举_本能方法ID::双目相机_发现候选存在,
            &用双目相机发现候选存在) && ok;
        ok = 取本能动作集().注册(
            枚举_本能方法ID::双目相机_取得当前观察帧,
            &用双目相机取得当前观察帧) && ok;
        ok = 取本能动作集().注册(
            枚举_本能方法ID::双目相机_取得当前观察特征帧,
            &用双目相机取得当前观察特征帧) && ok;
        return ok;
    }
}
