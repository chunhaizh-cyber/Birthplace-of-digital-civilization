    场景节点类* 创建任务可执行输入参数场景(
        const 任务节点* 任务头,
        时间戳 now) noexcept
    {
        if (!任务头 || !任务头->主信息.场景.指针) {
            return nullptr;
        }
        const auto* 场景名 = 语素集.添加信息入口词(
            "任务可执行输入_"
                + 任务主键_筹办日志(任务头)
                + "_"
                + std::to_string(now),
            枚举_信息入口类型::场景实例入口);
        return 世界树.场景().创建场景_按名称(
            reinterpret_cast<基础信息节点类*>(任务头->主信息.场景.指针),
            场景名,
            枚举_世界类型::内部世界);
    }

