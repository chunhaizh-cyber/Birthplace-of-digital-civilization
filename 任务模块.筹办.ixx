    }

    // 功能：把处理结果写入指定对象、场景或日志。
    void 写入筹办回执任务建议(
        任务模块::筹办::结构_任务推进回执& 回执,
        const 枚举_任务状态 状态,
        const 枚举_任务阶段 阶段) noexcept
    {
        // 筹办层只产出“任务层回执建议”，不直接写任务虚拟存在。
        // 真正的任务状态/阶段提交由任务管理工作线程统一完成。
        回执.建议任务状态 = 状态;
        回执.建议任务阶段 = 阶段;
    }

    // 功能：记录日志、动态、证据或运行痕迹。
    void 记录筹办日志(const std::string& 文本) noexcept
    {
        项目运行日志("任务筹办跟踪 | " + 文本);
    }

    // 功能：从指定来源读取数据或状态。
    状态节点类* 读取派生需求状态_从结果场景(
        场景节点类* 结果场景,
        const 语素入口节点类* 状态特征类型) noexcept
    {
        if (!结果场景 || !状态特征类型) {
            return nullptr;
        }
        void* 指针 = nullptr;
        return 世界树.读取特征_指针(
                reinterpret_cast<基础信息节点类*>(结果场景),
                状态特征类型,
                指针)
            && 指针
            ? reinterpret_cast<状态节点类*>(指针)
            : nullptr;
    }

    // 功能：记录日志、动态、证据或运行痕迹。
    void 记录缺口派生目标状态(
        const char* 阶段,
        const 任务节点* 任务头,
        const 方法节点* 目标方法,
        const 语素入口节点类* 缺口特征,
        const 可解析引用<基础信息节点类>& 缺口目标主体,
        场景节点类* 结果场景) noexcept
    {
        auto* 派生当前状态 = 读取派生需求状态_从结果场景(
            结果场景,
            私有_执行输出特征_派生需求当前状态_执行桥_最小_v0());
        auto* 派生目标状态 = 读取派生需求状态_从结果场景(
            结果场景,
            私有_执行输出特征_派生需求目标状态_执行桥_最小_v0());

        std::ostringstream 输出;
        输出 << (阶段 ? 阶段 : "缺口目标状态检查")
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 目标方法=" << 方法主键_筹办日志(目标方法)
            << " | 缺口目标主体=" << 基础主键_筹办日志(缺口目标主体.指针)
            << " | 缺口特征=" << 入口主键_筹办日志(缺口特征)
            << " | 派生当前状态=" << 状态主键_筹办日志(派生当前状态)
            << " | 派生目标状态=" << 状态主键_筹办日志(派生目标状态);
        记录筹办日志(输出.str());

        if (!派生目标状态) {
            记录筹办日志(std::string("缺口派生目标状态缺失")
                + " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 目标方法=" + 方法主键_筹办日志(目标方法)
                + " | 缺口特征=" + 入口主键_筹办日志(缺口特征)
                + " | 结果场景=" + 基础主键_筹办日志(reinterpret_cast<基础信息节点类*>(结果场景)));
        }
    }

    // 功能：把处理结果写入指定对象、场景或日志。
    void 写入方法节点引用(可解析引用<方法节点类>& 输出, 方法节点* 节点) noexcept
    {
        输出.指针 = reinterpret_cast<方法节点类*>(节点);
        输出.主键 = 节点 ? 节点->获取主键() : std::string{};
    }

    // 功能：把处理结果写入指定对象、场景或日志。
    void 写入方法候选引用(
        std::vector<可解析引用<方法节点类>>& 输出,
        方法节点* 节点) noexcept
    {
        if (!节点) {
            return;
        }
        auto* 方法节点引用指针 = reinterpret_cast<方法节点类*>(节点);
        for (const auto& 已有 : 输出) {
            if (已有.指针 == 方法节点引用指针
                || (!已有.主键.empty() && 已有.主键 == 节点->获取主键())) {
                return;
            }
        }

        可解析引用<方法节点类> 引用{};
        写入方法节点引用(引用, 节点);
        输出.push_back(std::move(引用));
    }

