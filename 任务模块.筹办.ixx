        case 枚举_本能方法ID::自我_跟踪指定存在:
        case 枚举_本能方法ID::自我_读取自我关键特征变化:
        case 枚举_本能方法ID::安全_构造场景影响因果候选:
        case 枚举_本能方法ID::自我_明确当前场景持续观察需求:
        case 枚举_本能方法ID::安全_持续观察当前场景:
        case 枚举_本能方法ID::自我_明确负向影响处置需求:
        case 枚举_本能方法ID::安全_执行降级保护:
        case 枚举_本能方法ID::安全_搜索安全因果因素证据:
        case 枚举_本能方法ID::服务_绑定任务交互者:
        case 枚举_本能方法ID::服务_绑定任务权限者:
        case 枚举_本能方法ID::服务_绑定任务服务对象:
        case 枚举_本能方法ID::服务_绑定任务权限边界:
        case 枚举_本能方法ID::服务_绑定任务目标宿主:
        case 枚举_本能方法ID::服务_绑定任务目标特征类型:
        case 枚举_本能方法ID::服务_绑定任务目标值:
        case 枚举_本能方法ID::服务_绑定任务输入场景:
            return false;
        default:
            return true;
        }
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    bool 方法可作为练习目标_筹办(const 方法节点* 方法) noexcept
    {
        return 本能方法ID可作为练习目标_筹办(方法原始本能ID值(方法));
    }

    // 功能：提交事实、动态、任务状态或运行回执。
    bool 方法动作状态已提交(方法节点* 方法, 时间戳 now) noexcept
    {
        if (!方法) {
            return false;
        }
        auto* 方法存在 = 方法虚拟存在服务类::取或创建方法虚拟存在(方法, nullptr, now);
        I64 方法动作状态 = 0;
        return 方法存在
            && 世界树.读取特征_I64(
                reinterpret_cast<基础信息节点类*>(方法存在),
                私有_方法动作状态特征类型_执行桥_最小_v0(),
                方法动作状态)
            && 方法动作状态 == 1;
    }

    // 功能：提交事实、动态、任务状态或运行回执。
    I64 已有单步本能入口待提交动作状态(方法节点* 方法, 时间戳 now) noexcept
    {
        const I64 本能方法ID = 方法自我能力值(方法);
        if (!本能方法ID可作为可执行入口提交(本能方法ID)
            || 方法动作状态已提交(方法, now)) {
            return 0;
        }
        const bool 已有可执行入口事实 =
            私有_方法有已注册本能入口_执行桥_最小_v0(方法)
            || 方法类::方法可执行入口数量(方法) > 0;
        if (已有可执行入口事实) {
            return 0;
        }
        return 本能方法ID;
    }

    // 功能：补齐条件、参数、证据或方法能力缺口。
    bool 任务目标是方法结构补齐需求(const 任务节点* 任务头) noexcept
    {
        const auto* 目标特征类型 = 任务对应需求目标特征类型(任务头);
        return 语素入口同一(目标特征类型, 私有_方法状态特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法稳定状态特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法运行账完整性特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法最近连续成功次数特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法动作状态特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法动作数量特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法可执行入口数量特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法条件节点数量特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法结果节点数量特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法条件结果对数量特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法条件结果配对状态特征类型_执行桥_最小_v0());
    }

    // 功能：按条件查找目标对象、方法或事实。
    方法节点* 按方法虚拟存在查找方法(
        自我类& 自我对象,
        基础信息节点类* 方法虚拟存在,
        时间戳 now) noexcept
    {
        auto* 自我存在 = 自我对象.确保自我存在();
        auto* 方法根节点 = 自我存在 ? 世界树.获取方法根节点(自我存在) : nullptr;
        if (!方法根节点 || !方法根节点->子 || !方法虚拟存在) {
            return nullptr;
        }

        auto* 首节点 = static_cast<方法节点*>(方法根节点->子);
        auto* 当前 = 首节点;
        std::size_t 保护计数 = 0;
        do {
            if (方法类::方法是首节点(当前)) {
                auto* 当前虚拟存在 = 方法虚拟存在服务类::取或创建方法虚拟存在(当前, 自我存在, now);
                if (当前虚拟存在 == 方法虚拟存在
                    || (当前虚拟存在
                        && !当前虚拟存在->获取主键().empty()
                        && 当前虚拟存在->获取主键() == 方法虚拟存在->获取主键())) {
                    return 当前;
                }
            }
            当前 = static_cast<方法节点*>(当前->下);
            ++保护计数;
        } while (当前 && 当前 != 首节点 && 保护计数 < 4096);
        return nullptr;
    }

    // 功能：按条件查找目标对象、方法或事实。
    方法节点* 按方法主键查找方法(
        自我类& 自我对象,
        const std::string& 方法主键) noexcept
    {
        if (方法主键.empty()) {
            return nullptr;
        }

        auto* 自我存在 = 自我对象.确保自我存在();
        auto* 方法根节点 = 自我存在 ? 世界树.获取方法根节点(自我存在) : nullptr;
        if (!方法根节点) {
            return nullptr;
        }

        std::vector<方法节点*> 待访问{};
        std::vector<方法节点*> 已入栈{};

        const auto 已记录节点 = [&](const 方法节点* 节点) noexcept {
            for (const auto* 已记录 : 已入栈) {
                if (已记录 == 节点) {
                    return true;
                }
            }
            return false;
        };

        const auto 压入待访问 = [&](方法节点* 节点) noexcept {
            if (!节点 || 已记录节点(节点)) {
                return;
            }
            已入栈.push_back(节点);
            待访问.push_back(节点);
        };

        const auto 压入直接子链 = [&](方法节点* 父节点) noexcept {
            auto* 首子 = 父节点 ? static_cast<方法节点*>(父节点->子) : nullptr;
            if (!首子) {
                return;
            }

            auto* 当前子 = 首子;
            std::size_t 兄弟保护计数 = 0;
            do {
                压入待访问(当前子);
                当前子 = static_cast<方法节点*>(当前子->下);
                ++兄弟保护计数;
            } while (当前子 && 当前子 != 首子 && 兄弟保护计数 < 4096);

            if (兄弟保护计数 >= 4096) {
                记录筹办日志("按方法主键查找兄弟链达到保护上限"
                    " | 父方法=" + 方法主键_筹办日志(父节点)
                    + " | 目标方法主键=" + 方法主键);
            }
        };

        压入待访问(方法根节点);
        std::size_t 访问计数 = 0;
        constexpr std::size_t 访问保护上限 = 65536;
        while (!待访问.empty() && 访问计数 < 访问保护上限) {
            auto* 当前 = 待访问.back();
            待访问.pop_back();
            ++访问计数;

            if (方法类::方法是首节点(当前)
                && 当前->获取主键() == 方法主键) {
                return 当前;
            }

            压入直接子链(当前);
        }

        if (访问计数 >= 访问保护上限) {
            记录筹办日志("按方法主键查找达到保护上限"
                " | 目标方法主键=" + 方法主键);
        }
        return nullptr;
    }

    struct 结构_方法选择评分 {
        I64 直接满足等级 = 0;
        I64 结果命中精度 = 0;
        I64 禁止项惩罚 = 0;
        I64 风险惩罚 = 0;
        I64 前置冲突惩罚 = 0;
        I64 效率分 = 0;
        I64 耗时惩罚 = 0;
        I64 能耗惩罚 = 0;
        I64 资源惩罚 = 0;
        I64 副作用惩罚 = 0;
        I64 可补齐等级 = 0;
        I64 不确定性惩罚 = 0;
        I64 稳定性分 = 0;
        bool 有效 = false;
    };

    // 功能：从候选集中选择当前使用对象或方法。
    bool 方法选择评分更优(
        const 结构_方法选择评分& 左,
        const 结构_方法选择评分& 右) noexcept
    {
        if (左.有效 != 右.有效) return 左.有效;
        if (左.直接满足等级 != 右.直接满足等级) return 左.直接满足等级 > 右.直接满足等级;
        if (左.结果命中精度 != 右.结果命中精度) return 左.结果命中精度 > 右.结果命中精度;
        if (左.禁止项惩罚 != 右.禁止项惩罚) return 左.禁止项惩罚 < 右.禁止项惩罚;
        if (左.风险惩罚 != 右.风险惩罚) return 左.风险惩罚 < 右.风险惩罚;
        if (左.前置冲突惩罚 != 右.前置冲突惩罚) return 左.前置冲突惩罚 < 右.前置冲突惩罚;
        if (左.效率分 != 右.效率分) return 左.效率分 > 右.效率分;
        if (左.耗时惩罚 != 右.耗时惩罚) return 左.耗时惩罚 < 右.耗时惩罚;
        if (左.能耗惩罚 != 右.能耗惩罚) return 左.能耗惩罚 < 右.能耗惩罚;
        if (左.资源惩罚 != 右.资源惩罚) return 左.资源惩罚 < 右.资源惩罚;
        if (左.副作用惩罚 != 右.副作用惩罚) return 左.副作用惩罚 < 右.副作用惩罚;
        if (左.可补齐等级 != 右.可补齐等级) return 左.可补齐等级 > 右.可补齐等级;
        if (左.不确定性惩罚 != 右.不确定性惩罚) return 左.不确定性惩罚 < 右.不确定性惩罚;
        return 左.稳定性分 > 右.稳定性分;
    }

    // 功能：从候选集中选择当前使用对象或方法。
    std::string 方法选择评分文本(const 结构_方法选择评分& 评分)
    {
        std::ostringstream 输出;
        输出 << "命中=" << 评分.结果命中精度
            << ",直接=" << 评分.直接满足等级
            << ",禁=" << 评分.禁止项惩罚
            << ",险=" << 评分.风险惩罚
            << ",冲突=" << 评分.前置冲突惩罚
            << ",效率=" << 评分.效率分
            << ",耗时=" << 评分.耗时惩罚
            << ",能耗=" << 评分.能耗惩罚
            << ",资源=" << 评分.资源惩罚
            << ",副作用=" << 评分.副作用惩罚
            << ",可补=" << 评分.可补齐等级
            << ",不确定=" << 评分.不确定性惩罚
            << ",稳定=" << 评分.稳定性分;
        return 输出.str();
    }

    // 功能：按函数名执行对应处理。
    bool 方法结果项I64目标值(
        const 结构_方法结果项& 结果项,
        I64& 输出值) noexcept
    {
        输出值 = 0;
        const auto* 目标值 = 结果项.关系模板.有目标值
            ? &结果项.关系模板.目标值
            : nullptr;
        if (const auto* 标量 = 目标值 ? std::get_if<I64>(目标值) : nullptr) {
            输出值 = *标量;
            return true;
        }
        return false;
    }

    // 功能：将复合目标特征展开为自身和全部子特征，供方法结果能力召回使用。
    bool 目标特征类型集合包含(
        const std::vector<const 语素入口节点类*>& 集合,
        const 语素入口节点类* 目标特征类型) noexcept
    {
        if (!目标特征类型) {
            return false;
        }
        for (const auto* 候选 : 集合) {
            if (语素入口同一(候选, 目标特征类型)) {
                return true;
            }
        }
        return false;
    }

    // 功能：将复合目标特征展开为自身和全部子特征，供方法结果能力召回使用。
    void 追加目标特征类型(
        std::vector<const 语素入口节点类*>& 集合,
        const 语素入口节点类* 目标特征类型) noexcept
    {
        if (!目标特征类型 || 目标特征类型集合包含(集合, 目标特征类型)) {
            return;
        }
        集合.push_back(目标特征类型);
    }

    // 功能：将复合目标特征展开为自身和全部子特征，供方法结果能力召回使用。
    void 递归展开抽象特征子特征(
        const 抽象特征节点类* 抽象特征,
        std::vector<const 语素入口节点类*>& 输出集合,
        std::uint32_t 深度 = 0) noexcept
    {
        if (!抽象特征 || 深度 > 32) {
            return;
        }
        const auto* 主信息 = 世界树.取抽象特征主信息(抽象特征);
        if (!主信息) {
            return;
        }

        追加目标特征类型(输出集合, 主信息->类型 ? 主信息->类型 : 主信息->名称);
        if (!主信息->是复合特征()) {
            return;
        }

        for (auto* 子节点 : 世界树.获取子节点(reinterpret_cast<const 基础信息节点类*>(抽象特征))) {
            auto* 子抽象 = 子节点 && 世界树.取抽象特征主信息(
                static_cast<const 抽象特征节点类*>(子节点))
                ? static_cast<const 抽象特征节点类*>(子节点)
                : nullptr;
            if (子抽象) {
                递归展开抽象特征子特征(子抽象, 输出集合, 深度 + 1);
            }
        }
    }

    // 功能：将复合目标特征展开为自身和全部子特征，供方法结果能力召回使用。
    std::vector<const 语素入口节点类*> 展开目标特征类型集合_筹办查询(
        const 语素入口节点类* 目标特征类型) noexcept
    {
        std::vector<const 语素入口节点类*> 结果{};
        追加目标特征类型(结果, 目标特征类型);
        auto* 抽象根 = 世界树.抽象特征根;
        auto* 抽象特征 = 抽象根 && 目标特征类型
            ? 世界树.查找子抽象特征_按类型(抽象根, 目标特征类型)
            : nullptr;
        if (抽象特征) {
            递归展开抽象特征子特征(抽象特征, 结果);
        }
        return 结果;
    }

    bool 方法结果项命中目标特征(
        const 结构_方法结果项& 结果项,
        const 语素入口节点类* 目标特征类型) noexcept;

    bool 方法结果项命中目标特征集合(
        const 结构_方法结果项& 结果项,
        const std::vector<const 语素入口节点类*>& 目标特征类型集合) noexcept;

    // 功能：适配外部接口、模块协议或调用结果。
    bool 方法结果项方向适配需求(
        const 结构_方法结果项& 结果项,
        const 需求节点* 来源需求) noexcept
    {
        const auto 允许方向 = 结果项.关系允许方向();
        if (允许方向 == 0) {
            return true;
        }
        if (!来源需求) {
            return false;
        }

        I64 当前值 = 0;
        I64 目标值 = 0;
        if (状态节点I64值(需求类::解析需求当前状态(来源需求), 当前值)
            && 状态节点I64值(需求类::解析需求目标状态(来源需求), 目标值)) {
            return 比较量命中方向(
                比较I64_三态(目标值, 当前值),
                允许方向);
        }

        const auto 方向编码 = 需求目标方向编码(来源需求);
        if (方向编码 != 0) {
            return 比较量命中方向(方向编码, 允许方向);
        }

        return true;
    }

    // 功能：按函数名执行对应处理。
    bool 方法结果项承接任务需求(
        const 结构_方法结果项& 结果项,
        const 语素入口节点类* 目标特征类型,
        const 需求节点* 来源需求) noexcept
    {
        const auto 目标特征类型集合 = 展开目标特征类型集合_筹办查询(目标特征类型);
        if (!方法结果项命中目标特征集合(结果项, 目标特征类型集合)) {
            return false;
        }
        return 方法结果项方向适配需求(结果项, 来源需求);
    }

    // 功能：按函数名执行对应处理。
    bool 方法结果项承接任务需求_按目标集合(
        const 结构_方法结果项& 结果项,
        const std::vector<const 语素入口节点类*>& 目标特征类型集合,
        const 需求节点* 来源需求) noexcept
    {
        if (!方法结果项命中目标特征集合(结果项, 目标特征类型集合)) {
            return false;
        }
        return 方法结果项方向适配需求(结果项, 来源需求);
    }

    // 功能：按函数名执行对应处理。
    bool 方法结果能力命中任务需求(
        方法节点* 方法,
        const 任务节点* 任务头,
        const 语素入口节点类* 目标特征类型) noexcept
    {
        const auto* 结果项集 = 方法类::方法结果项集(方法);
        if (!结果项集 || !目标特征类型) {
            return false;
        }

        const auto* 来源需求 = 任务来源需求(任务头);
        const auto 目标特征类型集合 = 展开目标特征类型集合_筹办查询(目标特征类型);
        for (const auto& 结果项 : *结果项集) {
            if (方法结果项承接任务需求_按目标集合(结果项, 目标特征类型集合, 来源需求)) {
                return true;
            }
        }
        return false;
    }

    // 功能：按函数名执行对应处理。
    I64 方法结果项目标值一致分(
        const 结构_方法结果项& 结果项,
        const 需求节点* 来源需求) noexcept
    {
        if (!来源需求) {
            return 0;
        }

        I64 结果目标值 = 0;
        I64 需求目标值 = 0;
        if (!方法结果项I64目标值(结果项, 结果目标值)
            || !状态节点I64值(需求类::解析需求目标状态(来源需求), 需求目标值)) {
            return 0;
        }

        const auto 比较量 = 比较I64_三态(结果目标值, 需求目标值);
        if (比较量 == 0) {
            return 100;
        }
        return 三向关系被接受(
            比较量转三向关系(比较量),
            需求类::读取需求满足关系(来源需求, 关系_等于))
            ? 60
            : -80;
    }

    // 功能：按函数名执行对应处理。
    I64 方法结果能力命中精度(
        方法节点* 方法,
        const 语素入口节点类* 目标特征类型,
        const 需求节点* 来源需求) noexcept
    {
        const auto* 结果项集 = 方法类::方法结果项集(方法);
        if (!结果项集 || !目标特征类型) {
            return 0;
        }

        I64 最佳精度 = 0;
        const auto 目标特征类型集合 = 展开目标特征类型集合_筹办查询(目标特征类型);
        for (const auto& 结果项 : *结果项集) {
            if (!方法结果项承接任务需求_按目标集合(结果项, 目标特征类型集合, 来源需求)) {
                continue;
            }

            if (!结果项.关系目标特征类型由参数决定()
                && 语素入口同一(结果项.关系目标特征类型(), 目标特征类型)) {
                // 固定结果特征类型最精确，优先级高于参数化“可改变任意特征”。
                最佳精度 = (std::max<I64>)(
                    最佳精度,
                    20 + 方法结果项目标值一致分(结果项, 来源需求));
            } else if (!结果项.关系目标特征类型由参数决定()
                && 目标特征类型集合包含(目标特征类型集合, 结果项.关系目标特征类型())) {
                // 复合特征的子特征能力可以承接复合目标，但精度低于直接命中复合特征。
                最佳精度 = (std::max<I64>)(
                    最佳精度,
                    15 + 方法结果项目标值一致分(结果项, 来源需求));
            } else if (结果项.关系目标特征类型由参数决定()
                && 结果项.关系目标特征类型参数() != nullptr) {
                // 参数化结果能力可以承接任意目标特征，但精度低于固定命中。
                最佳精度 = (std::max<I64>)(
                    最佳精度,
                    10 + 方法结果项目标值一致分(结果项, 来源需求));
            }
        }
        return 最佳精度;
    }

    方法节点* 评分_读取任务输入目标方法_筹办(const 任务节点* 任务头) noexcept;
    方法节点* 任务方法结构补齐目标方法(
        自我类& 自我对象,
        const 任务节点* 任务头,
        时间戳 now) noexcept;

    // 功能：按函数名执行对应处理。
    结构_方法选择评分 方法候选评分(
        自我类& 自我对象,
        任务节点* 任务头,
        方法节点* 方法,
        时间戳 now) noexcept
    {
        结构_方法选择评分 评分{};
        if (!方法类::方法是首节点(方法)) {
            return 评分;
        }

        const bool 有本能能力值 = 方法自我能力值(方法) != 0;
        const bool 有已注册本能入口 =
            私有_方法有已注册本能入口_执行桥_最小_v0(方法);
        const bool 有动作 =
            有本能能力值
            || 方法类::方法有动作(方法)
            || 方法类::方法动作数量(方法) > 0;
        const bool 有入口 =
            有已注册本能入口
            || 方法类::方法可执行入口数量(方法) > 0;
        const bool 有条件节点 = 方法类::方法条件节点数量(方法) > 0;
        const bool 有结果节点 = 方法类::方法结果节点数量(方法) > 0;
        const bool 有条件结果对 = 方法类::方法条件结果对数量(方法) > 0;
        const bool 是过程本能 = 方法是筹办过程或协作本能方法(方法);
        const bool 是学习本能 = 方法是学习补齐本能方法(方法);
        const bool 是结算叶子任务价值 = 方法是结算叶子任务价值方法(方法);
        const bool 结算前提具备 = !是结算叶子任务价值
            || 结算叶子任务价值前提具备_筹办(任务头);
        const bool 是方法结构任务 = 任务目标是方法结构补齐需求(任务头);
        const bool 是提交方法可执行入口 =
            方法是本能方法(方法, 枚举_本能方法ID::自我_提交方法可执行入口);
        const auto* 来源需求 = 任务来源需求(任务头);
        const auto* 目标特征类型 = 任务对应需求目标特征类型(任务头);

        if (方法是任务完成后处理方法(方法)) {
            评分.有效 = false;
            return 评分;
        }

        评分.有效 = true;

        评分.结果命中精度 = 方法结果能力命中精度(方法, 目标特征类型, 来源需求);
        const bool 结果可承接目标 = 评分.结果命中精度 > 0;

        // 第一层：所有可直接执行条件都满足且结果能力能承接目标的方法优先。
        // 这里先用结构可用性近似“必需条件全部满足”；具体输入参数仍在后续
        // 检查方法条件 / 配对参数阶段验证，不能在选择阶段提前提交事实。
        if (结果可承接目标 && !是过程本能 && 结算前提具备 && 有动作 && 有入口 && 有条件节点 && 有结果节点 && 有条件结果对) {
            评分.直接满足等级 = 300;
        } else if (结果可承接目标 && 是过程本能 && 有动作 && 有入口) {
            // 过程本能方法只说明“可以推进筹办过程”，不是最终状态提交者。
            // 因此它低于直接可执行方法，但高于普通不可用方法。
            评分.直接满足等级 = 100;
        } else if (结果可承接目标 && 结算前提具备 && 有动作 && 有入口) {
            评分.直接满足等级 = 20;
        } else if (结果可承接目标 && 结算前提具备 && 有动作) {
            评分.直接满足等级 = 10;
        }

        // 第二层到第四层的真实禁止项、风险、能耗以后应从方法条件节点、
        // 禁止结果、资源账读取。当前没有稳定字段时保持 0，避免臆造约束。
        评分.禁止项惩罚 = 0;
        评分.风险惩罚 = 0;
        评分.前置冲突惩罚 = 0;
        评分.耗时惩罚 = 0;
        评分.能耗惩罚 = 0;
        评分.资源惩罚 = 0;
        评分.副作用惩罚 = 0;

        // 效率和稳定性先用已有结构成熟度、条件结果对数量和本能入口作保守近似。
        评分.效率分 =
            方法类::方法成熟度阶段(方法) * 100
            + 方法类::方法条件结果对数量(方法) * 10
            + (有已注册本能入口 ? 50 : 0);
        评分.稳定性分 =
            方法类::方法成熟度阶段(方法) * 100
            + 方法类::方法条件结果对数量(方法) * 20;

        // 第五层：没有直接可执行方法时，再选能把条件变得可具备的方法。
        if (是方法结构任务 && 是学习本能) {
            评分.可补齐等级 = 900;
        } else if (是过程本能) {
            评分.可补齐等级 = 500;
        } else if (结算前提具备 && (有动作 || 有入口)) {
            评分.可补齐等级 = 100;
        }

        if (是结算叶子任务价值 && !结算前提具备) {
            评分.前置冲突惩罚 = 500;
        }
        if (是方法结构任务 && 是提交方法可执行入口) {
            auto* 被补方法 = 任务方法结构补齐目标方法(自我对象, 任务头, now);
            if (!被补方法) {
                被补方法 = 评分_读取任务输入目标方法_筹办(任务头);
            }
            const bool 被补方法已有入口能力 = 方法自我能力值(被补方法) != 0;
            if (!被补方法 || !被补方法已有入口能力) {
                评分.直接满足等级 = 0;
                评分.可补齐等级 = 0;
                评分.前置冲突惩罚 = (std::max<I64>)(评分.前置冲突惩罚, 500);
            }
        }

        评分.不确定性惩罚 = 0;
        return 评分;
    }

    // 功能：从候选集中选择当前使用对象或方法。
    方法节点* 从筹办候选集中选择当前方法(
        自我类& 自我对象,
        任务节点* 任务头,
        const std::vector<方法节点*>& 候选方法集,
        时间戳 now) noexcept
    {
        if (!任务头) {
            return nullptr;
        }

        if (候选方法集.empty()) {
            return nullptr;
        }

        auto* 已绑定方法 = reinterpret_cast<方法节点*>(任务类::读取任务执行方法(任务头));
        (void)已绑定方法;

        方法节点* 最佳方法 = nullptr;
        结构_方法选择评分 最佳评分{};
        for (auto* 方法 : 候选方法集) {
            if (方法挂载非当前本能句柄(方法)) {
                记录筹办日志("选择当前方法跳过非当前默认本能方法残留"
                    " | 任务=" + 任务主键_筹办日志(任务头)
                    + " | 方法=" + 方法主键_筹办日志(方法)
                    + " | 本能ID=" + std::to_string(方法原始本能ID值(方法)));
                continue;
            }

            const auto 分数 = 方法候选评分(自我对象, 任务头, 方法, now);
            {
                std::ostringstream 输出;
                输出 << "选择当前方法候选评分"
                    << " | 任务=" << 任务主键_筹办日志(任务头)
                    << " | 方法=" << 方法主键_筹办日志(方法)
                    << 方法本能诊断文本(方法)
                    << " | 评分=" << 方法选择评分文本(分数);
                记录筹办日志(输出.str());
            }
            const bool 分数更优 = !最佳方法 || 方法选择评分更优(分数, 最佳评分);
            const bool 分数相同 =
                最佳方法
                && !方法选择评分更优(分数, 最佳评分)
                && !方法选择评分更优(最佳评分, 分数);
            const bool 主键更稳定 =
                分数相同
                && 方法
                && 方法->获取主键() < 最佳方法->获取主键();
            if (方法 && (分数更优 || 主键更稳定)) {
                最佳方法 = 方法;
                最佳评分 = 分数;
            }
        }
        if (最佳方法) {
            std::ostringstream 输出;
            输出 << "选择当前方法完成"
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 方法=" << 方法主键_筹办日志(最佳方法)
                << 方法本能诊断文本(最佳方法)
                << " | 评分=" << 方法选择评分文本(最佳评分);
            记录筹办日志(输出.str());
        }
        return 最佳方法;
    }

    // 功能：补齐条件、参数、证据或方法能力缺口。
    方法节点* 任务方法结构补齐目标方法(
        自我类& 自我对象,
        const 任务节点* 任务头,
        时间戳 now) noexcept
    {
        if (!任务头 || !任务目标是方法结构补齐需求(任务头)) {
            return nullptr;
        }
        const auto* 来源需求 = 任务来源需求(任务头);

        if (auto* 需求目标宿主 = 需求类::解析需求目标宿主(来源需求)) {
            auto* 目标主体 = reinterpret_cast<基础信息节点类*>(
                需求目标宿主);
            if (auto* 方法 = 按方法虚拟存在查找方法(自我对象, 目标主体, now)) {
                记录筹办日志("方法结构补齐目标方法解析"
                    " | 来源=被需求存在"
                    " | 任务=" + 任务主键_筹办日志(任务头)
                    + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                    + " | 被补方法=" + 方法主键_筹办日志(方法));
                return 方法;
            }
        }

        auto* 目标主体 = 状态节点主体(需求类::解析需求目标状态(来源需求));
        if (!目标主体) {
            目标主体 = 状态节点主体(需求类::解析需求当前状态(来源需求));
        }
        if (auto* 方法 = 按方法虚拟存在查找方法(自我对象, 目标主体, now)) {
            记录筹办日志("方法结构补齐目标方法解析"
                " | 来源=状态主体"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                + " | 被补方法=" + 方法主键_筹办日志(方法));
            return 方法;
        }

        return nullptr;
    }

