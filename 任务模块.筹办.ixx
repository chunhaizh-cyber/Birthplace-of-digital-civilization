        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("值类型_场景指针", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    const 语素入口节点类* 值类型_特征类型指针_筹办() noexcept
    {
        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("值类型_特征类型指针", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    场景节点类* 创建任务可执行输入参数场景(
        const 任务节点* 任务头,
        时间戳 now) noexcept
    {
        if (!任务头 || !任务头->主信息.场景.指针) {
            return nullptr;
        }
        const auto* 场景名 = 语素集.添加信息入口词(
            "任务可执行输入_"
                + 任务主键_筹办日志(任务头)
                + "_"
                + std::to_string(now),
            枚举_信息入口类型::场景实例入口);
        return 世界树.场景().创建场景_按名称(
            reinterpret_cast<基础信息节点类*>(任务头->主信息.场景.指针),
            场景名,
            枚举_世界类型::内部世界);
    }

    const 语素入口节点类* 特征_方法结构是否完整() noexcept
    {
        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("方法结构是否完整", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    const 语素入口节点类* 特征_方法成熟度阶段() noexcept
    {
        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("成熟度阶段", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    const 语素入口节点类* 特征_方法允许自动召回() noexcept
    {
        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("允许自动召回", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    const 语素入口节点类* 特征_方法允许默认执行() noexcept
    {
        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("允许默认执行", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    void 写入方法补齐任务输入目标方法(
        任务节点* 任务头,
        方法节点* 被补方法,
        场景节点类* 输入参数场景,
        时间戳 now) noexcept
    {
        if (!任务头 || !被补方法 || !输入参数场景) {
            return;
        }
        auto* 输入包 = 世界树.确保特征(
            输入参数场景,
            特征_输入条件包());
        if (!输入包) {
            return;
        }
        (void)世界树.写入特征_指针(
            输入包,
            特征_目标方法头节点(),
            被补方法,
            now);
        void* 既有目标宿主指针 = nullptr;
        const bool 目标宿主已存在 = 世界树.读取特征_指针(
            reinterpret_cast<基础信息节点类*>(输入包),
            特征_目标宿主(),
            既有目标宿主指针)
            && 既有目标宿主指针;
        if (!目标宿主已存在 && 世界树.自我指针) {
            // 方法补齐练习的目标方法通过“目标方法头节点”表达；
            // 对象作用方法仍需要一个真实作用宿主，不能把方法虚拟存在当作业务目标。
            (void)世界树.写入特征_指针(
                输入包,
                特征_目标宿主(),
                世界树.自我指针,
                now);
        }
        (void)世界树.写入特征_指针(
            输入包,
            特征_任务信息节点_筹办(),
            任务头,
            now);
        if (auto* 来源需求 = 任务来源需求(任务头)) {
            (void)世界树.写入特征_指针(
                输入包,
                特征_来源需求_筹办(),
                来源需求,
                now);
            if (auto* 目标特征类型 = 需求目标特征类型(来源需求)) {
                // 学习方法执行时以条件节点绑定输入。被补方法只说明“补谁”，
                // 目标特征类型说明“补这个方法的哪个状态/结构槽”，二者缺一不可。
                (void)世界树.写入特征_指针(
                    输入包,
                    特征_目标特征类型(),
                    目标特征类型,
                    now);
                (void)世界树.写入特征_指针(
                    输入包,
                    特征_目标抽象特征(),
                    目标特征类型,
                    now);
            }
        }
        {
            std::ostringstream 输出;
            const auto& 动作句柄 = 被补方法->主信息.首节点信息().动作句柄;
            输出 << "写入方法补齐任务目标"
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 被补方法=" << 方法主键_筹办日志(被补方法)
                << " | 被补方法有方法动作=" << (被补方法->主信息.有方法动作() ? 1 : 0)
                << " | 被补方法动作句柄有效=" << (动作句柄.有效() ? 1 : 0)
                << " | 被补方法动作句柄类型=" << static_cast<int>(动作句柄.类型)
                << " | 被补方法本能ID=" << 动作句柄.本能ID
                << " | 目标特征=" << 入口主键_筹办日志(任务对应需求目标特征类型(任务头));
            记录筹办日志(输出.str());
        }
    }

    void 写入方法补齐任务输入目标方法(
        任务节点* 任务头,
        方法节点* 被补方法,
        时间戳 now) noexcept
    {
        auto* 输入参数场景 = 创建任务可执行输入参数场景(任务头, now);
        写入方法补齐任务输入目标方法(
            任务头,
            被补方法,
            输入参数场景,
            now);
    }

    bool 方法结果项命中目标特征(
        const 结构_方法结果项& 结果项,
        const 语素入口节点类* 目标特征类型) noexcept
    {
        if (!目标特征类型) {
            return false;
        }
        if (结果项.关系目标特征类型由参数决定()) {
            return 结果项.关系目标特征类型参数() != nullptr;
        }
        return 语素入口同一(结果项.关系目标特征类型(), 目标特征类型);
    }

    bool 方法结果能力命中目标特征(
        方法节点* 方法,
        const 语素入口节点类* 目标特征类型) noexcept
    {
        if (!方法
            || 方法->主信息.节点种类() != 枚举_方法节点种类::方法首节点
            || !目标特征类型) {
            return false;
        }
        if (方法是先天特征写入逻辑(方法)
            || 方法是专用提交入口方法(方法)) {
            return false;
        }
        auto* 首信息 = 方法->主信息.取首节点信息();
        if (!首信息
            || !首信息->能力.可被方法查找命中
            || 首信息->能力.是否根写入原语) {
            return false;
        }
        for (const auto& 结果项 : 首信息->能力.结果包.结果项集) {
            if (方法结果项命中目标特征(结果项, 目标特征类型)) {
                return true;
            }
        }
        return false;
    }

    bool 方法已有参数化结果能力(
        方法节点* 方法,
        const 语素入口节点类* 特征类型参数) noexcept
    {
        auto* 首信息 = 方法 && 方法->主信息.是否方法首节点()
            ? 方法->主信息.取首节点信息()
            : nullptr;
        if (!首信息 || !特征类型参数) {
            return false;
        }
        for (const auto& 结果项 : 首信息->能力.结果包.结果项集) {
            if (结果项.关系目标特征类型由参数决定()
                && 语素入口同一(结果项.关系目标特征类型参数(), 特征类型参数)) {
                return true;
            }
        }
        return false;
    }

    void 标记历史特征写入入口为先天逻辑(方法节点* 方法) noexcept
    {
        // 历史特征写入入口是底层写入原语，不是任务可选择方法。
        // 历史方法树若残留对应方法头，必须标记为根写入原语并排除出普通候选召回。
        auto* 首信息 = 方法 && 方法->主信息.是否方法首节点()
            ? 方法->主信息.取首节点信息()
            : nullptr;
        if (!首信息) {
            return;
        }
        首信息->能力.可被方法查找命中 = false;
        首信息->能力.是否根写入原语 = true;
    }

    std::size_t 追加方法到筹办候选集(
        自我类& 自我对象,
        任务节点* 任务头,
        std::vector<方法节点*>& 候选方法集,
        方法节点* 方法,
        时间戳 now,
        const char* 来源) noexcept
    {
        if (!任务头 || !方法 || 方法->主信息.节点种类() != 枚举_方法节点种类::方法首节点) {
            return 0;
        }
        if (方法是历史任务生命周期方法残留(方法)) {
            // 任务筹办/任务执行是任务管理生命周期普通函数，由工作线程按任务状态直接调用。
            // 历史方法树中若残留对应方法头，也不能进入候选方法集。
            记录筹办日志("候选集填充跳过任务生命周期函数残留方法"
                " | 来源=" + std::string(来源 ? 来源 : "空")
                + " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 方法=" + 方法主键_筹办日志(方法));
            return 0;
        }
        if (方法是先天特征写入逻辑(方法)) {
            标记历史特征写入入口为先天逻辑(方法);
            记录筹办日志("候选集填充跳过先天特征写入逻辑"
                " | 来源=" + std::string(来源 ? 来源 : "空")
                + " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 方法=" + 方法主键_筹办日志(方法));
            return 0;
        }
        if (方法挂载非当前本能句柄(方法)) {
            记录筹办日志("候选集填充跳过非当前默认本能方法残留"
                " | 来源=" + std::string(来源 ? 来源 : "空")
                + " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 方法=" + 方法主键_筹办日志(方法)
                + " | 本能ID=" + std::to_string(方法原始本能ID值(方法)));
            return 0;
        }
        if (方法是任务完成后处理方法(方法)) {
            记录筹办日志("候选集填充跳过任务完成后处理方法"
                " | 来源=" + std::string(来源 ? 来源 : "空")
                + " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 方法=" + 方法主键_筹办日志(方法)
                + " | 说明=结算叶子任务价值由任务完成后的价值结算链调用，不作为普通筹办当前方法");
            return 0;
        }
        if (方法是专用提交入口方法(方法)) {
            记录筹办日志("候选集填充跳过专用提交入口方法"
                " | 来源=" + std::string(来源 ? 来源 : "空")
                + " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 方法=" + 方法主键_筹办日志(方法)
                + " | 说明=OR组结算令牌只能由逻辑组织提交链调用，不作为普通筹办当前方法");
            return 0;
        }
        if (任务应跳过价值目标空占位方法(任务头, 方法)) {
            记录筹办日志("候选集填充跳过安全服务值空占位方法"
                " | 来源=" + std::string(来源 ? 来源 : "空")
                + " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 方法=" + 方法主键_筹办日志(方法)
                + " | 目标特征=" + 入口主键_筹办日志(任务对应需求目标特征类型(任务头))
                + " | 说明=安全值/服务值由叶子任务价值结算回传，不把运行时空方法头当作可补动作方法");
            return 0;
        }

        auto* 自我存在 = 自我对象.确保自我存在();
        auto* 方法存在 = 方法->主信息.首节点信息().方法虚拟存在.指针
            ? 方法->主信息.首节点信息().方法虚拟存在.指针
            : 方法虚拟存在服务类::取或创建方法虚拟存在(方法, 自我存在, now);
        if (!方法存在) {
            return 0;
        }

        for (auto* 已有 : 候选方法集) {
            if (已有 == 方法
                || (已有 && 已有->获取主键() == 方法->获取主键())) {
                return 0;
            }
        }
        候选方法集.push_back(方法);
        {
            std::ostringstream 输出;
            输出 << "候选集填充"
                << " | 来源=" << (来源 ? 来源 : "空")
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 方法=" << 方法主键_筹办日志(方法)
                << " | 方法虚拟存在=" << 基础主键_筹办日志(reinterpret_cast<基础信息节点类*>(方法存在))
                << " | 候选数=" << 候选方法集.size()
                << " | 提交方式=筹办回执";
            记录筹办日志(输出.str());
        }
        return 1u;
    }

    std::size_t 填充候选集_按结果能力(
        自我类& 自我对象,
        任务节点* 任务头,
        std::vector<方法节点*>& 候选方法集,
        方法节点* 方法根节点,
        const 语素入口节点类* 目标特征类型,
        时间戳 now) noexcept
    {
        if (!任务头 || !方法根节点 || !目标特征类型) {
            return 0;
        }

        const auto 填充开始 = std::chrono::steady_clock::now();
        std::size_t 新增数量 = 0;
        std::vector<方法节点*> 待访问{};
        std::vector<方法节点*> 已入栈{};

        const auto 已记录节点 = [&](const 方法节点* 节点) noexcept {
            for (const auto* 已记录 : 已入栈) {
                if (已记录 == 节点) {
                    return true;
                }
            }
            return false;
        };

        const auto 压入待访问 = [&](方法节点* 节点) noexcept {
            if (!节点 || 已记录节点(节点)) {
                return;
            }
            已入栈.push_back(节点);
            待访问.push_back(节点);
        };

        const auto 压入直接子链 = [&](方法节点* 父节点) noexcept {
            auto* 首子 = 父节点
                ? static_cast<方法节点*>(父节点->子)
                : nullptr;
            if (!首子) {
                return;
            }

            // 节点的兄弟链可能是环形链，也可能以空指针结束；两种情况都要安全枚举。
            auto* 当前子 = 首子;
            std::size_t 兄弟保护计数 = 0;
            do {
                压入待访问(当前子);
                当前子 = static_cast<方法节点*>(当前子->下);
                ++兄弟保护计数;
            } while (当前子 && 当前子 != 首子 && 兄弟保护计数 < 4096);

            if (兄弟保护计数 >= 4096) {
                记录筹办日志("候选集填充全树遍历兄弟链达到保护上限"
                    " | 任务=" + 任务主键_筹办日志(任务头)
                    + " | 父方法=" + 方法主键_筹办日志(父节点)
                    + " | 目标特征=" + 入口主键_筹办日志(目标特征类型));
            }
        };

        // 从方法根开始做全树遍历，而不是只看根下一层。根本身若不是方法首节点会被命中检查自然过滤。
        压入待访问(方法根节点);

        std::size_t 访问计数 = 0;
        constexpr std::size_t 访问保护上限 = 65536;
        while (!待访问.empty() && 访问计数 < 访问保护上限) {
            auto* 当前 = 待访问.back();
            待访问.pop_back();
            ++访问计数;

            if (方法结果能力命中任务需求(当前, 任务头, 目标特征类型)) {
                新增数量 += 追加方法到筹办候选集(
                    自我对象,
                    任务头,
                    候选方法集,
                    当前,
                    now,
                    "结果能力");
            }

            压入直接子链(当前);
        }

        {
            std::ostringstream 输出;
            const auto 填充耗时 = std::chrono::duration_cast<std::chrono::milliseconds>(
                std::chrono::steady_clock::now() - 填充开始).count();
            输出 << "候选集填充全树遍历完成"
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 目标特征=" << 入口主键_筹办日志(目标特征类型)
                << " | 访问节点数=" << 访问计数
                << " | 新增候选数=" << 新增数量
                << " | 耗时ms=" << 填充耗时
                << " | 达到保护上限=" << (访问计数 >= 访问保护上限 ? 1 : 0);
            记录筹办日志(输出.str());
        }

        return 新增数量;
    }

    方法节点* 任务已绑定非治理方法(
        自我类* 自我对象,
        任务节点* 任务头,
        时间戳 now) noexcept;

    void 填充任务方法候选集(
        自我类& 自我对象,
        任务节点* 任务头,
        std::vector<方法节点*>& 候选方法集,
        方法节点* 方法根节点,
        时间戳 now,
        bool* 输出已新建占位方法) noexcept
    {
        if (输出已新建占位方法) {
            *输出已新建占位方法 = false;
        }
        if (!任务头 || !方法根节点) {
            return;
        }

        if (auto* 已绑定方法 = 任务已绑定非治理方法(&自我对象, 任务头, now)) {
            (void)追加方法到筹办候选集(
                自我对象,
                任务头,
                候选方法集,
                已绑定方法,
                now,
                "已绑定方法");
        }

        const auto* 目标特征类型 = 任务对应需求目标特征类型(任务头);
        if (!目标特征类型) {
            return;
        }
        (void)填充候选集_按结果能力(
            自我对象,
            任务头,
            候选方法集,
            方法根节点,
            目标特征类型,
            now);

        const auto 候选数量 = 候选方法集.size();
        {
            std::ostringstream 输出;
            输出 << "候选集填充完成"
                << " | 对应普通步骤=候选整理"
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 来源需求=" << 需求主键_筹办日志(任务来源需求(任务头))
                << " | 目标特征=" << 入口主键_筹办日志(目标特征类型)
                << " | 候选数=" << 候选数量;
            记录筹办日志(输出.str());
        }
        if (候选数量 > 0) {
            return;
        }

        if (特征是学习信息补齐状态(目标特征类型)) {
            记录筹办日志("学习信息补齐目标未创建空占位方法头"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 来源需求=" + 需求主键_筹办日志(任务来源需求(任务头))
                + " | 目标特征=" + 入口主键_筹办日志(目标特征类型)
                + " | 说明=泛化学习缺口必须由明确方法结构缺口或既有学习本能承接，不为学习信息补齐状态自身沉淀占位方法");
            return;
        }

        if (任务目标是安全服务值(任务头)) {
            记录筹办日志("安全服务值目标未创建空占位方法头"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 来源需求=" + 需求主键_筹办日志(任务来源需求(任务头))
                + " | 目标特征=" + 入口主键_筹办日志(目标特征类型)
                + " | 说明=等待叶子任务完成后由结算叶子任务价值方法回传");
            return;
        }

        const auto 原方法根子节点数 = 方法根节点->子节点数量;
        // 只有在方法树没有任何可召回候选时才创建占位方法头，并放入本轮筹办回执候选集。
        auto* 目标方法 = 方法类::注册需求位方法首节点(
            方法根节点,
            目标特征类型,
            枚举_方法来源::运行时方法沉淀,
            now);
        if (!目标方法) {
            return;
        }
        if (输出已新建占位方法) {
            *输出已新建占位方法 = 方法根节点->子节点数量 > 原方法根子节点数;
        }
        写入任务节点引用(目标方法->主信息.首节点信息().来源任务, 任务头);
        (void)追加方法到筹办候选集(
            自我对象,
            任务头,
            候选方法集,
            目标方法,
            now,
            "占位方法头");
        {
            std::ostringstream 输出;
            输出 << "按需求目标创建占位方法头并加入候选集"
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 来源需求=" << 需求主键_筹办日志(任务来源需求(任务头))
                << " | 目标特征=" << 入口主键_筹办日志(目标特征类型)
                << " | 方法=" << 方法主键_筹办日志(目标方法)
                << " | 新建=" << (输出已新建占位方法 && *输出已新建占位方法 ? 1 : 0);
            记录筹办日志(输出.str());
        }
    }

    基础信息节点类* 任务参数缺口目标主体(
        任务节点* 任务头,
        方法节点* 目标方法,
        时间戳 now) noexcept
    {
        if (!任务头 || !任务头->主信息.场景.指针) {
            return nullptr;
        }
        auto* 任务虚拟存在 = 任务类::取或创建_任务虚拟存在(
            任务头,
            任务头->主信息.场景.指针);
        if (任务虚拟存在) {
            if (目标方法) {
                (void)世界树.写入特征_指针(
                    reinterpret_cast<基础信息节点类*>(任务虚拟存在),
                    特征_目标方法头节点(),
                    目标方法,
                    now);
            }
            return reinterpret_cast<基础信息节点类*>(任务虚拟存在);
        }
        auto* 参数缺口场景 = 创建任务可执行输入参数场景(任务头, now);
        auto* 输入包 = 参数缺口场景
            ? 世界树.确保特征(参数缺口场景, 特征_输入条件包())
            : nullptr;
        if (!输入包) {
            return reinterpret_cast<基础信息节点类*>(任务头->主信息.场景.指针);
        }
        if (目标方法) {
            (void)世界树.写入特征_指针(
                输入包,
                特征_目标方法头节点(),
                目标方法,
                now);
        }
        return reinterpret_cast<基础信息节点类*>(输入包);
    }

    bool 方法结果能力需要目标执行值(
        方法节点* 方法,
        const 语素入口节点类* 目标特征类型) noexcept
    {
        auto* 首信息 = 方法 && 方法->主信息.是否方法首节点()
            ? 方法->主信息.取首节点信息()
            : nullptr;
        if (!首信息) {
            return false;
        }

        for (const auto& 结果项 : 首信息->能力.结果包.结果项集) {
            if (结果项.关系目标特征类型由参数决定() && 结果项.关系目标特征类型参数()) {
                // 参数化结果能力表示“本方法本轮要改变哪个特征”由输入决定。
                // 因此筹办阶段不能只绑定特征类型，还必须拿到本轮目标值或差值出处。
                return true;
            }
            if (!结果项.关系目标特征类型由参数决定()
                && 目标特征类型
                && 语素入口同一(结果项.关系目标特征类型(), 目标特征类型)
                && 结果项.声明了执行目标值约束()) {
                // 固定特征类型但声明了结果关系约束的方法，也需要目标值或差值来形成可执行输入。
                return true;
            }
        }
        return false;
    }

    const 语素入口节点类* 评分_特征_输入条件包_筹办() noexcept
    {
        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("输入条件包", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    const 语素入口节点类* 评分_特征_目标方法头节点_筹办() noexcept
    {
        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("目标方法头节点", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    方法节点* 评分_读取任务输入目标方法_筹办(const 任务节点* 任务头) noexcept
    {
        if (!任务头 || !任务头->主信息.场景.指针) {
            return nullptr;
        }
        auto* 输入包 = 世界树.特征().查找子特征_按类型(
            reinterpret_cast<基础信息节点类*>(任务头->主信息.场景.指针),
            评分_特征_输入条件包_筹办());
        void* 指针 = nullptr;
        return 输入包
            && 世界树.读取特征_指针(
                reinterpret_cast<基础信息节点类*>(输入包),
                评分_特征_目标方法头节点_筹办(),
                指针)
            && 指针
            ? reinterpret_cast<方法节点*>(指针)
            : nullptr;
    }

    特征节点类* 查找子特征_筹办(
        基础信息节点类* 宿主,
        const 语素入口节点类* 特征类型) noexcept
    {
        return 宿主 && 特征类型
            ? 世界树.特征().查找子特征_按类型(宿主, 特征类型)
            : nullptr;
    }

    const 语素入口节点类* 特征节点类型_筹办(const 特征节点类* 特征) noexcept
    {
        const auto* 主信息 = 世界树.特征().取特征主信息(特征);
        return 主信息 ? 主信息->类型 : nullptr;
    }

    bool 特征已有真实值_筹办(const 特征节点类* 特征) noexcept
    {
        if (!特征) {
            return false;
        }

        const auto 值 = 世界树.读取特征快照(特征);
        const auto* 特征类型 = 特征节点类型_筹办(特征);
        if (语素入口同一(特征类型, 特征_选中自我能力值())) {
            const auto* 能力值 = std::get_if<I64>(&值);
            return 能力值 && *能力值 != 0;
        }
        if (语素入口同一(特征类型, 特征_任务状态_筹办())) {
            const auto* 任务状态 = std::get_if<I64>(&值);
            return 任务状态 && *任务状态 != static_cast<I64>(枚举_任务状态::未定义);
        }
        if (std::holds_alternative<std::monostate>(值)) {
            return false;
        }
        if (const auto* 指针值 = std::get_if<指针句柄>(&值)) {
            return 指针值->有效();
        }
        if (const auto* Vec值 = std::get_if<VecU句柄>(&值)) {
            return Vec值->有效();
        }
        return true;
    }

    bool 输入宿主包含实参值_筹办(
        基础信息节点类* 输入宿主,
        const 语素入口节点类* 参数特征类型) noexcept
    {
        return 特征已有真实值_筹办(
            查找子特征_筹办(输入宿主, 参数特征类型));
    }

    bool 输入场景包含实参值_筹办(
        场景节点类* 输入参数场景,
        特征节点类* 输入条件包,
        const 语素入口节点类* 参数特征类型) noexcept
    {
        if (!输入参数场景 || !参数特征类型) {
            return false;
        }
        if (语素入口同一(参数特征类型, 特征_输入条件包())) {
            return 输入条件包 != nullptr;
        }

        auto* 场景宿主 = reinterpret_cast<基础信息节点类*>(输入参数场景);
        if (输入宿主包含实参值_筹办(场景宿主, 参数特征类型)) {
            return true;
        }
        if (输入宿主包含实参值_筹办(
                reinterpret_cast<基础信息节点类*>(输入条件包),
                参数特征类型)) {
            return true;
        }

        for (const auto* 包类型 : { 特征_任务参数包_筹办(), 特征_现实场景包_筹办() }) {
            auto* 包 = 查找子特征_筹办(场景宿主, 包类型);
            if (输入宿主包含实参值_筹办(
                    reinterpret_cast<基础信息节点类*>(包),
                    参数特征类型)) {
                return true;
            }
        }
        return false;
    }

    bool 形参节点是必需_筹办(特征节点类* 形参节点) noexcept
    {
        I64 是否必需 = 1;
        (void)世界树.读取特征_I64(
            reinterpret_cast<基础信息节点类*>(形参节点),
            特征_是否必需_筹办(),
            是否必需);
        return 是否必需 != 0;
    }

    const 语素入口节点类* 形参节点值类型_筹办(特征节点类* 形参节点) noexcept
    {
        void* 值类型指针 = nullptr;
        if (!形参节点
            || !世界树.读取特征_指针(
                reinterpret_cast<基础信息节点类*>(形参节点),
                特征_参数值类型_筹办(),
                值类型指针)
            || !值类型指针) {
            return nullptr;
        }
        return reinterpret_cast<const 语素入口节点类*>(值类型指针);
    }

    bool 参数值类型为I64_筹办(特征节点类* 形参节点) noexcept
    {
        const auto* 值类型 = 形参节点值类型_筹办(形参节点);
        return 语素入口同一(值类型, 值类型_I64_筹办())
            || 语素入口同一(值类型, 值类型_类型I64_筹办());
    }

    bool 参数值类型为指针_筹办(特征节点类* 形参节点) noexcept
    {
        const auto* 值类型 = 形参节点值类型_筹办(形参节点);
        return 语素入口同一(值类型, 值类型_场景指针_筹办())
            || 语素入口同一(值类型, 值类型_特征类型指针_筹办());
    }

    struct 结构_必需实参检查结果 {
        I64 必需参数数量 = 0;
        I64 已绑定参数数量 = 0;
        I64 缺失参数数量 = 0;
        const 语素入口节点类* 首个缺失参数特征类型 = nullptr;

        bool 成功() const noexcept
        {
            return 缺失参数数量 == 0;
        }
    };

    特征节点类* 方法形参表_筹办(方法节点* 目标方法, 时间戳 now) noexcept
    {
        auto* 方法存在 = 目标方法 && 目标方法->主信息.是否方法首节点()
            ? (目标方法->主信息.首节点信息().方法虚拟存在.指针
                ? 目标方法->主信息.首节点信息().方法虚拟存在.指针
                : 方法虚拟存在服务类::取或创建方法虚拟存在(目标方法, nullptr, now))
            : nullptr;
        return 查找子特征_筹办(
            reinterpret_cast<基础信息节点类*>(方法存在),
            特征_形参表_筹办());
    }

    结构_必需实参检查结果 检查候选方法必需实参(
        方法节点* 目标方法,
        场景节点类* 输入参数场景,
        特征节点类* 输入条件包,
        时间戳 now) noexcept
    {
        结构_必需实参检查结果 结果{};
        if (!目标方法 || !输入参数场景) {
            return 结果;
        }

        auto* 形参表 = 方法形参表_筹办(目标方法, now);
        if (!形参表) {
            return 结果;
        }

        for (auto* 形参节点 : 世界树.特征().获取子特征(
                 reinterpret_cast<基础信息节点类*>(形参表))) {
            if (!形参节点 || !形参节点是必需_筹办(形参节点)) {
                continue;
            }

            const auto* 参数特征类型 = 特征节点类型_筹办(形参节点);
            if (!参数特征类型) {
                continue;
            }

            ++结果.必需参数数量;
            if (输入场景包含实参值_筹办(输入参数场景, 输入条件包, 参数特征类型)) {
                ++结果.已绑定参数数量;
                continue;
            }

            ++结果.缺失参数数量;
            if (!结果.首个缺失参数特征类型) {
                结果.首个缺失参数特征类型 = 参数特征类型;
            }
        }
        return 结果;
    }

    inline constexpr I64 筹办安全因果证据方向_负向 = 1;

    bool 读取基础节点I64_筹办(
        基础信息节点类* 宿主,
        const 语素入口节点类* 特征类型,
        I64& 输出值) noexcept
    {
        输出值 = 0;
        return 宿主
            && 特征类型
            && 世界树.读取特征_I64(宿主, 特征类型, 输出值);
    }

    bool 读取基础节点指针_筹办(
        基础信息节点类* 宿主,
        const 语素入口节点类* 特征类型,
        void*& 输出指针) noexcept
    {
        输出指针 = nullptr;
        return 宿主
            && 特征类型
            && 世界树.读取特征_指针(宿主, 特征类型, 输出指针)
            && 输出指针;
    }

    bool 输入包写入I64_若缺失_筹办(
        特征节点类* 输入条件包,
        const 语素入口节点类* 特征类型,
        I64 值,
        时间戳 now) noexcept
    {
        auto* 输入宿主 = reinterpret_cast<基础信息节点类*>(输入条件包);
        if (!输入宿主 || !特征类型) {
            return false;
        }
        if (输入宿主包含实参值_筹办(输入宿主, 特征类型)) {
            return true;
        }
        return 世界树.写入特征_I64(输入条件包, 特征类型, 值, now);
    }

    bool 输入包写入指针_若缺失_筹办(
        特征节点类* 输入条件包,
        const 语素入口节点类* 特征类型,
        const void* 指针,
        时间戳 now) noexcept
    {
        auto* 输入宿主 = reinterpret_cast<基础信息节点类*>(输入条件包);
        if (!输入宿主 || !特征类型 || !指针) {
            return false;
        }
        if (输入宿主包含实参值_筹办(输入宿主, 特征类型)) {
            return true;
        }
        return 世界树.写入特征_指针(输入条件包, 特征类型, 指针, now);
    }

    bool 从目标宿主复制I64实参_筹办(
        基础信息节点类* 目标宿主,
        特征节点类* 输入条件包,
        const 语素入口节点类* 特征类型,
        时间戳 now) noexcept
    {
        I64 值 = 0;
        if (!读取基础节点I64_筹办(目标宿主, 特征类型, 值)) {
            return false;
        }
        return 输入包写入I64_若缺失_筹办(
            输入条件包,
            特征类型,
            值,
            now);
    }

    bool 从目标宿主复制指针实参_筹办(
        基础信息节点类* 目标宿主,
        特征节点类* 输入条件包,
        const 语素入口节点类* 特征类型,
        时间戳 now) noexcept
    {
        void* 指针 = nullptr;
        if (!读取基础节点指针_筹办(目标宿主, 特征类型, 指针)) {
            return false;
        }
        return 输入包写入指针_若缺失_筹办(
            输入条件包,
            特征类型,
            指针,
            now);
    }

    struct 结构_因果搜索输入上下文_筹办 {
        bool 有效 = false;
        I64 证据方向 = 0;
    };

    结构_因果搜索输入上下文_筹办 构造因果搜索输入上下文_筹办(
        因果节点类* 来源因果) noexcept
    {
        结构_因果搜索输入上下文_筹办 结果{};
        if (!来源因果) {
            return 结果;
        }

        结果.证据方向 = 筹办安全因果证据方向_负向;
        结果.有效 =
            结果.证据方向 != 0;
        return 结果;
    }

    因果节点类* 解析因果信息节点_筹办(基础信息节点类* 节点) noexcept
    {
        auto* 候选 = reinterpret_cast<因果节点类*>(节点);
        return 候选 && 世界树.因果().取因果主信息(候选)
            ? 候选
            : nullptr;
    }

    因果节点类* 解析任务来源因果信息_筹办(
        任务节点* 任务头,
        基础信息节点类* 目标宿主) noexcept
    {
        auto* 来源需求 = 任务来源需求(任务头);
        if (来源需求) {
            const auto& 来源因果主键 =
                需求类::读取派生来源因果主键_兼容(来源需求->主信息);
            if (!来源因果主键.empty()) {
                if (auto* 因果 = 解析因果信息节点_筹办(
                        世界树.基础信息().查找主键(来源因果主键))) {
                    return 因果;
                }
            }

            需求类 需求服务{};
            if (auto* 目标比较 = 需求服务.获取需求方向(来源需求)) {
                if (auto* 因果 = 查找安全因果风险树来源因果_筹办查询(目标比较)) {
                    return 因果;
                }
            }
        }

        void* 目标宿主因果指针 = nullptr;
        if (读取基础节点指针_筹办(
                目标宿主,
                特征_目标安全因果信息_筹办(),
                目标宿主因果指针)) {
            if (auto* 因果 = 解析因果信息节点_筹办(
                    reinterpret_cast<基础信息节点类*>(目标宿主因果指针))) {
                return 因果;
            }
        }
        return nullptr;
    }

    bool 安全因果搜索输入已绑定I64_筹办(
        场景节点类* 输入参数场景,
        特征节点类* 输入条件包,
        const 语素入口节点类* 特征类型,
        I64& 输出值) noexcept
    {
        输出值 = 0;
        if (!输入参数场景 || !特征类型) {
            return false;
        }
        auto* 输入场景宿主 = reinterpret_cast<基础信息节点类*>(输入参数场景);
        if (读取基础节点I64_筹办(输入场景宿主, 特征类型, 输出值)) {
            return true;
        }
        return 读取基础节点I64_筹办(
            reinterpret_cast<基础信息节点类*>(输入条件包),
            特征类型,
            输出值);
    }

    bool 补齐安全因果搜索输入参数_筹办(
        任务节点* 任务头,
        方法节点* 目标方法,
        场景节点类* 输入参数场景,
        特征节点类* 输入条件包,
        基础信息节点类* 目标宿主,
        const 语素入口节点类* 目标特征类型,
        时间戳 now) noexcept
    {
        if (!方法是本能方法(目标方法, 枚举_本能方法ID::安全_搜索安全因果因素证据)
            || !输入参数场景
            || !输入条件包) {
            return true;
        }

        const auto 复制 = [&](const 语素入口节点类* 特征类型) noexcept -> bool {
            return 从目标宿主复制I64实参_筹办(
                目标宿主,
                输入条件包,
                特征类型,
                now);
        };

        (void)复制(特征_安全因果证据方向_筹办());
        (void)复制(特征_安全因果搜索时间窗口_筹办());
        (void)复制(特征_安全因果因素搜索范围完整状态_筹办());
        (void)复制(特征_安全因果因素负向证据数量_筹办());
        (void)复制(特征_安全因果因素正向证据数量_筹办());
        (void)复制(特征_安全因果因素稳定性证据数量_筹办());
        (void)复制(特征_安全因果因素归因证据数量_筹办());
        (void)复制(特征_安全因果因素材料缺失数量_筹办());
        (void)复制(特征_安全因果因素冲突数量_筹办());
        (void)复制(特征_安全因果因素搜索置信度_筹办());
        (void)复制(特征_安全因果因素评估值候选_筹办());

        auto* 来源因果信息 = 解析任务来源因果信息_筹办(任务头, 目标宿主);
        const auto 搜索上下文 = 构造因果搜索输入上下文_筹办(来源因果信息);
        const bool 补写目标因果 = 输入包写入指针_若缺失_筹办(
            输入条件包,
            特征_目标安全因果信息_筹办(),
            来源因果信息,
            now);
        const bool 从来源因果补写方向 =
            搜索上下文.有效
            && 输入包写入I64_若缺失_筹办(
                输入条件包,
                特征_安全因果证据方向_筹办(),
                搜索上下文.证据方向,
                now);

        I64 证据方向 = 0;
        const bool 方向已绑定 = 安全因果搜索输入已绑定I64_筹办(
            输入参数场景,
            输入条件包,
            特征_安全因果证据方向_筹办(),
            证据方向);

        bool 补写方向 = false;
        if (!方向已绑定
            && 来源因果信息
            && 语素入口同一(目标特征类型, 特征_安全因果因素证据搜索状态_筹办())) {
           补写方向 = 输入包写入I64_若缺失_筹办(
                输入条件包,
                特征_安全因果证据方向_筹办(),
                筹办安全因果证据方向_负向,
                now);
        }

        const bool 方向最终已绑定 = 方向已绑定 || 从来源因果补写方向 || 补写方向;
        const bool 来源因果最终已绑定 =
            来源因果信息 && (补写目标因果
                || 输入宿主包含实参值_筹办(
                    reinterpret_cast<基础信息节点类*>(输入条件包),
                    特征_目标安全因果信息_筹办()));
        std::ostringstream 输出;
        输出 << "安全因果搜索参数筹办"
            << " | 当前方法=" << 方法主键_筹办日志(目标方法)
            << " | 目标宿主=" << 基础主键_筹办日志(目标宿主)
            << " | 目标特征=" << 入口主键_筹办日志(目标特征类型)
            << " | 来源因果已绑定=" << (来源因果最终已绑定 ? 1 : 0)
            << " | 证据方向已绑定=" << (方向最终已绑定 ? 1 : 0)
            << " | 补写负向证据方向=" << (补写方向 ? 1 : 0)
            << " | 来源因果=" << 基础主键_筹办日志(来源因果信息)
            << " | 从来源因果补写方向=" << (从来源因果补写方向 ? 1 : 0)
            << " | 搜索不使用层级=1"
            << " | 不使用风险因素上下文=1"
            << " | 不使用安全因果因素ID形参=1"
            << " | 不生成需求=1"
            << " | 不写默认满足=1";
        记录筹办日志(输出.str());
        return true;
    }

    enum class 枚举_候选方法输入闭合状态 {
        已闭合 = 0,
        缺目标基础 = 1,
        缺目标执行值 = 2,
        输入包创建失败 = 3,
        输入参数写入失败 = 4,
        缺必需实参 = 5,
    };

    struct 结构_候选方法输入闭合结果 {
        枚举_候选方法输入闭合状态 状态 = 枚举_候选方法输入闭合状态::已闭合;
        const 语素入口节点类* 缺口特征类型 = nullptr;
        I64 必需参数数量 = 0;
        I64 已绑定参数数量 = 0;
        I64 缺失参数数量 = 0;

        bool 成功() const noexcept
        {
            return 状态 == 枚举_候选方法输入闭合状态::已闭合;
        }
    };

    struct 结构_通用参数绑定上下文 {
        任务节点* 任务头 = nullptr;
        方法节点* 当前方法 = nullptr;
        方法节点* 输入目标方法覆盖 = nullptr;
        基础信息节点类* 目标宿主 = nullptr;
        const 语素入口节点类* 目标特征类型 = nullptr;
        const 状态节点类* 当前状态 = nullptr;
        场景节点类* 输入参数场景 = nullptr;
        特征节点类* 输入条件包 = nullptr;
        bool 有目标执行后值 = false;
        I64 目标执行后值 = 0;
        时间戳 now = 0;
    };

    结构_候选方法输入闭合结果 通用绑定候选方法输入参数_筹办(
        const 结构_通用参数绑定上下文& 上下文) noexcept
    {
        if (!上下文.任务头
            || !上下文.当前方法
            || !上下文.目标宿主
            || !上下文.目标特征类型
            || !上下文.输入参数场景
            || !上下文.输入条件包) {
            return {
                枚举_候选方法输入闭合状态::输入参数写入失败,
                特征_输入条件包(),
            };
        }

        bool ok = true;
        auto* 输入包宿主 = reinterpret_cast<基础信息节点类*>(上下文.输入条件包);
        auto* 输入目标方法默认 = 上下文.输入目标方法覆盖
            ? 上下文.输入目标方法覆盖
            : 上下文.当前方法;

        const auto 写指针 = [&]<typename T>(
            const 语素入口节点类* 特征类型,
            T* 值,
            bool 允许覆盖) noexcept -> bool {
            if (!特征类型 || !值) {
                return true;
            }
            auto* 既有特征 = 查找子特征_筹办(输入包宿主, 特征类型);
            if (!允许覆盖 && 特征已有真实值_筹办(既有特征)) {
                return true;
            }
            return 世界树.写入特征_指针(
                上下文.输入条件包,
                特征类型,
                值,
                上下文.now);
        };

        const auto 写I64 = [&](
            const 语素入口节点类* 特征类型,
            I64 值,
            bool 允许覆盖) noexcept -> bool {
            if (!特征类型) {
                return true;
            }
            auto* 既有特征 = 查找子特征_筹办(输入包宿主, 特征类型);
            if (!允许覆盖 && 特征已有真实值_筹办(既有特征)) {
                return true;
            }
            return 世界树.写入特征_I64(
                上下文.输入条件包,
                特征类型,
                值,
                上下文.now);
        };

        auto* 既有目标方法特征 = 查找子特征_筹办(
            输入包宿主,
            特征_目标方法头节点());
        const bool 目标方法允许覆盖 =
            上下文.输入目标方法覆盖 || !特征已有真实值_筹办(既有目标方法特征);
        ok = 写指针(
            特征_目标方法头节点(),
            输入目标方法默认,
            目标方法允许覆盖) && ok;
        ok = 写指针(
            特征_目标宿主(),
            上下文.目标宿主,
            true) && ok;
        ok = 写指针(
            特征_目标特征类型(),
            上下文.目标特征类型,
            true) && ok;
        ok = 写指针(
            特征_目标抽象特征(),
            上下文.目标特征类型,
            false) && ok;
        ok = 写指针(
            特征_任务信息节点_筹办(),
            上下文.任务头,
            true) && ok;
        if (auto* 来源需求 = 任务来源需求(上下文.任务头)) {
            ok = 写指针(
                特征_来源需求_筹办(),
                来源需求,
                true) && ok;
        }
        auto* 来源因果信息 = 解析任务来源因果信息_筹办(
            上下文.任务头,
            上下文.目标宿主);
        if (来源因果信息) {
            ok = 写指针(
                特征_来源因果信息_筹办(),
                来源因果信息,
                true) && ok;
        }
        if (auto* 任务虚拟存在 = 任务类::取或创建_任务虚拟存在(
                上下文.任务头,
                上下文.任务头->主信息.场景.指针)) {
            ok = 写指针(
                特征_任务虚拟存在_筹办(),
                任务虚拟存在,
                true) && ok;
        }
        ok = 写I64(
            特征_任务状态_筹办(),
            static_cast<I64>(任务类::读取任务状态(上下文.任务头)),
            true) && ok;

        void* 输入目标方法指针 = nullptr;
        (void)世界树.读取特征_指针(
            上下文.输入条件包,
            特征_目标方法头节点(),
            输入目标方法指针);
        auto* 输入目标方法 = 输入目标方法指针
            ? reinterpret_cast<方法节点*>(输入目标方法指针)
            : 输入目标方法默认;
        const bool 输入目标方法不同于当前方法 =
            输入目标方法 && 输入目标方法 != 上下文.当前方法;

        I64 选中自我能力值 = 0;
        if (输入目标方法不同于当前方法) {
            选中自我能力值 = 方法自我能力值(输入目标方法);
        } else {
            选中自我能力值 = 任务类::读取任务选中自我能力值(上下文.任务头);
            if (选中自我能力值 == 0) {
                选中自我能力值 = 方法自我能力值(输入目标方法);
            }
        }
        auto* 选中能力特征 = 查找子特征_筹办(
            输入包宿主,
            特征_选中自我能力值());
        if (输入目标方法不同于当前方法
            && (选中自我能力值 != 0 || 选中能力特征)) {
            ok = 写I64(
                特征_选中自我能力值(),
                选中自我能力值,
                true) && ok;
        } else if (选中自我能力值 != 0
            && !特征已有真实值_筹办(选中能力特征)) {
            ok = 写I64(
                特征_选中自我能力值(),
                选中自我能力值,
                false) && ok;
        }

        if (上下文.有目标执行后值) {
            ok = 写I64(
                特征_目标执行后值(),
                上下文.目标执行后值,
                true) && ok;
        }

        I64 当前值 = 0;
        if (上下文.有目标执行后值 && 状态节点I64值(上下文.当前状态, 当前值)) {
            const bool 可表达差值 =
                !(当前值 < 0 && 上下文.目标执行后值 > (std::numeric_limits<I64>::max)() + 当前值)
                && !(当前值 > 0 && 上下文.目标执行后值 < (std::numeric_limits<I64>::min)() + 当前值);
            if (可表达差值) {
                ok = 写I64(
                    特征_执行差值(),
                    上下文.目标执行后值 - 当前值,
                    true) && ok;
            }
        }

        ok = 补齐安全因果搜索输入参数_筹办(
            上下文.任务头,
            上下文.当前方法,
            上下文.输入参数场景,
            上下文.输入条件包,
            上下文.目标宿主,
            上下文.目标特征类型,
            上下文.now) && ok;

        I64 形参数量 = 0;
        I64 既有实参数量 = 0;
        I64 目标宿主I64复制数量 = 0;
        I64 目标宿主指针复制数量 = 0;
        I64 通用派生指针数量 = 0;
        I64 暂无来源数量 = 0;
        if (auto* 形参表 = 方法形参表_筹办(上下文.当前方法, 上下文.now)) {
            for (auto* 形参节点 : 世界树.特征().获取子特征(
                     reinterpret_cast<基础信息节点类*>(形参表))) {
                if (!形参节点) {
                    continue;
                }
                const auto* 参数特征类型 = 特征节点类型_筹办(形参节点);
                if (!参数特征类型) {
                    continue;
                }

                ++形参数量;
                if (输入场景包含实参值_筹办(
                        上下文.输入参数场景,
                        上下文.输入条件包,
                        参数特征类型)) {
                    ++既有实参数量;
                    continue;
                }

                bool 已绑定 = false;
                if (语素入口同一(参数特征类型, 特征_输入条件包())) {
                    已绑定 = 写指针(
                        特征_输入条件包(),
                        上下文.输入条件包,
                        false);
                    if (已绑定) {
                        ++通用派生指针数量;
                    } else {
                        ok = false;
                    }
                }

                if (!已绑定 && 参数值类型为I64_筹办(形参节点)) {
                    I64 值 = 0;
                    if (读取基础节点I64_筹办(
                            上下文.目标宿主,
                            参数特征类型,
                            值)) {
                        已绑定 = 输入包写入I64_若缺失_筹办(
                            上下文.输入条件包,
                            参数特征类型,
                            值,
                            上下文.now);
                        if (已绑定) {
                            ++目标宿主I64复制数量;
                        } else {
                            ok = false;
                        }
                    }
                }

                if (!已绑定 && 参数值类型为指针_筹办(形参节点)) {
                    const void* 指针 = nullptr;
                    bool 来源为目标宿主指针 = false;
                    if (语素入口同一(参数特征类型, 特征_目标方法头节点())) {
                        指针 = 输入目标方法默认;
                    } else if (语素入口同一(参数特征类型, 特征_目标宿主())) {
                        指针 = 上下文.目标宿主;
                    } else if (语素入口同一(参数特征类型, 特征_目标特征类型())
                        || 语素入口同一(参数特征类型, 特征_目标抽象特征())) {
                        指针 = 上下文.目标特征类型;
                    } else if (语素入口同一(参数特征类型, 特征_任务信息节点_筹办())) {
                        指针 = 上下文.任务头;
                    } else if (语素入口同一(参数特征类型, 特征_来源需求_筹办())) {
                        指针 = 任务来源需求(上下文.任务头);
                    } else if (语素入口同一(参数特征类型, 特征_来源因果信息_筹办())) {
                        指针 = 来源因果信息;
                    } else if (语素入口同一(参数特征类型, 特征_任务虚拟存在_筹办())) {
                        指针 = 任务类::取或创建_任务虚拟存在(
                            上下文.任务头,
                            上下文.任务头->主信息.场景.指针);
                    } else {
                        void* 来源指针 = nullptr;
                        if (读取基础节点指针_筹办(
                                上下文.目标宿主,
                                参数特征类型,
                                来源指针)) {
                            指针 = 来源指针;
                            来源为目标宿主指针 = true;
                        }
                    }

                    if (指针) {
                        已绑定 = 输入包写入指针_若缺失_筹办(
                            上下文.输入条件包,
                            参数特征类型,
                            指针,
                            上下文.now);
                        if (已绑定) {
                            if (来源为目标宿主指针) {
                                ++目标宿主指针复制数量;
                            } else {
                                ++通用派生指针数量;
                            }
                        } else {
                            ok = false;
                        }
                    }
                }

                if (!已绑定) {
                    ++暂无来源数量;
                }
            }
        }

        {
            std::ostringstream 输出;
            输出 << "候选方法通用形参扫描"
                << " | 任务=" << 任务主键_筹办日志(上下文.任务头)
                << " | 当前方法=" << 方法主键_筹办日志(上下文.当前方法)
                << " | 形参=" << 形参数量
                << " | 既有=" << 既有实参数量
                << " | 复制I64=" << 目标宿主I64复制数量
                << " | 复制指针=" << 目标宿主指针复制数量
                << " | 派生指针=" << 通用派生指针数量
                << " | 暂无来源=" << 暂无来源数量;
            记录筹办日志(输出.str());
        }

        if (!ok) {
            return {
                枚举_候选方法输入闭合状态::输入参数写入失败,
                特征_输入条件包(),
            };
        }

        const auto 必需实参检查 = 检查候选方法必需实参(
            上下文.当前方法,
            上下文.输入参数场景,
            上下文.输入条件包,
            上下文.now);
        {
            std::ostringstream 输出;
            输出 << "候选方法通用参数绑定"
                << " | 任务=" << 任务主键_筹办日志(上下文.任务头)
                << " | 当前方法=" << 方法主键_筹办日志(上下文.当前方法)
                << " | 输入目标方法=" << 方法主键_筹办日志(输入目标方法)
                << " | 输入目标方法覆盖=" << (上下文.输入目标方法覆盖 ? 1 : 0)
                << " | 目标宿主=" << 基础主键_筹办日志(上下文.目标宿主)
                << " | 目标特征=" << 入口主键_筹办日志(上下文.目标特征类型)
                << " | 必需=" << 必需实参检查.必需参数数量
                << " | 绑定=" << 必需实参检查.已绑定参数数量
                << " | 缺失=" << 必需实参检查.缺失参数数量
                << " | 首个缺失=" << 入口主键_筹办日志(
                    必需实参检查.首个缺失参数特征类型);
            记录筹办日志(输出.str());
        }
        if (!必需实参检查.成功()) {
            return {
                枚举_候选方法输入闭合状态::缺必需实参,
                必需实参检查.首个缺失参数特征类型
                    ? 必需实参检查.首个缺失参数特征类型
                    : 特征_参数配对状态(),
                必需实参检查.必需参数数量,
                必需实参检查.已绑定参数数量,
                必需实参检查.缺失参数数量,
            };
        }

        return {
            枚举_候选方法输入闭合状态::已闭合,
            nullptr,
            必需实参检查.必需参数数量,
            必需实参检查.已绑定参数数量,
            必需实参检查.缺失参数数量,
        };
    }

    结构_候选方法输入闭合结果 尝试构造候选方法输入参数场景(
        任务模块::筹办::结构_任务筹办结果& 结果,
        任务节点* 任务头,
        方法节点* 目标方法,
        方法节点* 输入目标方法覆盖,
        基础信息节点类* 目标宿主,
        const 语素入口节点类* 目标特征类型,
        const 状态节点类* 当前状态,
        const 状态节点类* 目标状态,
        时间戳 now) noexcept
    {
        if (!任务头
            || !目标方法
            || !目标宿主
            || !目标特征类型
            || !任务头->主信息.场景.指针) {
            记录筹办日志("候选方法筹办参数缺口 | 缺少目标宿主/特征/任务场景"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 当前方法=" + 方法主键_筹办日志(目标方法)
                + " | 目标宿主=" + 基础主键_筹办日志(目标宿主)
                + " | 目标特征=" + 入口主键_筹办日志(目标特征类型));
            return {
                枚举_候选方法输入闭合状态::缺目标基础,
                特征_目标特征类型(),
            };
        }

        const bool 需要目标执行值 = 方法结果能力需要目标执行值(
            目标方法,
            目标特征类型);
        I64 目标执行后值 = 0;
        const bool 有目标执行后值 = 状态节点I64值(目标状态, 目标执行后值);
        if (需要目标执行值 && !有目标执行后值) {
            // 能力参数化或声明方向变化的方法，筹办阶段必须先拿到目标值或差值出处。
            // 不能把缺值任务推进到就绪，再让执行阶段用失败倒推出参数缺口。
            记录筹办日志("候选方法筹办参数缺口 | 缺少目标执行后值"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 当前方法=" + 方法主键_筹办日志(目标方法)
                + " | 目标特征=" + 入口主键_筹办日志(目标特征类型)
                + " | 需要目标执行值=" + std::to_string(需要目标执行值 ? 1 : 0)
                + " | 目标状态=" + 状态主键_筹办日志(目标状态));
            return {
                枚举_候选方法输入闭合状态::缺目标执行值,
                特征_目标执行后值(),
            };
        }

        auto* 输入参数场景 = 创建任务可执行输入参数场景(任务头, now);
        if (!输入参数场景) {
            记录筹办日志("候选方法筹办参数缺口 | 可执行输入参数场景创建失败"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 当前方法=" + 方法主键_筹办日志(目标方法));
            return {
                枚举_候选方法输入闭合状态::输入包创建失败,
                特征_输入条件包(),
            };
        }

        auto* 输入包 = 世界树.确保特征(
            输入参数场景,
            特征_输入条件包());
        if (!输入包) {
            记录筹办日志("候选方法筹办参数缺口 | 输入条件包创建失败"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 当前方法=" + 方法主键_筹办日志(目标方法));
            return {
                枚举_候选方法输入闭合状态::输入包创建失败,
                特征_输入条件包(),
            };
        }

        const auto 参数绑定结果 = 通用绑定候选方法输入参数_筹办({
            任务头,
            目标方法,
            输入目标方法覆盖,
            目标宿主,
            目标特征类型,
            当前状态,
            输入参数场景,
            输入包,
            有目标执行后值,
            目标执行后值,
            now,
        });
        if (参数绑定结果.状态 == 枚举_候选方法输入闭合状态::输入参数写入失败) {
            记录筹办日志("候选方法筹办参数缺口 | 输入参数写入失败"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 当前方法=" + 方法主键_筹办日志(目标方法)
                + " | 目标特征=" + 入口主键_筹办日志(目标特征类型));
            return 参数绑定结果;
        }

        if (!参数绑定结果.成功()) {
            std::ostringstream 输出;
            输出 << "候选方法筹办参数缺口 | 必需实参未绑定"
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 当前方法=" << 方法主键_筹办日志(目标方法)
                << " | 必需=" << 参数绑定结果.必需参数数量
                << " | 绑定=" << 参数绑定结果.已绑定参数数量
                << " | 缺失=" << 参数绑定结果.缺失参数数量
                << " | 首个缺失=" << 入口主键_筹办日志(
                    参数绑定结果.缺口特征类型);
            记录筹办日志(输出.str());
            return 参数绑定结果;
        }

        写入场景节点引用(
            结果.回执.可执行输入参数场景,
            输入参数场景);

        {
            std::ostringstream 输出;
            输出 << "候选方法筹办参数已闭合"
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 当前方法=" << 方法主键_筹办日志(目标方法)
                << " | 目标宿主=" << 基础主键_筹办日志(目标宿主)
                << " | 目标特征=" << 入口主键_筹办日志(目标特征类型)
                << " | 需要目标执行值=" << (需要目标执行值 ? 1 : 0)
                << " | 目标执行后值=" << (有目标执行后值 ? std::to_string(目标执行后值) : std::string("空"))
                << " | 必需实参数=" << 参数绑定结果.必需参数数量
                << " | 已绑定实参数=" << 参数绑定结果.已绑定参数数量
                << " | 输入场景=" << 基础主键_筹办日志(
                    reinterpret_cast<基础信息节点类*>(输入参数场景));
            记录筹办日志(输出.str());
        }
        return {};
    }

    方法节点* 任务已绑定非治理方法(
        自我类* 自我对象,
        任务节点* 任务头,
        时间戳 now) noexcept
    {
        if (!任务头) {
            return nullptr;
        }
        auto* 方法 = reinterpret_cast<方法节点*>(任务类::读取任务执行方法(任务头));
        if (!方法) {
            return nullptr;
        }
        if (方法是先天特征写入逻辑(方法)) {
            标记历史特征写入入口为先天逻辑(方法);
            记录筹办日志("已绑定方法跳过先天特征写入逻辑"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 方法=" + 方法主键_筹办日志(方法)
                + " | 本能ID=" + std::to_string(方法原始本能ID值(方法)));
            return nullptr;
        }
        if (方法挂载非当前本能句柄(方法)) {
            记录筹办日志("已绑定方法跳过非当前默认本能方法残留"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 方法=" + 方法主键_筹办日志(方法)
                + " | 本能ID=" + std::to_string(方法原始本能ID值(方法)));
            return nullptr;
        }
        if (方法是任务完成后处理方法(方法)) {
            记录筹办日志("已绑定方法跳过任务完成后处理方法"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 方法=" + 方法主键_筹办日志(方法)
                + " | 说明=结算叶子任务价值不作为普通任务执行方法");
            return nullptr;
        }
        if (方法是专用提交入口方法(方法)) {
            记录筹办日志("已绑定方法跳过专用提交入口方法"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 方法=" + 方法主键_筹办日志(方法)
                + " | 说明=OR组结算令牌提交不作为普通任务执行方法");
            return nullptr;
        }
        if (自我对象
            && 任务目标是方法结构补齐需求(任务头)
            && !方法是学习补齐本能方法(方法)) {
            auto* 被补方法 = 任务方法结构补齐目标方法(*自我对象, 任务头, now);
            // 方法结构补齐任务必须由学习本能承接。旧链可能把“方法状态 / 方法动作”等
            // 泛化方法头绑定到任务上；继续沿用会把补齐需求带偏到“方法动作状态”。
            if (被补方法) {
                写入方法补齐任务输入目标方法(任务头, 被补方法, now);
            }
            return nullptr;
        }
        const auto* 目标特征类型 = 任务对应需求目标特征类型(任务头);
        if (目标特征类型
            && !方法结果能力命中任务需求(方法, 任务头, 目标特征类型)) {
            记录筹办日志("已绑定方法结果能力不承接当前需求，取消沿用"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 方法=" + 方法主键_筹办日志(方法)
                + " | 目标特征=" + 入口主键_筹办日志(目标特征类型));
            return nullptr;
        }
        return 方法;
    }

    方法节点* 解析或创建任务目标方法(
        自我类& 自我对象,
        任务节点* 任务头,
        时间戳 now,
        bool* 输出已新建占位方法,
        std::vector<方法节点*>* 输出候选方法集) noexcept
    {
        if (输出已新建占位方法) {
            *输出已新建占位方法 = false;
        }
        if (!任务头) {
            return nullptr;
        }

        auto* 自我存在 = 自我对象.确保自我存在();
        auto* 方法根节点 = 自我存在 ? 世界树.存在().获取方法根节点(自我存在) : nullptr;
        if (!方法根节点) {
            return nullptr;
        }

        std::vector<方法节点*> 本轮候选方法集{};

        // 新筹办流程：先把所有可解释的语义方法放入本轮筹办回执候选集，再从候选集中选择当前方法。
        // 历史特征写入入口属于先天写入逻辑，不进入候选集；若没有语义方法命中，才创建占位方法头。
        填充任务方法候选集(
            自我对象,
            任务头,
            本轮候选方法集,
            方法根节点,
            now,
            输出已新建占位方法);

        if (输出候选方法集) {
            *输出候选方法集 = 本轮候选方法集;
        }

        if (auto* 候选选择方法 = 从筹办候选集中选择当前方法(
                自我对象,
                任务头,
                本轮候选方法集,
                now)) {
            // 候选集是任务可选解法的权威入口；筹办只在候选集填充后选择当前方法。
            std::ostringstream 输出;
            输出 << "候选集填充后选择当前方法"
                << " | 对应普通步骤=候选选择"
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 方法=" << 方法主键_筹办日志(候选选择方法);
            记录筹办日志(输出.str());
            return 候选选择方法;
        }
        {
            std::ostringstream 输出;
            输出 << "候选集填充后仍无当前方法"
                << " | 对应普通步骤=候选选择"
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 来源需求=" << 需求主键_筹办日志(任务来源需求(任务头))
                << " | 目标特征=" << 入口主键_筹办日志(任务对应需求目标特征类型(任务头));
            记录筹办日志(输出.str());
        }
        return nullptr;
    }

    const 语素入口节点类* 筹办缺口特征类型(
        任务模块::筹办::枚举_任务推进状况 状况) noexcept
    {
        using 任务模块::筹办::枚举_任务推进状况;
        switch (状况) {
        case 枚举_任务推进状况::缺方法动作:
            return 私有_方法动作状态特征类型_执行桥_最小_v0();
        case 枚举_任务推进状况::方法缺可执行入口:
            return 私有_方法可执行入口数量特征类型_执行桥_最小_v0();
        case 枚举_任务推进状况::方法缺条件节点:
            return 私有_方法条件节点数量特征类型_执行桥_最小_v0();
        case 枚举_任务推进状况::方法缺结果节点:
            return 私有_方法结果节点数量特征类型_执行桥_最小_v0();
        case 枚举_任务推进状况::方法缺条件结果对:
            return 私有_方法条件结果配对状态特征类型_执行桥_最小_v0();
        case 枚举_任务推进状况::参数不可配:
            return 特征_参数配对状态();
        case 枚举_任务推进状况::方法前置条件未满足:
            return 特征_实际结果状态_筹办();
        case 枚举_任务推进状况::方法运行账不足:
            return 私有_方法运行账完整性特征类型_执行桥_最小_v0();
        case 枚举_任务推进状况::方法结果不稳定:
            return 私有_方法稳定状态特征类型_执行桥_最小_v0();
        default:
            return nullptr;
        }
    }

    bool 返回方法结构缺口(
        任务模块::筹办::结构_任务筹办结果& 结果,
        任务节点* 任务头,
        方法节点* 目标方法,
        任务模块::筹办::枚举_任务推进状况 状况,
        时间戳 now,
        const 语素入口节点类* 覆盖缺口特征类型 = nullptr) noexcept
    {
        if (!任务头 || !目标方法) {
            return false;
        }

        using 任务模块::筹办::枚举_任务推进状况;

        场景节点类* 结果场景 = 任务头->主信息.场景.指针;
        特征节点类* 运行结果 = nullptr;
        基础信息节点类* 缺口目标主体 = nullptr;
        switch (状况) {
        case 枚举_任务推进状况::缺方法动作:
            运行结果 = 私有_填充缺方法动作执行结果_执行桥_最小_v0(目标方法, 结果场景, now);
            break;
        case 枚举_任务推进状况::方法缺可执行入口:
            运行结果 = 私有_填充方法缺可执行入口执行结果_执行桥_最小_v0(目标方法, 结果场景, now);
            break;
        case 枚举_任务推进状况::方法缺条件节点:
            运行结果 = 私有_填充方法缺条件节点执行结果_执行桥_最小_v0(目标方法, 结果场景, now);
            break;
        case 枚举_任务推进状况::方法缺结果节点:
            运行结果 = 私有_填充方法缺结果节点执行结果_执行桥_最小_v0(目标方法, 结果场景, now);
            break;
        case 枚举_任务推进状况::方法缺条件结果对:
            运行结果 = 私有_填充方法缺条件结果对执行结果_执行桥_最小_v0(目标方法, 结果场景, now);
            break;
        case 枚举_任务推进状况::参数不可配:
            缺口目标主体 = 任务参数缺口目标主体(任务头, 目标方法, now);
            运行结果 = 私有_填充参数配对缺口执行结果_执行桥_最小_v0(
                目标方法,
                缺口目标主体,
                结果场景,
                now);
            if (运行结果 && 覆盖缺口特征类型 && 缺口目标主体) {
                // 参数不可配可能是“目标执行值/差值尚未确定”，而不是泛化的参数包失败。
                // 这里把派生目标改写到更细的缺口特征，让自我线程能围绕具体值来源生长子需求。
                私有_填充主体特征需求状态_执行桥_最小_v0(
                    目标方法,
                    缺口目标主体,
                    覆盖缺口特征类型,
                    static_cast<I64>(0),
                    static_cast<I64>(1),
                    结果场景,
                    now);
            }
            break;
        case 枚举_任务推进状况::方法运行账不足:
            运行结果 = 私有_填充方法运行账不足执行结果_执行桥_最小_v0(目标方法, 结果场景, now);
            break;
        case 枚举_任务推进状况::方法结果不稳定:
            运行结果 = 私有_填充方法结果不稳定执行结果_执行桥_最小_v0(目标方法, 结果场景, now);
            break;
        default:
            return false;
        }
        if (!运行结果) {
            return false;
        }

        结果.方法运行结果 = 运行结果;
        结果.结果场景 = 结果场景;
        结果.回执.状况 = 状况;
        写入筹办回执任务建议(
            结果.回执,
            枚举_任务状态::等待中,
            枚举_任务阶段::筹办);
        结果.回执.缺口特征类型 = 覆盖缺口特征类型
            ? 覆盖缺口特征类型
            : 筹办缺口特征类型(状况);
        {
            std::ostringstream 输出;
            输出 << "返回方法结构缺口"
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 目标方法=" << 方法主键_筹办日志(目标方法)
                << " | 状况=" << static_cast<int>(状况)
                << " | 缺口特征=" << 入口主键_筹办日志(结果.回执.缺口特征类型)
                << " | 目标方法有方法动作=" << (目标方法->主信息.有方法动作() ? 1 : 0)
                << " | 方法动作数=" << 私有_方法动作数量_执行桥_最小_v0(目标方法)
                << " | 可执行入口数=" << 私有_方法可执行入口数量_执行桥_最小_v0(目标方法)
                << " | 条件结果对数=" << 私有_方法条件结果对数量_执行桥_最小_v0(目标方法);
            记录筹办日志(输出.str());
        }
        if (缺口目标主体) {
            写入基础节点引用(
                结果.回执.缺口目标主体,
                缺口目标主体);
        } else if (auto* 任务实例目标主体 = 任务参数缺口目标主体(任务头, 目标方法, now)) {
            // 方法被任务使用时，本轮“要补哪个方法”的实例信息归任务虚拟存在承载；
            // 目标方法自身的公用结构状态仍由后续方法域提交入口正式改写。
            写入基础节点引用(
                结果.回执.缺口目标主体,
                任务实例目标主体);
        } else if (auto* 方法虚拟存在 = 目标方法->主信息.首节点信息().方法虚拟存在.指针
                ? 目标方法->主信息.首节点信息().方法虚拟存在.指针
                : 方法虚拟存在服务类::取或创建方法虚拟存在(目标方法, nullptr, now)) {
            // 兜底只指向目标方法的公用方法状态，不能承载本轮任务参数或回执。
            auto* 方法状态 = 世界树.确保特征(
                reinterpret_cast<基础信息节点类*>(方法虚拟存在),
                私有_方法状态特征类型_执行桥_最小_v0());
            写入基础节点引用(
                结果.回执.缺口目标主体,
                方法状态
                    ? reinterpret_cast<基础信息节点类*>(方法状态)
                    : reinterpret_cast<基础信息节点类*>(方法虚拟存在));
        }
        记录缺口派生目标状态(
            "方法结构缺口派生目标状态",
            任务头,
            目标方法,
            结果.回执.缺口特征类型,
            结果.回执.缺口目标主体,
            结果场景);
        结果.回执.需要自我线程 = true;
        结果.回执.需要创建或复用子需求 = true;
        结果.回执.父任务需要重筹办 = false;
        return true;
    }

    const char* 自我动作组合反推状态名(
        枚举_自我动作组合反推状态 状态) noexcept
    {
        switch (状态) {
        case 枚举_自我动作组合反推状态::未定义:
            return "未定义";
        case 枚举_自我动作组合反推状态::无目标结果:
            return "无目标结果";
        case 枚举_自我动作组合反推状态::无匹配因果:
            return "无匹配因果";
        case 枚举_自我动作组合反推状态::有因果但无可映射方法:
            return "有因果但无可映射方法";
        case 枚举_自我动作组合反推状态::单步本能方法:
            return "单步本能方法";
        case 枚举_自我动作组合反推状态::多候选方法:
            return "多候选方法";
        case 枚举_自我动作组合反推状态::动作序列待定义:
            return "动作序列待定义";
        default:
            return "未知";
        }
    }

    bool 调用提交方法可执行入口(
        自我类& 自我对象,
        任务节点* 任务头,
        方法节点* 目标方法,
        I64 本能方法ID,
        时间戳 now) noexcept
    {
        if (!任务头 || !任务头->主信息.场景.指针 || !目标方法 || 本能方法ID <= 0) {
            return false;
        }

        auto* 自我存在 = 自我对象.确保自我存在();
        if (!自我存在) {
            记录筹办日志("提交方法可执行入口调用失败 | 原因=自我存在缺失"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 目标方法=" + 方法主键_筹办日志(目标方法));
            return false;
        }

        auto* 提交方法 = 本能方法类::查找或创建本能方法首节点(
            自我存在,
            枚举_本能方法ID::自我_提交方法可执行入口,
            now);
        if (!提交方法) {
            记录筹办日志("提交方法可执行入口调用失败 | 原因=提交本能方法首节点缺失"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 目标方法=" + 方法主键_筹办日志(目标方法));
            return false;
        }

        const auto* 输入名 = 语素集.添加信息入口词(
            "提交方法可执行入口_输入_" + std::to_string(now),
            枚举_信息入口类型::场景实例入口);
        const auto* 输出名 = 语素集.添加信息入口词(
            "提交方法可执行入口_输出_" + std::to_string(now),
            枚举_信息入口类型::场景实例入口);
        auto* 输入场景 = 世界树.场景().创建场景_按名称(
            reinterpret_cast<基础信息节点类*>(任务头->主信息.场景.指针),
            输入名,
            枚举_世界类型::内部世界);
        auto* 输出场景 = 世界树.场景().创建场景_按名称(
            reinterpret_cast<基础信息节点类*>(任务头->主信息.场景.指针),
            输出名,
            枚举_世界类型::内部世界);
        auto* 输入包 = 输入场景
            ? 世界树.确保特征(输入场景, 特征_输入条件包())
            : nullptr;
        if (!输入场景 || !输入包) {
            记录筹办日志("提交方法可执行入口调用失败 | 原因=输入条件包创建失败"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 目标方法=" + 方法主键_筹办日志(目标方法)
                + " | 能力=" + std::to_string(本能方法ID));
            return false;
        }

        bool ok = true;
        ok = 世界树.写入特征_指针(
            输入包,
            特征_目标方法头节点(),
            目标方法,
            now) && ok;
        ok = 世界树.写入特征_I64(
            输入包,
            特征_选中自我能力值(),
            本能方法ID,
            now) && ok;
        if (!ok) {
            记录筹办日志("提交方法可执行入口调用失败 | 原因=输入字段写入失败"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 目标方法=" + 方法主键_筹办日志(目标方法)
                + " | 能力=" + std::to_string(本能方法ID));
            return false;
        }

        auto* 运行存在 = 取本能动作集().执行功能函数(
            static_cast<枚举_本能动作ID>(枚举_本能方法ID::自我_提交方法可执行入口),
            提交方法,
            输入场景,
            输出场景);
        const bool 成功 = 运行存在
            && 目标方法->主信息.首节点信息().动作句柄.类型 == 枚举_动作句柄类型::本能函数ID
            && 目标方法->主信息.首节点信息().动作句柄.本能ID == 本能方法ID;

        std::ostringstream 输出;
        输出 << "提交方法可执行入口调用完成"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 目标方法=" << 方法主键_筹办日志(目标方法)
            << " | 能力=" << 本能方法ID
            << " | 运行存在=" << 基础主键_筹办日志(reinterpret_cast<基础信息节点类*>(运行存在))
            << " | 成功=" << (成功 ? 1 : 0);
        记录筹办日志(输出.str());
        return 成功;
    }

    bool 返回自我动作组合缺口(
        任务模块::筹办::结构_任务筹办结果& 结果,
        自我类& 自我对象,
        任务节点* 任务头,
        方法节点* 目标方法,
        任务模块::筹办::枚举_任务推进状况 状况,
        时间戳 now) noexcept
    {
        if (!任务头 || !目标方法) {
            return false;
        }

        // 方法动作 / 可执行入口缺失不能退化成“存在一个方法”的抽象需求。
        // 但目标方法已经被候选召回或占位创建后，缺口必须围绕该方法的具体结构槽上报，
        // 让后续学习链补“目标方法.方法动作状态 / 可执行入口”，而不是让父任务空等。
        结果.回执.状况 = 状况;
        写入方法节点引用(结果.回执.当前方法, 目标方法);
        写入筹办回执任务建议(
            结果.回执,
            枚举_任务状态::等待中,
            枚举_任务阶段::筹办);
        结果.回执.需要自我线程 = false;
        结果.回执.需要创建或复用子需求 = false;
        结果.回执.父任务需要重筹办 = false;
        结果.回执.缺口特征类型 = nullptr;
        结果.说明 = "方法缺少可直接绑定的自我动作组合，等待因果反推或动作序列入口规则";

        auto* 来源需求 = 任务来源需求(任务头);
        auto* 目标结果状态 = 来源需求 ? 来源需求->主信息.需求状态.指针 : nullptr;
        auto* 自我存在 = 自我对象.获取自我存在();
        auto* 方法根节点 = 自我存在
            ? 世界树.存在().获取方法根节点(自我存在)
            : nullptr;

        结构_自我动作组合反推输入 反推输入{};
        反推输入.目标结果状态 = 目标结果状态;
        反推输入.目标特征类型 = 来源需求 ? 需求目标特征类型(来源需求) : nullptr;
        反推输入.方法根节点 = 方法根节点;
        反推输入.最低稳定度 = 0;
        反推输入.最大候选数 = 8;
        反推输入.只接受已验证因果 = false;

        // 因果反推在这里是只读诊断：只读取目标结果、因果模板和方法根，
        // 不提交方法动作、任务状态或需求节点；真正写入须由后续领域提交方法完成。
        const auto 反推结果 = 世界树.因果().反推自我动作组合(反推输入);
        if (反推结果.状态 == 枚举_自我动作组合反推状态::单步本能方法) {
            I64 单步本能ID = 0;
            for (const auto& 候选 : 反推结果.候选) {
                if (候选.可直接绑定单步本能()) {
                    单步本能ID = 候选.本能方法ID;
                    break;
                }
            }
            if (调用提交方法可执行入口(
                    自我对象,
                    任务头,
                    目标方法,
                    单步本能ID,
                    now)) {
                结果.说明 = "因果已反推出单步本能候选，并已提交目标方法可执行入口，等待下一轮重筹办检查条件结果对";
                结果.回执.状况 = 任务模块::筹办::枚举_任务推进状况::已建立方法头待重入;
                写入筹办回执任务建议(
                    结果.回执,
                    枚举_任务状态::待重筹办,
                    枚举_任务阶段::筹办);
                结果.回执.父任务需要重筹办 = true;
            } else {
                结果.说明 = "因果已反推出单步本能候选，但提交方法可执行入口失败";
            }
        } else if (反推结果.状态 == 枚举_自我动作组合反推状态::多候选方法) {
            结果.说明 = "因果反推出多个本能候选，等待动作组合选择规则";
        } else if (反推结果.状态 == 枚举_自我动作组合反推状态::动作序列待定义) {
            结果.说明 = "因果反推出可映射方法，但需要动作序列入口规则";
        } else if (反推结果.状态 == 枚举_自我动作组合反推状态::有因果但无可映射方法) {
            结果.说明 = "因果存在但未能映射为自我可执行方法，等待自我动作组合补完";
        }
        结果.回执.摘要 = 结果.说明;

        std::ostringstream 输出;
        输出 << "返回自我动作组合缺口"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 目标方法=" << 方法主键_筹办日志(目标方法)
            << " | 状况=" << static_cast<int>(状况)
            << " | 来源需求=" << 需求主键_筹办日志(来源需求)
            << " | 目标结果状态=" << 状态主键_筹办日志(目标结果状态)
            << " | 方法根=" << 方法主键_筹办日志(方法根节点)
            << " | 因果反推状态=" << 自我动作组合反推状态名(反推结果.状态)
            << " | 因果反推候选数=" << static_cast<I64>(反推结果.候选.size())
            << " | 方法动作数=" << 私有_方法动作数量_执行桥_最小_v0(目标方法)
            << " | 可执行入口数=" << 私有_方法可执行入口数量_执行桥_最小_v0(目标方法)
            << " | 说明=" << 结果.说明;
        记录筹办日志(输出.str());
        for (std::size_t i = 0; i <反推结果.候选.size() && i < 3; ++i) {
            const auto& 候选 = 反推结果.候选[i];
            std::ostringstream 候选输出;
            候选输出 << "自我动作组合反推候选"
                << " | 序号=" << static_cast<I64>(i + 1)
                << " | 来源因果模板=" << 基础主键_筹办日志(候选.来源因果模板)
                << " | 候选方法=" << 方法主键_筹办日志(候选.候选方法)
                << " | 本能方法ID=" << 候选.本能方法ID
                << " | 稳定度=" << 候选.稳定度
                << " | 动作语义键=" << 候选.动作语义键;
            记录筹办日志(候选输出.str());
        }
        const auto 反推说明 = 结果.说明;
        if (返回方法结构缺口(
                结果,
                任务头,
                目标方法,
                状况,
                now)) {
            结果.说明 = 反推说明 + "；已按目标方法结构缺口上报学习承接";
            结果.回执.摘要 = 结果.说明;
            记录筹办日志("自我动作组合缺口已转为方法结构缺口"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 目标方法=" + 方法主键_筹办日志(目标方法)
                + " | 缺口特征=" + 入口主键_筹办日志(结果.回执.缺口特征类型)
                + " | 需要子需求=" + std::to_string(结果.回执.需要创建或复用子需求 ? 1 : 0)
                + " | 说明=" + 结果.说明);
        }
        (void)now;
        return true;
    }

    bool 返回方法状态可用性缺口(
        任务模块::筹办::结构_任务筹办结果& 结果,
        任务节点* 任务头,
        方法节点* 目标方法,
        时间戳 now) noexcept
    {
        if (!任务头 || !目标方法) {
            return false;
        }

        auto* 结果场景 = 任务头->主信息.场景.指针;
        auto* 运行结果 = 私有_填充方法不可用执行结果_执行桥_最小_v0(
            目标方法,
            结果场景,
            now);
        if (!运行结果) {
            return false;
        }

        auto* 方法虚拟存在 = 目标方法->主信息.首节点信息().方法虚拟存在.指针
            ? 目标方法->主信息.首节点信息().方法虚拟存在.指针
            : 方法虚拟存在服务类::取或创建方法虚拟存在(目标方法, nullptr, now);

        结果.方法运行结果 = 运行结果;
        结果.结果场景 = 结果场景;
        // 候选方法已经明确存在，但尚未达到“方法状态=可用”的最低判据。
        // 这里不细分为动作/条件/结果节点需求，避免筹办在缺口不明确时误派生方法动作需求。
        结果.回执.状况 = 任务模块::筹办::枚举_任务推进状况::方法缺条件结果对;
        写入筹办回执任务建议(
            结果.回执,
            枚举_任务状态::等待中,
            枚举_任务阶段::筹办);
        结果.回执.缺口特征类型 = 私有_方法状态特征类型_执行桥_最小_v0();
        if (auto* 任务实例目标主体 = 任务参数缺口目标主体(任务头, 目标方法, now)) {
            写入基础节点引用(
                结果.回执.缺口目标主体,
                任务实例目标主体);
        } else if (方法虚拟存在) {
            // 兜底只引用目标方法公用状态；任务期目标方法绑定优先写在任务虚拟存在。
            写入基础节点引用(
                结果.回执.缺口目标主体,
                reinterpret_cast<基础信息节点类*>(方法虚拟存在));
        }
        记录缺口派生目标状态(
            "方法状态可用性缺口派生目标状态",
            任务头,
            目标方法,
            结果.回执.缺口特征类型,
            结果.回执.缺口目标主体,
            结果场景);
        结果.回执.需要自我线程 = true;
        结果.回执.需要创建或复用子需求 = true;
        结果.回执.父任务需要重筹办 = false;
        结果.回执.治理结果可接受 = false;
        {
            std::ostringstream 输出;
            输出 << "返回方法状态可用性缺口"
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 目标方法=" << 方法主键_筹办日志(目标方法)
                << " | 缺口特征=" << 入口主键_筹办日志(结果.回执.缺口特征类型)
                << " | 目标方法有方法动作=" << (目标方法->主信息.有方法动作() ? 1 : 0)
                << " | 本能能力=" << 方法自我能力值(目标方法)
                << " | 方法动作数=" << 私有_方法动作数量_执行桥_最小_v0(目标方法)
                << " | 可执行入口数=" << 私有_方法可执行入口数量_执行桥_最小_v0(目标方法)
                << " | 条件节点数=" << 私有_方法条件节点数量_执行桥_最小_v0(目标方法)
                << " | 结果节点数=" << 私有_方法结果节点数量_执行桥_最小_v0(目标方法)
                << " | 条件结果对数=" << 私有_方法条件结果对数量_执行桥_最小_v0(目标方法);
            记录筹办日志(输出.str());
        }
        return true;
    }

    任务模块::筹办::枚举_任务推进状况 候选方法不可就绪状况(
        方法节点* 目标方法,
        时间戳 now) noexcept
    {
        using 任务模块::筹办::枚举_任务推进状况;
        if (!目标方法) {
            return 枚举_任务推进状况::方法查找未命中;
        }

        const bool 有本能动作句柄 = 方法自我能力值(目标方法) != 0;
        const bool 有已注册本能入口 =
            私有_方法有已注册本能入口_执行桥_最小_v0(目标方法);
        const bool 有方法动作 =
            有本能动作句柄
            || 目标方法->主信息.有方法动作()
            || 私有_方法动作数量_执行桥_最小_v0(目标方法) > 0;
        if (!有方法动作) {
            return 枚举_任务推进状况::缺方法动作;
        }

        const bool 有可执行入口 =
            有已注册本能入口
            || 私有_方法可执行入口数量_执行桥_最小_v0(目标方法) > 0;
        if (!有可执行入口) {
            return 枚举_任务推进状况::方法缺可执行入口;
        }

        // 普通方法“可用”的最低判据是至少存在一组有效条件结果对。
        // 学习补齐本能本身是内核反射：它负责给目标方法产出条件结果对，
        // 只要动作入口存在且输入场景已绑定，就不再用自身条件结果对反向阻塞自身。
        if (方法是学习补齐本能方法(目标方法)) {
            return 枚举_任务推进状况::未定义;
        }
        if (方法是筹办过程或协作本能方法(目标方法)) {
            return 枚举_任务推进状况::未定义;
        }
        if (私有_方法条件结果对数量_执行桥_最小_v0(目标方法) <= 0) {
            return 枚举_任务推进状况::方法缺条件结果对;
        }

        return 枚举_任务推进状况::未定义;
    }
}

export namespace 任务模块::筹办 {

结构_任务筹办结果 筹办任务(
    ::自我类& 自我对象,
    任务类::节点类* 输入任务,
    时间戳 now) noexcept
{
    using enum 枚举_任务推进状况;

    结构_任务筹办结果 结果{};
    结果.已执行筹办 = true;
    if (now == 0) {
        now = 结构体_时间戳::当前_微秒();
    }

    auto* 任务头 = 归一到任务头结点(输入任务);
    结果.回执.阶段 = 枚举_任务推进阶段::筹办;
    写入任务节点引用(结果.回执.当前任务, 任务头);
    if (!任务头) {
        结果.缺少任务 = true;
        结果.回执.状况 = 未定义;
        return 结果;
    }

    const auto 需求上下文 = 筹办_构造需求生命周期上下文(任务头);
    auto* 来源需求 = 需求上下文.来源需求;
    const auto* 目标特征类型 = 需求上下文.目标特征类型;
    auto* 当前状态 = 需求上下文.当前状态;
    auto* 目标状态 = 需求上下文.目标状态;
    auto* 目标宿主 = 需求上下文.目标宿主;
    结果.回执.目标特征类型 = 目标特征类型;
    {
        std::ostringstream 输出;
        输出 << "进入筹办"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 来源需求=" << 需求主键_筹办日志(来源需求)
            << " | 目标宿主=" << 基础主键_筹办日志(目标宿主)
            << " | 目标特征=" << 入口主键_筹办日志(目标特征类型)
            << " | 当前状态=" << 状态主键_筹办日志(当前状态)
            << " | 目标状态=" << 状态主键_筹办日志(目标状态)
            << " | 被需求存在由状态推导=" << (需求上下文.被需求存在由状态推导 ? 1 : 0)
            << " | 满足关系=" << static_cast<I64>(来源需求 ? 来源需求->主信息.满足关系 : 0);
        记录筹办日志(输出.str());
    }
    if (来源需求 && 需求上下文.被需求存在由状态推导) {
        记录筹办日志("需求上下文通过状态主体推导被需求存在 | 任务="
            + 任务主键_筹办日志(任务头)
            + " | 来源需求=" + 需求主键_筹办日志(来源需求)
            + " | 目标宿主=" + 基础主键_筹办日志(目标宿主));
    }
    if (来源需求 && 需求上下文.缺当前状态) {
        记录筹办日志("需求上下文缺少当前状态 | 任务=" + 任务主键_筹办日志(任务头)
            + " | 来源需求=" + 需求主键_筹办日志(来源需求)
            + " | 目标宿主=" + 基础主键_筹办日志(目标宿主)
            + " | 目标特征=" + 入口主键_筹办日志(目标特征类型));
    }
    if (来源需求 && !目标状态) {
        记录筹办日志("缺少需求目标状态 | 任务=" + 任务主键_筹办日志(任务头)
            + " | 来源需求=" + 需求主键_筹办日志(来源需求)
            + " | 目标宿主=" + 基础主键_筹办日志(目标宿主)
            + " | 目标特征=" + 入口主键_筹办日志(目标特征类型));
    }
    if (来源需求 && !目标宿主) {
        记录筹办日志("缺少需求目标宿主 | 任务=" + 任务主键_筹办日志(任务头)
            + " | 来源需求=" + 需求主键_筹办日志(来源需求)
            + " | 目标特征=" + 入口主键_筹办日志(目标特征类型)
            + " | 当前状态=" + 状态主键_筹办日志(当前状态)
            + " | 目标状态=" + 状态主键_筹办日志(目标状态));
    }
    if (来源需求) {
        写入需求节点引用(结果.回执.对应需求, 来源需求);
        结果.回执.目标满足关系 = 来源需求->主信息.满足关系;
    }

    const auto 满足判断 = 筹办_判定需求满足状态(需求上下文);
    记录需求满足项追踪_筹办(任务头, 来源需求, 满足判断);
    if (来源需求 && 满足判断.已满足) {
        记录筹办日志("父需求已满足，筹办退出 | 任务=" + 任务主键_筹办日志(任务头)
            + " | 来源需求=" + 需求主键_筹办日志(来源需求)
            + " | 可比较=" + std::to_string(满足判断.可比较 ? 1 : 0)
            + " | 关系=" + std::to_string(static_cast<I64>(满足判断.比较关系)));
        结果.回执.状况 = 父需求已满足;
        结果.回执.需要自我线程 = false;
        结果.回执.需要创建或复用子需求 = false;
        结果.回执.父任务需要重筹办 = false;
        写入筹办回执任务建议(
            结果.回执,
            枚举_任务状态::等待中,
            枚举_任务阶段::筹办);
        结果.回执.摘要 = "父需求已满足，筹办退出";
        return 结果;
    }

    if (来源需求 && 存在活动直接子需求(来源需求)) {
        记录筹办日志("存在活动子需求，筹办阻塞 | 任务=" + 任务主键_筹办日志(任务头)
            + " | 来源需求=" + 需求主键_筹办日志(来源需求));
        结果.回执.状况 = 存在活动子需求;
        写入筹办回执任务建议(
            结果.回执,
            枚举_任务状态::等待中,
            枚举_任务阶段::阻塞);
        return 结果;
    }

    if (!目标特征类型) {
        记录筹办日志("缺少需求目标特征 | 任务=" + 任务主键_筹办日志(任务头)
            + " | 来源需求=" + 需求主键_筹办日志(来源需求));
        结果.缺少需求目标 = true;
        结果.回执.状况 = 未定义;
        写入筹办回执任务建议(
            结果.回执,
            枚举_任务状态::无法执行,
            枚举_任务阶段::筹办);
        return 结果;
    }

    if (!目标宿主) {
        记录筹办日志("无法筹办：缺少需求目标宿主 | 任务=" + 任务主键_筹办日志(任务头)
            + " | 来源需求=" + 需求主键_筹办日志(来源需求)
            + " | 目标特征=" + 入口主键_筹办日志(目标特征类型)
            + " | 当前状态=" + 状态主键_筹办日志(当前状态)
            + " | 目标状态=" + 状态主键_筹办日志(目标状态));
        结果.缺少需求目标 = true;
        结果.回执.状况 = 未定义;
        写入筹办回执任务建议(
            结果.回执,
            枚举_任务状态::无法执行,
            枚举_任务阶段::筹办);
        return 结果;
    }

    const auto 目标语义视图 = 需求目标语义视图_筹办(目标特征类型);
    if (返回目标语义非普通筹办等待(
            结果,
            任务头,
            来源需求,
            目标语义视图)) {
        return 结果;
    }

    const auto 枚举目标校验 = 需求类::校验枚举目标合法性(
        目标特征类型,
        当前状态,
        目标状态,
        来源需求 && 来源需求->主信息.满足关系 != 0
            ? 来源需求->主信息.满足关系
            : 关系_等于);
    if (枚举目标校验.已检查 && 枚举目标校验.是枚举目标) {
        std::ostringstream 输出;
        输出 << "任务筹办枚举目标校验"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 来源需求=" << 需求主键_筹办日志(来源需求)
            << " | 目标特征=" << 入口主键_筹办日志(枚举目标校验.目标特征类型)
            << " | 生产者分级=" << 需求类::枚举目标生产者分级文本(枚举目标校验.生产者分级)
            << " | 比较符合法=" << (枚举目标校验.比较符合法 ? 1 : 0)
            << " | 值域命中=" << (枚举目标校验.目标值属于值域 ? 1 : 0)
            << " | 有生产者=" << (枚举目标校验.有合法生产者 ? 1 : 0)
            << " | 合法=" << (枚举目标校验.合法 ? 1 : 0)
            << " | 说明=" << 枚举目标校验.说明
            << " | 普通执行路径=" << (枚举目标校验.合法 ? 1 : 0)
            << " | 生成派生需求消息=0";
        记录筹办日志(输出.str());
    }
    if (枚举目标校验.已检查
        && 枚举目标校验.是枚举目标
        && !枚举目标校验.合法) {
        结果.缺少需求目标 = true;
        结果.回执.缺口特征类型 = 枚举目标校验.目标特征类型
            ? 枚举目标校验.目标特征类型
            : 目标特征类型;
        结果.回执.需要自我线程 =
            !枚举目标校验.有合法生产者;
        结果.回执.需要创建或复用子需求 =
            !枚举目标校验.有合法生产者;
        结果.回执.父任务需要重筹办 = false;
        结果.回执.状况 = 枚举目标校验.有合法生产者
            ? 未定义
            : 方法查找未命中;
        写入筹办回执任务建议(
            结果.回执,
            枚举目标校验.有合法生产者
                ? 枚举_任务状态::无法执行
                : 枚举_任务状态::等待中,
            枚举_任务阶段::筹办);
        结果.说明 = "枚举目标校验未通过，已阻断普通执行路径："
            + 枚举目标校验.说明;
        结果.回执.摘要 = 结果.说明;
        记录筹办日志("枚举目标校验阻断普通筹办"
            " | 任务=" + 任务主键_筹办日志(任务头)
            + " | 来源需求=" + 需求主键_筹办日志(来源需求)
            + " | 目标特征=" + 入口主键_筹办日志(结果.回执.缺口特征类型)
            + " | 生产者分级=" + 需求类::枚举目标生产者分级文本(枚举目标校验.生产者分级)
            + " | 说明=" + 枚举目标校验.说明);
        return 结果;
    }

    auto 因果路径入口壳 =
        筹办_按因果反推必要状态(
            自我对象,
            任务头,
            需求上下文,
            now);
    if (!因果路径入口壳.派生需求消息集.empty()) {
        结果.待上报派生需求消息集 = std::move(因果路径入口壳.派生需求消息集);
        bool 存在阻塞派生需求 = false;
        for (const auto& 派生需求消息 : 结果.待上报派生需求消息集) {
            const bool 是学习缺口 =
                派生需求消息.因果路径生成类型
                == 枚举_任务管理因果路径生成类型::学习缺口;
            if (!是学习缺口
                && (派生需求消息.是否阻塞当前步骤
                    || 派生需求消息.是否影响父任务推进)) {
                存在阻塞派生需求 = true;
                break;
            }
        }
        记录筹办日志(
            "因果路径筹办派生需求消息进入筹办结果"
            " | 任务=" + 任务主键_筹办日志(任务头)
            + " | 来源需求=" + 需求主键_筹办日志(来源需求)
            + " | 数量=" + std::to_string(结果.待上报派生需求消息集.size())
            + " | 存在阻塞派生需求=" + std::to_string(存在阻塞派生需求 ? 1 : 0)
            + " | 直接写需求树=0"
            + " | 实际发送派生需求消息=0");
        if (存在阻塞派生需求) {
            结果.回执.状况 = 存在活动子需求;
            结果.回执.需要自我线程 = true;
            结果.回执.需要创建或复用子需求 = true;
            结果.回执.父任务需要重筹办 = false;
            结果.说明 = "因果路径已生成阻塞派生子需求，父任务等待子需求结果或因果链更新";
            结果.回执.摘要 = 结果.说明;
            写入筹办回执任务建议(
                结果.回执,
                枚举_任务状态::等待中,
                枚举_任务阶段::阻塞);
            记录筹办日志(
                "因果路径正式阻塞派生需求等待子需求结果，筹办暂停"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                + " | 数量=" + std::to_string(结果.待上报派生需求消息集.size())
                + " | 父任务需重筹办=0"
                + " | 后续候选方法选择=0");
            return 结果;
        }
    }

    bool 已新建目标方法头 = false;
    std::vector<方法节点*> 本轮候选方法集{};
    auto* 目标方法 = 解析或创建任务目标方法(
        自我对象,
        任务头,
        now,
        &已新建目标方法头,
        &本轮候选方法集);
    if (!目标方法) {
        记录筹办日志("方法查找未命中 | 任务=" + 任务主键_筹办日志(任务头)
            + " | 来源需求=" + 需求主键_筹办日志(来源需求)
            + " | 目标特征=" + 入口主键_筹办日志(目标特征类型));
        结果.缺少需求目标 = true;
        结果.回执.状况 = 方法查找未命中;
        if (特征是学习信息补齐状态(目标特征类型)) {
            结果.说明 = "学习信息补齐目标缺少明确学习对象，等待方法结构缺口或来源因果";
            结果.回执.摘要 = 结果.说明;
            结果.回执.需要自我线程 = false;
            结果.回执.需要创建或复用子需求 = false;
            结果.回执.父任务需要重筹办 = false;
            写入筹办回执任务建议(
                结果.回执,
                枚举_任务状态::等待中,
                枚举_任务阶段::筹办);
            记录筹办日志("学习信息补齐目标缺少明确承接方法，进入等待"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                + " | 目标特征=" + 入口主键_筹办日志(目标特征类型)
                + " | 直接生成子需求=0"
                + " | 直接创建占位方法头=0");
            return 结果;
        }
        写入筹办回执任务建议(
            结果.回执,
            枚举_任务状态::待重筹办,
            枚举_任务阶段::筹办);
        return 结果;
    }

    结果.已绑定方法 = true;
    结果.已创建目标方法头 = 已新建目标方法头;
    for (auto* 候选方法 : 本轮候选方法集) {
        写入方法候选引用(结果.回执.候选方法集, 候选方法);
    }
    写入方法节点引用(结果.回执.当前方法, 目标方法);

    if (方法是学习补齐本能方法(目标方法)) {
        if (const I64 待提交入口本能ID = 已有单步本能入口待提交动作状态(目标方法, now)) {
            // 方法结构补齐任务会在下面直接绑定学习本能的可执行输入场景。
            // 但学习本能自身也必须先通过“提交方法可执行入口”形成
            // 方法动作状态=1 的可验收事实，否则自然流程永远缺真实入口样本。
            if (调用提交方法可执行入口(
                    自我对象,
                    任务头,
                    目标方法,
                    待提交入口本能ID,
                    now)) {
                结果.回执.状况 = 已建立方法头待重入;
                写入筹办回执任务建议(
                    结果.回执,
                    枚举_任务状态::待重筹办,
                    枚举_任务阶段::筹办);
                结果.回执.父任务需要重筹办 = true;
                结果.回执.需要自我线程 = false;
                结果.回执.需要创建或复用子需求 = false;
                结果.回执.缺口特征类型 = 私有_方法动作状态特征类型_执行桥_最小_v0();
                结果.说明 = "学习本能真实单步入口已提交为方法动作状态，等待下一轮重筹办";
                结果.回执.摘要 = 结果.说明;
                记录筹办日志("学习本能真实单步入口已提交"
                    " | 任务=" + 任务主键_筹办日志(任务头)
                    + " | 当前方法=" + 方法主键_筹办日志(目标方法)
                    + " | 本能ID=" + std::to_string(待提交入口本能ID));
                return 结果;
            }

            结果.回执.状况 = 方法缺可执行入口;
            写入筹办回执任务建议(
                结果.回执,
                枚举_任务状态::等待中,
                枚举_任务阶段::筹办);
            结果.回执.需要自我线程 = false;
            结果.回执.需要创建或复用子需求 = false;
            结果.回执.缺口特征类型 = 私有_方法可执行入口数量特征类型_执行桥_最小_v0();
            结果.说明 = "学习本能真实单步入口提交方法动作状态失败，等待入口提交链修复";
            结果.回执.摘要 = 结果.说明;
            记录筹办日志("学习本能真实单步入口提交失败"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 当前方法=" + 方法主键_筹办日志(目标方法)
                + " | 本能ID=" + std::to_string(待提交入口本能ID));
            return 结果;
        }
    }

    方法节点* 方法结构补齐被补方法 = nullptr;
    if (任务目标是方法结构补齐需求(任务头)) {
        方法结构补齐被补方法 = 任务方法结构补齐目标方法(自我对象, 任务头, now);
    }

    // 方法补齐任务和普通任务共用后续输入闭合流程。差异只体现在
    // “目标方法头节点”这个实参：学习/练习方法以被补方法作为输入目标。

    if (已新建目标方法头) {
        (void)方法虚拟存在服务类::初始化方法虚拟存在信息(
            目标方法,
            自我对象.获取自我存在(),
            now);
        (void)方法虚拟存在服务类::记录方法虚拟存在特征(
            目标方法,
            私有_方法状态特征类型_执行桥_最小_v0(),
            特征值{ static_cast<I64>(0) },
            自我对象.获取自我存在(),
            now);
        (void)方法虚拟存在服务类::记录方法虚拟存在特征(
            目标方法,
            特征_方法成熟度阶段(),
            特征值{ static_cast<I64>(0) },
            自我对象.获取自我存在(),
            now);
        (void)方法虚拟存在服务类::记录方法虚拟存在特征(
            目标方法,
            特征_方法结构是否完整(),
            特征值{ static_cast<I64>(0) },
            自我对象.获取自我存在(),
            now);
        (void)方法虚拟存在服务类::记录方法虚拟存在特征(
            目标方法,
            私有_方法运行账完整性特征类型_执行桥_最小_v0(),
            特征值{ static_cast<I64>(0) },
            自我对象.获取自我存在(),
            now);
        (void)方法虚拟存在服务类::记录方法虚拟存在特征(
            目标方法,
            私有_方法稳定状态特征类型_执行桥_最小_v0(),
            特征值{ static_cast<I64>(0) },
            自我对象.获取自我存在(),
            now);
        (void)方法虚拟存在服务类::记录方法虚拟存在特征(
            目标方法,
            特征_方法允许自动召回(),
            特征值{ static_cast<I64>(0) },
            自我对象.获取自我存在(),
            now);
        (void)方法虚拟存在服务类::记录方法虚拟存在特征(
            目标方法,
            特征_方法允许默认执行(),
            特征值{ static_cast<I64>(0) },
            自我对象.获取自我存在(),
            now);

        结果.已建立方法头待重入 = true;
        结果.回执.状况 = 已建立方法头待重入;
        写入筹办回执任务建议(
            结果.回执,
            枚举_任务状态::待重筹办,
            枚举_任务阶段::筹办);
        结果.回执.父任务需要重筹办 = true;
        结果.回执.需要自我线程 = false;
        结果.回执.需要创建或复用子需求 = false;
        结果.说明 = "任务筹办已建立目标方法头，等待下一轮重筹办检查可执行性";
        结果.回执.摘要 = 结果.说明;
        记录筹办日志("新建目标方法头后返回待重筹办"
            " | 任务=" + 任务主键_筹办日志(任务头)
            + " | 来源需求=" + 需求主键_筹办日志(来源需求)
            + " | 当前方法=" + 方法主键_筹办日志(目标方法)
            + " | 说明=方法头建立正确，本轮不直接追方法动作缺口");
        return 结果;
    }

    丢弃已绑定方法时的泛化学习缺口(
        结果,
        任务头,
        来源需求,
        目标方法,
        "已绑定既有目标方法，后续只允许精确方法结构缺口或直接执行路径");

    if (const I64 待提交入口本能ID = 已有单步本能入口待提交动作状态(目标方法, now)) {
        // 历史 / 初始化路径可能已经给方法写入真实单步本能动作句柄，
        // 但尚未通过方法域提交本能方法形成“方法动作状态=1”的可验收事实。
        // 这里不伪造入口数量，也不直接设置方法状态可用；只复用已存在的
        // 合法本能句柄走 自我_提交方法可执行入口，下一轮再检查条件结果对。
        if (调用提交方法可执行入口(
                自我对象,
                任务头,
                目标方法,
                待提交入口本能ID,
                now)) {
            结果.回执.状况 = 已建立方法头待重入;
            写入筹办回执任务建议(
                结果.回执,
                枚举_任务状态::待重筹办,
                枚举_任务阶段::筹办);
            结果.回执.父任务需要重筹办 = true;
            结果.回执.需要自我线程 = false;
            结果.回执.需要创建或复用子需求 = false;
            结果.回执.缺口特征类型 = 私有_方法动作状态特征类型_执行桥_最小_v0();
            结果.说明 = "已有真实单步本能入口已提交为方法动作状态，等待下一轮重筹办检查条件结果对";
            结果.回执.摘要 = 结果.说明;
            记录筹办日志("已有真实单步本能入口已提交"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 当前方法=" + 方法主键_筹办日志(目标方法)
                + " | 本能ID=" + std::to_string(待提交入口本能ID));
            return 结果;
        }

        结果.回执.状况 = 方法缺可执行入口;
        写入筹办回执任务建议(
            结果.回执,
            枚举_任务状态::等待中,
            枚举_任务阶段::筹办);
        结果.回执.需要自我线程 = false;
        结果.回执.需要创建或复用子需求 = false;
        结果.回执.缺口特征类型 = 私有_方法可执行入口数量特征类型_执行桥_最小_v0();
        结果.说明 = "已有真实单步本能入口提交方法动作状态失败，等待入口提交链修复";
        结果.回执.摘要 = 结果.说明;
        记录筹办日志("已有真实单步本能入口提交失败"
            " | 任务=" + 任务主键_筹办日志(任务头)
            + " | 当前方法=" + 方法主键_筹办日志(目标方法)
            + " | 本能ID=" + std::to_string(待提交入口本能ID));
        return 结果;
    }

    const auto 方法不可就绪状况 = 候选方法不可就绪状况(目标方法, now);
    if (方法不可就绪状况 != 未定义) {
        // 筹办的职责是形成“任务可就绪”的过程回执。
        // 找到并绑定当前方法只说明候选召回成功，不等于任务已经可执行。
        // 明确结构缺口必须保持精确目标，不能退回泛化的“方法状态=可用”。
        // 缺方法动作、缺可执行入口、缺条件结果对都是围绕“已找到的目标方法”的具体结构缺口。
        // 缺方法动作 / 缺可执行入口先做因果反推；反推无法直接提交时，仍上报结构化学习承接。
        记录筹办日志("候选方法条件检查对应缺口 | 对应普通步骤=条件检查 | 任务="
            + 任务主键_筹办日志(任务头)
            + " | 当前方法=" + 方法主键_筹办日志(目标方法)
            + " | 状况=" + std::to_string(static_cast<int>(方法不可就绪状况)));
        if (方法不可就绪状况 == 缺方法动作
            || 方法不可就绪状况 == 方法缺可执行入口) {
            return 返回自我动作组合缺口(
                结果,
                自我对象,
                任务头,
                目标方法,
                方法不可就绪状况,
                now)
                ? 结果
                : 结果;
        }
        if (方法不可就绪状况 == 方法缺条件结果对) {
            return 返回方法结构缺口(
                结果,
                任务头,
                目标方法,
                方法不可就绪状况,
                now)
                ? 结果
                : 结果;
        }

        if (返回方法状态可用性缺口(
                结果,
                任务头,
                目标方法,
                now)) {
            return 结果;
        }

        记录筹办日志("方法状态可用性缺口生成失败 | 任务=" + 任务主键_筹办日志(任务头)
            + " | 当前方法=" + 方法主键_筹办日志(目标方法)
            + " | 状况=" + std::to_string(static_cast<int>(方法不可就绪状况)));
        结果.回执.状况 = 方法不可就绪状况;
        写入筹办回执任务建议(
            结果.回执,
            枚举_任务状态::等待中,
            枚举_任务阶段::筹办);
        return 结果;
    }

    if (方法是任务完成后处理方法(目标方法)) {
        结果.回执.状况 = 方法前置条件未满足;
        写入筹办回执任务建议(
            结果.回执,
            枚举_任务状态::等待中,
            枚举_任务阶段::筹办);
        结果.回执.需要自我线程 = false;
        结果.回执.需要创建或复用子需求 = false;
        结果.回执.父任务需要重筹办 = false;
        结果.回执.缺口特征类型 = 特征_实际结果状态_筹办();
        结果.说明 = "结算叶子任务价值属于任务完成后处理链，不作为普通筹办当前方法";
        结果.回执.摘要 = 结果.说明;
        记录筹办日志("结算叶子任务价值普通筹办已拦截"
            " | 任务=" + 任务主键_筹办日志(任务头)
            + " | 当前方法=" + 方法主键_筹办日志(目标方法)
            + " | 任务状态=" + std::to_string(static_cast<int>(任务类::读取任务状态(任务头)))
            + " | 有来源需求=" + std::to_string(任务来源需求(任务头) ? 1 : 0)
            + " | 有实际结果状态=" + std::to_string(任务类::解析任务结果状态摘要_兼容(任务头) ? 1 : 0)
            + " | 安全权重=" + std::to_string(任务类::读取任务承接安全权重上限(任务头))
            + " | 服务权重=" + std::to_string(任务类::读取任务承接服务权重上限(任务头))
            + " | 说明=任务完成后价值结算链负责调用");
        return 结果;
    }

    if (方法是专用提交入口方法(目标方法)) {
        结果.回执.状况 = 方法前置条件未满足;
        写入筹办回执任务建议(
            结果.回执,
            枚举_任务状态::等待中,
            枚举_任务阶段::筹办);
        结果.回执.需要自我线程 = false;
        结果.回执.需要创建或复用子需求 = false;
        结果.回执.父任务需要重筹办 = false;
        结果.回执.缺口特征类型 = 特征_OR组结算令牌状态_筹办();
        结果.说明 = "OR组结算令牌提交属于逻辑组织提交链，不作为普通筹办当前方法";
        结果.回执.摘要 = 结果.说明;
        记录筹办日志("OR组结算令牌普通筹办已拦截"
            " | 任务=" + 任务主键_筹办日志(任务头)
            + " | 当前方法=" + 方法主键_筹办日志(目标方法));
        return 结果;
    }

    const auto 候选方法输入闭合结果 = 尝试构造候选方法输入参数场景(
        结果,
        任务头,
        目标方法,
        方法结构补齐被补方法,
        目标宿主,
        目标特征类型,
        当前状态,
        目标状态,
        now);
    if (!候选方法输入闭合结果.成功()) {
        // 缺少目标值 / 执行差值出处属于任务筹办缺口。
        // 筹办不按本能方法 ID 特判，而是按候选方法结果能力和输入闭合情况判断是否可执行。
        {
            std::ostringstream 输出;
            输出 << "候选方法输入未闭合"
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 当前方法=" << 方法主键_筹办日志(目标方法)
                << " | 闭合状态=" << static_cast<int>(候选方法输入闭合结果.状态)
                << " | 缺口特征=" << 入口主键_筹办日志(候选方法输入闭合结果.缺口特征类型)
                << " | 必需=" << 候选方法输入闭合结果.必需参数数量
                << " | 绑定=" << 候选方法输入闭合结果.已绑定参数数量
                << " | 缺失=" << 候选方法输入闭合结果.缺失参数数量;
            记录筹办日志(输出.str());
        }
        return 返回方法结构缺口(
            结果,
            任务头,
            目标方法,
            参数不可配,
            now,
            候选方法输入闭合结果.缺口特征类型)
            ? 结果
            : 结果;
    }

    // 通过可用性检查后，筹办才可以形成“任务可就绪”的回执。
    // 任务状态真正进入就绪仍由同步筹办回执和提交任务状态变化两个提交本能方法完成。
    结果.回执.状况 = 方法可执行;
    写入筹办回执任务建议(
        结果.回执,
        枚举_任务状态::就绪,
        枚举_任务阶段::执行);
    {
        std::ostringstream 输出;
        输出 << "筹办完成进入执行"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 来源需求=" << 需求主键_筹办日志(来源需求)
            << " | 当前方法=" << 方法主键_筹办日志(目标方法)
            << " | 新建方法头=" << (已新建目标方法头 ? 1 : 0);
        记录筹办日志(输出.str());
    }
    return 结果;
}

结构_安全因果风险树常驻维护结果 维护安全因果风险树常驻任务(
    ::自我类& 自我对象,
    时间戳 now) noexcept
{
    结构_安全因果风险树常驻维护结果 结果{};
    结果.已执行 = true;
    if (now == 0) {
        now = 结构体_时间戳::当前_微秒();
    }
    结果.已跳过 = true;
    结果.跳过原因 = "任务筹办无安全因果风险树更新权";
    记录筹办日志(
        "安全因果风险树常驻维护任务跳过"
        " | 原因=任务筹办无安全因果风险树更新权"
        " | 更新持有者=自我线程"
        " | 任务筹办更新权=0"
        " | 不执行搜索=1"
        " | 不写默认满足=1"
        " | 不写因素值=1"
        " | 不写风险安全层总值=1"
        " | 不写自我安全值=1");
    return 结果;
}

std::vector<结构_任务管理派生需求消息> 生成安全因果风险树缺口派生需求消息集(
    ::自我类& 自我对象,
    时间戳 now) noexcept
{
    std::vector<结构_任务管理派生需求消息> 消息集{};
    if (now == 0) {
        now = 结构体_时间戳::当前_微秒();
    }
    记录筹办日志(
        "安全因果风险树缺口派生需求消息跳过"
        " | 原因=任务筹办无安全因果风险树更新权"
        " | 更新持有者=自我线程"
        " | 任务筹办更新权=0"
        " | 直接写需求树=0"
        " | 不执行搜索=1"
        " | 不写默认满足=1"
        " | 不写因素值=1");
    return 消息集;
}

} // namespace 任务模块::筹办
