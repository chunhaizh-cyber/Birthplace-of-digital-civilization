    // 功能：按函数名执行对应处理。
    任务节点* 归一到任务头结点(任务节点* 节点) noexcept
    {
        auto* 当前 = 节点;
        while (当前) {
            if (任务类::读取任务节点种类(当前) == 枚举_任务节点种类::头结点) {
                return 当前;
            }
            当前 = static_cast<任务节点*>(当前->父);
        }
        return nullptr;
    }

    // 功能：按函数名执行对应处理。
    需求节点* 任务来源需求(const 任务节点* 任务头) noexcept
    {
        if (!任务头) {
            return nullptr;
        }
        const auto& 对应需求 = 任务类::读取任务对应需求引用(任务头);
        if (对应需求.指针) {
            return reinterpret_cast<需求节点*>(对应需求.指针);
        }
        if (!对应需求.主键.empty()) {
            auto* 自我存在 = 世界树.自我指针;
            auto* 需求根节点 = 自我存在 ? 世界树.获取需求根节点(自我存在) : nullptr;
            if (auto* 节点 = 需求类::按主键解析需求节点(
                    需求根节点,
                    对应需求.主键)) {
                return 节点;
            }
        }
        return nullptr;
    }

    // 功能：按函数名执行对应处理。
    const 状态节点主信息类* 状态主信息(const 状态节点类* 状态节点) noexcept
    {
        return 状态节点
            ? 世界树.取状态主信息(const_cast<状态节点类*>(状态节点))
            : nullptr;
    }

    // 功能：按函数名执行对应处理。
    const 语素入口节点类* 状态节点目标特征类型(const 状态节点类* 状态节点) noexcept
    {
        const auto* 主信息 = 状态主信息(状态节点);
        if (!主信息 || !主信息->状态特征.指针) {
            return nullptr;
        }
        const auto* 特征主信息 =
            dynamic_cast<const 特征节点主信息类*>(主信息->状态特征.指针->主信息);
        return 特征主信息 ? 特征主信息->类型 : nullptr;
    }

    // 功能：按函数名执行对应处理。
    基础信息节点类* 状态节点主体(const 状态节点类* 状态节点) noexcept
    {
        const auto* 主信息 = 状态主信息(状态节点);
        return 主信息 ? 主信息->状态主体.指针 : nullptr;
    }

    // 功能：按函数名执行对应处理。
    bool 状态节点I64值(const 状态节点类* 状态节点, I64& 输出值) noexcept
    {
        输出值 = 0;
        const auto* 主信息 = 状态主信息(状态节点);
        if (!主信息) {
            return false;
        }
        if (const auto* 标量 = std::get_if<I64>(&主信息->状态值)) {
            输出值 = *标量;
            return true;
        }
        return false;
    }

    // 功能：按函数名执行对应处理。
    std::int32_t 需求目标方向编码(const 需求节点* 来源需求) noexcept
    {
        if (!来源需求) {
            return 0;
        }

        需求类 需求服务{};
        auto* 方向节点 = 需求服务.获取需求方向(const_cast<需求节点*>(来源需求));
        std::int32_t 编码 = 0;
        return 二次特征类::读取方向比较结果编码_直接(方向节点, 编码) ? 编码 : 0;
    }

    // 功能：按函数名执行对应处理。
    const 语素入口节点类* 需求目标特征类型(const 需求节点* 需求) noexcept
    {
        return 需求类::读取需求目标特征类型(需求);
    }

    // 功能：按函数名执行对应处理。
    const 语素入口节点类* 任务对应需求目标特征类型(const 任务节点* 任务头) noexcept
    {
        return 需求目标特征类型(任务来源需求(任务头));
    }

    // 功能：补齐条件、参数、证据或方法能力缺口。
    bool 特征是学习信息补齐状态(const 语素入口节点类* 特征类型) noexcept
    {
        return 语素入口同一(
            特征类型,
            自我特征定义类::类型_学习_信息补齐状态());
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    const 语素入口节点类* 特征_OR组结算令牌状态_筹办() noexcept
    {
        static const 语素入口节点类* s_词 = 筹办特征词("OR组结算令牌状态");
        return s_词;
    }

    using 枚举_需求目标语义_筹办 = 需求类::枚举_需求目标语义;
    using 结构_需求目标语义视图_筹办 = 需求类::结构_需求目标语义视图;

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    结构_需求目标语义视图_筹办 需求目标语义视图_筹办(
        const 语素入口节点类* 目标特征类型) noexcept
    {
        return 需求类::需求目标语义视图(目标特征类型);
    }

    bool 需求已满足(const 需求节点* 需求) noexcept;

    // 功能：统计来源需求的直接子需求满足情况。
    void 统计直接子需求聚合_筹办(
        const 需求节点* 来源需求,
        std::size_t& 直接子需求数,
        std::size_t& 已满足子需求数,
        std::size_t& 未满足子需求数,
        std::string* 输出首个未满足子需求主键 = nullptr) noexcept
    {
        直接子需求数 = 0;
        已满足子需求数 = 0;
        未满足子需求数 = 0;
        if (输出首个未满足子需求主键) {
            输出首个未满足子需求主键->clear();
        }
        if (!来源需求 || !来源需求->子) {
            return;
        }

        auto* 首子 = reinterpret_cast<需求节点*>(来源需求->子);
        auto* 当前 = 首子;
        std::size_t 保护计数 = 0;
        do {
            if (!当前) {
                break;
            }
            ++直接子需求数;
            const bool 子已满足 =
                需求类::需求已截止(当前)
                || 需求已满足(当前);
            if (子已满足) {
                ++已满足子需求数;
            } else {
                ++未满足子需求数;
                if (输出首个未满足子需求主键
                    && 输出首个未满足子需求主键->empty()) {
                    *输出首个未满足子需求主键 = 当前->获取主键();
                }
            }

            当前 = reinterpret_cast<需求节点*>(当前->下);
            ++保护计数;
        } while (当前 && 当前 != 首子 && 保护计数 < 10000);
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    bool 返回直接子需求聚合筹办结果(
        任务模块::筹办::结构_任务筹办结果& 结果,
        const 任务节点* 任务头,
        const 需求节点* 来源需求,
        const 结构_需求目标语义视图_筹办& 视图,
        const char* 逻辑组名称) noexcept
    {
        const auto* 组名 = 逻辑组名称 ? 逻辑组名称 : "逻辑组织节点";
        std::size_t 直接子需求数 = 0;
        std::size_t 已满足子需求数 = 0;
        std::size_t 未满足子需求数 = 0;
        std::string 首个未满足子需求主键{};
        统计直接子需求聚合_筹办(
            来源需求,
            直接子需求数,
            已满足子需求数,
            未满足子需求数,
            &首个未满足子需求主键);
        const bool 存在结构缺口 = 直接子需求数 == 0;
        const bool 全部子需求已满足 = 直接子需求数 > 0 && 未满足子需求数 == 0;
        if (全部子需求已满足) {
            结果.回执.状况 = 任务模块::筹办::枚举_任务推进状况::目标结果符合;
            结果.回执.缺口特征类型 = nullptr;
            结果.回执.需要自我线程 = true;
            结果.回执.需要创建或复用子需求 = false;
            结果.回执.父任务需要重筹办 = true;
            结果.回执.当前任务目标达成 = true;
            结果.回执.完成度百万分比 = 1'000'000;
            可解析引用<状态节点类> 目标状态引用{};
            if (需求类::读取需求目标状态引用(来源需求, 目标状态引用)) {
                结果.回执.实际结果状态集.push_back(目标状态引用);
            }
            写入筹办回执任务建议(
                结果.回执,
                枚举_任务状态::完成,
                枚举_任务阶段::筹办);
        } else if (存在结构缺口) {
            结果.回执.状况 = 任务模块::筹办::枚举_任务推进状况::逻辑组织待聚合;
            结果.回执.缺口特征类型 = 视图.目标特征类型;
            结果.回执.需要自我线程 = false;
            结果.回执.需要创建或复用子需求 = false;
            结果.回执.父任务需要重筹办 = false;
            写入筹办回执任务建议(
                结果.回执,
                枚举_任务状态::等待中,
                枚举_任务阶段::阻塞);
        } else {
            结果.回执.状况 = 任务模块::筹办::枚举_任务推进状况::存在活动子需求;
            结果.回执.缺口特征类型 = 视图.目标特征类型;
            结果.回执.需要自我线程 = false;
            结果.回执.需要创建或复用子需求 = false;
            结果.回执.父任务需要重筹办 = false;
            写入筹办回执任务建议(
                结果.回执,
                枚举_任务状态::等待中,
                枚举_任务阶段::阻塞);
        }

        std::ostringstream 输出;
        输出 << 组名 << "聚合筹办视图"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 来源需求=" << 需求主键_筹办日志(来源需求)
            << " | 目标特征=" << 入口主键_筹办日志(视图.目标特征类型)
            << " | 直接子需求=" << 直接子需求数
            << " | 已满足子需求=" << 已满足子需求数
            << " | 未满足子需求=" << 未满足子需求数
            << " | 首个未满足子需求=" << 首个未满足子需求主键
            << " | 组节点满足回写输入=" << (全部子需求已满足 ? 1 : 0)
            << " | 任务筹办直接回写需求=0"
            << " | 候选方法填充=0";
        记录筹办日志(输出.str());
        return true;
    }

    // 功能：等待线程、任务、外设或条件变化。
    bool 返回目标语义非普通筹办等待(
        任务模块::筹办::结构_任务筹办结果& 结果,
        const 任务节点* 任务头,
        const 需求节点* 来源需求,
        const 结构_需求目标语义视图_筹办& 视图) noexcept
    {
        if (视图.可进入普通候选方法筹办) {
            return false;
        }
        if (视图.语义 == 枚举_需求目标语义_筹办::AND组满足) {
            return 返回直接子需求聚合筹办结果(
                结果,
                任务头,
                来源需求,
                视图,
                "AND组");
        }
        if (视图.语义 == 枚举_需求目标语义_筹办::方法路径完成) {
            return 返回直接子需求聚合筹办结果(
                结果,
                任务头,
                来源需求,
                视图,
                "方法路径组");
        }
        if (视图.语义 == 枚举_需求目标语义_筹办::因果子链支撑) {
            return 返回直接子需求聚合筹办结果(
                结果,
                任务头,
                来源需求,
                视图,
                "因果子链支撑");
        }

        结果.回执.状况 = 任务模块::筹办::枚举_任务推进状况::逻辑组织待聚合;
        结果.回执.缺口特征类型 = 视图.目标特征类型;
        结果.回执.需要自我线程 = false;
        结果.回执.需要创建或复用子需求 = false;
        结果.回执.父任务需要重筹办 = false;
        写入筹办回执任务建议(
            结果.回执,
            枚举_任务状态::等待中,
            枚举_任务阶段::阻塞);
        std::ostringstream 输出;
        输出 << "目标语义闸门阻断普通筹办"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 来源需求=" << 需求主键_筹办日志(来源需求)
            << " | 目标特征=" << 入口主键_筹办日志(视图.目标特征类型)
            << " | 目标语义=" << (视图.语义名称 ? 视图.语义名称 : "未知")
            << " | 逻辑组织目标=" << (视图.是逻辑组织目标 ? 1 : 0)
            << " | 结算令牌目标=" << (视图.是结算令牌目标 ? 1 : 0)
            << " | 普通候选方法筹办=0"
            << " | 候选方法填充=0"
            << " | 因果反推=0"
            << " | 创建学习需求=0";
        记录筹办日志(输出.str());
        return true;
    }

    struct 结构_需求生命周期上下文_筹办 {
        任务节点* 来源任务 = nullptr;
        需求节点* 来源需求 = nullptr;
        基础信息节点类* 需求主体 = nullptr;
        基础信息节点类* 被需求存在 = nullptr;
        基础信息节点类* 目标宿主 = nullptr;
        状态节点类* 当前状态 = nullptr;
        状态节点类* 目标状态 = nullptr;
        const 语素入口节点类* 目标特征类型 = nullptr;
        三向关系掩码 满足关系 = 关系_等于;
        bool 被需求存在由状态推导 = false;
        bool 缺来源需求 = false;
        bool 缺被需求存在 = false;
        bool 缺目标特征 = false;
        bool 缺当前状态 = false;
        bool 缺目标状态 = false;
    };

    struct 结构_筹办生命周期判断结果_筹办 {
        bool 已判断 = false;
        bool 可比较 = false;
        bool 已满足 = false;
        bool 当前状态缺失 = false;
        bool 目标状态缺失 = false;
        bool 使用主键相等判断 = false;
        枚举_三向关系 比较关系 = 枚举_三向关系::等于;
        三向关系掩码 满足关系 = 关系_等于;
    };

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    结构_需求生命周期上下文_筹办 筹办_构造需求生命周期上下文(
        const 需求节点* 来源需求) noexcept
    {
        结构_需求生命周期上下文_筹办 上下文{};
        上下文.来源需求 = const_cast<需求节点*>(来源需求);
        if (!来源需求) {
            上下文.缺来源需求 = true;
            return 上下文;
        }

        可解析引用<状态节点类> 当前状态引用{};
        可解析引用<状态节点类> 目标状态引用{};
        const bool 存在当前状态引用 =
            需求类::读取需求当前状态引用(来源需求, 当前状态引用);
        const bool 存在目标状态引用 =
            需求类::读取需求目标状态引用(来源需求, 目标状态引用);

        上下文.需求主体 = reinterpret_cast<基础信息节点类*>(
            需求类::解析需求主体(来源需求));
        上下文.被需求存在 = reinterpret_cast<基础信息节点类*>(
            需求类::解析需求目标宿主(来源需求));
        上下文.当前状态 = 需求类::解析需求当前状态(来源需求);
        上下文.目标状态 = 需求类::解析需求目标状态(来源需求);
        上下文.目标特征类型 = 需求类::读取需求目标特征类型(来源需求);
        上下文.满足关系 = 需求类::读取需求满足关系(来源需求, 关系_等于);

        上下文.目标宿主 = 状态节点主体(上下文.目标状态);
        if (!上下文.目标宿主) {
            上下文.目标宿主 = 状态节点主体(上下文.当前状态);
        }
        if (上下文.目标宿主) {
            上下文.被需求存在由状态推导 =
                上下文.目标宿主 != 上下文.被需求存在;
        } else {
            上下文.目标宿主 = 上下文.被需求存在;
        }

        上下文.缺被需求存在 = 上下文.目标宿主 == nullptr;
        上下文.缺目标特征 = 上下文.目标特征类型 == nullptr;
        上下文.缺当前状态 = 上下文.当前状态 == nullptr && !存在当前状态引用;
        上下文.缺目标状态 = 上下文.目标状态 == nullptr && !存在目标状态引用;
        return 上下文;
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    结构_需求生命周期上下文_筹办 筹办_构造需求生命周期上下文(
        const 任务节点* 任务头) noexcept
    {
        auto 上下文 = 筹办_构造需求生命周期上下文(任务来源需求(任务头));
        上下文.来源任务 = const_cast<任务节点*>(任务头);
        return 上下文;
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    结构_筹办生命周期判断结果_筹办 筹办_判定需求满足状态(
        const 结构_需求生命周期上下文_筹办& 上下文) noexcept
    {
        结构_筹办生命周期判断结果_筹办 结果{};
        结果.满足关系 = 上下文.满足关系 != 0 ? 上下文.满足关系 : 关系_等于;
        if (!上下文.来源需求) {
            return 结果;
        }

        if (上下文.当前状态 && 上下文.目标状态) {
            const auto 比较 = 世界树.比较状态(上下文.当前状态, 上下文.目标状态);
            结果.已判断 = true;
            结果.可比较 = 比较.可比较;
            结果.比较关系 = 比较.关系;
            结果.已满足 = 比较.可比较
                && 三向关系被接受(比较.关系, 结果.满足关系);
            return 结果;
        }

        结果.当前状态缺失 = 上下文.当前状态 == nullptr;
        结果.目标状态缺失 = 上下文.目标状态 == nullptr;
        可解析引用<状态节点类> 当前状态引用{};
        可解析引用<状态节点类> 目标状态引用{};
        (void)需求类::读取需求当前状态引用(上下文.来源需求, 当前状态引用);
        (void)需求类::读取需求目标状态引用(上下文.来源需求, 目标状态引用);
        const auto& 当前主键 = 当前状态引用.主键;
        const auto& 目标主键 = 目标状态引用.主键;
        if (!当前主键.empty() && 当前主键 == 目标主键) {
            结果.已判断 = true;
            结果.可比较 = true;
            结果.使用主键相等判断 = true;
            结果.比较关系 = 枚举_三向关系::等于;
            结果.已满足 = 三向关系被接受(枚举_三向关系::等于, 结果.满足关系);
            return 结果;
        }

        return 结果;
    }

    // 功能：按函数名执行对应处理。
    bool 需求已满足(const 需求节点* 需求) noexcept
    {
        return 筹办_判定需求满足状态(
            筹办_构造需求生命周期上下文(需求)).已满足;
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    const char* 满足来源文本_筹办(
        const 需求节点* 需求,
        const 结构_筹办生命周期判断结果_筹办& 判断) noexcept
    {
        if (需求类::需求已截止(需求)) {
            return "已截止";
        }
        if (判断.使用主键相等判断) {
            return "状态主键相等";
        }
        if (判断.可比较) {
            return "状态比较满足";
        }
        return "未满足";
    }

    // 功能：记录日志、动态、证据或运行痕迹。
    void 记录需求满足项追踪_筹办(
        const 任务节点* 任务头,
        const 需求节点* 来源需求,
        const 结构_筹办生命周期判断结果_筹办& 当前需求判断) noexcept
    {
        if (!来源需求) {
            return;
        }

        std::vector<const 需求节点*> 已满足需求{};
        std::vector<结构_需求生命周期上下文_筹办> 已满足上下文{};
        std::vector<结构_筹办生命周期判断结果_筹办> 已满足判断{};
        std::size_t 直接子总数 = 0;
        std::size_t 活动阻塞子数 = 0;
        std::size_t 已满足子数 = 0;
        std::size_t 已截止子数 = 0;
        if (来源需求->子) {
            auto* 首子 = reinterpret_cast<需求节点*>(来源需求->子);
            auto* 当前 = 首子;
            std::size_t 保护计数 = 0;
            do {
                if (!当前) {
                    break;
                }
                ++直接子总数;
                const bool 已截止 = 需求类::需求已截止(当前);
                const bool 活动阻塞 =
                    !已截止 && 需求类::需求阻塞父任务执行(当前);
                if (活动阻塞) {
                    ++活动阻塞子数;
                }
                if (已截止) {
                    ++已截止子数;
                }
                auto 子上下文 = 筹办_构造需求生命周期上下文(当前);
                auto 子判断 = 筹办_判定需求满足状态(子上下文);
                if (子判断.已满足) {
                    ++已满足子数;
                }
                if (已截止 || 子判断.已满足) {
                    已满足需求.push_back(当前);
                    已满足上下文.push_back(std::move(子上下文));
                    已满足判断.push_back(子判断);
                }
                当前 = reinterpret_cast<需求节点*>(当前->下);
                ++保护计数;
            } while (当前 && 当前 != 首子 && 保护计数 < 10000);
        }

        if (!当前需求判断.已满足 && 已满足需求.empty()) {
            return;
        }

        auto 记录项 = [&](const char* 项类型,
                         const 需求节点* 需求,
                         const 结构_需求生命周期上下文_筹办& 上下文,
                         const 结构_筹办生命周期判断结果_筹办& 判断) noexcept {
            std::ostringstream 输出;
            输出 << "需求满足项追踪/项"
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 当前需求=" << 需求主键_筹办日志(来源需求)
                << " | 项类型=" << (项类型 ? 项类型 : "")
                << " | 需求=" << 需求主键_筹办日志(需求)
                << " | 目标宿主=" << 基础主键_筹办日志(上下文.目标宿主)
                << " | 目标特征=" << 入口主键_筹办日志(上下文.目标特征类型)
                << " | 当前状态=" << 状态主键_筹办日志(上下文.当前状态)
                << " | 目标状态=" << 状态主键_筹办日志(上下文.目标状态)
                << " | 满足=" << (判断.已满足 ? 1 : 0)
                << " | 可比较=" << (判断.可比较 ? 1 : 0)
                << " | 关系=" << static_cast<I64>(判断.比较关系)
                << " | 满足关系=" << static_cast<I64>(判断.满足关系)
                << " | 来源=" << 满足来源文本_筹办(需求, 判断);
            if (需求) {
                输出 << " | 截止=" << static_cast<I64>(需求类::读取需求有效截止(需求))
                    << " | 阻塞父任务=" << (需求类::需求阻塞父任务执行(需求) ? 1 : 0)
                    << " | 安全权重=" << 需求类::读取需求安全权重(需求)
                    << " | 服务权重=" << 需求类::读取需求服务权重(需求);
            }
            记录筹办日志(输出.str());
        };

        const auto 当前上下文 = 筹办_构造需求生命周期上下文(来源需求);
        if (当前需求判断.已满足) {
            记录项("当前需求目标", 来源需求, 当前上下文, 当前需求判断);
        }
        for (std::size_t 索引 = 0; 索引 < 已满足需求.size(); ++索引) {
            记录项(
                "直接子需求",
                已满足需求[索引],
                已满足上下文[索引],
                已满足判断[索引]);
        }

        std::ostringstream 摘要;
        摘要 << "需求满足项追踪/摘要"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 当前需求=" << 需求主键_筹办日志(来源需求)
            << " | 当前需求满足=" << (当前需求判断.已满足 ? 1 : 0)
            << " | 直接子总数=" << 直接子总数
            << " | 活动阻塞子=" << 活动阻塞子数
            << " | 已满足子=" << 已满足子数
            << " | 已截止子=" << 已截止子数;
        记录筹办日志(摘要.str());
    }

    // 功能：按函数名执行对应处理。
    bool 存在活动直接子需求(const 需求节点* 需求) noexcept
    {
        if (!需求 || !需求->子) {
            return false;
        }
        auto* 首子 = reinterpret_cast<需求节点*>(需求->子);
        auto* 当前 = 首子;
        std::size_t 保护计数 = 0;
        do {
            if (当前
                && !需求类::需求已截止(当前)
                && 需求类::需求阻塞父任务执行(当前)
                && !需求已满足(当前)) {
                return true;
            }
            当前 = reinterpret_cast<需求节点*>(当前 ? 当前->下 : nullptr);
            ++保护计数;
        } while (当前 && 当前 != 首子 && 保护计数 < 10000);
        return false;
    }

    struct 结构_因果路径筹办入口壳结果 {
        bool 已检查 = false;
        bool 目标表达完整 = false;
        bool 目标比较已构造 = false;
        二次特征节点类* 目标比较 = nullptr;
        std::vector<结构_任务管理派生需求消息> 派生需求消息集{};
    };

    enum class 枚举_临时因果路径角色 : std::uint8_t {
        未定义 = 0,
        促成 = 1,
        避免 = 2,
        条件补齐 = 3,
        方法就绪 = 4,
        证据补齐 = 5,
        副作用约束 = 6,
        学习缺口 = 7,
    };

    struct 结构_临时因果路径项 {
        因果节点类* 来源因果 = nullptr;
        枚举_临时因果路径角色 角色 = 枚举_临时因果路径角色::未定义;
        I64 根分区 = 0;
        二次特征节点类* 子需求目标比较 = nullptr;
        std::uint32_t 贡献层级 = 0;
        I64 层级权重 = 0;
        I64 稳定度 = 0;
        bool 条件已满足 = false;
        bool 证据足够 = false;
        bool 来源因果已验证 = false;
        bool 目标已目标化 = false;
        bool 派生后父任务继续 = false;
        三向关系掩码 派生满足关系 = 关系_等于;
        基础信息节点类* 派生目标主体 = nullptr;
        const 语素入口节点类* 派生目标特征类型 = nullptr;
        状态节点类* 派生当前状态 = nullptr;
        状态节点类* 派生目标状态 = nullptr;
        I64 派生当前状态值 = 0;
        I64 派生目标状态值 = 0;
    };

    struct 结构_临时因果视图 {
        const 需求节点* 来源需求 = nullptr;
        const 二次特征节点类* 目标比较 = nullptr;
        I64 根分区 = 0;
        bool 观察材料质量目标 = false;
        bool 父需求依赖深度空间质量 = false;
        bool 父需求可降级继续 = false;
        I64 观察材料深度观察质量状态 = 筹办观察质量状态_可用;
        I64 观察材料空间坐标观察质量状态 = 筹办观察质量状态_可用;
        I64 观察材料质量缺口状态 = 0;
        I64 观察材料质量缺口原因集合 = 0;
        I64 观察材料空间类适用状态 = 筹办观察适用状态_可用;
        I64 观察材料风险判断适用状态 = 筹办观察适用状态_可用;
        I64 观察材料存在确认适用状态 = 筹办观察适用状态_可用;
        I64 观察材料质量改善线索状态 = 0;
        std::string 父需求继续策略{};
        std::vector<结构_临时因果路径项> 促成路径{};
        std::vector<结构_临时因果路径项> 避免路径{};
        std::vector<结构_临时因果路径项> 条件缺口{};
        std::vector<结构_临时因果路径项> 方法就绪缺口{};
        std::vector<结构_临时因果路径项> 证据缺口{};
        std::vector<结构_临时因果路径项> 副作用约束{};
        std::vector<结构_临时因果路径项> 学习缺口{};

        // 功能：按函数名执行对应处理。
        std::size_t 路径总数() const noexcept
        {
            return 促成路径.size()
                + 避免路径.size()
                + 条件缺口.size()
                + 方法就绪缺口.size()
                + 证据缺口.size()
                + 副作用约束.size()
                + 学习缺口.size();
        }
    };

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    I64 推导临时因果根分区_筹办查询(const 需求节点* 需求) noexcept
    {
        bool 关联安全 = false;
        bool 关联服务 = false;
        auto* 当前 = 需求;
        std::size_t 保护计数 = 0;
        while (当前 && ++保护计数 < 1024) {
            关联安全 = 关联安全 || 需求类::读取需求安全权重(当前) > 0;
            关联服务 = 关联服务 || 需求类::读取需求服务权重(当前) > 0;
            if (关联安全 && 关联服务) {
                break;
            }
            当前 = 当前->父 && 当前->父 != 当前
                ? 当前->父
                : nullptr;
        }
        if (关联安全 && 关联服务) {
            return 3;
        }
        if (关联安全) {
            return 1;
        }
        if (关联服务) {
            return 2;
        }
        return 0;
    }

    // 功能：计算权重、状态、差值或派生结果。
    I64 计算临时因果层级权重_百万分比(std::uint32_t 层级) noexcept
    {
        if (层级 == 0) {
            return 0;
        }
        I64 权重 = 900000;
        for (std::uint32_t i = 1; i < 层级; ++i) {
            权重 /= 10;
            if (权重 <= 0) {
                return 0;
            }
        }
        return 权重;
    }

    template<class T节点>
    std::string 引用主键_筹办查询(const 可解析引用<T节点>& 引用)
    {
        if (!引用.主键.empty()) {
            return 引用.主键;
        }
        return 引用.指针 ? 引用.指针->获取主键() : std::string{};
    }

    template<class T节点>
    bool 引用严格指向节点_筹办查询(
        const 可解析引用<T节点>& 引用,
        const T节点* 目标) noexcept
    {
        if (!目标 || !引用.有效()) {
            return false;
        }
        if (引用.指针 == 目标) {
            return true;
        }
        if (引用.主键.empty()) {
            return false;
        }
        const auto 目标主键 = 目标->获取主键();
        return !目标主键.empty() && 引用.主键 == 目标主键;
    }

    template<class T节点>
    bool 引用严格等价_筹办查询(
        const 可解析引用<T节点>& 左,
        const 可解析引用<T节点>& 右)
    {
        if (左.指针 || 右.指针) {
            return 左.指针 == 右.指针;
        }
        const auto 左主键 = 引用主键_筹办查询(左);
        const auto 右主键 = 引用主键_筹办查询(右);
        return !左主键.empty() && 左主键 == 右主键;
    }

    // 功能：解析输入文本、消息、场景或运行包。
    特征节点类* 解析特征引用_筹办查询(
        const 可解析引用<特征节点类>& 引用) noexcept
    {
        if (引用.指针) {
            return 引用.指针;
        }
        if (引用.主键.empty()) {
            return nullptr;
        }
        return 世界树.按主键解析特征节点(引用.主键);
    }

    // 功能：解析输入文本、消息、场景或运行包。
    状态节点类* 解析状态引用_筹办查询(
        const 可解析引用<状态节点类>& 引用) noexcept
    {
        if (引用.指针) {
            return const_cast<状态节点类*>(引用.指针);
        }
        if (引用.主键.empty()) {
            return nullptr;
        }
        return 世界树.按主键解析状态节点(引用.主键);
    }

    // 功能：根据当前输入生成目标数据、场景、动态或回执。
    枚举_任务管理因果路径生成类型 转换因果路径生成类型_筹办查询(
        const 枚举_临时因果路径角色 角色) noexcept
    {
        switch (角色) {
        case 枚举_临时因果路径角色::促成:
            return 枚举_任务管理因果路径生成类型::促成;
        case 枚举_临时因果路径角色::避免:
            return 枚举_任务管理因果路径生成类型::避免;
        case 枚举_临时因果路径角色::条件补齐:
            return 枚举_任务管理因果路径生成类型::条件补齐;
        case 枚举_临时因果路径角色::方法就绪:
            return 枚举_任务管理因果路径生成类型::方法就绪;
        case 枚举_临时因果路径角色::证据补齐:
            return 枚举_任务管理因果路径生成类型::证据补齐;
        case 枚举_临时因果路径角色::副作用约束:
            return 枚举_任务管理因果路径生成类型::副作用约束;
        case 枚举_临时因果路径角色::学习缺口:
            return 枚举_任务管理因果路径生成类型::学习缺口;
        case 枚举_临时因果路径角色::未定义:
        default:
            return 枚举_任务管理因果路径生成类型::未定义;
        }
    }

    // 功能：把输入数据转换为目标类型、语义或结构。
    枚举_任务管理派生需求类型 转换派生需求类型_筹办查询(
        const 枚举_临时因果路径角色 角色) noexcept
    {
        switch (角色) {
        case 枚举_临时因果路径角色::避免:
        case 枚举_临时因果路径角色::副作用约束:
            return 枚举_任务管理派生需求类型::风险处置;
        case 枚举_临时因果路径角色::条件补齐:
            return 枚举_任务管理派生需求类型::缺条件;
        case 枚举_临时因果路径角色::方法就绪:
            return 枚举_任务管理派生需求类型::方法结构;
        case 枚举_临时因果路径角色::证据补齐:
            return 枚举_任务管理派生需求类型::缺确认;
        case 枚举_临时因果路径角色::促成:
        case 枚举_临时因果路径角色::学习缺口:
            return 枚举_任务管理派生需求类型::缺信息;
        case 枚举_临时因果路径角色::未定义:
        default:
            return 枚举_任务管理派生需求类型::未定义;
        }
    }

    // 功能：把输入数据转换为目标类型、语义或结构。
    枚举_任务管理阻塞级别 转换阻塞级别_筹办查询(
        const 枚举_临时因果路径角色 角色) noexcept
    {
        switch (角色) {
        case 枚举_临时因果路径角色::避免:
        case 枚举_临时因果路径角色::副作用约束:
            return 枚举_任务管理阻塞级别::严重;
        case 枚举_临时因果路径角色::条件补齐:
        case 枚举_临时因果路径角色::方法就绪:
        case 枚举_临时因果路径角色::学习缺口:
            return 枚举_任务管理阻塞级别::中等;
        case 枚举_临时因果路径角色::证据补齐:
        case 枚举_临时因果路径角色::促成:
            return 枚举_任务管理阻塞级别::轻微;
        case 枚举_临时因果路径角色::未定义:
        default:
            return 枚举_任务管理阻塞级别::未定义;
        }
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    bool 派生消息字段完整_筹办查询(
        const 结构_任务管理派生需求消息& 消息) noexcept
    {
        return !消息.父需求主键.empty()
            && 消息.派生需求类型 != 枚举_任务管理派生需求类型::未定义
            && 消息.因果路径生成类型 != 枚举_任务管理因果路径生成类型::未定义
            && 消息.阻塞级别 != 枚举_任务管理阻塞级别::未定义
            && 消息.需求特征类型指针 != 0
            && !消息.需求特征类型主键.empty()
            && 消息.需求目标主体指针 != 0
            && !消息.需求目标主体主键.empty()
            && 消息.需求当前状态指针 != 0
            && !消息.需求当前状态主键.empty()
            && 消息.需求目标状态指针 != 0
            && !消息.需求目标状态主键.empty()
            && 消息.满足关系 != 0;
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    结构_任务管理派生需求消息 构造正式派生需求消息草案_筹办查询(
        const 任务节点* 任务头,
        const 需求节点* 来源需求,
        const 结构_临时因果路径项& 项,
        const 时间戳 now) noexcept
    {
        结构_任务管理派生需求消息 消息{};
        消息.消息头.任务主键 = 任务主键_筹办日志(任务头);
        消息.消息头.产生时间 = now;
        消息.父需求指针 = reinterpret_cast<std::uintptr_t>(
            const_cast<需求节点*>(来源需求));
        消息.父需求主键 = 来源需求 ? 来源需求->获取主键() : std::string{};
        消息.来源因果指针 = reinterpret_cast<std::uintptr_t>(项.来源因果);
        消息.来源因果主键 = 项.来源因果 ? 项.来源因果->获取主键() : std::string{};
        消息.派生需求类型 = 转换派生需求类型_筹办查询(项.角色);
        消息.因果路径生成类型 = 转换因果路径生成类型_筹办查询(项.角色);
        消息.阻塞级别 = 转换阻塞级别_筹办查询(项.角色);
        if (项.派生后父任务继续) {
            消息.阻塞级别 = 枚举_任务管理阻塞级别::轻微;
        }
        消息.是否阻塞当前步骤 = !项.派生后父任务继续;
        消息.是否影响父任务推进 = !项.派生后父任务继续;
        消息.是否可能影响安全 = 项.根分区 == 1 || 项.根分区 == 3;
        消息.是否可能影响服务 = 项.根分区 == 2 || 项.根分区 == 3;
        消息.是否建议线程重判 = true;
        消息.需求特征类型指针 =
            reinterpret_cast<std::uintptr_t>(项.派生目标特征类型);
        消息.需求特征类型主键 = 入口主键_筹办日志(项.派生目标特征类型);
        消息.需求目标主体指针 =
            reinterpret_cast<std::uintptr_t>(项.派生目标主体);
        消息.需求目标主体主键 = 基础主键_筹办日志(项.派生目标主体);
        消息.需求当前状态指针 =
            reinterpret_cast<std::uintptr_t>(项.派生当前状态);
        消息.需求当前状态主键 = 状态主键_筹办日志(项.派生当前状态);
        消息.需求目标状态指针 =
            reinterpret_cast<std::uintptr_t>(项.派生目标状态);
        消息.需求目标状态主键 = 状态主键_筹办日志(项.派生目标状态);
        消息.满足关系 = 项.派生满足关系 != 0
            ? 项.派生满足关系
            : 关系_等于;
        消息.贡献层级 = 项.贡献层级;
        消息.层级权重 = 项.层级权重;
        消息.稳定度摘要 = 项.稳定度;
        同步任务管理派生需求消息语义槽(消息);
        return 消息;
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    bool 因果证据足够_筹办查询(const 因果节点类* 因果节点) noexcept
    {
        bool 是初始模板 = false;
        bool 已验证 = false;
        bool 证据足够 = false;
        std::uint64_t 证据样本数量 = 0;
        I64 稳定度 = 0;
        世界树.读取因果证据状态(
            因果节点,
            是初始模板,
            已验证,
            证据样本数量,
            稳定度,
            证据足够);
        return 证据足够;
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    结构_临时因果路径项 构造临时因果路径项_筹办查询(
        因果节点类* 因果节点,
        const 枚举_临时因果路径角色 角色,
        const I64 根分区,
        二次特征节点类* 子需求目标比较,
        const std::uint32_t 贡献层级)
    {
        结构_临时因果路径项 项{};
        项.来源因果 = 因果节点;
        项.角色 = 角色;
        项.根分区 = 根分区;
        项.子需求目标比较 = 子需求目标比较;
        项.贡献层级 = 贡献层级;
        项.层级权重 = 计算临时因果层级权重_百万分比(贡献层级);
        bool 是初始模板 = false;
        bool 已验证 = false;
        bool 证据足够 = false;
        std::uint64_t 证据样本数量 = 0;
        I64 稳定度 = 0;
        世界树.读取因果证据状态(
            因果节点,
            是初始模板,
            已验证,
            证据样本数量,
            稳定度,
            证据足够);
        项.稳定度 = 稳定度;
        项.来源因果已验证 = 已验证;
        项.条件已满足 = !世界树.存在因果条件模板(因果节点);
        项.证据足够 = 证据足够;
        return 项;
    }

    状态节点类* 创建筹办I64状态节点(
        ::自我类& 自我对象,
        基础信息节点类* 主体,
        const 语素入口节点类* 特征类型,
        I64 值,
        时间戳 now) noexcept;

    // 功能：比较当前值、目标值或历史基准。
    bool 目标化条件目标状态路径项_筹办查询(
        ::自我类& 自我对象,
        结构_临时因果路径项& 项,
        状态节点类* 目标状态,
        const 时间戳 now) noexcept
    {
        const auto* 目标状态信息 = 状态主信息(目标状态);
        if (!目标状态信息) {
            return false;
        }

        auto* 目标主体 = 目标状态信息->状态主体.指针;
        auto* 条件特征 = 目标状态信息->状态特征.指针
            ? 目标状态信息->状态特征.指针
            : 解析特征引用_筹办查询(目标状态信息->状态特征);
        const auto* 目标特征类型 = 状态节点目标特征类型(目标状态);
        I64 目标值 = 0;
        if (!目标主体
            || !条件特征
            || !目标特征类型
            || !状态节点I64值(目标状态, 目标值)) {
            return false;
        }

        I64 当前值 = 0;
        const bool 当前值已读 =
            世界树.读取特征_I64(条件特征, 当前值)
            || 世界树.读取特征_I64(目标主体, 目标特征类型, 当前值);
        if (!当前值已读) {
            return false;
        }
        if (当前值 == 目标值) {
            项.条件已满足 = true;
            return true;
        }

        auto* 当前状态 = 创建筹办I64状态节点(
            自我对象,
            目标主体,
            目标特征类型,
            当前值,
            now);
        if (!当前状态) {
            return false;
        }

        项.条件已满足 = false;
        项.目标已目标化 = true;
        项.派生目标主体 = 目标主体;
        项.派生目标特征类型 = 目标特征类型;
        项.派生当前状态 = 当前状态;
        项.派生目标状态 = 目标状态;
        项.派生当前状态值 = 当前值;
        项.派生目标状态值 = 目标值;
        项.派生满足关系 = 关系_等于;

        return true;
    }

    // 功能：判断因果条件缺口是否重复当前来源需求目标。
    bool 因果条件缺口重复来源需求目标_筹办查询(
        const 结构_临时因果视图& 视图,
        const 结构_临时因果路径项& 项) noexcept
    {
        const auto* 来源需求 = 视图.来源需求;
        if (!来源需求
            || !项.目标已目标化
            || !项.派生目标主体
            || !项.派生目标特征类型
            || !项.派生目标状态) {
            return false;
        }

        const auto* 来源目标特征 = 需求目标特征类型(来源需求);
        if (!语素入口同一(来源目标特征, 项.派生目标特征类型)) {
            return false;
        }

        auto* 来源目标主体 = 状态节点主体(需求类::解析需求目标状态(来源需求));
        if (!来源目标主体) {
            来源目标主体 = 状态节点主体(需求类::解析需求当前状态(来源需求));
        }
        if (!来源目标主体) {
            来源目标主体 = reinterpret_cast<基础信息节点类*>(
                需求类::解析需求目标宿主(来源需求));
        }
        if (来源目标主体 && 来源目标主体 != 项.派生目标主体) {
            return false;
        }

        可解析引用<状态节点类> 来源目标状态引用{};
        (void)需求类::读取需求目标状态引用(来源需求, 来源目标状态引用);
        auto* 来源目标状态 = 需求类::解析需求目标状态(来源需求);
        if (来源目标状态 && 项.派生目标状态) {
            const auto 比较 = 世界树.比较状态(来源目标状态, 项.派生目标状态);
            if (!比较.可比较 || 比较.关系 != 枚举_三向关系::等于) {
                return false;
            }
        } else if (!来源目标状态引用.主键.empty()
            && !状态主键_筹办日志(项.派生目标状态).empty()
            && 来源目标状态引用.主键 != 状态主键_筹办日志(项.派生目标状态)) {
            return false;
        }

        const auto 来源满足关系 = 需求类::读取需求满足关系(来源需求, 关系_等于);
        const auto 派生满足关系 = 项.派生满足关系 != 0
            ? 项.派生满足关系
            : 关系_等于;
        return (来源满足关系 & 派生满足关系) != 0;
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    void 吸收因果条件缺口_筹办查询(
        ::自我类& 自我对象,
        结构_临时因果视图& 视图,
        因果节点类* 因果节点,
        const 时间戳 now)
    {
        std::vector<状态节点类*> 条件目标状态集{};
        std::vector<std::string> 条件缺失证据{};
        世界树.枚举因果条件目标状态(
            因果节点,
            条件目标状态集,
            条件缺失证据);
        if (条件目标状态集.empty() && 条件缺失证据.empty()) {
            return;
        }
        std::size_t 条件目标状态数量 = 0;
        std::size_t 条件已满足数量 = 0;
        std::size_t 条件缺口目标化数量 = 0;
        std::size_t 条件自目标跳过数量 = 0;
        std::size_t 条件不可目标化数量 = 条件缺失证据.size();
        for (auto* 目标状态 : 条件目标状态集) {
            if (!目标状态) {
                continue;
            }
            ++条件目标状态数量;
            auto 项 = 构造临时因果路径项_筹办查询(
                因果节点,
                枚举_临时因果路径角色::条件补齐,
                视图.根分区,
                nullptr,
                2);
            if (!目标化条件目标状态路径项_筹办查询(
                    自我对象,
                    项,
                    目标状态,
                    now)) {
                ++条件不可目标化数量;
                continue;
            }
            if (项.条件已满足) {
                ++条件已满足数量;
                continue;
            }
            if (项.目标已目标化
                && 项.派生目标主体
                && 项.派生目标特征类型
                && 项.派生当前状态
                && 项.派生目标状态) {
                if (因果条件缺口重复来源需求目标_筹办查询(视图, 项)) {
                    ++条件自目标跳过数量;
                    std::ostringstream 跳过;
                    跳过 << "因果条件缺口自目标跳过"
                        << " | 因果=" << 基础主键_筹办日志(因果节点)
                        << " | 来源需求=" << 需求主键_筹办日志(视图.来源需求)
                        << " | 目标宿主=" << 基础主键_筹办日志(项.派生目标主体)
                        << " | 目标特征=" << 入口主键_筹办日志(项.派生目标特征类型)
                        << " | 目标状态=" << 状态主键_筹办日志(项.派生目标状态)
                        << " | 满足关系=" << static_cast<I64>(项.派生满足关系 != 0 ? 项.派生满足关系 : 关系_等于)
                        << " | 不发送派生需求消息=1"
                        << " | 直接写需求树=0";
                    记录筹办日志(跳过.str());
                    continue;
                }
                视图.条件缺口.push_back(std::move(项));
                ++条件缺口目标化数量;
            } else {
                ++条件不可目标化数量;
            }
        }
        if (条件目标状态数量 > 0 || 条件不可目标化数量 > 0) {
            std::ostringstream 输出;
            输出 << "因果条件缺口目标化统计"
                << " | 因果=" << 基础主键_筹办日志(因果节点)
                << " | 条件目标状态=" << 条件目标状态数量
                << " | 条件已满足=" << 条件已满足数量
                << " | 条件缺口目标化=" << 条件缺口目标化数量
                << " | 条件自目标跳过=" << 条件自目标跳过数量
                << " | 条件不可目标化=" << 条件不可目标化数量
                << " | 不生成裸条件缺口=1"
                << " | 直接写需求树=0";
            记录筹办日志(输出.str());
        }
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    void 吸收因果方法就绪缺口_筹办查询(
        结构_临时因果视图& 视图,
        因果节点类* 因果节点)
    {
        方法节点类* 因方法 = nullptr;
        bool 有方法模板 = false;
        bool 有动作语义 = false;
        std::string 动作语义键{};
        世界树.查询因果动作来源(
            因果节点,
            因方法,
            有方法模板,
            有动作语义,
            动作语义键);
        if (!有方法模板) {
            return;
        }
        视图.方法就绪缺口.push_back(构造临时因果路径项_筹办查询(
            因果节点,
            枚举_临时因果路径角色::方法就绪,
            视图.根分区,
            nullptr,
            3));
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    void 吸收因果证据缺口_筹办查询(
        结构_临时因果视图& 视图,
        因果节点类* 因果节点)
    {
        if (因果证据足够_筹办查询(因果节点)) {
            return;
        }
        视图.证据缺口.push_back(构造临时因果路径项_筹办查询(
            因果节点,
            枚举_临时因果路径角色::证据补齐,
            视图.根分区,
            nullptr,
            3));
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    void 吸收促成因果到临时视图_筹办查询(
        ::自我类& 自我对象,
        结构_临时因果视图& 视图,
        因果节点类* 因果节点,
        const 时间戳 now)
    {
        吸收因果条件缺口_筹办查询(自我对象, 视图, 因果节点, now);
        吸收因果方法就绪缺口_筹办查询(视图, 因果节点);
        吸收因果证据缺口_筹办查询(视图, 因果节点);
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    void 吸收避免因果到临时视图_筹办查询(
        ::自我类& 自我对象,
        结构_临时因果视图& 视图,
        因果节点类* 因果节点,
        const 时间戳 now)
    {
        吸收因果条件缺口_筹办查询(自我对象, 视图, 因果节点, now);
        吸收因果证据缺口_筹办查询(视图, 因果节点);
    }

    // 功能：创建并返回或登记对应对象。
    状态节点类* 创建筹办I64状态节点(
        ::自我类& 自我对象,
        基础信息节点类* 主体,
        const 语素入口节点类* 特征类型,
        const I64 值,
        const 时间戳 now) noexcept
    {
        if (!主体 || !特征类型) {
            return nullptr;
        }
        auto* 场景 = 自我对象.获取自我内部世界();
        if (!场景) {
            场景 = 自我对象.获取自我现实场景();
        }
        auto* 特征 = 世界树.确保特征(主体, 特征类型);
        if (!场景 || !特征) {
            return nullptr;
        }
        return 世界树.创建状态(
            场景,
            主体,
            特征,
            特征值{ 值 },
            now,
            now);
    }

    // 功能：确保目标结构、状态或前置条件存在并可用。
    void 确保临时视图学习缺口_筹办查询(
        ::自我类& 自我对象,
        结构_临时因果视图& 视图,
        const 时间戳 now)
    {
        if (视图.路径总数() != 0) {
            return;
        }
        if (视图.来源需求 == 自我对象.获取安全根需求()
            || 视图.来源需求 == 自我对象.获取服务根需求()) {
            记录筹办日志("因果路径筹办学习缺口跳过"
                " | 原因=根需求缺口必须由根闭环/风险树/服务触发事实展开，禁止泛化学习缺口挂根"
                " | 来源需求=" + 需求主键_筹办日志(视图.来源需求)
                + " | 目标比较=" + 基础主键_筹办日志(
                    const_cast<基础信息节点类*>(reinterpret_cast<const 基础信息节点类*>(视图.目标比较)))
                + " | 直接写需求树=0 | 实际发送派生需求消息=0");
            return;
        }
        if (特征是学习信息补齐状态(需求目标特征类型(视图.来源需求))) {
            记录筹办日志("因果路径筹办学习缺口跳过"
                " | 原因=目标本身已是学习信息补齐状态，禁止递归派生同类学习缺口"
                " | 来源需求=" + 需求主键_筹办日志(视图.来源需求)
                + " | 目标比较=" + 基础主键_筹办日志(
                    const_cast<基础信息节点类*>(reinterpret_cast<const 基础信息节点类*>(视图.目标比较)))
                + " | 直接写需求树=0 | 实际发送派生需求消息=0");
            return;
        }
        if (!视图.观察材料质量目标) {
            记录筹办日志("因果路径筹办学习缺口跳过"
                " | 原因=缺明确学习对象或方法结构来源，禁止生成泛化学习信息补齐叶子"
                " | 来源需求=" + 需求主键_筹办日志(视图.来源需求)
                + " | 目标比较=" + 基础主键_筹办日志(
                    const_cast<基础信息节点类*>(reinterpret_cast<const 基础信息节点类*>(视图.目标比较)))
                + " | 直接写需求树=0 | 实际发送派生需求消息=0");
            return;
        }
        结构_临时因果路径项 项{};
        项.角色 = 枚举_临时因果路径角色::学习缺口;
        项.根分区 = 视图.根分区;
        项.子需求目标比较 = nullptr;
        项.贡献层级 = 3;
        项.层级权重 = 计算临时因果层级权重_百万分比(项.贡献层级);
        项.目标已目标化 = 视图.目标比较 != nullptr;
        项.派生目标主体 = reinterpret_cast<基础信息节点类*>(
            const_cast<二次特征节点类*>(视图.目标比较));
        项.派生后父任务继续 = 视图.父需求继续策略 != "等待子需求";
        项.派生目标特征类型 = 特征_筹办_观察质量改善路径验证状态();
        项.派生当前状态值 = 学习原子状态词典::未验证;
        项.派生目标状态值 = 学习原子状态词典::已验证;
        auto* 状态场景 = 自我对象.获取自我内部世界();
        if (!状态场景) {
            状态场景 = 自我对象.获取自我现实场景();
        }
        if (状态场景
            && 项.派生目标主体
            && 项.派生目标特征类型) {
            项.派生当前状态 = 自我对象.创建学习I64原子状态(
                状态场景,
                项.派生目标主体,
                项.派生目标特征类型,
                项.派生当前状态值,
                now);
            项.派生目标状态 = 自我对象.创建学习I64原子状态(
                状态场景,
                项.派生目标主体,
                项.派生目标特征类型,
                项.派生目标状态值,
                now);
        }
        视图.学习缺口.push_back(项);
    }

    // 功能：记录日志、动态、证据或运行痕迹。
    void 记录临时因果视图统计_筹办查询(
        const 任务节点* 任务头,
        const 结构_临时因果视图& 视图)
    {
        std::size_t 学习缺口已目标化数量 = 0;
        for (const auto& 项 : 视图.学习缺口) {
            if (项.目标已目标化
                && 项.派生目标主体
                && 项.派生目标特征类型
                && (项.派生目标状态值 == 学习原子状态词典::已补齐
                    || 项.派生目标状态值 == 学习原子状态词典::已验证)) {
                ++学习缺口已目标化数量;
            }
        }

        std::ostringstream 输出;
        输出 << "因果路径筹办临时视图统计"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 来源需求=" << 需求主键_筹办日志(视图.来源需求)
            << " | 目标比较=" << 基础主键_筹办日志(
                const_cast<基础信息节点类*>(reinterpret_cast<const 基础信息节点类*>(视图.目标比较)))
            << " | 根分区=" << 视图.根分区
            << " | 观察材料质量目标=" << (视图.观察材料质量目标 ? 1 : 0)
            << " | 父需求依赖深度空间=" << (视图.父需求依赖深度空间质量 ? 1 : 0)
            << " | 父需求继续策略=" << 视图.父需求继续策略
            << " | 深度观察质量状态=" << 视图.观察材料深度观察质量状态
            << " | 空间坐标观察质量状态=" << 视图.观察材料空间坐标观察质量状态
            << " | 质量缺口状态=" << 视图.观察材料质量缺口状态
            << " | 促成路径=" << 视图.促成路径.size()
            << " | 避免路径=" << 视图.避免路径.size()
            << " | 条件缺口=" << 视图.条件缺口.size()
            << " | 方法就绪缺口=" << 视图.方法就绪缺口.size()
            << " | 证据缺口=" << 视图.证据缺口.size()
            << " | 副作用约束=" << 视图.副作用约束.size()
            << " | 学习缺口=" << 视图.学习缺口.size()
            << " | 学习缺口目标化=" << 学习缺口已目标化数量
            << " | 临时视图入树=0"
            << " | 直接写需求树=0"
            << " | 实际发送派生需求消息=0";
        记录筹办日志(输出.str());
    }

    void 记录派生需求消息草案统计_筹办查询(
        const 任务节点* 任务头,
        const 结构_临时因果视图& 视图,
        const 时间戳 now,
        std::vector<结构_任务管理派生需求消息>* 输出正式消息集 = nullptr) noexcept
    {
        std::size_t 路径项数量 = 0;
        std::size_t 已目标化数量 = 0;
        std::size_t 字段完整数量 = 0;
        std::size_t 草案数量 = 0;
        std::size_t 正式消息数量 = 0;
        std::size_t 正式消息字段完整数量 = 0;
        std::size_t 状态物化数量 = 0;
        std::size_t 缺父需求数量 = 0;
        std::size_t 缺目标主体数量 = 0;
        std::size_t 缺目标特征数量 = 0;
        std::size_t 缺状态节点数量 = 0;

        const auto 检查路径项 = [&](const 结构_临时因果路径项& 项) noexcept {
            ++路径项数量;

            if (!视图.来源需求) {
                ++缺父需求数量;
            }
            if (项.目标已目标化) {
                ++已目标化数量;
            }
            if (!项.派生目标主体) {
                ++缺目标主体数量;
            }
            if (!项.派生目标特征类型) {
                ++缺目标特征数量;
            }
            if (!项.派生当前状态 || !项.派生目标状态) {
                ++缺状态节点数量;
                return;
            }
            ++状态物化数量;

            if (视图.来源需求
                && 项.目标已目标化
                && 项.派生目标主体
                && 项.派生目标特征类型) {
                ++字段完整数量;
                ++草案数量;
                const auto 消息 = 构造正式派生需求消息草案_筹办查询(
                    任务头,
                    视图.来源需求,
                    项,
                    now);
                ++正式消息数量;
                const bool 消息字段完整 = 派生消息字段完整_筹办查询(消息);
                if (消息字段完整) {
                    ++正式消息字段完整数量;
                    if (输出正式消息集) {
                        输出正式消息集->push_back(消息);
                    }
                }
                if (正式消息数量 == 1) {
                    记录筹办日志(
                        "因果路径筹办正式派生需求消息草案样本 | "
                        + 构造任务管理派生需求消息文本(消息)
                        + " | 字段完整=" + std::to_string(消息字段完整 ? 1 : 0)
                        + " | 直接写需求树=0 | 实际发送派生需求消息=0");
                }
            }
        };

        const auto 检查路径集 = [&](const std::vector<结构_临时因果路径项>& 路径集) noexcept {
            for (const auto& 项 : 路径集) {
                检查路径项(项);
            }
        };
        检查路径集(视图.促成路径);
        检查路径集(视图.避免路径);
        检查路径集(视图.条件缺口);
        检查路径集(视图.方法就绪缺口);
        检查路径集(视图.证据缺口);
        检查路径集(视图.副作用约束);
        检查路径集(视图.学习缺口);

        std::ostringstream 输出;
        输出 << "因果路径筹办派生消息草案统计"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 来源需求=" << 需求主键_筹办日志(视图.来源需求)
            << " | 目标比较=" << 基础主键_筹办日志(
                const_cast<基础信息节点类*>(reinterpret_cast<const 基础信息节点类*>(视图.目标比较)))
            << " | 路径项=" << 路径项数量
            << " | 已目标化=" << 已目标化数量
            << " | 字段完整=" << 字段完整数量
            << " | 草案数量=" << 草案数量
            << " | 正式消息数量=" << 正式消息数量
            << " | 正式消息字段完整=" << 正式消息字段完整数量
            << " | 状态物化=" << 状态物化数量
            << " | 缺父需求=" << 缺父需求数量
            << " | 缺目标主体=" << 缺目标主体数量
            << " | 缺目标特征=" << 缺目标特征数量
            << " | 缺状态节点=" << 缺状态节点数量
            << " | 直接写需求树=0"
            << " | 实际发送派生需求消息=0";
        记录筹办日志(输出.str());
    }

    // 功能：执行任务、方法或动作的主体逻辑。
    void 执行因果路径查询壳(
        ::自我类& 自我对象,
        const 任务节点* 任务头,
        const 需求节点* 来源需求,
        const 结构_需求生命周期上下文_筹办& 需求上下文,
        const 二次特征节点类* 目标比较,
        const 时间戳 now,
        std::vector<结构_任务管理派生需求消息>* 输出派生需求消息集 = nullptr) noexcept
    {
        std::size_t 因果节点数量 = 0;
        std::size_t 有主信息数量 = 0;
        std::size_t 因果模板数量 = 0;
        std::size_t 初始因果模板数量 = 0;
        std::size_t 后天验证因果数量 = 0;
        std::size_t 主果模板声明数量 = 0;
        std::size_t 主果可解析数量 = 0;
        std::size_t 主果不可解析数量 = 0;
        std::size_t 主果同向命中数量 = 0;
        std::size_t 主果反向命中数量 = 0;
        const auto 查询开始 = std::chrono::steady_clock::now();

        if (!目标比较) {
            记录筹办日志("因果路径筹办查询壳跳过 | 原因=缺目标比较"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                + " | 直接写需求树=0 | 生成派生需求消息=0");
            return;
        }

        结构_临时因果视图 视图{};
        视图.来源需求 = 来源需求;
        视图.目标比较 = 目标比较;
        视图.根分区 = 推导临时因果根分区_筹办查询(来源需求);

        std::string 首个命中因果键{};
        bool 首个命中因果已验证 = false;
        std::vector<因果节点类*> 同向命中因果{};
        std::vector<因果节点类*> 反向命中因果{};
        std::vector<std::string> 缺失证据{};
        世界树.查询主果方向命中因果(
            目标比较,
            true,
            因果节点数量,
            主果可解析数量,
            同向命中因果,
            反向命中因果,
            缺失证据);
        有主信息数量 = 因果节点数量;
        因果模板数量 = 因果节点数量;
        主果不可解析数量 = 缺失证据.size();
        主果模板声明数量 = 主果可解析数量 + 主果不可解析数量;
        主果同向命中数量 = 同向命中因果.size();
        主果反向命中数量 = 反向命中因果.size();

        auto 吸收命中因果 = [&](因果节点类* 因果节点, const bool 作为促成) {
            if (!因果节点) {
                return;
            }

            bool 是初始模板 = false;
            bool 已验证 = false;
            bool 证据足够 = false;
            std::uint64_t 证据样本数量 = 0;
            I64 稳定度 = 0;
            世界树.读取因果证据状态(
                因果节点,
                是初始模板,
                已验证,
                证据样本数量,
                稳定度,
                证据足够);
            if (是初始模板) {
                ++初始因果模板数量;
            }
            if (已验证) {
                ++后天验证因果数量;
            }
            if (首个命中因果键.empty()) {
                首个命中因果键 = 基础主键_筹办日志(因果节点);
                首个命中因果已验证 = 已验证;
            }
            if (作为促成) {
                吸收促成因果到临时视图_筹办查询(
                    自我对象,
                    视图,
                    因果节点,
                    now);
            } else {
                吸收避免因果到临时视图_筹办查询(
                    自我对象,
                    视图,
                    因果节点,
                    now);
            }
        };

        for (auto* 因果节点 : 同向命中因果) {
            吸收命中因果(因果节点, true);
        }
        for (auto* 因果节点 : 反向命中因果) {
            吸收命中因果(因果节点, false);
        }

        // 安全因果风险树由自我线程持有并按变化闸门维护；
        // 任务筹办只消费已有因果路径、方法条件和风险树缺口，不在查询壳内刷新树视图。

        确保临时视图学习缺口_筹办查询(
            自我对象,
            视图,
            now);

        std::ostringstream 输出;
        const auto 查询耗时 = std::chrono::duration_cast<std::chrono::milliseconds>(
            std::chrono::steady_clock::now() - 查询开始).count();
        输出 << "因果路径筹办查询壳统计"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 来源需求=" << 需求主键_筹办日志(来源需求)
            << " | 目标比较=" << 基础主键_筹办日志(
                const_cast<基础信息节点类*>(reinterpret_cast<const 基础信息节点类*>(目标比较)))
            << " | 因果节点=" << 因果节点数量
            << " | 有主信息=" << 有主信息数量
            << " | 因果模板=" << 因果模板数量
            << " | 命中初始因果模板=" << 初始因果模板数量
            << " | 命中后天验证因果=" << 后天验证因果数量
            << " | 主果模板声明=" << 主果模板声明数量
            << " | 主果可解析=" << 主果可解析数量
            << " | 主果不可解析=" << 主果不可解析数量
            << " | 主果同向命中=" << 主果同向命中数量
            << " | 主果反向命中=" << 主果反向命中数量
            << " | 命中因果模板ID=" << (首个命中因果键.empty() ? std::string("空") : 首个命中因果键)
            << " | 命中因果后天验证=" << (首个命中因果已验证 ? 1 : 0)
            << " | 耗时ms=" << 查询耗时
            << " | 直接写需求树=0"
            << " | 实际发送派生需求消息=0";
        记录筹办日志(输出.str());
        记录临时因果视图统计_筹办查询(任务头, 视图);
        记录派生需求消息草案统计_筹办查询(
            任务头,
            视图,
            now,
            输出派生需求消息集);
    }

    因果节点类* 查找安全因果风险树来源因果_筹办查询(
        const 二次特征节点类* 目标比较,
        std::size_t* 输出因果节点数量 = nullptr,
        std::size_t* 输出主果命中数量 = nullptr) noexcept
    {
        if (输出因果节点数量) {
            *输出因果节点数量 = 0;
        }
        if (输出主果命中数量) {
            *输出主果命中数量 = 0;
        }
        if (!目标比较) {
            return nullptr;
        }

        std::size_t 因果节点数量 = 0;
        std::size_t 主果可解析数量 = 0;
        std::vector<因果节点类*> 同向命中因果{};
        std::vector<因果节点类*> 反向命中因果{};
        std::vector<std::string> 缺失证据{};
        世界树.查询主果方向命中因果(
            目标比较,
            true,
            因果节点数量,
            主果可解析数量,
            同向命中因果,
            反向命中因果,
            缺失证据);
        if (输出因果节点数量) {
            *输出因果节点数量 = 因果节点数量;
        }
        if (输出主果命中数量) {
            *输出主果命中数量 = 同向命中因果.size() + 反向命中因果.size();
        }
        if (!同向命中因果.empty()) {
            return 同向命中因果.front();
        }
        return 反向命中因果.empty() ? nullptr : 反向命中因果.front();
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    结构_因果路径筹办入口壳结果 尝试准备因果路径筹办入口壳(
        ::自我类& 自我对象,
        const 任务节点* 任务头,
        const 结构_需求生命周期上下文_筹办& 需求上下文,
        const 时间戳 now) noexcept
    {
        结构_因果路径筹办入口壳结果 结果{};
        结果.已检查 = true;

        const auto* 来源需求 = 需求上下文.来源需求;
        结果.目标表达完整 =
            来源需求
            && 需求上下文.目标宿主
            && 需求上下文.目标特征类型
            && 需求上下文.当前状态
            && 需求上下文.目标状态;

        if (!结果.目标表达完整) {
            记录筹办日志("因果路径筹办入口跳过"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                + " | 缺来源需求=" + std::to_string(来源需求 ? 0 : 1)
                + " | 缺目标宿主=" + std::to_string(需求上下文.目标宿主 ? 0 : 1)
                + " | 缺目标特征类型=" + std::to_string(需求上下文.目标特征类型 ? 0 : 1)
                + " | 缺当前状态=" + std::to_string(需求上下文.当前状态 ? 0 : 1)
                + " | 缺目标状态=" + std::to_string(需求上下文.目标状态 ? 0 : 1)
                + " | 目标宿主=" + 基础主键_筹办日志(需求上下文.目标宿主)
                + " | 目标特征=" + 入口主键_筹办日志(需求上下文.目标特征类型)
                + " | 当前状态=" + 状态主键_筹办日志(需求上下文.当前状态)
                + " | 目标状态=" + 状态主键_筹办日志(需求上下文.目标状态)
                + " | 满足关系=" + std::to_string(static_cast<I64>(需求上下文.满足关系)));
            return 结果;
        }

        需求类 需求服务{};
        结果.目标比较 = 需求服务.获取需求方向(
            const_cast<需求节点*>(来源需求));
        结果.目标比较已构造 = 结果.目标比较 != nullptr;

        std::ostringstream 输出;
        输出 << "因果路径筹办入口准备"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 来源需求=" << 需求主键_筹办日志(来源需求)
            << " | 目标宿主=" << 基础主键_筹办日志(需求上下文.目标宿主)
            << " | 目标特征=" << 入口主键_筹办日志(需求上下文.目标特征类型)
            << " | 当前状态=" << 状态主键_筹办日志(需求上下文.当前状态)
            << " | 目标状态=" << 状态主键_筹办日志(需求上下文.目标状态)
            << " | 满足关系=" << static_cast<I64>(需求上下文.满足关系)
            << " | 目标比较=" << 基础主键_筹办日志(
                reinterpret_cast<基础信息节点类*>(结果.目标比较))
            << " | 已构造=" << (结果.目标比较已构造 ? 1 : 0)
            << " | 本片只建立入口壳=1"
            << " | 直接写需求树=0"
            << " | 生成派生需求消息=0";
        记录筹办日志(输出.str());

        if (结果.目标比较已构造) {
            执行因果路径查询壳(
                自我对象,
                任务头,
                来源需求,
                需求上下文,
                结果.目标比较,
                now,
                &结果.派生需求消息集);
            if (!结果.派生需求消息集.empty()) {
                记录筹办日志(
                    "因果路径筹办派生需求消息待上报"
                    " | 任务=" + 任务主键_筹办日志(任务头)
                    + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                    + " | 数量=" + std::to_string(结果.派生需求消息集.size())
                    + " | 直接写需求树=0"
                    + " | 实际发送派生需求消息=0");
            }
        }

        return 结果;
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    结构_因果路径筹办入口壳结果 筹办_按因果反推必要状态(
        ::自我类& 自我对象,
        const 任务节点* 任务头,
        const 结构_需求生命周期上下文_筹办& 需求上下文,
        const 时间戳 now) noexcept
    {
        auto 结果 = 尝试准备因果路径筹办入口壳(
            自我对象,
            任务头,
            需求上下文,
            now);
        记录筹办日志(
            "筹办_按因果反推必要状态"
            " | 任务=" + 任务主键_筹办日志(任务头)
            + " | 来源需求=" + 需求主键_筹办日志(需求上下文.来源需求)
            + " | 目标特征=" + 入口主键_筹办日志(需求上下文.目标特征类型)
            + " | 目标表达完整=" + std::to_string(结果.目标表达完整 ? 1 : 0)
            + " | 目标比较已构造=" + std::to_string(结果.目标比较已构造 ? 1 : 0)
            + " | 缺口报告数量=" + std::to_string(结果.派生需求消息集.size())
            + " | 直接写需求树=0"
            + " | 直接创建任务=0"
            + " | 直接结算价值=0");
        return 结果;
    }

    // 功能：按函数名执行对应处理。
    I64 方法自我能力值(const 方法节点* 方法) noexcept
    {
        const I64 能力值 = 方法类::方法本能ID(方法);
        return 本能方法类::是有效本能方法能力值(能力值) ? 能力值 : 0;
    }

    // 功能：按函数名执行对应处理。
    枚举_本能方法ID 方法本能ID(const 方法节点* 方法) noexcept
    {
        const I64 能力值 = 方法自我能力值(方法);
        return 能力值 != 0
            ? static_cast<枚举_本能方法ID>(能力值)
            : 枚举_本能方法ID::未定义;
    }

    inline constexpr I64 历史本能方法ID_改变特征值 = 6058;
    inline constexpr I64 历史本能方法ID_增加可用方法数量 = 6049;

    // 功能：按函数名执行对应处理。
    I64 方法原始本能ID值(const 方法节点* 方法) noexcept
    {
        const I64 本能ID = 方法类::方法本能ID(方法);
        return 本能ID != 0 ? 本能ID : 0;
    }

    // 功能：按函数名执行对应处理。
    bool 本能ID是当前默认自我本能(I64 本能ID) noexcept
    {
        if (本能ID <= 0
            || static_cast<unsigned long long>(本能ID) > (std::numeric_limits<std::uint32_t>::max)()) {
            return false;
        }
        return 本能方法类::是默认自我本能方法(
            static_cast<枚举_本能方法ID>(static_cast<std::uint32_t>(本能ID)));
    }

    // 功能：按函数名执行对应处理。
    bool 方法挂载非当前本能句柄(const 方法节点* 方法) noexcept
    {
        const I64 本能ID = 方法原始本能ID值(方法);
        return 本能ID != 0 && !本能ID是当前默认自我本能(本能ID);
    }

    // 功能：按函数名执行对应处理。
    bool 方法是本能方法(const 方法节点* 方法, 枚举_本能方法ID 本能ID) noexcept
    {
        return 方法本能ID(方法) == 本能ID;
    }

    // 功能：结算任务、需求、价值或结果贡献。
    bool 方法是结算叶子任务价值方法(const 方法节点* 方法) noexcept
    {
        return 方法是本能方法(方法, 枚举_本能方法ID::自我_结算叶子任务价值);
    }

    // 功能：按函数名执行对应处理。
    bool 方法是任务完成后处理方法(const 方法节点* 方法) noexcept
    {
        return 方法是结算叶子任务价值方法(方法);
    }

    // 功能：提交事实、动态、任务状态或运行回执。
    bool 方法是专用提交入口方法(const 方法节点* 方法) noexcept
    {
        return 方法是本能方法(方法, 枚举_本能方法ID::提交_领取OR组结算令牌);
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    const 语素入口节点类* 特征_安全值_筹办() noexcept
    {
        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("安全值", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    const 语素入口节点类* 特征_服务值_筹办() noexcept
    {
        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("服务值", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    // 功能：按函数名执行对应处理。
    bool 任务目标是安全服务值(const 任务节点* 任务头) noexcept
    {
        const auto* 目标特征类型 = 任务对应需求目标特征类型(任务头);
        return 语素入口同一(目标特征类型, 特征_安全值_筹办())
            || 语素入口同一(目标特征类型, 特征_服务值_筹办());
    }

    // 功能：执行对应模块、线程或方法的运行逻辑。
    bool 方法是运行时空占位方法头(const 方法节点* 方法) noexcept
    {
        if (!方法类::方法是首节点(方法)) {
            return false;
        }
        return 方法类::方法来源(方法) == 枚举_方法来源::运行时方法沉淀
            && 方法自我能力值(方法) == 0
            && !方法类::方法有动作(方法)
            && 方法类::方法动作数量(方法) <= 0
            && 方法类::方法可执行入口数量(方法) <= 0
            && 方法类::方法条件节点数量(方法) <= 0
            && 方法类::方法条件结果对数量(方法) <= 0;
    }

    // 功能：按函数名执行对应处理。
    bool 任务应跳过价值目标空占位方法(const 任务节点* 任务头, const 方法节点* 方法) noexcept
    {
        return 任务目标是安全服务值(任务头)
            && !方法是结算叶子任务价值方法(方法)
            && 方法是运行时空占位方法头(方法);
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    bool 结算叶子任务价值前提具备_筹办(const 任务节点* 任务头) noexcept
    {
        if (!任务头
            || 任务类::读取任务状态(任务头) != 枚举_任务状态::完成
            || !任务来源需求(任务头)
            || !任务类::解析任务实际结果状态(任务头)) {
            return false;
        }

        const I64 安全权重 = 任务类::读取任务承接安全权重上限(任务头);
        const I64 服务权重 = 任务类::读取任务承接服务权重上限(任务头);
        const auto 异常哨兵 = (std::numeric_limits<I64>::max)();
        return (安全权重 > 0 && 安全权重 != 异常哨兵)
            || (服务权重 > 0 && 服务权重 != 异常哨兵);
    }

    // 功能：补齐条件、参数、证据或方法能力缺口。
    bool 方法是学习补齐本能方法(const 方法节点* 方法) noexcept
    {
        const auto 本能ID = 方法本能ID(方法);
        return 本能ID == 枚举_本能方法ID::自我_尝试学习
            || 本能ID == 枚举_本能方法ID::自我_定向学习
            || 本能ID == 枚举_本能方法ID::自我_练习;
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    bool 方法是筹办过程或协作本能方法(const 方法节点* 方法) noexcept
    {
        const auto 本能ID = 方法本能ID(方法);
        return 本能ID == 枚举_本能方法ID::自我_尝试学习
            || 本能ID == 枚举_本能方法ID::自我_定向学习
            || 本能ID == 枚举_本能方法ID::自我_练习;
    }

    // 功能：按函数名执行对应处理。
    std::string 方法本能诊断文本(const 方法节点* 方法)
    {
        const I64 原始本能ID = 方法原始本能ID值(方法);
        const I64 自我能力 = 方法自我能力值(方法);
        const I64 默认本能ID = 自我能力 != 0
            ? 自我能力
            : (本能ID是当前默认自我本能(原始本能ID) ? 原始本能ID : 0);
        const char* 本能动作 = 默认本能ID != 0
            ? 本能方法类::查询默认动作名称(
                static_cast<枚举_本能方法ID>(
                    static_cast<std::uint32_t>(默认本能ID)))
            : nullptr;

        std::ostringstream 输出;
        输出 << " | 本能ID=" << 原始本能ID
            << " | 自我能力=" << 自我能力
            << " | 本能动作=" << (本能动作 ? 本能动作 : "空")
            << " | 学习本能=" << (方法是学习补齐本能方法(方法) ? 1 : 0)
            << " | 过程本能=" << (方法是筹办过程或协作本能方法(方法) ? 1 : 0);
        return 输出.str();
    }

    // 功能：把处理结果写入指定对象、场景或日志。
    bool 方法是先天特征写入逻辑(const 方法节点* 方法) noexcept
    {
        return 方法原始本能ID值(方法) == 历史本能方法ID_改变特征值;
    }

    // 功能：提交事实、动态、任务状态或运行回执。
    bool 本能方法ID可作为可执行入口提交(I64 本能方法ID) noexcept
    {
        if (本能方法ID <= 0
            || static_cast<unsigned long long>(本能方法ID) > (std::numeric_limits<std::uint32_t>::max)()) {
            return false;
        }
        if (本能方法ID == 历史本能方法ID_改变特征值
            || 本能方法ID == 历史本能方法ID_增加可用方法数量) {
            return false;
        }
        return 本能方法类::是默认自我本能方法(
            static_cast<枚举_本能方法ID>(static_cast<std::uint32_t>(本能方法ID)))
            && 私有_本能动作运行时已注册_执行桥_最小_v0(本能方法ID);
    }

    // 功能：推进任务筹办，形成候选、缺口或就绪回执。
    bool 本能方法ID可作为练习目标_筹办(I64 本能方法ID) noexcept
    {
        if (!本能方法ID可作为可执行入口提交(本能方法ID)) {
