    {
        return 节点 ? 节点->获取主键() : std::string("空");
    }

    std::string 基础主键_筹办日志(const 基础信息节点类* 节点)
    {
        return 节点 ? 节点->获取主键() : std::string("空");
    }

    std::string 入口主键_筹办日志(const 语素入口节点类* 节点)
    {
        return 节点 ? 节点->获取主键() : std::string("空");
    }

    std::string 状态主键_筹办日志(const 状态节点类* 节点)
    {
        return 节点 ? 节点->获取主键() : std::string("空");
    }

    void 写入筹办回执任务建议(
        任务模块::筹办::结构_任务推进回执& 回执,
        const 枚举_任务状态 状态,
        const 枚举_任务阶段 阶段) noexcept
    {
        // 筹办层只产出“任务层回执建议”，不直接写任务虚拟存在。
        // 真正的任务状态/阶段提交由任务管理工作线程统一完成。
        回执.建议任务状态 = 状态;
        回执.建议任务阶段 = 阶段;
    }

    void 记录筹办日志(const std::string& 文本) noexcept
    {
        项目运行日志("任务筹办跟踪 | " + 文本);
    }

    状态节点类* 读取派生需求状态_从结果场景(
        场景节点类* 结果场景,
        const 语素入口节点类* 状态特征类型) noexcept
    {
        if (!结果场景 || !状态特征类型) {
            return nullptr;
        }
        void* 指针 = nullptr;
        return 世界树.读取特征_指针(
                reinterpret_cast<基础信息节点类*>(结果场景),
                状态特征类型,
                指针)
            && 指针
            ? reinterpret_cast<状态节点类*>(指针)
            : nullptr;
    }

    void 记录缺口派生目标状态(
        const char* 阶段,
        const 任务节点* 任务头,
        const 方法节点* 目标方法,
        const 语素入口节点类* 缺口特征,
        const 可解析引用<基础信息节点类>& 缺口目标主体,
        场景节点类* 结果场景) noexcept
    {
        auto* 派生当前状态 = 读取派生需求状态_从结果场景(
            结果场景,
            私有_执行输出特征_派生需求当前状态_执行桥_最小_v0());
        auto* 派生目标状态 = 读取派生需求状态_从结果场景(
            结果场景,
            私有_执行输出特征_派生需求目标状态_执行桥_最小_v0());

        std::ostringstream 输出;
        输出 << (阶段 ? 阶段 : "缺口目标状态检查")
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 目标方法=" << 方法主键_筹办日志(目标方法)
            << " | 缺口目标主体=" << 基础主键_筹办日志(缺口目标主体.指针)
            << " | 缺口特征=" << 入口主键_筹办日志(缺口特征)
            << " | 派生当前状态=" << 状态主键_筹办日志(派生当前状态)
            << " | 派生目标状态=" << 状态主键_筹办日志(派生目标状态);
        记录筹办日志(输出.str());

        if (!派生目标状态) {
            记录筹办日志(std::string("缺口派生目标状态缺失")
                + " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 目标方法=" + 方法主键_筹办日志(目标方法)
                + " | 缺口特征=" + 入口主键_筹办日志(缺口特征)
                + " | 结果场景=" + 基础主键_筹办日志(reinterpret_cast<基础信息节点类*>(结果场景)));
        }
    }

    void 写入方法节点引用(可解析引用<方法节点类>& 输出, 方法节点* 节点) noexcept
    {
        输出.指针 = reinterpret_cast<方法节点类*>(节点);
        输出.主键 = 节点 ? 节点->获取主键() : std::string{};
    }

    void 写入方法候选引用(
        std::vector<可解析引用<方法节点类>>& 输出,
        方法节点* 节点) noexcept
    {
        if (!节点) {
            return;
        }
        auto* 方法节点引用指针 = reinterpret_cast<方法节点类*>(节点);
        for (const auto& 已有 : 输出) {
            if (已有.指针 == 方法节点引用指针
                || (!已有.主键.empty() && 已有.主键 == 节点->获取主键())) {
                return;
            }
        }

        可解析引用<方法节点类> 引用{};
        写入方法节点引用(引用, 节点);
        输出.push_back(std::move(引用));
    }

    void 写入任务节点引用(可解析引用<任务节点类>& 输出, 任务节点* 节点) noexcept
    {
        输出.指针 = reinterpret_cast<任务节点类*>(节点);
        输出.主键 = 节点 ? 节点->获取主键() : std::string{};
    }

    void 写入需求节点引用(可解析引用<需求节点类>& 输出, 需求节点* 节点) noexcept
    {
        输出.指针 = reinterpret_cast<需求节点类*>(节点);
        输出.主键 = 节点 ? 节点->获取主键() : std::string{};
    }

    void 写入基础节点引用(可解析引用<基础信息节点类>& 输出, 基础信息节点类* 节点) noexcept
    {
        输出.指针 = 节点;
        输出.主键 = 节点 ? 节点->获取主键() : std::string{};
    }

    void 写入场景节点引用(可解析引用<场景节点类>& 输出, 场景节点类* 节点) noexcept
    {
        输出.指针 = 节点;
        输出.主键 = 节点 ? 节点->获取主键() : std::string{};
    }

    任务节点* 归一到任务头结点(任务节点* 节点) noexcept
    {
        auto* 当前 = 节点;
        while (当前) {
            if (任务类::读取任务节点种类(当前) == 枚举_任务节点种类::头结点) {
                return 当前;
            }
            当前 = static_cast<任务节点*>(当前->父);
        }
        return nullptr;
    }

    需求节点* 任务来源需求(const 任务节点* 任务头) noexcept
    {
        if (!任务头) {
            return nullptr;
        }
        if (任务头->主信息.对应需求.指针) {
            return reinterpret_cast<需求节点*>(任务头->主信息.对应需求.指针);
        }
        if (!任务头->主信息.对应需求.主键.empty()) {
            if (auto* 节点 = 世界树.基础信息().查找主键(任务头->主信息.对应需求.主键)) {
                return reinterpret_cast<需求节点*>(节点);
            }
        }
        return nullptr;
    }

    const 状态节点主信息类* 状态主信息(const 状态节点类* 状态节点) noexcept
    {
        return 状态节点
            ? 世界树.状态().取状态主信息(const_cast<状态节点类*>(状态节点))
            : nullptr;
    }

    const 语素入口节点类* 状态节点目标特征类型(const 状态节点类* 状态节点) noexcept
    {
        const auto* 主信息 = 状态主信息(状态节点);
        if (!主信息 || !主信息->状态特征.指针) {
            return nullptr;
        }
        const auto* 特征主信息 =
            dynamic_cast<const 特征节点主信息类*>(主信息->状态特征.指针->主信息);
        return 特征主信息 ? 特征主信息->类型 : nullptr;
    }

    基础信息节点类* 状态节点主体(const 状态节点类* 状态节点) noexcept
    {
        const auto* 主信息 = 状态主信息(状态节点);
        return 主信息 ? 主信息->状态主体.指针 : nullptr;
    }

    bool 状态节点I64值(const 状态节点类* 状态节点, I64& 输出值) noexcept
    {
        输出值 = 0;
        const auto* 主信息 = 状态主信息(状态节点);
        if (!主信息) {
            return false;
        }
        if (const auto* 标量 = std::get_if<I64>(&主信息->状态值)) {
            输出值 = *标量;
            return true;
        }
        return false;
    }

    bool 状态节点I64区间(const 状态节点类* 状态节点, I64区间& 输出区间) noexcept
    {
        输出区间 = I64区间{ 0, -1 };
        const auto* 主信息 = 状态主信息(状态节点);
        if (!主信息 || !主信息->状态特征.指针) {
            return false;
        }

        const auto* 特征主信息 =
            dynamic_cast<const 特征节点主信息类*>(主信息->状态特征.指针->主信息);
        if (!特征主信息) {
            return false;
        }

        if (特征主信息->局部区间覆盖.has_value()
            && 特征主信息->局部区间覆盖->有效()) {
            输出区间 = *特征主信息->局部区间覆盖;
            return true;
        }
        if (特征主信息->区间.has_value()
            && 特征主信息->区间->有效()) {
            输出区间 = *特征主信息->区间;
            return true;
        }

        const auto 读取抽象区间 =
            [&](const 基础信息节点类* 抽象节点, I64区间& 区间) noexcept -> bool {
            const auto* 抽象主信息 = 抽象节点
                ? dynamic_cast<const 抽象特征主信息类*>(抽象节点->主信息)
                : nullptr;
            if (抽象主信息
                && 抽象主信息->区间.has_value()
                && 抽象主信息->区间->有效()) {
                区间 = *抽象主信息->区间;
                return true;
            }
            return false;
        };

        if (读取抽象区间(特征主信息->当前命中抽象特征.指针, 输出区间)) {
            return true;
        }
        return 读取抽象区间(特征主信息->抽象特征.指针, 输出区间);
    }

    std::int32_t 需求目标方向编码(const 需求节点* 来源需求) noexcept
    {
        if (!来源需求) {
            return 0;
        }

        需求类 需求服务{};
        auto* 方向节点 = 需求服务.获取需求方向(const_cast<需求节点*>(来源需求));
        const auto* 方向主信息 = 方向节点
            ? dynamic_cast<const 二次特征主信息类*>(方向节点->主信息)
            : nullptr;
        if (!方向主信息) {
            return 0;
        }
        if (方向主信息->方向区间 != 二次特征主信息类::枚举_方向区间::未定义) {
            return 二次特征主信息类::方向区间编码(方向主信息->方向区间);
        }
        if (方向主信息->差值.has_value()) {
            return 二次特征主信息类::方向区间编码(
                二次特征主信息类::由差值判断方向区间(*方向主信息->差值));
        }
        if (方向主信息->值形态 == 枚举_二次特征值形态::枚举
            && 方向主信息->离散编码 >= -1
            && 方向主信息->离散编码 <= 1) {
            return 方向主信息->离散编码;
        }
        if (方向主信息->值形态 == 枚举_二次特征值形态::布尔) {
            return 方向主信息->是否满足 ? 1 : 0;
        }
        return 0;
    }

    bool 需求目标要求正值(const 需求节点* 来源需求) noexcept
    {
        if (!来源需求) {
            return false;
        }

        I64 点值 = 0;
        if (状态节点I64值(来源需求->主信息.需求状态.指针, 点值)) {
            return 点值 > 0;
        }

        I64区间 区间{};
        if (状态节点I64区间(来源需求->主信息.需求状态.指针, 区间)) {
            return 区间.低值 > 0;
        }

        return 需求目标方向编码(来源需求) > 0;
    }

    bool 需求目标要求至少(const 需求节点* 来源需求, I64 阈值) noexcept
    {
        if (!来源需求) {
            return false;
        }

        I64 点值 = 0;
        if (状态节点I64值(来源需求->主信息.需求状态.指针, 点值)) {
            return 点值 >= 阈值;
        }

        I64区间 区间{};
        if (状态节点I64区间(来源需求->主信息.需求状态.指针, 区间)) {
            return 区间.低值 >= 阈值;
        }

        return false;
    }

    bool 语素入口同一(const 语素入口节点类* 左, const 语素入口节点类* 右) noexcept
    {
        if (!左 || !右) {
            return false;
        }
        if (左 == 右) {
            return true;
        }
        const auto 左主键 = 左->获取主键();
        return !左主键.empty() && 左主键 == 右->获取主键();
    }

    const 语素入口节点类* 需求目标特征类型(const 需求节点* 需求) noexcept
    {
        return 需求 ? 状态节点目标特征类型(需求->主信息.需求状态.指针) : nullptr;
    }

    const 语素入口节点类* 任务对应需求目标特征类型(const 任务节点* 任务头) noexcept
    {
        return 需求目标特征类型(任务来源需求(任务头));
    }

    struct 结构_需求生命周期上下文_筹办 {
        任务节点* 来源任务 = nullptr;
        需求节点* 来源需求 = nullptr;
        基础信息节点类* 需求主体 = nullptr;
        基础信息节点类* 被需求存在 = nullptr;
        基础信息节点类* 目标宿主 = nullptr;
        状态节点类* 当前状态 = nullptr;
        状态节点类* 目标状态 = nullptr;
        const 语素入口节点类* 目标特征类型 = nullptr;
        三向关系掩码 满足关系 = 关系_等于;
        bool 被需求存在由状态推导 = false;
        bool 缺来源需求 = false;
        bool 缺被需求存在 = false;
        bool 缺目标特征 = false;
        bool 缺当前状态 = false;
        bool 缺目标状态 = false;
        // 仅供程序调试日志使用，绝不能作为业务逻辑、语义判断、去重、结算或因果依据。
        std::string 诊断摘要{};
    };

    struct 结构_筹办生命周期判断结果_筹办 {
        bool 已判断 = false;
        bool 可比较 = false;
        bool 已满足 = false;
        bool 当前状态缺失 = false;
        bool 目标状态缺失 = false;
        bool 使用主键相等判断 = false;
        枚举_三向关系 比较关系 = 枚举_三向关系::等于;
        三向关系掩码 满足关系 = 关系_等于;
        // 仅供程序调试日志使用，绝不能作为业务逻辑、语义判断、去重、结算或因果依据。
        std::string 诊断摘要{};
    };

    结构_需求生命周期上下文_筹办 筹办_构造需求生命周期上下文(
        const 需求节点* 来源需求) noexcept
    {
        结构_需求生命周期上下文_筹办 上下文{};
        上下文.来源需求 = const_cast<需求节点*>(来源需求);
        if (!来源需求) {
            上下文.缺来源需求 = true;
            上下文.诊断摘要 = "缺来源需求";
            return 上下文;
        }

        上下文.需求主体 = 来源需求->主信息.需求主体.指针
            ? reinterpret_cast<基础信息节点类*>(来源需求->主信息.需求主体.指针)
            : nullptr;
        上下文.被需求存在 = 来源需求->主信息.被需求存在.指针
            ? reinterpret_cast<基础信息节点类*>(来源需求->主信息.被需求存在.指针)
            : nullptr;
        上下文.当前状态 = 来源需求->主信息.被需求当前状态.指针;
        上下文.目标状态 = 来源需求->主信息.需求状态.指针;
        上下文.目标特征类型 = 需求目标特征类型(来源需求);
        上下文.满足关系 = 来源需求->主信息.满足关系 != 0
            ? 来源需求->主信息.满足关系
            : 关系_等于;

        上下文.目标宿主 = 上下文.被需求存在;
        if (!上下文.目标宿主) {
            上下文.目标宿主 = 状态节点主体(上下文.目标状态);
            上下文.被需求存在由状态推导 = 上下文.目标宿主 != nullptr;
        }
        if (!上下文.目标宿主) {
            上下文.目标宿主 = 状态节点主体(上下文.当前状态);
            上下文.被需求存在由状态推导 = 上下文.目标宿主 != nullptr;
        }

        上下文.缺被需求存在 = 上下文.目标宿主 == nullptr;
        上下文.缺目标特征 = 上下文.目标特征类型 == nullptr;
        上下文.缺当前状态 = 上下文.当前状态 == nullptr
            && 来源需求->主信息.被需求当前状态.主键.empty();
        上下文.缺目标状态 = 上下文.目标状态 == nullptr
            && 来源需求->主信息.需求状态.主键.empty();
        if (上下文.缺被需求存在 || 上下文.缺目标特征
            || 上下文.缺当前状态 || 上下文.缺目标状态) {
            上下文.诊断摘要 = "需求上下文存在缺口";
        } else {
            上下文.诊断摘要 = "需求上下文完整";
        }
        return 上下文;
    }

    结构_需求生命周期上下文_筹办 筹办_构造需求生命周期上下文(
        const 任务节点* 任务头) noexcept
    {
        auto 上下文 = 筹办_构造需求生命周期上下文(任务来源需求(任务头));
        上下文.来源任务 = const_cast<任务节点*>(任务头);
        return 上下文;
    }

    结构_筹办生命周期判断结果_筹办 筹办_判定需求满足状态(
        const 结构_需求生命周期上下文_筹办& 上下文) noexcept
    {
        结构_筹办生命周期判断结果_筹办 结果{};
        结果.满足关系 = 上下文.满足关系 != 0 ? 上下文.满足关系 : 关系_等于;
        if (!上下文.来源需求) {
            结果.诊断摘要 = "缺来源需求";
            return 结果;
        }

        if (上下文.当前状态 && 上下文.目标状态) {
            const auto 比较 = 世界树.特征().比较状态(上下文.当前状态, 上下文.目标状态);
            结果.已判断 = true;
            结果.可比较 = 比较.可比较;
            结果.比较关系 = 比较.关系;
            结果.已满足 = 比较.可比较
                && 三向关系被接受(比较.关系, 结果.满足关系);
            结果.诊断摘要 = 比较.可比较 ? "状态可比较" : "状态不可比较";
            return 结果;
        }

        结果.当前状态缺失 = 上下文.当前状态 == nullptr;
        结果.目标状态缺失 = 上下文.目标状态 == nullptr;
        const auto& 当前主键 = 上下文.来源需求->主信息.被需求当前状态.主键;
        const auto& 目标主键 = 上下文.来源需求->主信息.需求状态.主键;
        if (!当前主键.empty() && 当前主键 == 目标主键) {
            结果.已判断 = true;
            结果.可比较 = true;
            结果.使用主键相等判断 = true;
            结果.比较关系 = 枚举_三向关系::等于;
            结果.已满足 = 三向关系被接受(枚举_三向关系::等于, 结果.满足关系);
            结果.诊断摘要 = "状态主键相等";
            return 结果;
        }

        结果.诊断摘要 = "缺少可比较状态";
        return 结果;
    }

    bool 需求已满足(const 需求节点* 需求) noexcept
    {
        return 筹办_判定需求满足状态(
            筹办_构造需求生命周期上下文(需求)).已满足;
    }

    bool 存在活动直接子需求(const 需求节点* 需求) noexcept
    {
        if (!需求 || !需求->子) {
            return false;
        }
        auto* 首子 = reinterpret_cast<需求节点*>(需求->子);
        auto* 当前 = 首子;
        std::size_t 保护计数 = 0;
        do {
            if (当前
                && 当前->主信息.需求有效截止 == 0
                && 当前->主信息.是否阻塞父任务执行
                && !需求已满足(当前)) {
                return true;
            }
            当前 = reinterpret_cast<需求节点*>(当前 ? 当前->下 : nullptr);
            ++保护计数;
        } while (当前 && 当前 != 首子 && 保护计数 < 10000);
        return false;
    }

    I64 方法自我能力值(const 方法节点* 方法) noexcept
    {
        if (!方法
            || 方法->主信息.首节点信息().动作句柄.类型 != 枚举_动作句柄类型::本能函数ID) {
            return 0;
        }
        const I64 能力值 = 方法->主信息.首节点信息().动作句柄.本能ID;
        return 本能方法类::是有效本能方法能力值(能力值) ? 能力值 : 0;
    }

    枚举_本能方法ID 方法本能ID(const 方法节点* 方法) noexcept
    {
        const I64 能力值 = 方法自我能力值(方法);
        return 能力值 != 0
            ? static_cast<枚举_本能方法ID>(能力值)
            : 枚举_本能方法ID::未定义;
    }

    inline constexpr I64 历史本能方法ID_任务筹办 = 6062;
    inline constexpr I64 历史本能方法ID_任务执行 = 6063;
    inline constexpr I64 历史本能方法ID_改变特征值 = 6058;
    inline constexpr I64 历史本能方法ID_增加可用方法数量 = 6049;

    I64 方法原始本能ID值(const 方法节点* 方法) noexcept
    {
        if (!方法
            || 方法->主信息.首节点信息().动作句柄.类型 != 枚举_动作句柄类型::本能函数ID
            || 方法->主信息.首节点信息().动作句柄.本能ID == 0) {
            return 0;
        }
        return 方法->主信息.首节点信息().动作句柄.本能ID;
    }

    bool 本能ID是当前默认自我本能(I64 本能ID) noexcept
    {
        if (本能ID <= 0
            || static_cast<unsigned long long>(本能ID) > (std::numeric_limits<std::uint32_t>::max)()) {
            return false;
        }
        return 本能方法类::是默认自我本能方法(
            static_cast<枚举_本能方法ID>(static_cast<std::uint32_t>(本能ID)));
    }

    bool 方法挂载非当前本能句柄(const 方法节点* 方法) noexcept
    {
        const I64 本能ID = 方法原始本能ID值(方法);
        return 本能ID != 0 && !本能ID是当前默认自我本能(本能ID);
    }

    bool 方法是本能方法(const 方法节点* 方法, 枚举_本能方法ID 本能ID) noexcept
    {
        return 方法本能ID(方法) == 本能ID;
    }

    bool 方法是结算叶子任务价值方法(const 方法节点* 方法) noexcept
    {
        return 方法是本能方法(方法, 枚举_本能方法ID::自我_结算叶子任务价值);
    }

    bool 方法是任务完成后处理方法(const 方法节点* 方法) noexcept
    {
        return 方法是结算叶子任务价值方法(方法);
    }

    const 语素入口节点类* 特征_安全值_筹办() noexcept
    {
        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("安全值", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    const 语素入口节点类* 特征_服务值_筹办() noexcept
    {
        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("服务值", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    bool 任务目标是安全服务值(const 任务节点* 任务头) noexcept
    {
        const auto* 目标特征类型 = 任务对应需求目标特征类型(任务头);
        return 语素入口同一(目标特征类型, 特征_安全值_筹办())
            || 语素入口同一(目标特征类型, 特征_服务值_筹办());
    }

    bool 方法是运行时空占位方法头(const 方法节点* 方法) noexcept
    {
        if (!方法 || 方法->主信息.节点种类() != 枚举_方法节点种类::方法首节点) {
            return false;
        }
        const auto& 首信息 = 方法->主信息.首节点信息();
        return 首信息.来源 == 枚举_方法来源::运行时方法沉淀
            && 方法自我能力值(方法) == 0
            && !方法->主信息.有方法动作()
            && 私有_方法动作数量_执行桥_最小_v0(方法) <= 0
            && 私有_方法可执行入口数量_执行桥_最小_v0(方法) <= 0
            && 私有_方法条件节点数量_执行桥_最小_v0(方法) <= 0
            && 私有_方法条件结果对数量_执行桥_最小_v0(方法) <= 0;
    }

    bool 任务应跳过价值目标空占位方法(const 任务节点* 任务头, const 方法节点* 方法) noexcept
    {
        return 任务目标是安全服务值(任务头)
            && !方法是结算叶子任务价值方法(方法)
            && 方法是运行时空占位方法头(方法);
    }

    bool 结算叶子任务价值前提具备_筹办(const 任务节点* 任务头) noexcept
    {
        if (!任务头
            || 任务类::读取任务状态(任务头) != 枚举_任务状态::完成
            || !任务来源需求(任务头)
            || !任务类::解析任务结果状态摘要_兼容(任务头)) {
            return false;
        }

        const I64 安全权重 = 任务类::读取任务承接安全权重上限(任务头);
        const I64 服务权重 = 任务类::读取任务承接服务权重上限(任务头);
        const auto 异常哨兵 = (std::numeric_limits<I64>::max)();
        return (安全权重 > 0 && 安全权重 != 异常哨兵)
            || (服务权重 > 0 && 服务权重 != 异常哨兵);
    }

    bool 方法是学习补齐本能方法(const 方法节点* 方法) noexcept
    {
        const auto 本能ID = 方法本能ID(方法);
        return 本能ID == 枚举_本能方法ID::自我_尝试学习
            || 本能ID == 枚举_本能方法ID::自我_定向学习
            || 本能ID == 枚举_本能方法ID::自我_练习;
    }

    bool 方法是历史任务生命周期方法残留(const 方法节点* 方法) noexcept
    {
        // 任务筹办 / 任务执行已迁为任务管理生命周期普通函数；历史方法树中若残留
        // 6062 / 6063 方法头，也必须从任务候选集中排除。这里保留私有数值
        // 兼容历史数据，但不再把它们公开为当前本能方法枚举。
        const auto 本能ID = 方法原始本能ID值(方法);
        return 本能ID == 历史本能方法ID_任务筹办
            || 本能ID == 历史本能方法ID_任务执行;
    }

    bool 方法是筹办过程或协作本能方法(const 方法节点* 方法) noexcept
    {
        const auto 本能ID = 方法本能ID(方法);
        return 本能ID == 枚举_本能方法ID::自我_尝试学习
            || 本能ID == 枚举_本能方法ID::自我_定向学习
            || 本能ID == 枚举_本能方法ID::自我_练习;
    }

    bool 方法是先天特征写入逻辑(const 方法节点* 方法) noexcept
    {
        return 方法原始本能ID值(方法) == 历史本能方法ID_改变特征值;
    }

    bool 本能方法ID可作为可执行入口提交(I64 本能方法ID) noexcept
    {
        if (本能方法ID <= 0
            || static_cast<unsigned long long>(本能方法ID) > (std::numeric_limits<std::uint32_t>::max)()) {
            return false;
        }
        if (本能方法ID == 历史本能方法ID_改变特征值
            || 本能方法ID == 历史本能方法ID_增加可用方法数量
            || 本能方法ID == 历史本能方法ID_任务筹办
            || 本能方法ID == 历史本能方法ID_任务执行) {
            return false;
        }
        return 本能方法类::是默认自我本能方法(
            static_cast<枚举_本能方法ID>(static_cast<std::uint32_t>(本能方法ID)))
            && 私有_本能动作运行时已注册_执行桥_最小_v0(本能方法ID);
    }

    bool 本能方法ID可作为练习目标_筹办(I64 本能方法ID) noexcept
    {
        if (!本能方法ID可作为可执行入口提交(本能方法ID)) {
            return false;
        }

        switch (static_cast<枚举_本能方法ID>(static_cast<std::uint32_t>(本能方法ID))) {
        case 枚举_本能方法ID::自我_练习:
        case 枚举_本能方法ID::自我_尝试学习:
        case 枚举_本能方法ID::自我_定向学习:
        case 枚举_本能方法ID::自我_提交任务状态变化:
        case 枚举_本能方法ID::自我_回写需求满足:
        case 枚举_本能方法ID::自我_结算叶子任务价值:
        case 枚举_本能方法ID::自我_提交方法可执行入口:
        case 枚举_本能方法ID::自我_建立条件结果对:
        case 枚举_本能方法ID::自我_提交方法状态变化:
            return false;
        default:
            return true;
        }
    }

    bool 方法可作为练习目标_筹办(const 方法节点* 方法) noexcept
    {
        return 本能方法ID可作为练习目标_筹办(方法原始本能ID值(方法));
    }

    bool 方法动作状态已提交(方法节点* 方法, 时间戳 now) noexcept
    {
        if (!方法) {
            return false;
        }
        auto* 方法存在 = 方法->主信息.首节点信息().方法虚拟存在.指针
            ? 方法->主信息.首节点信息().方法虚拟存在.指针
            : 方法虚拟存在服务类::取或创建方法虚拟存在(方法, nullptr, now);
        I64 方法动作状态 = 0;
        return 方法存在
            && 世界树.读取特征_I64(
                reinterpret_cast<基础信息节点类*>(方法存在),
                私有_方法动作状态特征类型_执行桥_最小_v0(),
                方法动作状态)
            && 方法动作状态 == 1;
    }

    I64 已有单步本能入口待提交动作状态(方法节点* 方法, 时间戳 now) noexcept
    {
        const I64 本能方法ID = 方法自我能力值(方法);
        if (!本能方法ID可作为可执行入口提交(本能方法ID)
            || 方法动作状态已提交(方法, now)) {
            return 0;
        }
        return 本能方法ID;
    }

    bool 任务目标是方法结构补齐需求(const 任务节点* 任务头) noexcept
    {
        const auto* 目标特征类型 = 任务对应需求目标特征类型(任务头);
        return 语素入口同一(目标特征类型, 私有_方法状态特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法稳定状态特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法运行账完整性特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法动作状态特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法动作数量特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法可执行入口数量特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法条件节点数量特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法结果节点数量特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法条件结果配对状态特征类型_执行桥_最小_v0());
    }

    方法节点* 按方法虚拟存在查找方法(
        自我类& 自我对象,
        基础信息节点类* 方法虚拟存在,
        时间戳 now) noexcept
    {
        auto* 自我存在 = 自我对象.确保自我存在();
        auto* 方法根节点 = 自我存在 ? 世界树.存在().获取方法根节点(自我存在) : nullptr;
        if (!方法根节点 || !方法根节点->子 || !方法虚拟存在) {
            return nullptr;
        }

        auto* 首节点 = static_cast<方法节点*>(方法根节点->子);
        auto* 当前 = 首节点;
        std::size_t 保护计数 = 0;
        do {
            if (当前 && 当前->主信息.节点种类() == 枚举_方法节点种类::方法首节点) {
                auto* 当前虚拟存在 = 当前->主信息.首节点信息().方法虚拟存在.指针
                    ? 当前->主信息.首节点信息().方法虚拟存在.指针
                    : 方法虚拟存在服务类::取或创建方法虚拟存在(当前, 自我存在, now);
                if (当前虚拟存在 == 方法虚拟存在
                    || (当前虚拟存在
                        && !当前虚拟存在->获取主键().empty()
                        && 当前虚拟存在->获取主键() == 方法虚拟存在->获取主键())) {
                    return 当前;
                }
            }
            当前 = static_cast<方法节点*>(当前->下);
            ++保护计数;
        } while (当前 && 当前 != 首节点 && 保护计数 < 4096);
        return nullptr;
    }

    方法节点* 按方法主键查找方法(
        自我类& 自我对象,
        const std::string& 方法主键) noexcept
    {
        if (方法主键.empty()) {
            return nullptr;
        }

        auto* 自我存在 = 自我对象.确保自我存在();
        auto* 方法根节点 = 自我存在 ? 世界树.存在().获取方法根节点(自我存在) : nullptr;
        if (!方法根节点) {
            return nullptr;
        }

        std::vector<方法节点*> 待访问{};
        std::vector<方法节点*> 已入栈{};

        const auto 已记录节点 = [&](const 方法节点* 节点) noexcept {
            for (const auto* 已记录 : 已入栈) {
                if (已记录 == 节点) {
                    return true;
                }
            }
            return false;
        };

        const auto 压入待访问 = [&](方法节点* 节点) noexcept {
            if (!节点 || 已记录节点(节点)) {
                return;
            }
            已入栈.push_back(节点);
            待访问.push_back(节点);
        };

        const auto 压入直接子链 = [&](方法节点* 父节点) noexcept {
            auto* 首子 = 父节点 ? static_cast<方法节点*>(父节点->子) : nullptr;
            if (!首子) {
                return;
            }

            auto* 当前子 = 首子;
            std::size_t 兄弟保护计数 = 0;
            do {
                压入待访问(当前子);
                当前子 = static_cast<方法节点*>(当前子->下);
                ++兄弟保护计数;
            } while (当前子 && 当前子 != 首子 && 兄弟保护计数 < 4096);

            if (兄弟保护计数 >= 4096) {
                记录筹办日志("按方法主键查找兄弟链达到保护上限"
                    " | 父方法=" + 方法主键_筹办日志(父节点)
                    + " | 目标方法主键=" + 方法主键);
            }
        };

        压入待访问(方法根节点);
        std::size_t 访问计数 = 0;
        constexpr std::size_t 访问保护上限 = 65536;
        while (!待访问.empty() && 访问计数 < 访问保护上限) {
            auto* 当前 = 待访问.back();
            待访问.pop_back();
            ++访问计数;

            if (当前
                && 当前->主信息.节点种类() == 枚举_方法节点种类::方法首节点
                && 当前->获取主键() == 方法主键) {
                return 当前;
            }

            压入直接子链(当前);
        }

        if (访问计数 >= 访问保护上限) {
            记录筹办日志("按方法主键查找达到保护上限"
                " | 目标方法主键=" + 方法主键);
        }
        return nullptr;
    }

    struct 结构_方法选择评分 {
        I64 直接满足等级 = 0;
        I64 结果命中精度 = 0;
        I64 禁止项惩罚 = 0;
        I64 风险惩罚 = 0;
        I64 前置冲突惩罚 = 0;
        I64 效率分 = 0;
        I64 耗时惩罚 = 0;
        I64 能耗惩罚 = 0;
        I64 资源惩罚 = 0;
        I64 副作用惩罚 = 0;
        I64 可补齐等级 = 0;
        I64 不确定性惩罚 = 0;
        I64 稳定性分 = 0;
        bool 有效 = false;
    };

    bool 方法选择评分更优(
        const 结构_方法选择评分& 左,
        const 结构_方法选择评分& 右) noexcept
    {
        if (左.有效 != 右.有效) return 左.有效;
        if (左.结果命中精度 != 右.结果命中精度) return 左.结果命中精度 > 右.结果命中精度;
        if (左.直接满足等级 != 右.直接满足等级) return 左.直接满足等级 > 右.直接满足等级;
        if (左.禁止项惩罚 != 右.禁止项惩罚) return 左.禁止项惩罚 < 右.禁止项惩罚;
        if (左.风险惩罚 != 右.风险惩罚) return 左.风险惩罚 < 右.风险惩罚;
        if (左.前置冲突惩罚 != 右.前置冲突惩罚) return 左.前置冲突惩罚 < 右.前置冲突惩罚;
        if (左.效率分 != 右.效率分) return 左.效率分 > 右.效率分;
        if (左.耗时惩罚 != 右.耗时惩罚) return 左.耗时惩罚 < 右.耗时惩罚;
        if (左.能耗惩罚 != 右.能耗惩罚) return 左.能耗惩罚 < 右.能耗惩罚;
        if (左.资源惩罚 != 右.资源惩罚) return 左.资源惩罚 < 右.资源惩罚;
        if (左.副作用惩罚 != 右.副作用惩罚) return 左.副作用惩罚 < 右.副作用惩罚;
        if (左.可补齐等级 != 右.可补齐等级) return 左.可补齐等级 > 右.可补齐等级;
        if (左.不确定性惩罚 != 右.不确定性惩罚) return 左.不确定性惩罚 < 右.不确定性惩罚;
        return 左.稳定性分 > 右.稳定性分;
    }

    bool 方法选择评分相同(
        const 结构_方法选择评分& 左,
        const 结构_方法选择评分& 右) noexcept
    {
        return !方法选择评分更优(左, 右)
            && !方法选择评分更优(右, 左);
    }

    std::string 方法选择评分文本(const 结构_方法选择评分& 评分)
    {
        std::ostringstream 输出;
        输出 << "命中=" << 评分.结果命中精度
            << ",直接=" << 评分.直接满足等级
            << ",禁=" << 评分.禁止项惩罚
            << ",险=" << 评分.风险惩罚
            << ",冲突=" << 评分.前置冲突惩罚
            << ",效率=" << 评分.效率分
            << ",耗时=" << 评分.耗时惩罚
            << ",能耗=" << 评分.能耗惩罚
            << ",资源=" << 评分.资源惩罚
            << ",副作用=" << 评分.副作用惩罚
            << ",可补=" << 评分.可补齐等级
            << ",不确定=" << 评分.不确定性惩罚
            << ",稳定=" << 评分.稳定性分;
        return 输出.str();
    }

    bool 方法结果项I64目标值(
        const 结构_方法结果项& 结果项,
        I64& 输出值) noexcept
    {
        输出值 = 0;
        const 特征值* 目标值 = 结果项.关系模板.有目标值
            ? &结果项.关系模板.目标值
            : &结果项.目标值;
        if (const auto* 标量 = std::get_if<I64>(目标值)) {
            输出值 = *标量;
            return true;
        }
        return false;
    }

    I64 方法结果项目标值一致分(
        const 结构_方法结果项& 结果项,
        const 需求节点* 来源需求) noexcept
    {
        if (!来源需求) {
            return 0;
        }

        I64 结果目标值 = 0;
        I64 需求目标值 = 0;
        if (!方法结果项I64目标值(结果项, 结果目标值)
            || !状态节点I64值(来源需求->主信息.需求状态.指针, 需求目标值)) {
            return 0;
        }

        const auto 比较量 = 比较I64_三态(结果目标值, 需求目标值);
        if (比较量 == 0) {
            return 100;
        }
        return 三向关系被接受(
            比较量转三向关系(比较量),
            来源需求->主信息.满足关系 != 0 ? 来源需求->主信息.满足关系 : 关系_等于)
            ? 60
            : -80;
    }

    I64 方法结果能力命中精度(
        方法节点* 方法,
        const 语素入口节点类* 目标特征类型,
        const 需求节点* 来源需求) noexcept
    {
        auto* 首信息 = 方法 && 方法->主信息.是否方法首节点()
            ? 方法->主信息.取首节点信息()
            : nullptr;
        if (!首信息 || !目标特征类型) {
            return 0;
        }

        I64 最佳精度 = 0;
        for (const auto& 结果项 : 首信息->能力.结果包.结果项集) {
            if (!结果项.关系目标特征类型由参数决定()
                && 语素入口同一(结果项.关系目标特征类型(), 目标特征类型)) {
                // 固定结果特征类型最精确，优先级高于参数化“可改变任意特征”。
                最佳精度 = (std::max<I64>)(
                    最佳精度,
                    20 + 方法结果项目标值一致分(结果项, 来源需求));
            } else if (结果项.关系目标特征类型由参数决定()
                && 结果项.关系目标特征类型参数() != nullptr) {
                // 参数化结果能力可以承接任意目标特征，但精度低于固定命中。
                最佳精度 = (std::max<I64>)(
                    最佳精度,
                    10 + 方法结果项目标值一致分(结果项, 来源需求));
            }
        }
        return 最佳精度;
    }

    方法节点* 评分_读取任务输入目标方法_筹办(const 任务节点* 任务头) noexcept;
    方法节点* 任务方法结构补齐目标方法(
        自我类& 自我对象,
        const 任务节点* 任务头,
        时间戳 now) noexcept;

    结构_方法选择评分 方法候选评分(
        自我类& 自我对象,
        任务节点* 任务头,
        方法节点* 方法,
        时间戳 now) noexcept
    {
        结构_方法选择评分 评分{};
        if (!方法 || 方法->主信息.节点种类() != 枚举_方法节点种类::方法首节点) {
            return 评分;
        }

        const bool 有本能能力值 = 方法自我能力值(方法) != 0;
        const bool 有已注册本能入口 =
            私有_方法有已注册本能入口_执行桥_最小_v0(方法);
        const bool 有动作 =
            有本能能力值
            || 方法->主信息.有方法动作()
            || 私有_方法动作数量_执行桥_最小_v0(方法) > 0;
        const bool 有入口 =
            有已注册本能入口
            || 私有_方法可执行入口数量_执行桥_最小_v0(方法) > 0;
        const bool 有条件节点 = 私有_方法条件节点数量_执行桥_最小_v0(方法) > 0;
        const bool 有结果节点 = 私有_方法结果节点数量_执行桥_最小_v0(方法) > 0;
        const bool 有条件结果对 = 私有_方法条件结果对数量_执行桥_最小_v0(方法) > 0;
        const bool 是过程本能 = 方法是筹办过程或协作本能方法(方法);
        const bool 是学习本能 = 方法是学习补齐本能方法(方法);
        const bool 是结算叶子任务价值 = 方法是结算叶子任务价值方法(方法);
        const bool 结算前提具备 = !是结算叶子任务价值
            || 结算叶子任务价值前提具备_筹办(任务头);
        const bool 是方法结构任务 = 任务目标是方法结构补齐需求(任务头);
        const bool 是提交方法可执行入口 =
            方法是本能方法(方法, 枚举_本能方法ID::自我_提交方法可执行入口);
        const auto* 来源需求 = 任务来源需求(任务头);
        const auto* 目标特征类型 = 任务对应需求目标特征类型(任务头);

        if (方法是任务完成后处理方法(方法)) {
            评分.有效 = false;
            return 评分;
        }

        评分.有效 = true;

        // 第一层：所有可直接执行条件都满足的方法优先。
        // 这里先用结构可用性近似“必需条件全部满足”；具体输入参数仍在后续
        // 检查方法条件 / 配对参数阶段验证，不能在选择阶段提前提交事实。
        if (!是过程本能 && 结算前提具备 && 有动作 && 有入口 && 有条件节点 && 有结果节点 && 有条件结果对) {
            评分.直接满足等级 = 300;
        } else if (是过程本能 && 有动作 && 有入口) {
            // 过程本能方法只说明“可以推进筹办过程”，不是最终状态提交者。
            // 因此它低于直接可执行方法，但高于普通不可用方法。
            评分.直接满足等级 = 100;
        } else if (结算前提具备 && 有动作 && 有入口) {
            评分.直接满足等级 = 20;
        } else if (结算前提具备 && 有动作) {
            评分.直接满足等级 = 10;
        }
        评分.结果命中精度 = 方法结果能力命中精度(方法, 目标特征类型, 来源需求);

        // 第二层到第四层的真实禁止项、风险、能耗以后应从方法条件节点、
        // 禁止结果、资源账读取。当前没有稳定字段时保持 0，避免臆造约束。
        评分.禁止项惩罚 = 0;
        评分.风险惩罚 = 0;
        评分.前置冲突惩罚 = 0;
        评分.耗时惩罚 = 0;
        评分.能耗惩罚 = 0;
        评分.资源惩罚 = 0;
        评分.副作用惩罚 = 0;

        // 效率和稳定性先用已有结构成熟度、条件结果对数量和本能入口作保守近似。
        评分.效率分 =
            方法->主信息.首节点信息().成熟度阶段 * 100
            + 私有_方法条件结果对数量_执行桥_最小_v0(方法) * 10
            + (有已注册本能入口 ? 50 : 0);
        评分.稳定性分 =
            方法->主信息.首节点信息().成熟度阶段 * 100
            + 私有_方法条件结果对数量_执行桥_最小_v0(方法) * 20;

        // 第五层：没有直接可执行方法时，再选能把条件变得可具备的方法。
        if (是方法结构任务 && 是学习本能) {
            评分.可补齐等级 = 900;
        } else if (是过程本能) {
            评分.可补齐等级 = 500;
        } else if (结算前提具备 && (有动作 || 有入口)) {
            评分.可补齐等级 = 100;
        }

        if (是结算叶子任务价值 && !结算前提具备) {
            评分.前置冲突惩罚 = 500;
        }
        if (是方法结构任务 && 是提交方法可执行入口) {
            auto* 被补方法 = 任务方法结构补齐目标方法(自我对象, 任务头, now);
            if (!被补方法) {
                被补方法 = 评分_读取任务输入目标方法_筹办(任务头);
            }
            const bool 被补方法已有入口能力 = 方法自我能力值(被补方法) != 0;
            if (!被补方法 || !被补方法已有入口能力) {
                评分.直接满足等级 = 0;
                评分.可补齐等级 = 0;
                评分.前置冲突惩罚 = (std::max<I64>)(评分.前置冲突惩罚, 500);
            }
        }

        评分.不确定性惩罚 = 0;
        return 评分;
    }

    方法节点* 从筹办候选集中选择当前方法(
        自我类& 自我对象,
        任务节点* 任务头,
        const std::vector<方法节点*>& 候选方法集,
        时间戳 now) noexcept
    {
        if (!任务头) {
            return nullptr;
        }

        if (候选方法集.empty()) {
            return nullptr;
        }

        auto* 已绑定方法 = reinterpret_cast<方法节点*>(任务类::读取任务执行方法(任务头));
        (void)已绑定方法;

        方法节点* 最佳方法 = nullptr;
        结构_方法选择评分 最佳评分{};
        for (auto* 方法 : 候选方法集) {
            // 旧数据残留的任务筹办 / 任务执行方法头只作兼容识别，不参与候选选择。
            if (方法是历史任务生命周期方法残留(方法)) {
                记录筹办日志("选择当前方法跳过任务生命周期方法残留"
                    " | 任务=" + 任务主键_筹办日志(任务头)
                    + " | 方法=" + 方法主键_筹办日志(方法));
                continue;
            }
            if (方法挂载非当前本能句柄(方法)) {
                记录筹办日志("选择当前方法跳过非当前默认本能方法残留"
                    " | 任务=" + 任务主键_筹办日志(任务头)
                    + " | 方法=" + 方法主键_筹办日志(方法)
                    + " | 本能ID=" + std::to_string(方法原始本能ID值(方法)));
                continue;
            }

            const auto 分数 = 方法候选评分(自我对象, 任务头, 方法, now);
            {
                std::ostringstream 输出;
                输出 << "选择当前方法候选评分"
                    << " | 任务=" << 任务主键_筹办日志(任务头)
                    << " | 方法=" << 方法主键_筹办日志(方法)
                    << " | 评分=" << 方法选择评分文本(分数);
                记录筹办日志(输出.str());
            }
            const bool 分数更优 = !最佳方法 || 方法选择评分更优(分数, 最佳评分);
            const bool 分数相同 =
                最佳方法
                && !方法选择评分更优(分数, 最佳评分)
                && !方法选择评分更优(最佳评分, 分数);
            const bool 主键更稳定 =
                分数相同
                && 方法
                && 方法->获取主键() < 最佳方法->获取主键();
            if (方法 && (分数更优 || 主键更稳定)) {
                最佳方法 = 方法;
                最佳评分 = 分数;
            }
        }
        if (最佳方法) {
            std::ostringstream 输出;
            输出 << "选择当前方法完成"
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 方法=" << 方法主键_筹办日志(最佳方法)
                << " | 评分=" << 方法选择评分文本(最佳评分);
            记录筹办日志(输出.str());
        }
        return 最佳方法;
    }

    方法节点* 任务方法结构补齐目标方法(
        自我类& 自我对象,
        const 任务节点* 任务头,
        时间戳 now) noexcept
    {
        if (!任务头 || !任务目标是方法结构补齐需求(任务头)) {
            return nullptr;
        }
        const auto* 来源需求 = 任务来源需求(任务头);

        // 迁移期兼容：学习需求由父任务筹办缺口派生时，兼容归因缓存中的
        // 来源方法主键仍是最精确的被补方法身份。后续应由来源回执 /
        // 动作动态 / 缺口二次特征链提供该身份。
        const auto 派生归因 =
            来源需求
                ? 需求类::读取派生归因兼容视图(来源需求->主信息)
                : 需求类::结构_需求派生归因兼容视图{};
        if (派生归因.有派生来源方法()) {
            if (auto* 方法 = 按方法主键查找方法(
                自我对象,
                派生归因.派生来源方法主键文本())) {
                记录筹办日志("方法结构补齐目标方法解析"
                    " | 来源=兼容派生来源方法主键"
                    " | 任务=" + 任务主键_筹办日志(任务头)
                    + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                    + " | 被补方法=" + 方法主键_筹办日志(方法));
                return 方法;
            }

            记录筹办日志("方法结构补齐目标方法主键未命中"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                + " | 兼容派生来源方法=" + 派生归因.派生来源方法主键文本());
        }

        if (来源需求 && 来源需求->主信息.被需求存在.指针) {
            auto* 目标主体 = reinterpret_cast<基础信息节点类*>(
                来源需求->主信息.被需求存在.指针);
            if (auto* 方法 = 按方法虚拟存在查找方法(自我对象, 目标主体, now)) {
                记录筹办日志("方法结构补齐目标方法解析"
                    " | 来源=被需求存在"
                    " | 任务=" + 任务主键_筹办日志(任务头)
                    + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                    + " | 被补方法=" + 方法主键_筹办日志(方法));
                return 方法;
            }
        }

        auto* 目标主体 = 来源需求 ? 状态节点主体(来源需求->主信息.需求状态.指针) : nullptr;
        if (!目标主体 && 来源需求) {
            目标主体 = 状态节点主体(来源需求->主信息.被需求当前状态.指针);
        }
        if (auto* 方法 = 按方法虚拟存在查找方法(自我对象, 目标主体, now)) {
            记录筹办日志("方法结构补齐目标方法解析"
                " | 来源=状态主体兜底"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                + " | 被补方法=" + 方法主键_筹办日志(方法));
            return 方法;
        }
        return nullptr;
    }

    const 语素入口节点类* 特征_输入条件包() noexcept
    {
        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("输入条件包", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    const 语素入口节点类* 特征_目标方法头节点() noexcept
    {
        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("目标方法头节点", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    const 语素入口节点类* 特征_选中自我能力值() noexcept
    {
        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("选中自我能力值", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    const 语素入口节点类* 特征_目标特征类型() noexcept
    {
