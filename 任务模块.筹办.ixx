    using 枚举_需求目标语义_筹办 = 需求类::枚举_需求目标语义;
    using 结构_需求目标语义视图_筹办 = 需求类::结构_需求目标语义视图;

    结构_需求目标语义视图_筹办 需求目标语义视图_筹办(
        const 语素入口节点类* 目标特征类型) noexcept
    {
        return 需求类::需求目标语义视图(目标特征类型);
    }

    bool 需求已满足(const 需求节点* 需求) noexcept;

    struct 结构_直接子需求聚合视图_筹办 {
        bool 已检查 = false;
        std::size_t 直接子需求数 = 0;
        std::size_t 已满足子需求数 = 0;
        std::size_t 未满足子需求数 = 0;
        std::string 首个未满足子需求主键{};

        bool 有结构缺口() const noexcept
        {
            return 已检查 && 直接子需求数 == 0;
        }

        bool 全部子需求已满足() const noexcept
        {
            return 已检查 && 直接子需求数 > 0 && 未满足子需求数 == 0;
        }
    };

    结构_直接子需求聚合视图_筹办 分析直接子需求聚合视图_筹办(
        const 需求节点* 来源需求) noexcept
    {
        结构_直接子需求聚合视图_筹办 视图{};
        视图.已检查 = true;
        if (!来源需求 || !来源需求->子) {
            return 视图;
        }

        auto* 首子 = reinterpret_cast<需求节点*>(来源需求->子);
        auto* 当前 = 首子;
        std::size_t 保护计数 = 0;
        do {
            if (!当前) {
                break;
            }
            ++视图.直接子需求数;
            const bool 子已满足 =
                当前->主信息.需求有效截止 != 0
                || 需求已满足(当前);
            if (子已满足) {
                ++视图.已满足子需求数;
            } else {
                ++视图.未满足子需求数;
                if (视图.首个未满足子需求主键.empty()) {
                    视图.首个未满足子需求主键 = 当前->获取主键();
                }
            }

            当前 = reinterpret_cast<需求节点*>(当前->下);
            ++保护计数;
        } while (当前 && 当前 != 首子 && 保护计数 < 10000);
        return 视图;
    }

    bool 返回直接子需求聚合筹办结果(
        任务模块::筹办::结构_任务筹办结果& 结果,
        const 任务节点* 任务头,
        const 需求节点* 来源需求,
        const 结构_需求目标语义视图_筹办& 视图,
        const char* 逻辑组名称) noexcept
    {
        const auto* 组名 = 逻辑组名称 ? 逻辑组名称 : "逻辑组织节点";
        const auto 聚合视图 = 分析直接子需求聚合视图_筹办(来源需求);
        if (聚合视图.全部子需求已满足()) {
            结果.回执.状况 = 任务模块::筹办::枚举_任务推进状况::目标结果符合;
            结果.回执.缺口特征类型 = nullptr;
            结果.回执.需要自我线程 = true;
            结果.回执.需要创建或复用子需求 = false;
            结果.回执.父任务需要重筹办 = true;
            结果.回执.当前任务目标达成 = true;
            结果.回执.完成度百万分比 = 1'000'000;
            if (来源需求 && 来源需求->主信息.需求状态.有效()) {
                结果.回执.实际结果状态集.push_back(来源需求->主信息.需求状态);
            }
            写入筹办回执任务建议(
                结果.回执,
                枚举_任务状态::完成,
                枚举_任务阶段::筹办);
            结果.说明 = std::string(组名) + "所有直接子需求已满足，形成组节点满足回写输入";
            结果.回执.摘要 = 结果.说明;
        } else if (聚合视图.有结构缺口()) {
            结果.回执.状况 = 任务模块::筹办::枚举_任务推进状况::逻辑组织待聚合;
            结果.回执.缺口特征类型 = 视图.目标特征类型;
            结果.回执.需要自我线程 = false;
            结果.回执.需要创建或复用子需求 = false;
            结果.回执.父任务需要重筹办 = false;
            写入筹办回执任务建议(
                结果.回执,
                枚举_任务状态::等待中,
                枚举_任务阶段::阻塞);
            结果.说明 = std::string(组名) + "缺少直接子需求，等待需求树展开";
            结果.回执.摘要 = 结果.说明;
        } else {
            结果.回执.状况 = 任务模块::筹办::枚举_任务推进状况::存在活动子需求;
            结果.回执.缺口特征类型 = 视图.目标特征类型;
            结果.回执.需要自我线程 = false;
            结果.回执.需要创建或复用子需求 = false;
            结果.回执.父任务需要重筹办 = false;
            写入筹办回执任务建议(
                结果.回执,
                枚举_任务状态::等待中,
                枚举_任务阶段::阻塞);
            结果.说明 = std::string(组名) + "仍有未满足子需求，等待子需求完成";
            if (!聚合视图.首个未满足子需求主键.empty()) {
                结果.说明 += " | 首个未满足子需求=" + 聚合视图.首个未满足子需求主键;
            }
            结果.回执.摘要 = 结果.说明;
        }

        std::ostringstream 输出;
        输出 << 组名 << "聚合筹办视图"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 来源需求=" << 需求主键_筹办日志(来源需求)
            << " | 目标特征=" << 入口主键_筹办日志(视图.目标特征类型)
            << " | 直接子需求=" << 聚合视图.直接子需求数
            << " | 已满足子需求=" << 聚合视图.已满足子需求数
            << " | 未满足子需求=" << 聚合视图.未满足子需求数
            << " | 组节点满足回写输入=" << (聚合视图.全部子需求已满足() ? 1 : 0)
            << " | 任务筹办直接回写需求=0"
            << " | 候选方法填充=0"
            << " | 说明=" << 结果.说明;
        记录筹办日志(输出.str());
        return true;
    }

    bool 返回目标语义非普通筹办等待(
        任务模块::筹办::结构_任务筹办结果& 结果,
        const 任务节点* 任务头,
        const 需求节点* 来源需求,
        const 结构_需求目标语义视图_筹办& 视图) noexcept
    {
        if (视图.可进入普通候选方法筹办) {
            return false;
        }
        if (视图.语义 == 枚举_需求目标语义_筹办::AND组满足) {
            return 返回直接子需求聚合筹办结果(
                结果,
                任务头,
                来源需求,
                视图,
                "AND组");
        }
        if (视图.语义 == 枚举_需求目标语义_筹办::方法路径完成) {
            return 返回直接子需求聚合筹办结果(
                结果,
                任务头,
                来源需求,
                视图,
                "方法路径组");
        }
        if (视图.语义 == 枚举_需求目标语义_筹办::因果子链支撑) {
            return 返回直接子需求聚合筹办结果(
                结果,
                任务头,
                来源需求,
                视图,
                "因果子链支撑");
        }

        结果.回执.状况 = 任务模块::筹办::枚举_任务推进状况::逻辑组织待聚合;
        结果.回执.缺口特征类型 = 视图.目标特征类型;
        结果.回执.需要自我线程 = false;
        结果.回执.需要创建或复用子需求 = false;
        结果.回执.父任务需要重筹办 = false;
        写入筹办回执任务建议(
            结果.回执,
            枚举_任务状态::等待中,
            枚举_任务阶段::阻塞);
        结果.说明 = std::string("目标语义为")
            + (视图.语义名称 ? 视图.语义名称 : "未知")
            + "，不进入普通候选方法筹办，等待需求树聚合或专用提交链";
        结果.回执.摘要 = 结果.说明;

        std::ostringstream 输出;
        输出 << "目标语义闸门阻断普通筹办"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 来源需求=" << 需求主键_筹办日志(来源需求)
            << " | 目标特征=" << 入口主键_筹办日志(视图.目标特征类型)
            << " | 目标语义=" << (视图.语义名称 ? 视图.语义名称 : "未知")
            << " | 逻辑组织目标=" << (视图.是逻辑组织目标 ? 1 : 0)
            << " | 结算令牌目标=" << (视图.是结算令牌目标 ? 1 : 0)
            << " | 普通候选方法筹办=0"
            << " | 候选方法填充=0"
            << " | 因果反推=0"
            << " | 创建学习需求=0";
        记录筹办日志(输出.str());
        return true;
    }

    struct 结构_需求生命周期上下文_筹办 {
        任务节点* 来源任务 = nullptr;
        需求节点* 来源需求 = nullptr;
        基础信息节点类* 需求主体 = nullptr;
        基础信息节点类* 被需求存在 = nullptr;
        基础信息节点类* 目标宿主 = nullptr;
        状态节点类* 当前状态 = nullptr;
        状态节点类* 目标状态 = nullptr;
        const 语素入口节点类* 目标特征类型 = nullptr;
        三向关系掩码 满足关系 = 关系_等于;
        bool 被需求存在由状态推导 = false;
        bool 缺来源需求 = false;
        bool 缺被需求存在 = false;
        bool 缺目标特征 = false;
        bool 缺当前状态 = false;
        bool 缺目标状态 = false;
        // 仅供程序调试日志使用，绝不能作为业务逻辑、语义判断、去重、结算或因果依据。
        std::string 诊断摘要{};
    };

    struct 结构_筹办生命周期判断结果_筹办 {
        bool 已判断 = false;
        bool 可比较 = false;
        bool 已满足 = false;
        bool 当前状态缺失 = false;
        bool 目标状态缺失 = false;
        bool 使用主键相等判断 = false;
        枚举_三向关系 比较关系 = 枚举_三向关系::等于;
        三向关系掩码 满足关系 = 关系_等于;
        // 仅供程序调试日志使用，绝不能作为业务逻辑、语义判断、去重、结算或因果依据。
        std::string 诊断摘要{};
    };

    结构_需求生命周期上下文_筹办 筹办_构造需求生命周期上下文(
        const 需求节点* 来源需求) noexcept
    {
        结构_需求生命周期上下文_筹办 上下文{};
        上下文.来源需求 = const_cast<需求节点*>(来源需求);
        if (!来源需求) {
            上下文.缺来源需求 = true;
            上下文.诊断摘要 = "缺来源需求";
            return 上下文;
        }

        上下文.需求主体 = 来源需求->主信息.需求主体.指针
            ? reinterpret_cast<基础信息节点类*>(来源需求->主信息.需求主体.指针)
            : nullptr;
        上下文.被需求存在 = 来源需求->主信息.被需求存在.指针
            ? reinterpret_cast<基础信息节点类*>(来源需求->主信息.被需求存在.指针)
            : nullptr;
        上下文.当前状态 = 来源需求->主信息.被需求当前状态.指针;
        上下文.目标状态 = 来源需求->主信息.需求状态.指针;
        上下文.目标特征类型 = 需求目标特征类型(来源需求);
        上下文.满足关系 = 来源需求->主信息.满足关系 != 0
            ? 来源需求->主信息.满足关系
            : 关系_等于;

        上下文.目标宿主 = 状态节点主体(上下文.目标状态);
        if (!上下文.目标宿主) {
            上下文.目标宿主 = 状态节点主体(上下文.当前状态);
        }
        if (上下文.目标宿主) {
            上下文.被需求存在由状态推导 =
                上下文.目标宿主 != 上下文.被需求存在;
        } else {
            上下文.目标宿主 = 上下文.被需求存在;
        }

        上下文.缺被需求存在 = 上下文.目标宿主 == nullptr;
        上下文.缺目标特征 = 上下文.目标特征类型 == nullptr;
        上下文.缺当前状态 = 上下文.当前状态 == nullptr
            && 来源需求->主信息.被需求当前状态.主键.empty();
        上下文.缺目标状态 = 上下文.目标状态 == nullptr
            && 来源需求->主信息.需求状态.主键.empty();
        if (上下文.缺被需求存在 || 上下文.缺目标特征
            || 上下文.缺当前状态 || 上下文.缺目标状态) {
            上下文.诊断摘要 = "需求上下文存在缺口";
        } else {
            上下文.诊断摘要 = "需求上下文完整";
        }
        return 上下文;
    }

    结构_需求生命周期上下文_筹办 筹办_构造需求生命周期上下文(
        const 任务节点* 任务头) noexcept
    {
        auto 上下文 = 筹办_构造需求生命周期上下文(任务来源需求(任务头));
        上下文.来源任务 = const_cast<任务节点*>(任务头);
        return 上下文;
    }

    结构_筹办生命周期判断结果_筹办 筹办_判定需求满足状态(
        const 结构_需求生命周期上下文_筹办& 上下文) noexcept
    {
        结构_筹办生命周期判断结果_筹办 结果{};
        结果.满足关系 = 上下文.满足关系 != 0 ? 上下文.满足关系 : 关系_等于;
        if (!上下文.来源需求) {
            结果.诊断摘要 = "缺来源需求";
            return 结果;
        }

        if (上下文.当前状态 && 上下文.目标状态) {
            const auto 比较 = 世界树.特征().比较状态(上下文.当前状态, 上下文.目标状态);
            结果.已判断 = true;
            结果.可比较 = 比较.可比较;
            结果.比较关系 = 比较.关系;
            结果.已满足 = 比较.可比较
                && 三向关系被接受(比较.关系, 结果.满足关系);
            结果.诊断摘要 = 比较.可比较 ? "状态可比较" : "状态不可比较";
            return 结果;
        }

        结果.当前状态缺失 = 上下文.当前状态 == nullptr;
        结果.目标状态缺失 = 上下文.目标状态 == nullptr;
        const auto& 当前主键 = 上下文.来源需求->主信息.被需求当前状态.主键;
        const auto& 目标主键 = 上下文.来源需求->主信息.需求状态.主键;
        if (!当前主键.empty() && 当前主键 == 目标主键) {
            结果.已判断 = true;
            结果.可比较 = true;
            结果.使用主键相等判断 = true;
            结果.比较关系 = 枚举_三向关系::等于;
            结果.已满足 = 三向关系被接受(枚举_三向关系::等于, 结果.满足关系);
            结果.诊断摘要 = "状态主键相等";
            return 结果;
        }

        结果.诊断摘要 = "缺少可比较状态";
        return 结果;
    }

    bool 需求已满足(const 需求节点* 需求) noexcept
    {
        return 筹办_判定需求满足状态(
            筹办_构造需求生命周期上下文(需求)).已满足;
    }

    const char* 满足来源文本_筹办(
        const 需求节点* 需求,
        const 结构_筹办生命周期判断结果_筹办& 判断) noexcept
    {
        if (需求 && 需求->主信息.需求有效截止 != 0) {
            return "已截止";
        }
        if (判断.使用主键相等判断) {
            return "状态主键相等";
        }
        if (判断.可比较) {
            return "状态比较满足";
        }
        return "未满足";
    }

    void 记录需求满足项追踪_筹办(
        const 任务节点* 任务头,
        const 需求节点* 来源需求,
        const 结构_筹办生命周期判断结果_筹办& 当前需求判断) noexcept
    {
        if (!来源需求) {
            return;
        }

        struct 结构_待记录满足项 {
            const 需求节点* 需求 = nullptr;
            结构_需求生命周期上下文_筹办 上下文{};
            结构_筹办生命周期判断结果_筹办 判断{};
        };

        std::vector<结构_待记录满足项> 已满足项{};
        std::size_t 直接子总数 = 0;
        std::size_t 活动阻塞子数 = 0;
        std::size_t 已满足子数 = 0;
        std::size_t 已截止子数 = 0;
        if (来源需求->子) {
            auto* 首子 = reinterpret_cast<需求节点*>(来源需求->子);
            auto* 当前 = 首子;
            std::size_t 保护计数 = 0;
            do {
                if (!当前) {
                    break;
                }
                ++直接子总数;
                const bool 已截止 = 当前->主信息.需求有效截止 != 0;
                const bool 活动阻塞 =
                    !已截止 && 当前->主信息.是否阻塞父任务执行;
                if (活动阻塞) {
                    ++活动阻塞子数;
                }
                if (已截止) {
                    ++已截止子数;
                }
                auto 子上下文 = 筹办_构造需求生命周期上下文(当前);
                auto 子判断 = 筹办_判定需求满足状态(子上下文);
                if (子判断.已满足) {
                    ++已满足子数;
                }
                if (已截止 || 子判断.已满足) {
                    已满足项.push_back({
                        当前,
                        std::move(子上下文),
                        子判断,
                    });
                }
                当前 = reinterpret_cast<需求节点*>(当前->下);
                ++保护计数;
            } while (当前 && 当前 != 首子 && 保护计数 < 10000);
        }

        if (!当前需求判断.已满足 && 已满足项.empty()) {
            return;
        }

        auto 记录项 = [&](const char* 项类型,
                         const 需求节点* 需求,
                         const 结构_需求生命周期上下文_筹办& 上下文,
                         const 结构_筹办生命周期判断结果_筹办& 判断) noexcept {
            std::ostringstream 输出;
            输出 << "需求满足项追踪/项"
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 当前需求=" << 需求主键_筹办日志(来源需求)
                << " | 项类型=" << (项类型 ? 项类型 : "")
                << " | 需求=" << 需求主键_筹办日志(需求)
                << " | 目标宿主=" << 基础主键_筹办日志(上下文.目标宿主)
                << " | 目标特征=" << 入口主键_筹办日志(上下文.目标特征类型)
                << " | 当前状态=" << 状态主键_筹办日志(上下文.当前状态)
                << " | 目标状态=" << 状态主键_筹办日志(上下文.目标状态)
                << " | 满足=" << (判断.已满足 ? 1 : 0)
                << " | 可比较=" << (判断.可比较 ? 1 : 0)
                << " | 关系=" << static_cast<I64>(判断.比较关系)
                << " | 满足关系=" << static_cast<I64>(判断.满足关系)
                << " | 来源=" << 满足来源文本_筹办(需求, 判断);
            if (需求) {
                输出 << " | 截止=" << static_cast<I64>(需求->主信息.需求有效截止)
                    << " | 阻塞父任务=" << (需求->主信息.是否阻塞父任务执行 ? 1 : 0)
                    << " | 安全权重=" << 需求->主信息.安全权重
                    << " | 服务权重=" << 需求->主信息.服务权重;
            }
            记录筹办日志(输出.str());
        };

        const auto 当前上下文 = 筹办_构造需求生命周期上下文(来源需求);
        if (当前需求判断.已满足) {
            记录项("当前需求目标", 来源需求, 当前上下文, 当前需求判断);
        }
        for (const auto& 项 : 已满足项) {
            记录项("直接子需求", 项.需求, 项.上下文, 项.判断);
        }

        std::ostringstream 摘要;
        摘要 << "需求满足项追踪/摘要"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 当前需求=" << 需求主键_筹办日志(来源需求)
            << " | 当前需求满足=" << (当前需求判断.已满足 ? 1 : 0)
            << " | 直接子总数=" << 直接子总数
            << " | 活动阻塞子=" << 活动阻塞子数
            << " | 已满足子=" << 已满足子数
            << " | 已截止子=" << 已截止子数;
        记录筹办日志(摘要.str());
    }

    bool 存在活动直接子需求(const 需求节点* 需求) noexcept
    {
        if (!需求 || !需求->子) {
            return false;
        }
        auto* 首子 = reinterpret_cast<需求节点*>(需求->子);
        auto* 当前 = 首子;
        std::size_t 保护计数 = 0;
        do {
            if (当前
                && 当前->主信息.需求有效截止 == 0
                && 当前->主信息.是否阻塞父任务执行
                && !需求已满足(当前)) {
                return true;
            }
            当前 = reinterpret_cast<需求节点*>(当前 ? 当前->下 : nullptr);
            ++保护计数;
        } while (当前 && 当前 != 首子 && 保护计数 < 10000);
        return false;
    }

    struct 结构_因果路径筹办入口壳结果 {
        bool 已检查 = false;
        bool 目标表达完整 = false;
        bool 目标比较已构造 = false;
        二次特征节点类* 目标比较 = nullptr;
        std::vector<结构_任务管理派生需求消息> 派生需求消息集{};
        std::string 拒绝原因{};
    };

    struct 结构_因果路径查询壳统计 {
        bool 已执行 = false;
        std::size_t 因果节点数量 = 0;
        std::size_t 有主信息数量 = 0;
        std::size_t 抽象因果数量 = 0;
        std::size_t 实例因果数量 = 0;
        std::size_t 未定义形态数量 = 0;
        std::size_t 遗传因果数量 = 0;
        std::size_t 推断生成因果数量 = 0;
        std::size_t 后天验证因果数量 = 0;
        std::size_t 主果模板声明数量 = 0;
        std::size_t 主果可解析数量 = 0;
        std::size_t 主果不可解析数量 = 0;
        std::size_t 主果同向命中数量 = 0;
        std::size_t 主果反向命中数量 = 0;
        std::vector<结构_任务管理派生需求消息> 派生需求消息集{};
    };

    enum class 枚举_临时因果路径角色 : std::uint8_t {
        未定义 = 0,
        促成 = 1,
        避免 = 2,
        条件补齐 = 3,
        方法就绪 = 4,
        证据补齐 = 5,
        副作用约束 = 6,
        学习缺口 = 7,
    };

    struct 结构_临时因果路径项 {
        因果节点类* 来源因果 = nullptr;
        枚举_临时因果路径角色 角色 = 枚举_临时因果路径角色::未定义;
        I64 根分区 = 0;
        二次特征节点类* 子需求目标比较 = nullptr;
        std::uint32_t 贡献层级 = 0;
        I64 层级权重 = 0;
        I64 稳定度 = 0;
        bool 条件已满足 = false;
        bool 证据足够 = false;
        枚举_因果来源类型 来源因果类型 = 枚举_因果来源类型::未定义;
        bool 来源因果已验证 = false;
        bool 目标已目标化 = false;
        bool 派生后父任务继续 = false;
        三向关系掩码 派生满足关系 = 关系_等于;
        基础信息节点类* 派生目标主体 = nullptr;
        const 语素入口节点类* 派生目标特征类型 = nullptr;
        状态节点类* 派生当前状态 = nullptr;
        状态节点类* 派生目标状态 = nullptr;
        I64 派生当前状态值 = 0;
        I64 派生目标状态值 = 0;
        std::string 目标化说明{};
    };

    struct 结构_临时因果视图 {
        const 需求节点* 来源需求 = nullptr;
        const 二次特征节点类* 目标比较 = nullptr;
        I64 根分区 = 0;
        bool 观察材料质量目标 = false;
        bool 父需求依赖深度空间质量 = false;
        bool 父需求可降级继续 = false;
        I64 观察材料深度观察质量状态 = 筹办观察质量状态_可用;
        I64 观察材料空间坐标观察质量状态 = 筹办观察质量状态_可用;
        I64 观察材料质量缺口状态 = 0;
        I64 观察材料质量缺口原因集合 = 0;
        I64 观察材料空间类适用状态 = 筹办观察适用状态_可用;
        I64 观察材料风险判断适用状态 = 筹办观察适用状态_可用;
        I64 观察材料存在确认适用状态 = 筹办观察适用状态_可用;
        I64 观察材料质量改善线索状态 = 0;
        std::string 父需求继续策略{};
        std::vector<结构_临时因果路径项> 促成路径{};
        std::vector<结构_临时因果路径项> 避免路径{};
        std::vector<结构_临时因果路径项> 条件缺口{};
        std::vector<结构_临时因果路径项> 方法就绪缺口{};
        std::vector<结构_临时因果路径项> 证据缺口{};
        std::vector<结构_临时因果路径项> 副作用约束{};
        std::vector<结构_临时因果路径项> 学习缺口{};

        std::size_t 路径总数() const noexcept
        {
            return 促成路径.size()
                + 避免路径.size()
                + 条件缺口.size()
                + 方法就绪缺口.size()
                + 证据缺口.size()
                + 副作用约束.size()
                + 学习缺口.size();
        }
    };

    struct 结构_因果路径派生消息草案统计 {
        bool 已执行 = false;
        std::size_t 路径项数量 = 0;
        std::size_t 已目标化数量 = 0;
        std::size_t 字段完整数量 = 0;
        std::size_t 草案数量 = 0;
        std::size_t 正式消息数量 = 0;
        std::size_t 正式消息字段完整数量 = 0;
        std::size_t 状态物化数量 = 0;
        std::size_t 缺父需求数量 = 0;
        std::size_t 缺目标主体数量 = 0;
        std::size_t 缺目标特征数量 = 0;
        std::size_t 缺状态节点数量 = 0;
    };

    I64 推导临时因果根分区_筹办查询(const 需求节点* 需求) noexcept
    {
        bool 关联安全 = false;
        bool 关联服务 = false;
        auto* 当前 = 需求;
        std::size_t 保护计数 = 0;
        while (当前 && ++保护计数 < 1024) {
            关联安全 = 关联安全 || 当前->主信息.安全权重 > 0;
            关联服务 = 关联服务 || 当前->主信息.服务权重 > 0;
            if (关联安全 && 关联服务) {
                break;
            }
            当前 = 当前->父 && 当前->父 != 当前
                ? 当前->父
                : nullptr;
        }
        if (关联安全 && 关联服务) {
            return 3;
        }
        if (关联安全) {
            return 1;
        }
        if (关联服务) {
            return 2;
        }
        return 0;
    }

    I64 计算临时因果层级权重_百万分比(std::uint32_t 层级) noexcept
    {
        if (层级 == 0) {
            return 0;
        }
        I64 权重 = 900000;
        for (std::uint32_t i = 1; i < 层级; ++i) {
            权重 /= 10;
            if (权重 <= 0) {
                return 0;
            }
        }
        return 权重;
    }

    template<class T节点>
    std::string 引用主键_筹办查询(const 可解析引用<T节点>& 引用)
    {
        if (!引用.主键.empty()) {
            return 引用.主键;
        }
        return 引用.指针 ? 引用.指针->获取主键() : std::string{};
    }

    template<class T节点>
    bool 引用严格指向节点_筹办查询(
        const 可解析引用<T节点>& 引用,
        const T节点* 目标) noexcept
    {
        if (!目标 || !引用.有效()) {
            return false;
        }
        if (引用.指针 == 目标) {
            return true;
        }
        if (引用.主键.empty()) {
            return false;
        }
        const auto 目标主键 = 目标->获取主键();
        return !目标主键.empty() && 引用.主键 == 目标主键;
    }

    template<class T节点>
    bool 引用严格等价_筹办查询(
        const 可解析引用<T节点>& 左,
        const 可解析引用<T节点>& 右)
    {
        if (左.指针 || 右.指针) {
            return 左.指针 == 右.指针;
        }
        const auto 左主键 = 引用主键_筹办查询(左);
        const auto 右主键 = 引用主键_筹办查询(右);
        return !左主键.empty() && 左主键 == 右主键;
    }

    二次特征节点类* 解析二次特征引用_筹办查询(
        const 可解析引用<二次特征节点类>& 引用) noexcept
    {
        if (引用.指针) {
            return 引用.指针;
        }
        if (引用.主键.empty()) {
            return nullptr;
        }
        return 世界树.基础信息().查找主键(引用.主键);
    }

    特征节点类* 解析特征引用_筹办查询(
        const 可解析引用<特征节点类>& 引用) noexcept
    {
        if (引用.指针) {
            return 引用.指针;
        }
        if (引用.主键.empty()) {
            return nullptr;
        }
        return 世界树.基础信息().查找主键(引用.主键);
    }

    状态节点类* 解析状态引用_筹办查询(
        const 可解析引用<状态节点类>& 引用) noexcept
    {
        if (引用.指针) {
            return const_cast<状态节点类*>(引用.指针);
        }
        if (引用.主键.empty()) {
            return nullptr;
        }
        return reinterpret_cast<状态节点类*>(
            世界树.基础信息().查找主键(引用.主键));
    }

    动态节点类* 解析动态引用_筹办查询(
        const 可解析引用<动态节点类>& 引用) noexcept
    {
        if (引用.指针) {
            return 引用.指针;
        }
        if (引用.主键.empty()) {
            return nullptr;
        }
        return 世界树.基础信息().查找主键(引用.主键);
    }

    枚举_任务管理因果路径生成类型 转换因果路径生成类型_筹办查询(
        const 枚举_临时因果路径角色 角色) noexcept
    {
        switch (角色) {
        case 枚举_临时因果路径角色::促成:
            return 枚举_任务管理因果路径生成类型::促成;
        case 枚举_临时因果路径角色::避免:
            return 枚举_任务管理因果路径生成类型::避免;
        case 枚举_临时因果路径角色::条件补齐:
            return 枚举_任务管理因果路径生成类型::条件补齐;
        case 枚举_临时因果路径角色::方法就绪:
            return 枚举_任务管理因果路径生成类型::方法就绪;
        case 枚举_临时因果路径角色::证据补齐:
            return 枚举_任务管理因果路径生成类型::证据补齐;
        case 枚举_临时因果路径角色::副作用约束:
            return 枚举_任务管理因果路径生成类型::副作用约束;
        case 枚举_临时因果路径角色::学习缺口:
            return 枚举_任务管理因果路径生成类型::学习缺口;
        case 枚举_临时因果路径角色::未定义:
        default:
            return 枚举_任务管理因果路径生成类型::未定义;
        }
    }

    枚举_任务管理派生需求类型 转换派生需求类型_筹办查询(
        const 枚举_临时因果路径角色 角色) noexcept
    {
        switch (角色) {
        case 枚举_临时因果路径角色::避免:
        case 枚举_临时因果路径角色::副作用约束:
            return 枚举_任务管理派生需求类型::风险处置;
        case 枚举_临时因果路径角色::条件补齐:
            return 枚举_任务管理派生需求类型::缺条件;
        case 枚举_临时因果路径角色::方法就绪:
            return 枚举_任务管理派生需求类型::方法结构;
        case 枚举_临时因果路径角色::证据补齐:
            return 枚举_任务管理派生需求类型::缺确认;
        case 枚举_临时因果路径角色::促成:
        case 枚举_临时因果路径角色::学习缺口:
            return 枚举_任务管理派生需求类型::缺信息;
        case 枚举_临时因果路径角色::未定义:
        default:
            return 枚举_任务管理派生需求类型::未定义;
        }
    }

    枚举_任务管理阻塞级别 转换阻塞级别_筹办查询(
        const 枚举_临时因果路径角色 角色) noexcept
    {
        switch (角色) {
        case 枚举_临时因果路径角色::避免:
        case 枚举_临时因果路径角色::副作用约束:
            return 枚举_任务管理阻塞级别::严重;
        case 枚举_临时因果路径角色::条件补齐:
        case 枚举_临时因果路径角色::方法就绪:
        case 枚举_临时因果路径角色::学习缺口:
            return 枚举_任务管理阻塞级别::中等;
        case 枚举_临时因果路径角色::证据补齐:
        case 枚举_临时因果路径角色::促成:
            return 枚举_任务管理阻塞级别::轻微;
        case 枚举_临时因果路径角色::未定义:
        default:
            return 枚举_任务管理阻塞级别::未定义;
        }
    }

    const char* 因果来源类型文本_筹办查询(
        const 枚举_因果来源类型 类型) noexcept
    {
        switch (类型) {
        case 枚举_因果来源类型::观察生成:
            return "观察生成";
        case 枚举_因果来源类型::执行生成:
            return "执行生成";
        case 枚举_因果来源类型::推断生成:
            return "推断生成";
        case 枚举_因果来源类型::遗传:
            return "遗传";
        case 枚举_因果来源类型::未定义:
        default:
            return "未定义";
        }
    }

    bool 派生消息字段完整_筹办查询(
        const 结构_任务管理派生需求消息& 消息) noexcept
    {
        return !消息.父需求主键.empty()
            && 消息.派生需求类型 != 枚举_任务管理派生需求类型::未定义
            && 消息.因果路径生成类型 != 枚举_任务管理因果路径生成类型::未定义
            && 消息.阻塞级别 != 枚举_任务管理阻塞级别::未定义
            && 消息.需求特征类型指针 != 0
            && !消息.需求特征类型主键.empty()
            && 消息.需求目标主体指针 != 0
            && !消息.需求目标主体主键.empty()
            && 消息.需求当前状态指针 != 0
            && !消息.需求当前状态主键.empty()
            && 消息.需求目标状态指针 != 0
            && !消息.需求目标状态主键.empty()
            && 消息.满足关系 != 0;
    }

    结构_任务管理派生需求消息 构造正式派生需求消息草案_筹办查询(
        const 任务节点* 任务头,
        const 需求节点* 来源需求,
        const 结构_临时因果路径项& 项,
        const 时间戳 now) noexcept
    {
        结构_任务管理派生需求消息 消息{};
        消息.消息头.任务主键 = 任务主键_筹办日志(任务头);
        消息.消息头.产生时间 = now;
        消息.父需求指针 = reinterpret_cast<std::uintptr_t>(
            const_cast<需求节点*>(来源需求));
        消息.父需求主键 = 来源需求 ? 来源需求->获取主键() : std::string{};
        消息.来源因果指针 = reinterpret_cast<std::uintptr_t>(项.来源因果);
        消息.来源因果主键 = 项.来源因果 ? 项.来源因果->获取主键() : std::string{};
        消息.派生需求类型 = 转换派生需求类型_筹办查询(项.角色);
        消息.因果路径生成类型 = 转换因果路径生成类型_筹办查询(项.角色);
        消息.阻塞级别 = 转换阻塞级别_筹办查询(项.角色);
        if (项.派生后父任务继续) {
            消息.阻塞级别 = 枚举_任务管理阻塞级别::轻微;
        }
        消息.是否阻塞当前步骤 = !项.派生后父任务继续;
        消息.是否影响父任务推进 = !项.派生后父任务继续;
        消息.是否可能影响安全 = 项.根分区 == 1 || 项.根分区 == 3;
        消息.是否可能影响服务 = 项.根分区 == 2 || 项.根分区 == 3;
        消息.是否建议线程重判 = true;
        消息.需求特征类型指针 =
            reinterpret_cast<std::uintptr_t>(项.派生目标特征类型);
        消息.需求特征类型主键 = 入口主键_筹办日志(项.派生目标特征类型);
        消息.需求目标主体指针 =
            reinterpret_cast<std::uintptr_t>(项.派生目标主体);
        消息.需求目标主体主键 = 基础主键_筹办日志(项.派生目标主体);
        消息.需求当前状态指针 =
            reinterpret_cast<std::uintptr_t>(项.派生当前状态);
        消息.需求当前状态主键 = 状态主键_筹办日志(项.派生当前状态);
        消息.需求目标状态指针 =
            reinterpret_cast<std::uintptr_t>(项.派生目标状态);
        消息.需求目标状态主键 = 状态主键_筹办日志(项.派生目标状态);
        消息.满足关系 = 项.派生满足关系 != 0
            ? 项.派生满足关系
            : 关系_等于;
        消息.贡献层级 = 项.贡献层级;
        消息.层级权重 = 项.层级权重;
        消息.稳定度摘要 = 项.稳定度;
        消息.派生原因 = 项.目标化说明;
        消息.证据摘要 =
            std::string("因果路径筹办正式派生需求消息草案")
            + " | 因果来源类型=" + 因果来源类型文本_筹办查询(项.来源因果类型)
            + " | 后天验证=" + std::to_string(项.来源因果已验证 ? 1 : 0)
            + " | 来源因果键=" + (!消息.来源因果主键.empty()
                ? 消息.来源因果主键
                : std::string("空"))
            + " | 中间必要状态=" + 入口主键_筹办日志(项.派生目标特征类型)
            + " | 中间状态当前满足=0"
            + " | 缺口报告=1";
        同步任务管理派生需求消息语义槽(消息);
        return 消息;
    }

    bool 因果证据足够_筹办查询(const 因果主信息类& 因果) noexcept
    {
        constexpr std::uint64_t 最小观察次数 = 3;
        constexpr std::uint64_t 最小成立次数 = 1;
        // 遗传因果是冷启动路线图，不是后天结论；筹办可用它反推必要状态，
        // 但后天证据仍由后续观察 / 执行动态被动强化或削弱。
        if (因果.来源类型 == 枚举_因果来源类型::遗传) {
            return true;
        }
        if (因果.已验证) {
            return true;
        }
        if (因果.观察次数 < 最小观察次数) {
            return false;
        }
        if (因果.成立次数 < 最小成立次数) {
            return false;
        }
        return 因果.失败次数 <= 因果.成立次数;
    }

    结构_临时因果路径项 构造临时因果路径项_筹办查询(
        因果节点类* 因果节点,
        const 因果主信息类& 因果,
        const 枚举_临时因果路径角色 角色,
        const I64 根分区,
        二次特征节点类* 子需求目标比较,
        const std::uint32_t 贡献层级)
    {
        结构_临时因果路径项 项{};
        项.来源因果 = 因果节点;
        项.角色 = 角色;
        项.根分区 = 根分区;
        项.子需求目标比较 = 子需求目标比较;
        项.贡献层级 = 贡献层级;
        项.层级权重 = 计算临时因果层级权重_百万分比(贡献层级);
        项.稳定度 = 因果.计算稳定度();
        项.来源因果类型 = 因果.来源类型;
        项.来源因果已验证 = 因果.已验证;
        项.条件已满足 = 因果.条件比较模板.empty();
        项.证据足够 = 因果证据足够_筹办查询(因果);
        return 项;
    }

    bool 目标化状态比较路径项_筹办查询(
        结构_临时因果路径项& 项,
        const char* 来源说明) noexcept
    {
        if (!项.子需求目标比较) {
            return false;
        }
        const auto* 比较信息 =
            世界树.二次特征().取二次特征主信息(项.子需求目标比较);
        if (!比较信息) {
            return false;
        }
        auto* 当前状态 = 解析状态引用_筹办查询(比较信息->来源起始状态);
        auto* 目标状态 = 解析状态引用_筹办查询(比较信息->来源结果状态);
        if (!当前状态 || !目标状态) {
            return false;
        }

        auto* 目标主体 = 状态节点主体(目标状态);
        if (!目标主体) {
            目标主体 = 状态节点主体(当前状态);
        }
        auto* 目标特征类型 = 状态节点目标特征类型(目标状态);
        if (!目标特征类型) {
            目标特征类型 = 状态节点目标特征类型(当前状态);
        }
        if (!目标主体 || !目标特征类型) {
            return false;
        }

        项.目标已目标化 = true;
        项.派生目标主体 = 目标主体;
        项.派生目标特征类型 = 目标特征类型;
        项.派生当前状态 = 当前状态;
        项.派生目标状态 = 目标状态;
        (void)状态节点I64值(当前状态, 项.派生当前状态值);
        (void)状态节点I64值(目标状态, 项.派生目标状态值);
        项.派生满足关系 = 关系_等于;

        std::ostringstream 说明;
        说明 << "因果路径子目标目标化"
            << " | 来源=" << (来源说明 ? 来源说明 : "因比较模板")
            << " | 目标宿主=" << 基础主键_筹办日志(目标主体)
            << " | 目标特征=" << 入口主键_筹办日志(目标特征类型)
            << " | 目标比较符=等于"
            << " | 当前状态=" << 状态主键_筹办日志(当前状态)
            << " | 目标状态=" << 状态主键_筹办日志(目标状态);
        项.目标化说明 = 说明.str();
        return true;
    }

    状态节点类* 查找因果条件目标状态_筹办查询(
        const 因果主信息类& 因果,
        const 可解析引用<特征节点类>& 条件引用) noexcept
    {
        auto* 条件特征 = 解析特征引用_筹办查询(条件引用);
        for (const auto& 动态引用 : 因果.证据动态样本) {
            auto* 动态 = 解析动态引用_筹办查询(动态引用);
            auto* 动态信息 = 动态 ? 世界树.动态().取动态主信息(动态) : nullptr;
            if (!动态信息) {
                continue;
            }
            auto* 初始状态 = 解析状态引用_筹办查询(动态信息->初始状态);
            const auto* 初始状态信息 = 状态主信息(初始状态);
            if (!初始状态信息 || !初始状态信息->状态特征.有效()) {
                continue;
            }
            const bool 特征命中 = 条件特征
                ? 引用严格指向节点_筹办查询(初始状态信息->状态特征, 条件特征)
                : 引用严格等价_筹办查询(初始状态信息->状态特征, 条件引用);
            if (特征命中) {
                return 初始状态;
            }
        }
        return nullptr;
    }

    状态节点类* 创建筹办I64状态节点(
        ::自我类& 自我对象,
        基础信息节点类* 主体,
        const 语素入口节点类* 特征类型,
        I64 值,
        时间戳 now) noexcept;

    bool 目标化条件比较路径项_筹办查询(
        ::自我类& 自我对象,
        结构_临时因果路径项& 项,
        const 因果主信息类& 因果,
        const 可解析引用<特征节点类>& 条件引用,
        const 时间戳 now) noexcept
    {
        auto* 目标状态 = 查找因果条件目标状态_筹办查询(因果, 条件引用);
        const auto* 目标状态信息 = 状态主信息(目标状态);
        if (!目标状态信息) {
            return false;
        }

        auto* 目标主体 = 目标状态信息->状态主体.指针;
        auto* 条件特征 = 目标状态信息->状态特征.指针
            ? 目标状态信息->状态特征.指针
            : 解析特征引用_筹办查询(目标状态信息->状态特征);
        const auto* 目标特征类型 = 状态节点目标特征类型(目标状态);
        I64 目标值 = 0;
        if (!目标主体
            || !条件特征
            || !目标特征类型
            || !状态节点I64值(目标状态, 目标值)) {
            return false;
        }

        I64 当前值 = 0;
        const bool 当前值已读 =
            世界树.读取特征_I64(条件特征, 当前值)
            || 世界树.读取特征_I64(目标主体, 目标特征类型, 当前值);
        if (!当前值已读) {
            return false;
        }
        if (当前值 == 目标值) {
            项.条件已满足 = true;
            return true;
        }

        auto* 当前状态 = 创建筹办I64状态节点(
            自我对象,
            目标主体,
            目标特征类型,
            当前值,
            now);
        if (!当前状态) {
            return false;
        }

        项.条件已满足 = false;
        项.目标已目标化 = true;
        项.派生目标主体 = 目标主体;
        项.派生目标特征类型 = 目标特征类型;
        项.派生当前状态 = 当前状态;
        项.派生目标状态 = 目标状态;
        项.派生当前状态值 = 当前值;
        项.派生目标状态值 = 目标值;
        项.派生满足关系 = 关系_等于;

        std::ostringstream 说明;
        说明 << "因果条件缺口目标化"
            << " | 来源=条件比较模板+证据动态初始状态"
            << " | 目标宿主=" << 基础主键_筹办日志(目标主体)
            << " | 目标特征=" << 入口主键_筹办日志(目标特征类型)
            << " | 目标比较符=等于"
            << " | 当前值=" << 当前值
            << " | 目标值=" << 目标值
            << " | 当前状态=" << 状态主键_筹办日志(当前状态)
            << " | 目标状态=" << 状态主键_筹办日志(目标状态)
            << " | 不生成裸条件缺口=1";
        项.目标化说明 = 说明.str();
        return true;
    }

    void 吸收因果条件缺口_筹办查询(
        ::自我类& 自我对象,
        结构_临时因果视图& 视图,
        因果节点类* 因果节点,
        const 因果主信息类& 因果,
        const 时间戳 now)
    {
        if (因果.条件比较模板.empty()) {
            return;
        }
        std::size_t 条件模板数量 = 0;
        std::size_t 条件已满足数量 = 0;
        std::size_t 条件缺口目标化数量 = 0;
        std::size_t 条件不可目标化数量 = 0;
        for (const auto& 条件 : 因果.条件比较模板) {
            if (!条件.有效()) {
                continue;
            }
            ++条件模板数量;
            auto 项 = 构造临时因果路径项_筹办查询(
                因果节点,
                因果,
                枚举_临时因果路径角色::条件补齐,
                视图.根分区,
                nullptr,
                2);
            if (!目标化条件比较路径项_筹办查询(
                    自我对象,
                    项,
                    因果,
                    条件,
                    now)) {
                ++条件不可目标化数量;
                continue;
            }
            if (项.条件已满足) {
                ++条件已满足数量;
                continue;
            }
            if (项.目标已目标化
                && 项.派生目标主体
                && 项.派生目标特征类型
                && 项.派生当前状态
                && 项.派生目标状态) {
                视图.条件缺口.push_back(std::move(项));
                ++条件缺口目标化数量;
            } else {
                ++条件不可目标化数量;
            }
        }
        if (条件模板数量 > 0) {
            std::ostringstream 输出;
            输出 << "因果条件缺口目标化统计"
                << " | 因果=" << 基础主键_筹办日志(因果节点)
                << " | 条件模板=" << 条件模板数量
                << " | 条件已满足=" << 条件已满足数量
                << " | 条件缺口目标化=" << 条件缺口目标化数量
                << " | 条件不可目标化=" << 条件不可目标化数量
                << " | 不生成裸条件缺口=1"
                << " | 直接写需求树=0";
            记录筹办日志(输出.str());
        }
    }

    void 吸收因果方法就绪缺口_筹办查询(
        结构_临时因果视图& 视图,
        因果节点类* 因果节点,
        const 因果主信息类& 因果)
    {
        if (!因果.因方法模板.有效()) {
            return;
        }
        视图.方法就绪缺口.push_back(构造临时因果路径项_筹办查询(
            因果节点,
            因果,
            枚举_临时因果路径角色::方法就绪,
            视图.根分区,
            nullptr,
            3));
    }

    void 吸收因果证据缺口_筹办查询(
        结构_临时因果视图& 视图,
        因果节点类* 因果节点,
        const 因果主信息类& 因果)
    {
        if (因果证据足够_筹办查询(因果)) {
            return;
        }
        视图.证据缺口.push_back(构造临时因果路径项_筹办查询(
            因果节点,
            因果,
            枚举_临时因果路径角色::证据补齐,
            视图.根分区,
            nullptr,
            3));
    }

    void 吸收促成因果到临时视图_筹办查询(
        ::自我类& 自我对象,
        结构_临时因果视图& 视图,
        因果节点类* 因果节点,
        const 因果主信息类& 因果,
        const 时间戳 now)
    {
        for (const auto& 因引用 : 因果.因比较模板) {
            auto* 因比较 = 解析二次特征引用_筹办查询(因引用);
            if (!因比较) {
                continue;
            }
            auto 项 = 构造临时因果路径项_筹办查询(
                因果节点,
                因果,
                枚举_临时因果路径角色::促成,
                视图.根分区,
                因比较,
                1);
            (void)目标化状态比较路径项_筹办查询(项, "因比较模板");
            视图.促成路径.push_back(std::move(项));
        }
        吸收因果条件缺口_筹办查询(自我对象, 视图, 因果节点, 因果, now);
        吸收因果方法就绪缺口_筹办查询(视图, 因果节点, 因果);
        吸收因果证据缺口_筹办查询(视图, 因果节点, 因果);
    }

    void 吸收避免因果到临时视图_筹办查询(
        ::自我类& 自我对象,
        结构_临时因果视图& 视图,
        因果节点类* 因果节点,
        const 因果主信息类& 因果,
        const 时间戳 now)
    {
        for (const auto& 因引用 : 因果.因比较模板) {
            auto* 风险因比较 = 解析二次特征引用_筹办查询(因引用);
            if (!风险因比较) {
                continue;
            }
            auto 项 = 构造临时因果路径项_筹办查询(
                因果节点,
                因果,
                枚举_临时因果路径角色::避免,
                视图.根分区,
                风险因比较,
                1);
            (void)目标化状态比较路径项_筹办查询(项, "反向因比较模板");
            视图.避免路径.push_back(std::move(项));
        }
        吸收因果条件缺口_筹办查询(自我对象, 视图, 因果节点, 因果, now);
        吸收因果证据缺口_筹办查询(视图, 因果节点, 因果);
    }

    状态节点类* 创建筹办I64状态节点(
        ::自我类& 自我对象,
        基础信息节点类* 主体,
        const 语素入口节点类* 特征类型,
        const I64 值,
        const 时间戳 now) noexcept
    {
        if (!主体 || !特征类型) {
            return nullptr;
        }
        auto* 场景 = 自我对象.获取自我内部世界();
        if (!场景) {
            场景 = 自我对象.获取自我现实场景();
        }
        auto* 特征 = 世界树.确保特征(主体, 特征类型);
        if (!场景 || !特征) {
            return nullptr;
        }
        return 世界树.状态().创建状态(
            场景,
            主体,
            特征,
            特征值{ 值 },
            now,
            now);
    }

