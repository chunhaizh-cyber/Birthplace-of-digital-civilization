enum class 枚举_任务推进阶段 : std::uint8_t {
    未定义 = 0,
    筹办 = 1,
    执行 = 2,
};

enum class 枚举_任务推进状况 : std::uint8_t {
    未定义 = 0,

    父需求已满足 = 1,
    存在活动子需求 = 2,
    逻辑组织待聚合 = 3,

    方法查找未命中 = 10,
    已建立方法头待重入 = 11,
    缺方法动作 = 12,
    方法缺可执行入口 = 13,
    方法缺条件节点 = 14,
    方法缺结果节点 = 15,
    方法缺条件结果对 = 16,
    参数不可配 = 17,
    方法运行账不足 = 18,
    方法结果不稳定 = 19,
    方法可执行 = 20,
    方法前置条件未满足 = 21,

    动作执行失败 = 30,
    动作执行成功无可比较结果 = 31,
    目标结果符合 = 32,
    目标结果不符合 = 33,
    出现需要附带结果 = 34,
    出现不需要附带结果 = 35,
    出现禁止结果 = 36,
};

enum class 枚举_任务执行结果类型 : std::uint8_t {
    未定义 = 0,
    目标已达成 = 1,
    有推进未达成 = 2,
    无推进未达成 = 3,
    退步 = 4,
    不可比较 = 5,
};

struct 结构_任务推进回执 {
    枚举_任务推进阶段 阶段 = 枚举_任务推进阶段::未定义;
    枚举_任务推进状况 状况 = 枚举_任务推进状况::未定义;
    枚举_任务状态 建议任务状态 = 枚举_任务状态::未定义;
    枚举_任务阶段 建议任务阶段 = 枚举_任务阶段::未定义;

    可解析引用<任务节点类> 当前任务{};
    可解析引用<需求节点类> 对应需求{};
    可解析引用<方法节点类> 当前方法{};
    std::vector<可解析引用<方法节点类>> 候选方法集{};
    可解析引用<基础信息节点类> 缺口目标主体{};
    可解析引用<场景节点类> 可执行输入参数场景{};

    const 语素入口节点类* 目标特征类型 = nullptr;
    三向关系掩码 目标满足关系 = 关系_等于;

    const 语素入口节点类* 缺口特征类型 = nullptr;
    三向关系掩码 缺口满足关系 = 关系_等于;

    std::vector<可解析引用<状态节点类>> 实际结果状态集{};
    std::vector<可解析引用<状态节点类>> 禁止结果状态集{};
    std::vector<可解析引用<状态节点类>> 需要附带结果状态集{};

    bool 需要自我线程 = false;
    bool 父任务需要重筹办 = false;
    bool 需要创建或复用子需求 = false;
    bool 当前任务目标达成 = false;
    bool 本轮是否有推进 = false;
    bool 任务结果可比较 = false;
    bool 治理结果可接受 = true;

    I64 本轮推进量 = 0;
    I64 剩余差距 = 0;
    I64 完成度百万分比 = 0;
    枚举_任务执行结果类型 执行结果类型 =
        枚举_任务执行结果类型::未定义;
    动作验证报告::结构_动作验证报告摘要 动作验证报告摘要{};
};

struct 结构_任务筹办结果 {
    bool 已执行筹办 = false;
    bool 已绑定方法 = false;
    bool 已创建目标方法头 = false;
    bool 已建立方法头待重入 = false;
    bool 缺少任务 = false;
    bool 缺少需求目标 = false;
    特征节点类* 方法运行结果 = nullptr;
    场景节点类* 结果场景 = nullptr;
    结构_任务推进回执 回执{};
    std::vector<结构_任务管理派生需求消息> 待上报派生需求消息集{};
};

struct 结构_安全因果风险树常驻维护结果 {
    bool 已执行 = false;
    bool 已跳过 = false;
    bool 已同步 = false;
    bool 版本变化 = false;
    std::size_t 节点数量 = 0;
    std::size_t 搜索缺口数量 = 0;
    std::size_t 场景影响前置缺口数量 = 0;
    I64 树版本 = 0;
};

结构_安全因果风险树常驻维护结果 维护安全因果风险树常驻任务(
    ::自我类& 自我对象,
    时间戳 now = 0) noexcept;

std::vector<结构_任务管理派生需求消息> 生成安全因果风险树缺口派生需求消息集(
    ::自我类& 自我对象,
    时间戳 now = 0) noexcept;

