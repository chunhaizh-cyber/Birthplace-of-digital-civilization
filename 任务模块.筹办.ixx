    const char* 安全风险树因素名_筹办查询(I64 因素ID) noexcept
    {
        return 因素ID > 0 ? "因果模板因素" : "未定义";
    }

    struct 结构_安全因果风险树展开统计 {
        bool 已执行 = false;
        bool 已跳过 = false;
        std::size_t 节点数量 = 0;
        std::size_t 搜索缺口数量 = 0;
        std::size_t 场景影响前置缺口数量 = 0;
        std::size_t 状态物化数量 = 0;
        I64 输入版本 = 0;
        I64 旧输入版本 = 0;
        bool 版本变化 = false;
        bool 同步状态已写入 = false;
        std::string 跳过原因{};
    };

    I64 安全风险树节点键_筹办查询(I64 层级, I64 因素ID) noexcept
    {
        return 层级 * 1000000 + 因素ID;
    }

    bool 安全风险树因素需要通用证据搜索_筹办查询(I64 因素ID) noexcept
    {
        return 因素ID > 0;
    }

    I64 计算安全因果风险树输入版本_筹办查询(因果节点类* 来源因果) noexcept
    {
        (void)来源因果;
        return 安全风险树层级_风险安全_v1 * 1000000000LL
            + 安全风险树同层因素集合版本_风险安全_v1 * 1000000LL
            + 安全风险树来源因果结构版本_风险安全_v1 * 1009LL;
    }

    bool 维护安全因果风险树同步状态_筹办查询(
        const 任务节点* 任务头,
        const 需求节点* 来源需求,
        基础信息节点类* 树宿主,
        因果节点类* 来源因果,
        结构_安全因果风险树展开统计& 统计,
        时间戳 now) noexcept
    {
        if (!树宿主) {
            return false;
        }

        I64 旧版本 = 0;
        const bool 有旧版本 = 世界树.读取特征_I64(
            树宿主,
            特征_安全因果风险树版本_筹办查询(),
            旧版本);

        统计.输入版本 = 计算安全因果风险树输入版本_筹办查询(来源因果);
        统计.旧输入版本 = 有旧版本 ? 旧版本 : 0;
        统计.版本变化 = !有旧版本 || 旧版本 != 统计.输入版本;

        bool ok = true;
        ok = 世界树.写入特征_I64(
            树宿主,
            特征_安全因果风险树同步状态_筹办查询(),
            安全风险树同步状态_已同步,
            now) && ok;
        ok = 世界树.写入特征_I64(
            树宿主,
            特征_安全因果风险树版本_筹办查询(),
            统计.输入版本,
            now) && ok;
        ok = 世界树.写入特征_I64(
            树宿主,
            特征_安全因果风险树节点数量_筹办查询(),
            static_cast<I64>(统计.节点数量),
            now) && ok;
        ok = 世界树.写入特征_I64(
            树宿主,
            特征_安全因果风险树搜索缺口报告数量_筹办查询(),
            static_cast<I64>(统计.搜索缺口数量),
            now) && ok;
        ok = 世界树.写入特征_I64(
            树宿主,
            特征_安全因果风险树最近维护时间_筹办查询(),
            static_cast<I64>(now),
            now) && ok;

        统计.同步状态已写入 = ok;

        std::ostringstream 输出;
        输出 << "安全因果风险树常驻维护任务"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 来源需求=" << 需求主键_筹办日志(来源需求)
            << " | 树宿主=" << 基础主键_筹办日志(树宿主)
            << " | 来源因果信息ID=" << 基础主键_筹办日志(来源因果)
            << " | 旧树版本=" << 统计.旧输入版本
            << " | 新树版本=" << 统计.输入版本
            << " | 版本变化=" << (统计.版本变化 ? 1 : 0)
            << " | 同步状态写入=" << (统计.同步状态已写入 ? 1 : 0)
            << " | 树节点数量=" << 统计.节点数量
            << " | 参数化搜索缺口报告数量=" << 统计.搜索缺口数量
            << " | 场景影响前置缺口报告数量=" << 统计.场景影响前置缺口数量
            << " | 只反推更新风险树=1"
            << " | 不执行搜索=1"
            << " | 不写默认满足=1"
            << " | 不写因素值=1"
            << " | 不写风险安全层总值=1"
            << " | 不写自我安全值=1"
            << " | 不回写需求满足=1"
            << " | 不结算价值=1";
        记录筹办日志(输出.str());
        return ok;
    }

    存在节点类* 取或创建安全因果风险树因素节点_筹办查询(
        基础信息节点类* 父宿主,
        因果节点类* 来源因果,
        I64 层级,
        I64 因素ID,
        时间戳 now) noexcept
    {
        if (!父宿主 || 层级 <= 0 || 因素ID <= 0) {
            return nullptr;
        }
        const I64 节点键 = 安全风险树节点键_筹办查询(层级, 因素ID);
        auto* 节点 = 世界树.取或创建子存在_按类型并按特征I64(
            父宿主,
            类型_安全因果风险树节点_筹办查询(),
            特征_安全因果风险树节点键_筹办查询(),
            节点键);
        auto* 宿主 = reinterpret_cast<基础信息节点类*>(节点);
        if (!宿主) {
            return nullptr;
        }
        (void)世界树.写入特征_I64(
            宿主,
            特征_安全因果风险树节点键_筹办查询(),
            节点键,
            now);
        (void)世界树.写入特征_I64(
            宿主,
            特征_安全因果层级_风险树筹办查询(),
            层级,
            now);
        (void)世界树.写入特征_I64(
            宿主,
            特征_安全因果因素ID_风险树筹办查询(),
            因素ID,
            now);
        (void)世界树.写入特征_I64(
            宿主,
            特征_安全因果证据方向_风险树筹办查询(),
            安全风险树证据方向_负向,
            now);
        (void)世界树.写入特征_I64(
            宿主,
            特征_安全因果因素证据搜索状态_风险树筹办查询(),
            安全风险树搜索状态_未执行,
            now);
        (void)世界树.写入特征_I64(
            宿主,
            特征_安全因果风险树上级因素ID_筹办查询(),
            0,
            now);
        (void)世界树.写入特征_I64(
            宿主,
            特征_安全因果风险树同层因素集合版本_筹办查询(),
            安全风险树同层因素集合版本_风险安全_v1,
            now);
        (void)世界树.写入特征_I64(
            宿主,
            特征_安全因果风险树入账状态_筹办查询(),
            安全风险树入账状态_未入账,
            now);
        (void)世界树.写入特征_I64(
            宿主,
            特征_安全因果风险树聚合状态_筹办查询(),
            安全风险树聚合状态_未聚合,
            now);
        if (来源因果) {
            (void)世界树.写入特征_指针(
                宿主,
                特征_目标安全因果信息_风险树筹办查询(),
                来源因果,
                now);
        }
        return 节点;
    }

    结构_临时因果路径项 构造安全风险树搜索缺口项_筹办查询(
        ::自我类& 自我对象,
        const 结构_临时因果视图& 视图,
        因果节点类* 来源因果,
        基础信息节点类* 因素宿主,
        I64 因素ID,
        时间戳 now) noexcept
    {
        结构_临时因果路径项 项{};
        项.来源因果 = 来源因果;
        项.角色 = 枚举_临时因果路径角色::证据补齐;
        项.根分区 = 视图.根分区;
        项.贡献层级 = 安全风险树层级_风险安全_v1;
        项.层级权重 = 计算临时因果层级权重_百万分比(项.贡献层级);
        if (auto* 因果信息 = 来源因果 ? 世界树.因果().取因果主信息(来源因果) : nullptr) {
            项.来源因果类型 = 因果信息->来源类型;
            项.来源因果已验证 = 因果信息->已验证;
            项.稳定度 = 因果信息->计算稳定度();
        } else {
            项.来源因果类型 = 枚举_因果来源类型::未定义;
        }
        项.证据足够 = false;
        项.目标已目标化 = 因素宿主 != nullptr;
        项.派生目标主体 = 因素宿主;
        项.派生目标特征类型 = 特征_安全因果因素证据搜索状态_风险树筹办查询();
        项.派生当前状态值 = 安全风险树搜索状态_未执行;
        项.派生目标状态值 = 安全风险树搜索状态_已完成;
        项.派生满足关系 = 关系_等于;
        if (因素宿主) {
            项.派生当前状态 = 创建筹办I64状态节点(
                自我对象,
                因素宿主,
                项.派生目标特征类型,
                项.派生当前状态值,
                now);
            项.派生目标状态 = 创建筹办I64状态节点(
                自我对象,
                因素宿主,
                项.派生目标特征类型,
                项.派生目标状态值,
                now);
        }
        项.目标化说明 =
            std::string("安全因果风险树搜索缺口 | 层级=2 | 因素=")
            + 安全风险树因素名_筹办查询(因素ID)
            + " | 安全因果因素证据搜索状态 等于 已完成"
            + " | 搜索方向=负向"
            + " | 默认满足需搜索后提交";
        return 项;
    }

    结构_临时因果路径项 构造安全风险树场景影响前置缺口项_筹办查询(
        ::自我类& 自我对象,
        const 结构_临时因果视图& 视图,
        因果节点类* 来源因果,
        基础信息节点类* 目标宿主,
        const 语素入口节点类* 目标特征,
        I64 当前值,
        I64 目标值,
        const char* 缺口名称,
        时间戳 now) noexcept
    {
        结构_临时因果路径项 项{};
        项.来源因果 = 来源因果;
        项.角色 = 枚举_临时因果路径角色::证据补齐;
        项.根分区 = 视图.根分区;
        项.贡献层级 = 安全风险树层级_风险安全_v1;
        项.层级权重 = 计算临时因果层级权重_百万分比(项.贡献层级);
        if (auto* 因果信息 = 来源因果 ? 世界树.因果().取因果主信息(来源因果) : nullptr) {
            项.来源因果类型 = 因果信息->来源类型;
            项.来源因果已验证 = 因果信息->已验证;
            项.稳定度 = 因果信息->计算稳定度();
        } else {
            项.来源因果类型 = 枚举_因果来源类型::未定义;
        }
        项.证据足够 = false;
        项.目标已目标化 = 目标宿主 != nullptr && 目标特征 != nullptr;
        项.派生目标主体 = 目标宿主;
        项.派生目标特征类型 = 目标特征;
        项.派生当前状态值 = 当前值;
        项.派生目标状态值 = 目标值;
        项.派生满足关系 = 关系_等于;
        if (目标宿主 && 目标特征) {
            项.派生当前状态 = 创建筹办I64状态节点(
                自我对象,
                目标宿主,
                项.派生目标特征类型,
                项.派生当前状态值,
                now);
            项.派生目标状态 = 创建筹办I64状态节点(
                自我对象,
                目标宿主,
                项.派生目标特征类型,
                项.派生目标状态值,
                now);
        }
        项.目标化说明 =
            std::string("安全因果风险树场景影响入账前置缺口 | ")
            + (缺口名称 ? 缺口名称 : "场景影响前置证据")
            + " 等于 已明确"
            + " | 来源=场景影响部分合法入账闸门"
            + " | 不执行安全因果因素搜索"
            + " | 不写默认满足";
        return 项;
    }

    结构_安全因果风险树展开统计 筹办_展开安全因果风险树(
        ::自我类& 自我对象,
        const 任务节点* 任务头,
        const 结构_需求生命周期上下文_筹办& 需求上下文,
        结构_临时因果视图& 视图,
        因果节点类* 来源因果,
        时间戳 now) noexcept
    {
        (void)自我对象;
        (void)需求上下文;
        (void)来源因果;
        (void)now;
        结构_安全因果风险树展开统计 统计{};
        统计.已执行 = true;
        统计.已跳过 = true;
        统计.跳过原因 = "任务筹办不再展开固定风险树因素";
        记录筹办日志(
            "筹办_展开安全因果风险树跳过"
            " | 原因=任务筹办不再展开固定风险树因素"
            " | 任务=" + 任务主键_筹办日志(任务头)
            + " | 来源需求=" + 需求主键_筹办日志(视图.来源需求)
            + " | 路径来源=遗传因果查询壳"
            + " | 任务筹办更新权=0"
            + " | 固定五因素表=0"
            + " | 直接写需求树=0"
            + " | 不写默认满足=1"
            + " | 不写因素值=1");
        return 统计;
    }

    bool 父需求目标特征依赖深度空间_筹办查询(
        const 语素入口节点类* 目标特征类型) noexcept
    {
        return 语素入口同一(目标特征类型, 特征_筹办_质量可用状态())
            || 语素入口同一(目标特征类型, 特征_筹办_基础观察事实可用状态())
            || 语素入口同一(目标特征类型, 特征_筹办_深度有效率())
            || 语素入口同一(目标特征类型, 特征_筹办_空间坐标有效率())
            || 语素入口同一(目标特征类型, 特征_筹办_深度观察质量状态())
            || 语素入口同一(目标特征类型, 特征_筹办_空间坐标观察质量状态())
            || 语素入口同一(目标特征类型, 特征_筹办_空间类后续处理适用状态())
            || 语素入口同一(目标特征类型, 特征_筹办_风险判断适用状态())
            || 语素入口同一(目标特征类型, 特征_筹办_存在确认适用状态())
            || 语素入口同一(目标特征类型, 特征_筹办_空间候选集合())
            || 语素入口同一(目标特征类型, 特征_筹办_空间候选数量())
            || 语素入口同一(目标特征类型, 特征_筹办_假设距离())
            || 语素入口同一(目标特征类型, 特征_筹办_观察存在确认状态());
    }

    bool 父需求目标特征可降级继续_筹办查询(
        const 语素入口节点类* 目标特征类型) noexcept
    {
        return 语素入口同一(目标特征类型, 特征_筹办_像素覆盖状态())
            || 语素入口同一(目标特征类型, 特征_筹办_坐标回查可用状态())
            || 语素入口同一(目标特征类型, 特征_筹办_帧内编号回查可用状态());
    }

    bool 父需求目标属于观察处理_筹办查询(
        const 语素入口节点类* 目标特征类型) noexcept
    {
        return 父需求目标特征依赖深度空间_筹办查询(目标特征类型)
            || 父需求目标特征可降级继续_筹办查询(目标特征类型);
    }

    存在节点类* 确保新观察材料目标主体_筹办查询(::自我类& 自我对象) noexcept
    {
        auto* 父节点 = reinterpret_cast<基础信息节点类*>(自我对象.获取自我内部世界());
        if (!父节点) {
            父节点 = reinterpret_cast<基础信息节点类*>(自我对象.获取自我现实场景());
        }
        if (!父节点) {
            父节点 = 世界树.基础信息().世界根();
        }
        return 世界树.取或创建子存在_按类型(
            父节点,
            类型_筹办_新观察材料());
    }

    const char* 父需求继续策略文本_筹办查询(
        bool 依赖深度空间,
        bool 允许降级) noexcept
    {
        if (依赖深度空间 && !允许降级) {
            return "等待子需求";
        }
        if (依赖深度空间) {
            return "降级继续";
        }
        return "并行补救";
    }

    const char* 观察质量阻塞关系文本_筹办查询(
        bool 依赖深度空间,
        bool 允许降级) noexcept
    {
        if (依赖深度空间 && !允许降级) {
            return "硬阻塞";
        }
        if (依赖深度空间) {
            return "软阻塞";
        }
        return "旁路补救";
    }

    结构_临时因果路径项 构造新观察材料质量目标项_筹办查询(
        ::自我类& 自我对象,
        const 结构_临时因果视图& 视图,
        基础信息节点类* 新观察材料,
        const 语素入口节点类* 目标特征,
        const I64 当前值,
        const I64 目标值,
        const char* 目标说明,
        const 时间戳 now) noexcept
    {
        结构_临时因果路径项 项{};
        项.角色 = 视图.父需求依赖深度空间质量
            ? 枚举_临时因果路径角色::条件补齐
            : 枚举_临时因果路径角色::促成;
        项.根分区 = 视图.根分区;
        项.贡献层级 = 2;
        项.层级权重 = 计算临时因果层级权重_百万分比(项.贡献层级);
        项.稳定度 = 0;
        项.条件已满足 = false;
        项.证据足够 = true;
        项.目标已目标化 = true;
        项.派生后父任务继续 = 视图.父需求继续策略 != "等待子需求";
        项.派生满足关系 = 关系_大于;
        项.派生目标主体 = 新观察材料;
        项.派生目标特征类型 = 目标特征;
        项.派生当前状态值 = 当前值;
        项.派生目标状态值 = 目标值;
        项.派生当前状态 = 创建筹办I64状态节点(
            自我对象,
            新观察材料,
            项.派生目标特征类型,
            项.派生当前状态值,
            now);
        项.派生目标状态 = 创建筹办I64状态节点(
            自我对象,
            新观察材料,
            项.派生目标特征类型,
            项.派生目标状态值,
            now);
        项.目标化说明 =
            std::string("观察质量父需求依赖裁决 | 目标=新观察材料.")
            + (目标说明 ? 目标说明 : "观察质量指标")
            + " 大于 最低阈值"
            + " | 父需求继续策略=" + 视图.父需求继续策略
            + " | 阻塞关系=" + 观察质量阻塞关系文本_筹办查询(
                视图.父需求依赖深度空间质量,
                视图.父需求可降级继续)
            + " | 来源=当前观察帧用途相关质量事实";
        return 项;
    }

    void 注入观察质量父需求依赖裁决_筹办查询(
        ::自我类& 自我对象,
        const 任务节点* 任务头,
        const 结构_需求生命周期上下文_筹办& 需求上下文,
        结构_临时因果视图& 视图,
        const 时间戳 now) noexcept
    {
        auto* 目标宿主 = 需求上下文.目标宿主;
        if (!目标宿主
            || !父需求目标属于观察处理_筹办查询(需求上下文.目标特征类型)) {
            return;
        }

        I64 深度质量 = 筹办观察质量状态_可用;
        I64 空间质量 = 筹办观察质量状态_可用;
        I64 缺口状态 = 0;
        I64 缺口原因集合 = 0;
        I64 空间类适用状态 = 筹办观察适用状态_可用;
        I64 风险适用状态 = 筹办观察适用状态_可用;
        I64 存在确认适用状态 = 筹办观察适用状态_可用;
        I64 线索状态 = 0;
        I64 深度有效率 = 0;
        I64 空间坐标有效率 = 0;
        const bool 已读深度质量 = 世界树.读取特征_I64(
            目标宿主,
            特征_筹办_深度观察质量状态(),
            深度质量);
        const bool 已读空间质量 = 世界树.读取特征_I64(
            目标宿主,
            特征_筹办_空间坐标观察质量状态(),
            空间质量);
        const bool 已读缺口 = 世界树.读取特征_I64(
            目标宿主,
            特征_筹办_质量缺口状态(),
            缺口状态);
        (void)世界树.读取特征_I64(
            目标宿主,
            特征_筹办_质量缺口原因集合(),
            缺口原因集合);
        (void)世界树.读取特征_I64(
            目标宿主,
            特征_筹办_空间类后续处理适用状态(),
            空间类适用状态);
        (void)世界树.读取特征_I64(
            目标宿主,
            特征_筹办_风险判断适用状态(),
            风险适用状态);
        (void)世界树.读取特征_I64(
            目标宿主,
            特征_筹办_存在确认适用状态(),
            存在确认适用状态);
        (void)世界树.读取特征_I64(
            目标宿主,
            特征_筹办_观察质量改善线索状态(),
            线索状态);
        (void)世界树.读取特征_I64(
            目标宿主,
            特征_筹办_深度有效率(),
            深度有效率);
        (void)世界树.读取特征_I64(
            目标宿主,
            特征_筹办_空间坐标有效率(),
            空间坐标有效率);

        const bool 深度不足 =
            (已读深度质量 && 深度质量 == 筹办观察质量状态_不足)
            || (深度有效率 > 0 && 深度有效率 < 筹办观察质量最低深度有效率);
        const bool 空间不足 =
            (已读空间质量 && 空间质量 == 筹办观察质量状态_不足)
            || (空间坐标有效率 > 0 && 空间坐标有效率 < 筹办观察质量最低空间坐标有效率);
        const bool 有质量事实 =
            已读深度质量
            || 已读空间质量
            || 已读缺口
            || 深度有效率 > 0
            || 空间坐标有效率 > 0;
        if (!有质量事实 || (!深度不足 && !空间不足 && 缺口状态 != 筹办观察质量缺口状态_存在)) {
            return;
        }

        视图.观察材料质量目标 = true;
        视图.父需求依赖深度空间质量 =
            父需求目标特征依赖深度空间_筹办查询(需求上下文.目标特征类型);
        视图.父需求可降级继续 =
            父需求目标特征可降级继续_筹办查询(需求上下文.目标特征类型);
        视图.父需求继续策略 = 父需求继续策略文本_筹办查询(
            视图.父需求依赖深度空间质量,
            视图.父需求可降级继续);
        视图.观察材料深度观察质量状态 = 深度质量;
        视图.观察材料空间坐标观察质量状态 = 空间质量;
        视图.观察材料质量缺口状态 = 缺口状态;
        视图.观察材料质量缺口原因集合 = 缺口原因集合;
        视图.观察材料空间类适用状态 = 空间类适用状态;
        视图.观察材料风险判断适用状态 = 风险适用状态;
        视图.观察材料存在确认适用状态 = 存在确认适用状态;
        视图.观察材料质量改善线索状态 = 线索状态;

        auto* 新观察材料 = reinterpret_cast<基础信息节点类*>(
            确保新观察材料目标主体_筹办查询(自我对象));
        bool 已插入观察质量派生路径 = false;
        auto 追加观察质量路径 = [&](const 结构_临时因果路径项& 项) noexcept {
            if (项.角色 == 枚举_临时因果路径角色::条件补齐) {
                视图.条件缺口.push_back(项);
            } else {
                视图.促成路径.push_back(项);
            }
            已插入观察质量派生路径 = true;
        };
        if (新观察材料 && 深度不足) {
            auto 项 = 构造新观察材料质量目标项_筹办查询(
                自我对象,
                视图,
                新观察材料,
                特征_筹办_深度有效率(),
                深度有效率,
                筹办观察质量最低深度有效率,
                "深度有效率",
                now);
            if (项.目标已目标化
                && 项.派生目标主体
                && 项.派生目标特征类型
                && 项.派生当前状态
                && 项.派生目标状态) {
                追加观察质量路径(项);
            }
        }
        if (新观察材料 && 空间不足) {
            auto 项 = 构造新观察材料质量目标项_筹办查询(
                自我对象,
                视图,
                新观察材料,
                特征_筹办_空间坐标有效率(),
                空间坐标有效率,
                筹办观察质量最低空间坐标有效率,
                "空间坐标有效率",
                now);
            if (项.目标已目标化
                && 项.派生目标主体
                && 项.派生目标特征类型
                && 项.派生当前状态
                && 项.派生目标状态) {
                追加观察质量路径(项);
            }
        }

        记录筹办日志(
            "观察质量父需求依赖裁决"
            " | 任务=" + 任务主键_筹办日志(任务头)
            + " | 来源需求=" + 需求主键_筹办日志(视图.来源需求)
            + " | 目标宿主=" + 基础主键_筹办日志(目标宿主)
            + " | 目标特征=" + 入口主键_筹办日志(需求上下文.目标特征类型)
            + " | 读取通用质量事实=1"
            + " | 深度观察质量状态=" + std::to_string(深度质量)
            + " | 空间坐标观察质量状态=" + std::to_string(空间质量)
            + " | 深度有效率=" + std::to_string(深度有效率)
            + " | 空间坐标有效率=" + std::to_string(空间坐标有效率)
            + " | 质量缺口状态=" + std::to_string(缺口状态)
            + " | 空间类适用状态=" + std::to_string(空间类适用状态)
            + " | 父需求依赖深度空间=" + std::to_string(视图.父需求依赖深度空间质量 ? 1 : 0)
            + " | 父需求继续策略=" + 视图.父需求继续策略
            + " | 阻塞关系=" + 观察质量阻塞关系文本_筹办查询(
                视图.父需求依赖深度空间质量,
                视图.父需求可降级继续)
            + " | 派生目标宿主=新观察材料"
            + " | 已插入观察质量派生路径=" + std::to_string(已插入观察质量派生路径 ? 1 : 0)
            + " | 读取S1名称=0"
            + " | 直接写需求树=0");
    }

    void 确保临时视图学习缺口_筹办查询(
        ::自我类& 自我对象,
        结构_临时因果视图& 视图,
        const 时间戳 now)
    {
        if (视图.路径总数() != 0) {
            return;
        }
        if (视图.来源需求 == 自我对象.获取安全根需求()
            || 视图.来源需求 == 自我对象.获取服务根需求()) {
            记录筹办日志("因果路径筹办学习缺口跳过"
                " | 原因=根需求缺口必须由根闭环/风险树/服务触发事实展开，禁止泛化学习缺口挂根"
                " | 来源需求=" + 需求主键_筹办日志(视图.来源需求)
                + " | 目标比较=" + 基础主键_筹办日志(
                    const_cast<基础信息节点类*>(reinterpret_cast<const 基础信息节点类*>(视图.目标比较)))
                + " | 直接写需求树=0 | 实际发送派生需求消息=0");
            return;
        }
        if (特征是学习信息补齐状态(需求目标特征类型(视图.来源需求))) {
            记录筹办日志("因果路径筹办学习缺口跳过"
                " | 原因=目标本身已是学习信息补齐状态，禁止递归派生同类学习缺口"
                " | 来源需求=" + 需求主键_筹办日志(视图.来源需求)
                + " | 目标比较=" + 基础主键_筹办日志(
                    const_cast<基础信息节点类*>(reinterpret_cast<const 基础信息节点类*>(视图.目标比较)))
                + " | 直接写需求树=0 | 实际发送派生需求消息=0");
            return;
        }
        if (!视图.观察材料质量目标) {
            记录筹办日志("因果路径筹办学习缺口跳过"
                " | 原因=缺明确学习对象或方法结构来源，禁止生成泛化学习信息补齐叶子"
                " | 来源需求=" + 需求主键_筹办日志(视图.来源需求)
                + " | 目标比较=" + 基础主键_筹办日志(
                    const_cast<基础信息节点类*>(reinterpret_cast<const 基础信息节点类*>(视图.目标比较)))
                + " | 直接写需求树=0 | 实际发送派生需求消息=0");
            return;
        }
        结构_临时因果路径项 项{};
        项.角色 = 枚举_临时因果路径角色::学习缺口;
        项.根分区 = 视图.根分区;
        项.子需求目标比较 = nullptr;
        项.贡献层级 = 3;
        项.层级权重 = 计算临时因果层级权重_百万分比(项.贡献层级);
        项.目标已目标化 = 视图.目标比较 != nullptr;
        项.派生目标主体 = reinterpret_cast<基础信息节点类*>(
            const_cast<二次特征节点类*>(视图.目标比较));
        项.派生后父任务继续 = 视图.父需求继续策略 != "等待子需求";
        项.派生目标特征类型 = 特征_筹办_观察质量改善路径验证状态();
        项.派生当前状态值 = 学习原子状态词典::未验证;
        项.派生目标状态值 = 学习原子状态词典::已验证;
        项.目标化说明 =
            "观察质量改善路径学习需求 | 观察质量改善路径验证状态 等于 已验证"
            " | 学习对象=获得新观察材料/后续观察帧/融合观察帧"
            " | 父需求继续策略=" + 视图.父需求继续策略;

        auto* 状态场景 = 自我对象.获取自我内部世界();
        if (!状态场景) {
            状态场景 = 自我对象.获取自我现实场景();
        }
        if (状态场景
            && 项.派生目标主体
            && 项.派生目标特征类型) {
            项.派生当前状态 = 自我对象.创建学习I64原子状态(
                状态场景,
                项.派生目标主体,
                项.派生目标特征类型,
                项.派生当前状态值,
                now);
            项.派生目标状态 = 自我对象.创建学习I64原子状态(
                状态场景,
                项.派生目标主体,
                项.派生目标特征类型,
                项.派生目标状态值,
                now);
        }
        视图.学习缺口.push_back(项);
    }

    void 记录临时因果视图统计_筹办查询(
        const 任务节点* 任务头,
        const 结构_临时因果视图& 视图)
    {
        std::size_t 学习缺口已目标化数量 = 0;
        for (const auto& 项 : 视图.学习缺口) {
            if (项.目标已目标化
                && 项.派生目标主体
                && 项.派生目标特征类型
                && (项.派生目标状态值 == 学习原子状态词典::已补齐
                    || 项.派生目标状态值 == 学习原子状态词典::已验证)) {
                ++学习缺口已目标化数量;
            }
        }

        std::ostringstream 输出;
        输出 << "因果路径筹办临时视图统计"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 来源需求=" << 需求主键_筹办日志(视图.来源需求)
            << " | 目标比较=" << 基础主键_筹办日志(
                const_cast<基础信息节点类*>(reinterpret_cast<const 基础信息节点类*>(视图.目标比较)))
            << " | 根分区=" << 视图.根分区
            << " | 观察材料质量目标=" << (视图.观察材料质量目标 ? 1 : 0)
            << " | 父需求依赖深度空间=" << (视图.父需求依赖深度空间质量 ? 1 : 0)
            << " | 父需求继续策略=" << 视图.父需求继续策略
            << " | 深度观察质量状态=" << 视图.观察材料深度观察质量状态
            << " | 空间坐标观察质量状态=" << 视图.观察材料空间坐标观察质量状态
            << " | 质量缺口状态=" << 视图.观察材料质量缺口状态
            << " | 促成路径=" << 视图.促成路径.size()
            << " | 避免路径=" << 视图.避免路径.size()
            << " | 条件缺口=" << 视图.条件缺口.size()
            << " | 方法就绪缺口=" << 视图.方法就绪缺口.size()
            << " | 证据缺口=" << 视图.证据缺口.size()
            << " | 副作用约束=" << 视图.副作用约束.size()
            << " | 学习缺口=" << 视图.学习缺口.size()
            << " | 学习缺口目标化=" << 学习缺口已目标化数量
            << " | 临时视图入树=0"
            << " | 直接写需求树=0"
            << " | 实际发送派生需求消息=0";
        记录筹办日志(输出.str());
    }

    结构_因果路径派生消息草案统计 记录派生需求消息草案统计_筹办查询(
        const 任务节点* 任务头,
        const 结构_临时因果视图& 视图,
        const 时间戳 now,
        std::vector<结构_任务管理派生需求消息>* 输出正式消息集 = nullptr) noexcept
    {
        结构_因果路径派生消息草案统计 统计{};
        统计.已执行 = true;

        const auto 检查路径项 = [&](const 结构_临时因果路径项& 项) noexcept {
            ++统计.路径项数量;

            if (!视图.来源需求) {
                ++统计.缺父需求数量;
            }
            if (项.目标已目标化) {
                ++统计.已目标化数量;
            }
            if (!项.派生目标主体) {
                ++统计.缺目标主体数量;
            }
            if (!项.派生目标特征类型) {
                ++统计.缺目标特征数量;
            }
            if (!项.派生当前状态 || !项.派生目标状态) {
                ++统计.缺状态节点数量;
                return;
            }
            ++统计.状态物化数量;

            if (视图.来源需求
                && 项.目标已目标化
                && 项.派生目标主体
                && 项.派生目标特征类型) {
                ++统计.字段完整数量;
                ++统计.草案数量;
                const auto 消息 = 构造正式派生需求消息草案_筹办查询(
                    任务头,
                    视图.来源需求,
                    项,
                    now);
                ++统计.正式消息数量;
                const bool 消息字段完整 = 派生消息字段完整_筹办查询(消息);
                if (消息字段完整) {
                    ++统计.正式消息字段完整数量;
                    if (输出正式消息集) {
                        输出正式消息集->push_back(消息);
                    }
                }
                if (统计.正式消息数量 == 1) {
                    记录筹办日志(
                        "因果路径筹办正式派生需求消息草案样本 | "
                        + 构造任务管理派生需求消息文本(消息)
                        + " | 字段完整=" + std::to_string(消息字段完整 ? 1 : 0)
                        + " | 直接写需求树=0 | 实际发送派生需求消息=0");
                }
            }
        };

        const auto 检查路径集 = [&](const std::vector<结构_临时因果路径项>& 路径集) noexcept {
            for (const auto& 项 : 路径集) {
                检查路径项(项);
            }
        };
        检查路径集(视图.促成路径);
        检查路径集(视图.避免路径);
        检查路径集(视图.条件缺口);
        检查路径集(视图.方法就绪缺口);
        检查路径集(视图.证据缺口);
        检查路径集(视图.副作用约束);
        检查路径集(视图.学习缺口);

        std::ostringstream 输出;
        输出 << "因果路径筹办派生消息草案统计"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 来源需求=" << 需求主键_筹办日志(视图.来源需求)
            << " | 目标比较=" << 基础主键_筹办日志(
                const_cast<基础信息节点类*>(reinterpret_cast<const 基础信息节点类*>(视图.目标比较)))
            << " | 路径项=" << 统计.路径项数量
            << " | 已目标化=" << 统计.已目标化数量
            << " | 字段完整=" << 统计.字段完整数量
            << " | 草案数量=" << 统计.草案数量
            << " | 正式消息数量=" << 统计.正式消息数量
            << " | 正式消息字段完整=" << 统计.正式消息字段完整数量
            << " | 状态物化=" << 统计.状态物化数量
            << " | 缺父需求=" << 统计.缺父需求数量
            << " | 缺目标主体=" << 统计.缺目标主体数量
            << " | 缺目标特征=" << 统计.缺目标特征数量
            << " | 缺状态节点=" << 统计.缺状态节点数量
            << " | 直接写需求树=0"
            << " | 实际发送派生需求消息=0";
        记录筹办日志(输出.str());

        return 统计;
    }

    结构_因果路径查询壳统计 执行因果路径查询壳(
        ::自我类& 自我对象,
        const 任务节点* 任务头,
        const 需求节点* 来源需求,
        const 结构_需求生命周期上下文_筹办& 需求上下文,
        const 二次特征节点类* 目标比较,
        const 时间戳 now) noexcept
    {
        结构_因果路径查询壳统计 统计{};
        统计.已执行 = true;
        const auto 查询开始 = std::chrono::steady_clock::now();

        if (!目标比较) {
            记录筹办日志("因果路径筹办查询壳跳过 | 原因=缺目标比较"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                + " | 直接写需求树=0 | 生成派生需求消息=0");
            return 统计;
        }

        const auto 因果节点集 = 世界树.因果().枚举全部因果();
        结构_临时因果视图 视图{};
        视图.来源需求 = 来源需求;
        视图.目标比较 = 目标比较;
        视图.根分区 = 推导临时因果根分区_筹办查询(来源需求);

        std::string 首个命中因果键{};
        std::string 首个命中因果来源类型{};
        bool 首个命中因果已验证 = false;
        因果节点类* 首个命中因果节点 = nullptr;
        统计.因果节点数量 = 因果节点集.size();
        for (auto* 因果节点 : 因果节点集) {
            auto* 主信息 = 世界树.因果().取因果主信息(因果节点);
            if (!主信息) {
                continue;
            }
            ++统计.有主信息数量;
            if (主信息->是抽象因果()) {
                ++统计.抽象因果数量;
            } else if (主信息->是实例因果()) {
                ++统计.实例因果数量;
            } else {
                ++统计.未定义形态数量;
            }
            if (主信息->来源类型 == 枚举_因果来源类型::遗传) {
                ++统计.遗传因果数量;
            } else if (主信息->来源类型 == 枚举_因果来源类型::推断生成) {
                ++统计.推断生成因果数量;
            }
            if (主信息->已验证) {
                ++统计.后天验证因果数量;
            }

            if (!主信息->主果比较模板.有效()) {
                continue;
            }

            ++统计.主果模板声明数量;
            auto* 主果 = 解析二次特征引用_筹办查询(主信息->主果比较模板);
            if (!主果) {
                ++统计.主果不可解析数量;
                continue;
            }

            ++统计.主果可解析数量;
            const auto 主果方向比较 = 需求类::比较需求方向(主果, 目标比较);
            if (主果方向比较 == 需求类::枚举_需求方向比较结果::同向) {
                ++统计.主果同向命中数量;
                if (首个命中因果键.empty()) {
                    首个命中因果键 = 基础主键_筹办日志(因果节点);
                    首个命中因果来源类型 = 因果来源类型文本_筹办查询(主信息->来源类型);
                    首个命中因果已验证 = 主信息->已验证;
                    首个命中因果节点 = 因果节点;
                }
                吸收促成因果到临时视图_筹办查询(
                    自我对象,
                    视图,
                    因果节点,
                    *主信息,
                    now);
            } else if (主果方向比较 == 需求类::枚举_需求方向比较结果::反向) {
                ++统计.主果反向命中数量;
                if (首个命中因果键.empty()) {
                    首个命中因果键 = 基础主键_筹办日志(因果节点);
                    首个命中因果来源类型 = 因果来源类型文本_筹办查询(主信息->来源类型);
                    首个命中因果已验证 = 主信息->已验证;
                    首个命中因果节点 = 因果节点;
                }
                吸收避免因果到临时视图_筹办查询(
                    自我对象,
                    视图,
                    因果节点,
                    *主信息,
                    now);
            }
        }

        // 安全因果风险树由自我线程持有并按变化闸门维护；
        // 任务筹办只消费已有因果路径、方法条件和风险树缺口，不在查询壳内刷新树视图。

        确保临时视图学习缺口_筹办查询(
            自我对象,
            视图,
            now);

        std::ostringstream 输出;
        const auto 查询耗时 = std::chrono::duration_cast<std::chrono::milliseconds>(
            std::chrono::steady_clock::now() - 查询开始).count();
        输出 << "因果路径筹办查询壳统计"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 来源需求=" << 需求主键_筹办日志(来源需求)
            << " | 目标比较=" << 基础主键_筹办日志(
                const_cast<基础信息节点类*>(reinterpret_cast<const 基础信息节点类*>(目标比较)))
            << " | 因果节点=" << 统计.因果节点数量
            << " | 有主信息=" << 统计.有主信息数量
            << " | 抽象因果=" << 统计.抽象因果数量
            << " | 实例因果=" << 统计.实例因果数量
            << " | 未定义形态=" << 统计.未定义形态数量
            << " | 遗传因果=" << 统计.遗传因果数量
            << " | 推断生成因果=" << 统计.推断生成因果数量
            << " | 后天验证因果=" << 统计.后天验证因果数量
            << " | 主果模板声明=" << 统计.主果模板声明数量
            << " | 主果可解析=" << 统计.主果可解析数量
            << " | 主果不可解析=" << 统计.主果不可解析数量
            << " | 主果同向命中=" << 统计.主果同向命中数量
            << " | 主果反向命中=" << 统计.主果反向命中数量
            << " | 命中因果模板ID=" << (首个命中因果键.empty() ? std::string("空") : 首个命中因果键)
            << " | 命中因果来源类型=" << (首个命中因果来源类型.empty() ? std::string("未定义") : 首个命中因果来源类型)
            << " | 命中因果后天验证=" << (首个命中因果已验证 ? 1 : 0)
            << " | 耗时ms=" << 查询耗时
            << " | 直接写需求树=0"
            << " | 实际发送派生需求消息=0";
        记录筹办日志(输出.str());
        记录临时因果视图统计_筹办查询(任务头, 视图);
        (void)记录派生需求消息草案统计_筹办查询(
            任务头,
            视图,
            now,
            &统计.派生需求消息集);

        return 统计;
    }

    因果节点类* 查找安全因果风险树来源因果_筹办查询(
        const 二次特征节点类* 目标比较,
        std::size_t* 输出因果节点数量 = nullptr,
        std::size_t* 输出主果命中数量 = nullptr) noexcept
    {
        if (输出因果节点数量) {
            *输出因果节点数量 = 0;
        }
        if (输出主果命中数量) {
            *输出主果命中数量 = 0;
        }
        if (!目标比较) {
            return nullptr;
        }

        因果节点类* 首个命中 = nullptr;
        for (auto* 因果节点 : 世界树.因果().枚举全部因果()) {
            if (输出因果节点数量) {
                ++*输出因果节点数量;
            }
            auto* 主信息 = 世界树.因果().取因果主信息(因果节点);
            if (!主信息 || !主信息->主果比较模板.有效()) {
                continue;
            }
            auto* 主果 = 解析二次特征引用_筹办查询(主信息->主果比较模板);
            if (!主果) {
                continue;
            }
            const auto 方向比较 = 需求类::比较需求方向(主果, 目标比较);
            if (方向比较 != 需求类::枚举_需求方向比较结果::同向
                && 方向比较 != 需求类::枚举_需求方向比较结果::反向) {
                continue;
            }
            if (输出主果命中数量) {
                ++*输出主果命中数量;
            }
            if (主信息->来源类型 == 枚举_因果来源类型::遗传) {
                return 因果节点;
            }
            if (!首个命中) {
                首个命中 = 因果节点;
            }
        }
        return 首个命中;
    }

    结构_因果路径筹办入口壳结果 尝试准备因果路径筹办入口壳(
        ::自我类& 自我对象,
        const 任务节点* 任务头,
        const 结构_需求生命周期上下文_筹办& 需求上下文,
        const 时间戳 now) noexcept
    {
        结构_因果路径筹办入口壳结果 结果{};
        结果.已检查 = true;

        const auto* 来源需求 = 需求上下文.来源需求;
        if (!来源需求) {
            结果.拒绝原因 = "缺来源需求";
        } else if (!需求上下文.目标宿主) {
            结果.拒绝原因 = "缺目标宿主";
        } else if (!需求上下文.目标特征类型) {
            结果.拒绝原因 = "缺目标特征类型";
        } else if (!需求上下文.当前状态) {
            结果.拒绝原因 = "缺当前状态";
        } else if (!需求上下文.目标状态) {
            结果.拒绝原因 = "缺目标状态";
        } else {
            结果.目标表达完整 = true;
        }

        if (!结果.目标表达完整) {
            记录筹办日志("因果路径筹办入口跳过 | 原因=" + 结果.拒绝原因
                + " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                + " | 目标宿主=" + 基础主键_筹办日志(需求上下文.目标宿主)
                + " | 目标特征=" + 入口主键_筹办日志(需求上下文.目标特征类型)
                + " | 当前状态=" + 状态主键_筹办日志(需求上下文.当前状态)
                + " | 目标状态=" + 状态主键_筹办日志(需求上下文.目标状态)
                + " | 满足关系=" + std::to_string(static_cast<I64>(需求上下文.满足关系)));
            return 结果;
        }

        需求类 需求服务{};
        结果.目标比较 = 需求服务.获取需求方向(
            const_cast<需求节点*>(来源需求));
        结果.目标比较已构造 = 结果.目标比较 != nullptr;

        std::ostringstream 输出;
        输出 << "因果路径筹办入口准备"
            << " | 任务=" << 任务主键_筹办日志(任务头)
            << " | 来源需求=" << 需求主键_筹办日志(来源需求)
            << " | 目标宿主=" << 基础主键_筹办日志(需求上下文.目标宿主)
            << " | 目标特征=" << 入口主键_筹办日志(需求上下文.目标特征类型)
            << " | 当前状态=" << 状态主键_筹办日志(需求上下文.当前状态)
            << " | 目标状态=" << 状态主键_筹办日志(需求上下文.目标状态)
            << " | 满足关系=" << static_cast<I64>(需求上下文.满足关系)
            << " | 目标比较=" << 基础主键_筹办日志(
                reinterpret_cast<基础信息节点类*>(结果.目标比较))
            << " | 已构造=" << (结果.目标比较已构造 ? 1 : 0)
            << " | 本片只建立入口壳=1"
            << " | 直接写需求树=0"
            << " | 生成派生需求消息=0";
        记录筹办日志(输出.str());

        if (结果.目标比较已构造) {
            auto 查询统计 = 执行因果路径查询壳(
                自我对象,
                任务头,
                来源需求,
                需求上下文,
                结果.目标比较,
                now);
            结果.派生需求消息集 = std::move(查询统计.派生需求消息集);
            if (!结果.派生需求消息集.empty()) {
                记录筹办日志(
                    "因果路径筹办派生需求消息待上报"
                    " | 任务=" + 任务主键_筹办日志(任务头)
                    + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                    + " | 数量=" + std::to_string(结果.派生需求消息集.size())
                    + " | 直接写需求树=0"
                    + " | 实际发送派生需求消息=0");
            }
        }

        return 结果;
    }

    结构_因果路径筹办入口壳结果 筹办_按因果反推必要状态(
        ::自我类& 自我对象,
        const 任务节点* 任务头,
        const 结构_需求生命周期上下文_筹办& 需求上下文,
        const 时间戳 now) noexcept
    {
        auto 结果 = 尝试准备因果路径筹办入口壳(
            自我对象,
            任务头,
            需求上下文,
            now);
        记录筹办日志(
            "筹办_按因果反推必要状态"
            " | 任务=" + 任务主键_筹办日志(任务头)
            + " | 来源需求=" + 需求主键_筹办日志(需求上下文.来源需求)
            + " | 目标特征=" + 入口主键_筹办日志(需求上下文.目标特征类型)
            + " | 目标表达完整=" + std::to_string(结果.目标表达完整 ? 1 : 0)
            + " | 目标比较已构造=" + std::to_string(结果.目标比较已构造 ? 1 : 0)
            + " | 缺口报告数量=" + std::to_string(结果.派生需求消息集.size())
            + " | 直接写需求树=0"
            + " | 直接创建任务=0"
            + " | 直接结算价值=0");
        return 结果;
    }

    I64 方法自我能力值(const 方法节点* 方法) noexcept
    {
        if (!方法
            || 方法->主信息.首节点信息().动作句柄.类型 != 枚举_动作句柄类型::本能函数ID) {
            return 0;
        }
        const I64 能力值 = 方法->主信息.首节点信息().动作句柄.本能ID;
        return 本能方法类::是有效本能方法能力值(能力值) ? 能力值 : 0;
    }

    枚举_本能方法ID 方法本能ID(const 方法节点* 方法) noexcept
    {
        const I64 能力值 = 方法自我能力值(方法);
        return 能力值 != 0
            ? static_cast<枚举_本能方法ID>(能力值)
            : 枚举_本能方法ID::未定义;
    }

    inline constexpr I64 历史本能方法ID_任务筹办 = 6062;
    inline constexpr I64 历史本能方法ID_任务执行 = 6063;
    inline constexpr I64 历史本能方法ID_改变特征值 = 6058;
    inline constexpr I64 历史本能方法ID_增加可用方法数量 = 6049;

    I64 方法原始本能ID值(const 方法节点* 方法) noexcept
    {
        if (!方法
            || 方法->主信息.首节点信息().动作句柄.类型 != 枚举_动作句柄类型::本能函数ID
            || 方法->主信息.首节点信息().动作句柄.本能ID == 0) {
            return 0;
        }
        return 方法->主信息.首节点信息().动作句柄.本能ID;
    }

    bool 本能ID是当前默认自我本能(I64 本能ID) noexcept
    {
        if (本能ID <= 0
            || static_cast<unsigned long long>(本能ID) > (std::numeric_limits<std::uint32_t>::max)()) {
            return false;
        }
        return 本能方法类::是默认自我本能方法(
            static_cast<枚举_本能方法ID>(static_cast<std::uint32_t>(本能ID)));
    }

    bool 方法挂载非当前本能句柄(const 方法节点* 方法) noexcept
    {
        const I64 本能ID = 方法原始本能ID值(方法);
        return 本能ID != 0 && !本能ID是当前默认自我本能(本能ID);
    }

    bool 方法是本能方法(const 方法节点* 方法, 枚举_本能方法ID 本能ID) noexcept
    {
        return 方法本能ID(方法) == 本能ID;
    }

    bool 方法是结算叶子任务价值方法(const 方法节点* 方法) noexcept
    {
        return 方法是本能方法(方法, 枚举_本能方法ID::自我_结算叶子任务价值);
    }

    bool 方法是任务完成后处理方法(const 方法节点* 方法) noexcept
    {
        return 方法是结算叶子任务价值方法(方法);
    }

    bool 方法是专用提交入口方法(const 方法节点* 方法) noexcept
    {
        return 方法是本能方法(方法, 枚举_本能方法ID::提交_领取OR组结算令牌);
    }

    const 语素入口节点类* 特征_安全值_筹办() noexcept
    {
        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("安全值", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    const 语素入口节点类* 特征_服务值_筹办() noexcept
    {
        static const 语素入口节点类* s_词 = 语素集.添加信息入口词("服务值", 枚举_信息入口类型::特征模板入口);
        return s_词;
    }

    bool 任务目标是安全服务值(const 任务节点* 任务头) noexcept
    {
        const auto* 目标特征类型 = 任务对应需求目标特征类型(任务头);
        return 语素入口同一(目标特征类型, 特征_安全值_筹办())
            || 语素入口同一(目标特征类型, 特征_服务值_筹办());
    }

    bool 方法是运行时空占位方法头(const 方法节点* 方法) noexcept
    {
        if (!方法 || 方法->主信息.节点种类() != 枚举_方法节点种类::方法首节点) {
            return false;
        }
        const auto& 首信息 = 方法->主信息.首节点信息();
        return 首信息.来源 == 枚举_方法来源::运行时方法沉淀
            && 方法自我能力值(方法) == 0
            && !方法->主信息.有方法动作()
            && 私有_方法动作数量_执行桥_最小_v0(方法) <= 0
            && 私有_方法可执行入口数量_执行桥_最小_v0(方法) <= 0
            && 私有_方法条件节点数量_执行桥_最小_v0(方法) <= 0
            && 私有_方法条件结果对数量_执行桥_最小_v0(方法) <= 0;
    }

    bool 任务应跳过价值目标空占位方法(const 任务节点* 任务头, const 方法节点* 方法) noexcept
    {
        return 任务目标是安全服务值(任务头)
            && !方法是结算叶子任务价值方法(方法)
            && 方法是运行时空占位方法头(方法);
    }

    bool 结算叶子任务价值前提具备_筹办(const 任务节点* 任务头) noexcept
    {
        if (!任务头
            || 任务类::读取任务状态(任务头) != 枚举_任务状态::完成
            || !任务来源需求(任务头)
            || !任务类::解析任务结果状态摘要_兼容(任务头)) {
            return false;
        }

        const I64 安全权重 = 任务类::读取任务承接安全权重上限(任务头);
        const I64 服务权重 = 任务类::读取任务承接服务权重上限(任务头);
        const auto 异常哨兵 = (std::numeric_limits<I64>::max)();
        return (安全权重 > 0 && 安全权重 != 异常哨兵)
            || (服务权重 > 0 && 服务权重 != 异常哨兵);
    }

    bool 方法是学习补齐本能方法(const 方法节点* 方法) noexcept
    {
        const auto 本能ID = 方法本能ID(方法);
        return 本能ID == 枚举_本能方法ID::自我_尝试学习
            || 本能ID == 枚举_本能方法ID::自我_定向学习
            || 本能ID == 枚举_本能方法ID::自我_练习;
    }

    bool 方法是历史任务生命周期方法残留(const 方法节点* 方法) noexcept
    {
        // 任务筹办 / 任务执行已迁为任务管理生命周期普通函数；历史方法树中若残留
        // 6062 / 6063 方法头，也必须从任务候选集中排除。这里保留私有数值
        // 兼容历史数据，但不再把它们公开为当前本能方法枚举。
        const auto 本能ID = 方法原始本能ID值(方法);
        return 本能ID == 历史本能方法ID_任务筹办
            || 本能ID == 历史本能方法ID_任务执行;
    }

    bool 方法是筹办过程或协作本能方法(const 方法节点* 方法) noexcept
    {
        const auto 本能ID = 方法本能ID(方法);
        return 本能ID == 枚举_本能方法ID::自我_尝试学习
            || 本能ID == 枚举_本能方法ID::自我_定向学习
            || 本能ID == 枚举_本能方法ID::自我_练习;
    }

    bool 方法是先天特征写入逻辑(const 方法节点* 方法) noexcept
    {
        return 方法原始本能ID值(方法) == 历史本能方法ID_改变特征值;
    }

    bool 本能方法ID可作为可执行入口提交(I64 本能方法ID) noexcept
    {
        if (本能方法ID <= 0
            || static_cast<unsigned long long>(本能方法ID) > (std::numeric_limits<std::uint32_t>::max)()) {
            return false;
        }
        if (本能方法ID == 历史本能方法ID_改变特征值
            || 本能方法ID == 历史本能方法ID_增加可用方法数量
            || 本能方法ID == 历史本能方法ID_任务筹办
            || 本能方法ID == 历史本能方法ID_任务执行) {
            return false;
        }
        return 本能方法类::是默认自我本能方法(
            static_cast<枚举_本能方法ID>(static_cast<std::uint32_t>(本能方法ID)))
            && 私有_本能动作运行时已注册_执行桥_最小_v0(本能方法ID);
    }

    bool 本能方法ID可作为练习目标_筹办(I64 本能方法ID) noexcept
    {
        if (!本能方法ID可作为可执行入口提交(本能方法ID)) {
            return false;
        }

        switch (static_cast<枚举_本能方法ID>(static_cast<std::uint32_t>(本能方法ID))) {
        case 枚举_本能方法ID::自我_练习:
        case 枚举_本能方法ID::自我_尝试学习:
        case 枚举_本能方法ID::自我_定向学习:
        case 枚举_本能方法ID::自我_提交任务状态变化:
        case 枚举_本能方法ID::自我_回写需求满足:
        case 枚举_本能方法ID::自我_结算叶子任务价值:
        case 枚举_本能方法ID::自我_提交方法可执行入口:
        case 枚举_本能方法ID::自我_建立条件结果对:
        case 枚举_本能方法ID::自我_提交方法状态变化:
        case 枚举_本能方法ID::提交_确认观察存在事实:
        case 枚举_本能方法ID::提交_当前观察范围可观测单位存在对应事实:
        case 枚举_本能方法ID::提交_观察存在发现事实:
        case 枚举_本能方法ID::提交_观察存在特征值变化事实:
        case 枚举_本能方法ID::提交_指定存在跟踪事实:
        case 枚举_本能方法ID::提交_风险安全场景影响部分状态变化:
        case 枚举_本能方法ID::提交_安全因果因素无负证据默认满足:
        case 枚举_本能方法ID::提交_安全因果因素证据评估值:
        case 枚举_本能方法ID::提交_领取OR组结算令牌:
        case 枚举_本能方法ID::提交_确认内部世界子存在事实:
            return false;
        default:
            return true;
        }
    }

    bool 方法可作为练习目标_筹办(const 方法节点* 方法) noexcept
    {
        return 本能方法ID可作为练习目标_筹办(方法原始本能ID值(方法));
    }

    bool 方法动作状态已提交(方法节点* 方法, 时间戳 now) noexcept
    {
        if (!方法) {
            return false;
        }
        auto* 方法存在 = 方法->主信息.首节点信息().方法虚拟存在.指针
            ? 方法->主信息.首节点信息().方法虚拟存在.指针
            : 方法虚拟存在服务类::取或创建方法虚拟存在(方法, nullptr, now);
        I64 方法动作状态 = 0;
        return 方法存在
            && 世界树.读取特征_I64(
                reinterpret_cast<基础信息节点类*>(方法存在),
                私有_方法动作状态特征类型_执行桥_最小_v0(),
                方法动作状态)
            && 方法动作状态 == 1;
    }

    I64 已有单步本能入口待提交动作状态(方法节点* 方法, 时间戳 now) noexcept
    {
        const I64 本能方法ID = 方法自我能力值(方法);
        if (!本能方法ID可作为可执行入口提交(本能方法ID)
            || 方法动作状态已提交(方法, now)) {
            return 0;
        }
        return 本能方法ID;
    }

    bool 任务目标是方法结构补齐需求(const 任务节点* 任务头) noexcept
    {
        const auto* 目标特征类型 = 任务对应需求目标特征类型(任务头);
        return 语素入口同一(目标特征类型, 私有_方法状态特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法稳定状态特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法运行账完整性特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法动作状态特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法动作数量特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法可执行入口数量特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法条件节点数量特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法结果节点数量特征类型_执行桥_最小_v0())
            || 语素入口同一(目标特征类型, 私有_方法条件结果配对状态特征类型_执行桥_最小_v0());
    }

    方法节点* 按方法虚拟存在查找方法(
        自我类& 自我对象,
        基础信息节点类* 方法虚拟存在,
        时间戳 now) noexcept
    {
        auto* 自我存在 = 自我对象.确保自我存在();
        auto* 方法根节点 = 自我存在 ? 世界树.存在().获取方法根节点(自我存在) : nullptr;
        if (!方法根节点 || !方法根节点->子 || !方法虚拟存在) {
            return nullptr;
        }

        auto* 首节点 = static_cast<方法节点*>(方法根节点->子);
        auto* 当前 = 首节点;
        std::size_t 保护计数 = 0;
        do {
            if (当前 && 当前->主信息.节点种类() == 枚举_方法节点种类::方法首节点) {
                auto* 当前虚拟存在 = 当前->主信息.首节点信息().方法虚拟存在.指针
                    ? 当前->主信息.首节点信息().方法虚拟存在.指针
                    : 方法虚拟存在服务类::取或创建方法虚拟存在(当前, 自我存在, now);
                if (当前虚拟存在 == 方法虚拟存在
                    || (当前虚拟存在
                        && !当前虚拟存在->获取主键().empty()
                        && 当前虚拟存在->获取主键() == 方法虚拟存在->获取主键())) {
                    return 当前;
                }
            }
            当前 = static_cast<方法节点*>(当前->下);
            ++保护计数;
        } while (当前 && 当前 != 首节点 && 保护计数 < 4096);
        return nullptr;
    }

    方法节点* 按方法主键查找方法(
        自我类& 自我对象,
        const std::string& 方法主键) noexcept
    {
        if (方法主键.empty()) {
            return nullptr;
        }

        auto* 自我存在 = 自我对象.确保自我存在();
        auto* 方法根节点 = 自我存在 ? 世界树.存在().获取方法根节点(自我存在) : nullptr;
        if (!方法根节点) {
            return nullptr;
        }

        std::vector<方法节点*> 待访问{};
        std::vector<方法节点*> 已入栈{};

        const auto 已记录节点 = [&](const 方法节点* 节点) noexcept {
            for (const auto* 已记录 : 已入栈) {
                if (已记录 == 节点) {
                    return true;
                }
            }
            return false;
        };

        const auto 压入待访问 = [&](方法节点* 节点) noexcept {
            if (!节点 || 已记录节点(节点)) {
                return;
            }
            已入栈.push_back(节点);
            待访问.push_back(节点);
        };

        const auto 压入直接子链 = [&](方法节点* 父节点) noexcept {
            auto* 首子 = 父节点 ? static_cast<方法节点*>(父节点->子) : nullptr;
            if (!首子) {
                return;
            }

            auto* 当前子 = 首子;
            std::size_t 兄弟保护计数 = 0;
            do {
                压入待访问(当前子);
                当前子 = static_cast<方法节点*>(当前子->下);
                ++兄弟保护计数;
            } while (当前子 && 当前子 != 首子 && 兄弟保护计数 < 4096);

            if (兄弟保护计数 >= 4096) {
                记录筹办日志("按方法主键查找兄弟链达到保护上限"
                    " | 父方法=" + 方法主键_筹办日志(父节点)
                    + " | 目标方法主键=" + 方法主键);
            }
        };

        压入待访问(方法根节点);
        std::size_t 访问计数 = 0;
        constexpr std::size_t 访问保护上限 = 65536;
        while (!待访问.empty() && 访问计数 < 访问保护上限) {
            auto* 当前 = 待访问.back();
            待访问.pop_back();
            ++访问计数;

            if (当前
                && 当前->主信息.节点种类() == 枚举_方法节点种类::方法首节点
                && 当前->获取主键() == 方法主键) {
                return 当前;
            }

            压入直接子链(当前);
        }

        if (访问计数 >= 访问保护上限) {
            记录筹办日志("按方法主键查找达到保护上限"
                " | 目标方法主键=" + 方法主键);
        }
        return nullptr;
    }

    struct 结构_方法选择评分 {
        I64 直接满足等级 = 0;
        I64 结果命中精度 = 0;
        I64 禁止项惩罚 = 0;
        I64 风险惩罚 = 0;
        I64 前置冲突惩罚 = 0;
        I64 效率分 = 0;
        I64 耗时惩罚 = 0;
        I64 能耗惩罚 = 0;
        I64 资源惩罚 = 0;
        I64 副作用惩罚 = 0;
        I64 可补齐等级 = 0;
        I64 不确定性惩罚 = 0;
        I64 稳定性分 = 0;
        bool 有效 = false;
    };

    bool 方法选择评分更优(
        const 结构_方法选择评分& 左,
        const 结构_方法选择评分& 右) noexcept
    {
        if (左.有效 != 右.有效) return 左.有效;
        if (左.直接满足等级 != 右.直接满足等级) return 左.直接满足等级 > 右.直接满足等级;
        if (左.结果命中精度 != 右.结果命中精度) return 左.结果命中精度 > 右.结果命中精度;
        if (左.禁止项惩罚 != 右.禁止项惩罚) return 左.禁止项惩罚 < 右.禁止项惩罚;
        if (左.风险惩罚 != 右.风险惩罚) return 左.风险惩罚 < 右.风险惩罚;
        if (左.前置冲突惩罚 != 右.前置冲突惩罚) return 左.前置冲突惩罚 < 右.前置冲突惩罚;
        if (左.效率分 != 右.效率分) return 左.效率分 > 右.效率分;
        if (左.耗时惩罚 != 右.耗时惩罚) return 左.耗时惩罚 < 右.耗时惩罚;
        if (左.能耗惩罚 != 右.能耗惩罚) return 左.能耗惩罚 < 右.能耗惩罚;
        if (左.资源惩罚 != 右.资源惩罚) return 左.资源惩罚 < 右.资源惩罚;
        if (左.副作用惩罚 != 右.副作用惩罚) return 左.副作用惩罚 < 右.副作用惩罚;
        if (左.可补齐等级 != 右.可补齐等级) return 左.可补齐等级 > 右.可补齐等级;
        if (左.不确定性惩罚 != 右.不确定性惩罚) return 左.不确定性惩罚 < 右.不确定性惩罚;
        return 左.稳定性分 > 右.稳定性分;
    }

    bool 方法选择评分相同(
        const 结构_方法选择评分& 左,
        const 结构_方法选择评分& 右) noexcept
    {
        return !方法选择评分更优(左, 右)
            && !方法选择评分更优(右, 左);
    }

    std::string 方法选择评分文本(const 结构_方法选择评分& 评分)
    {
        std::ostringstream 输出;
        输出 << "命中=" << 评分.结果命中精度
            << ",直接=" << 评分.直接满足等级
            << ",禁=" << 评分.禁止项惩罚
            << ",险=" << 评分.风险惩罚
            << ",冲突=" << 评分.前置冲突惩罚
            << ",效率=" << 评分.效率分
            << ",耗时=" << 评分.耗时惩罚
            << ",能耗=" << 评分.能耗惩罚
            << ",资源=" << 评分.资源惩罚
            << ",副作用=" << 评分.副作用惩罚
            << ",可补=" << 评分.可补齐等级
            << ",不确定=" << 评分.不确定性惩罚
            << ",稳定=" << 评分.稳定性分;
        return 输出.str();
    }

    bool 方法结果项I64目标值(
        const 结构_方法结果项& 结果项,
        I64& 输出值) noexcept
    {
        输出值 = 0;
        const 特征值* 目标值 = 结果项.关系模板.有目标值
            ? &结果项.关系模板.目标值
            : &结果项.目标值;
        if (const auto* 标量 = std::get_if<I64>(目标值)) {
            输出值 = *标量;
            return true;
        }
        return false;
    }

    bool 方法结果项命中目标特征(
        const 结构_方法结果项& 结果项,
        const 语素入口节点类* 目标特征类型) noexcept;

    bool 方法结果项目标值适配需求(
        const 结构_方法结果项& 结果项,
        const 需求节点* 来源需求) noexcept
    {
        if (!结果项.关系模板.有目标值
            && std::holds_alternative<std::monostate>(结果项.目标值)) {
            return true;
        }
        if (!来源需求) {
            return false;
        }

        I64 结果目标值 = 0;
        I64 需求目标值 = 0;
        if (!方法结果项I64目标值(结果项, 结果目标值)
            || !状态节点I64值(来源需求->主信息.需求状态.指针, 需求目标值)) {
            return false;
        }

        const auto 满足关系 = 来源需求->主信息.满足关系 != 0
            ? 来源需求->主信息.满足关系
            : 关系_等于;
        return 三向关系被接受(
            比较量转三向关系(比较I64_三态(结果目标值, 需求目标值)),
            满足关系);
    }

    bool 方法结果项方向适配需求(
        const 结构_方法结果项& 结果项,
        const 需求节点* 来源需求) noexcept
    {
        const auto 允许方向 = 结果项.关系允许方向();
        if (允许方向 == 0) {
            return true;
        }
        if (!来源需求) {
            return false;
        }

        I64 当前值 = 0;
        I64 目标值 = 0;
        if (状态节点I64值(来源需求->主信息.被需求当前状态.指针, 当前值)
            && 状态节点I64值(来源需求->主信息.需求状态.指针, 目标值)) {
            return 比较量命中方向(
                比较I64_三态(目标值, 当前值),
                允许方向);
        }

        const auto 方向编码 = 需求目标方向编码(来源需求);
        if (方向编码 != 0) {
            return 比较量命中方向(方向编码, 允许方向);
        }

        return true;
    }

    bool 方法结果项承接任务需求(
        const 结构_方法结果项& 结果项,
        const 语素入口节点类* 目标特征类型,
        const 需求节点* 来源需求) noexcept
    {
        if (!方法结果项命中目标特征(结果项, 目标特征类型)) {
            return false;
        }
        return 方法结果项方向适配需求(结果项, 来源需求);
    }

    bool 方法结果能力命中任务需求(
        方法节点* 方法,
        const 任务节点* 任务头,
        const 语素入口节点类* 目标特征类型) noexcept
    {
        auto* 首信息 = 方法 && 方法->主信息.是否方法首节点()
            ? 方法->主信息.取首节点信息()
            : nullptr;
        if (!首信息 || !目标特征类型) {
            return false;
        }

        const auto* 来源需求 = 任务来源需求(任务头);
        for (const auto& 结果项 : 首信息->能力.结果包.结果项集) {
            if (方法结果项承接任务需求(结果项, 目标特征类型, 来源需求)) {
                return true;
            }
        }
        return false;
    }

    I64 方法结果项目标值一致分(
        const 结构_方法结果项& 结果项,
        const 需求节点* 来源需求) noexcept
    {
        if (!来源需求) {
            return 0;
        }

        I64 结果目标值 = 0;
        I64 需求目标值 = 0;
        if (!方法结果项I64目标值(结果项, 结果目标值)
            || !状态节点I64值(来源需求->主信息.需求状态.指针, 需求目标值)) {
            return 0;
        }

        const auto 比较量 = 比较I64_三态(结果目标值, 需求目标值);
        if (比较量 == 0) {
            return 100;
        }
        return 三向关系被接受(
            比较量转三向关系(比较量),
            来源需求->主信息.满足关系 != 0 ? 来源需求->主信息.满足关系 : 关系_等于)
            ? 60
            : -80;
    }

    I64 方法结果能力命中精度(
        方法节点* 方法,
        const 语素入口节点类* 目标特征类型,
        const 需求节点* 来源需求) noexcept
    {
        auto* 首信息 = 方法 && 方法->主信息.是否方法首节点()
            ? 方法->主信息.取首节点信息()
            : nullptr;
        if (!首信息 || !目标特征类型) {
            return 0;
        }

        I64 最佳精度 = 0;
        for (const auto& 结果项 : 首信息->能力.结果包.结果项集) {
            if (!方法结果项承接任务需求(结果项, 目标特征类型, 来源需求)) {
                continue;
            }

            if (!结果项.关系目标特征类型由参数决定()
                && 语素入口同一(结果项.关系目标特征类型(), 目标特征类型)) {
                // 固定结果特征类型最精确，优先级高于参数化“可改变任意特征”。
                最佳精度 = (std::max<I64>)(
                    最佳精度,
                    20 + 方法结果项目标值一致分(结果项, 来源需求));
            } else if (结果项.关系目标特征类型由参数决定()
                && 结果项.关系目标特征类型参数() != nullptr) {
                // 参数化结果能力可以承接任意目标特征，但精度低于固定命中。
                最佳精度 = (std::max<I64>)(
                    最佳精度,
                    10 + 方法结果项目标值一致分(结果项, 来源需求));
            }
        }
        return 最佳精度;
    }

    方法节点* 评分_读取任务输入目标方法_筹办(const 任务节点* 任务头) noexcept;
    方法节点* 任务方法结构补齐目标方法(
        自我类& 自我对象,
        const 任务节点* 任务头,
        时间戳 now) noexcept;

    结构_方法选择评分 方法候选评分(
        自我类& 自我对象,
        任务节点* 任务头,
        方法节点* 方法,
        时间戳 now) noexcept
    {
        结构_方法选择评分 评分{};
        if (!方法 || 方法->主信息.节点种类() != 枚举_方法节点种类::方法首节点) {
            return 评分;
        }

        const bool 有本能能力值 = 方法自我能力值(方法) != 0;
        const bool 有已注册本能入口 =
            私有_方法有已注册本能入口_执行桥_最小_v0(方法);
        const bool 有动作 =
            有本能能力值
            || 方法->主信息.有方法动作()
            || 私有_方法动作数量_执行桥_最小_v0(方法) > 0;
        const bool 有入口 =
            有已注册本能入口
            || 私有_方法可执行入口数量_执行桥_最小_v0(方法) > 0;
        const bool 有条件节点 = 私有_方法条件节点数量_执行桥_最小_v0(方法) > 0;
        const bool 有结果节点 = 私有_方法结果节点数量_执行桥_最小_v0(方法) > 0;
        const bool 有条件结果对 = 私有_方法条件结果对数量_执行桥_最小_v0(方法) > 0;
        const bool 是过程本能 = 方法是筹办过程或协作本能方法(方法);
        const bool 是学习本能 = 方法是学习补齐本能方法(方法);
        const bool 是结算叶子任务价值 = 方法是结算叶子任务价值方法(方法);
        const bool 结算前提具备 = !是结算叶子任务价值
            || 结算叶子任务价值前提具备_筹办(任务头);
        const bool 是方法结构任务 = 任务目标是方法结构补齐需求(任务头);
        const bool 是提交方法可执行入口 =
            方法是本能方法(方法, 枚举_本能方法ID::自我_提交方法可执行入口);
        const auto* 来源需求 = 任务来源需求(任务头);
        const auto* 目标特征类型 = 任务对应需求目标特征类型(任务头);

        if (方法是任务完成后处理方法(方法)) {
            评分.有效 = false;
            return 评分;
        }

        评分.有效 = true;

        评分.结果命中精度 = 方法结果能力命中精度(方法, 目标特征类型, 来源需求);
        const bool 结果可承接目标 = 评分.结果命中精度 > 0;

        // 第一层：所有可直接执行条件都满足且结果能力能承接目标的方法优先。
        // 这里先用结构可用性近似“必需条件全部满足”；具体输入参数仍在后续
        // 检查方法条件 / 配对参数阶段验证，不能在选择阶段提前提交事实。
        if (结果可承接目标 && !是过程本能 && 结算前提具备 && 有动作 && 有入口 && 有条件节点 && 有结果节点 && 有条件结果对) {
            评分.直接满足等级 = 300;
        } else if (结果可承接目标 && 是过程本能 && 有动作 && 有入口) {
            // 过程本能方法只说明“可以推进筹办过程”，不是最终状态提交者。
            // 因此它低于直接可执行方法，但高于普通不可用方法。
            评分.直接满足等级 = 100;
        } else if (结果可承接目标 && 结算前提具备 && 有动作 && 有入口) {
            评分.直接满足等级 = 20;
        } else if (结果可承接目标 && 结算前提具备 && 有动作) {
            评分.直接满足等级 = 10;
        }

        // 第二层到第四层的真实禁止项、风险、能耗以后应从方法条件节点、
        // 禁止结果、资源账读取。当前没有稳定字段时保持 0，避免臆造约束。
        评分.禁止项惩罚 = 0;
        评分.风险惩罚 = 0;
        评分.前置冲突惩罚 = 0;
        评分.耗时惩罚 = 0;
        评分.能耗惩罚 = 0;
        评分.资源惩罚 = 0;
        评分.副作用惩罚 = 0;

        // 效率和稳定性先用已有结构成熟度、条件结果对数量和本能入口作保守近似。
        评分.效率分 =
            方法->主信息.首节点信息().成熟度阶段 * 100
            + 私有_方法条件结果对数量_执行桥_最小_v0(方法) * 10
            + (有已注册本能入口 ? 50 : 0);
        评分.稳定性分 =
            方法->主信息.首节点信息().成熟度阶段 * 100
            + 私有_方法条件结果对数量_执行桥_最小_v0(方法) * 20;

        // 第五层：没有直接可执行方法时，再选能把条件变得可具备的方法。
        if (是方法结构任务 && 是学习本能) {
            评分.可补齐等级 = 900;
        } else if (是过程本能) {
            评分.可补齐等级 = 500;
        } else if (结算前提具备 && (有动作 || 有入口)) {
            评分.可补齐等级 = 100;
        }

        if (是结算叶子任务价值 && !结算前提具备) {
            评分.前置冲突惩罚 = 500;
        }
        if (是方法结构任务 && 是提交方法可执行入口) {
            auto* 被补方法 = 任务方法结构补齐目标方法(自我对象, 任务头, now);
            if (!被补方法) {
                被补方法 = 评分_读取任务输入目标方法_筹办(任务头);
            }
            const bool 被补方法已有入口能力 = 方法自我能力值(被补方法) != 0;
            if (!被补方法 || !被补方法已有入口能力) {
                评分.直接满足等级 = 0;
                评分.可补齐等级 = 0;
                评分.前置冲突惩罚 = (std::max<I64>)(评分.前置冲突惩罚, 500);
            }
        }

        评分.不确定性惩罚 = 0;
        return 评分;
    }

    方法节点* 从筹办候选集中选择当前方法(
        自我类& 自我对象,
        任务节点* 任务头,
        const std::vector<方法节点*>& 候选方法集,
        时间戳 now) noexcept
    {
        if (!任务头) {
            return nullptr;
        }

        if (候选方法集.empty()) {
            return nullptr;
        }

        auto* 已绑定方法 = reinterpret_cast<方法节点*>(任务类::读取任务执行方法(任务头));
        (void)已绑定方法;

        方法节点* 最佳方法 = nullptr;
        结构_方法选择评分 最佳评分{};
        for (auto* 方法 : 候选方法集) {
            // 旧数据残留的任务筹办 / 任务执行方法头只作兼容识别，不参与候选选择。
            if (方法是历史任务生命周期方法残留(方法)) {
                记录筹办日志("选择当前方法跳过任务生命周期方法残留"
                    " | 任务=" + 任务主键_筹办日志(任务头)
                    + " | 方法=" + 方法主键_筹办日志(方法));
                continue;
            }
            if (方法挂载非当前本能句柄(方法)) {
                记录筹办日志("选择当前方法跳过非当前默认本能方法残留"
                    " | 任务=" + 任务主键_筹办日志(任务头)
                    + " | 方法=" + 方法主键_筹办日志(方法)
                    + " | 本能ID=" + std::to_string(方法原始本能ID值(方法)));
                continue;
            }

            const auto 分数 = 方法候选评分(自我对象, 任务头, 方法, now);
            {
                std::ostringstream 输出;
                输出 << "选择当前方法候选评分"
                    << " | 任务=" << 任务主键_筹办日志(任务头)
                    << " | 方法=" << 方法主键_筹办日志(方法)
                    << " | 评分=" << 方法选择评分文本(分数);
                记录筹办日志(输出.str());
            }
            const bool 分数更优 = !最佳方法 || 方法选择评分更优(分数, 最佳评分);
            const bool 分数相同 =
                最佳方法
                && !方法选择评分更优(分数, 最佳评分)
                && !方法选择评分更优(最佳评分, 分数);
            const bool 主键更稳定 =
                分数相同
                && 方法
                && 方法->获取主键() < 最佳方法->获取主键();
            if (方法 && (分数更优 || 主键更稳定)) {
                最佳方法 = 方法;
                最佳评分 = 分数;
            }
        }
        if (最佳方法) {
            std::ostringstream 输出;
            输出 << "选择当前方法完成"
                << " | 任务=" << 任务主键_筹办日志(任务头)
                << " | 方法=" << 方法主键_筹办日志(最佳方法)
                << " | 评分=" << 方法选择评分文本(最佳评分);
            记录筹办日志(输出.str());
        }
        return 最佳方法;
    }

    方法节点* 任务方法结构补齐目标方法(
        自我类& 自我对象,
        const 任务节点* 任务头,
        时间戳 now) noexcept
    {
        if (!任务头 || !任务目标是方法结构补齐需求(任务头)) {
            return nullptr;
        }
        const auto* 来源需求 = 任务来源需求(任务头);

        // 迁移期兼容：学习需求由父任务筹办缺口派生时，兼容归因缓存中的
        // 来源方法主键仍是最精确的被补方法身份。后续应由来源回执 /
        // 动作动态 / 缺口二次特征链提供该身份。
        const auto 派生归因 =
            来源需求
                ? 需求类::读取派生归因兼容视图(来源需求->主信息)
                : 需求类::结构_需求派生归因兼容视图{};
        if (派生归因.有派生来源方法()) {
            if (auto* 方法 = 按方法主键查找方法(
                自我对象,
                派生归因.派生来源方法主键文本())) {
                记录筹办日志("方法结构补齐目标方法解析"
                    " | 来源=兼容派生来源方法主键"
                    " | 任务=" + 任务主键_筹办日志(任务头)
                    + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                    + " | 被补方法=" + 方法主键_筹办日志(方法));
                return 方法;
            }

            记录筹办日志("方法结构补齐目标方法主键未命中"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                + " | 兼容派生来源方法=" + 派生归因.派生来源方法主键文本());
        }

        if (来源需求 && 来源需求->主信息.被需求存在.指针) {
            auto* 目标主体 = reinterpret_cast<基础信息节点类*>(
                来源需求->主信息.被需求存在.指针);
            if (auto* 方法 = 按方法虚拟存在查找方法(自我对象, 目标主体, now)) {
                记录筹办日志("方法结构补齐目标方法解析"
                    " | 来源=被需求存在"
                    " | 任务=" + 任务主键_筹办日志(任务头)
                    + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                    + " | 被补方法=" + 方法主键_筹办日志(方法));
                return 方法;
            }
        }

        auto* 目标主体 = 来源需求 ? 状态节点主体(来源需求->主信息.需求状态.指针) : nullptr;
        if (!目标主体 && 来源需求) {
            目标主体 = 状态节点主体(来源需求->主信息.被需求当前状态.指针);
        }
        if (auto* 方法 = 按方法虚拟存在查找方法(自我对象, 目标主体, now)) {
            记录筹办日志("方法结构补齐目标方法解析"
                " | 来源=状态主体兜底"
                " | 任务=" + 任务主键_筹办日志(任务头)
                + " | 来源需求=" + 需求主键_筹办日志(来源需求)
                + " | 被补方法=" + 方法主键_筹办日志(方法));
            return 方法;
        }
        return nullptr;
    }

