        // 功能：按函数名执行对应处理。
        inline 基础信息节点类* 基础节点(基础信息节点类* 节点) noexcept
        {
            return 节点;
        }

        // 功能：把处理结果写入指定对象、场景或日志。
        inline bool 写入I64(
            基础信息节点类* 宿主,
            const 语素入口节点类* 特征类型,
            I64 值,
            时间戳 now) noexcept
        {
            return 宿主 && 特征类型 && 世界树.写入特征_I64(宿主, 特征类型, 值, now);
        }

        // 功能：把处理结果写入指定对象、场景或日志。
        inline bool 写入指针(
            基础信息节点类* 宿主,
            const 语素入口节点类* 特征类型,
            const void* 指针,
            时间戳 now) noexcept
        {
            return 宿主 && 特征类型 && 指针 && 世界树.写入特征_指针(宿主, 特征类型, 指针, now);
        }

        // 功能：从指定来源读取数据或状态。
        inline bool 读取I64(
            基础信息节点类* 宿主,
            const 语素入口节点类* 特征类型,
            I64& 输出值) noexcept
        {
            return 宿主 && 特征类型 && 世界树.读取特征_I64(宿主, 特征类型, 输出值);
        }

        inline constexpr I64 扫描空间位置最大允许误差毫米 = 300;

        // 功能：按函数名执行对应处理。
        inline I64 绝对差I64(I64 左, I64 右) noexcept
        {
            return 左 >= 右 ? 左 - 右 : 右 - 左;
        }

        // 功能：按函数名执行对应处理。
        inline I64 绝对差F64I64(double 左, I64 右) noexcept
        {
            const double 差 = 左 - static_cast<double>(右);
            return static_cast<I64>(差 >= 0.0 ? 差 : -差);
        }

        // 功能：按函数名执行对应处理。
        inline bool 外设空间中心有效(const 结构_外设空间中心& 中心) noexcept
        {
            return 中心.Z > 0 || 中心.X != 0 || 中心.Y != 0;
        }

        // 功能：按函数名执行对应处理。
        inline bool 外设空间范围有效(const 结构_外设空间范围AABB& 范围) noexcept
        {
            return 范围.最大X >= 范围.最小X
                && 范围.最大Y >= 范围.最小Y
                && 范围.最大Z >= 范围.最小Z
                && (范围.最大X > 范围.最小X
                    || 范围.最大Y > 范围.最小Y
                    || 范围.最大Z > 范围.最小Z);
        }

        // 功能：创建并返回或登记对应对象。
        inline 存在节点类* 取或创建运行存在(
            方法类::节点类* 方法首节点,
            场景节点类* 输出结果场景,
            时间戳 now) noexcept
        {
            auto* 方法存在 = 方法虚拟存在服务类::取或创建方法虚拟存在(方法首节点, nullptr, now);
            auto* 宿主 = 方法存在 ? 基础节点(方法存在) : 基础节点(输出结果场景);
            if (!宿主) return nullptr;

            auto* 运行存在 = 世界树.取或创建子存在_按类型并按特征I64(
                宿主,
                类型_扫描方法运行虚拟存在(),
                特征_运行ID(),
                static_cast<I64>(now));
            if (!运行存在) return nullptr;

            auto* 运行宿主 = 基础节点(运行存在);
            (void)写入I64(运行宿主, 特征_运行ID(), static_cast<I64>(now), now);
            (void)写入指针(运行宿主, 特征_当前场景引用(), 输出结果场景, now);
            (void)写入指针(运行宿主, 特征_输出结果场景(), 输出结果场景, now);
            return 运行存在;
        }

        // 功能：从指定来源读取数据或状态。
        inline std::optional<结构_外设观察报告队列项> 读取扫描报告(
            场景节点类* 输入参数场景,
            场景节点类* 输出结果场景,
            存在节点类* 运行存在) noexcept
        {
            I64 指定报告ID = 0;
            const bool 有指定报告 =
                读取I64(基础节点(输入参数场景), 特征_外设观察报告ID(), 指定报告ID)
                || 读取I64(基础节点(输出结果场景), 特征_外设观察报告ID(), 指定报告ID)
                || 读取I64(基础节点(运行存在), 特征_外设观察报告ID(), 指定报告ID);
            if (有指定报告 && 指定报告ID > 0) {
                return 读取外设观察报告_按ID(static_cast<std::uint64_t>(指定报告ID));
            }
            return 读取最新外设观察报告({}, 枚举_外设观察报告类型::扫描变化报告);
        }

        // 功能：计算权重、状态、差值或派生结果。
        inline I64 计算TTL毫秒(I64 当前时间毫秒, I64 有效截止时间毫秒) noexcept
        {
            return 有效截止时间毫秒 > 当前时间毫秒
                ? 有效截止时间毫秒 - 当前时间毫秒
                : 0;
        }

        // 功能：按函数名执行对应处理。
        inline 结构_外设特征材料 构造外设特征材料(
            const 结构_外设特征值条目& 项,
            const 结构_外设扫描提交包& 包)
        {
            结构_外设特征材料 材料{};
            材料.特征类型 = 项.特征类型;
            材料.值形态 = 项.值形态;
            材料.当前I64值 = 项.I64值;
            材料.当前F64值 = 项.F64值;
            材料.当前文本值 = 项.文本值;
            材料.特征值generation = 包.包头.generation;
            材料.来源材料句柄 = 项.来源材料;
            材料.可回查 = !材料.来源材料句柄.empty() || !包.包头.材料句柄集.empty();
            材料.可比较 = 项.可比较;
            return 材料;
        }

        // 功能：按函数名执行对应处理。
        inline std::vector<结构_已合法外设数据项> 展开已合法外设数据项(
            const 结构_外设观察报告队列项& 报告,
            const 结构_外设扫描提交包& 包)
        {
            std::vector<结构_已合法外设数据项> 队列{};
            std::uint64_t 序号 = 0;
            const auto 帧ID = 包.当前帧ID != 0 ? 包.当前帧ID : 报告.来源外设帧ID;
            const auto 采集时间毫秒 = 包.包头.采集时间毫秒 != 0
                ? 包.包头.采集时间毫秒
                : 报告.时间戳毫秒;

            auto 填充共同合同字段 = [&](结构_已合法外设数据项& 数据项) {
                数据项.来源报告ID = 包.包头.报告ID;
                数据项.来源帧ID = 帧ID;
                数据项.来源外设ID = 包.包头.外设ID;
                数据项.约束ID = 报告.目标观察约束ID;
                数据项.约束generation = 报告.约束generation;
                数据项.目标特征generation = 报告.目标特征generation;
                数据项.来源材料generation = 报告.来源材料generation;
                数据项.时间戳毫秒 = 采集时间毫秒;
                数据项.TTL毫秒 = 计算TTL毫秒(采集时间毫秒, 包.包头.有效截止时间毫秒);
                数据项.材料质量等级 = 报告.帧质量评分;
                数据项.外设材料可承接状态 = 报告.外设材料可承接状态;
                数据项.空间可用状态 = 报告.空间可用状态;
                数据项.可承接能力等级 = 报告.可承接能力等级;
                数据项.坐标系ID = 包.包头.坐标系ID.empty() ? 报告.坐标系版本 : 包.包头.坐标系ID;
                数据项.可回查 = !包.包头.材料句柄集.empty();
            };

            auto 追加特征项 = [&](
                const 结构_外设特征值条目& 项,
                枚举_扫描数据项类别 类别,
                bool 可生成变化候选) {
                结构_已合法外设数据项 数据项{};
                数据项.数据项ID = ++序号;
                填充共同合同字段(数据项);
                数据项.类别 = 类别;
                数据项.外设特征类型 = 项.特征类型;
                数据项.当前I64值 = 项.I64值;
                数据项.坐标系ID = 项.坐标系ID.empty() ? 数据项.坐标系ID : 项.坐标系ID;
                数据项.时间戳毫秒 = 项.时间戳毫秒 != 0 ? 项.时间戳毫秒 : 数据项.时间戳毫秒;
                数据项.TTL毫秒 = 计算TTL毫秒(数据项.时间戳毫秒, 包.包头.有效截止时间毫秒);
                数据项.特征材料集合.push_back(构造外设特征材料(项, 包));
                数据项.可回查 = 数据项.可回查 || 数据项.特征材料集合.front().可回查;
                数据项.可比较 = 项.可比较;
                数据项.可生成扫描变化候选 = 可生成变化候选;
                数据项.预置缺口 = 项.可比较
                    ? 枚举_扫描缺口类型::无
                    : 枚举_扫描缺口类型::数据项不可比较;
                数据项.缺口原因 = 项.可比较 ? "" : "外设特征材料不可比较";
                队列.push_back(std::move(数据项));
            };

            for (const auto& 项 : 包.当前特征值) {
                追加特征项(项, 枚举_扫描数据项类别::当前特征值, false);
            }
            for (const auto& 项 : 包.特征变化值) {
                追加特征项(项, 枚举_扫描数据项类别::特征变化值, true);
            }
            for (const auto& 项 : 包.已知存在结果) {
                结构_已合法外设数据项 数据项{};
                数据项.数据项ID = ++序号;
                填充共同合同字段(数据项);
                数据项.类别 = 枚举_扫描数据项类别::已知存在扫描结果;
                数据项.已确认存在ID = 项.已确认存在ID;
                数据项.当前中心 = 项.当前中心;
                数据项.当前空间范围 = 项.当前空间范围;
                数据项.空间中心有效 = 外设空间中心有效(项.当前中心);
                数据项.空间范围有效 = 外设空间范围有效(项.当前空间范围);
                数据项.可回查 =
                    数据项.可回查
                    || !项.当前ROI.empty()
                    || !项.当前掩码.empty()
                    || !项.当前点集.empty()
                    || !项.当前深度切片.empty();
                数据项.当前I64值 = static_cast<I64>(项.已确认存在ID);
                数据项.可比较 = 数据项.空间中心有效;
                数据项.可生成扫描变化候选 = true;
                数据项.预置缺口 = 数据项.空间中心有效
                    ? 枚举_扫描缺口类型::无
                    : 枚举_扫描缺口类型::缺空间位置;
                数据项.缺口原因 = 数据项.空间中心有效 ? "" : "外设当前数据项缺空间位置";
                队列.push_back(std::move(数据项));
            }
            return 队列;
        }

        // 功能：按函数名执行对应处理。
        inline bool 已合法外设数据项合同满足(const 结构_已合法外设数据项& 数据项) noexcept
        {
            if (数据项.数据项ID == 0) return false;
            if (数据项.来源报告ID == 0 || 数据项.来源帧ID == 0) return false;
            if (数据项.来源外设ID.empty()) return false;
            if (数据项.类别 == 枚举_扫描数据项类别::未定义) return false;
            if (数据项.坐标系ID.empty()) return false;
            if (数据项.时间戳毫秒 <= 0) return false;
            if (数据项.类别 != 枚举_扫描数据项类别::已知存在扫描结果
                && 数据项.特征材料集合.empty()) {
                return false;
            }
            if (数据项.类别 == 枚举_扫描数据项类别::已知存在扫描结果
                && !数据项.空间中心有效) {
                return false;
            }
            return true;
        }

#if 鱼巢_开关_启用扫描上游契约诊断
        inline void 记录扫描上游契约错误(
            const 结构_已合法外设数据项& 数据项,
            const char* 位置) noexcept
        {
            std::ostringstream 输出;
            输出 << "自我_扫描当前场景/上游契约错误"
                << " | 位置=" << (位置 ? 位置 : "")
                << " | 数据项ID=" << 数据项.数据项ID
                << " | 来源报告ID=" << 数据项.来源报告ID
                << " | 来源帧ID=" << 数据项.来源帧ID
                << " | 来源外设ID空=" << (数据项.来源外设ID.empty() ? 1 : 0)
                << " | 坐标系ID空=" << (数据项.坐标系ID.empty() ? 1 : 0)
                << " | 时间戳毫秒=" << 数据项.时间戳毫秒
                << " | 类别=" << static_cast<I64>(数据项.类别)
                << " | 特征材料数=" << 数据项.特征材料集合.size();
            const auto 文本 = 输出.str();
            项目运行错误日志(文本);
#if 鱼巢_开关_启用项目弹窗错误
            static std::atomic_bool 已弹窗{ false };
            if (!已弹窗.exchange(true, std::memory_order_acq_rel)) {
                项目弹窗错误提示("鱼巢 - 扫描上游契约错误", 文本);
            }
#endif
        }
#endif

        // 功能：判断条件、状态或业务结果是否成立。
        inline 结构_扫描判断结果 判断外设数据项可处理(
            const 结构_已合法外设数据项& 数据项) noexcept
        {
            if (!已合法外设数据项合同满足(数据项)) {
#if 鱼巢_开关_启用扫描上游契约诊断
                记录扫描上游契约错误(数据项, "判断外设数据项可处理");
#endif
                return { 枚举_扫描判断状态::条件不足, 0, "上游契约错误" };
            }
            if (数据项.来源报告ID == 0 || 数据项.来源帧ID == 0) {
                return { 枚举_扫描判断状态::条件不足, 0, "缺来源报告或来源帧" };
            }
            const bool 材料达到空间可比较 =
                数据项.外设材料可承接状态 > 0
                && 数据项.空间可用状态 > 0
                && static_cast<I64>(数据项.可承接能力等级) >= static_cast<I64>(枚举_外设材料能力等级::空间可用);
            if (!材料达到空间可比较) {
                return { 枚举_扫描判断状态::证据不足, 0, "外设材料质量未达到空间可比较" };
            }
            if (数据项.预置缺口 != 枚举_扫描缺口类型::无) {
                return { 枚举_扫描判断状态::证据不足, 0, 数据项.缺口原因 };
            }
            if (!数据项.可比较) {
                return { 枚举_扫描判断状态::证据不足, 0, 数据项.缺口原因 };
            }
            return { 枚举_扫描判断状态::成立, 1000000, "" };
        }

        // 功能：创建并返回或登记对应对象。
        inline 存在节点类* 取或创建记录节点(
            存在节点类* 运行存在,
            const 语素入口节点类* 类型,
            const 语素入口节点类* 键特征,
            I64 键值) noexcept
        {
            return 运行存在 && 类型 && 键特征
                ? 世界树.取或创建子存在_按类型并按特征I64(基础节点(运行存在), 类型, 键特征, 键值)
                : nullptr;
        }

        // 功能：记录日志、动态、证据或运行痕迹。
        inline void 记录缺口(
            存在节点类* 运行存在,
            I64 序号,
            枚举_扫描缺口类型 缺口类型,
            I64 目标宿主状态,
            I64 特征类型状态,
            I64 后续路径状态,
            时间戳 now) noexcept
        {
            auto* 缺口 = 取或创建记录节点(运行存在, 类型_扫描信息缺口(), 特征_缺口序号(), 序号);
            auto* 宿主 = 基础节点(缺口);
            (void)写入I64(宿主, 特征_缺口序号(), 序号, now);
            (void)写入I64(宿主, 特征_缺口类型(), static_cast<I64>(缺口类型), now);
            (void)写入I64(宿主, 特征_缺口目标宿主状态(), 目标宿主状态, now);
            (void)写入I64(宿主, 特征_缺口特征类型状态(), 特征类型状态, now);
            (void)写入I64(宿主, 特征_建议后续路径状态(), 后续路径状态, now);
        }

        // 功能：记录日志、动态、证据或运行痕迹。
        inline void 记录数据项处理(
            存在节点类* 运行存在,
            const 结构_已合法外设数据项& 数据项,
            const 结构_扫描判断结果& 判断,
            时间戳 now) noexcept
        {
            auto* 记录 = 取或创建记录节点(
                运行存在,
                类型_扫描数据项处理记录(),
                特征_数据项ID(),
                static_cast<I64>(数据项.数据项ID));
            auto* 宿主 = 基础节点(记录);
            (void)写入I64(宿主, 特征_数据项ID(), static_cast<I64>(数据项.数据项ID), now);
            (void)写入I64(宿主, 特征_数据项类别(), static_cast<I64>(数据项.类别), now);
            (void)写入I64(宿主, 特征_外设特征类型ID(), static_cast<I64>(数据项.外设特征类型), now);
            (void)写入I64(宿主, 特征_已确认存在ID(), static_cast<I64>(数据项.已确认存在ID), now);
            (void)写入I64(宿主, 特征_外设观察报告ID(), static_cast<I64>(数据项.来源报告ID), now);
            (void)写入I64(宿主, 特征_来源帧ID(), static_cast<I64>(数据项.来源帧ID), now);
            (void)写入I64(宿主, 特征_处理闭合证据状态(), static_cast<I64>(判断.状态), now);
        }

        // 功能：记录日志、动态、证据或运行痕迹。
        inline void 记录关注存在(
            存在节点类* 运行存在,
            I64 序号,
            存在节点类* 目标存在,
            枚举_扫描关注集合类别 集合类别,
            枚举_扫描关注原因状态 原因状态,
            时间戳 now) noexcept
        {
            auto* 记录 = 取或创建记录节点(
                运行存在,
                类型_扫描关注存在记录(),
                特征_关注记录序号(),
                序号);
            auto* 宿主 = 基础节点(记录);
            (void)写入I64(宿主, 特征_关注记录序号(), 序号, now);
            (void)写入指针(宿主, 特征_关注存在指针(), 目标存在, now);
            (void)写入I64(宿主, 特征_关注集合类别(), static_cast<I64>(集合类别), now);
            (void)写入I64(宿主, 特征_关注原因状态(), static_cast<I64>(原因状态), now);
        }

        // 功能：根据当前输入生成目标数据、场景、动态或回执。
        inline 结构_扫描关注集合 生成本轮扫描关注集合(
            场景节点类* 当前场景,
            存在节点类* 运行存在,
            I64& 缺口数量,
            时间戳 now) noexcept
        {
            结构_扫描关注集合 关注集合{};
            if (!当前场景) {
                return 关注集合;
            }

            I64 记录序号 = 0;
            const auto 子存在集合 = 世界树.获取子存在(基础节点(当前场景));
            for (auto* 当前存在 : 子存在集合) {
                if (!当前存在) continue;

                Vector3D 坐标{};
                const bool 空间位置可读 = 世界树.读取存在场景绝对坐标(当前存在, 坐标);
                if (!空间位置可读) {
                    关注集合.需补条件存在集合.push_back(当前存在);
                    记录关注存在(
                        运行存在,
                        ++记录序号,
                        当前存在,
                        枚举_扫描关注集合类别::本轮需补条件,
                        枚举_扫描关注原因状态::缺空间位置,
                        now);
                    ++缺口数量;
                    记录缺口(
                        运行存在,
                        缺口数量,
                        枚举_扫描缺口类型::缺空间位置,
                        1,
                        1,
                        2,
                        now);
                    continue;
                }

                关注集合.应覆盖存在集合.push_back(当前存在);
                记录关注存在(
                    运行存在,
                    ++记录序号,
                    当前存在,
                    枚举_扫描关注集合类别::本轮应覆盖,
                    枚举_扫描关注原因状态::可进入本轮扫描,
                    now);
            }

            return 关注集合;
        }

        // 功能：判断条件、状态或业务结果是否成立。
        inline 结构_扫描对应结果 判断外设数据项对应关系(
            const 结构_已合法外设数据项& 数据项,
            const 结构_扫描关注集合& 关注集合) noexcept
        {
            结构_扫描对应结果 结果{};
            if (数据项.类别 != 枚举_扫描数据项类别::已知存在扫描结果
                || !数据项.空间中心有效) {
                结果.状态 = 枚举_扫描判断状态::条件不足;
                return 结果;
            }

            I64 最小误差 = 0;
            for (auto* 候选 : 关注集合.应覆盖存在集合) {
                if (!候选) continue;
                Vector3D 内部坐标{};
                if (!世界树.读取存在场景绝对坐标(候选, 内部坐标)) continue;

                const I64 误差 =
                    绝对差F64I64(内部坐标.x, 数据项.当前中心.X)
                    + 绝对差F64I64(内部坐标.y, 数据项.当前中心.Y)
                    + 绝对差F64I64(内部坐标.z, 数据项.当前中心.Z);
                if (误差 > 扫描空间位置最大允许误差毫米) continue;

                ++结果.候选数量;
                if (!结果.目标存在 || 误差 < 最小误差) {
                    结果.目标存在 = 候选;
                    最小误差 = 误差;
                }
            }

            结果.空间位置误差值 = 最小误差;
            if (结果.候选数量 == 1 && 结果.目标存在) {
                结果.状态 = 枚举_扫描判断状态::成立;
            } else if (结果.候选数量 > 1) {
                结果.状态 = 枚举_扫描判断状态::冲突;
            } else {
                结果.状态 = 枚举_扫描判断状态::不成立;
            }
            return 结果;
        }

        // 功能：记录日志、动态、证据或运行痕迹。
        inline void 记录覆盖索引(
            存在节点类* 运行存在,
            I64 序号,
            const 结构_已合法外设数据项& 数据项,
            const 结构_扫描对应结果& 对应结果,
            时间戳 now) noexcept
        {
            auto* 记录 = 取或创建记录节点(
                运行存在,
                类型_扫描覆盖索引记录(),
                特征_覆盖记录序号(),
                序号);
            auto* 宿主 = 基础节点(记录);
            (void)写入I64(宿主, 特征_覆盖记录序号(), 序号, now);
            (void)写入I64(宿主, 特征_覆盖数据项ID(), static_cast<I64>(数据项.数据项ID), now);
            (void)写入指针(宿主, 特征_覆盖目标存在指针(), 对应结果.目标存在, now);
            (void)写入I64(宿主, 特征_覆盖判断状态(), static_cast<I64>(对应结果.状态), now);
            (void)写入I64(宿主, 特征_覆盖候选数量(), 对应结果.候选数量, now);
            (void)写入I64(宿主, 特征_空间位置误差值(), 对应结果.空间位置误差值, now);
        }

        // 功能：按函数名执行对应处理。
        inline bool 语素入口主键相同(
            const 语素入口节点类* 左,
            const 语素入口节点类* 右) noexcept
        {
            if (左 == 右) return true;
            if (!左 || !右) return false;
            const auto 左主键 = 左->获取主键();
            const auto 右主键 = 右->获取主键();
            return !左主键.empty() && 左主键 == 右主键;
        }

        // 功能：确保目标结构、状态或前置条件存在并可用。
        inline bool 确保方法结果能力I64(
            方法类::节点类* 方法首节点,
            const 语素入口节点类* 目标特征类型,
            I64 目标值,
            枚举_结果变化方向 方向 = 枚举_结果变化方向::已形成) noexcept
        {
            auto* 首信息 = 方法首节点 && 方法首节点->主信息.是否方法首节点()
                ? 方法首节点->主信息.取首节点信息()
                : nullptr;
            if (!首信息 || !目标特征类型) {
                return false;
            }

            首信息->能力.可被方法查找命中 = true;
            首信息->能力.是否根写入原语 = false;

            for (const auto& 结果项 : 首信息->能力.结果包.结果项集) {
                if (结果项.关系目标特征类型由参数决定()
                    || !语素入口主键相同(结果项.关系目标特征类型(), 目标特征类型)) {
                    continue;
                }

                const auto* 已有目标值 = 结果项.关系模板.有目标值
                    ? &结果项.关系模板.目标值
                    : nullptr;
                if (const auto* 已有I64 = 已有目标值 ? std::get_if<I64>(已有目标值) : nullptr;
                    已有I64 && *已有I64 == 目标值) {
                    return true;
                }
            }

            结构_方法结果项 结果项{};
            结果项.关系模板.目标特征类型 = 目标特征类型;
            结果项.关系模板.允许方向 = 方法结果变化方向允许方向(方向);
            结果项.关系模板.有目标值 = true;
            结果项.关系模板.目标值 = 特征值{ 目标值 };
            首信息->能力.结果包.结果项集.push_back(std::move(结果项));
            return true;
        }

        // 功能：记录日志、动态、证据或运行痕迹。
        inline const 语素入口节点类* 方法动作名(方法类::节点类* 方法首节点) noexcept
        {
            auto* 首信息 = 方法首节点 && 方法首节点->主信息.是否方法首节点()
                ? 方法首节点->主信息.取首节点信息()
                : nullptr;
            return 首信息 ? 首信息->动作名 : nullptr;
        }

        // 功能：创建并返回或登记对应对象。
        inline 状态节点类* 创建扫描I64状态(
            场景节点类* 场景,
            基础信息节点类* 主体,
            const 语素入口节点类* 特征类型,
            I64 值,
            bool 是否变化,
            时间戳 now) noexcept
        {
            auto* 特征 = 主体 && 特征类型
                ? 世界树.取或创建子特征_按类型(主体, 特征类型)
                : nullptr;
            if (!场景 || !主体 || !特征) {
                return nullptr;
            }
            return 世界树.创建内部状态(
                场景,
                主体,
                特征,
                特征值{ 值 },
                是否变化,
                now);
        }

        // 功能：创建并返回或登记对应对象。
        inline 状态节点类* 写入扫描输出I64状态(
            场景节点类* 输出结果场景,
            基础信息节点类* 宿主,
            const 语素入口节点类* 特征类型,
            I64 值,
            时间戳 now) noexcept
        {
            if (!宿主 || !特征类型) {
                return nullptr;
            }
            (void)写入I64(宿主, 特征类型, 值, now);
            if (!输出结果场景) {
                return nullptr;
            }
            return 创建扫描I64状态(
                输出结果场景,
                宿主,
                特征类型,
                值,
                true,
                now);
        }

        // 功能：创建扫描方法造成的 I64 子特征状态变化动态，并同步生成可查询因果信息。
        inline 动态节点类* 创建扫描I64子特征动作动态(
            方法类::节点类* 方法首节点,
            场景节点类* 输入参数场景,
            场景节点类* 输出结果场景,
            基础信息节点类* 目标宿主,
            const 语素入口节点类* 目标特征类型,
            I64 初始值,
            I64 结果值,
            时间戳 now,
            因果模板节点类** 输出因果信息 = nullptr,
            bool* 输出因果信息已生成 = nullptr) noexcept
        {
            if (输出因果信息) {
                *输出因果信息 = nullptr;
            }
            if (输出因果信息已生成) {
                *输出因果信息已生成 = false;
            }
            auto* 动态场景 = 输出结果场景 ? 输出结果场景 : 输入参数场景;
            auto* 变化特征 = 目标宿主
                ? 世界树.取或创建子特征_按类型(目标宿主, 目标特征类型)
                : nullptr;
            if (!方法首节点 || !动态场景 || !目标宿主 || !变化特征 || !目标特征类型) {
                return nullptr;
            }

            auto* 初始状态 = 世界树.创建内部状态(
                动态场景,
                目标宿主,
                变化特征,
                特征值{ 初始值 },
                false,
                now);
            auto* 结果状态 = 世界树.创建内部状态(
                动态场景,
                目标宿主,
                变化特征,
                特征值{ 结果值 },
                true,
                now);
            auto* 动态 = 世界树.创建方法动作动态(
                动态场景,
                目标宿主,
                变化特征,
                reinterpret_cast<方法节点类*>(方法首节点),
                方法动作名(方法首节点),
                now,
                now,
                true,
                0,
                输入参数场景,
                输出结果场景,
                初始状态,
                结果状态);
            if (!动态) {
                return nullptr;
            }

            auto* 因果信息 = 世界树.因果().生成因果信息(
                动态场景,
                动态,
                目标宿主,
                reinterpret_cast<基础信息节点类*>(变化特征),
                {},
                true);
            if (输出因果信息) {
                *输出因果信息 = 因果信息;
            }
            if (输出因果信息已生成) {
                *输出因果信息已生成 = 因果信息 != nullptr;
            }
            return 动态;
        }

        // 功能：记录日志、动态、证据或运行痕迹。
        inline 动态节点类* 创建扫描空间位置变化动作动态(
            方法类::节点类* 方法首节点,
            场景节点类* 输入参数场景,
            场景节点类* 输出结果场景,
            存在节点类* 目标存在,
            I64 变化量,
            时间戳 now,
            因果模板节点类** 输出因果信息 = nullptr,
            bool* 输出因果信息已生成 = nullptr) noexcept
        {
            if (变化量 <= 0) {
                if (输出因果信息) {
                    *输出因果信息 = nullptr;
                }
                if (输出因果信息已生成) {
                    *输出因果信息已生成 = false;
                }
                return nullptr;
            }
            return 创建扫描I64子特征动作动态(
                方法首节点,
                输入参数场景,
                输出结果场景,
                基础节点(目标存在),
                特征_扫描空间位置变化量(),
                0,
                变化量,
                now,
                输出因果信息,
                输出因果信息已生成);
        }

        // 功能：把处理结果写入指定对象、场景或日志。
        inline 结构_扫描写入结果 写入场景当前特征值_空间位置(
            方法类::节点类* 方法首节点,
            场景节点类* 输入参数场景,
            场景节点类* 输出结果场景,
            存在节点类* 运行存在,
            I64 摘要序号,
            存在节点类* 目标存在,
            const 结构_已合法外设数据项& 数据项,
            时间戳 now) noexcept
        {
            结构_扫描写入结果 结果{};
            Vector3D 旧坐标{};
            const bool 旧值可读 = 世界树.读取存在场景绝对坐标(目标存在, 旧坐标);
            const Vector3D 新坐标{
                static_cast<double>(数据项.当前中心.X),
                static_cast<double>(数据项.当前中心.Y),
                static_cast<double>(数据项.当前中心.Z)
            };
            I64 变化量 = 0;
            if (旧值可读) {
                变化量 =
                    绝对差F64I64(旧坐标.x, 数据项.当前中心.X)
                    + 绝对差F64I64(旧坐标.y, 数据项.当前中心.Y)
                    + 绝对差F64I64(旧坐标.z, 数据项.当前中心.Z);
            }
            const bool 写入成功 =
                目标存在
                && 数据项.空间中心有效
                && 世界树.写入存在场景绝对坐标(目标存在, 新坐标, now, 10000);
            结果.写入成功 = 写入成功;
            结果.旧值可读 = 旧值可读;
            结果.首次建立基准 = 写入成功 && !旧值可读;
            结果.状态变化成立 = 写入成功 && 旧值可读 && 变化量 > 扫描空间位置最大允许误差毫米;
            结果.空间位置变化量 = 变化量;

            auto* 摘要 = 取或创建记录节点(
                运行存在,
                类型_扫描场景写入摘要记录(),
                特征_写入摘要序号(),
                摘要序号);
            auto* 宿主 = 基础节点(摘要);
            (void)写入I64(宿主, 特征_写入摘要序号(), 摘要序号, now);
            (void)写入指针(宿主, 特征_写入目标存在指针(), 目标存在, now);
            (void)写入I64(宿主, 特征_写入目标特征类型状态(), static_cast<I64>(枚举_扫描当前状态特征类型::空间位置), now);
            (void)写入I64(宿主, 特征_写入来源数据项ID(), static_cast<I64>(数据项.数据项ID), now);
            (void)写入I64(宿主, 特征_写入结果状态(), 写入成功 ? 1 : 0, now);
            (void)写入I64(宿主, 特征_写入旧值状态(), 旧值可读 ? 1 : 0, now);
            (void)写入I64(宿主, 特征_空间位置误差值(), 变化量, now);
            if (旧值可读) {
                (void)写入I64(宿主, 特征_写入旧空间位置X(), static_cast<I64>(旧坐标.x), now);
                (void)写入I64(宿主, 特征_写入旧空间位置Y(), static_cast<I64>(旧坐标.y), now);
                (void)写入I64(宿主, 特征_写入旧空间位置Z(), static_cast<I64>(旧坐标.z), now);
            }
            (void)写入I64(宿主, 特征_写入新空间位置X(), 数据项.当前中心.X, now);
            (void)写入I64(宿主, 特征_写入新空间位置Y(), 数据项.当前中心.Y, now);
            (void)写入I64(宿主, 特征_写入新空间位置Z(), 数据项.当前中心.Z, now);
            if (结果.状态变化成立) {
                结果.状态变化动态 = 创建扫描空间位置变化动作动态(
                    方法首节点,
                    输入参数场景,
                    输出结果场景,
                    目标存在,
                    变化量,
                    now,
                    &结果.主动因果信息,
                    &结果.主动因果信息已生成);
                (void)写入指针(宿主, 特征_动作动态指针(), 结果.状态变化动态, now);
                (void)写入I64(宿主, 特征_扫描主动因果信息状态(), 结果.主动因果信息已生成 ? 1 : 0, now);
            }
            return 结果;
        }

        // 功能：按函数名执行对应处理。
        inline bool 指针集合包含(const std::vector<存在节点类*>& 集合, const 存在节点类* 目标) noexcept
        {
            return 目标 && std::find(集合.begin(), 集合.end(), 目标) != 集合.end();
        }

        // 功能：记录日志、动态、证据或运行痕迹。
        inline void 记录未覆盖解释(
            存在节点类* 运行存在,
            I64 序号,
            存在节点类* 目标存在,
            枚举_扫描未覆盖解释状态 解释状态,
            时间戳 now) noexcept
        {
            auto* 记录 = 取或创建记录节点(
                运行存在,
                类型_扫描未覆盖解释记录(),
                特征_未覆盖记录序号(),
                序号);
            auto* 宿主 = 基础节点(记录);
            (void)写入I64(宿主, 特征_未覆盖记录序号(), 序号, now);
            (void)写入指针(宿主, 特征_未覆盖目标存在指针(), 目标存在, now);
            (void)写入I64(宿主, 特征_未覆盖解释状态(), static_cast<I64>(解释状态), now);
        }

        // 功能：同步线程、任务、场景或对象之间的状态。
        inline void 同步扫描输出结果场景(
            场景节点类* 输出结果场景,
            存在节点类* 运行存在,
            动态节点类* 动作动态,
            枚举_扫描治理输出状态 输出状态,
            枚举_扫描场景维护结果 维护状态,
            I64 外设数据项总数,
            I64 已闭合计数,
            I64 缺口数量,
            I64 写入摘要数量,
            I64 临时证据数量,
            I64 覆盖冲突数量,
            I64 本轮异常未覆盖存在数量,
            I64 消失候选数量,
            I64 扫描入账状态,
            I64 外设扫描结果场景状态,
            I64 当前场景扫描组合状态,
            I64 状态变化动作动态数量,
            I64 主动因果信息数量,
            时间戳 now) noexcept
        {
            auto* 输出宿主 = 基础节点(输出结果场景);
            if (!输出宿主) return;

            const I64 处理已闭合 = 已闭合计数 == 外设数据项总数 ? 1 : 0;
            (void)写入指针(输出宿主, 特征_扫描运行存在指针(), 运行存在, now);
            (void)写入指针(输出宿主, 特征_动作动态指针(), 动作动态, now);
            (void)写入I64(输出宿主, 特征_动作动态创建状态(), 动作动态 ? 1 : 0, now);
            (void)写入I64(输出宿主, 特征_扫描治理输出状态(), static_cast<I64>(输出状态), now);
            (void)写入I64(输出宿主, 特征_场景维护结果状态(), static_cast<I64>(维护状态), now);
            (void)写入I64(输出宿主, 特征_状态信息集合(), 输出状态 == 枚举_扫描治理输出状态::状态信息 ? 1 : 0, now);
            (void)写入I64(输出宿主, 特征_信息缺口集合(), 缺口数量 > 0 ? 1 : 0, now);
            (void)写入I64(输出宿主, 特征_空信息状态(), 输出状态 == 枚举_扫描治理输出状态::空信息 ? 1 : 0, now);
            (void)写入I64(输出宿主, 特征_场景写入摘要集合(), 写入摘要数量 > 0 ? 1 : 0, now);
            (void)写入I64(输出宿主, 特征_临时证据集合(), 临时证据数量 > 0 ? 1 : 0, now);
            (void)写入I64(输出宿主, 特征_处理闭合证据状态(), 处理已闭合, now);
            (void)写入I64(输出宿主, 特征_外设数据项总数(), 外设数据项总数, now);
            (void)写入I64(输出宿主, 特征_已闭合处理数据项计数(), 已闭合计数, now);
            (void)写入I64(输出宿主, 特征_信息缺口数量(), 缺口数量, now);
            (void)写入I64(输出宿主, 特征_场景写入摘要数量(), 写入摘要数量, now);
            (void)写入I64(输出宿主, 特征_临时证据数量(), 临时证据数量, now);
            (void)写入I64(输出宿主, 特征_覆盖冲突数量(), 覆盖冲突数量, now);
            (void)写入I64(输出宿主, 特征_本轮异常未覆盖存在数量(), 本轮异常未覆盖存在数量, now);
            (void)写入I64(输出宿主, 特征_消失候选数量(), 消失候选数量, now);
            (void)写入I64(输出宿主, 特征_需求来源状态(), 缺口数量 > 0 ? 1 : 0, now);
            (void)写入I64(输出宿主, 特征_后续承接入口状态(), 缺口数量 > 0 ? 2 : 1, now);
            (void)写入扫描输出I64状态(输出结果场景, 输出宿主, 特征_已识别区域扫描入账状态(), 扫描入账状态, now);
            (void)写入扫描输出I64状态(输出结果场景, 输出宿主, 特征_外设扫描结果场景状态(), 外设扫描结果场景状态, now);
            (void)写入扫描输出I64状态(输出结果场景, 输出宿主, 特征_当前场景扫描组合状态(), 当前场景扫描组合状态, now);
            (void)写入I64(输出宿主, 特征_扫描状态变化动作动态数量(), 状态变化动作动态数量, now);
            (void)写入I64(输出宿主, 特征_扫描主动因果信息数量(), 主动因果信息数量, now);
            (void)写入I64(输出宿主, 特征_扫描主动因果信息状态(), 主动因果信息数量 > 0 ? 1 : 0, now);
            (void)写入I64(输出宿主, 特征_输出场景同步状态(), 1, now);
        }

        // 功能：创建并返回或登记对应对象。
        inline 动态节点类* 创建扫描闭合动作动态(
            方法类::节点类* 方法首节点,
            场景节点类* 输入参数场景,
            场景节点类* 输出结果场景,
            存在节点类* 运行存在,
            const std::vector<动态节点类*>& 来源低层动态集合,
            时间戳 now,
            因果模板节点类** 输出因果信息 = nullptr,
            bool* 输出因果信息已生成 = nullptr) noexcept
        {
            if (输出因果信息) {
                *输出因果信息 = nullptr;
            }
            if (输出因果信息已生成) {
                *输出因果信息已生成 = false;
            }
            auto* 动态场景 = 输出结果场景 ? 输出结果场景 : 输入参数场景;
            auto* 运行宿主 = 基础节点(运行存在);
            auto* 闭合特征 = 运行宿主
                ? 世界树.取或创建子特征_按类型(运行宿主, 特征_当前场景扫描组合状态())
                : nullptr;
            if (!方法首节点 || !动态场景 || !运行宿主 || !闭合特征) {
                return nullptr;
            }

            auto* 初始状态 = 世界树.创建内部状态(
                动态场景,
                运行宿主,
                闭合特征,
                特征值{ 0 },
                false,
                now);
            auto* 结果状态 = 世界树.创建内部状态(
                动态场景,
                运行宿主,
                闭合特征,
                特征值{ 1 },
                true,
                now);
            auto* 动态 = 世界树.创建方法动作动态(
                动态场景,
                运行宿主,
                闭合特征,
                reinterpret_cast<方法节点类*>(方法首节点),
                方法动作名(方法首节点),
                now,
                now,
                true,
                0,
                输入参数场景,
                输出结果场景,
                初始状态,
                结果状态);
            if (!动态) {
                return nullptr;
            }
            for (auto* 来源动态 : 来源低层动态集合) {
                (void)世界树.追加来源低层动态(动态, 来源动态);
            }
            auto* 因果信息 = 世界树.因果().生成因果信息(
                动态场景,
                动态,
                运行宿主,
                reinterpret_cast<基础信息节点类*>(闭合特征),
                {},
                true);
            if (输出因果信息) {
                *输出因果信息 = 因果信息;
            }
            if (输出因果信息已生成) {
                *输出因果信息已生成 = 因果信息 != nullptr;
            }
            return 动态;
        }

        // 功能：创建并返回或登记对应对象。
        inline void 记录扫描动作动态创建失败(
            方法类::节点类* 方法首节点,
            场景节点类* 输入参数场景,
            场景节点类* 输出结果场景,
            存在节点类* 运行存在) noexcept
        {
            std::ostringstream 输出;
            输出 << "自我_扫描当前场景/动作动态创建逻辑错误"
                << " | 方法=" << (方法首节点 ? 方法首节点->获取主键() : std::string("空"))
                << " | 输入场景=" << (输入参数场景 ? 输入参数场景->获取主键() : std::string("空"))
                << " | 输出场景=" << (输出结果场景 ? 输出结果场景->获取主键() : std::string("空"))
                << " | 运行存在=" << (运行存在 ? 运行存在->获取主键() : std::string("空"))
                << " | 处置=运行事实已特征化，动作动态缺失被记录为逻辑错误证据";
            const auto 文本 = 输出.str();
            项目运行错误日志(文本);

            static std::atomic_bool s_同类错误已弹窗{ false };
            if (!s_同类错误已弹窗.exchange(true)) {
                项目弹窗错误提示("鱼巢 - 扫描动作动态逻辑错误", 文本);
            }
        }

        // 功能：把扫描复合状态的直接子特征落成可查询动作动态和主动因果信息。
        inline void 追加扫描子特征动作动态(
            方法类::节点类* 方法首节点,
            场景节点类* 输入参数场景,
            场景节点类* 输出结果场景,
            存在节点类* 运行存在,
            const 语素入口节点类* 特征类型,
            I64 初始值,
            I64 结果值,
            std::vector<动态节点类*>& 输出动态集合,
            I64& 输出动态数量,
            I64& 输出因果数量,
            时间戳 now) noexcept
        {
            if (初始值 == 结果值) {
                return;
            }
            因果模板节点类* 因果 = nullptr;
            bool 因果已生成 = false;
            auto* 动态 = 创建扫描I64子特征动作动态(
                方法首节点,
                输入参数场景,
                输出结果场景,
                基础节点(运行存在),
                特征类型,
                初始值,
                结果值,
                now,
                &因果,
                &因果已生成);
            if (!动态) {
                记录扫描动作动态创建失败(方法首节点, 输入参数场景, 输出结果场景, 运行存在);
                return;
            }
            输出动态集合.push_back(动态);
            ++输出动态数量;
            if (因果已生成) {
                ++输出因果数量;
            }
        }
    }

    // 功能：执行扫描相关材料获取、比较或提交逻辑。
    export bool 确认自我扫描当前场景规格(
        方法类::节点类* 方法首节点,
        存在节点类* 方法存在,
        时间戳 now) noexcept
    {
        auto* 虚拟存在 = 方法虚拟存在服务类::取或创建方法虚拟存在(方法首节点, 方法存在, now);
        auto* 宿主 = 基础节点(虚拟存在 ? 虚拟存在 : 方法存在);
        if (!宿主) return false;

        bool ok = true;
        ok = 写入I64(宿主, 特征_扫描运行状态(), static_cast<I64>(枚举_扫描运行状态::未开始), now) && ok;
        ok = 写入I64(宿主, 特征_扫描闭合状态(), 0, now) && ok;
        ok = 写入I64(宿主, 特征_已识别区域扫描入账状态(), static_cast<I64>(枚举_已识别区域扫描入账状态::未生成), now) && ok;
        ok = 写入I64(宿主, 特征_外设扫描结果场景状态(), 0, now) && ok;
        ok = 写入I64(宿主, 特征_当前场景扫描组合状态(), 0, now) && ok;
        ok = 写入I64(宿主, 特征_扫描状态变化动作动态数量(), 0, now) && ok;
        ok = 写入I64(宿主, 特征_扫描主动因果信息数量(), 0, now) && ok;
        ok = 写入I64(宿主, 特征_扫描主动因果信息状态(), 0, now) && ok;
        ok = 写入I64(宿主, 特征_场景维护结果状态(), static_cast<I64>(枚举_扫描场景维护结果::未定义), now) && ok;
        ok = 写入I64(宿主, 特征_扫描治理输出状态(), static_cast<I64>(枚举_扫描治理输出状态::未定义), now) && ok;
        ok = 确保方法结果能力I64(
            方法首节点,
            特征_已识别区域扫描入账状态(),
            static_cast<I64>(枚举_已识别区域扫描入账状态::已生成)) && ok;
        ok = 确保方法结果能力I64(方法首节点, 特征_外设扫描结果场景状态(), 1) && ok;
        ok = 确保方法结果能力I64(方法首节点, 特征_当前场景扫描组合状态(), 1) && ok;
        ok = 确保方法结果能力I64(方法首节点, 特征_扫描主动因果信息状态(), 1) && ok;
        return ok;
    }

    // 功能：执行扫描相关材料获取、比较或提交逻辑。
    export 存在节点类* 自我扫描当前场景(
        方法类::节点类* 方法首节点,
        场景节点类* 输入参数场景,
        场景节点类* 输出结果场景) noexcept
    {
        const auto now = 结构体_时间戳::当前_微秒();
        auto* 运行存在 = 取或创建运行存在(方法首节点, 输出结果场景, now);
        auto* 运行宿主 = 基础节点(运行存在);
        if (!运行存在) {
            项目运行日志("自我_扫描当前场景/运行存在创建失败");
            return nullptr;
        }

        (void)写入指针(运行宿主, 特征_输入参数场景(), 输入参数场景, now);
        if (输入参数场景) {
            (void)写入指针(运行宿主, 特征_当前场景引用(), 输入参数场景, now);
        }
        (void)写入I64(运行宿主, 特征_扫描运行状态(), static_cast<I64>(枚举_扫描运行状态::运行中), now);
        (void)写入I64(运行宿主, 特征_扫描范围状态(), 输入参数场景 ? 1 : 0, now);
        (void)写入指针(运行宿主, 特征_目标宿主指针(), 运行存在, now);
        (void)写入指针(运行宿主, 特征_目标特征类型指针(), 特征_已识别区域扫描入账状态(), now);
        (void)写入I64(运行宿主, 特征_当前状态值(), 0, now);
        (void)写入I64(运行宿主, 特征_目标状态值(), 1, now);
        (void)写入I64(运行宿主, 特征_扫描闭合状态(), 0, now);
        (void)写入I64(运行宿主, 特征_已识别区域扫描入账状态(), static_cast<I64>(枚举_已识别区域扫描入账状态::未生成), now);
        (void)写入I64(运行宿主, 特征_外设扫描结果场景状态(), 0, now);
        (void)写入I64(运行宿主, 特征_当前场景扫描组合状态(), 0, now);
        (void)写入I64(运行宿主, 特征_扫描状态变化动作动态数量(), 0, now);
        (void)写入I64(运行宿主, 特征_扫描主动因果信息数量(), 0, now);
        (void)写入I64(运行宿主, 特征_扫描主动因果信息状态(), 0, now);

        I64 缺口数量 = 0;
        I64 已取出计数 = 0;
        I64 已解析计数 = 0;
        I64 已闭合计数 = 0;
        I64 覆盖计数 = 0;
        I64 覆盖冲突数量 = 0;
        I64 写入摘要数量 = 0;
        I64 已写入特征数量 = 0;
        I64 已建立基准数量 = 0;
        I64 无变化刷新数量 = 0;
        I64 写入失败数量 = 0;
        I64 已写入状态动态数量 = 0;
        I64 扫描主动因果信息数量 = 0;
        I64 值域冲突数量 = 0;
        I64 覆盖记录序号 = 0;
        I64 未覆盖记录序号 = 0;
        I64 本轮异常未覆盖存在数量 = 0;
        I64 未覆盖状态信息数量 = 0;
        I64 消失候选数量 = 0;
        std::vector<存在节点类*> 已覆盖存在集合{};
        std::vector<动态节点类*> 状态变化动态集合{};

        if (!输入参数场景) {
            ++缺口数量;
            记录缺口(运行存在, 缺口数量, 枚举_扫描缺口类型::缺输入场景, 0, 0, 4, now);
        }
        if (!输出结果场景) {
            ++缺口数量;
            记录缺口(运行存在, 缺口数量, 枚举_扫描缺口类型::缺输出场景, 0, 0, 4, now);
        }

        const auto 关注集合 = 生成本轮扫描关注集合(输入参数场景, 运行存在, 缺口数量, now);
        const I64 本轮应覆盖存在数量 = static_cast<I64>(关注集合.应覆盖存在集合.size());
        const I64 本轮可忽略存在数量 = static_cast<I64>(关注集合.可忽略存在集合.size());
        const I64 本轮需补条件存在数量 = static_cast<I64>(关注集合.需补条件存在集合.size());
        (void)写入I64(运行宿主, 特征_本轮应覆盖存在数量(), 本轮应覆盖存在数量, now);
        (void)写入I64(运行宿主, 特征_本轮可忽略存在数量(), 本轮可忽略存在数量, now);
        (void)写入I64(运行宿主, 特征_本轮需补条件存在数量(), 本轮需补条件存在数量, now);
        (void)写入I64(运行宿主, 特征_本轮应覆盖存在集合(), 本轮应覆盖存在数量 > 0 ? 1 : 0, now);
        (void)写入I64(运行宿主, 特征_本轮可忽略存在集合(), 本轮可忽略存在数量 > 0 ? 1 : 0, now);
        (void)写入I64(运行宿主, 特征_本轮需补条件存在集合(), 本轮需补条件存在数量 > 0 ? 1 : 0, now);

        const auto 报告可选 = 读取扫描报告(输入参数场景, 输出结果场景, 运行存在);
        std::vector<结构_已合法外设数据项> 数据项队列{};
        I64 来源报告ID = 0;
        I64 来源帧ID = 0;
        if (报告可选.has_value()) {
            来源报告ID = static_cast<I64>(报告可选->报告ID);
            来源帧ID = static_cast<I64>(报告可选->来源外设帧ID);
            (void)写入I64(运行宿主, 特征_外设观察报告ID(), 来源报告ID, now);
            (void)写入I64(运行宿主, 特征_来源帧ID(), 来源帧ID, now);

            const auto 扫描包可选 = 构造外设扫描提交包_由观察报告(*报告可选);
            if (扫描包可选.has_value()) {
                数据项队列 = 展开已合法外设数据项(*报告可选, *扫描包可选);
            }
            else {
                ++缺口数量;
                记录缺口(
                    运行存在,
                    缺口数量,
                    枚举_扫描缺口类型::外设报告类型不匹配,
                    1,
                    1,
                    4,
                    now);
            }
        }
        else {
            ++缺口数量;
            记录缺口(运行存在, 缺口数量, 枚举_扫描缺口类型::缺合法外设数据集, 1, 1, 4, now);
        }

        (void)写入I64(运行宿主, 特征_外设数据项总数(), static_cast<I64>(数据项队列.size()), now);
        for (const auto& 数据项 : 数据项队列) {
            ++已取出计数;
            const auto 判断 = 判断外设数据项可处理(数据项);
            if (判断.状态 == 枚举_扫描判断状态::成立) {
                ++已解析计数;
                if (数据项.类别 == 枚举_扫描数据项类别::已知存在扫描结果) {
                    const auto 对应 = 判断外设数据项对应关系(数据项, 关注集合);
                    if (对应.状态 == 枚举_扫描判断状态::成立 && 对应.目标存在) {
                        ++覆盖计数;
                        记录覆盖索引(运行存在, ++覆盖记录序号, 数据项, 对应, now);
                        if (!指针集合包含(已覆盖存在集合, 对应.目标存在)) {
                            已覆盖存在集合.push_back(对应.目标存在);
                        }
                        const auto 写入结果 = 写入场景当前特征值_空间位置(
                            方法首节点,
                            输入参数场景,
                            输出结果场景,
                            运行存在,
                            ++写入摘要数量,
                            对应.目标存在,
                            数据项,
                            now);
                        if (写入结果.写入成功) {
                            ++已写入特征数量;
                            if (写入结果.首次建立基准) {
                                ++已建立基准数量;
                            } else if (写入结果.状态变化成立) {
                                if (写入结果.状态变化动态) {
                                    状态变化动态集合.push_back(写入结果.状态变化动态);
                                    ++已写入状态动态数量;
                                } else {
                                    记录扫描动作动态创建失败(方法首节点, 输入参数场景, 输出结果场景, 运行存在);
                                }
                                if (写入结果.主动因果信息已生成) {
                                    ++扫描主动因果信息数量;
                                }
                            } else {
                                ++无变化刷新数量;
                            }
                        } else {
                            ++写入失败数量;
                            ++缺口数量;
                            记录缺口(
                                运行存在,
                                缺口数量,
                                枚举_扫描缺口类型::缺场景写入接口绑定,
                                1,
                                1,
                                3,
                                now);
                        }
                    } else if (对应.状态 == 枚举_扫描判断状态::冲突) {
                        ++覆盖冲突数量;
                        记录覆盖索引(运行存在, ++覆盖记录序号, 数据项, 对应, now);
                        ++缺口数量;
                        记录缺口(
                            运行存在,
                            缺口数量,
                            枚举_扫描缺口类型::对应候选不唯一,
                            1,
                            1,
                            3,
                            now);
                    } else {
                        ++缺口数量;
                        记录缺口(
                            运行存在,
                            缺口数量,
                            枚举_扫描缺口类型::存在对应关系未确定,
                            0,
                            1,
                            2,
                            now);
                    }
                } else {
                    ++缺口数量;
                    记录缺口(
                        运行存在,
                        缺口数量,
                        枚举_扫描缺口类型::存在对应关系未确定,
                        0,
                        1,
                        2,
                        now);
                }
            }
            else {
                const bool 合同满足 = 已合法外设数据项合同满足(数据项);
                const auto 缺口类型 = !合同满足
                    ? 枚举_扫描缺口类型::上游契约错误
                    : (!(数据项.外设材料可承接状态 > 0
                        && 数据项.空间可用状态 > 0
                        && static_cast<I64>(数据项.可承接能力等级) >= static_cast<I64>(枚举_外设材料能力等级::空间可用))
                    ? 枚举_扫描缺口类型::材料质量不可比较
                    : (数据项.预置缺口 != 枚举_扫描缺口类型::无
                    ? 数据项.预置缺口
                    : 枚举_扫描缺口类型::数据项不可比较));
                const bool 特征类型已绑定 =
                    数据项.类别 == 枚举_扫描数据项类别::已知存在扫描结果
                    || 数据项.外设特征类型 != 枚举_外设特征类型ID::未指定;
                ++缺口数量;
                记录缺口(
                    运行存在,
                    缺口数量,
                    缺口类型,
                    数据项.空间中心有效 ? 1 : 0,
                    特征类型已绑定 ? 1 : 0,
                    2,
                    now);
            }
            记录数据项处理(运行存在, 数据项, 判断, now);
            ++已闭合计数;
        }

        if (!数据项队列.empty()) {
            for (auto* 应覆盖存在 : 关注集合.应覆盖存在集合) {
                if (!应覆盖存在 || 指针集合包含(已覆盖存在集合, 应覆盖存在)) continue;
                ++本轮异常未覆盖存在数量;
                ++消失候选数量;
                ++未覆盖状态信息数量;
                记录未覆盖解释(
                    运行存在,
                    ++未覆盖记录序号,
                    应覆盖存在,
                    枚举_扫描未覆盖解释状态::消失候选,
                    now);
            }
        }

        // 当前只实现空间位置的统一写入；没有写入摘要时，保留写入接口缺口。
        if (!数据项队列.empty() && 写入摘要数量 == 0) {
            ++缺口数量;
            记录缺口(
                运行存在,
                缺口数量,
                枚举_扫描缺口类型::缺场景写入接口绑定,
                0,
                1,
                2,
                now);
            写入失败数量 = static_cast<I64>(数据项队列.size());
        }

        const bool 有状态信息 =
            已建立基准数量 > 0
            || 已写入状态动态数量 > 0
            || 未覆盖状态信息数量 > 0;
        const auto 输出状态 = 有状态信息
            ? 枚举_扫描治理输出状态::状态信息
            : 枚举_扫描治理输出状态::空信息;
        const auto 维护状态 = 缺口数量 > 0
            ? 枚举_扫描场景维护结果::信息不全
            : (有状态信息 ? 枚举_扫描场景维护结果::部分更新 : 枚举_扫描场景维护结果::已最新);
        const I64 扫描入账状态 = static_cast<I64>(枚举_已识别区域扫描入账状态::已生成);
        const I64 外设扫描结果场景状态 = 输出结果场景 ? 1 : 0;
        const I64 当前场景扫描组合状态 = 1;
        const I64 本轮应覆盖存在集合状态 = 本轮应覆盖存在数量 > 0 ? 1 : 0;
        const I64 本轮需补条件存在集合状态 = 本轮需补条件存在数量 > 0 ? 1 : 0;
        const I64 信息缺口集合状态 = 缺口数量 > 0 ? 1 : 0;
        const I64 处理闭合证据状态 = 已闭合计数 == static_cast<I64>(数据项队列.size()) ? 1 : 0;

        (void)写入I64(运行宿主, 特征_已取出数据项计数(), 已取出计数, now);
        (void)写入I64(运行宿主, 特征_已成功解析数据项计数(), 已解析计数, now);
        (void)写入I64(运行宿主, 特征_已闭合处理数据项计数(), 已闭合计数, now);
        (void)写入I64(运行宿主, 特征_本轮外设覆盖索引状态(), 覆盖计数 > 0 ? 1 : 0, now);
        (void)写入I64(运行宿主, 特征_本轮外设覆盖索引(), 覆盖计数 > 0 ? 1 : 0, now);
        (void)写入I64(运行宿主, 特征_覆盖冲突数量(), 覆盖冲突数量, now);
        (void)写入I64(运行宿主, 特征_场景写入摘要数量(), 写入摘要数量, now);
        (void)写入I64(运行宿主, 特征_已写入特征数量(), 已写入特征数量, now);
        (void)写入I64(运行宿主, 特征_已写入状态动态数量(), 已写入状态动态数量, now);
        (void)写入I64(运行宿主, 特征_写入批次状态(), 写入摘要数量 > 0 ? 1 : 0, now);
        (void)写入I64(运行宿主, 特征_写入失败数量(), 写入失败数量, now);
        (void)写入I64(运行宿主, 特征_信息缺口数量(), 缺口数量, now);
        const I64 临时证据数量 =
            已闭合计数
            + 本轮异常未覆盖存在数量
            + 已建立基准数量
            + 无变化刷新数量;
        (void)写入I64(运行宿主, 特征_状态信息集合(), 输出状态 == 枚举_扫描治理输出状态::状态信息 ? 1 : 0, now);
        (void)写入I64(运行宿主, 特征_信息缺口集合(), 信息缺口集合状态, now);
        (void)写入I64(运行宿主, 特征_空信息状态(), 输出状态 == 枚举_扫描治理输出状态::空信息 ? 1 : 0, now);
        (void)写入I64(运行宿主, 特征_场景写入摘要集合(), 写入摘要数量 > 0 ? 1 : 0, now);
        (void)写入I64(运行宿主, 特征_临时证据集合(), 临时证据数量 > 0 ? 1 : 0, now);
        (void)写入I64(运行宿主, 特征_需求来源状态(), 缺口数量 > 0 ? 1 : 0, now);
        (void)写入I64(运行宿主, 特征_临时证据数量(), 临时证据数量, now);
        (void)写入I64(运行宿主, 特征_值域冲突数量(), 值域冲突数量, now);
        (void)写入I64(运行宿主, 特征_视野外证据数量(), 0, now);
        (void)写入I64(运行宿主, 特征_遮蔽覆盖证据数量(), 0, now);
        (void)写入I64(运行宿主, 特征_消失候选数量(), 消失候选数量, now);
        (void)写入I64(运行宿主, 特征_本轮应覆盖存在数量(), 本轮应覆盖存在数量, now);
        (void)写入I64(运行宿主, 特征_本轮可忽略存在数量(), 本轮可忽略存在数量, now);
        (void)写入I64(运行宿主, 特征_本轮需补条件存在数量(), 本轮需补条件存在数量, now);
        (void)写入I64(运行宿主, 特征_本轮异常未覆盖存在数量(), 本轮异常未覆盖存在数量, now);
        (void)写入I64(运行宿主, 特征_本轮异常未覆盖存在集合(), 本轮异常未覆盖存在数量 > 0 ? 1 : 0, now);
        (void)写入I64(运行宿主, 特征_场景维护结果状态(), static_cast<I64>(维护状态), now);
        (void)写入I64(运行宿主, 特征_信息完备性状态(), 缺口数量 == 0 ? 1 : 0, now);
        (void)写入I64(运行宿主, 特征_内部信息一致性状态(), 覆盖冲突数量 == 0 ? 1 : 0, now);
        (void)写入I64(运行宿主, 特征_扫描治理输出状态(), static_cast<I64>(输出状态), now);
        (void)写入I64(运行宿主, 特征_处理闭合证据状态(), 处理闭合证据状态, now);
        (void)写入I64(运行宿主, 特征_方法执行情况状态(), 1, now);
        (void)写入I64(运行宿主, 特征_实际结果状态值(), 扫描入账状态, now);
        (void)写入I64(运行宿主, 特征_后续承接入口状态(), 缺口数量 > 0 ? 2 : 1, now);
        (void)写入扫描输出I64状态(输出结果场景, 运行宿主, 特征_已识别区域扫描入账状态(), 扫描入账状态, now);
        (void)写入扫描输出I64状态(输出结果场景, 运行宿主, 特征_外设扫描结果场景状态(), 外设扫描结果场景状态, now);
        (void)写入扫描输出I64状态(输出结果场景, 运行宿主, 特征_当前场景扫描组合状态(), 当前场景扫描组合状态, now);

        std::vector<动态节点类*> 扫描低层动态集合 = 状态变化动态集合;
        I64 扫描子特征动态数量 = 0;
        I64 扫描子特征因果数量 = 0;
        const auto 追加组合子状态 = [&](const 语素入口节点类* 特征类型, I64 初始值, I64 结果值) noexcept {
            追加扫描子特征动作动态(
                方法首节点,
                输入参数场景,
                输出结果场景,
                运行存在,
                特征类型,
                初始值,
                结果值,
                扫描低层动态集合,
                扫描子特征动态数量,
                扫描子特征因果数量,
                now);
        };
        追加组合子状态(特征_本轮应覆盖存在集合(), 0, 本轮应覆盖存在集合状态);
        追加组合子状态(特征_本轮需补条件存在集合(), 0, 本轮需补条件存在集合状态);
        追加组合子状态(特征_处理闭合证据状态(), 0, 处理闭合证据状态);
        追加组合子状态(特征_场景维护结果状态(), static_cast<I64>(枚举_扫描场景维护结果::未定义), static_cast<I64>(维护状态));
        追加组合子状态(特征_扫描治理输出状态(), static_cast<I64>(枚举_扫描治理输出状态::未定义), static_cast<I64>(输出状态));
        追加组合子状态(特征_信息缺口集合(), 0, 信息缺口集合状态);
        追加组合子状态(特征_已识别区域扫描入账状态(), static_cast<I64>(枚举_已识别区域扫描入账状态::未生成), 扫描入账状态);
        追加组合子状态(特征_外设扫描结果场景状态(), 0, 外设扫描结果场景状态);
        追加组合子状态(特征_已写入状态动态数量(), 0, 已写入状态动态数量);

        const I64 预计扫描状态变化动作动态数量 = 已写入状态动态数量 + 扫描子特征动态数量 + 3;
        const I64 预计扫描主动因果信息数量 = 扫描主动因果信息数量 + 扫描子特征因果数量 + 3 + 1;
        追加组合子状态(特征_扫描状态变化动作动态数量(), 0, 预计扫描状态变化动作动态数量);
        追加组合子状态(特征_扫描主动因果信息数量(), 0, 预计扫描主动因果信息数量);
        追加组合子状态(特征_扫描主动因果信息状态(), 0, 预计扫描主动因果信息数量 > 0 ? 1 : 0);

        const I64 扫描状态变化动作动态总数 = 已写入状态动态数量 + 扫描子特征动态数量;
        I64 扫描主动因果信息总数 = 扫描主动因果信息数量 + 扫描子特征因果数量;
        (void)写入I64(运行宿主, 特征_扫描状态变化动作动态数量(), 扫描状态变化动作动态总数, now);
        (void)写入I64(运行宿主, 特征_扫描主动因果信息数量(), 扫描主动因果信息总数, now);
        (void)写入I64(运行宿主, 特征_扫描主动因果信息状态(), 扫描主动因果信息总数 > 0 ? 1 : 0, now);
        (void)写入I64(运行宿主, 特征_扫描闭合状态(), 1, now);
        (void)写入I64(运行宿主, 特征_扫描运行状态(), static_cast<I64>(枚举_扫描运行状态::已完成), now);

        因果模板节点类* 扫描组合因果信息 = nullptr;
        auto* 动作动态 = 创建扫描闭合动作动态(
            方法首节点,
            输入参数场景,
            输出结果场景,
            运行存在,
            扫描低层动态集合,
            now,
            &扫描组合因果信息);
        if (动作动态) {
            if (扫描组合因果信息) {
                ++扫描主动因果信息总数;
            }
            (void)写入指针(运行宿主, 特征_动作动态指针(), 动作动态, now);
            (void)写入I64(运行宿主, 特征_动作动态创建状态(), 1, now);
            (void)写入I64(运行宿主, 特征_错误日志证据状态(), 0, now);
        } else {
            记录扫描动作动态创建失败(方法首节点, 输入参数场景, 输出结果场景, 运行存在);
            (void)写入I64(运行宿主, 特征_动作动态创建状态(), 0, now);
            (void)写入I64(运行宿主, 特征_错误日志证据状态(), 1, now);
            (void)写入I64(运行宿主, 特征_方法执行情况状态(), 2, now);
        }
        (void)写入I64(运行宿主, 特征_扫描主动因果信息数量(), 扫描主动因果信息总数, now);
        (void)写入I64(运行宿主, 特征_扫描主动因果信息状态(), 扫描主动因果信息总数 > 0 ? 1 : 0, now);

        同步扫描输出结果场景(
            输出结果场景,
            运行存在,
            动作动态,
            输出状态,
            维护状态,
            static_cast<I64>(数据项队列.size()),
            已闭合计数,
            缺口数量,
            写入摘要数量,
            临时证据数量,
            覆盖冲突数量,
            本轮异常未覆盖存在数量,
            消失候选数量,
            扫描入账状态,
            外设扫描结果场景状态,
            当前场景扫描组合状态,
            扫描状态变化动作动态总数,
            扫描主动因果信息总数,
            now);

        {
            std::ostringstream 输出;
            输出 << "自我_扫描当前场景/函数自身结果"
                << " | 运行存在=" << 运行存在->获取主键()
                << " | 报告ID=" << 来源报告ID
                << " | 来源帧ID=" << 来源帧ID
                << " | 外设数据项总数=" << 数据项队列.size()
                << " | 已取出=" << 已取出计数
                << " | 已解析=" << 已解析计数
                << " | 已闭合=" << 已闭合计数
                << " | 覆盖计数=" << 覆盖计数
                << " | 未覆盖状态信息=" << 未覆盖状态信息数量
                << " | 缺口数量=" << 缺口数量
                << " | 已识别区域扫描入账状态=" << 扫描入账状态
                << " | 外设扫描结果场景状态=" << 外设扫描结果场景状态
                << " | 当前场景扫描组合状态=" << 当前场景扫描组合状态
                << " | 已写入状态动态数量=" << 已写入状态动态数量
                << " | 扫描状态变化动作动态数量=" << 扫描状态变化动作动态总数
                << " | 扫描主动因果信息数量=" << 扫描主动因果信息总数
                << " | 扫描主动因果信息状态=" << (扫描主动因果信息总数 > 0 ? 1 : 0)
                << " | 语义输出=" << static_cast<I64>(输出状态)
                << " | 动作动态=" << (动作动态 ? 动作动态->获取主键() : std::string("空"))
                << " | 不生产观察特征=1"
                << " | 不确认新存在=1"
                << " | 不直接调用观察识别跟踪=1";
            项目运行日志(输出.str());
        }

        return 运行存在;
    }
}
