    namespace {
        enum class 枚举_扫描判断状态 : I64 {
            未定义 = 0,
            成立 = 1,
            不成立 = 2,
            证据不足 = 3,
            条件不足 = 4,
            冲突 = 5,
        };

        enum class 枚举_扫描治理输出状态 : I64 {
            未定义 = 0,
            状态信息 = 1,
            信息缺口 = 2,
            空信息 = 3,
        };

        enum class 枚举_扫描场景维护结果 : I64 {
            未定义 = 0,
            已更新 = 1,
            已最新 = 2,
            信息不全 = 3,
            部分更新 = 4,
            无法解释 = 5,
        };

        enum class 枚举_扫描运行状态 : I64 {
            未开始 = 0,
            运行中 = 1,
            已完成 = 2,
            条件不足 = 3,
            失败 = 4,
        };

        enum class 枚举_扫描缺口类型 : I64 {
            无 = 0,
            缺输入场景 = 1,
            缺输出场景 = 2,
            缺合法外设数据集 = 3,
            外设报告类型不匹配 = 4,
            缺已确认存在指针 = 5,
            数据项不可比较 = 6,
            缺场景写入接口绑定 = 7,
            缺本轮关注集合绑定 = 8,
        };

        struct 结构_扫描判断结果 {
            枚举_扫描判断状态 状态 = 枚举_扫描判断状态::未定义;
            I64 分值 = 0;
            const char* 原因 = "";
        };

        struct 结构_已合法外设数据项视图 {
            std::uint64_t 数据项ID = 0;
            std::uint64_t 来源报告ID = 0;
            std::uint64_t 来源帧ID = 0;
            std::string 来源外设ID{};
            std::string 特征类型ID{};
            I64 当前I64值 = 0;
            bool 可比较 = false;
            bool 可生成扫描变化候选 = false;
            const char* 缺口原因 = "";
        };

