// 功能：记录日志、动态、证据或运行痕迹。
inline void 私有_记录方法执行条件结果节点_执行桥_最小_v0(
    方法类::节点类* 方法,
    场景节点类* 输入场景,
    场景节点类*& 输出场景,
    时间戳 开始时间,
    时间戳 结束时间) noexcept
{
    if (!方法 || !输入场景) {
        return;
    }

    if (!输出场景) {
        输出场景 = 方法类::取或创建_方法结果场景(
            方法,
            nullptr,
            结束时间);
    }

    auto* 方法条件场景 = 方法类::取或创建_方法条件场景(
            方法,
            nullptr,
            开始时间);
    auto* 方法结果场景 = 方法类::取或创建_方法结果场景(
            方法,
            nullptr,
            结束时间);

    auto* 条件节点 = 方法类::创建条件节点(
        方法,
        方法条件场景,
        {},
        {},
        开始时间,
        结束时间);

    if (方法结果场景) {
        (void)方法类::创建结果节点(
            条件节点 ? 条件节点 : 方法,
            方法结果场景,
            {});
    }
}

// 功能：执行对应模块、线程或方法的运行逻辑。
inline 特征节点类* 私有_补写运行场景事实_执行桥_最小_v0(
    特征节点类* 运行结果,
    场景节点类* 输入场景,
    场景节点类* 输出场景,
    时间戳 now) noexcept
{
    写入本能动作运行场景事实(
        reinterpret_cast<存在节点类*>(运行结果),
        输入场景,
        输出场景,
        now);
    return 运行结果;
}

class 任务执行桥类 {
public:
    // 功能：启动线程、模块或运行流程。
    void 启动(std::uint32_t n)
    {
        工作者数量_ = n == 0 ? 1 : n;
        停止请求_ = false;
        取消请求_ = false;
    }

    // 功能：停止线程、模块或运行流程。
    void 请求停止()
    {
        停止请求_ = true;
    }

    // 功能：停止线程、模块或运行流程。
    void 等待停止()
    {
    }

    // 功能：按函数名执行对应处理。
    void 取消全部()
    {
        取消请求_ = true;
    }

    // 功能：同步线程、任务、场景或对象之间的状态。
    特征节点类* 执行方法_同步等待(
        方法类::节点类* 方法首节点,
        场景节点类* 当前场景,
        场景节点类* 条件场景,
        时间戳 timeoutUs)
    {
        return 执行方法_同步等待(
            方法首节点,
            nullptr,
            当前场景,
            条件场景,
            nullptr,
            timeoutUs);
    }

    // 功能：同步线程、任务、场景或对象之间的状态。
    特征节点类* 执行方法_同步等待(
        方法类::节点类* 方法首节点,
        场景节点类* 当前场景,
        场景节点类* 条件场景,
        场景节点类* 结果场景,
        时间戳 timeoutUs)
    {
        return 执行方法_同步等待(
            方法首节点,
            nullptr,
            当前场景,
            条件场景,
            结果场景,
            timeoutUs);
    }

    // 功能：同步线程、任务、场景或对象之间的状态。
    特征节点类* 执行方法_同步等待(
        方法类::节点类* 方法首节点,
        任务类::节点类* 当前任务节点,
        场景节点类* 当前场景,
        场景节点类* 条件场景,
        场景节点类* 结果场景,
        时间戳 timeoutUs)
    {
        const auto 入口时间 = 结构体_时间戳::当前_微秒();
        if (当前任务节点 && 任务类::读取任务选中自我能力值(当前任务节点) != 0) {
            if (auto* 能力方法 = 私有_解析任务选中自我能力方法_执行桥_最小_v0(
                    当前任务节点,
                    入口时间)) {
                方法首节点 = 能力方法;
            }
            else {
                auto* 运行结果 = 创建本能动作运行结果实例_按码(
                    方法首节点,
                    结果场景 ? 结果场景 : 当前场景,
                    -1,
                    入口时间);
                return 私有_补写运行场景事实_执行桥_最小_v0(
                    运行结果,
                    条件场景 ? 条件场景 : 当前场景,
                    结果场景 ? 结果场景 : 当前场景,
                    入口时间);
            }
        }

        auto* 方法信息 = 方法首节点 ? &方法首节点->主信息 : nullptr;
        const auto* 首节点信息 = 方法信息 ? 方法信息->取首节点信息() : nullptr;
        if (!方法信息 || !首节点信息) {
            auto* 运行结果 = 创建本能动作运行结果实例_按码(
                方法首节点,
                结果场景 ? 结果场景 : 当前场景,
                -1,
                入口时间);
            return 私有_补写运行场景事实_执行桥_最小_v0(
                运行结果,
                条件场景 ? 条件场景 : 当前场景,
                结果场景 ? 结果场景 : 当前场景,
                入口时间);
        }

        auto* 默认结果场景 = 结果场景
            ? 结果场景
            : 方法类::取或创建_方法结果场景(
                方法首节点,
                nullptr,
                结构体_时间戳::当前_微秒());
        auto* 默认方法虚拟存在 = 方法虚拟存在服务类::取或创建方法虚拟存在(
            方法首节点,
            nullptr,
            结构体_时间戳::当前_微秒());
        auto* 默认输入场景 = 条件场景 ? 条件场景 : 当前场景;

        const auto 当前时间 = 结构体_时间戳::当前_微秒();
        const bool 允许引导执行 = 私有_方法允许引导执行_执行桥_最小_v0(方法首节点);
        if (私有_方法动作数量_执行桥_最小_v0(方法首节点) <= 0) {
            私有_记录执行桥方法缺口_最小_v0(
                "方法动作",
                当前任务节点,
                方法首节点,
                允许引导执行);
            auto* 运行结果 = 私有_填充缺方法动作执行结果_执行桥_最小_v0(
                方法首节点,
                默认结果场景,
                当前时间);
            return 私有_补写运行场景事实_执行桥_最小_v0(
                运行结果,
                默认输入场景,
                默认结果场景,
                当前时间);
        }

        if (私有_方法可执行入口数量_执行桥_最小_v0(方法首节点) <= 0) {
            私有_记录执行桥方法缺口_最小_v0(
                "方法可执行入口",
                当前任务节点,
                方法首节点,
                允许引导执行);
            auto* 运行结果 = 私有_填充方法缺可执行入口执行结果_执行桥_最小_v0(
                方法首节点,
                默认结果场景,
                当前时间);
            return 私有_补写运行场景事实_执行桥_最小_v0(
                运行结果,
                默认输入场景,
                默认结果场景,
                当前时间);
        }

        if (!允许引导执行
            && 私有_方法条件节点数量_执行桥_最小_v0(方法首节点) <= 0) {
            私有_记录执行桥方法缺口_最小_v0(
                "方法条件节点",
                当前任务节点,
                方法首节点,
                允许引导执行);
            auto* 运行结果 = 私有_填充方法缺条件节点执行结果_执行桥_最小_v0(
                方法首节点,
                默认结果场景,
                当前时间);
            return 私有_补写运行场景事实_执行桥_最小_v0(
                运行结果,
                默认输入场景,
                默认结果场景,
                当前时间);
        }

        if (!允许引导执行
            && 私有_方法结果节点数量_执行桥_最小_v0(方法首节点) <= 0) {
            私有_记录执行桥方法缺口_最小_v0(
                "方法结果节点",
                当前任务节点,
                方法首节点,
                允许引导执行);
            auto* 运行结果 = 私有_填充方法缺结果节点执行结果_执行桥_最小_v0(
                方法首节点,
                默认结果场景,
                当前时间);
            return 私有_补写运行场景事实_执行桥_最小_v0(
                运行结果,
                默认输入场景,
                默认结果场景,
                当前时间);
        }

        if (!允许引导执行
            && 私有_方法条件结果对数量_执行桥_最小_v0(方法首节点) <= 0) {
            私有_记录执行桥方法缺口_最小_v0(
                "方法条件结果对",
                当前任务节点,
                方法首节点,
                允许引导执行);
            auto* 运行结果 = 私有_填充方法缺条件结果对执行结果_执行桥_最小_v0(
                方法首节点,
                默认结果场景,
                当前时间);
            return 私有_补写运行场景事实_执行桥_最小_v0(
                运行结果,
                默认输入场景,
                默认结果场景,
                当前时间);
        }

        if (!允许引导执行
            && !私有_方法当前可用_执行桥_最小_v0(方法首节点, 当前时间)) {
            私有_记录执行桥方法缺口_最小_v0(
                "方法状态不可用",
                当前任务节点,
                方法首节点,
                允许引导执行);
            auto* 运行结果 = 私有_填充方法不可用执行结果_执行桥_最小_v0(
                方法首节点,
                默认结果场景,
                当前时间);
            return 私有_补写运行场景事实_执行桥_最小_v0(
                运行结果,
                默认输入场景,
                默认结果场景,
                当前时间);
        }

        auto* 执行条件场景 = 条件场景
            ? 条件场景
            : (允许引导执行
                ? 当前场景
                : 私有_真实执行条件场景_执行桥_最小_v0(方法首节点, 当前场景));
        const bool 条件类型描述为无输入 =
            私有_方法条件类型描述为无输入_执行桥_最小_v0(默认方法虚拟存在);
        if (!执行条件场景 && !条件类型描述为无输入) {
            auto* 运行结果 = 私有_填充方法缺条件节点执行结果_执行桥_最小_v0(
                方法首节点,
                默认结果场景,
                当前时间);
            return 私有_补写运行场景事实_执行桥_最小_v0(
                运行结果,
                默认输入场景,
                默认结果场景,
                当前时间);
        }

        if (首节点信息->动作句柄.类型 != 枚举_动作句柄类型::本能函数ID) {
            auto* 运行结果 = 私有_填充方法缺可执行入口执行结果_执行桥_最小_v0(
                方法首节点,
                默认结果场景,
                当前时间);
            return 私有_补写运行场景事实_执行桥_最小_v0(
                运行结果,
                执行条件场景 ? 执行条件场景 : 默认输入场景,
                默认结果场景,
                当前时间);
        }

        auto 执行体 = [=]() -> 特征节点类* {
            if (停止请求_ || 取消请求_) {
                const auto 停止时间 = 结构体_时间戳::当前_微秒();
                auto* 运行结果 = 创建本能动作运行结果实例_按码(
                    方法首节点,
                    默认结果场景,
                    -4,
                    停止时间);
                return 私有_补写运行场景事实_执行桥_最小_v0(
                    运行结果,
                    执行条件场景 ? 执行条件场景 : 默认输入场景,
                    默认结果场景,
                    停止时间);
            }

            auto* 输入场景 = 执行条件场景 ? 执行条件场景 : 当前场景;
            auto* 输出场景 = 默认结果场景 ? 默认结果场景 : (当前场景 ? 当前场景 : 条件场景);
            auto* 实际输入场景 = 输入场景 ? 输入场景 : (当前场景 ? 当前场景 : 输出场景);
            auto* 实际输出场景 = 输出场景 ? 输出场景 : 实际输入场景;

            const auto 动作开始时间 = 结构体_时间戳::当前_微秒();
            auto* 运行结果 = 取本能动作集().执行功能函数(
                static_cast<枚举_本能动作ID>(首节点信息->动作句柄.本能ID),
                方法首节点,
                实际输入场景,
                实际输出场景);
            const auto 动作结束时间 = 结构体_时间戳::当前_微秒();
            const auto 运行视图 = 读取本能方法运行闭环视图(
                运行结果,
                实际输出场景);
            const auto 运行码 = 本能动作运行结果值(运行结果);
            if (static_cast<枚举_本能方法ID>(首节点信息->动作句柄.本能ID)
                == 枚举_本能方法ID::提交_当前观察范围可观测单位存在对应事实) {
                std::ostringstream 输出;
                输出 << "任务执行桥/6150动作调用结果诊断"
                    << " | 任务=" << 私有_执行桥任务主键_最小_v0(当前任务节点)
                    << " | 方法=" << 私有_执行桥方法主键_最小_v0(方法首节点)
                    << " | 本能ID=" << 首节点信息->动作句柄.本能ID
                    << " | 输入场景=" << (实际输入场景
                        ? reinterpret_cast<基础信息节点类*>(实际输入场景)->获取主键()
                        : std::string("空"))
                    << " | 输出场景=" << (实际输出场景
                        ? reinterpret_cast<基础信息节点类*>(实际输出场景)->获取主键()
                        : std::string("空"))
                    << " | 运行存在=" << (运行结果
                        ? reinterpret_cast<基础信息节点类*>(运行结果)->获取主键()
                        : std::string("空"))
                    << " | 运行码=" << 运行码
                    << " | 方法执行成功=" << (运行视图.方法执行成功 ? 1 : 0)
                    << " | 有执行缺口=" << (运行视图.有执行缺口() ? 1 : 0)
                    << " | 执行缺口类型=" << (运行视图.执行缺口类型
                        ? 运行视图.执行缺口类型->获取主键()
                        : std::string("空"))
                    << " | 只诊断不改变判定=1";
                项目运行日志(输出.str());
            }
            (void)私有_创建方法调用动作动态_执行桥_最小_v0(
                方法首节点,
                实际输入场景,
                实际输出场景,
                动作开始时间,
                动作结束时间,
                运行视图.方法执行成功 && !运行视图.有执行缺口(),
                运行码);
            私有_记录方法执行条件结果节点_执行桥_最小_v0(
                方法首节点,
                实际输入场景,
                实际输出场景,
                动作开始时间,
                动作结束时间);
            if (运行结果) {
                return 运行结果;
            }
            auto* 未知结果 = 创建本能动作运行结果实例_按码(
                方法首节点,
                实际输出场景,
                本能动作运行结果_未知,
                动作结束时间);
            return 私有_补写运行场景事实_执行桥_最小_v0(
                未知结果,
                实际输入场景,
                实际输出场景,
                动作结束时间);
        };

        if (timeoutUs == 0) {
            return 执行体();
        }

        auto Future = std::async(std::launch::async, 执行体);
        const auto 状态 = Future.wait_for(std::chrono::microseconds(timeoutUs));
        if (状态 == std::future_status::ready) {
            return Future.get();
        }

        取消全部();
        const auto 超时时间 = 结构体_时间戳::当前_微秒();
        auto* 运行结果 = 创建本能动作运行结果实例(
            方法首节点,
            默认结果场景,
            "执行超时",
            -3,
            超时时间);
        return 私有_补写运行场景事实_执行桥_最小_v0(
            运行结果,
            执行条件场景 ? 执行条件场景 : 默认输入场景,
            默认结果场景,
            超时时间);
    }

private:
    std::uint32_t 工作者数量_ = 1;
    bool 停止请求_ = false;
    bool 取消请求_ = false;
};

// 功能：同步线程、任务、场景或对象之间的状态。
inline void 私有_同步任务执行记录_最小_v0(
    任务类::节点类* 任务,
    方法类::节点类* 方法,
    const 特征节点类* 方法运行结果,
    枚举_任务执行记账结果 记账结果,
    时间戳 开始时间,
    时间戳 结束时间) noexcept
{
    (void)任务;
    (void)方法;
    (void)方法运行结果;
    (void)记账结果;
    (void)开始时间;
    (void)结束时间;
    // 旧执行桥只保留回执计算，不提交任务账。
    // 错误码、运行次数、镜像同步等任务域事实必须由同步 / 提交类本能方法落账。
}

// 功能：执行任务、方法或动作的主体逻辑。
inline 方法类::节点类* 私有_取任务执行方法_最小_v0(任务类::节点类* 任务) noexcept
{
    if (!任务) {
        return nullptr;
    }
    if (任务类::读取任务选中自我能力值(任务) != 0) {
        return 私有_解析任务选中自我能力方法_执行桥_最小_v0(
            任务,
            结构体_时间戳::当前_微秒());
    }
    if (auto* 方法 = reinterpret_cast<方法类::节点类*>(任务类::读取任务执行方法(任务))) {
        return 方法;
    }
    return nullptr;
}

// 功能：执行对应模块、线程或方法的运行逻辑。
inline 枚举_任务状态 私有_按方法运行结果推导任务状态_最小_v0(
    方法类::节点类* 当前方法,
    const 特征节点类* 方法运行结果,
    枚举_任务执行记账结果 记账结果) noexcept
{
    const auto 运行视图 = 读取本能方法运行闭环视图(方法运行结果);
    if (运行视图.有执行缺口()) {
        if (语素入口同一(
                运行视图.后续承接方式,
                本能动作承接_异常处理词())) {
            return 枚举_任务状态::无法执行;
        }
        if (语素入口同一(
                运行视图.后续承接方式,
                本能动作承接_重筹办词())) {
            return 枚举_任务状态::待重筹办;
        }
        return 枚举_任务状态::等待中;
    }
    if (运行视图.方法执行成功
        || 记账结果 == 枚举_任务执行记账结果::成功) {
        return 枚举_任务状态::待重筹办;
    }
    return 当前方法 ? 枚举_任务状态::待重筹办 : 枚举_任务状态::等待中;
}

inline 结构_执行任务结果 执行任务(
    任务执行桥类& 执行桥,
    任务类::节点类* 当前任务节点,
    时间戳 now = 结构体_时间戳::当前_微秒(),
    时间戳 timeoutUs = 0)
{
    结构_执行任务结果 输出{};
    auto& 任务执行结果 = 输出.任务执行结果;
    auto* 主任务 = 私有_归一到任务头_执行桥_最小_v0(当前任务节点);
    if (!主任务) {
        主任务 = 当前任务节点;
    }
    任务执行结果.主任务 = 主任务;
    任务执行结果.当前步骤节点 = 主任务;

    if (!当前任务节点) {
        任务执行结果.方法运行结果 = 创建本能动作运行结果实例_按码(nullptr, nullptr, -12, now);
        任务执行结果.方法运行说明 = "当前任务节点为空";
        任务执行结果.记账结果 = 枚举_任务执行记账结果::未定义;
        输出.方法运行结果 = 任务执行结果.方法运行结果;
        私有_写入动作验证报告摘要_执行桥_最小_v0(
            任务执行结果,
            now,
            "P2执行入口空任务，仅贯通动作验证报告摘要，不提交事实");
        同步执行桥语义槽(输出);
        return 输出;
    }

    if (now == 0) {
        now = 结构体_时间戳::当前_微秒();
    }

    auto* 当前场景 = 任务类::解析任务场景(主任务);
    auto* 可执行输入参数场景 =
        私有_读取任务可执行输入参数场景_执行桥_最小_v0(主任务);
    场景节点类* 结果场景 = nullptr;
    场景节点类* 本轮条件场景 = nullptr;
    场景节点类* 本轮输入场景 = 当前场景;
    const auto 完成当前轮 = [&](方法类::节点类* 方法, 枚举_任务状态 结束状态) {
        任务执行结果.当前方法 = 方法;
        任务执行结果.建议任务状态 = 结束状态;
        任务执行结果.建议任务阶段 = 枚举_任务阶段::执行;
        if (主任务) {
            // 旧执行桥只填写建议状态，不直接写任务状态 / 时间 / 错误码等任务账。
            // 真实任务账提交由同步回执与提交任务状态变化本能方法完成。
        }

        私有_同步任务执行记录_最小_v0(
            主任务 ? 主任务 : 当前任务节点,
            方法,
            任务执行结果.方法运行结果,
            任务执行结果.记账结果,
            now,
            now);
        任务执行结果.条件场景 = 本轮条件场景 ? 本轮条件场景 : 本轮输入场景;
        任务执行结果.结果场景 = 结果场景 ? 结果场景 : 当前场景;
        任务执行结果.有效 = true;
        输出.方法运行结果 = 任务执行结果.方法运行结果;
        输出.有效 = true;
        私有_写入动作验证报告摘要_执行桥_最小_v0(
            任务执行结果,
            now,
            "P2仅贯通动作验证报告摘要，VX0尚未驱动完成判断");
        同步执行桥语义槽(输出);
    };

    auto* 当前方法 = 私有_取任务执行方法_最小_v0(主任务);
    任务执行结果.当前方法 = 当前方法;
    if (!当前方法) {
        结果场景 = 当前场景;
        auto* 运行结果 = 创建本能动作运行结果实例_按码(
            nullptr,
            结果场景,
            本能方法结果_任务缺条件需自我线程,
            now);
        任务执行结果.方法运行结果 =
            私有_补写运行场景事实_执行桥_最小_v0(
                运行结果,
                本轮输入场景,
                结果场景,
                now);
        任务执行结果.方法运行说明 = "任务尚未形成可执行方法：可保留方法头并等待重筹办、学习补齐或外部支撑";
        任务执行结果.记账结果 = 枚举_任务执行记账结果::未定义;
        完成当前轮(nullptr, 枚举_任务状态::等待中);
        return 输出;
    }

    if (主任务) {
        // 旧执行桥不得把任务推进到执行中；这里只保留回执建议，避免绕过提交类本能方法。
        任务执行结果.建议任务状态 = 枚举_任务状态::执行中;
        任务执行结果.建议任务阶段 = 枚举_任务阶段::执行;
    }
    if (可执行输入参数场景) {
        本轮输入场景 = 可执行输入参数场景;
        本轮条件场景 = 可执行输入参数场景;
        项目运行日志("任务执行普通函数/使用可执行输入参数场景 | 任务="
            + (主任务 ? 主任务->获取主键() : std::string("空"))
            + " | 方法=" + (当前方法 ? 当前方法->获取主键() : std::string("空"))
            + " | 输入场景="
            + reinterpret_cast<基础信息节点类*>(可执行输入参数场景)->获取主键());
    } else {
        本轮条件场景 = 私有_方法允许引导执行_执行桥_最小_v0(当前方法)
            ? 当前场景
            : 私有_真实执行条件场景_执行桥_最小_v0(当前方法, 当前场景);
        本轮输入场景 = 当前场景;
    }
    结果场景 = 当前场景;
    任务执行结果.方法运行结果 = 执行桥.执行方法_同步等待(
        当前方法,
        主任务,
        本轮输入场景,
        本轮条件场景,
        结果场景,
        timeoutUs);
    任务执行结果.方法运行说明 = 本能动作运行结果文本(任务执行结果.方法运行结果);

    const auto 运行视图 = 读取本能方法运行闭环视图(
        任务执行结果.方法运行结果,
        结果场景);
    if (运行视图.方法执行成功 && !运行视图.有执行缺口()) {
        任务执行结果.记账结果 = 枚举_任务执行记账结果::成功;
    } else if (运行视图.有执行缺口()) {
        任务执行结果.记账结果 = 枚举_任务执行记账结果::未定义;
    } else {
        任务执行结果.记账结果 = 枚举_任务执行记账结果::未定义;
    }

    const auto 结束状态 = 私有_按方法运行结果推导任务状态_最小_v0(
        当前方法,
        任务执行结果.方法运行结果,
        任务执行结果.记账结果);
    完成当前轮(当前方法, 结束状态);
    return 输出;
}

} // export
