export {

enum class 枚举_任务执行记账结果 : std::uint8_t {
    未定义 = 0,
    成功 = 1,
    失败 = 2,
};

struct 结构_任务步骤执行结果_最小 {
    bool 有效 = false;
    枚举_任务执行记账结果 记账结果 = 枚举_任务执行记账结果::未定义;
    枚举_任务状态 建议任务状态 = 枚举_任务状态::未定义;
    枚举_任务阶段 建议任务阶段 = 枚举_任务阶段::未定义;
    std::uintptr_t 记账结果抽象特征指针 = 0;
    I64 记账结果值 = 0;
    任务类::节点类* 主任务 = nullptr;
    任务类::节点类* 当前步骤节点 = nullptr; // 当前执行承载任务；新逻辑中等同于主任务。
    方法类::节点类* 当前方法 = nullptr;
    场景节点类* 条件场景 = nullptr;
    场景节点类* 结果场景 = nullptr;
    特征节点类* 方法运行结果 = nullptr;
    动态节点类* 动作动态 = nullptr;
    动作验证报告::结构_动作验证报告摘要 动作验证报告摘要{};
    std::string 方法运行说明{};
};

struct 结构_执行任务结果 {
    bool 有效 = false;
    结构_任务步骤执行结果_最小 任务执行结果{};
    特征节点类* 方法运行结果 = nullptr;
};

// 功能：同步线程、任务、场景或对象之间的状态。
inline void 同步执行桥语义槽(结构_任务步骤执行结果_最小& 结果) noexcept
{
    结果.记账结果抽象特征指针 =
        reinterpret_cast<std::uintptr_t>(自我特征定义类::类型_任务管理_任务执行记账结果());
    结果.记账结果值 = static_cast<I64>(结果.记账结果);
}

// 功能：同步线程、任务、场景或对象之间的状态。
inline void 同步执行桥语义槽(结构_执行任务结果& 结果) noexcept
{
    同步执行桥语义槽(结果.任务执行结果);
}

// 功能：执行任务、方法或动作的主体逻辑。
inline const 语素入口节点类* 私有_方法调用动作动态特征类型_执行桥_最小_v0() noexcept
{
    static const 语素入口节点类* s_词 = 语素集.添加信息入口词("方法调用动作动态", 枚举_信息入口类型::特征模板入口);
    return s_词;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline const 语素入口节点类* 私有_可执行输入参数场景特征_执行桥_最小_v0() noexcept
{
    static const 语素入口节点类* s_词 = 语素集.添加信息入口词("可执行输入参数场景", 枚举_信息入口类型::特征模板入口);
    return s_词;
}

// 功能：从指定来源读取数据或状态。
inline 场景节点类* 私有_读取任务可执行输入参数场景_执行桥_最小_v0(
    const 任务类::节点类* 任务) noexcept
{
    auto* 任务虚拟存在 = 任务类::解析任务虚拟存在(任务);
    void* 指针 = nullptr;
    return 任务虚拟存在
        && 世界树.读取特征_指针(
            reinterpret_cast<基础信息节点类*>(任务虚拟存在),
            私有_可执行输入参数场景特征_执行桥_最小_v0(),
            指针)
        && 指针
        ? reinterpret_cast<场景节点类*>(指针)
        : nullptr;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline const 语素入口节点类* 私有_方法动作名_执行桥_最小_v0(const 方法类::节点类* 方法首节点) noexcept
{
    if (方法首节点 && 方法首节点->主信息.首节点信息().动作名) {
        return 方法首节点->主信息.首节点信息().动作名;
    }
    return 语素集.添加信息入口词("方法调用", 枚举_信息入口类型::动态模板入口);
}

// 功能：创建并返回或登记对应对象。
inline 动态节点类* 私有_创建方法调用动作动态_执行桥_最小_v0(
    方法类::节点类* 方法首节点,
    场景节点类* 输入场景,
    场景节点类* 输出场景,
    时间戳 开始时间,
    时间戳 结束时间,
    bool 执行成功,
    std::int64_t 错误码) noexcept
{
    auto* 自我场景 = 世界树.自我所在场景
        ? 世界树.自我所在场景
        : 世界树.取或创建自我现实场景();
    auto* 自我存在 = 世界树.取或创建自我存在();
    if (!自我场景 || !自我存在) {
        return nullptr;
    }

    auto* 动作特征 = 世界树.取或创建子特征_按类型(
        自我存在,
        私有_方法调用动作动态特征类型_执行桥_最小_v0());
    if (!动作特征) {
        return nullptr;
    }

    if (结束时间 == 0) {
        结束时间 = 结构体_时间戳::当前_微秒();
    }
    if (开始时间 == 0) {
        开始时间 = 结束时间;
    }

    const auto* 动作名 = 私有_方法动作名_执行桥_最小_v0(方法首节点);
    auto* 动态节点 = 世界树.创建方法动作动态(
        自我场景,
        自我存在,
        动作特征,
        reinterpret_cast<方法节点类*>(方法首节点),
        动作名,
        开始时间,
        结束时间,
        执行成功,
        static_cast<I64>(错误码),
        输入场景,
        输出场景);
    if (!动态节点) {
        return nullptr;
    }

    if (auto* 动态主信息 = 世界树.取动态主信息(动态节点)) {
        动态主信息->名称 = 动作名;
        动态主信息->类型 = 动作名;
    }
    return 动态节点;
}

// 功能：按函数名执行对应处理。
inline bool 任务结果缺条件_最小_v0(const 特征节点类* 运行结果) noexcept
{
    const auto 视图 = 读取本能方法运行闭环视图(运行结果);
    return 视图.有执行缺口()
        && 视图.执行缺口类型 != 本能动作执行缺口_当前方法执行失败词();
}

// 功能：执行任务、方法或动作的主体逻辑。
inline 任务类::节点类* 私有_归一到任务头_执行桥_最小_v0(任务类::节点类* 节点) noexcept
{
    auto* 当前 = 节点;
    while (当前) {
        if (任务类::读取任务节点种类(当前) == 枚举_任务节点种类::头结点) {
            return 当前;
        }
        当前 = reinterpret_cast<任务类::节点类*>(当前->父);
    }
    return nullptr;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline I64 私有_方法自我能力值_执行桥_最小_v0(
    const 方法类::节点类* 方法) noexcept
{
    if (!方法
        || 方法->主信息.首节点信息().动作句柄.类型 != 枚举_动作句柄类型::本能函数ID) {
        return 0;
    }
    const I64 能力值 = 方法->主信息.首节点信息().动作句柄.本能ID;
    return 本能方法类::是有效本能方法能力值(能力值) ? 能力值 : 0;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline bool 私有_方法匹配自我能力值_执行桥_最小_v0(
    const 方法类::节点类* 方法,
    I64 自我能力值) noexcept
{
    return 自我能力值 != 0
        && 私有_方法自我能力值_执行桥_最小_v0(方法) == 自我能力值;
}

// 功能：解析输入文本、消息、场景或运行包。
inline 方法类::节点类* 私有_解析任务选中自我能力方法_执行桥_最小_v0(
    任务类::节点类* 任务,
    时间戳 now) noexcept
{
    const I64 自我能力值 = 任务类::读取任务选中自我能力值(任务);
    if (!任务 || 自我能力值 == 0) {
        return nullptr;
    }

    if (auto* 方法 = reinterpret_cast<方法类::节点类*>(任务类::读取任务执行方法(任务));

        // 功能：执行任务、方法或动作的主体逻辑。
        私有_方法匹配自我能力值_执行桥_最小_v0(方法, 自我能力值)) {
        return 方法;
    }
    (void)now;
    return nullptr;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline 场景节点类* 私有_真实执行条件场景_执行桥_最小_v0(
    const 方法类::节点类* 方法,
    场景节点类* 当前场景) noexcept
{
    if (!方法) {
        return nullptr;
    }
    if (方法->子) {
        auto* 首节点 = reinterpret_cast<方法类::节点类*>(方法->子);
        auto* 当前 = 首节点;
        std::size_t 保护计数 = 0;
        do {
            if (当前 && 当前->主信息.公共.节点种类 == 枚举_方法节点种类::方法条件节点) {
                const auto* 条件信息 = 当前->主信息.取条件节点信息();
                return 条件信息 && 条件信息->条件场景.指针
                    ? 条件信息->条件场景.指针
                    : 当前场景;
            }
            当前 = 当前 ? reinterpret_cast<方法类::节点类*>(当前->下) : nullptr;
            ++保护计数;
        } while (当前 && 当前 != 首节点 && 保护计数 < 4096);
    }
    return nullptr;
}

