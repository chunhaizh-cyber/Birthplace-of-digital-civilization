// 功能：执行任务、方法或动作的主体逻辑。
inline 动作验证报告::结构_动作验证报告 私有_构造动作验证报告占位_执行桥_最小_v0(
    const 任务类::节点类* 任务,
    const 方法类::节点类* 方法,
    时间戳 now,
    const char* 纠偏建议)
{
    if (now == 0) {
        now = 结构体_时间戳::当前_微秒();
    }

    动作验证报告::结构_动作验证报告 报告{};
    报告.来源任务指针 = reinterpret_cast<std::uintptr_t>(任务);
    报告.来源任务主键 = 私有_执行桥任务主键_最小_v0(任务);
    报告.来源方法指针 = reinterpret_cast<std::uintptr_t>(方法);
    报告.来源方法主键 = 私有_执行桥方法主键_最小_v0(方法);
    报告.动作事务ID =
        报告.来源任务主键
        + "|"
        + 报告.来源方法主键
        + "|"
        + std::to_string(now)
        + "|动作验证报告";
    报告.验证状态 = 方法
        ? 动作验证报告::枚举_动作验证状态::等待实际回读
        : 动作验证报告::枚举_动作验证状态::实际回读不足;
    报告.事实提交等级 = 动作验证报告::枚举_事实提交等级::不可提交;
    报告.回读置信度_Q10000 = 0;
    报告.纠偏建议 = 纠偏建议 ? 纠偏建议 : "P2仅贯通动作验证报告摘要，VX0尚未驱动完成判断";
    动作验证报告::刷新偏差(报告);
    return 报告;
}

// 功能：把处理结果写入指定对象、场景或日志。
inline void 私有_写入动作验证报告摘要_执行桥_最小_v0(
    结构_任务步骤执行结果_最小& 结果,
    const 时间戳 now,
    const char* 纠偏建议)
{
    const auto 报告 = 私有_构造动作验证报告占位_执行桥_最小_v0(
        结果.主任务 ? 结果.主任务 : 结果.当前步骤节点,
        结果.当前方法,
        now,
        纠偏建议);
    结果.动作验证报告摘要 = 动作验证报告::提取摘要(报告);
}

// 功能：记录日志、动态、证据或运行痕迹。
inline void 私有_记录执行桥方法缺口_最小_v0(
    const char* 缺口,
    const 任务类::节点类* 任务,
    const 方法类::节点类* 方法,
    const bool 允许引导执行) noexcept
{
    std::ostringstream 输出;
    输出 << "任务执行桥跟踪 | 方法结构缺口"
        << " | 缺口=" << (缺口 ? 缺口 : "未知")
        << " | 任务=" << 私有_执行桥任务主键_最小_v0(任务)
        << " | 方法=" << 私有_执行桥方法主键_最小_v0(方法)
        << " | 本能ID=" << (方法 ? 方法->主信息.首节点信息().动作句柄.本能ID : -1)
        << " | 允许引导执行=" << (允许引导执行 ? 1 : 0)
        << " | 方法动作数=" << 私有_方法动作数量_执行桥_最小_v0(方法)
        << " | 可执行入口数=" << 私有_方法可执行入口数量_执行桥_最小_v0(方法)
        << " | 条件节点数=" << 私有_方法条件节点数量_执行桥_最小_v0(方法)
        << " | 结果节点数=" << 私有_方法结果节点数量_执行桥_最小_v0(方法)
        << " | 条件结果对数=" << 私有_方法条件结果对数量_执行桥_最小_v0(方法);
    项目运行日志(输出.str());
}

// 功能：执行任务、方法或动作的主体逻辑。
inline constexpr I64 私有_方法状态_待方法动作_执行桥_最小_v0() noexcept { return static_cast<I64>(枚举_方法状态::待方法动作); }

// 功能：执行任务、方法或动作的主体逻辑。
inline constexpr I64 私有_方法状态_待可执行入口_执行桥_最小_v0() noexcept { return static_cast<I64>(枚举_方法状态::待可执行入口); }

// 功能：执行任务、方法或动作的主体逻辑。
inline constexpr I64 私有_方法状态_待条件节点_执行桥_最小_v0() noexcept { return static_cast<I64>(枚举_方法状态::待条件节点); }

// 功能：执行任务、方法或动作的主体逻辑。
inline constexpr I64 私有_方法状态_待结果节点_执行桥_最小_v0() noexcept { return static_cast<I64>(枚举_方法状态::待结果节点); }

// 功能：执行任务、方法或动作的主体逻辑。
inline constexpr I64 私有_方法状态_待条件结果对_执行桥_最小_v0() noexcept { return static_cast<I64>(枚举_方法状态::待条件结果对); }

// 功能：执行任务、方法或动作的主体逻辑。
inline constexpr I64 私有_方法状态_可用_执行桥_最小_v0() noexcept { return static_cast<I64>(枚举_方法状态::可用); }

// 功能：执行对应模块、线程或方法的运行逻辑。
inline constexpr I64 私有_方法状态_待运行账_执行桥_最小_v0() noexcept { return 私有_方法状态_可用_执行桥_最小_v0(); }

// 功能：执行任务、方法或动作的主体逻辑。
inline constexpr I64 私有_方法状态_待稳定_执行桥_最小_v0() noexcept { return 私有_方法状态_可用_执行桥_最小_v0(); }

// 功能：执行任务、方法或动作的主体逻辑。
inline I64 私有_方法状态集合当前值_执行桥_最小_v0(
    方法类::节点类* 方法,
    const 语素入口节点类* 明细特征类型,
    I64 当前值,
    I64 目标值) noexcept
{
    // “方法状态”只用一个既有特征承载顺序阶段，避免为每个阶段扩散新特征类型。
    // 明细缺口仍写在“方法状态”下面，集合特征本身记录当前最前置的完善阶段。
    if (语素入口同一(
            明细特征类型,
            私有_方法动作状态特征类型_执行桥_最小_v0())) {
        return 私有_方法状态_待方法动作_执行桥_最小_v0();
    }
    if (语素入口同一(
            明细特征类型,
            私有_方法可执行入口数量特征类型_执行桥_最小_v0())) {
        return 私有_方法状态_待可执行入口_执行桥_最小_v0();
    }
    if (语素入口同一(
            明细特征类型,
            私有_方法条件节点数量特征类型_执行桥_最小_v0())) {
        return 私有_方法状态_待条件节点_执行桥_最小_v0();
    }
    if (语素入口同一(
            明细特征类型,
            私有_方法结果节点数量特征类型_执行桥_最小_v0())) {
        return 私有_方法状态_待结果节点_执行桥_最小_v0();
    }
    if (语素入口同一(
            明细特征类型,
            私有_方法条件结果对数量特征类型_执行桥_最小_v0())) {
        return 私有_方法状态_待条件结果对_执行桥_最小_v0();
    }
    if (语素入口同一(
            明细特征类型,
            私有_方法条件结果配对状态特征类型_执行桥_最小_v0())) {
        return 私有_方法状态_待条件结果对_执行桥_最小_v0();
    }
    if (语素入口同一(
            明细特征类型,
            私有_方法运行账完整性特征类型_执行桥_最小_v0())) {
        return 私有_方法状态_待运行账_执行桥_最小_v0();
    }
    if (语素入口同一(
            明细特征类型,
            私有_方法稳定状态特征类型_执行桥_最小_v0())) {
        return 私有_方法状态_待稳定_执行桥_最小_v0();
    }
    if (语素入口同一(
            明细特征类型,
            私有_方法状态特征类型_执行桥_最小_v0())) {
        if (!方法 || 私有_方法动作数量_执行桥_最小_v0(方法) <= 0) {
            return 私有_方法状态_待方法动作_执行桥_最小_v0();
        }
        if (私有_方法可执行入口数量_执行桥_最小_v0(方法) <= 0) {
            return 私有_方法状态_待可执行入口_执行桥_最小_v0();
        }
        if (私有_方法条件节点数量_执行桥_最小_v0(方法) <= 0) {
            return 私有_方法状态_待条件节点_执行桥_最小_v0();
        }
        if (私有_方法结果节点数量_执行桥_最小_v0(方法) <= 0) {
            return 私有_方法状态_待结果节点_执行桥_最小_v0();
        }
        if (私有_方法条件结果对数量_执行桥_最小_v0(方法) <= 0) {
            return 私有_方法状态_待条件结果对_执行桥_最小_v0();
        }
        return 私有_方法状态_可用_执行桥_最小_v0();
    }
    return static_cast<I64>(0);
}

// 功能：执行任务、方法或动作的主体逻辑。
inline const 语素入口节点类* 私有_参数配对状态特征类型_执行桥_最小_v0() noexcept
{
    static const 语素入口节点类* s_词 = 语素集.添加信息入口词("参数配对状态", 枚举_信息入口类型::特征模板入口);
    return s_词;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline bool 私有_方法允许引导执行_执行桥_最小_v0(const 方法类::节点类* 方法) noexcept
{
    if (!方法
        || 方法->主信息.首节点信息().动作句柄.类型 != 枚举_动作句柄类型::本能函数ID
        || 方法->主信息.首节点信息().动作句柄.本能ID == 0) {
        return false;
    }

    switch (static_cast<枚举_本能方法ID>(方法->主信息.首节点信息().动作句柄.本能ID)) {
    case 枚举_本能方法ID::自我_练习:
    case 枚举_本能方法ID::自我_尝试学习:
    case 枚举_本能方法ID::自我_定向学习:
        return true;
    default:
        return false;
    }
}

// 功能：执行任务、方法或动作的主体逻辑。
inline bool 私有_方法当前可用_执行桥_最小_v0(
    方法类::节点类* 方法,
    时间戳 now) noexcept
{
    if (!方法) {
        return false;
    }
    auto* 方法虚拟存在 = 方法->主信息.首节点信息().方法虚拟存在.指针
        ? 方法->主信息.首节点信息().方法虚拟存在.指针
        : 方法虚拟存在服务类::取或创建方法虚拟存在(
            方法,
            nullptr,
            now);
    I64 方法状态值 = 0;
    if (方法虚拟存在
        && 世界树.读取特征_I64(
            reinterpret_cast<const 基础信息节点类*>(方法虚拟存在),
            私有_方法状态特征类型_执行桥_最小_v0(),
            方法状态值)
        ) {
        return 方法状态值 >= 私有_方法状态_可用_执行桥_最小_v0()
            && 私有_方法条件结果对数量_执行桥_最小_v0(方法) > 0;
    }
    return 私有_方法状态集合当前值_执行桥_最小_v0(
            方法,
            私有_方法状态特征类型_执行桥_最小_v0(),
            0,
            私有_方法状态_可用_执行桥_最小_v0())
        >= 私有_方法状态_可用_执行桥_最小_v0();
}

// 功能：执行任务、方法或动作的主体逻辑。
inline I64 私有_方法条件节点数量_执行桥_最小_v0(const 方法类::节点类* 方法) noexcept
{
    if (!方法 || !方法->子) {
        return 0;
    }
    I64 数量 = 0;
    auto* 首节点 = reinterpret_cast<const 方法类::节点类*>(方法->子);
    auto* 当前 = 首节点;
    std::size_t 保护计数 = 0;
    do {
        if (当前 && 当前->主信息.公共.节点种类 == 枚举_方法节点种类::方法条件节点) {
            ++数量;
        }
        当前 = 当前 ? reinterpret_cast<const 方法类::节点类*>(当前->下) : nullptr;
        ++保护计数;
    } while (当前 && 当前 != 首节点 && 保护计数 < 4096);
    return 数量;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline I64 私有_方法动作数量_执行桥_最小_v0(const 方法类::节点类* 方法) noexcept
{
    return 方法 && 方法->主信息.有方法动作() ? 1 : 0;
}

// 功能：注册方法、模板、对象或运行入口。
inline bool 私有_本能动作运行时已注册_执行桥_最小_v0(I64 本能ID) noexcept
{
    return 本能ID > 0
        && static_cast<unsigned long long>(本能ID) <= (std::numeric_limits<std::uint32_t>::max)()
        && static_cast<枚举_本能方法ID>(static_cast<std::uint32_t>(本能ID)) != 枚举_本能方法ID::未定义
        && 取本能动作集().查询(
            static_cast<枚举_本能动作ID>(
                static_cast<枚举_本能方法ID>(
                    static_cast<std::uint32_t>(本能ID)))).has_value();
}

// 功能：注册方法、模板、对象或运行入口。
inline bool 私有_方法有已注册本能入口_执行桥_最小_v0(const 方法类::节点类* 方法) noexcept
{
    return 方法
        && 方法->主信息.首节点信息().动作句柄.类型 == 枚举_动作句柄类型::本能函数ID
        && 私有_本能动作运行时已注册_执行桥_最小_v0(
            方法->主信息.首节点信息().动作句柄.本能ID);
}

// 功能：执行任务、方法或动作的主体逻辑。
inline I64 私有_方法结果节点数量_执行桥_最小_v0(const 方法类::节点类* 方法) noexcept
{
    if (!方法 || !方法->子) {
        return 0;
    }
    I64 数量 = 0;
    auto* 首节点 = reinterpret_cast<const 方法类::节点类*>(方法->子);
    auto* 当前 = 首节点;
    std::size_t 保护计数 = 0;
    do {
        if (当前) {
            if (当前->主信息.公共.节点种类 == 枚举_方法节点种类::方法条件节点
                && 当前->子) {
                auto* 首结果 = reinterpret_cast<const 方法类::节点类*>(当前->子);
                auto* 结果 = 首结果;
                std::size_t 结果保护 = 0;
                do {
                    if (结果 && 结果->主信息.公共.节点种类 == 枚举_方法节点种类::方法结果节点) {
                        ++数量;
                    }
                    结果 = 结果 ? reinterpret_cast<const 方法类::节点类*>(结果->下) : nullptr;
                    ++结果保护;
                } while (结果 && 结果 != 首结果 && 结果保护 < 1024);
            }
        }
        当前 = 当前 ? reinterpret_cast<const 方法类::节点类*>(当前->下) : nullptr;
        ++保护计数;
    } while (当前 && 当前 != 首节点 && 保护计数 < 4096);
    return 数量;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline I64 私有_方法可执行入口数量_执行桥_最小_v0(const 方法类::节点类* 方法) noexcept
{
    return 私有_方法有已注册本能入口_执行桥_最小_v0(方法)
        ? 1
        : 0;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline I64 私有_方法条件结果对数量_执行桥_最小_v0(const 方法类::节点类* 方法) noexcept
{
    if (!方法 || !方法->子) {
        return 0;
    }
    I64 数量 = 0;
    auto* 首节点 = reinterpret_cast<const 方法类::节点类*>(方法->子);
    auto* 当前 = 首节点;
    std::size_t 保护计数 = 0;
    do {
        if (当前
            && 当前->主信息.公共.节点种类 == 枚举_方法节点种类::方法条件节点
            && 当前->子) {
            auto* 首结果 = reinterpret_cast<const 方法类::节点类*>(当前->子);
            auto* 结果 = 首结果;
            std::size_t 结果保护 = 0;
            do {
                if (结果 && 结果->主信息.公共.节点种类 == 枚举_方法节点种类::方法结果节点) {
                    ++数量;
                }
                结果 = 结果 ? reinterpret_cast<const 方法类::节点类*>(结果->下) : nullptr;
                ++结果保护;
            } while (结果 && 结果 != 首结果 && 结果保护 < 1024);
        }
        当前 = 当前 ? reinterpret_cast<const 方法类::节点类*>(当前->下) : nullptr;
        ++保护计数;
    } while (当前 && 当前 != 首节点 && 保护计数 < 4096);
    return 数量;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline const 语素入口节点类* 私有_执行输出特征_派生需求_执行桥_最小_v0() noexcept
{
    static const 语素入口节点类* s_词 = 语素集.添加信息入口词("派生需求", 枚举_信息入口类型::特征模板入口);
    return s_词;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline const 语素入口节点类* 私有_执行输出特征_派生需求当前状态_执行桥_最小_v0() noexcept
{
    static const 语素入口节点类* s_词 = 语素集.添加信息入口词("派生需求当前状态", 枚举_信息入口类型::特征模板入口);
    return s_词;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline const 语素入口节点类* 私有_执行输出特征_派生需求目标状态_执行桥_最小_v0() noexcept
{
    static const 语素入口节点类* s_词 = 语素集.添加信息入口词("派生需求目标状态", 枚举_信息入口类型::特征模板入口);
    return s_词;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline void 私有_填充主体特征需求状态_执行桥_最小_v0(
    方法类::节点类* 方法,
    基础信息节点类* 目标主体,
    const 语素入口节点类* 特征类型,
    I64 当前值,
    I64 目标值,
    场景节点类*& 结果场景,
    时间戳 now) noexcept
{
    if (!目标主体 || !特征类型) {
        return;
    }

    auto* 状态特征 = 世界树.确保特征(目标主体, 特征类型);
    if (!状态特征) {
        return;
    }
    (void)世界树.写入特征_I64(目标主体, 特征类型, 当前值, now);

    auto* 状态场景 = 结果场景;
    if (!状态场景 && 方法) {
        状态场景 = 方法类::取或创建_方法结果场景(
            方法,
            nullptr,
            now);
    }
    if (!状态场景) {
        状态场景 = 世界树.取或创建自我现实场景();
    }
    if (!状态场景) {
        return;
    }
    结果场景 = 状态场景;

    auto* 当前状态 = 世界树.创建内部状态(
        状态场景,
        目标主体,
        状态特征,
        当前值,
        false,
        now);
    auto* 目标状态 = 世界树.创建内部状态(
        状态场景,
        目标主体,
        状态特征,
        目标值,
        当前值 != 目标值,
        now);
    (void)世界树.写入特征_指针(
        reinterpret_cast<基础信息节点类*>(状态场景),
        私有_执行输出特征_派生需求_执行桥_最小_v0(),
        特征类型,
        now);
    if (当前状态) {
        (void)世界树.写入特征_指针(
            reinterpret_cast<基础信息节点类*>(状态场景),
            私有_执行输出特征_派生需求当前状态_执行桥_最小_v0(),
            当前状态,
            now);
    }
    if (目标状态) {
        (void)世界树.写入特征_指针(
            reinterpret_cast<基础信息节点类*>(状态场景),
            私有_执行输出特征_派生需求目标状态_执行桥_最小_v0(),
            目标状态,
            now);
    }
}

// 功能：执行任务、方法或动作的主体逻辑。
inline void 私有_填充方法特征需求状态_执行桥_最小_v0(
    方法类::节点类* 方法,
    const 语素入口节点类* 特征类型,
    I64 当前值,
    I64 目标值,
    场景节点类*& 结果场景,
    时间戳 now) noexcept
{
    if (!方法 || !特征类型) {
        return;
    }
    auto* 方法虚拟存在 = 方法虚拟存在服务类::取或创建方法虚拟存在(
            方法,
            nullptr,
            now);
    if (!方法虚拟存在) {
        return;
    }
    auto* 方法状态 = 世界树.确保特征(
        reinterpret_cast<基础信息节点类*>(方法虚拟存在),
        私有_方法状态特征类型_执行桥_最小_v0());
    if (方法状态) {
        (void)世界树.写入特征_I64(
            方法状态,
            私有_方法状态集合当前值_执行桥_最小_v0(
                方法,
                特征类型,
                当前值,
                目标值),
            now);
    }
    auto* 目标主体 = 方法状态
        ? reinterpret_cast<基础信息节点类*>(方法状态)
        : reinterpret_cast<基础信息节点类*>(方法虚拟存在);

    私有_填充主体特征需求状态_执行桥_最小_v0(
        方法,
        目标主体,
        特征类型,
        当前值,
        目标值,
        结果场景,
        now);
}

// 功能：执行任务、方法或动作的主体逻辑。
inline 特征节点类* 私有_填充方法不可用执行结果_执行桥_最小_v0(
    方法类::节点类* 方法,
    场景节点类*& 结果场景,
    时间戳 now) noexcept
{
    auto* 方法虚拟存在 = 方法虚拟存在服务类::取或创建方法虚拟存在(
        方法,
        nullptr,
        now);
    if (!方法虚拟存在) {
        return nullptr;
    }

    // 方法状态只表达结构完善顺序；“可用”的最低事实判据是目标方法已有条件结果对。
    // 运行账完整性和稳定性属于“好用/细化”阶段，不能再抬高方法状态的可用阈值。
    const auto 当前方法状态 =
        私有_方法状态集合当前值_执行桥_最小_v0(
            方法,
            私有_方法状态特征类型_执行桥_最小_v0(),
            static_cast<I64>(0),
            私有_方法状态_可用_执行桥_最小_v0());

    私有_填充主体特征需求状态_执行桥_最小_v0(
        方法,
        reinterpret_cast<基础信息节点类*>(方法虚拟存在),
        私有_方法状态特征类型_执行桥_最小_v0(),
        当前方法状态,
        私有_方法状态_可用_执行桥_最小_v0(),
        结果场景,
        now);
    return 创建本能动作运行结果实例_按码(
        方法,
        结果场景,
        本能方法结果_任务缺条件需自我线程,
        now);
}

