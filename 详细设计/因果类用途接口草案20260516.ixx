// 因果类用途接口草案 20260516
//
// 设计定位：
// 本文件是接口草案，不参与当前工程编译。
// 它对应 `规范/因果信息用途与用法规范20260516.md`，用于约束后续因果类改造。
//
// 边界：
// 1. 因果类只提供解释、预测、反推、审查、验收、需求候选和稳定度更新。
// 2. 因果类不直接写任务状态。
// 3. 因果类不直接写正式需求节点。
// 4. 因果类不直接写安全值 / 服务值。
// 5. 正式写入仍由需求域、任务域、方法域、结算域对应方法完成。

#pragma once

#include <cstdint>
#include <vector>

class 动态节点类;
class 状态节点类;
class 因果模板节点类;
class 因果实例节点类;
class 方法节点类;
class 任务节点类;
class 需求节点类;
class 场景节点类;
class 基础信息节点类;

enum class 枚举_因果补完状态 : std::uint8_t {
    无状态变化 = 0,
    仅状态变化线索 = 1,
    已建立完整因果 = 2,
    已补完既有线索 = 3,
};

enum class 枚举_因果评价结果 : std::uint8_t {
    未定义 = 0,
    成立 = 1,
    失败 = 2,
    副作用 = 3,
    待验证 = 4,
};

enum class 枚举_因果学习缺口类型 : std::uint8_t {
    无缺口 = 0,

    缺条件 = 1,
    缺动作 = 2,
    缺结果 = 3,

    缺参数 = 10,
    缺执行入口 = 11,
    缺副作用 = 12,
    缺适用范围 = 13,
    缺验证证据 = 14,
    缺因果来源 = 15,
};

struct 结构_因果补完结果 {
    枚举_因果补完状态 状态 = 枚举_因果补完状态::无状态变化;

    基础信息节点类* 状态变化线索 = nullptr;
    因果模板节点类* 完整因果模板 = nullptr;
    因果实例节点类* 因果实例 = nullptr;

    bool 是完整因果() const noexcept
    {
        return 完整因果模板 != nullptr;
    }
};

struct 结构_因果学习诊断输入 {
    std::vector<状态节点类*> 条件状态{};
    std::vector<状态节点类*> 条件模板{};
    基础信息节点类* 动作语义 = nullptr;
    const char* 动作语义键 = nullptr;
    方法节点类* 候选方法 = nullptr;
    std::vector<状态节点类*> 结果状态{};
    std::vector<状态节点类*> 结果模板{};
    因果模板节点类* 来源因果模板 = nullptr;
    基础信息节点类* 来源状态变化线索 = nullptr;
    bool 有足够验证证据 = false;
};

struct 结构_因果学习缺口诊断结果 {
    枚举_因果学习缺口类型 缺口类型 = 枚举_因果学习缺口类型::无缺口;
    因果模板节点类* 来源因果模板 = nullptr;
    基础信息节点类* 来源状态变化线索 = nullptr;
    方法节点类* 相关方法 = nullptr;
    状态节点类* 目标结果状态 = nullptr;
    std::int64_t 置信度 = 0;
};

struct 结构_学习需求候选 {
    枚举_因果学习缺口类型 缺口类型 = 枚举_因果学习缺口类型::无缺口;

    基础信息节点类* 目标宿主 = nullptr;
    基础信息节点类* 目标特征类型 = nullptr;
    状态节点类* 当前状态 = nullptr;
    状态节点类* 目标状态 = nullptr;

    因果模板节点类* 来源因果模板 = nullptr;
    基础信息节点类* 来源状态变化线索 = nullptr;
    方法节点类* 相关方法 = nullptr;

    std::int64_t 置信度 = 0;
    std::int64_t 优先级 = 0;
};

struct 结构_学习需求候选结果 {
    std::vector<结构_学习需求候选> 候选{};
    bool 已生成正式需求 = false; // 第一版应始终为 false，正式入树归自我线程。
};

struct 结构_因果解释参数 {
    std::uint32_t 最大反推层数 = 3;
    std::uint32_t 最大候选数 = 16;
    bool 允许低置信度候选 = false;
};

struct 结构_因果解释结果 {
    状态节点类* 结果状态 = nullptr;
    std::vector<因果模板节点类*> 原因模板链{};
    std::vector<基础信息节点类*> 状态变化线索链{};
    std::int64_t 最高置信度 = 0;
};

struct 结构_因果预测输入 {
    场景节点类* 当前场景 = nullptr;
    状态节点类* 条件状态 = nullptr;
    方法节点类* 候选方法 = nullptr;
    基础信息节点类* 候选动作语义 = nullptr;
};

struct 结构_因果预测结果 {
    std::vector<状态节点类*> 预测结果状态{};
    std::vector<状态节点类*> 预测副作用状态{};
    std::vector<因果模板节点类*> 命中模板{};
    std::int64_t 置信度 = 0;
    bool 存在硬风险 = false;
};

struct 结构_因果反推输入 {
    状态节点类* 目标结果状态 = nullptr;
    std::uint32_t 最大反推层数 = 3;
    std::uint32_t 最大候选数 = 16;
};

struct 结构_因果反推结果 {
    std::vector<方法节点类*> 候选方法{};
    std::vector<基础信息节点类*> 候选动作语义{};
    std::vector<因果模板节点类*> 支撑模板{};
    std::vector<状态节点类*> 必要条件状态{};
};

struct 结构_因果需求投影参数 {
    需求节点类* 默认父需求 = nullptr;
    bool 只生成候选 = true;
    std::uint32_t 最大投影数 = 8;
};

struct 结构_因果需求投影结果 {
    std::vector<基础信息节点类*> 需求候选信息{};
    std::vector<因果模板节点类*> 来源因果模板{};
    bool 已生成正式需求 = false; // 第一版应始终为 false，正式入树归自我线程。
};

struct 结构_因果审查输入 {
    任务节点类* 来源任务 = nullptr;
    需求节点类* 来源需求 = nullptr;
    方法节点类* 候选方法 = nullptr;
    场景节点类* 输入参数场景 = nullptr;
};

struct 结构_因果审查结果 {
    bool 允许执行 = false;
    bool 触发硬边界 = false;
    std::vector<状态节点类*> 预期收益{};
    std::vector<状态节点类*> 预期风险{};
    std::vector<因果模板节点类*> 审查依据{};
};

struct 结构_因果验收输入 {
    任务节点类* 来源任务 = nullptr;
    需求节点类* 来源需求 = nullptr;
    方法节点类* 执行动作方法 = nullptr;
    动态节点类* 动作动态 = nullptr;
    场景节点类* 输出结果场景 = nullptr;
};

struct 结构_因果验收结果 {
    枚举_因果评价结果 评价 = 枚举_因果评价结果::未定义;
    bool 满足来源需求 = false;
    std::vector<因果模板节点类*> 命中模板{};
    std::vector<状态节点类*> 实际结果状态{};
    std::vector<状态节点类*> 副作用状态{};
};

struct 结构_因果实例评价 {
    因果实例节点类* 因果实例 = nullptr;
    枚举_因果评价结果 评价 = 枚举_因果评价结果::未定义;
    std::int64_t 置信度增量 = 0;
};

struct 结构_因果稳定度更新结果 {
    因果模板节点类* 模板 = nullptr;
    std::int64_t 成立次数 = 0;
    std::int64_t 失败次数 = 0;
    std::int64_t 稳定度 = 0;
    bool 已更新 = false;
};

class 因果类_用途接口草案 {
public:
    // 因果学习六小闭环接口：
    // 1. 按动态补完因果；
    // 2. 诊断学习缺口；
    // 3. 从因果缺口生成学习需求候选；
    // 4. 反推可达动作；
    // 5. 预测动作结果；
    // 6. 验收动作结果。

    // 采集与沉淀：
    // 从动态中提取状态变化；若动作已知，建立完整因果模板；若动作未知，只建立状态变化线索。
    结构_因果补完结果 按动态补完因果(动态节点类* 动态);

    // 学习缺口诊断：
    // 判断当前因果材料缺条件、缺动作、缺结果、缺验证证据，或存在参数、入口、副作用、适用范围等学习缺口。
    结构_因果学习缺口诊断结果 诊断学习缺口(
        const 结构_因果学习诊断输入& 输入);

    // 学习需求候选：
    // 把因果学习缺口转换为学习需求候选信息；正式入树仍由自我线程和需求域方法完成。
    结构_学习需求候选结果 从因果缺口生成学习需求候选(
        const 结构_因果学习缺口诊断结果& 缺口);

    // 解释：
    // 根据结果状态反查可能原因链，只返回解释结果，不直接生成需求或任务。
    结构_因果解释结果 解释状态变化(
        状态节点类* 结果状态,
        const 结构_因果解释参数& 参数);

    // 预测：
    // 根据条件状态和候选动作预测结果、风险和副作用。
    结构_因果预测结果 预测动作结果(
        const 结构_因果预测输入& 输入);

    // 反推：
    // 根据目标结果状态反推出可能动作 / 方法候选，供任务筹办使用。
    结构_因果反推结果 反推可达动作(
        const 结构_因果反推输入& 输入);

    // 需求投影：
    // 从原因链生成需求候选信息；正式入树仍由自我线程通过需求域方法完成。
    结构_因果需求投影结果 从因果解释生成需求候选(
        const 结构_因果解释结果& 解释,
        const 结构_因果需求投影参数& 参数);

    // 执行前审查：
    // 对候选动作做收益、风险和硬边界检查；不直接改任务状态。
    结构_因果审查结果 审查候选动作(
        const 结构_因果审查输入& 输入);

    // 执行后验收：
    // 比较预测结果与实际输出，形成成立 / 失败 / 副作用评价。
    结构_因果验收结果 验收动作结果(
        const 结构_因果验收输入& 输入);

    // 稳定度更新：
    // 根据因果实例评价更新模板成立次数、失败次数和稳定度。
    结构_因果稳定度更新结果 更新因果模板稳定度(
        因果模板节点类* 模板,
        const 结构_因果实例评价& 评价);
};
