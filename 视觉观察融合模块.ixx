struct 结构_体素融合点检查结果 {
    枚举_体素融合点状态 状态 = 枚举_体素融合点状态::无;
    std::uint64_t 新观察占据数量 = 0;
    std::uint64_t 重叠融合点数量 = 0;
    std::uint64_t 相邻融合点数量 = 0;

    // 功能：判断本次融合点检查是否命中可融合关系。
    bool 有融合点() const noexcept
    {
        return 状态 == 枚举_体素融合点状态::有融合点
            && (重叠融合点数量 > 0 || 相邻融合点数量 > 0);
    }
};

