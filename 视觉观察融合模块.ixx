namespace detail {
    // 功能：判断外设空间 AABB 是否为有效闭区间。
    inline bool 外设AABB有效(const 结构_外设空间范围AABB& 范围) noexcept
    {
        return 范围.最小X <= 范围.最大X
            && 范围.最小Y <= 范围.最大Y
            && 范围.最小Z <= 范围.最大Z;
    }

    // 功能：把外设 AABB 转为场景体素 AABB 查询结构。
    inline 场景体素模块::结构_场景体素AABB 转场景体素AABB(
        const 结构_外设空间范围AABB& 范围) noexcept
    {
        return 场景体素模块::结构_场景体素AABB{
            范围.最小X,
            范围.最小Y,
            范围.最小Z,
            范围.最大X,
            范围.最大Y,
            范围.最大Z,
        };
    }

    // 功能：把外设置信度比例转换为 Q10000 评分。
    inline I64 比例转Q10000(double 比例) noexcept
    {
        if (!std::isfinite(比例) || 比例 <= 0.0) return 0;
        if (比例 > 1.0) 比例 = 1.0;
        return 限制I64(static_cast<I64>(std::llround(比例 * 10000.0)), 0, 10000);
    }

    // 功能：按材料中心和先验存在原点计算 L1 距离。
    inline I64 材料到先验L1距离(
        const 结构_视觉融合合法外设材料项& 材料,
        const 场景体素模块::结构_场景体素存在项& 先验项) noexcept
    {
        const auto dx = 饱和绝对差I64(材料.当前中心.X, 先验项.原点X_mm);
        const auto dy = 饱和绝对差I64(材料.当前中心.Y, 先验项.原点Y_mm);
        const auto dz = 饱和绝对差I64(材料.当前中心.Z, 先验项.原点Z_mm);
        return 饱和增加(饱和增加(dx, dy), dz);
    }

    // 功能：选择离材料中心最近的先验存在项。
    inline const 场景体素模块::结构_场景体素存在项* 选择最近先验项(
        const 结构_视觉融合合法外设材料项& 材料,
        const std::vector<场景体素模块::结构_场景体素存在项>& 命中集合,
        I64& 输出距离)
    {
        输出距离 = 0;
        if (命中集合.empty()) return nullptr;
        const 场景体素模块::结构_场景体素存在项* 最佳 = nullptr;
        I64 最佳距离 = (std::numeric_limits<I64>::max)();
        for (const auto& 项 : 命中集合) {
            const I64 距离 = 材料到先验L1距离(材料, 项);
            if (!最佳 || 距离 < 最佳距离) {
                最佳 = &项;
                最佳距离 = 距离;
            }
        }
        输出距离 = 最佳 ? 最佳距离 : 0;
        return 最佳;
    }

    // 功能：追加结构化视觉信息缺口。
    inline void 追加信息缺口(
        结构_视觉观察域结果包& 输出,
        枚举_视觉信息缺口类型 类型,
        const 结构_视觉融合合法外设材料项* 材料,
        I64 先验版本,
        I64 证据值,
        存在节点类* 相关存在 = nullptr)
    {
        结构_视觉信息缺口 缺口{};
        缺口.类型 = 类型;
        缺口.先验版本 = 先验版本;
        缺口.证据值 = 证据值;
        缺口.相关存在 = 相关存在;
        if (材料) {
            缺口.数据项ID = 材料->数据项ID;
            缺口.来源报告ID = 材料->来源报告ID;
            缺口.来源帧ID = 材料->来源帧ID;
        }
        输出.信息缺口集合.push_back(std::move(缺口));
    }

    // 功能：按材料、先验命中和阈值生成观察解释类型。
    inline 枚举_视觉观察解释类型 判断解释类型(
        const 结构_视觉融合合法外设材料项& 材料,
        const 结构_视觉先验匹配评分& 评分,
        const 结构_视觉融合目标约束摘要& 约束) noexcept
    {
        if (材料.深度有效率Q10000 <= 0) return 枚举_视觉观察解释类型::深度缺失;
        if (评分.AABB命中数量 <= 0) return 枚举_视觉观察解释类型::自由空间冲突;
        if (评分.综合评分Q10000 >= std::max<I64>(0, 约束.最低先验匹配评分Q10000)) {
            return 枚举_视觉观察解释类型::先验匹配;
        }
        if (材料.材料质量Q10000 < 5000) return 枚举_视觉观察解释类型::遮挡候选;
        return 枚举_视觉观察解释类型::证据不足;
    }

    // 功能：判断指定坐标六邻域内是否存在父体素占据。
    inline bool 父体素六邻域有占据(
        const VecIU64& 现有父体素,
        const std::uint32_t 包围盒边长,
        const std::uint32_t x,
        const std::uint32_t y,
        const std::uint32_t z) noexcept
    {
        if (x > 0 && 场景体素模块::读取正立方体体素占据位(现有父体素, 包围盒边长, x - 1, y, z)) return true;
        if (x + 1 < 包围盒边长 && 场景体素模块::读取正立方体体素占据位(现有父体素, 包围盒边长, x + 1, y, z)) return true;
        if (y > 0 && 场景体素模块::读取正立方体体素占据位(现有父体素, 包围盒边长, x, y - 1, z)) return true;
        if (y + 1 < 包围盒边长 && 场景体素模块::读取正立方体体素占据位(现有父体素, 包围盒边长, x, y + 1, z)) return true;
        if (z > 0 && 场景体素模块::读取正立方体体素占据位(现有父体素, 包围盒边长, x, y, z - 1)) return true;
        if (z + 1 < 包围盒边长 && 场景体素模块::读取正立方体体素占据位(现有父体素, 包围盒边长, x, y, z + 1)) return true;
        return false;
    }

    // 功能：检查新观察体素候选与现有父体素之间是否存在重叠或相邻融合点。
    inline 结构_体素融合点检查结果 检查体素融合点(
        const VecIU64& 现有父体素,
        const VecIU64& 新观察候选,
        const std::uint32_t 包围盒边长)
    {
        结构_体素融合点检查结果 结果{};
        const auto 总数 = 三维体素总数(包围盒边长);
        const auto 期望块数 = 总数 == 0 ? 0 : (总数 + 63ull) / 64ull;
        if (包围盒边长 < 3 || 总数 == 0) {
            结果.状态 = 枚举_体素融合点状态::输入非法;
            return 结果;
        }
        if (现有父体素.size() < 期望块数) {
            结果.状态 = 枚举_体素融合点状态::缺现有父体素;
            return 结果;
        }
        if (新观察候选.size() < 期望块数) {
            结果.状态 = 枚举_体素融合点状态::缺新观察候选;
            return 结果;
        }

        for (std::uint32_t z = 0; z < 包围盒边长; ++z) {
            for (std::uint32_t y = 0; y < 包围盒边长; ++y) {
                for (std::uint32_t x = 0; x < 包围盒边长; ++x) {
                    if (!场景体素模块::读取正立方体体素占据位(新观察候选, 包围盒边长, x, y, z)) {
                        continue;
                    }
                    ++结果.新观察占据数量;
                    if (场景体素模块::读取正立方体体素占据位(现有父体素, 包围盒边长, x, y, z)) {
                        ++结果.重叠融合点数量;
                    } else if (父体素六邻域有占据(现有父体素, 包围盒边长, x, y, z)) {
                        ++结果.相邻融合点数量;
                    }
                }
            }
        }

        if (结果.新观察占据数量 == 0) {
            结果.状态 = 枚举_体素融合点状态::缺新观察候选;
        } else if (结果.重叠融合点数量 > 0 || 结果.相邻融合点数量 > 0) {
            结果.状态 = 枚举_体素融合点状态::有融合点;
        } else {
            结果.状态 = 枚举_体素融合点状态::无融合点;
        }
        return 结果;
    }

    // 功能：把无符号计数压入 I64 计数范围。
    inline I64 计数转I64(const std::uint64_t 值) noexcept
    {
        return 值 > static_cast<std::uint64_t>((std::numeric_limits<I64>::max)())
            ? (std::numeric_limits<I64>::max)()
            : static_cast<I64>(值);
    }

    // 功能：统计局部体素占据候选中的占据体素数量。
    inline I64 统计局部体素占据数量(const VecIU64& 占据候选) noexcept
    {
        std::uint64_t 数量 = 0;
        for (const auto 块 : 占据候选) {
            数量 += static_cast<std::uint64_t>(std::popcount(块));
            if (数量 > static_cast<std::uint64_t>((std::numeric_limits<I64>::max)())) {
                return (std::numeric_limits<I64>::max)();
            }
        }
        return 计数转I64(数量);
    }

    // 功能：按局部体素完整性和支撑数量给子轮廓候选排序。
    inline I64 局部体素子候选排序分(
        const 结构_体素子轮廓候选& 子候选,
        const I64 占据数量) noexcept
    {
        I64 分数 = 占据数量 > 0 ? 占据数量 : 0;
        分数 = 饱和增加(分数, 计数转I64(子候选.深度支撑像素数量));
        分数 = 饱和增加(分数, 计数转I64(子候选.空间支撑像素数量));
        分数 = 饱和增加(分数, 计数转I64(子候选.彩色像素数量));
        if (子候选.局部体素检查.可作为完整体素候选) {
            分数 = 饱和增加(分数, 10000);
        } else if (子候选.局部体素检查.输入有效 && 子候选.局部体素检查.有占据) {
            分数 = 饱和增加(分数, 1000);
        }
        return 分数;
    }

    // 功能：计算局部体素证据完整性评分，只作为 C 的当前观察域证据评分。
    inline I64 计算局部体素完整性评分Q10000(
        const 结构_体素子轮廓候选& 子候选) noexcept
    {
        if (!子候选.局部体素检查.输入有效
            || !子候选.局部体素检查.有占据
            || 子候选.局部体素占据候选.empty()) {
            return 0;
        }

        I64 分数 = 4000;
        if (子候选.有深度空间支撑) {
            分数 = 饱和增加(分数, 2000);
        }
        if (子候选.局部体素检查.可作为完整体素候选) {
            分数 = 饱和增加(分数, 2500);
        } else if (子候选.局部体素检查.局部包围盒压紧) {
            分数 = 饱和增加(分数, 1500);
        }
        if (!子候选.局部体素检查.触碰外边界) {
            分数 = 饱和增加(分数, 1000);
        }
        if (子候选.深度支撑率Q10000 > 0) {
            分数 = 饱和增加(分数, 子候选.深度支撑率Q10000 / 20);
        }
        return 限制I64(分数, 0, 10000);
    }

    // 功能：选择可挂到观察候选 C 的最佳局部体素子候选。
    inline const 结构_体素子轮廓候选* 选择局部体素证据子候选(
        const 结构_体素加工候选结果包& 候选包,
        I64& 输出占据数量)
    {
        输出占据数量 = 0;
        const 结构_体素子轮廓候选* 最佳 = nullptr;
        I64 最佳分 = 0;
        for (const auto& 子候选 : 候选包.子轮廓候选集合) {
            if (子候选.状态 != 枚举_体素子轮廓候选状态::可生成局部体素候选
                || !子候选.局部体素检查.输入有效
                || !子候选.局部体素检查.有占据
                || 子候选.局部体素占据候选.empty()) {
                continue;
            }
            const I64 占据数量 = 统计局部体素占据数量(子候选.局部体素占据候选);
            const I64 分数 = 局部体素子候选排序分(子候选, 占据数量);
            if (!最佳 || 分数 > 最佳分) {
                最佳 = &子候选;
                最佳分 = 分数;
                输出占据数量 = 占据数量;
            }
        }
        return 最佳;
    }

    // 功能：返回轮廓视角声明尺寸对应的像素数量，非法尺寸返回 0。
    inline std::size_t 轮廓视角像素数量(const 结构_三维体素轮廓图视角& 视角) noexcept
    {
        if (视角.宽度 == 0 || 视角.高度 == 0) return 0;
        const auto 宽64 = static_cast<std::uint64_t>(视角.宽度);
        const auto 高64 = static_cast<std::uint64_t>(视角.高度);
        if (宽64 > static_cast<std::uint64_t>((std::numeric_limits<std::size_t>::max)()) / 高64) {
            return 0;
        }
        return static_cast<std::size_t>(宽64 * 高64);
    }

    // 功能：判断轮廓视角是否具备彩色分解所需的掩码和颜色数组。
    inline bool 彩色轮廓视角可分解(const 结构_三维体素轮廓图视角& 视角) noexcept
    {
        const auto 像素数 = 轮廓视角像素数量(视角);
        return 像素数 > 0
            && 视角.轮廓掩码.size() >= 像素数
            && 视角.颜色_RGBA.size() >= 像素数;
    }

    // 功能：判断候选深度视角是否能对齐彩色轮廓像素。
    inline bool 深度轮廓视角可支撑(
        const 结构_三维体素轮廓图视角& 彩色视角,
        const 结构_三维体素轮廓图视角& 深度视角) noexcept
    {
        const auto 像素数 = 轮廓视角像素数量(彩色视角);
        return 像素数 > 0
            && 深度视角.宽度 == 彩色视角.宽度
            && 深度视角.高度 == 彩色视角.高度
            && 深度视角.深度_mm.size() >= 像素数
            && 深度视角.空间点_mm.size() >= 像素数;
    }

    // 功能：选择与彩色轮廓同尺寸的深度视角，优先使用独立深度视角。
    inline const 结构_三维体素轮廓图视角* 选择深度支撑视角(
        const 结构_三维体素轮廓图视角& 彩色视角,
        const 结构_三维体素轮廓图视角& 深度视角) noexcept
    {
        if (深度轮廓视角可支撑(彩色视角, 深度视角)) return &深度视角;
        if (深度轮廓视角可支撑(彩色视角, 彩色视角)) return &彩色视角;
        return nullptr;
    }

    // 功能：判断 RGBA 值是否代表可参与颜色分解的像素。
    inline bool 颜色值有效(const std::uint32_t rgba) noexcept
    {
        return rgba != 0;
    }

    // 功能：把 RGBA 颜色压缩成候选分区键，只用于运行期颜色连通分区。
    inline std::uint32_t 量化颜色键(const std::uint32_t rgba) noexcept
    {
        const auto r = (rgba >> 16) & 0xffu;
        const auto g = (rgba >> 8) & 0xffu;
        const auto b = rgba & 0xffu;
        return ((r >> 4) << 8) | ((g >> 4) << 4) | (b >> 4);
    }

    struct 结构_RGBA累积 {
        std::uint64_t A = 0;
        std::uint64_t R = 0;
        std::uint64_t G = 0;
        std::uint64_t B = 0;
        std::uint64_t 数量 = 0;
    };

    // 功能：把一个 RGBA 像素加入平均颜色累积器。
    inline void 累积RGBA(结构_RGBA累积& 累积, const std::uint32_t rgba) noexcept
    {
        if (!颜色值有效(rgba)) return;
        累积.A += (rgba >> 24) & 0xffu;
        累积.R += (rgba >> 16) & 0xffu;
        累积.G += (rgba >> 8) & 0xffu;
        累积.B += rgba & 0xffu;
        ++累积.数量;
    }

    // 功能：从 RGBA 累积器生成平均颜色统计。
    inline 结构_体素颜色平均统计 完成颜色统计(const 结构_RGBA累积& 累积) noexcept
    {
        结构_体素颜色平均统计 统计{};
        if (累积.数量 == 0) return 统计;
        const auto a = static_cast<std::uint32_t>(累积.A / 累积.数量) & 0xffu;
        const auto r = static_cast<std::uint32_t>(累积.R / 累积.数量) & 0xffu;
        const auto g = static_cast<std::uint32_t>(累积.G / 累积.数量) & 0xffu;
        const auto b = static_cast<std::uint32_t>(累积.B / 累积.数量) & 0xffu;
        统计.有效 = true;
        统计.像素数量 = 累积.数量;
        统计.平均颜色RGBA = (a << 24) | (r << 16) | (g << 8) | b;
        return 统计;
    }

    // 功能：按已确认子轮廓掩码扣除区域后计算父基础平均颜色。
    inline 结构_体素颜色平均统计 计算父基础颜色统计(
        const 结构_三维体素轮廓图视角& 彩色视角,
        const std::vector<std::uint8_t>& 已确认子轮廓掩码)
    {
        结构_RGBA累积 累积{};
        if (!彩色轮廓视角可分解(彩色视角)) return {};

        const auto 像素数 = 轮廓视角像素数量(彩色视角);
        const bool 有排除掩码 = 已确认子轮廓掩码.size() >= 像素数;
        for (std::size_t i = 0; i < 像素数; ++i) {
            if (彩色视角.轮廓掩码[i] == 0) continue;
            if (有排除掩码 && 已确认子轮廓掩码[i] != 0) continue;
            累积RGBA(累积, 彩色视角.颜色_RGBA[i]);
        }
        return 完成颜色统计(累积);
    }

    // 功能：判断深度视角指定像素是否有有效深度值。
    inline bool 像素深度有效(
        const 结构_三维体素轮廓图视角& 深度视角,
        const std::size_t 索引) noexcept
    {
        return 索引 < 深度视角.深度_mm.size()
            && 深度视角.深度_mm[索引] > 0;
    }

    // 功能：判断深度视角指定像素是否有有效空间点。
    inline bool 像素空间点有效(
        const 结构_三维体素轮廓图视角& 深度视角,
        const std::size_t 索引) noexcept
    {
        return 索引 < 深度视角.空间点_mm.size()
            && 深度视角.空间点_mm[索引].z > 0;
    }

    // 功能：创建正立方体 VecIU64 位块，非法尺寸返回空位块。
    inline VecIU64 创建正立方体体素位块(
        const std::uint32_t 包围盒边长,
        const std::uint64_t 最大扫描体素数)
    {
        const auto 总数 = 三维体素总数(包围盒边长);
        if (包围盒边长 < 3 || 总数 == 0 || 总数 > 最大扫描体素数) return {};
        const auto 块数 = (总数 + 63ull) / 64ull;
        if (块数 > static_cast<std::uint64_t>((std::numeric_limits<std::size_t>::max)())) return {};
        return VecIU64(static_cast<std::size_t>(块数), 0);
    }

    // 功能：设置正立方体 VecIU64 位块中的占据状态。
    inline bool 设置正立方体体素占据位(
        VecIU64& 占据位块,
        const std::uint32_t 包围盒边长,
        const std::uint32_t x,
        const std::uint32_t y,
        const std::uint32_t z) noexcept
    {
        if (包围盒边长 < 3 || x >= 包围盒边长 || y >= 包围盒边长 || z >= 包围盒边长) {
            return false;
        }
        const auto 索引 =
            (static_cast<std::uint64_t>(z) * 包围盒边长 + y) * 包围盒边长 + x;
        const auto 块索引 = 索引 / 64ull;
        const auto 位索引 = 索引 % 64ull;
        if (块索引 >= 占据位块.size()) return false;
        占据位块[static_cast<std::size_t>(块索引)] |= (1ull << 位索引);
        return true;
    }

    // 功能：把局部像素偏移映射到保留外边界后的有效区坐标。
    inline std::uint32_t 映射到体素有效区(
        const std::uint32_t 偏移,
        const std::uint32_t 跨度,
        const std::uint32_t 包围盒边长) noexcept
    {
        if (包围盒边长 < 3) return 0;
        const auto 有效格数 = 包围盒边长 - 2;
        if (跨度 <= 1 || 有效格数 <= 1) return 1;
        const auto 分母 = static_cast<std::uint64_t>(跨度 - 1);
        const auto 分子 = static_cast<std::uint64_t>(偏移) * (有效格数 - 1);
        const auto 映射偏移 = static_cast<std::uint32_t>((分子 + 分母 / 2) / 分母);
        return 1 + std::min<std::uint32_t>(映射偏移, 有效格数 - 1);
    }

    // 功能：按彩色连通分区和深度支撑生成子轮廓候选集合。
    inline std::vector<结构_体素子轮廓候选> 生成子轮廓候选集合(
        const 结构_三维体素轮廓图视角& 彩色视角,
        const 结构_三维体素轮廓图视角& 深度视角,
        const std::uint64_t 最大候选数量,
        const std::uint64_t 最大扫描体素数)
    {
        std::vector<结构_体素子轮廓候选> 输出{};
        if (!彩色轮廓视角可分解(彩色视角)) return 输出;

        const auto 像素数 = 轮廓视角像素数量(彩色视角);
        const auto 宽 = static_cast<std::size_t>(彩色视角.宽度);
        const auto 高 = static_cast<std::size_t>(彩色视角.高度);
        const auto* 深度支撑视角 = 选择深度支撑视角(彩色视角, 深度视角);
        const auto 候选上限 = std::max<std::uint64_t>(1, 最大候选数量);
        std::vector<std::uint8_t> 已访问(像素数, 0);
        std::vector<std::size_t> 栈{};
        std::vector<std::size_t> 连通像素{};

        for (std::size_t 起点 = 0; 起点 < 像素数 && 输出.size() < 候选上限; ++起点) {
            if (已访问[起点] != 0 || 彩色视角.轮廓掩码[起点] == 0) continue;
            const auto 起点颜色 = 彩色视角.颜色_RGBA[起点];
            if (!颜色值有效(起点颜色)) {
                已访问[起点] = 1;
                continue;
            }

            const auto 颜色键 = 量化颜色键(起点颜色);
            栈.clear();
            连通像素.clear();
            栈.push_back(起点);
            已访问[起点] = 1;

            while (!栈.empty()) {
                const auto 当前 = 栈.back();
                栈.pop_back();
                连通像素.push_back(当前);

                const auto x = 当前 % 宽;
                const auto y = 当前 / 宽;
                const auto 尝试压入 = [&](const std::size_t nx, const std::size_t ny) {
                    if (nx >= 宽 || ny >= 高) return;
                    const auto 邻居 = ny * 宽 + nx;
                    if (邻居 >= 像素数 || 已访问[邻居] != 0 || 彩色视角.轮廓掩码[邻居] == 0) return;
                    const auto 邻居颜色 = 彩色视角.颜色_RGBA[邻居];
                    if (!颜色值有效(邻居颜色) || 量化颜色键(邻居颜色) != 颜色键) return;
                    已访问[邻居] = 1;
                    栈.push_back(邻居);
                };

                if (x > 0) 尝试压入(x - 1, y);
                尝试压入(x + 1, y);
                if (y > 0) 尝试压入(x, y - 1);
                尝试压入(x, y + 1);
            }

            if (连通像素.empty()) continue;

            结构_体素子轮廓候选 候选{};
            候选.候选ID = 计数转I64(static_cast<std::uint64_t>(输出.size() + 1));
            候选.颜色键 = 颜色键;
            候选.彩色像素数量 = static_cast<std::uint64_t>(连通像素.size());

            std::size_t 最小X = 宽;
            std::size_t 最小Y = 高;
            std::size_t 最大X = 0;
            std::size_t 最大Y = 0;
            I64 最小深度 = (std::numeric_limits<I64>::max)();
            I64 最大深度 = 0;
            结构_RGBA累积 颜色累积{};

            for (const auto 索引 : 连通像素) {
                const auto x = 索引 % 宽;
                const auto y = 索引 / 宽;
                最小X = std::min(最小X, x);
                最小Y = std::min(最小Y, y);
                最大X = std::max(最大X, x);
                最大Y = std::max(最大Y, y);
                累积RGBA(颜色累积, 彩色视角.颜色_RGBA[索引]);
                if (深度支撑视角 && 像素深度有效(*深度支撑视角, 索引)) {
                    ++候选.深度支撑像素数量;
                    if (像素空间点有效(*深度支撑视角, 索引)) {
                        ++候选.空间支撑像素数量;
                        const auto 深度值 = 深度支撑视角->深度_mm[索引];
                        最小深度 = std::min<I64>(最小深度, 深度值);
                        最大深度 = std::max<I64>(最大深度, 深度值);
                    }
                }
            }

            候选.颜色统计 = 完成颜色统计(颜色累积);
            候选.深度支撑率Q10000 = 候选.彩色像素数量 > 0
                ? 比例转Q10000(static_cast<double>(候选.深度支撑像素数量)
                    / static_cast<double>(候选.彩色像素数量))
                : 0;
            候选.有深度空间支撑 =
                候选.深度支撑像素数量 > 0 && 候选.空间支撑像素数量 > 0;

            if (!候选.有深度空间支撑) {
                候选.状态 = 枚举_体素子轮廓候选状态::表面区域;
                输出.push_back(std::move(候选));
                continue;
            }

            const auto 组件宽 = static_cast<std::uint32_t>(最大X - 最小X + 1);
            const auto 组件高 = static_cast<std::uint32_t>(最大Y - 最小Y + 1);
            auto 规格 = 场景体素模块::计算正立方体体素包围盒规格_按占据尺寸(组件宽, 组件高, 1);
            候选.局部包围盒边长 = 规格.包围盒边长;
            候选.局部体素占据候选 = 创建正立方体体素位块(
                候选.局部包围盒边长,
                最大扫描体素数);

            if (规格.有效 && !候选.局部体素占据候选.empty()) {
                for (const auto 索引 : 连通像素) {
                    if (!深度支撑视角
                        || !像素深度有效(*深度支撑视角, 索引)
                        || !像素空间点有效(*深度支撑视角, 索引)) {
                        continue;
                    }
                    const auto x = 索引 % 宽;
                    const auto y = 索引 / 宽;
                    const auto 局部X = 映射到体素有效区(
                        static_cast<std::uint32_t>(x - 最小X),
                        组件宽,
                        候选.局部包围盒边长);
                    const auto 局部Y = 映射到体素有效区(
                        static_cast<std::uint32_t>(y - 最小Y),
                        组件高,
                        候选.局部包围盒边长);
                    std::uint32_t 局部Z = 1;
                    if (最大深度 > 最小深度 && 候选.局部包围盒边长 > 3) {
                        const auto 有效格数 = 候选.局部包围盒边长 - 2;
                        const auto 比例 = static_cast<double>(深度支撑视角->深度_mm[索引] - 最小深度)
                            / static_cast<double>(最大深度 - 最小深度);
                        const auto 映射 = static_cast<std::uint32_t>(
                            std::llround(std::max(0.0, std::min(1.0, 比例)) * (有效格数 - 1)));
                        局部Z = 1 + std::min<std::uint32_t>(映射, 有效格数 - 1);
                    }
                    设置正立方体体素占据位(
                        候选.局部体素占据候选,
                        候选.局部包围盒边长,
                        局部X,
                        局部Y,
                        局部Z);
                }
                候选.局部体素检查 = 场景体素模块::检查正立方体体素包围盒(
                    候选.局部体素占据候选,
                    候选.局部包围盒边长,
                    最大扫描体素数);
                候选.状态 = 候选.局部体素检查.有占据
                    ? 枚举_体素子轮廓候选状态::可生成局部体素候选
                    : 枚举_体素子轮廓候选状态::未解释候选;
                if (候选.状态 == 枚举_体素子轮廓候选状态::可生成局部体素候选) {
                    候选.局部子体素候选ID = 候选.候选ID;
                }
            } else {
                候选.状态 = 枚举_体素子轮廓候选状态::未解释候选;
            }
            输出.push_back(std::move(候选));
        }

        return 输出;
    }
}

// 功能：把视觉信息缺口类型映射为 D5 结构化缺口大类 I64 值域。
I64 视觉信息缺口_结构化缺口大类(枚举_视觉信息缺口类型 类型) noexcept
{
    switch (类型) {
    case 枚举_视觉信息缺口类型::无:
        return 0;
    case 枚举_视觉信息缺口类型::缺SceneVoxelPrior:
    case 枚举_视觉信息缺口类型::先验坐标系版本缺失:
    case 枚举_视觉信息缺口类型::先验结构缺口:
        return 7;
    case 枚举_视觉信息缺口类型::缺合法外设材料:
        return 1;
    case 枚举_视觉信息缺口类型::材料空间范围无效:
        return 4;
    case 枚举_视觉信息缺口类型::材料不可比较:
    case 枚举_视觉信息缺口类型::证据不足:
        return 2;
    case 枚举_视觉信息缺口类型::深度缺失:
        return 3;
    default:
        return 0;
    }
}

// 功能：把视觉信息缺口类型映射为 D5 结构化阻断阶段 I64 值域。
I64 视觉信息缺口_结构化阻断阶段(枚举_视觉信息缺口类型 类型) noexcept
{
    switch (类型) {
    case 枚举_视觉信息缺口类型::无:
        return 0;
    case 枚举_视觉信息缺口类型::缺SceneVoxelPrior:
    case 枚举_视觉信息缺口类型::先验坐标系版本缺失:
    case 枚举_视觉信息缺口类型::先验结构缺口:
        return 7;
    case 枚举_视觉信息缺口类型::缺合法外设材料:
        return 1;
    case 枚举_视觉信息缺口类型::材料空间范围无效:
        return 3;
    case 枚举_视觉信息缺口类型::材料不可比较:
    case 枚举_视觉信息缺口类型::证据不足:
        return 8;
    case 枚举_视觉信息缺口类型::深度缺失:
        return 2;
    default:
        return 0;
    }
}

// 功能：把视觉信息缺口类型映射为 D5 需求化处理建议 I64 值域，不直接创建需求。
I64 视觉信息缺口_需求化处理建议(枚举_视觉信息缺口类型 类型) noexcept
{
    switch (类型) {
    case 枚举_视觉信息缺口类型::无:
        return 0;
    case 枚举_视觉信息缺口类型::缺SceneVoxelPrior:
    case 枚举_视觉信息缺口类型::先验坐标系版本缺失:
    case 枚举_视觉信息缺口类型::先验结构缺口:
    case 枚举_视觉信息缺口类型::材料不可比较:
        return 11;
    case 枚举_视觉信息缺口类型::缺合法外设材料:
        return 6;
    case 枚举_视觉信息缺口类型::材料空间范围无效:
        return 7;
    case 枚举_视觉信息缺口类型::深度缺失:
    case 枚举_视觉信息缺口类型::证据不足:
        return 1;
    default:
        return 0;
    }
}

class 视觉观察融合类 {
public:
    // 功能：从扫描提交包提取公开合法外设材料项，供融合模块运行期使用。
    static std::vector<结构_视觉融合合法外设材料项> 从扫描提交包提取合法外设材料(
        const 结构_外设扫描提交包& 扫描包)
    {
        std::vector<结构_视觉融合合法外设材料项> 输出{};
        std::uint64_t 序号 = 0;
        for (const auto& 已知 : 扫描包.已知存在结果) {
            结构_视觉融合合法外设材料项 项{};
            项.数据项ID = ++序号;
            项.来源报告ID = 扫描包.包头.报告ID;
            项.来源帧ID = 扫描包.包头.帧ID != 0 ? 扫描包.包头.帧ID : 扫描包.当前帧ID;
            项.已确认存在ID = 已知.已确认存在ID;
            项.当前中心 = 已知.当前中心;
            项.当前空间范围 = 已知.当前空间范围;
            项.空间中心有效 = 已知.当前中心.X != 0 || 已知.当前中心.Y != 0 || 已知.当前中心.Z != 0;
            项.空间范围有效 = detail::外设AABB有效(已知.当前空间范围);
            项.可回查 = !已知.当前点集句柄.empty() || !已知.当前深度切片句柄.empty();
            项.可比较 = 项.空间范围有效 && 项.可回查;
            项.可生成候选 = 项.可比较;
            项.材料质量Q10000 = detail::比例转Q10000(已知.匹配置信度);
            项.深度有效率Q10000 = 扫描包.深度有效率 > 0.0
                ? detail::比例转Q10000(扫描包.深度有效率)
                : (已知.当前深度切片句柄.empty() ? 0 : 10000);
            项.空间坐标有效率Q10000 = 扫描包.空间坐标有效率 > 0.0
                ? detail::比例转Q10000(扫描包.空间坐标有效率)
                : (项.空间范围有效 ? 10000 : 0);
            项.候选像素数量 = 已知.候选像素数量;
            项.候选有效深度点数量 = 已知.候选有效深度点数量;
            项.候选争议像素数量 = 已知.候选争议像素数量;
            项.候选遮挡边界像素数量 = 已知.候选遮挡边界像素数量;
            项.候选深度缺失像素数量 = 已知.候选深度缺失像素数量;
            项.候选低质量像素数量 = 已知.候选低质量像素数量;
            项.候选像素归属质量评分Q10000 = 已知.候选像素归属质量评分Q10000;
            输出.push_back(std::move(项));
        }
        return 输出;
    }

    // 功能：融合合法外设材料和 SceneVoxelPrior，输出观察域候选、评分、解释和缺口。
    static 结构_视觉观察域结果包 融合观察域结果(const 结构_视觉融合输入& 输入)
    {
        结构_视觉观察域结果包 输出{};
        输出.先验版本 = 输入.SceneVoxelPrior.版本;
        输出.先验坐标系版本 = 输入.SceneVoxelPrior.坐标系版本;
        输出.合法材料数量 = static_cast<I64>(std::min<std::size_t>(
            输入.合法外设材料集合.size(),
            static_cast<std::size_t>((std::numeric_limits<I64>::max)())));

        if (输入.SceneVoxelPrior.版本 <= 0) {
            detail::追加信息缺口(
                输出,
                枚举_视觉信息缺口类型::缺SceneVoxelPrior,
                nullptr,
                输入.SceneVoxelPrior.版本,
                输入.SceneVoxelPrior.版本);
        }
        if (输入.SceneVoxelPrior.坐标系版本 <= 0) {
            detail::追加信息缺口(
                输出,
                枚举_视觉信息缺口类型::先验坐标系版本缺失,
                nullptr,
                输入.SceneVoxelPrior.版本,
                输入.SceneVoxelPrior.坐标系版本);
        }
        for (const auto& 先验缺口 : 输入.SceneVoxelPrior.缺口集合) {
            detail::追加信息缺口(
                输出,
                枚举_视觉信息缺口类型::先验结构缺口,
                nullptr,
                输入.SceneVoxelPrior.版本,
                static_cast<I64>(先验缺口.类型),
                先验缺口.存在.指针);
        }
        if (输入.SceneVoxelPrior.版本 > 0) {
            const auto 快照已有缺口 = [&](场景体素模块::枚举_场景体素缺口类型 类型) {
                return std::any_of(
                    输入.SceneVoxelPrior.缺口集合.begin(),
                    输入.SceneVoxelPrior.缺口集合.end(),
                    [类型](const 场景体素模块::结构_场景体素缺口项& 缺口) {
                        return 缺口.类型 == 类型;
                    });
            };
            const auto 补充缺失图层缺口 = [&](bool 图层句柄有效, 场景体素模块::枚举_场景体素缺口类型 缺口类型) {
                if (图层句柄有效 || 快照已有缺口(缺口类型)) return;
                detail::追加信息缺口(
                    输出,
                    枚举_视觉信息缺口类型::先验结构缺口,
                    nullptr,
                    输入.SceneVoxelPrior.版本,
                    static_cast<I64>(缺口类型));
            };

            补充缺失图层缺口(
                输入.SceneVoxelPrior.先验感兴趣区域集合句柄.有效(),
                场景体素模块::枚举_场景体素缺口类型::缺先验投影索引);
            补充缺失图层缺口(
                输入.SceneVoxelPrior.预计深度范围图句柄.有效(),
                场景体素模块::枚举_场景体素缺口类型::缺预计深度范围图);
            补充缺失图层缺口(
                输入.SceneVoxelPrior.预计遮挡区域句柄.有效(),
                场景体素模块::枚举_场景体素缺口类型::缺可见性预计算);
            补充缺失图层缺口(
                输入.SceneVoxelPrior.已知空闲区句柄.有效(),
                场景体素模块::枚举_场景体素缺口类型::缺已知空闲区);
            补充缺失图层缺口(
                输入.SceneVoxelPrior.未知区句柄.有效(),
                场景体素模块::枚举_场景体素缺口类型::缺未知区);
            补充缺失图层缺口(
                输入.SceneVoxelPrior.自由空间冲突候选区句柄.有效(),
                场景体素模块::枚举_场景体素缺口类型::缺已知空闲区);
            补充缺失图层缺口(
                输入.SceneVoxelPrior.可见性预计算结果句柄.有效(),
                场景体素模块::枚举_场景体素缺口类型::缺可见性预计算);
        }
        if (输入.合法外设材料集合.empty()) {
            detail::追加信息缺口(
                输出,
                枚举_视觉信息缺口类型::缺合法外设材料,
                nullptr,
                输入.SceneVoxelPrior.版本,
                0);
        }

        for (const auto& 材料 : 输入.合法外设材料集合) {
            if (!材料.空间范围有效 || !detail::外设AABB有效(材料.当前空间范围)) {
                detail::追加信息缺口(
                    输出,
                    枚举_视觉信息缺口类型::材料空间范围无效,
                    &材料,
                    输入.SceneVoxelPrior.版本,
                    0);
                continue;
            }
            if (!材料.可比较) {
                detail::追加信息缺口(
                    输出,
                    枚举_视觉信息缺口类型::材料不可比较,
                    &材料,
                    输入.SceneVoxelPrior.版本,
                    0);
                continue;
            }
            if (材料.深度有效率Q10000 <= 0) {
                ++输出.深度缺失数量;
                detail::追加信息缺口(
                    输出,
                    枚举_视觉信息缺口类型::深度缺失,
                    &材料,
                    输入.SceneVoxelPrior.版本,
                    材料.深度有效率Q10000);
            }

            const auto 查询范围 = detail::转场景体素AABB(材料.当前空间范围);
            const auto 命中集合 = 场景体素模块::场景体素缓存类::查询AABB(
                输入.SceneVoxelPrior,
                查询范围);

            I64 最近距离 = 0;
            const auto* 最佳先验 = detail::选择最近先验项(材料, 命中集合, 最近距离);

            结构_视觉先验匹配评分 评分{};
            评分.数据项ID = 材料.数据项ID;
            评分.先验版本 = 输入.SceneVoxelPrior.版本;
            评分.先验坐标系版本 = 输入.SceneVoxelPrior.坐标系版本;
            评分.AABB命中数量 = static_cast<I64>(std::min<std::size_t>(
                命中集合.size(),
                static_cast<std::size_t>((std::numeric_limits<I64>::max)())));
            评分.最近先验距离_mm = 最近距离;
            评分.空间重叠评分Q10000 = 评分.AABB命中数量 > 0 ? 10000 : 0;
            评分.深度一致评分Q10000 = 最佳先验
                ? 深度差异评分(饱和绝对差I64(材料.当前中心.Z, 最佳先验->原点Z_mm))
                : 0;
            评分.材料质量评分Q10000 = 限制I64(材料.材料质量Q10000, 0, 10000);
            评分.综合评分Q10000 = 限制I64(
                (评分.空间重叠评分Q10000 + 评分.深度一致评分Q10000 + 评分.材料质量评分Q10000) / 3,
                0,
                10000);
            if (最佳先验) 评分.最佳先验存在 = 最佳先验->存在.指针;

            const auto 解释类型 = detail::判断解释类型(材料, 评分, 输入.目标约束);
            结构_视觉观察候选 候选{};
            候选.数据项ID = 材料.数据项ID;
            候选.解释类型 = 解释类型;
            候选.先验评分 = 评分;
            候选.候选像素数量 = 材料.候选像素数量;
            候选.候选有效深度点数量 = 材料.候选有效深度点数量;
            候选.候选争议像素数量 = 材料.候选争议像素数量;
            候选.候选遮挡边界像素数量 = 材料.候选遮挡边界像素数量;
            候选.候选深度缺失像素数量 = 材料.候选深度缺失像素数量;
            候选.候选低质量像素数量 = 材料.候选低质量像素数量;
            候选.候选像素归属质量评分Q10000 = 材料.候选像素归属质量评分Q10000;
            候选.候选使用场景体素版本 = 输入.SceneVoxelPrior.版本;
            候选.候选匹配先验短编号 = 评分.AABB命中数量 > 0 ? 1 : 0;
            候选.候选先验投影重叠率Q10000 = 评分.空间重叠评分Q10000;
            候选.候选先验深度一致评分Q10000 = 评分.深度一致评分Q10000;
            候选.候选自由空间冲突数量 =
                解释类型 == 枚举_视觉观察解释类型::自由空间冲突 ? 1 : 0;
            输出.候选集合.push_back(std::move(候选));
            输出.先验匹配评分集合.push_back(评分);

            if (评分.AABB命中数量 > 0) {
                ++输出.先验匹配数量;
            }
            if (解释类型 == 枚举_视觉观察解释类型::遮挡候选) {
                ++输出.遮挡候选数量;
            }
            if (解释类型 == 枚举_视觉观察解释类型::自由空间冲突) {
                结构_视觉自由空间冲突候选 冲突{};
                冲突.数据项ID = 材料.数据项ID;
                冲突.先验版本 = 输入.SceneVoxelPrior.版本;
                冲突.冲突数量 = 1;
                冲突.材料质量Q10000 = 材料.材料质量Q10000;
                冲突.当前空间范围 = 材料.当前空间范围;
                输出.自由空间冲突候选集合.push_back(std::move(冲突));
            }
        }

        输出.候选数量 = static_cast<I64>(std::min<std::size_t>(
            输出.候选集合.size(),
            static_cast<std::size_t>((std::numeric_limits<I64>::max)())));
        输出.自由空间冲突候选数量 = static_cast<I64>(std::min<std::size_t>(
            输出.自由空间冲突候选集合.size(),
            static_cast<std::size_t>((std::numeric_limits<I64>::max)())));
        输出.信息缺口数量 = static_cast<I64>(std::min<std::size_t>(
            输出.信息缺口集合.size(),
            static_cast<std::size_t>((std::numeric_limits<I64>::max)())));
        return 输出;
    }

    // 功能：按 D9 观察域先验材料收束先验一致性评分，不确认 E 当前存在或消失。
    static 结构_先验一致性评分 计算先验一致性评分(const 结构_视觉观察域结果包& 观察域结果)
    {
        auto 追加阻断 = [](I64& 掩码, 枚举_先验一致性阻断原因 原因) noexcept {
            掩码 |= static_cast<I64>(原因);
        };

        结构_先验一致性评分 输出{};
        输出.先验版本 = 观察域结果.先验版本;
        输出.先验坐标系版本 = 观察域结果.先验坐标系版本;
        输出.合法材料数量 = 观察域结果.合法材料数量;
        输出.候选数量 = 观察域结果.候选数量;
        输出.先验匹配数量 = 观察域结果.先验匹配数量;
        输出.自由空间冲突候选数量 = 观察域结果.自由空间冲突候选数量;
        输出.遮挡候选数量 = 观察域结果.遮挡候选数量;
        输出.深度缺失数量 = 观察域结果.深度缺失数量;
        输出.信息缺口数量 = 观察域结果.信息缺口数量;

        const 结构_视觉先验匹配评分* 最佳评分 = nullptr;
        for (const auto& 评分 : 观察域结果.先验匹配评分集合) {
            输出.AABB命中数量 = 饱和增加(输出.AABB命中数量, 评分.AABB命中数量);
            if (!最佳评分
                || 评分.综合评分Q10000 > 最佳评分->综合评分Q10000
                || (评分.综合评分Q10000 == 最佳评分->综合评分Q10000
                    && 评分.深度一致评分Q10000 > 最佳评分->深度一致评分Q10000)) {
                最佳评分 = &评分;
            }
        }

        if (最佳评分) {
            输出.最近先验距离_mm = 最佳评分->最近先验距离_mm;
            输出.空间重叠评分Q10000 = 限制I64(最佳评分->空间重叠评分Q10000, 0, 10000);
            输出.深度一致评分Q10000 = 限制I64(最佳评分->深度一致评分Q10000, 0, 10000);
            输出.材料质量评分Q10000 = 限制I64(最佳评分->材料质量评分Q10000, 0, 10000);
            输出.最佳先验综合评分Q10000 = 限制I64(最佳评分->综合评分Q10000, 0, 10000);
            输出.最佳先验数据项ID = static_cast<I64>((std::min<std::uint64_t>)(
                最佳评分->数据项ID,
                static_cast<std::uint64_t>((std::numeric_limits<I64>::max)())));
        }

        if (输出.先验版本 <= 0) {
            追加阻断(输出.阻断原因掩码, 枚举_先验一致性阻断原因::缺SceneVoxelPrior);
        }
        if (输出.先验坐标系版本 <= 0) {
            追加阻断(输出.阻断原因掩码, 枚举_先验一致性阻断原因::先验坐标版本缺失);
        }
        if (输出.合法材料数量 <= 0) {
            追加阻断(输出.阻断原因掩码, 枚举_先验一致性阻断原因::缺合法材料);
        }
        if (输出.先验匹配数量 <= 0) {
            追加阻断(输出.阻断原因掩码, 枚举_先验一致性阻断原因::缺先验匹配);
        }
        if (输出.自由空间冲突候选数量 > 0) {
            追加阻断(输出.阻断原因掩码, 枚举_先验一致性阻断原因::自由空间冲突);
        }
        if (输出.遮挡候选数量 > 0) {
            追加阻断(输出.阻断原因掩码, 枚举_先验一致性阻断原因::遮挡解释候选);
        }
        if (输出.深度缺失数量 > 0) {
            追加阻断(输出.阻断原因掩码, 枚举_先验一致性阻断原因::深度缺失);
        }
        if (输出.信息缺口数量 > 0) {
            追加阻断(输出.阻断原因掩码, 枚举_先验一致性阻断原因::信息缺口);
        }
        if (输出.材料质量评分Q10000 > 0 && 输出.材料质量评分Q10000 < 5000) {
            追加阻断(输出.阻断原因掩码, 枚举_先验一致性阻断原因::材料质量不足);
        }

        const I64 冲突扣分 = (std::min<I64>)(4000, 输出.自由空间冲突候选数量 * 2000);
        const I64 遮挡扣分 = (std::min<I64>)(2000, 输出.遮挡候选数量 * 500);
        const I64 深度扣分 = (std::min<I64>)(2000, 输出.深度缺失数量 * 500);
        const I64 缺口扣分 = (std::min<I64>)(2000, 输出.信息缺口数量 * 250);
        输出.评分Q10000 = 限制I64(
            输出.最佳先验综合评分Q10000 - 冲突扣分 - 遮挡扣分 - 深度扣分 - 缺口扣分,
            0,
            10000);
        if (输出.评分Q10000 > 0 && 输出.评分Q10000 < 5000) {
            追加阻断(输出.阻断原因掩码, 枚举_先验一致性阻断原因::先验匹配偏低);
        }

        if ((输出.阻断原因掩码 & static_cast<I64>(枚举_先验一致性阻断原因::先验坐标版本缺失)) != 0) {
            输出.状态值 = static_cast<I64>(枚举_先验一致性状态::坐标版本冲突);
        } else if ((输出.阻断原因掩码 & static_cast<I64>(枚举_先验一致性阻断原因::缺SceneVoxelPrior)) != 0) {
            输出.状态值 = static_cast<I64>(枚举_先验一致性状态::无先验);
        } else if ((输出.阻断原因掩码 & static_cast<I64>(枚举_先验一致性阻断原因::缺合法材料)) != 0) {
            输出.状态值 = static_cast<I64>(枚举_先验一致性状态::先验不可比较);
        } else if ((输出.阻断原因掩码 & static_cast<I64>(枚举_先验一致性阻断原因::自由空间冲突)) != 0) {
            输出.状态值 = static_cast<I64>(枚举_先验一致性状态::自由空间冲突);
        } else if ((输出.阻断原因掩码 & static_cast<I64>(枚举_先验一致性阻断原因::遮挡解释候选)) != 0) {
            输出.状态值 = static_cast<I64>(枚举_先验一致性状态::遮挡解释候选);
        } else if ((输出.阻断原因掩码 & (static_cast<I64>(枚举_先验一致性阻断原因::深度缺失)
            | static_cast<I64>(枚举_先验一致性阻断原因::信息缺口))) != 0) {
            输出.状态值 = static_cast<I64>(枚举_先验一致性状态::需复验);
        } else if (输出.评分Q10000 >= 8000 && 输出.先验匹配数量 > 0) {
            输出.状态值 = static_cast<I64>(枚举_先验一致性状态::高一致);
        } else if (输出.评分Q10000 >= 5000 && 输出.先验匹配数量 > 0) {
            输出.状态值 = static_cast<I64>(枚举_先验一致性状态::可参考);
        } else {
            输出.状态值 = static_cast<I64>(枚举_先验一致性状态::低一致);
        }
        return 输出;
    }

    // 功能：按 D9 局部体素、清晰度、稳定复现和先验材料收束体素融合前置状态，不写稳定体素。
    static 结构_体素融合前置状态评分 计算局部体素融合前置状态(const 结构_视觉观察候选& 候选, const 结构_观察候选清晰度评分& 候选清晰度, const 结构_稳定复现评分& 稳定复现, const 结构_先验一致性评分* 先验一致性)
    {
        auto 追加阻断 = [](I64& 掩码, 枚举_体素融合前置阻断原因 原因) noexcept {
            掩码 |= static_cast<I64>(原因);
        };

        结构_体素融合前置状态评分 输出{};
        输出.观察候选数据项ID = static_cast<I64>((std::min<std::uint64_t>)(
            候选.数据项ID,
            static_cast<std::uint64_t>((std::numeric_limits<I64>::max)())));
        输出.局部体素来源任务ID = 候选.局部体素来源任务ID;
        输出.局部体素来源观察证据ID = 候选.局部体素来源观察证据ID;
        输出.局部体素来源基准体素版本 = 候选.局部体素来源基准体素版本;
        输出.局部体素来源子候选ID = 候选.局部体素来源子候选ID;
        输出.局部体素候选版本 = 候选.局部体素候选版本;
        输出.局部体素包围盒边长 = 候选.局部体素包围盒边长;
        输出.局部体素占据数量 = 候选.局部体素占据数量;
        输出.局部体素颜色数量 = 候选.局部体素颜色数量;
        输出.局部体素有效深度支撑数量 = 候选.局部体素有效深度支撑数量;
        输出.局部体素空间支撑数量 = 候选.局部体素空间支撑数量;
        输出.局部体素完整性评分Q10000 = 限制I64(候选.局部体素完整性评分Q10000, 0, 10000);
        输出.候选清晰度评分Q10000 = 限制I64(候选清晰度.评分Q10000, 0, 10000);
        输出.候选清晰度状态值 = 候选清晰度.状态值;
        输出.稳定复现评分Q10000 = 限制I64(稳定复现.评分Q10000, 0, 10000);
        输出.稳定复现状态值 = 稳定复现.状态值;
        输出.归属可信评分Q10000 = 限制I64(候选.候选像素归属质量评分Q10000, 0, 10000);
        输出.自由空间冲突数量 = 候选.候选自由空间冲突数量;
        if (先验一致性) {
            输出.先验一致性评分Q10000 = 限制I64(先验一致性->评分Q10000, 0, 10000);
            输出.先验一致性状态值 = 先验一致性->状态值;
        }

        if (候选.数据项ID == 0) {
            追加阻断(输出.阻断原因掩码, 枚举_体素融合前置阻断原因::缺观察候选);
        }
        if (输出.局部体素来源任务ID <= 0 || 输出.局部体素来源观察证据ID <= 0 || 输出.局部体素来源子候选ID <= 0) {
            追加阻断(输出.阻断原因掩码, 枚举_体素融合前置阻断原因::来源链缺失);
        }
        if (输出.局部体素来源基准体素版本 <= 0) {
            追加阻断(输出.阻断原因掩码, 枚举_体素融合前置阻断原因::基准版本缺失);
        }
        if (输出.局部体素占据数量 <= 0 || 候选.局部体素占据候选.empty()) {
            追加阻断(输出.阻断原因掩码, 枚举_体素融合前置阻断原因::缺局部体素候选);
            追加阻断(输出.阻断原因掩码, 枚举_体素融合前置阻断原因::局部体素占据不足);
        }
        if (输出.局部体素有效深度支撑数量 <= 0) {
            追加阻断(输出.阻断原因掩码, 枚举_体素融合前置阻断原因::深度支撑不足);
        }
        if (输出.局部体素空间支撑数量 <= 0) {
            追加阻断(输出.阻断原因掩码, 枚举_体素融合前置阻断原因::空间支撑不足);
        }
        if (输出.局部体素完整性评分Q10000 < 5000) {
            追加阻断(输出.阻断原因掩码, 枚举_体素融合前置阻断原因::局部体素清晰度不足);
        }
        if (输出.候选清晰度评分Q10000 < 5000
            || 输出.候选清晰度状态值 == static_cast<I64>(枚举_视觉清晰度等级状态::不可用)
            || 输出.候选清晰度状态值 == static_cast<I64>(枚举_视觉清晰度等级状态::冲突)) {
            追加阻断(输出.阻断原因掩码, 枚举_体素融合前置阻断原因::候选清晰度不足);
        }
        if (输出.稳定复现评分Q10000 < 5000
            || 输出.稳定复现状态值 == static_cast<I64>(枚举_稳定复现等级状态::未复现)
            || 输出.稳定复现状态值 == static_cast<I64>(枚举_稳定复现等级状态::冲突复现)) {
            追加阻断(输出.阻断原因掩码, 枚举_体素融合前置阻断原因::稳定复现不足);
        }
        if (输出.归属可信评分Q10000 < 5000) {
            追加阻断(输出.阻断原因掩码, 枚举_体素融合前置阻断原因::归属可信性不足);
        }
        if (输出.自由空间冲突数量 > 0) {
            追加阻断(输出.阻断原因掩码, 枚举_体素融合前置阻断原因::自由空间冲突);
        }
        if (先验一致性) {
            if (先验一致性->状态值 == static_cast<I64>(枚举_先验一致性状态::自由空间冲突)
                || 先验一致性->状态值 == static_cast<I64>(枚举_先验一致性状态::坐标版本冲突)) {
                追加阻断(输出.阻断原因掩码, 枚举_体素融合前置阻断原因::先验冲突);
            } else if (先验一致性->状态值 == static_cast<I64>(枚举_先验一致性状态::需复验)
                || 先验一致性->状态值 == static_cast<I64>(枚举_先验一致性状态::遮挡解释候选)) {
                追加阻断(输出.阻断原因掩码, 枚举_体素融合前置阻断原因::需复验);
            }
        }

        const I64 清晰稳定平均 = (输出.候选清晰度评分Q10000 + 输出.稳定复现评分Q10000) / 2;
        const I64 先验项 = 先验一致性 ? 输出.先验一致性评分Q10000 : 5000;
        输出.评分Q10000 = 限制I64(
            (输出.局部体素完整性评分Q10000
                + 清晰稳定平均
                + 输出.归属可信评分Q10000
                + 先验项) / 4,
            0,
            10000);

        const I64 不可融合掩码 =
            static_cast<I64>(枚举_体素融合前置阻断原因::缺观察候选)
            | static_cast<I64>(枚举_体素融合前置阻断原因::缺局部体素候选)
            | static_cast<I64>(枚举_体素融合前置阻断原因::局部体素占据不足)
            | static_cast<I64>(枚举_体素融合前置阻断原因::候选清晰度不足);
        const I64 条件不足掩码 =
            static_cast<I64>(枚举_体素融合前置阻断原因::来源链缺失)
            | static_cast<I64>(枚举_体素融合前置阻断原因::基准版本缺失)
            | static_cast<I64>(枚举_体素融合前置阻断原因::深度支撑不足)
            | static_cast<I64>(枚举_体素融合前置阻断原因::空间支撑不足);

        if ((输出.阻断原因掩码 & (static_cast<I64>(枚举_体素融合前置阻断原因::先验冲突)
            | static_cast<I64>(枚举_体素融合前置阻断原因::自由空间冲突))) != 0) {
            输出.状态值 = static_cast<I64>(枚举_体素融合前置状态::先验冲突阻断);
        } else if ((输出.阻断原因掩码 & 不可融合掩码) != 0 || 输出.评分Q10000 <= 0) {
            输出.状态值 = static_cast<I64>(枚举_体素融合前置状态::不可融合);
        } else if ((输出.阻断原因掩码 & 条件不足掩码) != 0) {
            输出.状态值 = static_cast<I64>(枚举_体素融合前置状态::条件不足);
        } else if ((输出.阻断原因掩码 & static_cast<I64>(枚举_体素融合前置阻断原因::归属可信性不足)) != 0) {
            输出.状态值 = static_cast<I64>(枚举_体素融合前置状态::需识别复核);
        } else if ((输出.阻断原因掩码 & (static_cast<I64>(枚举_体素融合前置阻断原因::稳定复现不足)
            | static_cast<I64>(枚举_体素融合前置阻断原因::需复验)
            | static_cast<I64>(枚举_体素融合前置阻断原因::局部体素清晰度不足))) != 0) {
            输出.状态值 = static_cast<I64>(枚举_体素融合前置状态::需观察复验);
        } else if (输出.评分Q10000 >= 8000
            && 输出.局部体素完整性评分Q10000 >= 7000
            && 输出.稳定复现评分Q10000 >= 5000) {
            输出.状态值 = static_cast<I64>(枚举_体素融合前置状态::可生成稳定体素候选);
        } else {
            输出.状态值 = static_cast<I64>(枚举_体素融合前置状态::可挂子体素证据链);
        }
        return 输出;
    }
};

class 体素加工工作线程类 {
public:
    体素加工工作线程类() = default;

    // 功能：析构时请求体素加工工作线程停止并等待线程收口。
    ~体素加工工作线程类()
    {
        请求停止();
        等待停止();
    }

    体素加工工作线程类(const 体素加工工作线程类&) = delete;
    体素加工工作线程类& operator=(const 体素加工工作线程类&) = delete;

    // 功能：启动体素加工工作线程，只处理运行期任务和候选结果包。
    bool 启动(const 结构_体素加工工作线程配置& 配置 = {})
    {
        {
            std::lock_guard<std::mutex> 锁(状态互斥_);
            if (生命周期_ == 枚举_体素加工线程生命周期状态::启动中
                || 生命周期_ == 枚举_体素加工线程生命周期状态::运行中) {
                return true;
            }
            if (工作线程_.joinable()) {
                return false;
            }

            配置_ = 配置;
            停止请求_ = false;
            生命周期_ = 枚举_体素加工线程生命周期状态::启动中;
        }

        try {
            工作线程_ = std::thread(&体素加工工作线程类::主循环_, this);
            return true;
        } catch (...) {
            std::lock_guard<std::mutex> 锁(状态互斥_);
            生命周期_ = 枚举_体素加工线程生命周期状态::故障;
            停止请求_ = true;
            return false;
        }
    }

    // 功能：请求体素加工工作线程停止，不写任何世界树事实。
    void 请求停止()
    {
        {
            std::lock_guard<std::mutex> 锁(状态互斥_);
            if (生命周期_ == 枚举_体素加工线程生命周期状态::未启动
                || 生命周期_ == 枚举_体素加工线程生命周期状态::已停止) {
                return;
            }
            停止请求_ = true;
            生命周期_ = 枚举_体素加工线程生命周期状态::停止请求中;
        }
        条件_.notify_all();
    }

    // 功能：等待体素加工工作线程退出。
    void 等待停止()
    {
        if (工作线程_.joinable()) {
            工作线程_.join();
        }
    }

    // 功能：提交体素加工任务到运行期队列，不直接加工或入账。
    bool 提交任务(结构_体素加工任务 任务)
    {
        {
            std::lock_guard<std::mutex> 锁(状态互斥_);
            if (生命周期_ != 枚举_体素加工线程生命周期状态::启动中
                && 生命周期_ != 枚举_体素加工线程生命周期状态::运行中) {
                return false;
            }
            if (任务.提交时间 == 0) {
                任务.提交时间 = 结构体_时间戳::当前_微秒();
            }

            const std::size_t 队列上限 = std::max<std::size_t>(1, 配置_.最大任务队列长度);
            while (任务队列_.size() >= 队列上限) {
                任务队列_.pop_front();
                ++已丢弃任务数量_;
            }
            任务队列_.push_back(std::move(任务));
            ++已接收任务数量_;
        }
        条件_.notify_one();
        return true;
    }

    // 功能：读取候选结果包副本，不返回线程内部队列引用。
    std::vector<结构_体素加工候选结果包> 读取候选结果包集合() const
    {
        std::lock_guard<std::mutex> 锁(状态互斥_);
        return 候选结果包集合_;
    }

    // 功能：读取体素加工工作线程摘要。
    结构_体素加工工作线程摘要 读取摘要() const
    {
        std::lock_guard<std::mutex> 锁(状态互斥_);
        结构_体素加工工作线程摘要 摘要{};
        摘要.生命周期 = 生命周期_;
        摘要.已启动 =
            生命周期_ == 枚举_体素加工线程生命周期状态::启动中
            || 生命周期_ == 枚举_体素加工线程生命周期状态::运行中
            || 生命周期_ == 枚举_体素加工线程生命周期状态::停止请求中;
        摘要.停止请求 = 停止请求_;
        摘要.任务队列长度 = 任务队列_.size();
        摘要.候选结果包数量 = 候选结果包集合_.size();
        摘要.已接收任务数量 = 已接收任务数量_;
        摘要.已丢弃任务数量 = 已丢弃任务数量_;
        摘要.已处理任务数量 = 已处理任务数量_;
        摘要.已生成候选包数量 = 已生成候选包数量_;
        摘要.条件不足数量 = 条件不足数量_;
        摘要.输入非法数量 = 输入非法数量_;
        摘要.最近处理时间 = 最近处理时间_;
        return 摘要;
    }

private:
    // 功能：把单个体素加工任务转换成候选结果包，正式入账留给提交入口。
    static 结构_体素加工候选结果包 处理任务_(const 结构_体素加工任务& 任务)
    {
        结构_体素加工候选结果包 结果{};
        结果.任务ID = 任务.任务ID;
        结果.父存在 = 任务.父存在;
        结果.输入观察证据ID = 任务.输入观察证据ID;
        结果.基准体素版本 = 任务.基准体素版本;
        结果.包围盒边长 = 任务.包围盒边长;
        结果.父体素占据候选快照 = 任务.父体素占据候选快照;
        结果.生成时间 = 结构体_时间戳::当前_微秒();

        if (任务.任务ID <= 0
            || 任务.输入观察证据ID <= 0
            || 任务.包围盒边长 < 3
            || 任务.父体素占据候选快照.empty()) {
            结果.处理状态 = 枚举_体素加工任务处理状态::输入非法;
            结果.可提交状态 = 枚举_体素加工可提交状态::条件不足;
            return 结果;
        }

        结果.父体素检查 = 场景体素模块::检查正立方体体素包围盒(
            任务.父体素占据候选快照,
            任务.包围盒边长,
            任务.最大扫描体素数);
        结果.是否触碰外边界 = 结果.父体素检查.触碰外边界;
        结果.是否局部包围盒压紧 = 结果.父体素检查.局部包围盒压紧;

        if (!结果.父体素检查.输入有效 || !结果.父体素检查.有占据) {
            结果.处理状态 = 枚举_体素加工任务处理状态::条件不足;
            结果.可提交状态 = 枚举_体素加工可提交状态::条件不足;
            return 结果;
        }

        结果.融合点检查 = detail::检查体素融合点(
            任务.现有父体素占据快照,
            任务.父体素占据候选快照,
            任务.包围盒边长);
        结果.是否存在融合点 = 结果.融合点检查.有融合点();
        结果.父基础颜色统计 = detail::计算父基础颜色统计(
            任务.彩色轮廓视角,
            任务.已确认子轮廓掩码);
        结果.子轮廓候选集合 = detail::生成子轮廓候选集合(
            任务.彩色轮廓视角,
            任务.深度轮廓视角,
            任务.最大子轮廓候选数量,
            任务.最大扫描体素数);
        结果.子轮廓候选数量 = detail::计数转I64(
            static_cast<std::uint64_t>(结果.子轮廓候选集合.size()));
        for (const auto& 子候选 : 结果.子轮廓候选集合) {
            if (子候选.状态 == 枚举_体素子轮廓候选状态::可生成局部体素候选) {
                ++结果.有深度支撑子候选数量;
            } else if (子候选.状态 == 枚举_体素子轮廓候选状态::表面区域
                || 子候选.状态 == 枚举_体素子轮廓候选状态::未解释候选) {
                ++结果.表面或未解释子候选数量;
            }
        }
        结果.处理状态 = 枚举_体素加工任务处理状态::已生成候选;
        结果.可提交状态 = 结果.是否存在融合点
            ? 枚举_体素加工可提交状态::未裁决
            : 枚举_体素加工可提交状态::待融合点;
        return 结果;
    }

    // 功能：保存候选结果包，控制运行期缓存长度。
    void 保存候选结果包_(结构_体素加工候选结果包 结果)
    {
        const std::size_t 结果上限 = std::max<std::size_t>(1, 配置_.最大结果包数量);
        while (候选结果包集合_.size() >= 结果上限) {
            候选结果包集合_.erase(候选结果包集合_.begin());
        }
        候选结果包集合_.push_back(std::move(结果));
    }

    // 功能：体素加工线程主循环，串行消费运行期任务。
    void 主循环_()
    {
        {
            std::lock_guard<std::mutex> 锁(状态互斥_);
            if (生命周期_ == 枚举_体素加工线程生命周期状态::启动中) {
                生命周期_ = 枚举_体素加工线程生命周期状态::运行中;
            }
        }

        for (;;) {
            结构_体素加工任务 任务{};
            {
                std::unique_lock<std::mutex> 锁(状态互斥_);
                条件_.wait(锁, [&]() {
                    return 停止请求_ || !任务队列_.empty();
                });
                if (任务队列_.empty()) {
                    if (停止请求_) {
                        break;
                    }
                    continue;
                }
                任务 = std::move(任务队列_.front());
                任务队列_.pop_front();
            }

            auto 结果 = 处理任务_(任务);
            I64 局部子体素候选数量 = 0;
            for (const auto& 子候选 : 结果.子轮廓候选集合) {
                const bool 有局部子体素候选 =
                    子候选.局部体素检查.输入有效
                    && 子候选.局部体素检查.有占据
                    && !子候选.局部体素占据候选.empty();
                if (有局部子体素候选) {
                    ++局部子体素候选数量;
                }
            }
            {
                auto* 父存在 = 结果.父存在.获取();
                std::ostringstream 输出;
                输出 << "体素加工工作线程/候选结果包处理"
                    << " | 任务ID=" << 结果.任务ID
                    << " | 父存在=" << (父存在 ? 父存在->获取主键() : std::string("空"))
                    << " | 观察证据ID=" << 结果.输入观察证据ID
                    << " | 基准体素版本=" << 结果.基准体素版本
                    << " | 包围盒边长=" << 结果.包围盒边长
                    << " | 处理状态=" << static_cast<I64>(结果.处理状态)
                    << " | 可提交状态=" << static_cast<I64>(结果.可提交状态)
                    << " | 父候选输入有效=" << (结果.父体素检查.输入有效 ? 1 : 0)
                    << " | 父候选有占据=" << (结果.父体素检查.有占据 ? 1 : 0)
                    << " | 父候选触碰外边界=" << (结果.是否触碰外边界 ? 1 : 0)
                    << " | 融合点=" << (结果.是否存在融合点 ? 1 : 0)
                    << " | 子轮廓候选数量=" << 结果.子轮廓候选数量
                    << " | 有深度支撑子候选数量=" << 结果.有深度支撑子候选数量
                    << " | 表面或未解释子候选数量=" << 结果.表面或未解释子候选数量
                    << " | 局部子体素候选数量=" << 局部子体素候选数量
                    << " | 父基础颜色有效=" << (结果.父基础颜色统计.有效 ? 1 : 0)
                    << " | 父基础颜色像素数量=" << 结果.父基础颜色统计.像素数量
                    << " | worker只产候选=1";
                项目运行日志(输出.str());
            }
            {
                std::lock_guard<std::mutex> 锁(状态互斥_);
                ++已处理任务数量_;
                if (结果.处理状态 == 枚举_体素加工任务处理状态::已生成候选) {
                    ++已生成候选包数量_;
                } else if (结果.处理状态 == 枚举_体素加工任务处理状态::条件不足) {
                    ++条件不足数量_;
                } else if (结果.处理状态 == 枚举_体素加工任务处理状态::输入非法) {
                    ++输入非法数量_;
                }
                最近处理时间_ = 结果.生成时间;
                保存候选结果包_(std::move(结果));
            }
        }

        {
            std::lock_guard<std::mutex> 锁(状态互斥_);
            停止请求_ = false;
            生命周期_ = 枚举_体素加工线程生命周期状态::已停止;
        }
    }

private:
    mutable std::mutex 状态互斥_{};
    std::condition_variable 条件_{};
    std::thread 工作线程_{};
    结构_体素加工工作线程配置 配置_{};
    bool 停止请求_ = false;
    枚举_体素加工线程生命周期状态 生命周期_ =
        枚举_体素加工线程生命周期状态::未启动;
    std::deque<结构_体素加工任务> 任务队列_{};
    std::vector<结构_体素加工候选结果包> 候选结果包集合_{};
    std::uint64_t 已接收任务数量_ = 0;
    std::uint64_t 已丢弃任务数量_ = 0;
    std::uint64_t 已处理任务数量_ = 0;
    std::uint64_t 已生成候选包数量_ = 0;
    std::uint64_t 条件不足数量_ = 0;
    std::uint64_t 输入非法数量_ = 0;
    时间戳 最近处理时间_ = 0;
};

// 功能：读取全局体素加工工作线程单例。
inline 体素加工工作线程类& 获取全局体素加工工作线程() noexcept
{
    static 体素加工工作线程类 线程;
    return 线程;
}

// 功能：启动全局体素加工工作线程。
inline bool 启动体素加工工作线程(const 结构_体素加工工作线程配置& 配置 = {})
{
    return 获取全局体素加工工作线程().启动(配置);
}

// 功能：停止全局体素加工工作线程。
inline void 停止体素加工工作线程()
{
    auto& 线程 = 获取全局体素加工工作线程();
    线程.请求停止();
    线程.等待停止();
}

// 功能：提交体素加工任务到全局工作线程。
inline bool 提交体素加工任务(结构_体素加工任务 任务)
{
    return 获取全局体素加工工作线程().提交任务(std::move(任务));
}

// 功能：读取全局体素加工工作线程候选结果包副本。
inline std::vector<结构_体素加工候选结果包> 读取体素加工候选结果包集合()
{
    return 获取全局体素加工工作线程().读取候选结果包集合();
}

// 功能：把体素加工候选结果包中的最佳局部体素证据挂到观察候选 C 运行期视图。
inline I64 挂接局部体素证据到观察候选(
    std::vector<结构_视觉观察候选>& 候选集合,
    const std::vector<结构_体素加工候选结果包>& 候选结果包集合)
{
    I64 挂接数量 = 0;
    for (auto& 候选 : 候选集合) {
        候选.局部体素来源任务ID = 0;
        候选.局部体素来源观察证据ID = 0;
        候选.局部体素来源基准体素版本 = 0;
        候选.局部体素来源子候选ID = 0;
        候选.局部体素候选版本 = 0;
        候选.局部体素包围盒边长 = 0;
        候选.局部体素占据数量 = 0;
        候选.局部体素颜色数量 = 0;
        候选.局部体素有效深度支撑数量 = 0;
        候选.局部体素空间支撑数量 = 0;
        候选.局部体素完整性评分Q10000 = 0;
        候选.局部体素占据候选.clear();

        if (候选.数据项ID == 0
            || 候选.数据项ID > static_cast<std::uint64_t>((std::numeric_limits<I64>::max)())) {
            continue;
        }

        const I64 观察证据ID = static_cast<I64>(候选.数据项ID);
        const 结构_体素加工候选结果包* 最佳包 = nullptr;
        const 结构_体素子轮廓候选* 最佳子候选 = nullptr;
        I64 最佳占据数量 = 0;
        I64 最佳完整性 = 0;

        for (const auto& 候选包 : 候选结果包集合) {
            if (候选包.输入观察证据ID != 观察证据ID
                || 候选包.处理状态 != 枚举_体素加工任务处理状态::已生成候选) {
                continue;
            }

            I64 占据数量 = 0;
            const auto* 子候选 = detail::选择局部体素证据子候选(候选包, 占据数量);
            if (!子候选) {
                continue;
            }
            const I64 完整性 = detail::计算局部体素完整性评分Q10000(*子候选);
            if (!最佳子候选 || 完整性 > 最佳完整性 || (完整性 == 最佳完整性 && 占据数量 > 最佳占据数量)) {
                最佳包 = &候选包;
                最佳子候选 = 子候选;
                最佳占据数量 = 占据数量;
                最佳完整性 = 完整性;
            }
        }

        if (!最佳包 || !最佳子候选) {
            continue;
        }

        候选.局部体素来源任务ID = 最佳包->任务ID;
        候选.局部体素来源观察证据ID = 最佳包->输入观察证据ID;
        候选.局部体素来源基准体素版本 = 最佳包->基准体素版本;
        候选.局部体素来源子候选ID = 最佳子候选->局部子体素候选ID > 0
            ? 最佳子候选->局部子体素候选ID
            : 最佳子候选->候选ID;
        候选.局部体素候选版本 = 最佳包->生成时间;
        候选.局部体素包围盒边长 = detail::计数转I64(最佳子候选->局部包围盒边长);
        候选.局部体素占据数量 = 最佳占据数量;
        候选.局部体素颜色数量 = detail::计数转I64(最佳子候选->彩色像素数量);
        候选.局部体素有效深度支撑数量 = detail::计数转I64(最佳子候选->深度支撑像素数量);
        候选.局部体素空间支撑数量 = detail::计数转I64(最佳子候选->空间支撑像素数量);
        候选.局部体素完整性评分Q10000 = 最佳完整性;
        候选.局部体素占据候选 = 最佳子候选->局部体素占据候选;
        ++挂接数量;
    }
    return 挂接数量;
}

// 功能：读取全局体素加工工作线程摘要。
inline 结构_体素加工工作线程摘要 读取体素加工工作线程摘要()
{
    return 获取全局体素加工工作线程().读取摘要();
}

} // namespace 视觉观察融合模块
