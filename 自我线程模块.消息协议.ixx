// 功能：按函数名执行对应处理。
inline const char* 默认动作语义键(const 枚举_消息处理类型 处理类型) noexcept
{
    switch (处理类型) {
    case 枚举_消息处理类型::控制域事实消息: return "控制域事实变化";
    case 枚举_消息处理类型::业务域事实消息: return "业务域事实变化";
    case 枚举_消息处理类型::延迟事实消息: return "延迟事实生效";
    case 枚举_消息处理类型::工作线程状态消息: return "线程状态变化上报";
    case 枚举_消息处理类型::任务推进关键事件消息: return "任务推进关键事件上报";
    case 枚举_消息处理类型::派生需求上报消息: return "派生需求上报";
    case 枚举_消息处理类型::结果与关键中间状态回流消息: return "结果与关键中间状态回流";
    case 枚举_消息处理类型::自检报告消息: return "自检报告";
    case 枚举_消息处理类型::控制面板刷新请求消息: return "控制面板刷新请求";
    case 枚举_消息处理类型::未定义:
    default:
        return "未定义动作";
    }
}

// 功能：按函数名执行对应处理。
inline 枚举_治理消息优先级 默认消息优先级(const 枚举_消息处理类型 处理类型) noexcept
{
    switch (处理类型) {
    case 枚举_消息处理类型::控制域事实消息:
        return 枚举_治理消息优先级::很高;
    case 枚举_消息处理类型::业务域事实消息:
    case 枚举_消息处理类型::延迟事实消息:
    case 枚举_消息处理类型::工作线程状态消息:
    case 枚举_消息处理类型::结果与关键中间状态回流消息:
    case 枚举_消息处理类型::自检报告消息:
        return 枚举_治理消息优先级::高;
    case 枚举_消息处理类型::派生需求上报消息:
        return 枚举_治理消息优先级::很高;
    case 枚举_消息处理类型::任务推进关键事件消息:
        return 枚举_治理消息优先级::中;
    case 枚举_消息处理类型::控制面板刷新请求消息:
        return 枚举_治理消息优先级::低;
    case 枚举_消息处理类型::未定义:
    default:
        return 枚举_治理消息优先级::低;
    }
}

// 功能：按函数名执行对应处理。
inline bool 默认可抢占(const 枚举_消息处理类型 处理类型) noexcept
{
    return 处理类型 == 枚举_消息处理类型::控制域事实消息;
}

// 功能：按函数名执行对应处理。
inline bool 默认仅局部有效(const 枚举_消息处理类型) noexcept
{
    return false;
}

// 功能：按函数名执行对应处理。
inline 枚举_动作类型 从处理类型映射动作类型(const 枚举_消息处理类型 处理类型) noexcept
{
    switch (处理类型) {
    case 枚举_消息处理类型::控制域事实消息:
        return 枚举_动作类型::下发控制意图;
    case 枚举_消息处理类型::业务域事实消息:
        return 枚举_动作类型::上报事实;
    case 枚举_消息处理类型::延迟事实消息:
        return 枚举_动作类型::到期生效;
    case 枚举_消息处理类型::工作线程状态消息:
        return 枚举_动作类型::状态回报;
    case 枚举_消息处理类型::任务推进关键事件消息:
        return 枚举_动作类型::推进事件上报;
    case 枚举_消息处理类型::派生需求上报消息:
        return 枚举_动作类型::派生需求上报;
    case 枚举_消息处理类型::结果与关键中间状态回流消息:
        return 枚举_动作类型::结果回流;
    case 枚举_消息处理类型::自检报告消息:
        return 枚举_动作类型::自检报告;
    case 枚举_消息处理类型::控制面板刷新请求消息:
        return 枚举_动作类型::控制面板刷新请求;
    case 枚举_消息处理类型::未定义:
    default:
        return 枚举_动作类型::未定义;
    }
}

// 功能：按函数名执行对应处理。
inline std::uintptr_t 抽象特征指针值(const 语素入口节点类* 特征类型) noexcept
{
    return reinterpret_cast<std::uintptr_t>(特征类型);
}

// 功能：同步线程、任务、场景或对象之间的状态。
inline void 同步治理消息头语义槽(结构_治理消息头& 头) noexcept
{
    头.来源链抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_消息_来源链());
    头.来源链值 = static_cast<I64>(头.来源链);
    头.处理类型抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_消息_处理类型());
    头.处理类型值 = static_cast<I64>(头.处理类型);
    头.优先级抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_消息_优先级());
    头.优先级值 = static_cast<I64>(头.优先级);
}

// 功能：同步线程、任务、场景或对象之间的状态。
inline void 同步治理消息语义槽(结构_存在动作语义& 语义) noexcept
{
    语义.动作类型抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_消息_动作类型());
    语义.动作类型值 = static_cast<I64>(语义.动作类型);
}

// 功能：同步线程、任务、场景或对象之间的状态。
inline void 同步自检缺口候选消息语义槽(结构_自检缺口候选消息& 候选) noexcept
{
    if (候选.候选类型 == 枚举_自检候选类型::未定义) {
        候选.候选类型 =
            候选.建议生成需求
                ? 枚举_自检候选类型::需求型
                : 枚举_自检候选类型::报告型;
    }
    候选.候选类型值 = static_cast<I64>(候选.候选类型);
    候选.缺口类型抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_自检_缺口类型());
    候选.来源对象类型抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_自检_来源对象类型());
    候选.来源方法能力抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_自检_来源方法能力());
    候选.来源方法头节点抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_自检_来源方法头节点());
    候选.目标特征类型抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_自检_目标特征类型());
    候选.缺失结构类型抽象特征指针 = 候选.缺失结构类型值 != 0
        ? 抽象特征指针值(自我特征定义类::类型_自检_缺失结构类型())
        : 0;
    候选.证据特征指针 = 抽象特征指针值(自我特征定义类::类型_自检_证据类型());
    候选.严重程度抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_自检_严重程度());
    候选.建议需求类型抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_自检_建议需求类型());
    候选.建议生成需求抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_自检_是否建议生成需求());
    候选.建议生成需求值 = 候选.建议生成需求 ? 1 : 0;
}

// 功能：同步线程、任务、场景或对象之间的状态。
inline void 同步自检报告消息语义槽(结构_自检报告消息& 报告) noexcept
{
    报告.自检范围抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_自检_范围());
    for (auto& 候选 : 报告.缺口候选集) {
        同步自检缺口候选消息语义槽(候选);
    }
}

// 功能：同步线程、任务、场景或对象之间的状态。
inline void 同步特征变化项语义槽(结构_特征变化项& 变化项) noexcept
{
    变化项.变化主体类型抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_消息_存在类型());
    变化项.变化主体类型值 = static_cast<I64>(变化项.变化主体类型);
    变化项.特征类型抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_消息_特征类型());
    变化项.特征类型值 = static_cast<I64>(变化项.特征类型);
}

// 功能：同步线程、任务、场景或对象之间的状态。
inline void 同步执行尝试对账结果语义槽(结构_执行尝试对账结果& 结果) noexcept
{
    结果.结论抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_消息_执行尝试对账结论());
    结果.结论值 = static_cast<I64>(结果.结论);
}

// 功能：同步线程、任务、场景或对象之间的状态。
inline void 同步执行尝试汇总语义槽(结构_执行尝试汇总& 汇总) noexcept
{
    汇总.验证状态抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_消息_执行尝试验证状态());
    汇总.验证状态值 = static_cast<I64>(汇总.验证状态);
    汇总.汇总状态抽象特征指针 = 抽象特征指针值(自我特征定义类::类型_消息_执行尝试汇总状态());
    汇总.汇总状态值 = static_cast<I64>(汇总.汇总状态);
}

// 功能：同步线程、任务、场景或对象之间的状态。
inline 结构_执行尝试对账结果 同步后返回执行尝试对账结果(结构_执行尝试对账结果 结果) noexcept
{
    同步执行尝试对账结果语义槽(结果);
    return 结果;
}

// 功能：同步线程、任务、场景或对象之间的状态。
inline 结构_执行尝试对账结果 同步后返回执行尝试汇总对账结果(
    结构_执行尝试汇总* 汇总,
    结构_执行尝试对账结果 结果) noexcept
{
    if (汇总) {
        同步执行尝试汇总语义槽(*汇总);
    }
    同步执行尝试对账结果语义槽(结果);
    return 结果;
}

inline 结构_特征变化项 构造特征变化项(
    const 枚举_存在类型 变化主体类型,
    const std::uint64_t 变化主体主键,
    const 枚举_特征类型 特征类型,
    const std::uint64_t 特征主键,
    const 特征值& 变化后值,
    const bool 已确认生效 = false,
    const bool 是否关键中间状态 = false,
    const bool 已恢复 = false,
    const std::string& 变化原因键 = {}) noexcept
{
    结构_特征变化项 变化{};
    变化.变化主体类型 = 变化主体类型;
    变化.变化主体主键 = 变化主体主键;
    变化.特征类型 = 特征类型;
    变化.特征主键 = 特征主键;
    变化.变化后值 = 变化后值;
    变化.已确认生效 = 已确认生效;
    变化.是否关键中间状态 = 是否关键中间状态;
    变化.已恢复 = 已恢复;
    变化.变化原因键 = 变化原因键;
    同步特征变化项语义槽(变化);
    return 变化;
}

inline 结构_特征变化项 构造特征变化项_含前后值(
    const 枚举_存在类型 变化主体类型,
    const std::uint64_t 变化主体主键,
    const 枚举_特征类型 特征类型,
    const std::uint64_t 特征主键,
    const 特征值& 变化前值,
    const 特征值& 变化后值,
    const bool 已确认生效 = false,
    const bool 是否关键中间状态 = false,
    const bool 已恢复 = false,
    const std::string& 变化原因键 = {}) noexcept
{
    auto 变化 = 构造特征变化项(
        变化主体类型,
        变化主体主键,
        特征类型,
        特征主键,
        变化后值,
        已确认生效,
        是否关键中间状态,
        已恢复,
        变化原因键);
    变化.变化前值 = 变化前值;
    同步特征变化项语义槽(变化);
    return 变化;
}

// 功能：按函数名执行对应处理。
inline const char* 线程状态特征文本(const 枚举_特征类型 特征类型) noexcept
{
    switch (特征类型) {
    case 枚举_特征类型::控制意图: return "控制意图";
    case 枚举_特征类型::实际运行状态: return "实际运行状态";
    case 枚举_特征类型::生命周期状态: return "生命周期状态";
    default: return "未定义状态特征";
    }
}

// 功能：按函数名执行对应处理。
inline bool 是否线程状态型特征(const 枚举_特征类型 特征类型) noexcept
{
    return 特征类型 == 枚举_特征类型::控制意图
        || 特征类型 == 枚举_特征类型::实际运行状态
        || 特征类型 == 枚举_特征类型::生命周期状态;
}

// 功能：按函数名执行对应处理。
inline bool 是否线程状态变化处理类型(const 枚举_消息处理类型 处理类型) noexcept
{
    return 处理类型 == 枚举_消息处理类型::工作线程状态消息;
}

// 功能：根据当前输入生成目标数据、场景、动态或回执。
inline std::string 生成线程状态变化摘要(const 结构_线程状态变化消息段& 消息段)
{
    std::ostringstream 输出;
    输出 << "线程状态变化";
    if (!消息段.线程标签.empty()) {
        输出 << "[" << 消息段.线程标签 << "]";
    } else {
        输出 << "[#" << 消息段.线程存在主键 << "]";
    }
    输出 << " | 特征=" << 线程状态特征文本(消息段.状态特征类型)
        << " | " << 消息段.旧状态 << "->" << 消息段.新状态;
    if (!消息段.决策者标签.empty()) {
        输出 << " | 决策者=" << 消息段.决策者标签;
    } else if (消息段.决策者主键 != 0) {
        输出 << " | 决策者=#" << 消息段.决策者主键;
    }
    return 输出.str();
}

inline 结构_治理消息 构造治理消息(
    const 枚举_消息处理类型 处理类型,
    const 枚举_消息来源链 来源链 = 枚举_消息来源链::线程直达消息,
    const 时间戳 产生时间 = 0) noexcept
{
    结构_治理消息 消息{};
    消息.头.来源链 = 来源链;
    消息.头.来源链值 = static_cast<I64>(来源链);
    消息.头.处理类型 = 处理类型;
    消息.头.处理类型值 = static_cast<I64>(处理类型);
    消息.头.优先级 = 默认消息优先级(处理类型);
    消息.头.优先级值 = static_cast<I64>(消息.头.优先级);
    消息.头.产生时间 = 产生时间;
    消息.头.可抢占 = 默认可抢占(处理类型);
    消息.头.仅局部有效 = 默认仅局部有效(处理类型);
    消息.头.来源成功 = true;
    消息.语义.动作类型 = 从处理类型映射动作类型(处理类型);
    消息.语义.动作语义键 = 默认动作语义键(处理类型);
    同步治理消息头语义槽(消息.头);
    同步治理消息语义槽(消息.语义);
    return 消息;
}

// 功能：按函数名执行对应处理。
inline bool 是否存在线程状态变化消息段(const 结构_治理消息& 消息) noexcept
{
    return 消息.附加载荷.线程状态变化.has_value();
}

// 功能：读取并返回指定对象、状态或运行材料。
inline const 结构_线程状态变化消息段* 获取线程状态变化消息段(
    const 结构_治理消息& 消息) noexcept
{
    if (!消息.附加载荷.线程状态变化.has_value()) {
        return nullptr;
    }
    return &(*消息.附加载荷.线程状态变化);
}

// 功能：按函数名执行对应处理。
inline bool 是否线程状态变化治理消息(const 结构_治理消息& 消息) noexcept
{
    return 是否线程状态变化处理类型(消息.头.处理类型)
        || 是否存在线程状态变化消息段(消息);
}

inline 结构_治理消息 从线程状态变化构造治理消息(
    const 结构_线程状态变化消息段& 消息段,
    const 枚举_消息来源链 来源链 = 枚举_消息来源链::线程直达消息,
    const 枚举_消息处理类型 处理类型 = 枚举_消息处理类型::工作线程状态消息) noexcept
{
    auto 消息 = 构造治理消息(处理类型, 来源链, 消息段.发生时间);
    消息.头.发出者主键 = 消息段.决策者主键;
    消息.头.动作主体主键 = 消息段.线程存在主键;
    消息.头.作用对象主键 = 消息段.线程存在主键;
    消息.头.来源线程主键 =
        消息段.关联线程主键 != 0
        ? 消息段.关联线程主键
        : 消息段.线程存在主键;
    消息.头.来源任务主键 = 消息段.关联任务主键;
    消息.头.目标任务主键 = 消息段.关联任务主键;
    消息.头.父任务主键 = 消息段.关联任务主键;
    消息.头.来源成功 = !消息段.是否故障触发;
    消息.语义.发出者类型 = 消息段.决策者类型;
    消息.语义.发出者主键 = 消息段.决策者主键;
    消息.语义.动作主体类型 = 消息段.线程存在类型;
    消息.语义.动作主体主键 = 消息段.线程存在主键;
    消息.语义.动作类型 = 从处理类型映射动作类型(处理类型);
    消息.语义.动作类型值 = static_cast<I64>(消息.语义.动作类型);
    消息.语义.动作语义键 =
        消息段.触发动作.empty()
        ? "线程状态变更"
        : 消息段.触发动作;
    消息.语义.作用对象类型 = 消息段.线程存在类型;
    消息.语义.作用对象主键 = 消息段.线程存在主键;
    消息.语义.记录者类型 = 枚举_存在类型::自我线程;
    消息.语义.因果摘要 = 消息段.原因键;
    消息.附加载荷.线程状态变化 = 消息段;
    if (是否线程状态型特征(消息段.状态特征类型)) {
        消息.变化项集.push_back(构造特征变化项_含前后值(
            消息段.线程存在类型,
            消息段.线程存在主键,
            消息段.状态特征类型,
            0,
            特征值{ 消息段.旧状态 },
            特征值{ 消息段.新状态 },
            true,
            false,
            false,
            消息段.原因键));
    }
    消息.摘要 = 生成线程状态变化摘要(消息段);
    return 消息;
}

// 功能：确认候选事实、存在、状态或运行结果。
inline bool 是否存在已确认变化项(const 结构_治理消息& 消息) noexcept
{
    for (const auto& 变化项 : 消息.变化项集) {
        if (变化项.已确认生效) {
            return true;
        }
    }
    return false;
}

// 功能：按函数名执行对应处理。
inline bool 是否存在关键中间状态变化项(const 结构_治理消息& 消息) noexcept
{
    for (const auto& 变化项 : 消息.变化项集) {
        if (变化项.是否关键中间状态) {
            return true;
        }
    }
    return false;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline const char* 执行尝试汇总状态文本(const 枚举_执行尝试汇总状态 状态) noexcept
{
    switch (状态) {
    case 枚举_执行尝试汇总状态::执行中: return "执行中";
    case 枚举_执行尝试汇总状态::已结束待结果: return "已结束待结果";
    case 枚举_执行尝试汇总状态::已收结果待确认: return "已收结果待确认";
    case 枚举_执行尝试汇总状态::已验证成功: return "已验证成功";
    case 枚举_执行尝试汇总状态::已验证失败: return "已验证失败";
    case 枚举_执行尝试汇总状态::已争议: return "已争议";
    case 枚举_执行尝试汇总状态::已过期: return "已过期";
    case 枚举_执行尝试汇总状态::未定义:
    default:
        return "未定义";
    }
}

// 功能：执行任务、方法或动作的主体逻辑。
inline const char* 执行尝试验证状态文本(const 枚举_执行尝试验证状态 状态) noexcept
{
    switch (状态) {
    case 枚举_执行尝试验证状态::待确认: return "待确认";
    case 枚举_执行尝试验证状态::已验证成功: return "已验证成功";
    case 枚举_执行尝试验证状态::已验证失败: return "已验证失败";
    case 枚举_执行尝试验证状态::已争议: return "已争议";
    case 枚举_执行尝试验证状态::已过期: return "已过期";
    case 枚举_执行尝试验证状态::未定义:
    default:
        return "未定义";
    }
}

// 功能：执行任务、方法或动作的主体逻辑。
inline const char* 执行尝试对账结论文本(const 枚举_执行尝试对账结论 结论) noexcept
{
    switch (结论) {
    case 枚举_执行尝试对账结论::对账通过: return "对账通过";
    case 枚举_执行尝试对账结论::缺结果: return "缺结果";
    case 枚举_执行尝试对账结论::缺结束消息: return "缺结束消息";
    case 枚举_执行尝试对账结论::重复: return "重复";
    case 枚举_执行尝试对账结论::冲突: return "冲突";
    case 枚举_执行尝试对账结论::超时: return "超时";
    case 枚举_执行尝试对账结论::时序异常: return "时序异常";
    case 枚举_执行尝试对账结论::串单: return "串单";
    case 枚举_执行尝试对账结论::未定义:
    default:
        return "未定义";
    }
}

// 功能：解析输入文本、消息、场景或运行包。
inline std::uint64_t 安全解析或散列任务管理主键(const std::string& 文本) noexcept
{
    if (文本.empty()) {
        return 0;
    }

    std::uint64_t 值 = 0;
    for (const auto 字符 : 文本) {
        if (字符 < '0' || 字符 > '9') {
            return static_cast<std::uint64_t>(std::hash<std::string>{}(文本));
        }
        const auto 数字 = static_cast<std::uint64_t>(字符 - '0');
        if (值 > (UINT64_MAX - 数字) / 10) {
            return static_cast<std::uint64_t>(std::hash<std::string>{}(文本));
        }
        值 = 值 * 10 + 数字;
    }
    return 值;
}

// 功能：按函数名执行对应处理。
inline 枚举_结果状态 映射任务管理结果状态(const 枚举_任务管理结果状态 状态) noexcept
{
    switch (状态) {
    case 枚举_任务管理结果状态::成功: return 枚举_结果状态::成功;
    case 枚举_任务管理结果状态::失败: return 枚举_结果状态::失败;
    case 枚举_任务管理结果状态::中断: return 枚举_结果状态::中断;
    case 枚举_任务管理结果状态::收束完成: return 枚举_结果状态::收束;
    case 枚举_任务管理结果状态::异常结束: return 枚举_结果状态::异常;
    case 枚举_任务管理结果状态::部分完成: return 枚举_结果状态::待重试;
    case 枚举_任务管理结果状态::未定义:
    default:
        return 枚举_结果状态::未定义;
    }
}

// 功能：按函数名执行对应处理。
inline 枚举_存在类型 推断任务管理动作主体类型(
    const std::string& 类型摘要) noexcept
{
    (void)类型摘要;
    return 枚举_存在类型::外部对象;
}

// 功能：从任务管理消息头生成内部执行尝试数值键。
inline std::uint64_t 任务管理消息头执行尝试主键值(const 结构_任务管理消息头& 消息头) noexcept
{
    return 安全解析或散列任务管理主键(构造任务管理执行尝试键(消息头));
}

// 功能：判断两个可空数值键是否可用于同一次执行尝试对齐。
inline bool 执行尝试键字段可对齐(
    const std::uint64_t 左,
    const std::uint64_t 右) noexcept
{
    return 左 == 0 || 右 == 0 || 左 == 右;
}

// 功能：判断两个任务管理消息头是否属于同一次执行尝试。
inline bool 是否同一次执行尝试(
    const 结构_任务管理消息头& 左,
    const 结构_任务管理消息头& 右) noexcept
{
    return 执行尝试键字段可对齐(任务管理消息头执行尝试主键值(左), 任务管理消息头执行尝试主键值(右))
        && 执行尝试键字段可对齐(
            安全解析或散列任务管理主键(左.任务管理任务主键),
            安全解析或散列任务管理主键(右.任务管理任务主键))
        && 执行尝试键字段可对齐(
            安全解析或散列任务管理主键(左.任务主键),
            安全解析或散列任务管理主键(右.任务主键))
        && 执行尝试键字段可对齐(
            安全解析或散列任务管理主键(左.父任务主键),
            安全解析或散列任务管理主键(右.父任务主键))
        && 执行尝试键字段可对齐(
            安全解析或散列任务管理主键(左.步骤主键),
            安全解析或散列任务管理主键(右.步骤主键))
        && 执行尝试键字段可对齐(左.路径签名, 右.路径签名)
        && 执行尝试键字段可对齐(左.执行尝试号, 右.执行尝试号);
}

// 功能：把任务管理消息头同步为执行尝试汇总的数值基准。
inline void 建立执行尝试汇总基准(
    结构_执行尝试汇总& 汇总,
    const 结构_任务管理消息头& 消息头) noexcept
{
    汇总.已建立执行尝试基准 = true;
    汇总.执行尝试主键 = 任务管理消息头执行尝试主键值(消息头);
    汇总.任务管理任务主键 = 安全解析或散列任务管理主键(消息头.任务管理任务主键);
    汇总.任务主键 = 安全解析或散列任务管理主键(消息头.任务主键);
    汇总.父任务主键 = 安全解析或散列任务管理主键(消息头.父任务主键);
    汇总.步骤主键 = 安全解析或散列任务管理主键(消息头.步骤主键);
    汇总.路径签名 = 消息头.路径签名;
    汇总.执行尝试号 = 消息头.执行尝试号;
}

// 功能：判断任务管理消息头是否可并入现有执行尝试汇总。
inline bool 执行尝试汇总基准可对齐(
    const 结构_执行尝试汇总& 汇总,
    const 结构_任务管理消息头& 消息头) noexcept
{
    return 执行尝试键字段可对齐(汇总.执行尝试主键, 任务管理消息头执行尝试主键值(消息头))
        && 执行尝试键字段可对齐(
            汇总.任务管理任务主键,
            安全解析或散列任务管理主键(消息头.任务管理任务主键))
        && 执行尝试键字段可对齐(
            汇总.任务主键,
            安全解析或散列任务管理主键(消息头.任务主键))
        && 执行尝试键字段可对齐(
            汇总.父任务主键,
            安全解析或散列任务管理主键(消息头.父任务主键))
        && 执行尝试键字段可对齐(
            汇总.步骤主键,
            安全解析或散列任务管理主键(消息头.步骤主键))
        && 执行尝试键字段可对齐(汇总.路径签名, 消息头.路径签名)
        && 执行尝试键字段可对齐(汇总.执行尝试号, 消息头.执行尝试号);
}

// 功能：按函数名执行对应处理。
inline bool 线程状态与结果状态一致(
    const 结构_任务管理线程状态消息& 线程消息,
    const 结构_任务管理结果状态消息& 结果消息) noexcept
{
    const auto 结束状态 = 线程消息.结束状态;
    const auto 结果状态 = 结果消息.结果状态;

    switch (结束状态) {
    case 枚举_任务管理线程结束状态::正常结束:
        return 结果状态 != 枚举_任务管理结果状态::中断
            && 结果状态 != 枚举_任务管理结果状态::异常结束;
    case 枚举_任务管理线程结束状态::收束结束:
        return 结果状态 == 枚举_任务管理结果状态::收束完成
            || 结果状态 == 枚举_任务管理结果状态::部分完成
            || 结果状态 == 枚举_任务管理结果状态::失败;
    case 枚举_任务管理线程结束状态::中断结束:
        return 结果状态 == 枚举_任务管理结果状态::中断
            || 结果状态 == 枚举_任务管理结果状态::部分完成;
    case 枚举_任务管理线程结束状态::故障结束:
        return 结果状态 == 枚举_任务管理结果状态::失败
            || 结果状态 == 枚举_任务管理结果状态::异常结束;
    case 枚举_任务管理线程结束状态::超时结束:
        return 结果状态 == 枚举_任务管理结果状态::失败
            || 结果状态 == 枚举_任务管理结果状态::中断
            || 结果状态 == 枚举_任务管理结果状态::异常结束;
    case 枚举_任务管理线程结束状态::未结束:
    case 枚举_任务管理线程结束状态::未定义:
    default:
        return true;
    }
}

// 功能：按函数名执行对应处理。
inline 结构_执行尝试对账结果 对账线程状态消息与结果消息(
    const 结构_任务管理线程状态消息& 线程消息,
    const 结构_任务管理结果状态消息& 结果消息) noexcept
{
    结构_执行尝试对账结果 结果{};
    结果.是否同一次执行尝试 = 是否同一次执行尝试(线程消息.消息头, 结果消息.消息头);
    if (!结果.是否同一次执行尝试) {
        结果.结论 = 枚举_执行尝试对账结论::串单;
        结果.说明 = "线程状态消息与结果消息的任务/步骤/路径签名或尝试号无法对齐";
        return 同步后返回执行尝试对账结果(结果);
    }

    if (!是否线程状态消息表示执行结束(线程消息)) {
        结果.结论 = 枚举_执行尝试对账结论::缺结束消息;
        结果.说明 = "线程状态消息尚未声明本次执行尝试结束";
        return 同步后返回执行尝试对账结果(结果);
    }

    if (结果消息.消息头.产生时间 != 0
        && 线程消息.结束时间 != 0
        && 结果消息.消息头.产生时间 < 线程消息.结束时间) {
        结果.结论 = 枚举_执行尝试对账结论::时序异常;
        结果.说明 = "结果消息产生时间早于线程结束时间";
        return 同步后返回执行尝试对账结果(结果);
    }

    结果.是否一致 = 线程状态与结果状态一致(线程消息, 结果消息);
    if (!结果.是否一致) {
        结果.结论 = 枚举_执行尝试对账结论::冲突;
        结果.说明 = "线程结束状态与结果状态存在语义冲突";
        return 同步后返回执行尝试对账结果(结果);
    }

    结果.结论 = 枚举_执行尝试对账结论::对账通过;
    结果.是否完整 = true;
    结果.是否进入待确认池 = true;
    结果.说明 = "线程状态消息与结果消息已完成完整性、一致性和时序校验";
    return 同步后返回执行尝试对账结果(结果);
}

// 功能：按函数名执行对应处理。
// 功能：按函数名执行对应处理。
inline bool 任务管理结果消息语义相同(
    const 结构_任务管理结果状态消息& 左,
    const 结构_任务管理结果状态消息& 右) noexcept
{
    return 左.结果状态 == 右.结果状态
        && 左.完成度 == 右.完成度
        && 左.是否成功 == 右.是否成功
        && 左.错误码 == 右.错误码
        && 左.完成时间 == 右.完成时间
        && 左.方法虚拟存在主键 == 右.方法虚拟存在主键
        && 左.是否存在关键中间状态 == 右.是否存在关键中间状态
        && 左.是否仍有未满足项 == 右.是否仍有未满足项
        && 左.是否需要外部支撑 == 右.是否需要外部支撑
        && 左.是否需要父任务处理 == 右.是否需要父任务处理
        && 左.是否需要自我线程重判 == 右.是否需要自我线程重判
        && 左.是否疑似需要新任务入口 == 右.是否疑似需要新任务入口
        && 左.可能影响父任务 == 右.可能影响父任务
        && 左.任务价值反馈.本次安全满足量 == 右.任务价值反馈.本次安全满足量
        && 左.任务价值反馈.本次服务满足量 == 右.任务价值反馈.本次服务满足量
        && 左.任务价值反馈.安全累计比例_百万分比 == 右.任务价值反馈.安全累计比例_百万分比
        && 左.任务价值反馈.服务累计比例_百万分比 == 右.任务价值反馈.服务累计比例_百万分比;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline 结构_执行尝试对账结果 刷新执行尝试汇总状态(
    结构_执行尝试汇总* 汇总) noexcept
{
    结构_执行尝试对账结果 对账结果{};
    if (!汇总) {
        return 同步后返回执行尝试汇总对账结果(汇总, 对账结果);
    }

    if (汇总->最近线程状态消息.has_value() && 汇总->最近结果消息.has_value()) {
        对账结果 = 对账线程状态消息与结果消息(
            *汇总->最近线程状态消息,
            *汇总->最近结果消息);
        汇总->最近对账说明 = 对账结果.说明;
        switch (对账结果.结论) {
        case 枚举_执行尝试对账结论::对账通过:
            汇总->汇总状态 = 枚举_执行尝试汇总状态::已收结果待确认;
            汇总->验证状态 = 枚举_执行尝试验证状态::待确认;
            break;
        case 枚举_执行尝试对账结论::时序异常:
        case 枚举_执行尝试对账结论::冲突:
        case 枚举_执行尝试对账结论::串单:
            汇总->汇总状态 = 枚举_执行尝试汇总状态::已争议;
            汇总->验证状态 = 枚举_执行尝试验证状态::已争议;
            break;
        case 枚举_执行尝试对账结论::缺结束消息:
            汇总->汇总状态 = 枚举_执行尝试汇总状态::执行中;
            break;
        case 枚举_执行尝试对账结论::缺结果:
            汇总->汇总状态 = 枚举_执行尝试汇总状态::已结束待结果;
            break;
        case 枚举_执行尝试对账结论::重复:
        case 枚举_执行尝试对账结论::超时:
        case 枚举_执行尝试对账结论::未定义:
        default:
            break;
        }
        return 同步后返回执行尝试汇总对账结果(汇总, 对账结果);
    }

    if (汇总->最近线程状态消息.has_value()) {
        if (是否线程状态消息表示执行结束(*汇总->最近线程状态消息)) {
            汇总->汇总状态 = 枚举_执行尝试汇总状态::已结束待结果;
            对账结果.结论 = 枚举_执行尝试对账结论::缺结果;
            对账结果.说明 = "已收到线程结束消息，等待结果消息";
        } else {
            汇总->汇总状态 = 枚举_执行尝试汇总状态::执行中;
            对账结果.结论 = 枚举_执行尝试对账结论::缺结果;
            对账结果.说明 = "执行尝试仍在运行，尚未形成最终结果";
        }
        汇总->最近对账说明 = 对账结果.说明;
        return 同步后返回执行尝试汇总对账结果(汇总, 对账结果);
    }

    if (汇总->最近结果消息.has_value()) {
        汇总->汇总状态 = 枚举_执行尝试汇总状态::执行中;
        对账结果.结论 = 枚举_执行尝试对账结论::缺结束消息;
        对账结果.说明 = "已收到结果消息，但缺少线程结束消息";
        汇总->最近对账说明 = 对账结果.说明;
        return 同步后返回执行尝试汇总对账结果(汇总, 对账结果);
    }

    汇总->汇总状态 = 枚举_执行尝试汇总状态::未定义;
    汇总->验证状态 = 枚举_执行尝试验证状态::未定义;
    return 同步后返回执行尝试汇总对账结果(汇总, 对账结果);
}

// 功能：执行任务、方法或动作的主体逻辑。
inline 结构_执行尝试对账结果 合并线程状态消息到执行尝试汇总(
    结构_执行尝试汇总* 汇总,
    const 结构_任务管理线程状态消息& 消息) noexcept
{
    结构_执行尝试对账结果 对账结果{};
    if (!汇总) {
        return 同步后返回执行尝试汇总对账结果(汇总, 对账结果);
    }

    if (!汇总->已建立执行尝试基准) {
        建立执行尝试汇总基准(*汇总, 消息.消息头);
    } else if (!执行尝试汇总基准可对齐(*汇总, 消息.消息头)) {
        对账结果.结论 = 枚举_执行尝试对账结论::串单;
        对账结果.说明 = "线程状态消息无法并入现有执行尝试汇总";
        汇总->汇总状态 = 枚举_执行尝试汇总状态::已争议;
        汇总->验证状态 = 枚举_执行尝试验证状态::已争议;
        汇总->最近对账说明 = 对账结果.说明;
        return 同步后返回执行尝试汇总对账结果(汇总, 对账结果);
    }

    if (!消息.消息头.幂等键.empty()
        && 消息.消息头.幂等键 == 汇总->最近线程状态消息幂等键) {
        ++汇总->重复消息累计数;
        对账结果.结论 = 枚举_执行尝试对账结论::重复;
        对账结果.说明 = "线程状态消息幂等键重复";
        汇总->最近对账说明 = 对账结果.说明;
        return 同步后返回执行尝试汇总对账结果(汇总, 对账结果);
    }

    汇总->已收到线程状态 = true;
    ++汇总->线程状态消息累计数;
    汇总->当前线程运行状态 = 消息.当前运行状态;
    汇总->线程结束状态 = 消息.结束状态;
    汇总->开始时间 = 消息.开始时间 != 0 ? 消息.开始时间 : 汇总->开始时间;
    汇总->结束时间 = 消息.结束时间 != 0 ? 消息.结束时间 : 汇总->结束时间;
    汇总->最近归并时间 = 消息.消息头.产生时间;
    汇总->最近线程状态消息幂等键 = 消息.消息头.幂等键;
    if (消息.是否携带控制请求 || !消息.控制请求主键.empty()) {
        汇总->已收到控制响应 =
            消息.当前控制响应状态 != 枚举_任务管理控制响应状态::未定义
            || 消息.是否控制已执行完成;
        汇总->最近控制请求主键 = 消息.控制请求主键;
        汇总->最近控制意图 = 消息.当前控制意图;
        汇总->最近控制响应状态 = 消息.当前控制响应状态;
        汇总->最近控制已执行完成 = 消息.是否控制已执行完成;
    }
    汇总->最近线程状态消息 = 消息;
    return 刷新执行尝试汇总状态(汇总);
}

// 功能：执行任务、方法或动作的主体逻辑。
inline 结构_执行尝试对账结果 合并结果消息到执行尝试汇总(
    结构_执行尝试汇总* 汇总,
    const 结构_任务管理结果状态消息& 消息) noexcept
{
    结构_执行尝试对账结果 对账结果{};
    if (!汇总) {
        return 同步后返回执行尝试汇总对账结果(汇总, 对账结果);
    }

    if (!汇总->已建立执行尝试基准) {
        建立执行尝试汇总基准(*汇总, 消息.消息头);
    } else if (!执行尝试汇总基准可对齐(*汇总, 消息.消息头)) {
        对账结果.结论 = 枚举_执行尝试对账结论::串单;
        对账结果.说明 = "结果消息无法并入现有执行尝试汇总";
        汇总->汇总状态 = 枚举_执行尝试汇总状态::已争议;
        汇总->验证状态 = 枚举_执行尝试验证状态::已争议;
        汇总->最近对账说明 = 对账结果.说明;
        return 同步后返回执行尝试汇总对账结果(汇总, 对账结果);
    }

    if (!消息.消息头.幂等键.empty()
        && 消息.消息头.幂等键 == 汇总->最近结果消息幂等键
        && 汇总->最近结果消息.has_value()
        && 任务管理结果消息语义相同(*汇总->最近结果消息, 消息)) {
        ++汇总->重复消息累计数;
        对账结果.结论 = 枚举_执行尝试对账结论::重复;
        对账结果.说明 = "结果消息幂等键重复";
        汇总->最近对账说明 = 对账结果.说明;
        return 同步后返回执行尝试汇总对账结果(汇总, 对账结果);
    }

    汇总->已收到结果消息 = true;
    ++汇总->结果消息累计数;
    汇总->结果状态 = 消息.结果状态;
    汇总->最近结果时间 =
        消息.完成时间 != 0
        ? 消息.完成时间
        : (消息.执行结束时间 != 0 ? 消息.执行结束时间 : 消息.消息头.产生时间);
    汇总->最近归并时间 = 消息.消息头.产生时间;
    汇总->最近结果消息幂等键 = 消息.消息头.幂等键;
    汇总->动作验证报告摘要 = 消息.动作验证报告摘要;
    if (汇总->开始时间 == 0) {
        汇总->开始时间 = 消息.执行开始时间;
    }
    if (汇总->结束时间 == 0) {
        汇总->结束时间 =
            消息.执行结束时间 != 0
            ? 消息.执行结束时间
            : 消息.完成时间;
    }
    汇总->最近结果消息 = 消息;
    return 刷新执行尝试汇总状态(汇总);
}

// 功能：执行任务、方法或动作的主体逻辑。
inline 结构_执行尝试汇总 从线程状态消息构造执行尝试汇总(
    const 结构_任务管理线程状态消息& 消息) noexcept
{
    结构_执行尝试汇总 汇总{};
    (void)合并线程状态消息到执行尝试汇总(&汇总, 消息);
    return 汇总;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline 结构_执行尝试汇总 从结果消息构造执行尝试汇总(
    const 结构_任务管理结果状态消息& 消息) noexcept
{
    结构_执行尝试汇总 汇总{};
    (void)合并结果消息到执行尝试汇总(&汇总, 消息);
    return 汇总;
}

// 功能：按函数名执行对应处理。
inline 枚举_任务管理触发事件类型 映射到任务管理触发事件类型(
    const 结构_治理消息& 消息) noexcept
{
    if (消息.附加载荷.恢复快照.has_value()) {
        return 枚举_任务管理触发事件类型::恢复重建;
    }

    switch (消息.头.来源链) {
    case 枚举_消息来源链::线程直达消息:
        return 枚举_任务管理触发事件类型::外部反馈;
    case 枚举_消息来源链::任务管理工作线程回流消息:
        return 枚举_任务管理触发事件类型::执行回流;
    case 枚举_消息来源链::自检线程报告消息:
        return 枚举_任务管理触发事件类型::外部反馈;
    case 枚举_消息来源链::界面线程控制消息:
        return 枚举_任务管理触发事件类型::外部反馈;
    case 枚举_消息来源链::未定义:
    default:
        return 枚举_任务管理触发事件类型::未定义;
    }
}

// 功能：按函数名执行对应处理。
inline 枚举_任务管理触发来源 映射到任务管理触发来源(
    const 结构_治理消息& 消息) noexcept
{
    if (消息.头.来源链 == 枚举_消息来源链::未定义) {
        return 枚举_任务管理触发来源::未定义;
    }
    return 枚举_任务管理触发来源::自然运行态;
}

// 功能：计算权重、状态、差值或派生结果。
inline 枚举_治理恢复事件处理方式 计算恢复事件处理方式(
    const 结构_治理消息& 消息) noexcept
{
    if (消息.附加载荷.恢复快照.has_value()) {
        return 枚举_治理恢复事件处理方式::由恢复重建承接;
    }

    switch (消息.头.处理类型) {
    case 枚举_消息处理类型::控制域事实消息:
        return 枚举_治理恢复事件处理方式::仅内存态;
    case 枚举_消息处理类型::业务域事实消息:
    case 枚举_消息处理类型::延迟事实消息:
    case 枚举_消息处理类型::工作线程状态消息:
    case 枚举_消息处理类型::任务推进关键事件消息:
    case 枚举_消息处理类型::派生需求上报消息:
    case 枚举_消息处理类型::结果与关键中间状态回流消息:
    case 枚举_消息处理类型::自检报告消息:
        return 枚举_治理恢复事件处理方式::待回判事实;
    case 枚举_消息处理类型::控制面板刷新请求消息:
        return 枚举_治理恢复事件处理方式::仅内存态;
    case 枚举_消息处理类型::未定义:
    default:
        return 枚举_治理恢复事件处理方式::未定义;
    }
}

// 功能：按函数名执行对应处理。
inline 结构_治理消息 从任务推进事件构造治理消息(const 结构_任务推进事件& 事件) noexcept
{
    结构_治理消息 消息{};
    switch (事件.事件类型) {
    case 枚举_任务推进事件类型::当前步骤可执行:
        消息 = 构造治理消息(
            枚举_消息处理类型::任务推进关键事件消息,
            枚举_消息来源链::任务管理工作线程回流消息);
        消息.变化项集.push_back(构造特征变化项(
            枚举_存在类型::任务管理任务,
            事件.任务根ID,
            枚举_特征类型::局部运行状态,
            0,
            特征值{ static_cast<I64>(枚举_任务推进事件类型::当前步骤可执行) },
            true,
            false,
            false,
            "当前步骤可执行"));
        break;
    case 枚举_任务推进事件类型::当前步骤阻塞:
        消息 = 构造治理消息(
            枚举_消息处理类型::任务推进关键事件消息,
            枚举_消息来源链::任务管理工作线程回流消息);
        消息.变化项集.push_back(构造特征变化项(
            枚举_存在类型::任务管理任务,
            事件.任务根ID,
            枚举_特征类型::当前阻塞状态,
            0,
            特征值{ static_cast<I64>(枚举_任务推进事件类型::当前步骤阻塞) },
            true,
            true,
            false,
            {}));
        break;
    case 枚举_任务推进事件类型::派生需求上报:
        消息 = 构造治理消息(
            枚举_消息处理类型::派生需求上报消息,
            枚举_消息来源链::任务管理工作线程回流消息);
        消息.变化项集.push_back(构造特征变化项(
            枚举_存在类型::任务管理任务,
            事件.任务根ID,
            枚举_特征类型::当前阻塞状态,
            0,
            特征值{ static_cast<I64>(枚举_任务推进事件类型::派生需求上报) },
            true,
            true,
            false,
            "派生需求上报"));
        break;
    case 枚举_任务推进事件类型::局部结果返回:
    case 枚举_任务推进事件类型::最终结果返回:
    case 枚举_任务推进事件类型::异常上报:
        消息 = 构造治理消息(
            枚举_消息处理类型::结果与关键中间状态回流消息,
            枚举_消息来源链::任务管理工作线程回流消息);
        消息.变化项集.push_back(构造特征变化项(
            枚举_存在类型::任务,
            事件.任务根ID,
            枚举_特征类型::结果状态,
            0,
            特征值{ static_cast<I64>(事件.事件类型) },
            true,
            事件.事件类型 == 枚举_任务推进事件类型::异常上报,
            false,
            {}));
        break;
    case 枚举_任务推进事件类型::未定义:
    default:
        消息 = 构造治理消息(
            枚举_消息处理类型::未定义,
            枚举_消息来源链::任务管理工作线程回流消息);
        break;
    }

    消息.头.来源任务主键 = 事件.任务根ID;
    消息.头.目标任务主键 = 事件.任务根ID;
    消息.头.作用对象主键 = 事件.任务根ID;
    消息.语义.动作主体类型 = 枚举_存在类型::任务管理任务;
    消息.语义.动作主体主键 = 事件.任务根ID;
    消息.语义.作用对象类型 = 枚举_存在类型::任务;
    消息.语义.作用对象主键 = 事件.任务根ID;
    return 消息;
}

// 功能：按函数名执行对应处理。
inline 结构_治理消息 从任务管理线程状态消息构造治理消息(
    const 结构_任务管理线程状态消息& 任务管理消息输入) noexcept
{
    auto 任务管理消息 = 任务管理消息输入;
    同步任务管理线程状态消息语义槽(任务管理消息);

    const auto 产生时间 =
        任务管理消息.结束时间 != 0
        ? 任务管理消息.结束时间
        : 任务管理消息.消息头.产生时间;
    const auto 发出者主键 = 安全解析或散列任务管理主键(任务管理消息.消息头.发出者主键);
    const auto 任务管理任务主键 = 安全解析或散列任务管理主键(任务管理消息.消息头.任务管理任务主键);
    const auto 任务主键 = 安全解析或散列任务管理主键(任务管理消息.消息头.任务主键);
    const auto 是否故障触发 =
        任务管理消息.结束状态 == 枚举_任务管理线程结束状态::故障结束
        || 任务管理消息.当前运行状态 == 枚举_任务管理线程运行状态::故障;

    auto 治理消息 = 构造治理消息(
        枚举_消息处理类型::结果与关键中间状态回流消息,
        枚举_消息来源链::任务管理工作线程回流消息,
        产生时间);
    治理消息.头.发出者主键 = 发出者主键;
    治理消息.头.动作主体主键 = 任务管理任务主键;
    治理消息.头.作用对象主键 = 任务主键;
    治理消息.头.来源线程主键 = 发出者主键;
    治理消息.头.来源任务主键 = 任务主键;
    治理消息.头.目标任务主键 = 治理消息.头.来源任务主键;
    治理消息.头.父任务主键 = 安全解析或散列任务管理主键(任务管理消息.消息头.父任务主键);
    治理消息.头.关联场景主键 = 安全解析或散列任务管理主键(任务管理消息.消息头.关联场景主键);
    治理消息.头.回复目标消息主键 = 任务管理消息.消息头.回复目标消息主键;
    治理消息.头.路径签名 = 任务管理消息.消息头.路径签名;
    治理消息.头.来源成功 = !是否故障触发;
    治理消息.语义.发出者类型 = 枚举_存在类型::任务管理工作线程;
    治理消息.语义.发出者主键 = 发出者主键;
    治理消息.语义.动作主体类型 = 枚举_存在类型::任务管理任务;
    治理消息.语义.动作主体主键 = 治理消息.头.动作主体主键;
    治理消息.语义.动作语义键 = "任务管理执行尝试状态上报";
    治理消息.语义.作用对象类型 = 枚举_存在类型::任务;
    治理消息.语义.作用对象主键 = 治理消息.头.作用对象主键;
    治理消息.语义.记录者类型 = 枚举_存在类型::自我线程;
    治理消息.语义.事实摘要 = 构造任务管理线程状态消息文本(任务管理消息);
    治理消息.语义.因果摘要 = 任务管理线程结束状态文本(任务管理消息.结束状态);
    治理消息.来源.影子验证状态 = 任务管理消息.消息头.影子验证状态;
    治理消息.来源.允许正式资产提交 = 任务管理消息.消息头.允许正式资产提交;
    治理消息.附加载荷.任务管理线程状态 = 任务管理消息;

    auto 汇总 = 从线程状态消息构造执行尝试汇总(任务管理消息);
    auto 对账结果 = 刷新执行尝试汇总状态(&汇总);
    治理消息.附加载荷.执行尝试汇总 = 汇总;
    治理消息.附加载荷.执行对账结果 = 对账结果;
    治理消息.摘要 = 构造任务管理线程状态消息文本(任务管理消息);
    if (!任务管理消息.消息头.幂等键.empty()) {
        治理消息.载荷键 = "任务管理线程状态|" + 任务管理消息.消息头.幂等键;
    }
    return 治理消息;
}

// 功能：按函数名执行对应处理。
inline 结构_治理消息 从任务管理派生需求消息构造治理消息(
    const 结构_任务管理派生需求消息& 任务管理消息输入) noexcept
{
    auto 任务管理消息 = 任务管理消息输入;
    同步任务管理派生需求消息语义槽(任务管理消息);

    auto 治理消息 = 构造治理消息(
        枚举_消息处理类型::派生需求上报消息,
        枚举_消息来源链::任务管理工作线程回流消息,
        任务管理消息.消息头.产生时间);
    治理消息.头.发出者主键 = 安全解析或散列任务管理主键(任务管理消息.消息头.发出者主键);
    治理消息.头.动作主体主键 = 安全解析或散列任务管理主键(任务管理消息.消息头.任务管理任务主键);
    治理消息.头.作用对象主键 = 安全解析或散列任务管理主键(任务管理消息.消息头.任务主键);
    治理消息.头.来源线程主键 = 治理消息.头.发出者主键;
    治理消息.头.来源任务主键 = 治理消息.头.作用对象主键;
    治理消息.头.目标任务主键 = 治理消息.头.作用对象主键;
    治理消息.头.父任务主键 = 安全解析或散列任务管理主键(任务管理消息.消息头.父任务主键);
    治理消息.头.关联场景主键 = 安全解析或散列任务管理主键(任务管理消息.消息头.关联场景主键);
    治理消息.头.回复目标消息主键 = 任务管理消息.消息头.回复目标消息主键;
    治理消息.头.路径签名 = 任务管理消息.消息头.路径签名;
    治理消息.头.来源成功 = true;
    治理消息.语义.发出者类型 = 枚举_存在类型::任务管理工作线程;
    治理消息.语义.发出者主键 = 治理消息.头.发出者主键;
    治理消息.语义.动作主体类型 = 枚举_存在类型::任务管理任务;
    治理消息.语义.动作主体主键 = 治理消息.头.动作主体主键;
    治理消息.语义.动作类型 = 枚举_动作类型::派生需求上报;
    治理消息.语义.动作类型值 = static_cast<I64>(治理消息.语义.动作类型);
    治理消息.语义.动作语义键 =
        !任务管理消息.触发动作语义键.empty()
        ? 任务管理消息.触发动作语义键
        : "任务管理派生需求上报";
    治理消息.语义.作用对象类型 = 枚举_存在类型::任务;
    治理消息.语义.作用对象主键 = 治理消息.头.作用对象主键;
    治理消息.语义.事实摘要 = 构造任务管理派生需求消息文本(任务管理消息);
    治理消息.语义.因果摘要 = 任务管理派生需求类型文本(任务管理消息.派生需求类型);
    治理消息.来源.影子验证状态 = 任务管理消息.消息头.影子验证状态;
    治理消息.来源.允许正式资产提交 = 任务管理消息.消息头.允许正式资产提交;
    治理消息.附加载荷.任务管理派生需求 = 任务管理消息;

    if (任务管理消息.是否阻塞当前步骤) {
        治理消息.变化项集.push_back(构造特征变化项(
            枚举_存在类型::任务管理任务,
            治理消息.头.动作主体主键,
            枚举_特征类型::当前阻塞状态,
            0,
            特征值{ static_cast<I64>(任务管理消息.派生需求类型) },
            true,
            任务管理消息.是否阻塞当前步骤,
            false,
            任务管理派生需求类型文本(任务管理消息.派生需求类型)));
    }
    if (任务管理消息.是否本地不可消化 || 任务管理消息.是否阻塞当前步骤) {
        治理消息.变化项集.push_back(构造特征变化项(
            枚举_存在类型::任务,
            治理消息.头.作用对象主键,
            枚举_特征类型::条件满足状态,
            0,
            特征值{ static_cast<I64>(0) },
            true,
            任务管理消息.是否阻塞当前步骤,
            false,
            !任务管理消息.需求特征类型主键.empty()
            ? 任务管理消息.需求特征类型主键
            : "本地不可消化缺口"));
    }
    if (任务管理消息.是否阻塞当前步骤 || 任务管理消息.是否影响父任务推进) {
        治理消息.变化项集.push_back(构造特征变化项(
            枚举_存在类型::任务,
            治理消息.头.作用对象主键,
            枚举_特征类型::是否允许继续派发,
            0,
            特征值{ static_cast<I64>(0) },
            true,
            false,
            false,
            "派生需求阻塞推进"));
    }
    if (任务管理消息.是否可能影响安全) {
        治理消息.变化项集.push_back(构造特征变化项(
            枚举_存在类型::任务管理任务,
            治理消息.头.动作主体主键,
            枚举_特征类型::风险等级,
            0,
            特征值{ static_cast<I64>(任务管理消息.阻塞级别) },
            true,
            false,
            false,
            "派生需求风险提示"));
    }

    治理消息.摘要 = 构造任务管理派生需求消息文本(任务管理消息);
    if (!任务管理消息.消息头.幂等键.empty()) {
        治理消息.载荷键 = "任务管理派生需求|" + 任务管理消息.消息头.幂等键;
    }
    return 治理消息;
}

// 功能：按函数名执行对应处理。
inline 结构_治理消息 从任务管理结果状态消息构造治理消息(
    const 结构_任务管理结果状态消息& 任务管理消息输入) noexcept
{
    auto 任务管理消息 = 任务管理消息输入;
    同步任务管理结果状态消息语义槽(任务管理消息);

    auto 治理消息 = 构造治理消息(
        枚举_消息处理类型::结果与关键中间状态回流消息,
        枚举_消息来源链::任务管理工作线程回流消息,
        任务管理消息.消息头.产生时间);
    治理消息.头.发出者主键 = 安全解析或散列任务管理主键(任务管理消息.消息头.发出者主键);
    治理消息.头.动作主体主键 = 安全解析或散列任务管理主键(任务管理消息.消息头.任务管理任务主键);
    治理消息.头.作用对象主键 = 安全解析或散列任务管理主键(任务管理消息.消息头.任务主键);
    治理消息.头.来源线程主键 = 治理消息.头.发出者主键;
    治理消息.头.来源任务主键 = 治理消息.头.作用对象主键;
    治理消息.头.目标任务主键 = 治理消息.头.作用对象主键;
    治理消息.头.父任务主键 = 安全解析或散列任务管理主键(任务管理消息.消息头.父任务主键);
    治理消息.头.关联场景主键 = 安全解析或散列任务管理主键(任务管理消息.消息头.关联场景主键);
    治理消息.头.回复目标消息主键 = 任务管理消息.消息头.回复目标消息主键;
    治理消息.头.路径签名 = 任务管理消息.消息头.路径签名;
    治理消息.头.来源成功 = 任务管理消息.是否成功;
    治理消息.头.错误码 = 任务管理消息.错误码;
    if (任务管理消息.是否成功
        || 任务管理消息.结果状态 == 枚举_任务管理结果状态::成功
        || 任务管理消息.结果状态 == 枚举_任务管理结果状态::收束完成) {
        治理消息.头.优先级 = 枚举_治理消息优先级::紧急;
        治理消息.头.优先级值 = static_cast<I64>(治理消息.头.优先级);
    }
    治理消息.语义.发出者类型 = 枚举_存在类型::任务管理工作线程;
    治理消息.语义.发出者主键 = 治理消息.头.发出者主键;
    治理消息.语义.动作主体类型 = 枚举_存在类型::任务管理任务;
    治理消息.语义.动作主体主键 = 治理消息.头.动作主体主键;
    治理消息.语义.动作类型 = 枚举_动作类型::结果回流;
    治理消息.语义.动作类型值 = static_cast<I64>(治理消息.语义.动作类型);
    治理消息.语义.动作语义键 = "任务管理结果上报";
    治理消息.语义.作用对象类型 = 枚举_存在类型::任务;
    治理消息.语义.作用对象主键 = 治理消息.头.作用对象主键;
    治理消息.语义.事实摘要 = 构造任务管理结果状态消息文本(任务管理消息);
    治理消息.语义.因果摘要 = 任务管理结果状态文本(任务管理消息.结果状态);
    治理消息.来源.影子验证状态 = 任务管理消息.消息头.影子验证状态;
    治理消息.来源.允许正式资产提交 = 任务管理消息.消息头.允许正式资产提交;
    治理消息.变化项集.push_back(构造特征变化项(
        枚举_存在类型::任务,
        治理消息.头.作用对象主键,
        枚举_特征类型::结果状态,
        0,
        特征值{ static_cast<I64>(映射任务管理结果状态(任务管理消息.结果状态)) },
        true,
        false,
        false,
        任务管理结果状态文本(任务管理消息.结果状态)));
    治理消息.变化项集.push_back(构造特征变化项(
        枚举_存在类型::任务,
        治理消息.头.作用对象主键,
        枚举_特征类型::局部完成度,
        0,
        特征值{ static_cast<I64>(任务管理消息.完成度 * 10000.0) },
        true,
        false,
        false,
        "结果完成度"));
    治理消息.附加载荷.任务管理结果状态 = 任务管理消息;

    auto 汇总 = 从结果消息构造执行尝试汇总(任务管理消息);
    auto 对账结果 = 刷新执行尝试汇总状态(&汇总);
    治理消息.附加载荷.执行尝试汇总 = 汇总;
    治理消息.附加载荷.执行对账结果 = 对账结果;
    治理消息.摘要 = 构造任务管理结果状态消息文本(任务管理消息);
    if (!任务管理消息.消息头.幂等键.empty()) {
        治理消息.载荷键 = "任务管理结果状态|" + 任务管理消息.消息头.幂等键;
    }
    return 治理消息;
}

// 功能：按函数名执行对应处理。
inline 结构_治理消息 从自检报告消息构造治理消息(
    const 结构_自检报告消息& 自检报告输入) noexcept
{
    auto 自检报告 = 自检报告输入;
    同步自检报告消息语义槽(自检报告);

    auto 治理消息 = 构造治理消息(
        枚举_消息处理类型::自检报告消息,
        枚举_消息来源链::自检线程报告消息,
        自检报告.生成时间);
    治理消息.头.发出者主键 = 自检报告.来源自检线程主键;
    治理消息.头.动作主体主键 = 自检报告.来源自检线程主键;
    治理消息.头.来源线程主键 = 自检报告.来源自检线程主键;
    治理消息.语义.发出者类型 = 枚举_存在类型::自检线程;
    治理消息.语义.发出者主键 = 自检报告.来源自检线程主键;
    治理消息.语义.动作主体类型 = 枚举_存在类型::自检线程;
    治理消息.语义.动作主体主键 = 自检报告.来源自检线程主键;
    治理消息.语义.动作类型 = 枚举_动作类型::自检报告;
    治理消息.语义.动作类型值 = static_cast<I64>(治理消息.语义.动作类型);
    治理消息.附加载荷.自检报告 = 自检报告;
    治理消息.载荷键 = std::to_string(自检报告.报告ID);
    std::ostringstream 摘要;
    摘要 << "自检报告 | ID=" << 自检报告.报告ID
        << " | 缺口候选=" << 自检报告.缺口候选集.size();
    if (!自检报告.缺口候选集.empty()
        && !自检报告.缺口候选集.front().证据摘要.empty()) {
        摘要 << " | 首项=" << 自检报告.缺口候选集.front().证据摘要;
    }
    治理消息.摘要 = 摘要.str();
    治理消息.语义.事实摘要 = 治理消息.摘要;
    return 治理消息;
}

// 功能：按函数名执行对应处理。
inline 结构_治理消息 从任务管理观察事实承接请求构造治理消息(
    const 结构_任务管理观察事实承接请求& 任务管理消息输入) noexcept
{
    auto 任务管理消息 = 任务管理消息输入;
    同步任务管理观察事实承接请求语义槽(任务管理消息);

    auto 治理消息 = 构造治理消息(
        枚举_消息处理类型::业务域事实消息,
        枚举_消息来源链::任务管理工作线程回流消息,
        任务管理消息.消息头.产生时间);
    治理消息.头.优先级 = 枚举_治理消息优先级::紧急;
    治理消息.头.优先级值 = static_cast<I64>(治理消息.头.优先级);
    治理消息.头.可抢占 = true;
    同步治理消息头语义槽(治理消息.头);
    治理消息.头.发出者主键 =
        安全解析或散列任务管理主键(任务管理消息.消息头.发出者主键);
    治理消息.头.动作主体主键 =
        安全解析或散列任务管理主键(任务管理消息.消息头.任务管理任务主键);
    治理消息.头.作用对象主键 =
        安全解析或散列任务管理主键(任务管理消息.消息头.任务主键);
    if (治理消息.头.作用对象主键 == 0) {
        治理消息.头.作用对象主键 = 任务管理消息.报告ID;
    }
    治理消息.头.来源线程主键 = 治理消息.头.发出者主键;
    治理消息.头.来源任务主键 = 治理消息.头.作用对象主键;
    治理消息.头.目标任务主键 = 治理消息.头.作用对象主键;
    治理消息.头.父任务主键 =
        安全解析或散列任务管理主键(任务管理消息.消息头.父任务主键);
    治理消息.头.关联场景主键 =
        安全解析或散列任务管理主键(任务管理消息.消息头.关联场景主键);
    治理消息.头.回复目标消息主键 = 任务管理消息.消息头.回复目标消息主键;
    治理消息.头.路径签名 = 任务管理消息.消息头.路径签名;
    治理消息.头.来源成功 = true;
    治理消息.语义.发出者类型 = 枚举_存在类型::任务管理工作线程;
    治理消息.语义.发出者主键 = 治理消息.头.发出者主键;
    治理消息.语义.动作主体类型 = 枚举_存在类型::任务管理任务;
    治理消息.语义.动作主体主键 = 治理消息.头.动作主体主键;
    治理消息.语义.动作类型 = 枚举_动作类型::上报事实;
    治理消息.语义.动作类型值 = static_cast<I64>(治理消息.语义.动作类型);
    治理消息.语义.动作语义键 = "外设观察事实承接请求";
    治理消息.语义.作用对象类型 = 枚举_存在类型::任务;
    治理消息.语义.作用对象主键 = 治理消息.头.作用对象主键;
    治理消息.语义.事实摘要 = 构造任务管理观察事实承接请求文本(任务管理消息);
    治理消息.来源.影子验证状态 = 任务管理消息.消息头.影子验证状态;
    治理消息.来源.允许正式资产提交 = 任务管理消息.消息头.允许正式资产提交;
    治理消息.附加载荷.任务管理观察事实承接请求 = 任务管理消息;
    治理消息.摘要 = 构造任务管理观察事实承接请求文本(任务管理消息);
    if (!任务管理消息.消息头.幂等键.empty()) {
        治理消息.载荷键 = "任务管理观察事实承接|" + 任务管理消息.消息头.幂等键;
    }
    return 治理消息;
}

// 功能：执行任务、方法或动作的主体逻辑。
inline 结构_治理消息 从任务管理执行前许可请求构造治理消息(
    const 结构_任务管理执行前许可请求消息& 任务管理消息输入) noexcept
{
    auto 任务管理消息 = 任务管理消息输入;
    同步任务管理执行前许可请求语义槽(任务管理消息);

    auto 治理消息 = 构造治理消息(
        枚举_消息处理类型::业务域事实消息,
        枚举_消息来源链::任务管理工作线程回流消息,
        任务管理消息.消息头.产生时间);
    治理消息.头.优先级 = 枚举_治理消息优先级::紧急;
    治理消息.头.优先级值 = static_cast<I64>(治理消息.头.优先级);
    治理消息.头.可抢占 = true;
    同步治理消息头语义槽(治理消息.头);
    治理消息.头.发出者主键 =
        安全解析或散列任务管理主键(任务管理消息.消息头.发出者主键);
    治理消息.头.动作主体主键 =
        安全解析或散列任务管理主键(任务管理消息.消息头.任务管理任务主键);
    治理消息.头.作用对象主键 =
        安全解析或散列任务管理主键(任务管理消息.消息头.任务主键);
    if (治理消息.头.作用对象主键 == 0) {
        治理消息.头.作用对象主键 = 任务管理消息.工作项ID;
    }
    治理消息.头.来源线程主键 = 治理消息.头.发出者主键;
    治理消息.头.来源任务主键 = 治理消息.头.作用对象主键;
    治理消息.头.目标任务主键 = 治理消息.头.作用对象主键;
    治理消息.头.父任务主键 =
        安全解析或散列任务管理主键(任务管理消息.消息头.父任务主键);
    治理消息.头.关联场景主键 =
        安全解析或散列任务管理主键(任务管理消息.消息头.关联场景主键);
    治理消息.头.回复目标消息主键 = 任务管理消息.消息头.回复目标消息主键;
    治理消息.头.路径签名 = 任务管理消息.消息头.路径签名;
    治理消息.头.来源成功 = true;
    治理消息.语义.发出者类型 = 枚举_存在类型::任务管理工作线程;
    治理消息.语义.发出者主键 = 治理消息.头.发出者主键;
    治理消息.语义.动作主体类型 = 枚举_存在类型::任务管理任务;
    治理消息.语义.动作主体主键 = 治理消息.头.动作主体主键;
    治理消息.语义.动作类型 = 枚举_动作类型::上报事实;
    治理消息.语义.动作类型值 = static_cast<I64>(治理消息.语义.动作类型);
    治理消息.语义.动作语义键 = "任务执行前许可请求";
    治理消息.语义.作用对象类型 = 枚举_存在类型::任务;
    治理消息.语义.作用对象主键 = 治理消息.头.作用对象主键;
    治理消息.语义.事实摘要 = 构造任务管理执行前许可请求文本(任务管理消息);
    治理消息.来源.影子验证状态 = 任务管理消息.消息头.影子验证状态;
    治理消息.来源.允许正式资产提交 = 任务管理消息.消息头.允许正式资产提交;
    治理消息.附加载荷.任务管理执行前许可请求 = 任务管理消息;
    治理消息.摘要 = 构造任务管理执行前许可请求文本(任务管理消息);
    if (!任务管理消息.消息头.幂等键.empty()) {
        治理消息.载荷键 = "任务管理执行前许可|" + 任务管理消息.消息头.幂等键;
    } else if (任务管理消息.工作项ID != 0) {
        治理消息.载荷键 =
            "任务管理执行前许可|工作项=" + std::to_string(任务管理消息.工作项ID);
    }
    return 治理消息;
}

// 功能：按函数名执行对应处理。
inline 结构_治理消息 从控制面板刷新请求构造治理消息(
    const 结构_控制面板刷新请求消息& 请求) noexcept
{
    auto 治理消息 = 构造治理消息(
        枚举_消息处理类型::控制面板刷新请求消息,
        枚举_消息来源链::界面线程控制消息,
        请求.请求时间);
    治理消息.头.发出者主键 = 请求.来源界面主键;
    治理消息.头.动作主体主键 = 请求.来源界面主键;
    治理消息.头.来源线程主键 = 请求.来源界面主键;
    治理消息.语义.发出者类型 = 枚举_存在类型::控制面板界面线程;
    治理消息.语义.发出者主键 = 请求.来源界面主键;
    治理消息.语义.动作主体类型 = 枚举_存在类型::控制面板界面线程;
    治理消息.语义.动作主体主键 = 请求.来源界面主键;
    治理消息.语义.作用对象类型 = 枚举_存在类型::控制面板摘要线程;
    治理消息.语义.动作类型 = 枚举_动作类型::控制面板刷新请求;
    治理消息.语义.动作类型值 = static_cast<I64>(治理消息.语义.动作类型);
    治理消息.附加载荷.控制面板刷新请求 = 请求;
    治理消息.载荷键 = std::to_string(static_cast<std::uint64_t>(请求.请求时间));
    std::ostringstream 摘要;
    摘要 << "控制面板刷新请求 | 时间=" << 请求.请求时间
        << " | 来源=" << 请求.来源界面主键;
    治理消息.摘要 = 摘要.str();
    治理消息.语义.事实摘要 = 治理消息.摘要;
    return 治理消息;
}

// 功能：按函数名执行对应处理。
inline 结构_治理消息 从任务管理上行消息构造治理消息(
    const 结构_任务管理上行消息& 上行消息输入) noexcept
{
    auto 上行消息 = 上行消息输入;
    同步任务管理上行消息语义槽(上行消息);

    switch (上行消息.类型) {
    case 枚举_任务管理上行消息类型::线程状态消息:
        if (const auto* 消息 = std::get_if<结构_任务管理线程状态消息>(&上行消息.载荷)) {
            return 从任务管理线程状态消息构造治理消息(*消息);
        }
        break;
    case 枚举_任务管理上行消息类型::派生需求消息:
        if (const auto* 消息 = std::get_if<结构_任务管理派生需求消息>(&上行消息.载荷)) {
            return 从任务管理派生需求消息构造治理消息(*消息);
        }
        break;
    case 枚举_任务管理上行消息类型::结果状态消息:
        if (const auto* 消息 = std::get_if<结构_任务管理结果状态消息>(&上行消息.载荷)) {
            return 从任务管理结果状态消息构造治理消息(*消息);
        }
        break;
    case 枚举_任务管理上行消息类型::观察事实承接请求:
        if (const auto* 消息 = std::get_if<结构_任务管理观察事实承接请求>(&上行消息.载荷)) {
            return 从任务管理观察事实承接请求构造治理消息(*消息);
        }
        break;
    case 枚举_任务管理上行消息类型::执行前许可请求:
        if (const auto* 消息 = std::get_if<结构_任务管理执行前许可请求消息>(&上行消息.载荷)) {
            return 从任务管理执行前许可请求构造治理消息(*消息);
        }
        break;
    case 枚举_任务管理上行消息类型::未定义:
    default:
        break;
    }

    return 构造治理消息(
        枚举_消息处理类型::未定义,
        枚举_消息来源链::任务管理工作线程回流消息);
}

