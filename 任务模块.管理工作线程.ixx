export namespace 任务管理工作线程 {

struct 结构_工作线程一步结果 {
    std::vector<结构_任务推进事件> 推进事件列表{};
    std::vector<结构_任务管理上行消息> 上行消息集{};
    bool 任务管理上位输入已刷新 = false;
    bool 任务管理治理触发 = false;
    bool 已执行当前步骤方法 = false;
    bool 存在当前步骤方法执行数据 = false;
    结构_任务步骤执行结果_最小 当前步骤方法执行数据{};
    特征节点类* 当前步骤方法运行结果 = nullptr;
    bool 存在任务推进回执 = false;
    任务模块::筹办::结构_任务推进回执 当前任务推进回执{};
    结构_任务管理结果 治理结果{};
};

struct 结构_工作线程一步响应 {
    bool 推进成功 = false;
    结构_任务控制态 最新任务控制态{};
    结构_任务局部运行态 最新任务局部运行态{};
    结构_工作线程一步结果 一步结果{};
};

struct 结构_工作线程实例快照 {
    bool 已启动 = false;
    bool 正在执行 = false;
    bool 已收到请求 = false;
    bool 停止请求 = false;
    bool 故障 = false;
    std::uint64_t 工作线程ID = 1;
    std::uint64_t 最近任务根ID = 0;
    std::uint64_t 最近请求ID = 0;
    std::uint64_t 最近工作项ID = 0;
    std::uint64_t 累计推进次数 = 0;
    std::uint64_t 累计收到请求数 = 0;
    std::uint64_t 累计收到工作项数 = 0;
    std::uint64_t 累计处理工作项数 = 0;
    std::uint64_t 累计成功推进数 = 0;
    std::uint64_t 累计失败数 = 0;
    std::uint64_t 累计派生需求数 = 0;
    std::uint64_t 累计收到控制请求数 = 0;
    std::uint64_t 累计发送上行消息数 = 0;
    std::uint64_t 最近一次上行消息数 = 0;
    std::uint64_t 当前排队数 = 0;
    时间戳 最近开始时间 = 0;
    时间戳 最近结束时间 = 0;
    时间戳 最近推进时间 = 0;
    std::string 最近宿主任务主键{};
    std::string 最近任务虚拟存在主键{};
    std::string 最近需求主键{};
    std::string 最近步骤主键{};
    std::string 最近方法主键{};
    std::string 最近下一步去向{};
    std::string 最近总控结果{};
    std::string 最近因果链状态{};
    std::string 最近缺口归类{};
    std::string 最近推进阶段{};
    std::string 最近推进状况{};
    std::string 最近筹办承接{};
    // 仅供程序调试和日志展示，绝不能作为逻辑语义、业务判断、去重、结算或因果依据。
    std::string 最近等待原因{};
    std::string 最近错误说明{};
    std::uint64_t 最近特征变化数 = 0;
};

struct 结构_界面优先级结果 {
    任务类::节点类* 当前最高优先级任务 = nullptr;
    std::int64_t 调度优先级 = 0;
    bool 是否硬中断任务 = false;
    bool 是否可执行 = false;
    bool 是否安全方向任务 = false;
    bool 是否服务方向任务 = false;
    std::int32_t 来源步骤序号 = 0;
    bool 来源于前置步骤 = false;
};

enum class 枚举_外设消息承接处理状态 : std::uint8_t {
    未处理 = 0,
    无匹配报告 = 1,
    已生成任务回执 = 2,
    已生成观察事实承接请求 = 3,
    已生成稳定特征承接请求 = 4,
};

struct 结构_外设消息承接结果 {
    枚举_外设消息承接处理状态 处理状态 = 枚举_外设消息承接处理状态::未处理;
    bool 已处理 = false;
    bool 命中报告 = false;
    bool 生成任务回执 = false;
    bool 生成观察事实承接请求 = false;
    bool 生成稳定特征承接请求 = false;
    std::uint64_t 等待项ID = 0;
    std::uint64_t 报告ID = 0;
    std::string 目标外设{};
    std::string 报告类型文本{};
    std::string 观察运行模式文本{};
    std::string 承接摘要{};
    std::vector<结构_任务管理上行消息> 上行消息集{};
};

const char* 外设消息承接处理状态文本(枚举_外设消息承接处理状态 状态) noexcept;

结构_外设消息承接结果 任务管理外设消息承接_处理一次(
    const 结构_外设观察等待项& 等待项);

std::string 构造任务管理外设消息承接结果摘要(
    const 结构_外设消息承接结果& 结果);

bool 确保任务管理工作线程壳已启动() noexcept;

bool 提交任务工作项(
    自我类& 自我对象,
    const 任务管理线程协议::结构_任务工作项& 工作项,
    任务管理线程协议::结构_任务工作结果* 输出 = nullptr) noexcept;

bool 读取任务管理工作线程快照(结构_工作线程实例快照* 输出) noexcept;

bool 计算任务管理界面优先级结果(
    const 自我类& 自我对象,
    结构_界面优先级结果* 输出) noexcept;

void 停止任务管理工作线程壳() noexcept;

} // namespace 任务管理工作线程

namespace {

using 任务节点 = 任务类::节点类;
using 需求节点 = 需求类::节点类;
using 方法节点 = 方法类::节点类;

struct 结构_工作线程壳状态 {
    std::mutex 锁{};
    任务管理工作线程::结构_工作线程实例快照 快照{};
    bool 工作线程壳已启动 = false;
    std::vector<std::string> 最近筹办派生需求稳定键集{};
};

结构_工作线程壳状态& 私有_壳状态() noexcept
{
    static 结构_工作线程壳状态 状态{};
    return 状态;
}

时间戳 私有_时间(时间戳 now) noexcept
{
    return now != 0 ? now : 结构体_时间戳::当前_微秒();
}

std::string 私有_任务主键(const 任务节点* 节点) noexcept
{
    return 节点 ? 节点->获取主键() : std::string{};
}

std::string 私有_需求主键(const 需求节点* 节点) noexcept
{
    return 节点 ? 节点->获取主键() : std::string{};
}

任务节点* 私有_任务根节点取任务(const 结构_任务根节点& 根节点) noexcept
{
    if (根节点.世界任务根指针 != 0) {
        return reinterpret_cast<任务节点*>(根节点.世界任务根指针);
    }
    if (根节点.父任务指针 != 0) {
        return reinterpret_cast<任务节点*>(根节点.父任务指针);
    }
    return nullptr;
}

任务节点* 私有_任务根节点取管理对象任务(const 结构_任务根节点& 根节点) noexcept
{
    return 根节点.管理对象任务指针 != 0
        ? reinterpret_cast<任务节点*>(根节点.管理对象任务指针)
        : nullptr;
}

void 私有_写入任务节点引用(
    可解析引用<任务节点类>& 输出,
    任务节点* 节点) noexcept
{
    输出.指针 = reinterpret_cast<任务节点类*>(节点);
    输出.主键 = 节点 ? 节点->获取主键() : std::string{};
}

void 私有_写入需求节点引用(
    可解析引用<需求节点类>& 输出,
    需求节点* 节点) noexcept
{
    输出.指针 = reinterpret_cast<需求节点类*>(节点);
    输出.主键 = 节点 ? 节点->获取主键() : std::string{};
}

void 私有_写入方法节点引用(
    可解析引用<方法节点类>& 输出,
    方法类::节点类* 节点) noexcept
{
    输出.指针 = reinterpret_cast<方法节点类*>(节点);
    输出.主键 = 节点 ? 节点->获取主键() : std::string{};
}

void 私有_写入场景节点引用(
    可解析引用<场景节点类>& 输出,
    场景节点类* 节点) noexcept
{
    输出.指针 = 节点;
    输出.主键 = 节点 ? 节点->获取主键() : std::string{};
}

void 私有_写入状态节点引用(
    可解析引用<状态节点类>& 输出,
    状态节点类* 节点) noexcept
{
    输出.指针 = 节点;
    输出.主键 = 节点 ? 节点->获取主键() : std::string{};
}

bool 私有_语素入口相同(const 语素入口节点类* 左, const 语素入口节点类* 右) noexcept
{
    if (左 == 右) return true;
    if (!左 || !右) return false;
    return 左->获取主键() == 右->获取主键();
}

const 语素入口节点类* 私有_任务语义特征词(const char* 名称) noexcept
{
    return 名称 ? 语素集.添加信息入口词(名称, 枚举_信息入口类型::特征模板入口) : nullptr;
}

const 语素入口节点类* 私有_任务语义状态词(const char* 名称) noexcept
{
    return 名称 ? 语素集.添加信息入口词(名称, 枚举_信息入口类型::状态模板入口) : nullptr;
}

