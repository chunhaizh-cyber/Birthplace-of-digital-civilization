// 功能：等待线程、任务、外设或条件变化。
bool 私有_任务已有等待承接证据(const 任务节点* 任务) noexcept
{
    return 任务
        && 任务类::读取任务等待缺口唤醒(
            任务,
            false,
            任务类::解析任务场景(任务));
}

// 功能：服务所在模块的内部辅助流程。
bool 私有_读基础节点指针特征(
    const 基础信息节点类* 宿主,
    const 语素入口节点类* 特征类型,
    void*& 输出指针) noexcept
{
    输出指针 = nullptr;
    return 宿主
        && 特征类型
        && 世界树.读取特征_指针(宿主, 特征类型, 输出指针)
        && 输出指针;
}

// 功能：服务所在模块的内部辅助流程。
bool 私有_读基础节点I64特征(
    const 基础信息节点类* 宿主,
    const 语素入口节点类* 特征类型,
    I64& 输出值) noexcept
{
    输出值 = 0;
    return 宿主
        && 特征类型
        && 世界树.读取特征_I64(宿主, 特征类型, 输出值);
}

// 功能：从指定来源读取数据或状态。
场景节点类* 私有_读取任务可执行输入参数场景(任务节点* 任务) noexcept
{
    auto* 任务虚拟存在 = 任务
        ? 任务类::解析任务虚拟存在(任务)
        : nullptr;
    void* 指针 = nullptr;
    if (私有_读基础节点指针特征(
            reinterpret_cast<基础信息节点类*>(任务虚拟存在),
            私有_特征_可执行输入参数场景(),
            指针)) {
        return reinterpret_cast<场景节点类*>(指针);
    }
    return nullptr;
}

// 功能：执行对应模块、线程或方法的运行逻辑。
任务模块::筹办::枚举_任务推进状况 私有_从筹办运行回执推导状况(
    枚举_任务状态 建议状态,
    const 语素入口节点类* 筹办缺口) noexcept
{
    using 任务模块::筹办::枚举_任务推进状况;
    if (建议状态 == 枚举_任务状态::完成) {
        return 枚举_任务推进状况::父需求已满足;
    }
    if (建议状态 == 枚举_任务状态::就绪
        || 语素入口同一(筹办缺口, 私有_值_无筹办缺口())) {
        return 枚举_任务推进状况::方法可执行;
    }
    if (语素入口同一(筹办缺口, 私有_值_筹办缺口_任务信息缺失())
        || 语素入口同一(筹办缺口, 私有_值_筹办缺口_需求目标不可解析())) {
        return 枚举_任务推进状况::未定义;
    }
    if (语素入口同一(筹办缺口, 私有_值_筹办缺口_无确定候选方法())) {
        return 枚举_任务推进状况::方法查找未命中;
    }
    if (语素入口同一(筹办缺口, 私有_值_筹办缺口_候选方法缺执行入口())) {
        return 枚举_任务推进状况::方法缺可执行入口;
    }
    if (语素入口同一(筹办缺口, 私有_值_筹办缺口_候选方法条件不满足())) {
        return 枚举_任务推进状况::方法缺条件结果对;
    }
    if (语素入口同一(筹办缺口, 私有_值_筹办缺口_参数配对失败())) {
        return 枚举_任务推进状况::参数不可配;
    }
    if (语素入口同一(筹办缺口, 私有_值_筹办缺口_候选方法不可用())) {
        return 枚举_任务推进状况::方法运行账不足;
    }
    return 建议状态 == 枚举_任务状态::等待中
        ? 枚举_任务推进状况::存在活动子需求
        : 枚举_任务推进状况::未定义;
}

任务模块::筹办::结构_任务推进回执 私有_构造执行推进回执(
    const 任务节点* 任务,
    const 需求节点* 来源需求,
    const 结构_执行任务结果& 执行结果) noexcept;

// 功能：推进任务筹办，形成候选、缺口或就绪回执。
任务模块::筹办::结构_任务筹办结果 私有_调用任务筹办普通函数(
    自我类& 自我对象,
    任务节点* 任务,
    时间戳 now) noexcept
{
    // 任务筹办是任务管理生命周期普通函数，不进入方法树候选体系，
    // 也不作为本能方法运行；它只产出结构化筹办回执供后续同步/状态提交方法使用。
    项目运行日志("任务管理工作线程/调用任务筹办普通函数 | 任务="
        + 私有_任务主键(任务));
    return 任务模块::筹办::筹办任务(自我对象, 任务, now);
}

// 功能：执行任务、方法或动作的主体逻辑。
结构_执行任务结果 私有_调用任务执行普通函数(
    任务节点* 任务,
    时间戳 now,
    任务模块::筹办::结构_任务推进回执* 输出回执) noexcept
{
    // 任务执行同样是任务管理生命周期普通函数。真正被执行的“当前方法”
    // 仍然必须是方法树中的动作能力；任务执行本身不再伪装成可选本能方法。
    项目运行日志("任务管理工作线程/调用任务执行普通函数 | 任务="
        + 私有_任务主键(任务));
    任务执行桥类 执行桥{};
    执行桥.启动(1);
    auto 结果 = 执行任务(
        执行桥,
        任务,
        now);
    if (输出回执) {
        *输出回执 = 私有_构造执行推进回执(
            任务,
            任务类::解析任务对应需求(任务),
            结果);
    }
    return 结果;
}

// 功能：服务所在模块的内部辅助流程。
结构_任务控制态 私有_构造任务控制态(
    const 结构_任务根节点& 根节点,
    const 任务节点* 任务) noexcept
{
    结构_任务控制态 控制态{};
    控制态.任务根ID = 根节点.任务根ID;
    控制态.队列状态 = !任务
        ? 枚举_任务队列状态::等待
        : (任务类::任务状态已终结(任务类::读取任务状态(任务))
            ? 枚举_任务队列状态::已结算
            : 枚举_任务队列状态::可运行);
    控制态.全局优先级 = 任务 ? 任务类::读取任务调度优先级(任务) : 0;
    控制态.绑定工作线程ID = 1;
    return 控制态;
}

// 功能：执行对应模块、线程或方法的运行逻辑。
结构_任务局部运行态 私有_构造任务局部运行态(
    const 结构_任务根节点& 根节点,
    const 任务节点* 任务) noexcept
{
    结构_任务局部运行态 运行态{};
    运行态.任务根ID = 根节点.任务根ID;
    运行态.当前状态 = !任务
        ? 枚举_任务局部运行状态::等待条件
        : (任务类::任务状态已终结(任务类::读取任务状态(任务))
            ? 枚举_任务局部运行状态::局部完成
            : 枚举_任务局部运行状态::已受理);
    运行态.当前步骤前沿 = reinterpret_cast<std::uintptr_t>(任务);
    运行态.当前等待原因 = 任务 ? std::string{} : std::string("缺少任务节点");
    return 运行态;
}

// 功能：执行任务、方法或动作的主体逻辑。
枚举_任务状态 私有_从执行结果推导界面任务状态(
    const 结构_任务步骤执行结果_最小& 任务数据,
    const 特征节点类* 方法运行结果) noexcept
{
    const auto 运行视图 = 读取本能方法运行闭环视图(
        方法运行结果,
        任务数据.结果场景);
    if (运行视图.有执行缺口()) {
        if (私有_任务已有等待承接证据(任务数据.主任务)) {
            return 枚举_任务状态::等待中;
        }
        return 枚举_任务状态::待重筹办;
    }
    if (运行视图.方法执行成功) {
        return 枚举_任务状态::待重筹办;
    }
    return 任务数据.当前方法 ? 枚举_任务状态::待重筹办 : 枚举_任务状态::等待中;
}

// 功能：服务所在模块的内部辅助流程。
std::string 私有_任务推进状况文本(
    const 任务模块::筹办::枚举_任务推进状况 状况)
{
    using 任务模块::筹办::枚举_任务推进状况;
    switch (状况) {
    case 枚举_任务推进状况::父需求已满足:
        return "父需求已满足";
    case 枚举_任务推进状况::存在活动子需求:
        return "存在活动子需求";
    case 枚举_任务推进状况::逻辑组织待聚合:
        return "逻辑组织待聚合";
    case 枚举_任务推进状况::方法查找未命中:
        return "方法查找未命中";
    case 枚举_任务推进状况::已建立方法头待重入:
        return "已建立方法头待重入";
    case 枚举_任务推进状况::缺方法动作:
        return "缺方法动作";
    case 枚举_任务推进状况::方法缺可执行入口:
        return "方法缺可执行入口";
    case 枚举_任务推进状况::方法缺条件节点:
        return "方法缺条件节点";
    case 枚举_任务推进状况::方法缺结果节点:
        return "方法缺结果节点";
    case 枚举_任务推进状况::方法缺条件结果对:
        return "方法缺条件结果对";
    case 枚举_任务推进状况::参数不可配:
        return "参数不可配";
    case 枚举_任务推进状况::方法运行账不足:
        return "方法运行账不足";
    case 枚举_任务推进状况::方法结果不稳定:
        return "方法结果不稳定";
    case 枚举_任务推进状况::方法可执行:
        return "方法可执行";
    case 枚举_任务推进状况::方法前置条件未满足:
        return "方法前置条件未满足";
    case 枚举_任务推进状况::动作执行失败:
        return "动作执行失败";
    case 枚举_任务推进状况::动作执行成功无可比较结果:
        return "动作执行成功无可比较结果";
    case 枚举_任务推进状况::目标结果符合:
        return "目标结果符合";
    case 枚举_任务推进状况::目标结果不符合:
        return "目标结果不符合";
    case 枚举_任务推进状况::出现需要附带结果:
        return "出现需要附带结果";
    case 枚举_任务推进状况::出现不需要附带结果:
        return "出现不需要附带结果";
    case 枚举_任务推进状况::出现禁止结果:
        return "出现禁止结果";
    default:
        return "未定义";
    }
}

// 功能：服务所在模块的内部辅助流程。
std::string 私有_任务推进阶段文本(
    const 任务模块::筹办::枚举_任务推进阶段 阶段)
{
    switch (阶段) {
    case 任务模块::筹办::枚举_任务推进阶段::筹办:
        return "筹办";
    case 任务模块::筹办::枚举_任务推进阶段::执行:
        return "执行";
    default:
        return "未定义";
    }
}

// 功能：服务所在模块的内部辅助流程。
bool 私有_任务推进回执目标成功(
    const 任务模块::筹办::结构_任务推进回执& 回执) noexcept
{
    return 回执.状况 == 任务模块::筹办::枚举_任务推进状况::目标结果符合
        || (回执.阶段 == 任务模块::筹办::枚举_任务推进阶段::执行
            && 回执.当前任务目标达成);
}

// 功能：服务所在模块的内部辅助流程。
bool 私有_任务推进回执目标失败(
    const 任务模块::筹办::结构_任务推进回执& 回执) noexcept
{
    return 回执.状况 == 任务模块::筹办::枚举_任务推进状况::目标结果不符合;
}

I64 私有_方法自我能力值(const 方法类::节点类* 方法) noexcept;

// 功能：服务所在模块的内部辅助流程。
bool 私有_任务推进回执是通用部分推进(
    const 任务模块::筹办::结构_任务推进回执& 回执) noexcept
{
    return 回执.阶段 == 任务模块::筹办::枚举_任务推进阶段::执行
        && 回执.状况 == 任务模块::筹办::枚举_任务推进状况::目标结果不符合
        && 回执.本轮是否有推进
        && 回执.执行结果类型 == 任务模块::筹办::枚举_任务执行结果类型::有推进未达成
        && 回执.治理结果可接受
        && !回执.需要创建或复用子需求
        && !回执.当前任务目标达成;
}

// 功能：服务所在模块的内部辅助流程。
枚举_任务状态 私有_从任务推进回执推导界面任务状态(
    const 任务模块::筹办::结构_任务推进回执& 回执,
    const 结构_任务步骤执行结果_最小& 任务数据,
    const 特征节点类* 方法运行结果) noexcept
{
    const bool 通用部分推进 =
        私有_任务推进回执是通用部分推进(回执);

    if (回执.建议任务状态 != 枚举_任务状态::未定义) {
        if (回执.建议任务状态 == 枚举_任务状态::完成
            && !私有_任务推进回执目标成功(回执)) {
            if (通用部分推进) {
                return 枚举_任务状态::执行中;
            }
            return 回执.本轮是否有推进
                ? 枚举_任务状态::待重筹办
                : 枚举_任务状态::等待中;
        }
        return 回执.建议任务状态;
    }

    using 任务模块::筹办::枚举_任务推进状况;
    switch (回执.状况) {
    case 枚举_任务推进状况::目标结果符合:
        return 枚举_任务状态::完成;
    case 枚举_任务推进状况::已建立方法头待重入:
    case 枚举_任务推进状况::动作执行成功无可比较结果:
        return 枚举_任务状态::待重筹办;
    case 枚举_任务推进状况::方法查找未命中:
        return 枚举_任务状态::挂起;
    case 枚举_任务推进状况::目标结果不符合:
        return 通用部分推进
            ? 枚举_任务状态::执行中
            : 枚举_任务状态::待重筹办;
    case 枚举_任务推进状况::父需求已满足:
    case 枚举_任务推进状况::存在活动子需求:
    case 枚举_任务推进状况::逻辑组织待聚合:
    case 枚举_任务推进状况::缺方法动作:
    case 枚举_任务推进状况::方法缺可执行入口:
    case 枚举_任务推进状况::方法缺条件节点:
    case 枚举_任务推进状况::方法缺结果节点:
    case 枚举_任务推进状况::方法缺条件结果对:
    case 枚举_任务推进状况::参数不可配:
    case 枚举_任务推进状况::方法运行账不足:
    case 枚举_任务推进状况::方法结果不稳定:
    case 枚举_任务推进状况::方法前置条件未满足:
        return 枚举_任务状态::等待中;
    case 枚举_任务推进状况::出现禁止结果:
        return 枚举_任务状态::挂起;
    case 枚举_任务推进状况::动作执行失败:
        return 回执.需要创建或复用子需求 ? 枚举_任务状态::等待中 : 枚举_任务状态::无法执行;
    default:
        return 私有_从执行结果推导界面任务状态(任务数据, 方法运行结果);
    }
}

// 功能：服务所在模块的内部辅助流程。
void 私有_填充任务层回执到治理结果(
    结构_任务管理结果& 治理结果,
    任务节点* 任务,
    const 任务模块::筹办::结构_任务推进回执& 回执,
    const 枚举_任务状态 任务状态) noexcept
{
    if (!任务) {
        return;
    }
    if (任务状态 == 枚举_任务状态::未定义) {
        return;
    }

    // 工作线程只填写“建议任务状态”和“候选/当前方法”到治理结果。
    // 任务状态、阶段、候选方法集和镜像特征的真实写入由管理界面线程统一提交。
    治理结果.宿主任务旧状态 = 任务类::读取任务状态(任务);
    if (治理结果.宿主任务旧状态 == 枚举_任务状态::未定义) {
        治理结果.宿主任务旧状态 = 枚举_任务状态::执行中;
    }
    治理结果.宿主任务新状态 = 任务状态;
    if (回执.当前方法.指针) {
        治理结果.当前方法 = reinterpret_cast<方法类::节点类*>(回执.当前方法.指针);
    }
    治理结果.已推进任务状态 = true;
}

// 功能：服务所在模块的内部辅助流程。
I64 私有_方法自我能力值(const 方法类::节点类* 方法) noexcept
{
    const auto 动作句柄 = 方法类::方法动作句柄(方法);
    if (!方法 || 动作句柄.类型 != 枚举_动作句柄类型::本能函数ID) {
        return 0;
    }
    const I64 能力值 = 动作句柄.本能ID;
    return 本能方法类::是有效本能方法能力值(能力值) ? 能力值 : 0;
}

// 功能：同步线程、任务、场景或对象之间的状态。
void 私有_同步任务回执方法到任务虚拟存在(
    任务节点* 任务,
    const 任务模块::筹办::结构_任务推进回执& 回执,
    const 时间戳 now) noexcept
{
    (void)任务;
    (void)回执;
    (void)now;
    // 兼容旧调用点的空实现：工作线程不得写任务虚拟存在。
    // 当前方法和候选方法集由管理界面线程读取工作结果后统一提交。
}

结构_执行任务结果 私有_构造未执行任务结果(
    任务节点* 任务,
    const I64 错误码,
    const std::string& 解释,
    const 枚举_任务执行记账结果 记账结果 = 枚举_任务执行记账结果::未定义) noexcept
{
    结构_执行任务结果 输出{};
    输出.任务执行结果.主任务 = 任务;
    输出.任务执行结果.当前步骤节点 = 任务;
    输出.任务执行结果.记账结果 = 记账结果;
    输出.任务执行结果.结果场景 = 任务类::解析任务场景(任务);
    输出.任务执行结果.方法运行结果 = 创建本能动作运行结果实例_按码(
        nullptr,
        输出.任务执行结果.结果场景,
        错误码);
    输出.任务执行结果.方法运行说明 = 解释;
    输出.方法运行结果 = 输出.任务执行结果.方法运行结果;
    return 输出;
}

// 功能：等待线程、任务、外设或条件变化。
std::string 私有_执行结果等待原因(
    const 结构_任务步骤执行结果_最小& 任务数据,
    const 特征节点类* 方法运行结果)
{
    if (任务结果缺条件_最小_v0(方法运行结果)) {
        return !任务数据.方法运行说明.empty()
            ? 任务数据.方法运行说明
            : std::string("执行发现实际缺失，已上报自我线程生成原子需求");
    }
    return 任务数据.当前方法
        ? std::string("方法执行未完成")
        : std::string("缺少选中自我能力值或可执行方法");
}

// 功能：等待线程、任务、外设或条件变化。
std::string 私有_推进回执等待原因(
    const 任务模块::筹办::结构_任务推进回执& 推进回执,
    const 结构_任务步骤执行结果_最小& 任务数据,
    const 特征节点类* 方法运行结果)
{
    using 任务模块::筹办::枚举_任务推进状况;
    switch (推进回执.状况) {
    case 枚举_任务推进状况::存在活动子需求:
        return "等待既有活动子需求完成";
    case 枚举_任务推进状况::逻辑组织待聚合:
        return "等待需求树聚合或逻辑组织展开";
    case 枚举_任务推进状况::父需求已满足:
        return "父需求已满足，等待提交链收束";
    case 枚举_任务推进状况::目标结果符合:
        return "目标结果符合，等待提交链收束";
    default:
        return 私有_执行结果等待原因(任务数据, 方法运行结果);
    }
}

// 功能：服务所在模块的内部辅助流程。
bool 私有_回报包含派生需求消息(
    const 任务管理工作线程::结构_工作线程一步响应& 响应) noexcept
{
    return std::any_of(
        响应.一步结果.上行消息集.begin(),
        响应.一步结果.上行消息集.end(),
        [](const auto& 消息) noexcept {
            return 消息.类型 == 枚举_任务管理上行消息类型::派生需求消息;
        });
}

// 功能：服务所在模块的内部辅助流程。
void 私有_填充派生需求父需求字段(
    结构_任务管理派生需求消息& 消息,
    const 任务节点* 任务) noexcept
{
    auto* 父需求 = 任务
        ? 任务类::解析任务对应需求(任务)
        : nullptr;
    if (父需求 && 父需求->父 == nullptr) {
        父需求 = nullptr;
    }
    if (!父需求) {
        return;
    }
    消息.父需求指针 = reinterpret_cast<std::uintptr_t>(父需求);
    消息.父需求主键 = 私有_需求主键(父需求);
}

// 功能：推进任务筹办，形成候选、缺口或就绪回执。
bool 私有_补齐筹办派生需求消息主键槽(
    结构_任务管理派生需求消息& 消息) noexcept
{
    bool 已补齐 = false;
    const auto 从节点补主键 = [&](std::string& 主键, const auto* 节点) noexcept {
        if (!主键.empty() || !节点) {
            return;
        }
        主键 = 节点->获取主键();
        已补齐 = 已补齐 || !主键.empty();
    };

    从节点补主键(
        消息.父需求主键,
        reinterpret_cast<const 需求节点*>(消息.父需求指针));
    从节点补主键(
        消息.来源因果主键,
        reinterpret_cast<const 因果节点类*>(消息.来源因果指针));
    从节点补主键(
        消息.需求特征类型主键,
        reinterpret_cast<const 语素入口节点类*>(消息.需求特征类型指针));
    从节点补主键(
        消息.需求目标主体主键,
        reinterpret_cast<const 基础信息节点类*>(消息.需求目标主体指针));
    从节点补主键(
        消息.需求当前状态主键,
        reinterpret_cast<const 状态节点类*>(消息.需求当前状态指针));
    从节点补主键(
        消息.需求目标状态主键,
        reinterpret_cast<const 状态节点类*>(消息.需求目标状态指针));
    return 已补齐;
}

// 功能：推进任务筹办，形成候选、缺口或就绪回执。
bool 私有_筹办派生需求消息字段完整(
    const 结构_任务管理派生需求消息& 消息) noexcept
{
    return !消息.父需求主键.empty()
        && 消息.派生需求类型 != 枚举_任务管理派生需求类型::未定义
        && 消息.因果路径生成类型 != 枚举_任务管理因果路径生成类型::未定义
        && 消息.阻塞级别 != 枚举_任务管理阻塞级别::未定义
        && 消息.需求特征类型指针 != 0
        && !消息.需求特征类型主键.empty()
        && 消息.需求目标主体指针 != 0
        && !消息.需求目标主体主键.empty()
        && 消息.需求当前状态指针 != 0
        && !消息.需求当前状态主键.empty()
        && 消息.需求目标状态指针 != 0
        && !消息.需求目标状态主键.empty()
        && 消息.满足关系 != 0;
}

// 功能：推进任务筹办，形成候选、缺口或就绪回执。
std::string 私有_筹办派生需求消息缺失槽位文本(
    const 结构_任务管理派生需求消息& 消息)
{
    std::vector<std::string> 缺失槽位{};
    const auto 添加 = [&](const char* 名称) {
        缺失槽位.emplace_back(名称);
    };
    const auto 添加引用槽位 = [&](
        const char* 总名,
        const char* 指针名,
        const char* 主键名,
        const std::uintptr_t 指针,
        const std::string& 主键) {
        if (指针 == 0 && 主键.empty()) {
            添加(总名);
        } else if (指针 == 0) {
            添加(指针名);
        } else if (主键.empty()) {
            添加(主键名);
        }
    };

    if (消息.父需求主键.empty()) {
        添加("父需求");
    }
    if (消息.派生需求类型 == 枚举_任务管理派生需求类型::未定义) {
        添加("派生需求类型");
    }
    if (消息.因果路径生成类型 == 枚举_任务管理因果路径生成类型::未定义) {
        添加("因果路径生成类型");
    }
    if (消息.阻塞级别 == 枚举_任务管理阻塞级别::未定义) {
        添加("阻塞级别");
    }
    添加引用槽位(
        "目标特征类型",
        "目标特征类型指针",
        "目标特征类型主键",
        消息.需求特征类型指针,
        消息.需求特征类型主键);
    添加引用槽位(
        "目标主体",
        "目标主体指针",
        "目标主体主键",
        消息.需求目标主体指针,
        消息.需求目标主体主键);
    添加引用槽位(
        "当前状态",
        "当前状态指针",
        "当前状态主键",
        消息.需求当前状态指针,
        消息.需求当前状态主键);
    添加引用槽位(
        "目标状态",
        "目标状态指针",
        "目标状态主键",
        消息.需求目标状态指针,
        消息.需求目标状态主键);
    if (消息.满足关系 == 0) {
        添加("满足关系");
    }
    if (缺失槽位.empty()) {
        return "无";
    }

    std::ostringstream 输出;
    for (std::size_t i = 0; i < 缺失槽位.size(); ++i) {
        if (i > 0) {
            输出 << ",";
        }
        输出 << 缺失槽位[i];
    }
    return 输出.str();
}

// 功能：推进任务筹办，形成候选、缺口或就绪回执。
std::string 私有_筹办派生需求消息稳定键(
    const 结构_任务管理派生需求消息& 消息)
{
    std::ostringstream 输出;
    const bool 学习缺口 =
        消息.因果路径生成类型 == 枚举_任务管理因果路径生成类型::学习缺口;
    输出 << static_cast<int>(消息.派生需求类型)
        << "|" << static_cast<int>(消息.因果路径生成类型)
        << "|" << static_cast<int>(消息.阻塞级别)
        << "|" << 消息.父需求主键
        << "|" << 消息.来源因果主键
        << "|" << 消息.需求目标主体主键
        << "|" << 消息.需求特征类型主键
        << "|" << static_cast<int>(消息.满足关系);
    if (学习缺口) {
        输出 << "|学习信息补齐状态=已补齐";
    } else {
        输出 << "|" << 消息.需求当前状态主键
            << "|" << 消息.需求目标状态主键;
    }
    输出 << "|" << static_cast<I64>(消息.满足关系);
    return 输出.str();
}

// 功能：推进任务筹办，形成候选、缺口或就绪回执。
bool 私有_最近已上报筹办派生需求稳定键(const std::string& 稳定键)
{
    auto& 状态 = 私有_壳状态();
    std::lock_guard<std::mutex> 锁(状态.锁);
    return std::find(
        状态.最近筹办派生需求稳定键集.begin(),
        状态.最近筹办派生需求稳定键集.end(),
        稳定键) != 状态.最近筹办派生需求稳定键集.end();
}

// 功能：记录日志、动态、证据或运行痕迹。
void 私有_记录最近筹办派生需求稳定键(const std::string& 稳定键)
{
    if (稳定键.empty()) {
        return;
    }
    auto& 状态 = 私有_壳状态();
    std::lock_guard<std::mutex> 锁(状态.锁);
    auto& 集合 = 状态.最近筹办派生需求稳定键集;
    if (std::find(集合.begin(), 集合.end(), 稳定键) == 集合.end()) {
        集合.push_back(稳定键);
    }
    constexpr std::size_t 最大最近键数量 = 128;
    while (集合.size() > 最大最近键数量) {
        集合.erase(集合.begin());
    }
}

// 功能：推进任务筹办，形成候选、缺口或就绪回执。
void 私有_规范化筹办派生需求消息(
    结构_任务管理派生需求消息& 消息,
    const 任务节点* 任务,
    const 时间戳 now)
{
    const auto 任务主键 = 私有_任务主键(任务);
    if (消息.消息头.发出者主键.empty()) {
        消息.消息头.发出者主键 = "任务管理工作线程";
    }
    if (消息.消息头.任务主键.empty()) {
        消息.消息头.任务主键 = 任务主键;
    }
    if (消息.消息头.步骤主键.empty()) {
        消息.消息头.步骤主键 = 任务主键;
    }
    if (消息.消息头.产生时间 == 0) {
        消息.消息头.产生时间 = now;
    }
    if (消息.父需求指针 == 0 && 消息.父需求主键.empty()) {
        私有_填充派生需求父需求字段(消息, 任务);
    }
    const bool 主键槽已补齐 = 私有_补齐筹办派生需求消息主键槽(消息);
    const auto 稳定键 = 私有_筹办派生需求消息稳定键(消息);
    if (消息.消息头.执行尝试主键.empty()) {
        消息.消息头.执行尝试主键 =
            任务主键 + "|因果路径派生需求|" + 稳定键;
    }
    if (消息.消息头.幂等键.empty()) {
        消息.消息头.幂等键 = 稳定键;
    }
    同步任务管理派生需求消息语义槽(消息);
    if (主键槽已补齐) {
        项目运行日志(
            "任务管理工作线程/因果路径派生需求主键槽补齐"
            " | 任务=" + 任务主键
            + " | " + 构造任务管理派生需求消息文本(消息)
            + " | 直接写需求树=0");
    }
}

// 功能：服务所在模块的内部辅助流程。
bool 私有_响应已包含派生需求稳定键(
    const 任务管理工作线程::结构_工作线程一步响应& 响应,
    const std::string& 稳定键)
{
    return std::any_of(
        响应.一步结果.上行消息集.begin(),
        响应.一步结果.上行消息集.end(),
        [&](const auto& 上行) {
            if (上行.类型 != 枚举_任务管理上行消息类型::派生需求消息) {
                return false;
            }
            const auto* 已有 =
                std::get_if<结构_任务管理派生需求消息>(&上行.载荷);
            return 已有
                && 私有_筹办派生需求消息稳定键(*已有) == 稳定键;
        });
}

// 功能：推进任务筹办，形成候选、缺口或就绪回执。
void 私有_吸收筹办派生需求消息(
    任务管理工作线程::结构_工作线程一步响应& 响应,
    const std::vector<结构_任务管理派生需求消息>& 消息集,
    const 任务节点* 任务,
    const 时间戳 now)
{
    if (消息集.empty()) {
        return;
    }

    std::vector<结构_任务管理派生需求消息> 候选集{};
    候选集.reserve(消息集.size());
    std::size_t 字段不完整数量 = 0;
    for (auto 消息 : 消息集) {
        私有_规范化筹办派生需求消息(消息, 任务, now);
        if (!私有_筹办派生需求消息字段完整(消息)) {
            ++字段不完整数量;
            const auto 稳定键 = 私有_筹办派生需求消息稳定键(消息);
            项目运行错误日志(
                "任务管理工作线程/派生需求消息构造逻辑错误"
                " | 缺失槽位=" + 私有_筹办派生需求消息缺失槽位文本(消息)
                + " | 任务=" + 私有_任务主键(任务)
                + " | 执行尝试键=" + 构造任务管理执行尝试键(消息.消息头)
                + " | 稳定键=" + 稳定键
                + " | " + 构造任务管理派生需求消息文本(消息)
                + " | 直接写需求树=0"
                + " | 实际发送派生需求消息=0");
            continue;
        }
        候选集.push_back(std::move(消息));
    }

    std::sort(
        候选集.begin(),
        候选集.end(),
        [](const auto& 左, const auto& 右) {
            return 私有_筹办派生需求消息稳定键(左)
                < 私有_筹办派生需求消息稳定键(右);
        });

    std::string 上一稳定键{};
    std::size_t 重复数量 = 0;
    std::size_t 同批候选重复数量 = 0;
    std::size_t 响应内已包含数量 = 0;
    std::size_t 最近缓存命中数量 = 0;
    std::size_t 上报数量 = 0;
    bool 已记录重复样本 = false;
    for (auto& 消息 : 候选集) {
        const auto 稳定键 = 私有_筹办派生需求消息稳定键(消息);
        const bool 同批候选重复 = 稳定键 == 上一稳定键;
        const bool 响应内已包含 =
            !同批候选重复
            && 私有_响应已包含派生需求稳定键(响应, 稳定键);
        const bool 最近缓存命中 =
            !同批候选重复
            && !响应内已包含
            && 私有_最近已上报筹办派生需求稳定键(稳定键);
        if (同批候选重复 || 响应内已包含 || 最近缓存命中) {
            ++重复数量;
            if (同批候选重复) {
                ++同批候选重复数量;
            } else if (响应内已包含) {
                ++响应内已包含数量;
            } else {
                ++最近缓存命中数量;
            }
            if (!已记录重复样本) {
                const char* 重复来源 = 同批候选重复
                    ? "同批候选重复"
                    : (响应内已包含 ? "响应内已包含" : "最近已上报缓存命中");
                项目运行日志(
                    "任务管理工作线程/派生需求消息幂等去重"
                    " | 重复来源=" + std::string(重复来源)
                    + " | 稳定键=" + 稳定键
                    + " | 任务=" + 私有_任务主键(任务)
                    + " | " + 构造任务管理派生需求消息文本(消息)
                    + " | 直接写需求树=0"
                    + " | 实际发送派生需求消息=0");
                已记录重复样本 = true;
            }
            continue;
        }
        上一稳定键 = 稳定键;

        结构_任务管理上行消息 上行{};
        上行.类型 = 枚举_任务管理上行消息类型::派生需求消息;
        上行.载荷 = 消息;
        同步任务管理上行消息语义槽(上行);
        响应.一步结果.上行消息集.push_back(std::move(上行));
        私有_记录最近筹办派生需求稳定键(稳定键);
        ++上报数量;

        if (上报数量 == 1) {
            项目运行日志(
                "任务管理工作线程/因果路径派生需求上报样本 | "
                + 构造任务管理派生需求消息文本(消息)
                + " | 直接写需求树=0"
                + " | 实际发送派生需求消息=1");
        }
    }

    std::ostringstream 输出;
    输出 << "任务管理工作线程/因果路径派生需求上报"
        << " | 任务=" << 私有_任务主键(任务)
        << " | 输入数量=" << 消息集.size()
        << " | 字段不完整=" << 字段不完整数量
        << " | 重复消息=" << 重复数量
        << " | 同批候选重复=" << 同批候选重复数量
        << " | 响应内已包含=" << 响应内已包含数量
        << " | 最近缓存命中=" << 最近缓存命中数量
        << " | 上报数量=" << 上报数量
        << " | 直接写需求树=0"
        << " | 实际发送派生需求消息=" << (上报数量 > 0 ? 1 : 0);
    项目运行日志(输出.str());
}

