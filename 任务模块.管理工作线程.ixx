bool 私有_语素入口同一_工作线程(const 语素入口节点类* 左, const 语素入口节点类* 右) noexcept
{
    if (!左 || !右) {
        return false;
    }
    if (左 == 右) {
        return true;
    }
    const auto 左键 = 左->获取主键();
    const auto 右键 = 右->获取主键();
    return !左键.empty() && 左键 == 右键;
}

bool 私有_需求特征是缺失参数数量_工作线程(
    const 语素入口节点类* 特征类型,
    const std::string& 特征主键 = {}) noexcept
{
    const auto* 缺失参数数量 = 私有_执行输出特征_缺失参数数量();
    if (私有_语素入口同一_工作线程(特征类型, 缺失参数数量)) {
        return true;
    }
    return 缺失参数数量
        && !特征主键.empty()
        && 特征主键 == 缺失参数数量->获取主键();
}

const 语素入口节点类* 私有_任务特征词_工作线程(const char* 名称) noexcept
{
    return 名称
        ? 语素集.添加信息入口词(名称, 枚举_信息入口类型::特征模板入口)
        : nullptr;
}

const 语素入口节点类* 私有_外设内部材料字段词_工作线程(const char* 名称) noexcept
{
    return 私有_任务特征词_工作线程(名称);
}

bool 私有_需求特征是外设内部材料字段_工作线程(
    const 语素入口节点类* 特征类型,
    const std::string& 特征主键 = {}) noexcept
{
    static constexpr const char* s_字段名集[] = {
        "像素坐标X",
        "像素坐标Y",
        "目标区域",
        "目标簇",
        "目标候选",
        "跟踪种子",
        "外设观察报告ID",
        "匹配外设观察像素簇ID",
        "外设内部簇ID",
        "外设跨帧簇ID",
        "ROI引用",
        "ROI句柄",
        "当前ROI",
        "当前掩码",
        "当前深度切片",
        "材料句柄",
        "材料句柄集",
        "原始观察帧句柄",
        "深度帧句柄",
        "彩色帧句柄",
        "对齐帧句柄",
        "像素集合掩码句柄",
        "彩色轮廓局部图句柄",
        "深度轮廓局部图句柄",
        "局部点集句柄",
        "点集句柄",
        "空间候选引用",
        "像素归属账本引用",
        "像素归属验证材料引用",
    };
    for (const auto* 字段名 : s_字段名集) {
        const auto* 字段词 = 私有_外设内部材料字段词_工作线程(字段名);
        if (私有_语素入口同一_工作线程(特征类型, 字段词)) {
            return true;
        }
        if (字段词 && !特征主键.empty() && 特征主键 == 字段词->获取主键()) {
            return true;
        }
    }
    return false;
}

bool 私有_读取执行输出缺失参数数量_工作线程(
    const 结构_执行任务结果& 执行结果,
    I64& 缺失参数数量) noexcept
{
    auto* 结果场景 = reinterpret_cast<const 基础信息节点类*>(
        执行结果.任务执行结果.结果场景);
    return 私有_读基础节点I64特征(
            结果场景,
            私有_执行输出特征_缺失参数数量(),
            缺失参数数量);
}

bool 私有_执行输出含缺失参数诊断_工作线程(
    const 结构_执行任务结果& 执行结果) noexcept
{
    I64 缺失参数数量 = 0;
    return 私有_读取执行输出缺失参数数量_工作线程(执行结果, 缺失参数数量)
        && 缺失参数数量 > 0;
}

void 私有_提示执行输出缺失参数数量_工作线程(
    const char* 阶段,
    const 结构_执行任务结果& 执行结果,
    const I64 缺失参数数量,
    const std::string& 需求特征主键 = {}) noexcept
{
    std::ostringstream 输出;
    输出 << "任务管理工作线程/发现缺失参数数量"
        << " | 阶段=" << (阶段 ? 阶段 : "空")
        << " | 任务=" << 私有_任务主键(执行结果.任务执行结果.主任务)
        << " | 当前步骤=" << 私有_任务主键(执行结果.任务执行结果.当前步骤节点)
        << " | 当前方法=" << (执行结果.任务执行结果.当前方法
            ? 执行结果.任务执行结果.当前方法->获取主键()
            : std::string{})
        << " | 方法运行结果=" << (执行结果.方法运行结果
            ? 执行结果.方法运行结果->获取主键()
            : std::string{})
        << " | 结果场景=" << (执行结果.任务执行结果.结果场景
            ? 执行结果.任务执行结果.结果场景->获取主键()
            : std::string{})
        << " | 需求特征=" << 需求特征主键
        << " | 缺失参数数量=";
    if (缺失参数数量 >= 0) {
        输出 << 缺失参数数量;
    } else {
        输出 << "未读取";
    }
    输出 << " | 处置=仅作为参数诊断并阻断派生需求入树";

    const auto 文本 = 输出.str();
    项目运行错误日志(文本);

    static std::atomic_bool s_同类错误已弹窗{ false };
    if (!s_同类错误已弹窗.exchange(true)) {
        项目弹窗错误提示("鱼巢 - 缺失参数数量诊断", 文本);
    } else {
        项目运行错误日志(
            "任务管理工作线程/发现缺失参数数量 | 同类弹窗已提示，本次仅记录错误日志");
    }
}

void 私有_提示外设内部材料字段需求化_工作线程(
    const char* 阶段,
    const 结构_执行任务结果& 执行结果,
    const std::string& 需求特征主键) noexcept
{
    std::ostringstream 输出;
    输出 << "任务管理工作线程/外设内部材料字段阻断入树"
        << " | 阶段=" << (阶段 ? 阶段 : "空")
        << " | 任务=" << 私有_任务主键(执行结果.任务执行结果.主任务)
        << " | 当前步骤=" << 私有_任务主键(执行结果.任务执行结果.当前步骤节点)
        << " | 当前方法=" << (执行结果.任务执行结果.当前方法
            ? 执行结果.任务执行结果.当前方法->获取主键()
            : std::string{})
        << " | 方法运行结果=" << (执行结果.方法运行结果
            ? 执行结果.方法运行结果->获取主键()
            : std::string{})
        << " | 结果场景=" << (执行结果.任务执行结果.结果场景
            ? 执行结果.任务执行结果.结果场景->获取主键()
            : std::string{})
        << " | 需求特征=" << 需求特征主键
        << " | 原因=外设材料字段或方法输入参数只允许作为方法内部数据/回查诊断"
        << " | 处置=阻断派生需求入树";
    项目运行警告日志(输出.str());
}

任务模块::筹办::枚举_任务推进状况 私有_从派生需求特征推导推进状况(
    const 语素入口节点类* 派生需求特征) noexcept
{
    using 任务模块::筹办::枚举_任务推进状况;
    if (私有_语素入口同一_工作线程(
            派生需求特征,
            私有_方法动作状态特征类型_执行桥_最小_v0())) {
        return 枚举_任务推进状况::缺方法动作;
    }
    if (私有_语素入口同一_工作线程(
            派生需求特征,
            私有_方法动作数量特征类型_执行桥_最小_v0())) {
        return 枚举_任务推进状况::缺方法动作;
    }
    if (私有_语素入口同一_工作线程(
            派生需求特征,
            私有_方法可执行入口数量特征类型_执行桥_最小_v0())) {
        return 枚举_任务推进状况::方法缺可执行入口;
    }
    if (私有_语素入口同一_工作线程(
            派生需求特征,
            私有_方法条件节点数量特征类型_执行桥_最小_v0())) {
        return 枚举_任务推进状况::方法缺条件节点;
    }
    if (私有_语素入口同一_工作线程(
            派生需求特征,
            私有_方法结果节点数量特征类型_执行桥_最小_v0())) {
        return 枚举_任务推进状况::方法缺结果节点;
    }
    if (私有_语素入口同一_工作线程(
            派生需求特征,
            私有_方法条件结果配对状态特征类型_执行桥_最小_v0())) {
        return 枚举_任务推进状况::方法缺条件结果对;
    }
    if (私有_语素入口同一_工作线程(
            派生需求特征,
            私有_方法条件结果对数量特征类型_执行桥_最小_v0())) {
        return 枚举_任务推进状况::方法缺条件结果对;
    }
    if (私有_语素入口同一_工作线程(
            派生需求特征,
            私有_参数配对状态特征类型_执行桥_最小_v0())) {
        return 枚举_任务推进状况::参数不可配;
    }
    if (私有_语素入口同一_工作线程(
            派生需求特征,
            私有_执行输出特征_缺失参数数量())) {
        // 缺失参数数量是参数绑定诊断，不再作为任务推进缺口类型或派生需求来源。
        return 枚举_任务推进状况::未定义;
    }
    if (私有_需求特征是外设内部材料字段_工作线程(派生需求特征)) {
        // 外设材料字段由外设方法内部闭合，不能反向变成普通需求树缺口。
        return 枚举_任务推进状况::未定义;
    }
    if (私有_语素入口同一_工作线程(
            派生需求特征,
            私有_方法状态特征类型_执行桥_最小_v0())) {
        return 枚举_任务推进状况::方法结果不稳定;
    }
    if (私有_语素入口同一_工作线程(
            派生需求特征,
            私有_执行输出特征_方法最近连续成功次数())) {
        return 枚举_任务推进状况::方法结果不稳定;
    }
    if (私有_语素入口同一_工作线程(
            派生需求特征,
            私有_方法运行账完整性特征类型_执行桥_最小_v0())) {
        return 枚举_任务推进状况::方法运行账不足;
    }
    if (私有_语素入口同一_工作线程(
            派生需求特征,
            私有_方法稳定状态特征类型_执行桥_最小_v0())) {
        return 枚举_任务推进状况::方法结果不稳定;
    }
    return 枚举_任务推进状况::未定义;
}

const 语素入口节点类* 私有_读取输出语素入口指针(
    const 基础信息节点类* 宿主,
    const 语素入口节点类* 特征类型) noexcept
{
    if (!宿主 || !特征类型) {
        return nullptr;
    }
    void* 指针 = nullptr;
    if (!世界树.读取特征_指针(宿主, 特征类型, 指针) || !指针) {
        return nullptr;
    }
    return reinterpret_cast<const 语素入口节点类*>(指针);
}

状态节点类* 私有_读取输出状态指针(
    const 基础信息节点类* 宿主,
    const 语素入口节点类* 特征类型) noexcept
{
    if (!宿主 || !特征类型) {
        return nullptr;
    }
    void* 指针 = nullptr;
    if (世界树.读取特征_指针(宿主, 特征类型, 指针) && 指针) {
        return reinterpret_cast<状态节点类*>(指针);
    }

    const auto* 场景主信息 = dynamic_cast<const 场景节点主信息类*>(宿主->主信息);
    if (!场景主信息) {
        return nullptr;
    }

    const auto* 场景 = reinterpret_cast<const 场景节点类*>(宿主);
    const auto 状态集 = 世界树.状态().获取场景状态(场景);
    for (auto it = 状态集.rbegin(); it != 状态集.rend(); ++it) {
        auto* 状态 = *it;
        const auto* 状态主信息 = 状态
            ? dynamic_cast<const 状态节点主信息类*>(状态->主信息)
            : nullptr;
        const auto* 状态特征主信息 = 状态主信息 && 状态主信息->状态特征.指针
            ? dynamic_cast<const 特征节点主信息类*>(状态主信息->状态特征.指针->主信息)
            : nullptr;
        const auto* 状态特征类型 = 状态特征主信息 ? 状态特征主信息->类型 : nullptr;
        if (!私有_语素入口同一_工作线程(状态特征类型, 特征类型)) {
            continue;
        }
        if (!世界树.状态().是否当前活动状态(场景, 状态)) {
            continue;
        }
        return 状态;
    }
    return nullptr;
}

状态节点类* 私有_读取输出场景内状态指针(
    const 基础信息节点类* 宿主,
    const 语素入口节点类* 特征类型) noexcept
{
    if (!宿主 || !特征类型) {
        return nullptr;
    }
    void* 场景指针 = nullptr;
    if (!世界树.读取特征_指针(宿主, 私有_特征_输出结果场景(), 场景指针) || !场景指针) {
        return nullptr;
    }
    return 私有_读取输出状态指针(
        reinterpret_cast<const 基础信息节点类*>(场景指针),
        特征类型);
}

const 语素入口节点类* 私有_读取执行输出语素入口指针(
    const 结构_执行任务结果& 执行结果,
    const 语素入口节点类* 特征类型,
    const bool 允许结果场景) noexcept
{
    if (!特征类型) {
        return nullptr;
    }
    if (const auto* 运行存在 = reinterpret_cast<const 基础信息节点类*>(
            执行结果.方法运行结果)) {
        if (const auto* 词 = 私有_读取输出语素入口指针(运行存在, 特征类型)) {
            return 词;
        }
    }
    if (允许结果场景) {
        if (const auto* 结果场景 = reinterpret_cast<const 基础信息节点类*>(
                执行结果.任务执行结果.结果场景)) {
            if (const auto* 词 = 私有_读取输出语素入口指针(结果场景, 特征类型)) {
                return 词;
            }
        }
    }
    return nullptr;
}

状态节点类* 私有_读取执行输出状态指针(
    const 结构_执行任务结果& 执行结果,
    const 语素入口节点类* 特征类型) noexcept
{
    if (!特征类型) {
        return nullptr;
    }
    if (const auto* 运行存在 = reinterpret_cast<const 基础信息节点类*>(
            执行结果.方法运行结果)) {
        if (auto* 状态 = 私有_读取输出状态指针(运行存在, 特征类型)) {
            return 状态;
        }
        // 本能方法的运行存在只承载回执；真实可比较结果常写在它引用的输出结果场景中。
        if (auto* 状态 = 私有_读取输出场景内状态指针(运行存在, 特征类型)) {
            return 状态;
        }
    }
    if (const auto* 结果场景 = reinterpret_cast<const 基础信息节点类*>(
            执行结果.任务执行结果.结果场景)) {
        if (auto* 状态 = 私有_读取输出状态指针(结果场景, 特征类型)) {
            return 状态;
        }
        if (auto* 状态 = 私有_读取输出场景内状态指针(结果场景, 特征类型)) {
            return 状态;
        }
    }
    return nullptr;
}

void 私有_记录执行目标状态读取(
    const 任务节点* 任务,
    const 需求节点* 需求,
    const 方法节点* 方法,
    const 结构_执行任务结果& 执行结果,
    const 语素入口节点类* 特征类型,
    const 状态节点类* 目标状态,
    const 状态节点类* 实际状态) noexcept
{
    std::ostringstream 输出;
    输出 << "任务管理工作线程/执行目标状态读取"
        << " | 任务=" << 私有_任务主键(任务)
        << " | 需求=" << 私有_需求主键(需求)
        << " | 方法=" << (方法 ? 方法->获取主键() : std::string{})
        << " | 目标特征=" << (特征类型 ? 特征类型->获取主键() : std::string{})
        << " | 目标状态=" << (目标状态 ? 目标状态->获取主键() : std::string{})
        << " | 实际状态=" << (实际状态 ? 实际状态->获取主键() : std::string{})
        << " | 方法运行存在=" << (执行结果.方法运行结果 ? 执行结果.方法运行结果->获取主键() : std::string{})
        << " | 结果场景=" << (执行结果.任务执行结果.结果场景 ? 执行结果.任务执行结果.结果场景->获取主键() : std::string{})
        << " | 当前方法运行存在=" << (执行结果.任务执行结果.方法运行结果 ? 执行结果.任务执行结果.方法运行结果->获取主键() : std::string{});
    项目运行日志(输出.str());
}

bool 私有_读取状态I64值_工作线程(
    const 状态节点类* 状态,
    I64& 输出值) noexcept
{
    const auto* 主信息 = 状态
        ? dynamic_cast<const 状态节点主信息类*>(状态->主信息)
        : nullptr;
    if (!主信息) {
        return false;
    }
    if (const auto* 值 = std::get_if<I64>(&主信息->状态值)) {
        输出值 = *值;
        return true;
    }
    return false;
}

void 私有_记录执行目标状态比较(
    const 任务节点* 任务,
    const 需求节点* 需求,
    const 方法节点* 方法,
    const 语素入口节点类* 特征类型,
    const 状态节点类* 目标状态,
    const 状态节点类* 实际状态,
    const 结构_特征状态比较结果& 比较,
    三向关系掩码 目标满足关系) noexcept
{
    I64 目标值 = 0;
    I64 实际值 = 0;
    const bool 目标值有效 = 私有_读取状态I64值_工作线程(目标状态, 目标值);
    const bool 实际值有效 = 私有_读取状态I64值_工作线程(实际状态, 实际值);

    // 该日志只记录比较输入和输出，用于定位目标状态、实际状态或满足关系的来源错误。
    std::ostringstream 输出;
    输出 << "任务管理工作线程/执行目标状态比较"
        << " | 任务=" << 私有_任务主键(任务)
        << " | 需求=" << 私有_需求主键(需求)
        << " | 方法=" << (方法 ? 方法->获取主键() : std::string{})
        << " | 目标特征=" << (特征类型 ? 特征类型->获取主键() : std::string{})
        << " | 目标状态=" << (目标状态 ? 目标状态->获取主键() : std::string{})
        << " | 目标值=" << (目标值有效 ? std::to_string(目标值) : std::string{"非I64"})
        << " | 实际状态=" << (实际状态 ? 实际状态->获取主键() : std::string{})
        << " | 实际值=" << (实际值有效 ? std::to_string(实际值) : std::string{"非I64"})
        << " | 可比较=" << (比较.可比较 ? 1 : 0)
        << " | 比较关系=" << static_cast<int>(比较.关系)
        << " | 满足关系=" << static_cast<int>(目标满足关系)
        << " | 差值=" << 比较.差值
        << " | 接受=" << (比较.可比较 && 三向关系被接受(比较.关系, 目标满足关系) ? 1 : 0)
        << " | 说明=" << 比较.说明;
    项目运行日志(输出.str());
}

const 语素入口节点类* 私有_执行输出派生需求词(
    const 结构_执行任务结果& 执行结果) noexcept
{
    if (!执行结果.任务执行结果.当前方法) {
        return nullptr;
    }
    // 显式派生目标特征可能由方法域输出场景携带，例如“目标方法.方法状态=可用”。
    // 它不是任务状态回执；因此允许从输出结果场景读取。派生需求提示仍走任务层回执。
    return 私有_读取执行输出语素入口指针(
        执行结果,
        私有_执行输出特征_派生需求(),
        true);
}

const 语素入口节点类* 私有_执行输出失败原因词(
    const 结构_执行任务结果& 执行结果) noexcept
{
    if (!执行结果.任务执行结果.当前方法) {
        return nullptr;
    }
    return 私有_读取执行输出语素入口指针(
        执行结果,
        私有_执行输出特征_失败原因(),
        false);
}

bool 私有_方法是学习承接本能(
    const 方法节点* 方法) noexcept;

bool 私有_执行输出需要派生原子需求(
    const 结构_执行任务结果& 执行结果) noexcept
{
    const auto* 派生需求词 = 私有_执行输出派生需求词(执行结果);
    const auto 运行视图 = 读取本能方法运行闭环视图(
        执行结果.方法运行结果,
        执行结果.任务执行结果.结果场景);
    const bool 动作成功 = 运行视图.方法执行成功 && !运行视图.有执行缺口();
    if (动作成功
        && (!派生需求词
            || !私有_方法是学习承接本能(执行结果.任务执行结果.当前方法))) {
        return false;
    }
    I64 缺失参数数量 = 0;
    const bool 读到缺失参数数量 =
        私有_读取执行输出缺失参数数量_工作线程(执行结果, 缺失参数数量);
    if (私有_需求特征是缺失参数数量_工作线程(派生需求词)) {
        私有_提示执行输出缺失参数数量_工作线程(
            "执行输出派生需求词",
            执行结果,
            读到缺失参数数量 ? 缺失参数数量 : -1,
            派生需求词 ? 派生需求词->获取主键() : std::string{});
        return false;
    }
    if (私有_需求特征是外设内部材料字段_工作线程(派生需求词)) {
        私有_提示外设内部材料字段需求化_工作线程(
            "执行输出派生需求词",
            执行结果,
            派生需求词 ? 派生需求词->获取主键() : std::string{});
        return false;
    }
    if (!派生需求词 && 读到缺失参数数量 && 缺失参数数量 > 0) {
        私有_提示执行输出缺失参数数量_工作线程(
            "执行输出缺失参数诊断",
            执行结果,
            缺失参数数量);
        return false;
    }
    const auto* 失败原因词 = 私有_执行输出失败原因词(执行结果);
    if (!派生需求词 && 失败原因词) {
        std::ostringstream 输出;
        输出 << "任务管理工作线程/执行失败原因仅作回执诊断"
            << " | 任务=" << 私有_任务主键(执行结果.任务执行结果.主任务)
            << " | 当前方法=" << (执行结果.任务执行结果.当前方法
                ? 执行结果.任务执行结果.当前方法->获取主键()
                : std::string{})
            << " | 失败原因词=" << 失败原因词->获取主键()
            << " | 处置=不构造派生需求";
        项目运行日志(输出.str());
    }
    return 派生需求词 != nullptr;
}

const 语素入口节点类* 私有_状态特征类型(const 状态节点类* 状态) noexcept
{
    const auto* 状态主信息 = 状态
        ? dynamic_cast<const 状态节点主信息类*>(状态->主信息)
        : nullptr;
    const auto* 特征主信息 = 状态主信息 && 状态主信息->状态特征.指针
        ? dynamic_cast<const 特征节点主信息类*>(状态主信息->状态特征.指针->主信息)
        : nullptr;
    return 特征主信息 ? 特征主信息->类型 : nullptr;
}

基础信息节点类* 私有_状态主体节点(const 状态节点类* 状态) noexcept
{
    const auto* 状态主信息 = 状态
        ? dynamic_cast<const 状态节点主信息类*>(状态->主信息)
        : nullptr;
    return 状态主信息 ? 状态主信息->状态主体.指针 : nullptr;
}

const 语素入口节点类* 私有_任务目标特征类型(
    const 任务节点* 任务,
    const 需求节点* 需求) noexcept
{
    if (需求 && 需求->主信息.目标特征类型缓存) {
        return 需求->主信息.目标特征类型缓存;
    }
    if (任务 && 任务->主信息.目标状态.指针) {
        return 私有_状态特征类型(任务->主信息.目标状态.指针);
    }
    if (auto* 兼容结果状态 = 任务类::解析任务结果状态摘要_兼容(任务)) {
        return 私有_状态特征类型(兼容结果状态);
    }
    return nullptr;
}

状态节点类* 私有_任务目标状态(
    const 任务节点* 任务,
    const 需求节点* 需求) noexcept
{
    if (需求 && 需求->主信息.需求状态.指针) {
        return 需求->主信息.需求状态.指针;
    }
    return 任务 ? 任务->主信息.目标状态.指针 : nullptr;
}

状态节点类* 私有_任务之前结果状态(
    const 任务节点* 任务,
    const 需求节点* 需求) noexcept
{
    if (auto* 兼容结果状态 = 任务类::解析任务结果状态摘要_兼容(任务)) {
        return 兼容结果状态;
    }
    return 需求 ? 需求->主信息.被需求当前状态.指针 : nullptr;
}

bool 私有_状态主体同一_工作线程(
    const 状态节点类* 左,
    const 状态节点类* 右) noexcept
{
    auto* 左主体 = 私有_状态主体节点(左);
    auto* 右主体 = 私有_状态主体节点(右);
    if (!左主体 || !右主体) {
        return false;
    }
    if (左主体 == 右主体) {
        return true;
    }
    const auto 左键 = 左主体->获取主键();
    const auto 右键 = 右主体->获取主键();
    return !左键.empty() && 左键 == 右键;
}

bool 私有_状态目标同一_工作线程(
    const 状态节点类* 左,
    const 状态节点类* 右) noexcept
{
    if (!左 || !右) {
        return false;
    }
    if (!私有_状态主体同一_工作线程(左, 右)) {
        return false;
    }
    if (!私有_语素入口同一_工作线程(
            私有_状态特征类型(左),
            私有_状态特征类型(右))) {
        return false;
    }
    const auto 比较 = 世界树.特征().比较状态(
        const_cast<状态节点类*>(左),
        const_cast<状态节点类*>(右));
    if (比较.可比较) {
        return 比较.关系 == 枚举_三向关系::等于;
    }
    I64 左值 = 0;
    I64 右值 = 0;
    if (私有_读取状态I64值_工作线程(左, 左值)
        && 私有_读取状态I64值_工作线程(右, 右值)) {
        return 左值 == 右值;
    }
    return 左 == 右 || 左->获取主键() == 右->获取主键();
}

bool 私有_执行输出派生目标等于来源需求目标(
    const 任务节点* 任务,
    const 需求节点* 需求,
    const 结构_执行任务结果& 执行结果) noexcept
{
    auto* 派生目标状态 = 私有_读取执行输出状态指针(
        执行结果,
        私有_执行输出特征_派生需求目标状态());
    auto* 来源目标状态 = 私有_任务目标状态(任务, 需求);
    return 私有_状态目标同一_工作线程(派生目标状态, 来源目标状态);
}

bool 私有_目标特征是学习承接缺口(
    const 语素入口节点类* 特征类型) noexcept
{
    return 私有_语素入口同一_工作线程(
            特征类型,
            私有_方法状态特征类型_执行桥_最小_v0())
        || 私有_语素入口同一_工作线程(
            特征类型,
            私有_方法稳定状态特征类型_执行桥_最小_v0())
        || 私有_语素入口同一_工作线程(
            特征类型,
            私有_方法运行账完整性特征类型_执行桥_最小_v0())
        || 私有_语素入口同一_工作线程(
            特征类型,
            私有_方法动作状态特征类型_执行桥_最小_v0())
        || 私有_语素入口同一_工作线程(
            特征类型,
            私有_方法动作数量特征类型_执行桥_最小_v0())
        || 私有_语素入口同一_工作线程(
            特征类型,
            私有_方法可执行入口数量特征类型_执行桥_最小_v0())
        || 私有_语素入口同一_工作线程(
            特征类型,
            私有_方法条件节点数量特征类型_执行桥_最小_v0())
        || 私有_语素入口同一_工作线程(
            特征类型,
            私有_方法结果节点数量特征类型_执行桥_最小_v0())
        || 私有_语素入口同一_工作线程(
            特征类型,
            私有_方法条件结果配对状态特征类型_执行桥_最小_v0())
        || 私有_语素入口同一_工作线程(
            特征类型,
            私有_方法条件结果对数量特征类型_执行桥_最小_v0())
        || 私有_语素入口同一_工作线程(
            特征类型,
            私有_参数配对状态特征类型_执行桥_最小_v0())
        || 私有_语素入口同一_工作线程(
            特征类型,
            私有_执行输出特征_缺失参数数量())
        || 私有_语素入口同一_工作线程(
            特征类型,
            私有_执行输出特征_方法最近连续成功次数());
}

bool 私有_方法是学习承接本能(
    const 方法节点* 方法) noexcept
{
    if (!方法
        || 方法->主信息.首节点信息().动作句柄.类型 != 枚举_动作句柄类型::本能函数ID) {
        return false;
    }
    switch (static_cast<枚举_本能方法ID>(
        方法->主信息.首节点信息().动作句柄.本能ID)) {
    case 枚举_本能方法ID::自我_尝试学习:
    case 枚举_本能方法ID::自我_定向学习:
    case 枚举_本能方法ID::自我_练习:
        return true;
    default:
        return false;
    }
}

bool 私有_任务推进状况是学习承接缺口(
    const 任务模块::筹办::枚举_任务推进状况 状况) noexcept
{
    using 任务模块::筹办::枚举_任务推进状况;
    switch (状况) {
    case 枚举_任务推进状况::缺方法动作:
    case 枚举_任务推进状况::方法缺可执行入口:
    case 枚举_任务推进状况::方法缺条件节点:
    case 枚举_任务推进状况::方法缺结果节点:
    case 枚举_任务推进状况::方法缺条件结果对:
    case 枚举_任务推进状况::参数不可配:
    case 枚举_任务推进状况::方法结果不稳定:
    case 枚举_任务推进状况::方法运行账不足:
        return true;
    default:
        return false;
    }
}

void 私有_记录动作成功无可比较目标结果(
    const 任务节点* 任务,
    const 需求节点* 需求,
    const 方法节点* 方法,
    const 语素入口节点类* 特征类型,
    const 状态节点类* 目标状态,
    const char* 原因) noexcept
{
    std::ostringstream 输出;
    输出 << "任务管理工作线程/动作成功无可比较目标结果"
        << " | 原因=" << (原因 ? 原因 : "")
        << " | 任务=" << 私有_任务主键(任务)
        << " | 需求=" << (需求 ? 需求->获取主键() : std::string{})
        << " | 方法=" << (方法 ? 方法->获取主键() : std::string{})
        << " | 目标特征=" << (特征类型 ? 特征类型->获取主键() : std::string{})
        << " | 目标状态=" << (目标状态 ? 目标状态->获取主键() : std::string{})
        << " | 说明=动作成功后缺少可比较实际结果，已记录诊断；该路径不应长期重复重排。";
    项目运行警告日志(输出.str());
}

I64 私有_计算任务完成度百万分比_工作线程(
    状态节点类* 实际状态,
    状态节点类* 目标状态,
    状态节点类* 之前状态,
    三向关系掩码 满足关系,
    bool 目标已达成) noexcept
{
    constexpr I64 满额 = 1'000'000;
    if (目标已达成) {
        return 满额;
    }

    I64 实际值 = 0;
    I64 目标值 = 0;
    I64 之前值 = 0;
    if (!私有_读取状态I64值_工作线程(实际状态, 实际值)
        || !私有_读取状态I64值_工作线程(目标状态, 目标值)
        || !私有_读取状态I64值_工作线程(之前状态, 之前值)) {
        return 0;
    }

    const bool 只接受小于 =
        (满足关系 & 关系_小于) != 0
        && (满足关系 & 关系_大于) == 0;
    const bool 只接受大于 =
        (满足关系 & 关系_大于) != 0
        && (满足关系 & 关系_小于) == 0;
    const auto 绝对差 = [](I64 左, I64 右) noexcept -> long double {
        const long double 差值 = static_cast<long double>(左) - static_cast<long double>(右);
        return 差值 < 0 ? -差值 : 差值;
    };
    auto 夹紧比例 = [=](long double 比例) noexcept -> I64 {
        if (比例 <= 0.0L) {
            return 0;
        }
        if (比例 >= 1.0L) {
            return 满额;
        }
        return static_cast<I64>(比例 * static_cast<long double>(满额) + 0.5L);
    };

    long double 总量 = 0.0L;
    long double 已完成 = 0.0L;
    if (只接受小于) {
        总量 = static_cast<long double>(之前值) - static_cast<long double>(目标值);
        已完成 = static_cast<long double>(之前值) - static_cast<long double>(实际值);
    } else if (只接受大于) {
        总量 = static_cast<long double>(目标值) - static_cast<long double>(之前值);
        已完成 = static_cast<long double>(实际值) - static_cast<long double>(之前值);
    } else {
        总量 = 绝对差(目标值, 之前值);
        已完成 = 总量 - 绝对差(目标值, 实际值);
    }

    if (总量 <= 0.0L) {
        return 0;
    }
    return 夹紧比例(已完成 / 总量);
}

任务模块::筹办::结构_任务推进回执 私有_构造执行推进回执(
    const 任务节点* 任务,
    const 需求节点* 需求,
    const 结构_执行任务结果& 执行结果) noexcept
{
    // 执行结果验证属于任务管理普通回执处理；这里不作为方法动作来源，也不直接改写需求满足或价值账。
    任务模块::筹办::结构_任务推进回执 回执{};
    回执.阶段 = 任务模块::筹办::枚举_任务推进阶段::执行;
    私有_写入任务节点引用(回执.当前任务, const_cast<任务节点*>(任务));
    私有_写入需求节点引用(回执.对应需求, const_cast<需求节点*>(需求));
    auto* 回执方法 = 执行结果.任务执行结果.当前方法
        ? reinterpret_cast<方法类::节点类*>(执行结果.任务执行结果.当前方法)
        : (任务
            ? reinterpret_cast<方法类::节点类*>(任务类::读取任务执行方法(const_cast<任务节点*>(任务)))
            : nullptr);
    私有_写入方法节点引用(回执.当前方法, 回执方法);
    回执.目标特征类型 = 私有_任务目标特征类型(任务, 需求);
    回执.目标满足关系 = 需求 && 需求->主信息.满足关系 != 0
        ? 需求->主信息.满足关系
        : 关系_等于;
    回执.治理结果可接受 = true;

    const auto 运行视图 = 读取本能方法运行闭环视图(
        执行结果.方法运行结果,
        执行结果.任务执行结果.结果场景);
    const bool 动作成功 = 运行视图.方法执行成功 && !运行视图.有执行缺口();
    if (!动作成功) {
        const auto* 派生需求特征 = 私有_执行输出派生需求词(执行结果);
        const auto 派生状况 = 私有_从派生需求特征推导推进状况(派生需求特征);
        if (派生状况 != 任务模块::筹办::枚举_任务推进状况::未定义) {
            回执.状况 = 派生状况;
            回执.缺口特征类型 = 派生需求特征;
            回执.需要自我线程 = true;
            回执.需要创建或复用子需求 = true;
            回执.父任务需要重筹办 = false;
            回执.摘要 = std::string("执行阶段发现缺口：") + 私有_任务推进状况文本(派生状况);
            {
                std::ostringstream 输出;
                输出 << "任务管理工作线程/执行失败回执尾部证据"
                    << " | 任务=" << 私有_任务主键(任务)
                    << " | 需求=" << 私有_需求主键(需求)
                    << " | 方法=" << (回执方法 ? 回执方法->获取主键() : std::string{})
                    << " | 动作成功=0"
                    << " | 派生需求特征=" << (派生需求特征
                        ? 派生需求特征->获取主键()
                        : std::string{})
                    << " | 派生状况=" << 私有_任务推进状况文本(派生状况)
                    << " | 需要自我线程=" << (回执.需要自我线程 ? 1 : 0)
                    << " | 需要子需求=" << (回执.需要创建或复用子需求 ? 1 : 0)
                    << " | 父任务需重筹办=" << (回执.父任务需要重筹办 ? 1 : 0)
                    << " | 摘要=" << 回执.摘要;
                项目运行日志(输出.str());
            }
            return 回执;
        }

        const auto* 执行缺口类型 = 运行视图.执行缺口类型
            ? 运行视图.执行缺口类型
            : 私有_执行输出失败原因词(执行结果);
        if (执行缺口类型
            && !私有_执行缺口表示动作失败(执行缺口类型)) {
            const bool 已有等待承接证据 = 私有_任务已有等待承接证据(任务);
            回执.状况 = 任务模块::筹办::枚举_任务推进状况::方法前置条件未满足;
            回执.缺口特征类型 = 执行缺口类型;
            回执.需要自我线程 = false;
            回执.需要创建或复用子需求 = false;
            回执.父任务需要重筹办 = !已有等待承接证据;
            回执.建议任务状态 = 已有等待承接证据
                ? 枚举_任务状态::等待中
                : 枚举_任务状态::待重筹办;
            回执.摘要 = 已有等待承接证据
                ? "执行缺口等待既有承接证据"
                : "执行缺口等待重筹办承接";
            {
                std::ostringstream 输出;
                输出 << "任务管理工作线程/执行缺口通用回执"
                    << " | 任务=" << 私有_任务主键(任务)
                    << " | 需求=" << 私有_需求主键(需求)
                    << " | 方法=" << (回执方法 ? 回执方法->获取主键() : std::string{})
                    << " | 执行缺口类型=" << 执行缺口类型->获取主键()
                    << " | 等待承接证据=" << (已有等待承接证据 ? 1 : 0)
                    << " | 建议任务状态=" << static_cast<I64>(回执.建议任务状态)
                    << " | 需要自我线程=0"
                    << " | 需要子需求=0"
                    << " | 父任务需重筹办=" << (回执.父任务需要重筹办 ? 1 : 0);
                项目运行日志(输出.str());
            }
            return 回执;
        }

        回执.状况 = 任务模块::筹办::枚举_任务推进状况::动作执行失败;
        回执.缺口特征类型 = 执行缺口类型
            ? 执行缺口类型
            : 私有_值_执行缺口_方法运行回执未闭环();
        回执.需要自我线程 = 私有_执行输出需要派生原子需求(执行结果);
        回执.需要创建或复用子需求 = 回执.需要自我线程;
        回执.父任务需要重筹办 = false;
        回执.摘要 = 执行缺口类型
            ? "动作执行失败"
            : "方法运行回执未闭环";
        {
            const auto* 失败原因词 = 私有_执行输出失败原因词(执行结果);
            std::ostringstream 输出;
            输出 << "任务管理工作线程/执行失败回执尾部证据"
                << " | 任务=" << 私有_任务主键(任务)
                << " | 需求=" << 私有_需求主键(需求)
                << " | 方法=" << (回执方法 ? 回执方法->获取主键() : std::string{})
                << " | 动作成功=0"
                << " | 派生需求特征="
                << " | 失败原因词=" << (失败原因词 ? 失败原因词->获取主键() : std::string{})
                << " | 派生状况=" << 私有_任务推进状况文本(回执.状况)
                << " | 需要自我线程=" << (回执.需要自我线程 ? 1 : 0)
                << " | 需要子需求=" << (回执.需要创建或复用子需求 ? 1 : 0)
                << " | 父任务需重筹办=" << (回执.父任务需要重筹办 ? 1 : 0)
                << " | 摘要=" << 回执.摘要;
            项目运行日志(输出.str());
        }
        return 回执;
    }

    const auto* 成功派生需求特征 = 私有_执行输出派生需求词(执行结果);
    const auto 成功派生状况 = 私有_从派生需求特征推导推进状况(成功派生需求特征);
    if (私有_方法是学习承接本能(回执方法)
        && 成功派生状况 != 任务模块::筹办::枚举_任务推进状况::未定义) {
        回执.状况 = 成功派生状况;
        回执.缺口特征类型 = 成功派生需求特征;
        回执.需要自我线程 = true;
        回执.需要创建或复用子需求 = true;
        回执.父任务需要重筹办 = false;
        回执.摘要 = std::string("执行阶段发现缺口：") + 私有_任务推进状况文本(成功派生状况);
        {
            std::ostringstream 输出;
            输出 << "任务管理工作线程/执行成功回执派生缺口"
                << " | 任务=" << 私有_任务主键(任务)
                << " | 需求=" << 私有_需求主键(需求)
                << " | 方法=" << (回执方法 ? 回执方法->获取主键() : std::string{})
                << " | 动作成功=1"
                << " | 派生需求特征=" << (成功派生需求特征
                    ? 成功派生需求特征->获取主键()
                    : std::string{})
                << " | 派生状况=" << 私有_任务推进状况文本(成功派生状况)
                << " | 需要自我线程=" << (回执.需要自我线程 ? 1 : 0)
                << " | 需要子需求=" << (回执.需要创建或复用子需求 ? 1 : 0)
                << " | 父任务需重筹办=" << (回执.父任务需要重筹办 ? 1 : 0)
                << " | 摘要=" << 回执.摘要;
            项目运行日志(输出.str());
        }
        return 回执;
    }

    auto* 目标状态 = 私有_任务目标状态(任务, 需求);
    auto* 实际状态 = 回执.目标特征类型
        ? 私有_读取执行输出状态指针(执行结果, 回执.目标特征类型)
        : nullptr;
    私有_记录执行目标状态读取(
        任务,
        需求,
        回执方法,
        执行结果,
        回执.目标特征类型,
        目标状态,
        实际状态);
    if (实际状态) {
        可解析引用<状态节点类> 实际引用{};
        私有_写入状态节点引用(实际引用, 实际状态);
        回执.实际结果状态集.push_back(实际引用);
    }

    if (!实际状态
        && 目标状态
        && 回执.目标特征类型
        && 私有_方法是学习承接本能(回执方法)
        && 私有_目标特征是学习承接缺口(回执.目标特征类型)) {
        // 学习承接动作成功只说明本能方法产生了运行事实。
        // 目标是否达成必须由显式实际结果状态或需求满足证据支撑，不能用动作成功直接替代。
        回执.状况 = 任务模块::筹办::枚举_任务推进状况::动作执行成功无可比较结果;
        回执.父任务需要重筹办 = true;
        回执.摘要 = "学习承接动作成功但缺少显式目标结果";
        私有_记录动作成功无可比较目标结果(
            任务,
            需求,
            回执方法,
            回执.目标特征类型,
            目标状态,
            "学习承接未产出显式实际结果状态");
        return 回执;
    }

    if (!实际状态 || !目标状态) {
        回执.状况 = 任务模块::筹办::枚举_任务推进状况::动作执行成功无可比较结果;
        回执.父任务需要重筹办 = true;
        回执.摘要 = "动作执行成功但无可比较目标结果";
        私有_记录动作成功无可比较目标结果(
            任务,
            需求,
            回执方法,
            回执.目标特征类型,
            目标状态,
            !实际状态 ? "缺少实际结果状态" : "缺少目标状态");
        return 回执;
    }

    const auto 比较 = 世界树.特征().比较状态(实际状态, 目标状态);
    auto* 之前结果状态 = 私有_任务之前结果状态(任务, 需求);
    const auto 之前比较 = 之前结果状态
        ? 世界树.特征().比较状态(实际状态, 之前结果状态)
        : 结构_特征状态比较结果{};
    私有_记录执行目标状态比较(
        任务,
        需求,
        回执方法,
        回执.目标特征类型,
        目标状态,
        实际状态,
        比较,
        回执.目标满足关系);
    if (!比较.可比较) {
        回执.状况 = 任务模块::筹办::枚举_任务推进状况::动作执行成功无可比较结果;
        回执.父任务需要重筹办 = true;
        回执.摘要 = "动作执行成功但目标结果不可比较";
        私有_记录动作成功无可比较目标结果(
            任务,
            需求,
            回执方法,
            回执.目标特征类型,
            目标状态,
            "状态比较器返回不可比较");
        return 回执;
    }

    回执.任务结果可比较 = true;

    I64 实际值 = 0;
    I64 目标值 = 0;
    I64 之前值 = 0;
    const bool 实际值有效 = 私有_读取状态I64值_工作线程(实际状态, 实际值);
    const bool 目标值有效 = 私有_读取状态I64值_工作线程(目标状态, 目标值);
    const bool 之前值有效 = 私有_读取状态I64值_工作线程(之前结果状态, 之前值);
    if (实际值有效 && 目标值有效) {
        const I64 目标差值 = 目标值 - 实际值;
        回执.剩余差距 = 目标差值 > 0 ? 目标差值 : 0;
    }
    if (实际值有效 && 之前值有效) {
        回执.本轮推进量 = 实际值 - 之前值;
        回执.本轮是否有推进 = 回执.本轮推进量 > 0;
    } else if (之前比较.可比较) {
        回执.本轮是否有推进 = 之前比较.关系 == 枚举_三向关系::大于;
        回执.本轮推进量 = 回执.本轮是否有推进 ? 1 : 0;
    }

    const bool 结果达到任务目标 = 三向关系被接受(比较.关系, 回执.目标满足关系);
    回执.完成度百万分比 = 私有_计算任务完成度百万分比_工作线程(
        实际状态,
        目标状态,
        之前结果状态,
        回执.目标满足关系,
        结果达到任务目标);
    if (结果达到任务目标) {
        回执.状况 = 任务模块::筹办::枚举_任务推进状况::目标结果符合;
        回执.当前任务目标达成 = true;
        回执.需要自我线程 = true;
        回执.执行结果类型 = 任务模块::筹办::枚举_任务执行结果类型::目标已达成;
        回执.摘要 = "目标结果符合";
    } else {
        回执.状况 = 任务模块::筹办::枚举_任务推进状况::目标结果不符合;
        回执.父任务需要重筹办 = true;
        回执.需要自我线程 = true;
        if (回执.本轮是否有推进) {
            回执.执行结果类型 = 任务模块::筹办::枚举_任务执行结果类型::有推进未达成;
            回执.摘要 = "目标结果不符合但本轮有推进";
        } else if (之前比较.可比较 && 之前比较.关系 == 枚举_三向关系::小于) {
            回执.执行结果类型 = 任务模块::筹办::枚举_任务执行结果类型::退步;
            回执.摘要 = "目标结果不符合且本轮退步";
        } else {
            回执.执行结果类型 = 任务模块::筹办::枚举_任务执行结果类型::无推进未达成;
            回执.摘要 = "目标结果不符合且无推进";
        }
    }
    {
        std::ostringstream 输出;
        输出 << "任务管理工作线程/执行结果任务特征评价"
            << " | 任务=" << 私有_任务主键(任务)
            << " | 需求=" << 私有_需求主键(需求)
            << " | 目标状态=" << (目标状态 ? 目标状态->获取主键() : std::string{})
            << " | 实际状态=" << (实际状态 ? 实际状态->获取主键() : std::string{})
            << " | 之前状态=" << (之前结果状态 ? 之前结果状态->获取主键() : std::string{})
            << " | 目标达成=" << (回执.当前任务目标达成 ? 1 : 0)
            << " | 有推进=" << (回执.本轮是否有推进 ? 1 : 0)
            << " | 推进量=" << 回执.本轮推进量
            << " | 剩余差距=" << 回执.剩余差距
            << " | 完成度百万分比=" << 回执.完成度百万分比
            << " | 执行结果类型=" << static_cast<int>(回执.执行结果类型);
        项目运行日志(输出.str());
    }
    return 回执;
}

void 私有_补充执行输出派生需求字段(
    结构_任务管理派生需求消息& 消息,
    const 结构_执行任务结果& 执行结果) noexcept
{
    const auto* 派生需求词 = 私有_执行输出派生需求词(执行结果);
    const auto* 失败原因词 = 私有_执行输出失败原因词(执行结果);
    const auto* 需求词 = 派生需求词 ? 派生需求词 : 失败原因词;
    if (!需求词) {
        return;
    }

    消息.需求特征类型指针 = reinterpret_cast<std::uintptr_t>(需求词);
    消息.需求特征类型主键 = 需求词->获取主键();

    if (auto* 当前状态 = 私有_读取执行输出状态指针(
            执行结果,
            私有_执行输出特征_派生需求当前状态())) {
        消息.需求当前状态指针 = reinterpret_cast<std::uintptr_t>(当前状态);
        消息.需求当前状态主键 = 当前状态->获取主键();
    }
    if (auto* 目标状态 = 私有_读取执行输出状态指针(
            执行结果,
            私有_执行输出特征_派生需求目标状态())) {
        消息.需求目标状态指针 = reinterpret_cast<std::uintptr_t>(目标状态);
        消息.需求目标状态主键 = 目标状态->获取主键();
    }

    (void)失败原因词;
}

方法节点* 私有_派生需求来源方法头(
    const 任务节点* 任务,
    const 结构_执行任务结果& 执行结果) noexcept
{
    if (执行结果.任务执行结果.当前方法) {
        return 执行结果.任务执行结果.当前方法;
    }
    if (!任务) {
        return nullptr;
    }
    if (auto* 方法 = 任务类::读取任务执行方法(const_cast<任务节点*>(任务))) {
        return reinterpret_cast<方法节点*>(方法);
    }
    return nullptr;
}

void 私有_提示执行桥派生需求逻辑错误(const std::string& 文本) noexcept
{
    项目运行错误日志(文本);
    项目弹窗错误提示("鱼巢 - 执行桥逻辑错误", 文本);
}

bool 私有_派生需求执行输出完整(
    const 结构_任务管理派生需求消息& 消息) noexcept
{
    return (消息.需求特征类型指针 != 0 || !消息.需求特征类型主键.empty())
        && (消息.需求当前状态指针 != 0 || !消息.需求当前状态主键.empty())
        && (消息.需求目标状态指针 != 0 || !消息.需求目标状态主键.empty());
}

结构_任务管理上行消息 私有_构造执行缺失原子需求消息(
    const 任务节点* 任务,
    const 结构_执行任务结果& 执行结果,
    const 任务模块::筹办::结构_任务推进回执* 回执,
    const 时间戳 now) noexcept
{
    if (回执
        && (回执->状况 == 任务模块::筹办::枚举_任务推进状况::存在活动子需求
            || 回执->状况 == 任务模块::筹办::枚举_任务推进状况::逻辑组织待聚合
            || 回执->状况 == 任务模块::筹办::枚举_任务推进状况::父需求已满足)) {
        // “存在活动子需求”应等待/复用原子子需求；
        // “逻辑组织待聚合”应等待需求树展开或专用提交链；
        // “父需求已满足”只表示筹办退出，不代表本任务完成，
        // 不能再把未执行运行结果中的失败原因升级成新的派生需求。
        项目运行日志(
            "任务管理工作线程/派生需求构造跳过"
            " | 原因=回执不需要新增子需求"
            " | 任务=" + 私有_任务主键(任务)
            + " | 推进状况=" + 私有_任务推进状况文本(回执->状况));
        return {};
    }
    结构_任务管理派生需求消息 消息{};
    const auto 任务主键 = 私有_任务主键(任务);
    const auto 步骤主键 = 私有_任务主键(执行结果.任务执行结果.当前步骤节点);
    消息.消息头.发出者主键 = "任务管理工作线程";
    消息.消息头.任务主键 = 任务主键;
    消息.消息头.步骤主键 = 步骤主键.empty() ? 任务主键 : 步骤主键;
    消息.消息头.产生时间 = now;
    消息.消息头.执行尝试主键 = 任务主键 + "|执行缺失";
    auto* 来源方法 = 私有_派生需求来源方法头(任务, 执行结果);
    消息.当前方法主键 = 来源方法 ? 来源方法->获取主键() : std::string{};
    消息.派生需求类型 = 枚举_任务管理派生需求类型::执行缺失;
    消息.阻塞级别 = 枚举_任务管理阻塞级别::严重;
    消息.是否阻塞当前步骤 = true;
    消息.是否影响父任务推进 = true;
    消息.是否建议线程重判 = true;
    私有_填充派生需求父需求字段(消息, 任务);
    const auto* 来源方法首节点信息 = 来源方法 ? 来源方法->主信息.取首节点信息() : nullptr;
    if (auto* 方法虚拟存在 = 来源方法首节点信息 ? 来源方法首节点信息->方法虚拟存在.指针 : nullptr) {
        消息.方法虚拟存在指针 = reinterpret_cast<std::uintptr_t>(方法虚拟存在);
        消息.方法虚拟存在主键 = 方法虚拟存在->获取主键();
    }
    if (回执
        && (回执->缺口目标主体.指针 || !回执->缺口目标主体.主键.empty())) {
        消息.需求目标主体指针 =
            reinterpret_cast<std::uintptr_t>(回执->缺口目标主体.指针);
        消息.需求目标主体主键 = 回执->缺口目标主体.主键;
    }
    私有_补充执行输出派生需求字段(消息, 执行结果);
    if (回执
        && 消息.需求特征类型指针 == 0
        && 消息.需求特征类型主键.empty()
        && 回执->缺口特征类型) {
        // 筹办阶段发现的方法缺口可能只存在于任务推进回执中。
        // 此处只补“需求目标特征类型”，当前/目标状态仍必须来自方法输出结果场景。
        消息.需求特征类型指针 =
            reinterpret_cast<std::uintptr_t>(回执->缺口特征类型);
        消息.需求特征类型主键 = 回执->缺口特征类型->获取主键();
    }
    if (消息.需求当前状态指针 == 0 && 消息.需求当前状态主键.empty()) {
        if (auto* 当前状态 = 私有_读取执行输出状态指针(
                执行结果,
                私有_执行输出特征_派生需求当前状态())) {
            消息.需求当前状态指针 = reinterpret_cast<std::uintptr_t>(当前状态);
            消息.需求当前状态主键 = 当前状态->获取主键();
        }
    }
    if (消息.需求目标状态指针 == 0 && 消息.需求目标状态主键.empty()) {
        if (auto* 目标状态 = 私有_读取执行输出状态指针(
                执行结果,
                私有_执行输出特征_派生需求目标状态())) {
            消息.需求目标状态指针 = reinterpret_cast<std::uintptr_t>(目标状态);
            消息.需求目标状态主键 = 目标状态->获取主键();
        }
    }
    if (消息.需求目标主体指针 == 0 && 消息.需求目标主体主键.empty()) {
        auto* 目标状态 = reinterpret_cast<状态节点类*>(消息.需求目标状态指针);
        auto* 当前状态 = reinterpret_cast<状态节点类*>(消息.需求当前状态指针);
        auto* 状态主体 = 私有_状态主体节点(目标状态);
        if (!状态主体) {
            状态主体 = 私有_状态主体节点(当前状态);
        }
        if (状态主体) {
            消息.需求目标主体指针 = reinterpret_cast<std::uintptr_t>(状态主体);
            消息.需求目标主体主键 = 状态主体->获取主键();
        } else if (auto* 方法虚拟存在 = 来源方法首节点信息 ? 来源方法首节点信息->方法虚拟存在.指针 : nullptr) {
            消息.需求目标主体指针 = reinterpret_cast<std::uintptr_t>(方法虚拟存在);
            消息.需求目标主体主键 = 方法虚拟存在->获取主键();
        }
    }
    if (私有_需求特征是缺失参数数量_工作线程(
            reinterpret_cast<const 语素入口节点类*>(消息.需求特征类型指针),
            消息.需求特征类型主键)) {
        I64 缺失参数数量 = 0;
        const bool 读到缺失参数数量 =
            私有_读取执行输出缺失参数数量_工作线程(执行结果, 缺失参数数量);
        私有_提示执行输出缺失参数数量_工作线程(
            "派生需求构造",
            执行结果,
            读到缺失参数数量 ? 缺失参数数量 : -1,
            消息.需求特征类型主键);
        项目运行日志(
            "任务管理工作线程/派生需求构造跳过"
            " | 原因=缺失参数数量仅作为参数诊断"
            " | 任务=" + 任务主键
            + " | 来源方法=" + 消息.当前方法主键
            + " | 需求特征=" + 消息.需求特征类型主键);
        return {};
    }
    if (私有_需求特征是外设内部材料字段_工作线程(
            reinterpret_cast<const 语素入口节点类*>(消息.需求特征类型指针),
            消息.需求特征类型主键)) {
        私有_提示外设内部材料字段需求化_工作线程(
            "派生需求构造",
            执行结果,
            消息.需求特征类型主键);
        项目运行日志(
            "任务管理工作线程/派生需求构造跳过"
            " | 原因=外设内部材料字段仅作方法内部数据"
            " | 任务=" + 任务主键
            + " | 来源方法=" + 消息.当前方法主键
            + " | 需求特征=" + 消息.需求特征类型主键);
        return {};
    }
    {
        const bool 特征完整 = 消息.需求特征类型指针 != 0 || !消息.需求特征类型主键.empty();
        const bool 当前状态完整 = 消息.需求当前状态指针 != 0 || !消息.需求当前状态主键.empty();
        const bool 目标状态完整 = 消息.需求目标状态指针 != 0 || !消息.需求目标状态主键.empty();
        std::ostringstream 输出;
        输出 << "任务管理工作线程/派生需求构造"
            << " | 任务=" << 任务主键
            << " | 来源方法=" << 消息.当前方法主键
            << " | 方法虚拟存在=" << 消息.方法虚拟存在主键
            << " | 需求特征=" << 消息.需求特征类型主键
            << " | 目标主体=" << 消息.需求目标主体主键
            << " | 当前状态=" << 消息.需求当前状态主键
            << " | 目标状态=" << 消息.需求目标状态主键
            << " | 回执缺口特征=" << (回执 && 回执->缺口特征类型
                ? 回执->缺口特征类型->获取主键()
                : std::string{})
            << " | 特征完整=" << (特征完整 ? 1 : 0)
            << " | 当前状态完整=" << (当前状态完整 ? 1 : 0)
            << " | 目标状态完整=" << (目标状态完整 ? 1 : 0)
            << " | 完整=" << (私有_派生需求执行输出完整(消息) ? 1 : 0);
        项目运行日志(输出.str());
    }
    if (!私有_派生需求执行输出完整(消息)) {
        std::ostringstream 输出;
        输出 << "执行桥逻辑错误：执行缺失派生需求缺少执行桥输出的目标状态。"
            << " | 任务=" << 任务主键
            << " | 方法=" << 消息.当前方法主键
            << " | 需求特征=" << 消息.需求特征类型主键
            << " | 当前状态=" << 消息.需求当前状态主键
            << " | 目标状态=" << 消息.需求目标状态主键
            << " | 已拒绝发送派生需求。";
        私有_提示执行桥派生需求逻辑错误(输出.str());
        return {};
    }
    结构_任务管理上行消息 上行{};
    上行.类型 = 枚举_任务管理上行消息类型::派生需求消息;
    上行.载荷 = 消息;
    同步任务管理上行消息语义槽(上行);
    return 上行;
}

结构_任务管理上行消息 私有_构造结果状态上行消息(
    const 任务节点* 任务,
    const 结构_执行任务结果& 执行结果,
    const 任务模块::筹办::结构_任务推进回执& 回执,
    const 时间戳 now) noexcept
{
    结构_任务管理结果状态消息 消息{};
    const auto 任务主键 = 私有_任务主键(任务);
    const auto 步骤主键 = 私有_任务主键(执行结果.任务执行结果.当前步骤节点);
    消息.消息头.发出者主键 = "任务管理工作线程";
    消息.消息头.任务主键 = 任务主键;
    消息.消息头.步骤主键 = 步骤主键.empty() ? 任务主键 : 步骤主键;
    消息.消息头.产生时间 = now;
    消息.消息头.执行尝试主键 = 任务主键 + "|执行任务";
    消息.执行结束时间 = now;
    auto* 当前方法 = 执行结果.任务执行结果.当前方法;
    const auto* 当前方法首节点信息 = 当前方法 ? 当前方法->主信息.取首节点信息() : nullptr;
    if (auto* 方法虚拟存在 = 当前方法首节点信息 ? 当前方法首节点信息->方法虚拟存在.指针 : nullptr) {
        消息.方法虚拟存在指针 = reinterpret_cast<std::uintptr_t>(方法虚拟存在);
        消息.方法虚拟存在主键 = 方法虚拟存在->获取主键();
    }
    const bool 目标成功 = 私有_任务推进回执目标成功(回执);
    const bool 目标失败 = 私有_任务推进回执目标失败(回执)
        || 回执.状况 == 任务模块::筹办::枚举_任务推进状况::动作执行失败;
    const auto 原始运行码 = 本能动作运行结果值(执行结果.方法运行结果);
    const bool 本轮未执行等待重筹办 =
        执行结果.任务执行结果.记账结果 == 枚举_任务执行记账结果::未定义
        && (回执.状况 == 任务模块::筹办::枚举_任务推进状况::已建立方法头待重入
            || 回执.建议任务状态 == 枚举_任务状态::待重筹办);
    const auto 运行码 = 本轮未执行等待重筹办 ? I64{ 0 } : 原始运行码;
    消息.结果状态 = 目标成功
        ? 枚举_任务管理结果状态::成功
        : (目标失败
            ? 枚举_任务管理结果状态::失败
            : 枚举_任务管理结果状态::部分完成);
    const I64 完成度百万分比 = std::clamp<I64>(
        目标成功 && 回执.完成度百万分比 <= 0
            ? 1'000'000
            : 回执.完成度百万分比,
        0,
        1'000'000);
    消息.完成度 =
        static_cast<double>(完成度百万分比) / 1'000'000.0;
    消息.是否成功 = 目标成功;
    消息.错误码 = 运行码;
    消息.完成时间 = now;
    消息.任务价值反馈.反馈事件主键 =
        任务主键 + "|" + 消息.消息头.步骤主键 + "|" + std::to_string(now) + "|任务价值反馈";
    if (目标成功 && 回执.治理结果可接受) {
        消息.任务价值反馈.安全累计比例_百万分比 = 完成度百万分比;
        消息.任务价值反馈.服务累计比例_百万分比 = 完成度百万分比;
    }
    消息.是否仍有未满足项 =
        !目标成功
        || 回执.需要创建或复用子需求
        || 任务结果缺条件_最小_v0(执行结果.方法运行结果);
    消息.未满足项类型文本 =
        消息.是否仍有未满足项
            ? 私有_任务推进状况文本(回执.状况)
            : std::string{};
    消息.是否需要父任务处理 = 回执.父任务需要重筹办;
    消息.是否需要自我线程重判 =
        回执.需要自我线程
        || 目标成功
        || 任务结果缺条件_最小_v0(执行结果.方法运行结果);
    if (消息.是否仍有未满足项) {
        结构_任务管理未满足项 未满足项{};
        未满足项.未满足项类型 = 消息.未满足项类型文本;
        未满足项.作用主体主键 = 任务主键;
        未满足项.是否关键阻塞 = true;
        未满足项.是否建议线程重判 = 消息.是否需要自我线程重判;
        消息.未满足项集.push_back(未满足项);
    }

    结构_任务管理上行消息 上行{};
    上行.类型 = 枚举_任务管理上行消息类型::结果状态消息;
    上行.载荷 = 消息;
    同步任务管理上行消息语义槽(上行);
    return 上行;
}

结构_任务管理上行消息 私有_构造线程状态上行消息(
    const 任务节点* 任务,
    const 结构_执行任务结果& 执行结果,
    枚举_任务管理线程运行状态 运行状态,
    枚举_任务管理线程结束状态 结束状态,
    bool 是否结束,
    时间戳 now,
    const std::string& 阶段) noexcept
{
    结构_任务管理线程状态消息 消息{};
    const auto 任务主键 = 私有_任务主键(任务);
    const auto 步骤主键 = 私有_任务主键(执行结果.任务执行结果.当前步骤节点);
    消息.消息头.发出者主键 = "任务管理工作线程";
    消息.消息头.任务主键 = 任务主键;
    消息.消息头.步骤主键 = 步骤主键.empty() ? 任务主键 : 步骤主键;
    消息.消息头.产生时间 = now;
    消息.消息头.执行尝试主键 = 任务主键 + "|线程状态|" + 阶段;
    消息.消息头.幂等键 = 消息.消息头.执行尝试主键;
    消息.当前运行状态 = 运行状态;
    消息.是否执行尝试结束 = 是否结束;
    消息.结束状态 = 结束状态;
    消息.开始时间 = 任务 ? 任务->主信息.启动时间 : 0;
    消息.结束时间 = 是否结束 ? now : 0;

    if (!步骤主键.empty()) {
        消息.补充特征集.push_back(结构_任务管理线程补充特征{
            枚举_任务管理线程补充特征类型::当前步骤主键,
            步骤主键,
            0,
            false,
            reinterpret_cast<std::uintptr_t>(执行结果.任务执行结果.当前步骤节点)
        });
    }
    if (!执行结果.任务执行结果.方法运行说明.empty()) {
        消息.补充特征集.push_back(结构_任务管理线程补充特征{
            枚举_任务管理线程补充特征类型::当前等待原因,
            执行结果.任务执行结果.方法运行说明,
            0,
            false,
            0
        });
    }

    结构_任务管理上行消息 上行{};
    上行.类型 = 枚举_任务管理上行消息类型::线程状态消息;
    上行.载荷 = 消息;
    同步任务管理上行消息语义槽(上行);
    return 上行;
}

任务管理工作线程::结构_工作线程一步响应 私有_工作线程执行当前任务方法(
    自我类& 自我对象,
    bool 本轮执行筹办,
    bool 本轮执行方法,
    const 结构_任务根节点& 任务根节点,
    结构_任务控制态* 任务控制态,
    结构_任务局部运行态* 任务局部运行态,
    时间戳 now) noexcept
{
    now = 私有_时间(now);
    auto* 任务 = 私有_任务根节点取任务(任务根节点);

    任务管理工作线程::结构_工作线程一步响应 响应{};
    响应.最新任务控制态 = 任务控制态 ? *任务控制态 : 私有_构造任务控制态(任务根节点, 任务);
    响应.最新任务局部运行态 = 任务局部运行态 ? *任务局部运行态 : 私有_构造任务局部运行态(任务根节点, 任务);
    结构_执行任务结果 执行结果{};
    if (!任务) {
        执行结果 = 私有_构造未执行任务结果(nullptr, -12, "当前任务节点为空");
    } else {
        try {
            // 工作类型由管理界面线程决定。工作线程只按授权执行本轮动作，
            // 避免“筹办刚选出方法就同轮执行”的双阶段串账。
            if (本轮执行筹办) {
            const auto 筹办结果 = 私有_调用任务筹办普通函数(自我对象, 任务, now);
            {
                std::ostringstream 输出;
                auto* 当前方法 = reinterpret_cast<方法类::节点类*>(筹办结果.回执.当前方法.指针);
                输出 << "任务管理工作线程/筹办回执"
                    << " | 任务=" << 私有_任务主键(任务)
                    << " | 状况=" << 私有_任务推进状况文本(筹办结果.回执.状况)
                    << " | 当前方法=" << (当前方法
                        ? 当前方法->获取主键()
                        : std::string("空"))
                    << " | 需要子需求=" << (筹办结果.回执.需要创建或复用子需求 ? 1 : 0)
                    << " | 父任务需重筹办=" << (筹办结果.回执.父任务需要重筹办 ? 1 : 0);
                项目运行日志(输出.str());
            }
            私有_同步任务回执方法到任务虚拟存在(
                任务,
                筹办结果.回执,
                now);
            if (筹办结果.已执行筹办 && !筹办结果.说明.empty()) {
                项目运行日志("任务管理工作线程/普通任务筹办 | " + 筹办结果.说明);
            }
            私有_吸收筹办派生需求消息(
                响应,
                筹办结果.待上报派生需求消息集,
                任务,
                now);
            if (筹办结果.回执.状况 == 任务模块::筹办::枚举_任务推进状况::父需求已满足
                || 筹办结果.回执.状况 == 任务模块::筹办::枚举_任务推进状况::存在活动子需求
                || 筹办结果.回执.状况 == 任务模块::筹办::枚举_任务推进状况::逻辑组织待聚合) {
                const I64 运行码 =
                    筹办结果.回执.状况 == 任务模块::筹办::枚举_任务推进状况::父需求已满足
                        ? 0
                        : -26002;
                执行结果 = 私有_构造未执行任务结果(
                    任务,
                    运行码,
                    筹办结果.说明.empty()
                        ? std::string("任务筹办前置状态已返回")
                        : 筹办结果.说明);
                响应.一步结果.已执行当前步骤方法 = false;
                响应.一步结果.存在当前步骤方法执行数据 = true;
                响应.一步结果.当前步骤方法执行数据 = 执行结果.任务执行结果;
                响应.一步结果.当前步骤方法运行结果 = 执行结果.方法运行结果;
                响应.一步结果.存在任务推进回执 = true;
                响应.一步结果.当前任务推进回执 = 筹办结果.回执;
                响应.推进成功 = true;
                return 响应;
            }
            if (筹办结果.已建立方法头待重入
                || 筹办结果.回执.父任务需要重筹办) {
                执行结果 = 私有_构造未执行任务结果(
                    任务,
                    本能方法结果_任务筹办已建立方法头待重入,
                    筹办结果.说明.empty()
                        ? std::string("任务筹办已建立目标方法头，等待下一轮重筹办")
                        : 筹办结果.说明,
                    枚举_任务执行记账结果::未定义);
                响应.一步结果.已执行当前步骤方法 = false;
                响应.一步结果.存在当前步骤方法执行数据 = true;
                响应.一步结果.当前步骤方法执行数据 = 执行结果.任务执行结果;
                响应.一步结果.当前步骤方法运行结果 = 执行结果.方法运行结果;
                响应.一步结果.存在任务推进回执 = true;
                响应.一步结果.当前任务推进回执 = 筹办结果.回执;
                响应.推进成功 = true;
                return 响应;
            }
            if (筹办结果.回执.需要创建或复用子需求
                && 筹办结果.方法运行结果) {
                执行结果.有效 = true;
                执行结果.方法运行结果 = 筹办结果.方法运行结果;
                执行结果.任务执行结果.有效 = true;
                执行结果.任务执行结果.主任务 = 任务;
                执行结果.任务执行结果.当前步骤节点 = 任务;
                执行结果.任务执行结果.当前方法 =
                    reinterpret_cast<方法类::节点类*>(筹办结果.回执.当前方法.指针);
                if (!执行结果.任务执行结果.当前方法) {
                    执行结果.任务执行结果.当前方法 =
                        reinterpret_cast<方法类::节点类*>(任务类::读取任务执行方法(任务));
                }
                执行结果.任务执行结果.结果场景 = 筹办结果.结果场景
                    ? 筹办结果.结果场景
                    : (任务 ? 任务->主信息.场景.指针 : nullptr);
                执行结果.任务执行结果.方法运行结果 = 筹办结果.方法运行结果;
                执行结果.任务执行结果.方法运行说明 = 筹办结果.说明;
                执行结果.任务执行结果.记账结果 = 枚举_任务执行记账结果::未定义;
                同步执行桥语义槽(执行结果);
                响应.一步结果.已执行当前步骤方法 = false;
                响应.一步结果.存在当前步骤方法执行数据 = true;
                响应.一步结果.当前步骤方法执行数据 = 执行结果.任务执行结果;
                响应.一步结果.当前步骤方法运行结果 = 执行结果.方法运行结果;
                响应.一步结果.存在任务推进回执 = true;
                响应.一步结果.当前任务推进回执 = 筹办结果.回执;
                响应.推进成功 = true;
                return 响应;
            }
            if (筹办结果.回执.状况 != 任务模块::筹办::枚举_任务推进状况::方法可执行) {
                // 筹办没有形成可执行回执时，本轮必须停在任务管理层。
                // 特别是“缺自我动作组合 / 等待动作序列入口”这类缺口，不允许继续落到执行桥。
                执行结果 = 私有_构造未执行任务结果(
                    任务,
                    -26003,
                    筹办结果.说明.empty()
                        ? std::string("任务筹办尚未形成可执行回执，本轮不执行方法")
                        : 筹办结果.说明,
                    枚举_任务执行记账结果::未定义);
                响应.一步结果.已执行当前步骤方法 = false;
                响应.一步结果.存在当前步骤方法执行数据 = true;
                响应.一步结果.当前步骤方法执行数据 = 执行结果.任务执行结果;
                响应.一步结果.当前步骤方法运行结果 = 执行结果.方法运行结果;
                响应.一步结果.存在任务推进回执 = true;
                响应.一步结果.当前任务推进回执 = 筹办结果.回执;
                响应.推进成功 = true;
                return 响应;
            }
            if (!本轮执行方法) {
                执行结果 = 私有_构造未执行任务结果(
                    任务,
                    0,
                    筹办结果.说明.empty()
                        ? std::string("任务筹办已完成，本轮不执行方法")
                        : 筹办结果.说明,
                    枚举_任务执行记账结果::未定义);
                响应.一步结果.已执行当前步骤方法 = false;
                响应.一步结果.存在当前步骤方法执行数据 = true;
                响应.一步结果.当前步骤方法执行数据 = 执行结果.任务执行结果;
                响应.一步结果.当前步骤方法运行结果 = 执行结果.方法运行结果;
                响应.一步结果.存在任务推进回执 = true;
                响应.一步结果.当前任务推进回执 = 筹办结果.回执;
                响应.推进成功 = true;
                return 响应;
            }
            } else if (!本轮执行方法) {
                执行结果 = 私有_构造未执行任务结果(
                    任务,
                    0,
                    "工作项未指定筹办或执行，本轮仅同步状态",
                    枚举_任务执行记账结果::未定义);
                响应.一步结果.已执行当前步骤方法 = false;
                响应.一步结果.存在当前步骤方法执行数据 = true;
                响应.一步结果.当前步骤方法执行数据 = 执行结果.任务执行结果;
                响应.一步结果.当前步骤方法运行结果 = 执行结果.方法运行结果;
                响应.推进成功 = true;
                return 响应;
            }
            auto* 当前方法 = reinterpret_cast<方法类::节点类*>(任务类::读取任务执行方法(任务));
            auto* 管理对象任务 = 任务类::读取任务管理对象任务(任务);
            std::ostringstream 输出;
            const I64 选中能力值 = 任务类::读取任务选中自我能力值(任务);
            输出 << "任务管理工作线程/执行任务入口"
                << " | 管理任务=" << 私有_任务主键(任务)
                << " | 管理对象=" << 私有_任务主键(管理对象任务)
                << " | 当前方法=" << (当前方法 ? 当前方法->获取主键() : std::string("空"))
                << " | 当前本能ID=" << (当前方法 ? 当前方法->主信息.首节点信息().动作句柄.本能ID : -1)
                << " | 选中自我能力值=" << 选中能力值
                << " | 管理任务角色=" << static_cast<int>(任务类::读取任务角色(任务))
                << " | 管理对象角色=" << (管理对象任务 ? static_cast<int>(任务类::读取任务角色(管理对象任务)) : -1);
            项目运行日志(输出.str());
            任务模块::筹办::结构_任务推进回执 执行回执{};
            执行结果 = 私有_调用任务执行普通函数(任务, now, &执行回执);
            响应.一步结果.存在任务推进回执 = true;
            响应.一步结果.当前任务推进回执 = 执行回执;
        } catch (...) {
            执行结果.任务执行结果.结果场景 = 任务 ? 任务->主信息.场景.指针 : nullptr;
            执行结果.任务执行结果.方法运行结果 = 创建本能动作运行结果实例_按码(
                nullptr,
                执行结果.任务执行结果.结果场景,
                -9001,
                now);
            执行结果.任务执行结果.方法运行说明 = "执行任务异常";
            执行结果.方法运行结果 = 执行结果.任务执行结果.方法运行结果;
        }
    }

    响应.一步结果.已执行当前步骤方法 =
        任务 != nullptr
        && 执行结果.任务执行结果.当前方法 != nullptr;
    响应.一步结果.存在当前步骤方法执行数据 = true;
    响应.一步结果.当前步骤方法执行数据 = 执行结果.任务执行结果;
    响应.一步结果.当前步骤方法运行结果 = 执行结果.方法运行结果;
    响应.推进成功 = true;
    return 响应;
}

void 私有_刷新快照_已加锁(
    结构_工作线程壳状态& 状态,
    const 任务管理工作线程::结构_工作线程一步响应& 响应,
    const 任务节点* 任务,
    const 时间戳 now) noexcept
{
    状态.快照.已启动 = 状态.工作线程壳已启动;
    状态.快照.正在执行 = false;
    状态.快照.已收到请求 = true;
    状态.快照.最近任务根ID = 响应.最新任务控制态.任务根ID;
    状态.快照.累计推进次数 += 1;
    状态.快照.最近推进时间 = now;
    状态.快照.最近宿主任务主键 = 私有_任务主键(任务);
    状态.快照.最近步骤主键 = 私有_任务主键(
        响应.一步结果.当前步骤方法执行数据.当前步骤节点);
    if (状态.快照.最近步骤主键.empty()) {
        状态.快照.最近步骤主键 = 状态.快照.最近宿主任务主键;
    }
    状态.快照.最近方法主键 = 响应.一步结果.当前步骤方法执行数据.当前方法
        ? 响应.一步结果.当前步骤方法执行数据.当前方法->获取主键()
        : std::string{};
    状态.快照.最近下一步去向 = 响应.一步结果.治理结果.当前下一步去向 == 枚举_任务管理下一步去向::进入收束
        ? "进入收束"
        : (响应.一步结果.治理结果.当前下一步去向 == 枚举_任务管理下一步去向::保持等待
            ? "保持等待"
            : "进入运行");
    状态.快照.最近总控结果 = 响应.一步结果.治理结果.最近总控结果 == 枚举_任务管理总控结果::宿主进入收束
        ? "宿主进入收束"
        : (响应.一步结果.治理结果.最近总控结果 == 枚举_任务管理总控结果::宿主保持等待
            ? "宿主保持等待"
            : "宿主已进入运行");
    状态.快照.最近缺口归类 = 响应.一步结果.治理结果.当前缺口类型 == 枚举_任务管理缺口类型::方法挂点缺失
        ? "方法挂点缺失"
        : (响应.一步结果.治理结果.当前缺口类型 == 枚举_任务管理缺口类型::无缺口
            ? "无缺口"
            : "工作线程按一步结果归类");
    if (响应.一步结果.存在任务推进回执) {
        状态.快照.最近推进阶段 = 私有_任务推进阶段文本(
            响应.一步结果.当前任务推进回执.阶段);
        状态.快照.最近推进状况 = 私有_任务推进状况文本(
            响应.一步结果.当前任务推进回执.状况);
    } else {
        状态.快照.最近推进阶段 = "未定义";
        状态.快照.最近推进状况 = "未定义";
    }
    状态.快照.最近筹办承接 = "工作线程已生成一步结果";
    状态.快照.最近等待原因 = 响应.最新任务局部运行态.当前等待原因;
    状态.快照.最近一次上行消息数 = static_cast<std::uint64_t>(响应.一步结果.上行消息集.size());
    状态.快照.累计发送上行消息数 += 状态.快照.最近一次上行消息数;
}

void 私有_补齐工作线程一步结果(
    任务管理工作线程::结构_工作线程一步响应& 响应,
    任务节点* 任务,
    任务节点* 管理对象任务,
    需求节点* 需求,
    const 结构_任务根节点& 任务根节点,
    const 时间戳 now) noexcept
{
    auto& 一步 = 响应.一步结果;
    auto* 管理任务 = 任务;
    auto* 宿主任务 = 管理对象任务 ? 管理对象任务 : 任务;
    auto* 当前步骤节点 =
        一步.当前步骤方法执行数据.当前步骤节点
            ? 一步.当前步骤方法执行数据.当前步骤节点
            : 宿主任务;
    一步.任务管理治理触发 = true;
    一步.任务管理上位输入已刷新 = true;
    一步.治理结果.最近根层重判结果 =
        枚举_任务管理根层重判结果::允许普通推进;
    一步.治理结果.最近执行前门控结果 =
        枚举_任务管理执行前门控结果::允许普通执行;
    一步.治理结果.当前主需求 = 需求;
    一步.治理结果.当前管理任务 = 管理任务;
    一步.治理结果.当前宿主任务 = 宿主任务;
    一步.治理结果.当前步骤节点 = 当前步骤节点;
    一步.治理结果.已选中宿主任务 = 宿主任务 != nullptr;

    if (!任务) {
        响应.最新任务控制态.队列状态 = 枚举_任务队列状态::等待;
        响应.最新任务局部运行态.当前状态 = 枚举_任务局部运行状态::等待条件;
        响应.最新任务局部运行态.当前等待原因 = "缺少任务节点";
        一步.治理结果.当前缺口类型 = 枚举_任务管理缺口类型::宿主任务缺失;
        一步.治理结果.当前下一步去向 = 枚举_任务管理下一步去向::保持等待;
        一步.治理结果.最近总控结果 = 枚举_任务管理总控结果::宿主保持等待;
        结构_执行任务结果 空执行结果{};
        空执行结果.任务执行结果 = 一步.当前步骤方法执行数据;
        空执行结果.方法运行结果 = 一步.当前步骤方法运行结果;
        一步.上行消息集.push_back(私有_构造线程状态上行消息(
            nullptr,
            空执行结果,
            枚举_任务管理线程运行状态::故障,
            枚举_任务管理线程结束状态::故障结束,
            true,
            now,
            "缺少任务"));
        return;
    }

    结构_执行任务结果 执行结果{};
    执行结果.任务执行结果 = 一步.当前步骤方法执行数据;
    执行结果.方法运行结果 = 一步.当前步骤方法运行结果;
    if (!一步.存在任务推进回执) {
        一步.当前任务推进回执 = 私有_构造执行推进回执(
            宿主任务,
            需求,
            执行结果);
        一步.存在任务推进回执 = true;
    }
    auto& 推进回执 = 一步.当前任务推进回执;
    auto* 上行任务 = 宿主任务;
    const bool 仅任务管理内部换步 = false;
    const bool 回执表示等待既有子需求 =
        推进回执.状况 == 任务模块::筹办::枚举_任务推进状况::存在活动子需求;
    const bool 回执表示逻辑组织待聚合 =
        推进回执.状况 == 任务模块::筹办::枚举_任务推进状况::逻辑组织待聚合;
    const bool 回执表示父需求已满足 =
        推进回执.状况 == 任务模块::筹办::枚举_任务推进状况::父需求已满足;
    const auto* 执行输出派生需求词 = 私有_执行输出派生需求词(执行结果);
    const auto* 执行输出失败原因词 = 私有_执行输出失败原因词(执行结果);
    auto* 派生当前状态 = 私有_读取执行输出状态指针(
        执行结果,
        私有_执行输出特征_派生需求当前状态());
    auto* 派生目标状态 = 私有_读取执行输出状态指针(
        执行结果,
        私有_执行输出特征_派生需求目标状态());
    auto* 来源目标状态 = 私有_任务目标状态(宿主任务, 需求);
    const auto* 来源目标特征 = 私有_状态特征类型(来源目标状态);
    const bool 派生目标等于来源需求目标 =
        私有_状态目标同一_工作线程(派生目标状态, 来源目标状态);
    const bool 派生目标特征等于来源目标特征 =
        私有_语素入口同一_工作线程(执行输出派生需求词, 来源目标特征);
    const bool 执行结果缺最小条件 =
        !回执表示等待既有子需求
        && !回执表示逻辑组织待聚合
        && !回执表示父需求已满足
        && 任务结果缺条件_最小_v0(执行结果.方法运行结果);
    const bool 执行输出存在派生原子需求 =
        !回执表示等待既有子需求
        && !回执表示逻辑组织待聚合
        && !回执表示父需求已满足
        && 私有_执行输出需要派生原子需求(执行结果);
    const bool 同目标学习缺口继续当前任务 =
        执行输出存在派生原子需求
        && 私有_方法是学习承接本能(一步.当前步骤方法执行数据.当前方法)
        && 私有_任务推进状况是学习承接缺口(推进回执.状况)
        && 私有_目标特征是学习承接缺口(执行输出派生需求词)
        && (派生目标等于来源需求目标
            || (派生目标特征等于来源目标特征
                && 私有_目标特征是学习承接缺口(来源目标特征)));
    {
        const auto 执行运行视图 = 读取本能方法运行闭环视图(
            执行结果.方法运行结果,
            执行结果.任务执行结果.结果场景);
        std::ostringstream 输出;
        输出 << "任务管理工作线程/执行输出派生尾部证据"
            << " | 任务=" << 私有_任务主键(宿主任务)
            << " | 需求=" << 私有_需求主键(需求)
            << " | 当前方法=" << (一步.当前步骤方法执行数据.当前方法
                ? 一步.当前步骤方法执行数据.当前方法->获取主键()
                : std::string{})
            << " | 方法运行成功=" << (执行运行视图.方法执行成功 && !执行运行视图.有执行缺口() ? 1 : 0)
            << " | 方法运行结果=" << (执行结果.方法运行结果
                ? 执行结果.方法运行结果->获取主键()
                : std::string{})
            << " | 结果场景=" << (执行结果.任务执行结果.结果场景
                ? 执行结果.任务执行结果.结果场景->获取主键()
                : std::string{})
            << " | 派生需求词=" << (执行输出派生需求词
                ? 执行输出派生需求词->获取主键()
                : std::string{})
            << " | 失败原因词=" << (执行输出失败原因词
                ? 执行输出失败原因词->获取主键()
                : std::string{})
            << " | 派生当前状态=" << (派生当前状态
                ? 派生当前状态->获取主键()
                : std::string{})
            << " | 派生目标状态=" << (派生目标状态
                ? 派生目标状态->获取主键()
                : std::string{})
            << " | 来源目标状态=" << (来源目标状态
                ? 来源目标状态->获取主键()
                : std::string{})
            << " | 派生目标等于来源=" << (派生目标等于来源需求目标 ? 1 : 0)
            << " | 派生目标特征等于来源特征=" << (派生目标特征等于来源目标特征 ? 1 : 0)
            << " | 推进状况=" << 私有_任务推进状况文本(推进回执.状况)
            << " | 回执摘要=" << 推进回执.摘要;
        项目运行日志(输出.str());
    }
    if (同目标学习缺口继续当前任务) {
        // 学习承接本能已经执行并写出同目标结构化缺口时，
        // 不能把同一目标再次派生成子需求；当前任务保留缺口并等待重筹办/后续证据。
        推进回执.需要自我线程 = false;
        推进回执.需要创建或复用子需求 = false;
        推进回执.父任务需要重筹办 = true;
        推进回执.摘要 = "学习承接同目标缺口，继续当前任务";
        项目运行日志(
            "任务管理工作线程/同目标学习缺口继续"
            " | 任务=" + 私有_任务主键(宿主任务)
            + " | 需求=" + 私有_需求主键(需求)
            + " | 推进状况=" + 私有_任务推进状况文本(推进回执.状况));
    }
    const bool 执行输出需要派生需求 =
        执行输出存在派生原子需求
        && !同目标学习缺口继续当前任务;
    const bool 存在阻塞性派生需求 = 执行结果缺最小条件 || 执行输出需要派生需求;
    {
        std::ostringstream 输出;
        输出 << "任务管理工作线程/执行输出派生判定"
            << " | 任务=" << (管理任务 ? 管理任务->获取主键() : std::string{})
            << " | 管理对象任务=" << (管理对象任务 ? 管理对象任务->获取主键() : std::string{})
            << " | 上行任务=" << (上行任务 ? 上行任务->获取主键() : std::string{})
            << " | 当前方法=" << (一步.当前步骤方法执行数据.当前方法
                ? 一步.当前步骤方法执行数据.当前方法->获取主键()
                : std::string{})
            << " | 推进状况=" << 私有_任务推进状况文本(推进回执.状况)
            << " | 等待既有子需求=" << (回执表示等待既有子需求 ? 1 : 0)
            << " | 逻辑组织待聚合=" << (回执表示逻辑组织待聚合 ? 1 : 0)
            << " | 父需求已满足=" << (回执表示父需求已满足 ? 1 : 0)
            << " | 缺最小条件=" << (执行结果缺最小条件 ? 1 : 0)
            << " | 执行输出存在派生原子需求=" << (执行输出存在派生原子需求 ? 1 : 0)
            << " | 同目标学习继续=" << (同目标学习缺口继续当前任务 ? 1 : 0)
            << " | 执行输出需要派生需求=" << (执行输出需要派生需求 ? 1 : 0);
        项目运行日志(输出.str());
    }

    auto 推导状态 = 私有_从任务推进回执推导界面任务状态(
        推进回执,
        一步.当前步骤方法执行数据,
        一步.当前步骤方法运行结果);
    if (同目标学习缺口继续当前任务
        && 推导状态 == 枚举_任务状态::等待中) {
        推导状态 = 枚举_任务状态::待重筹办;
    }
    if (存在阻塞性派生需求
        && (推导状态 == 枚举_任务状态::完成
            || 推导状态 == 枚举_任务状态::失败)) {
        推导状态 = 枚举_任务状态::等待中;
    }
    私有_填充任务层回执到治理结果(
        一步.治理结果,
        宿主任务,
        推进回执,
        推导状态);
    if (!一步.治理结果.当前方法) {
        一步.治理结果.当前方法 = 一步.当前步骤方法执行数据.当前方法;
    }

    if (推导状态 == 枚举_任务状态::完成) {
        响应.最新任务控制态.队列状态 = 枚举_任务队列状态::已结算;
        响应.最新任务局部运行态.当前状态 = 枚举_任务局部运行状态::局部完成;
        响应.最新任务局部运行态.局部完成度 = 10000;
        // 这里表示“存在任务状态推进建议”，真实提交仍由提交类本能方法完成。
        一步.治理结果.已推进任务状态 = true;
        一步.治理结果.当前缺口类型 = 枚举_任务管理缺口类型::无缺口;
        一步.治理结果.当前下一步去向 = 枚举_任务管理下一步去向::进入收束;
        一步.治理结果.最近总控结果 = 枚举_任务管理总控结果::宿主进入收束;
    } else if (推导状态 == 枚举_任务状态::待重筹办
        || 推导状态 == 枚举_任务状态::执行中
        || 推导状态 == 枚举_任务状态::就绪
        || 推导状态 == 枚举_任务状态::排队中) {
        响应.最新任务控制态.队列状态 = 枚举_任务队列状态::可运行;
        响应.最新任务控制态.已派发 = false;
        响应.最新任务局部运行态.当前状态 = 枚举_任务局部运行状态::当前步骤可执行;
        响应.最新任务局部运行态.当前等待原因 = 推进回执.摘要;
        一步.治理结果.当前缺口类型 = 枚举_任务管理缺口类型::无缺口;
        一步.治理结果.当前下一步去向 =
            推导状态 == 枚举_任务状态::待重筹办
                ? 枚举_任务管理下一步去向::回到重筹办
                : 枚举_任务管理下一步去向::进入运行;
        一步.治理结果.最近总控结果 = 枚举_任务管理总控结果::宿主已进入运行;
    } else {
        响应.最新任务控制态.队列状态 = 枚举_任务队列状态::等待;
        响应.最新任务局部运行态.当前状态 = 枚举_任务局部运行状态::等待条件;
        响应.最新任务局部运行态.当前等待原因 = 推进回执.摘要.empty()
            ? 私有_执行结果等待原因(
                一步.当前步骤方法执行数据,
                一步.当前步骤方法运行结果)
            : 推进回执.摘要;
        一步.治理结果.当前缺口类型 =
            执行输出需要派生需求 || 一步.当前步骤方法执行数据.当前方法
                ? 枚举_任务管理缺口类型::任务运行中
                : 枚举_任务管理缺口类型::任务待启动;
        一步.治理结果.当前下一步去向 = 枚举_任务管理下一步去向::保持等待;
        一步.治理结果.最近总控结果 = 枚举_任务管理总控结果::宿主保持等待;
    }

    一步.上行消息集.push_back(私有_构造线程状态上行消息(
        宿主任务,
        执行结果,
        枚举_任务管理线程运行状态::推进中,
        枚举_任务管理线程结束状态::未结束,
        false,
        now,
        "推进中"));

    bool 实际已上报派生需求 = 私有_回报包含派生需求消息(响应);
    auto 尝试上报派生需求 = [&]() noexcept {
        auto 派生需求消息 = 私有_构造执行缺失原子需求消息(
            上行任务,
            执行结果,
            &推进回执,
            now);
        if (派生需求消息.类型 != 枚举_任务管理上行消息类型::未定义) {
            一步.上行消息集.push_back(std::move(派生需求消息));
            实际已上报派生需求 = true;
        }
    };

    if (!仅任务管理内部换步) {
        if (执行结果缺最小条件) {
            尝试上报派生需求();
        }
        if (执行输出需要派生需求
            && !执行结果缺最小条件) {
            尝试上报派生需求();
        }
        auto 上行消息 = 私有_构造结果状态上行消息(上行任务, 执行结果, 推进回执, now);
        一步.上行消息集.push_back(上行消息);
    }
    const auto 最终运行状态 =
        推导状态 == 枚举_任务状态::完成
            ? 枚举_任务管理线程运行状态::已停止
            : (推导状态 == 枚举_任务状态::等待中 || 推导状态 == 枚举_任务状态::挂起
                ? 枚举_任务管理线程运行状态::等待中
                : 枚举_任务管理线程运行状态::推进中);
    const auto 最终结束状态 =
        推导状态 == 枚举_任务状态::完成
            ? 枚举_任务管理线程结束状态::正常结束
            : 枚举_任务管理线程结束状态::未结束;
    一步.上行消息集.push_back(私有_构造线程状态上行消息(
        宿主任务,
        执行结果,
        最终运行状态,
        最终结束状态,
        推导状态 == 枚举_任务状态::完成,
        now,
        "回报"));
    结构_任务推进事件 推进事件{};
    推进事件.任务根ID = 任务根节点.任务根ID;
    推进事件.事件类型 =
        实际已上报派生需求
            ? 枚举_任务推进事件类型::派生需求上报
            : (推导状态 == 枚举_任务状态::完成
                ? 枚举_任务推进事件类型::最终结果返回
                : 枚举_任务推进事件类型::当前步骤阻塞);
    推进事件.当前步骤指针 = reinterpret_cast<std::uintptr_t>(当前步骤节点);
    推进事件.结果指针 = 0;
    推进事件.等待原因 = 响应.最新任务局部运行态.当前等待原因;
    推进事件.说明 = 推进回执.摘要.empty()
        ? 一步.当前步骤方法执行数据.方法运行说明
        : 推进回执.摘要;
    同步工作线程事件语义槽(推进事件);
    一步.推进事件列表.push_back(推进事件);
}

} // namespace

namespace 任务管理工作线程 {

bool 确保任务管理工作线程壳已启动() noexcept
{
    auto& 状态 = 私有_壳状态();
    std::lock_guard<std::mutex> 锁(状态.锁);
    状态.工作线程壳已启动 = true;
    状态.快照.已启动 = true;
    return true;
}

const char* 外设消息承接处理状态文本(枚举_外设消息承接处理状态 状态) noexcept
{
    switch (状态) {
    case 枚举_外设消息承接处理状态::未处理:
        return "未处理";
    case 枚举_外设消息承接处理状态::无匹配报告:
        return "无匹配报告";
    case 枚举_外设消息承接处理状态::已生成任务回执:
        return "已生成任务回执";
    case 枚举_外设消息承接处理状态::已生成观察事实承接请求:
        return "已生成观察事实承接请求";
    case 枚举_外设消息承接处理状态::已生成稳定特征承接请求:
        return "已生成稳定特征承接请求";
    default:
        return "未知";
    }
}

std::string 构造任务管理外设消息承接结果摘要(
    const 结构_外设消息承接结果& 结果)
{
    std::ostringstream 输出;
    输出 << "任务管理外设消息承接"
        << " | 状态=" << 外设消息承接处理状态文本(结果.处理状态)
        << " | 等待项ID=" << 结果.等待项ID
        << " | 报告ID=" << 结果.报告ID
        << " | 目标外设=" << 结果.目标外设
        << " | 观察运行模式=" << 结果.观察运行模式文本
        << " | 报告类型=" << 结果.报告类型文本
        << " | 命中报告=" << (结果.命中报告 ? 1 : 0)
        << " | 任务回执=" << (结果.生成任务回执 ? 1 : 0)
        << " | 观察承接请求=" << (结果.生成观察事实承接请求 ? 1 : 0)
        << " | 稳定特征承接请求=" << (结果.生成稳定特征承接请求 ? 1 : 0)
        << " | 上行消息数=" << 结果.上行消息集.size();
    if (!结果.承接摘要.empty()) {
        输出 << " | 摘要=" << 结果.承接摘要;
    }
    return 输出.str();
}

结构_外设消息承接结果 任务管理外设消息承接_处理一次(
    const 结构_外设观察等待项& 等待项)
{
    结构_外设消息承接结果 结果{};
    结果.已处理 = true;
    结果.等待项ID = 等待项.等待项ID;
    结果.目标外设 = 等待项.目标外设;
    结果.观察运行模式文本 = 外设观察运行模式文本(等待项.观察运行模式);
    结果.报告类型文本 = 外设观察报告类型文本(等待项.期望报告类型);

    const auto 匹配报告 = 按等待项匹配外设观察报告(等待项);
    if (!匹配报告.has_value()) {
        结果.处理状态 = 枚举_外设消息承接处理状态::无匹配报告;
        结果.承接摘要 = "未命中外设观察报告；只保留队列缓存，不上报自我线程";
        项目运行日志("任务管理外设消息承接/处理一次 | "
            + 构造任务管理外设消息承接结果摘要(结果));
        return 结果;
    }

    const auto& 报告 = *匹配报告;
    结果.命中报告 = true;
    结果.生成任务回执 = true;
    结果.报告ID = 报告.报告ID;
    结果.报告类型文本 = 外设观察报告类型文本(报告.报告类型);

    const auto 质量判定 = 判断外设观察材料质量(报告, &等待项);
    const auto 质量摘要 = 构造观察材料质量判定摘要(质量判定);
    if (质量判定.等级 == 枚举_观察材料等级::不合格) {
        结果.处理状态 = 枚举_外设消息承接处理状态::已生成任务回执;
        结果.承接摘要 =
            "已匹配外设报告，但观察材料不合格；不生成观察事实或稳定特征上行，等待下一份新鲜材料 | "
            + 质量摘要;
        项目运行日志("任务管理外设消息承接/材料不合格 | "
            + 构造任务管理外设消息承接结果摘要(结果));
        return 结果;
    }

    if (报告.报告类型 == 枚举_外设观察报告类型::逐簇识别报告) {
        if (质量判定.可进入识别方法) {
            结果.生成观察事实承接请求 = true;
            结果.处理状态 = 枚举_外设消息承接处理状态::已生成观察事实承接请求;
            结果.承接摘要 =
                "已匹配逐簇识别报告；形成任务回执和观察事实承接请求草案，等待提交入口裁决";
        } else {
            结果.处理状态 = 枚举_外设消息承接处理状态::已生成任务回执;
            结果.承接摘要 =
                "已匹配逐簇识别报告，但材料质量门控未允许进入验证或识别方法";
        }
    } else if (报告.报告类型 == 枚举_外设观察报告类型::扫描变化报告) {
        if (质量判定.可生成扫描变化候选) {
            结果.生成观察事实承接请求 = true;
            结果.处理状态 = 枚举_外设消息承接处理状态::已生成观察事实承接请求;
            结果.承接摘要 =
                "已匹配优质扫描变化报告；形成扫描变化观察承接请求草案，等待提交入口裁决";
        } else if (质量判定.可进入验证方法) {
            结果.生成观察事实承接请求 = true;
            结果.处理状态 = 枚举_外设消息承接处理状态::已生成观察事实承接请求;
            结果.承接摘要 =
                "已匹配可用扫描材料；仅形成待复验观察承接请求，不生成扫描变化动态候选";
        } else {
            结果.处理状态 = 枚举_外设消息承接处理状态::已生成任务回执;
            结果.承接摘要 =
                "已匹配扫描变化报告，但材料质量门控未允许进入验证方法";
        }
    } else if (报告.报告类型 == 枚举_外设观察报告类型::跟踪报告) {
        if (质量判定.可生成跟踪动态候选) {
            结果.生成稳定特征承接请求 = true;
            结果.处理状态 = 枚举_外设消息承接处理状态::已生成稳定特征承接请求;
            结果.承接摘要 =
                "已匹配优质跟踪报告；形成稳定特征承接请求草案，等待提交入口裁决";
        } else if (质量判定.可进入验证方法) {
            结果.生成观察事实承接请求 = true;
            结果.处理状态 = 枚举_外设消息承接处理状态::已生成观察事实承接请求;
            结果.承接摘要 =
                "已匹配可用跟踪材料；仅形成待复验观察承接请求，不生成稳定跟踪动态候选";
        } else {
            结果.处理状态 = 枚举_外设消息承接处理状态::已生成任务回执;
            结果.承接摘要 =
                "已匹配跟踪报告，但材料质量门控未允许进入验证方法";
        }
    } else {
        结果.处理状态 = 枚举_外设消息承接处理状态::已生成任务回执;
        结果.承接摘要 =
            "已匹配外设报告；仅形成任务回执，不直接写需求树或世界树";
    }
    结果.承接摘要 += " | " + 质量摘要;

    if (结果.生成观察事实承接请求 || 结果.生成稳定特征承接请求) {
        结构_任务管理观察事实承接请求 承接请求{};
        承接请求.消息头.发出者主键 = "任务管理工作线程";
        承接请求.消息头.产生时间 = 结构体_时间戳::当前_微秒();
        承接请求.消息头.幂等键 =
            "外设观察承接|等待项=" + std::to_string(等待项.等待项ID)
            + "|报告=" + std::to_string(报告.报告ID);
        承接请求.等待项ID = 等待项.等待项ID;
        承接请求.报告ID = 报告.报告ID;
        承接请求.来源需求ID = 等待项.来源需求ID;
        承接请求.目标观察约束ID = 等待项.目标观察约束ID != 0
            ? 等待项.目标观察约束ID
            : 报告.目标观察约束ID;
        承接请求.目标存在ID = 等待项.目标存在ID;
        承接请求.目标特征类型ID = 等待项.目标特征类型ID;
        承接请求.目标特征当前值 = 等待项.目标特征当前值;
        承接请求.目标特征generation = !等待项.目标特征generation.empty()
            ? 等待项.目标特征generation
            : 报告.目标特征generation;
        承接请求.约束generation = !等待项.约束generation.empty()
            ? 等待项.约束generation
            : 报告.约束generation;
        承接请求.来源外设 = 报告.来源外设;
        承接请求.观察运行模式文本 = 外设观察运行模式文本(报告.观察运行模式);
        承接请求.报告类型文本 = 外设观察报告类型文本(报告.报告类型);
        承接请求.观察时间 = static_cast<时间戳>(报告.时间戳毫秒);
        承接请求.观察像素簇数量 =
            static_cast<std::uint64_t>(报告.观察像素簇集合.size());
        承接请求.请求承接观察报告 = true;
        承接请求.请求承接观察像素簇集合 =
            报告.报告类型 == 枚举_外设观察报告类型::逐簇识别报告
            || 报告.报告类型 == 枚举_外设观察报告类型::扫描变化报告;
        承接请求.请求生成存在候选 =
            报告.报告类型 == 枚举_外设观察报告类型::逐簇识别报告;
        承接请求.请求统计当前帧识别情况 =
            报告.报告类型 == 枚举_外设观察报告类型::逐簇识别报告;
        承接请求.请求承接稳定特征集合 = 结果.生成稳定特征承接请求;
        承接请求.报告摘要 = 构造外设观察报告摘要(报告);
        承接请求.证据摘要 =
            "任务管理按外设观察等待项匹配报告并完成观察材料质量门控后生成，等待提交入口裁决 | "
            + 质量摘要;
        同步任务管理观察事实承接请求语义槽(承接请求);

        结构_任务管理上行消息 上行{};
        上行.类型 = 枚举_任务管理上行消息类型::观察事实承接请求;
        上行.载荷 = 承接请求;
        同步任务管理上行消息语义槽(上行);
        项目运行日志(
            "任务管理外设消息承接/生成观察事实承接请求 | "
            + 构造任务管理观察事实承接请求文本(承接请求));
        结果.上行消息集.push_back(std::move(上行));
        const bool 报告已消费 = 标记外设观察报告已消费(报告.报告ID, 等待项.等待项ID);
        结果.承接摘要 +=
            std::string(" | 报告已消费标记=")
            + (报告已消费 ? "1" : "0")
            + " | 消费口径=已生成自我侧观察承接上行,报告仍可按ID回查直到TTL清理";
    }

    项目运行日志("任务管理外设消息承接/处理一次 | "
        + 构造任务管理外设消息承接结果摘要(结果));
    return 结果;
}

bool 提交任务工作项(
    自我类& 自我对象,
    const 任务管理线程协议::结构_任务工作项& 工作项,
    任务管理线程协议::结构_任务工作结果* 输出) noexcept
{
    (void)确保任务管理工作线程壳已启动();
    const auto now = 私有_时间(工作项.当前时间);
    任务管理线程协议::结构_任务工作结果 局部结果{};
    auto* 有效输出 = 输出 ? 输出 : &局部结果;
    *有效输出 = {};
    有效输出->请求ID = 工作项.请求ID;
    有效输出->工作项ID = 工作项.工作项ID;
    有效输出->幂等键 = 工作项.幂等键;
    有效输出->任务信息节点 = 工作项.任务信息节点;
    有效输出->任务虚拟存在 = 工作项.任务虚拟存在;
    有效输出->来源需求 = 工作项.来源需求;
    有效输出->最新任务控制态 = 工作项.任务控制态;
    有效输出->最新任务局部运行态 = 工作项.任务局部运行态;

    auto 根节点 = 工作项.任务根节点;
    auto 控制态 = 工作项.任务控制态;
    auto 局部运行态 = 工作项.任务局部运行态;
    auto* 管理任务 = reinterpret_cast<任务节点*>(工作项.任务信息节点);
    if (管理任务 && 根节点.管理对象任务指针 == 0) {
        根节点.管理对象任务指针 = reinterpret_cast<std::uintptr_t>(管理任务);
    }
    {
        auto& 状态 = 私有_壳状态();
        std::lock_guard<std::mutex> 锁(状态.锁);
        状态.快照.已启动 = true;
        状态.快照.正在执行 = true;
        状态.快照.已收到请求 = true;
        状态.快照.最近请求ID = 工作项.请求ID;
        状态.快照.最近工作项ID = 工作项.工作项ID;
        状态.快照.最近任务根ID = 根节点.任务根ID;
        状态.快照.最近开始时间 = now;
        状态.快照.最近推进时间 = now;
        状态.快照.最近宿主任务主键 = 私有_任务主键(管理任务);
        状态.快照.最近任务虚拟存在主键 =
            工作项.任务虚拟存在 ? 工作项.任务虚拟存在->获取主键() : std::string{};
        状态.快照.最近需求主键 =
            工作项.来源需求 ? 工作项.来源需求->获取主键() : std::string{};
        状态.快照.累计收到请求数 += 1;
        状态.快照.累计收到工作项数 += 1;
    }

    const auto 写失败结果 = [&](I64 错误码, const std::string& 说明) noexcept {
        有效输出->已处理 = true;
        有效输出->推进成功 = false;
        有效输出->任务失败 = true;
        有效输出->错误码 = 错误码;
        有效输出->错误说明 = 说明;
        有效输出->等待原因 = 说明;
        有效输出->摘要 = 说明;
        有效输出->最新任务控制态 = 控制态;
        有效输出->最新任务控制态.队列状态 = 枚举_任务队列状态::等待;
        有效输出->最新任务局部运行态 = 局部运行态;
        有效输出->最新任务局部运行态.当前状态 = 枚举_任务局部运行状态::等待条件;
        有效输出->最新任务局部运行态.当前等待原因 = 说明;
        结构_任务推进事件 事件{};
        事件.任务根ID = 根节点.任务根ID;
        事件.事件类型 = 枚举_任务推进事件类型::异常上报;
        事件.当前步骤指针 = reinterpret_cast<std::uintptr_t>(管理任务);
        事件.等待原因 = 说明;
        事件.说明 = 说明;
        同步工作线程事件语义槽(事件);
        有效输出->推进事件列表.push_back(事件);
        auto& 状态 = 私有_壳状态();
        std::lock_guard<std::mutex> 锁(状态.锁);
        状态.快照.正在执行 = false;
        状态.快照.故障 = true;
        状态.快照.累计处理工作项数 += 1;
        状态.快照.累计失败数 += 1;
        状态.快照.最近结束时间 = now;
        状态.快照.最近错误说明 = 说明;
        状态.快照.最近等待原因 = 说明;
    };

    if (鱼巢_不允许空指(管理任务, "任务管理工作线程/提交任务工作项/任务信息节点缺失")) {
        写失败结果(-1001, "缺少任务信息节点");
        return false;
    }
    if (鱼巢_不允许空指(工作项.任务虚拟存在, "任务管理工作线程/提交任务工作项/任务虚拟存在缺失")) {
        写失败结果(-1002, "缺少任务虚拟存在，界面线程未完成绑定");
        return false;
    }
    if (根节点.任务根ID == 0) {
        写失败结果(-1003, "缺少任务根ID");
        return false;
    }
    if (!任务类::任务允许派发(管理任务)) {
        写失败结果(-1005, "任务信息节点当前不可派发");
        return false;
    }

    const bool 本轮执行筹办 =
        工作项.工作类型 == 任务管理线程协议::枚举_任务工作项类型::筹办;
    const bool 本轮执行方法 =
        工作项.工作类型 == 任务管理线程协议::枚举_任务工作项类型::执行;
    if (!本轮执行筹办 && !本轮执行方法) {
        写失败结果(-1006, "任务工作项未指定筹办或执行");
        有效输出->任务失败 = false;
        有效输出->需要等待 = true;
        return false;
    }

    auto 响应 = 私有_工作线程执行当前任务方法(
        自我对象,
        本轮执行筹办,
        本轮执行方法,
        根节点,
        &控制态,
        &局部运行态,
        now);
    私有_补齐工作线程一步结果(
        响应,
        管理任务,
        私有_任务根节点取管理对象任务(根节点),
        reinterpret_cast<需求节点*>(工作项.来源需求),
        根节点,
        now);

    结构_外设消息承接结果 外设承接结果{};
    bool 存在外设承接结果 = false;
    bool 存在外设承接上行消息 = false;
    if (工作项.存在外设观察等待项) {
        外设承接结果 = 任务管理外设消息承接_处理一次(工作项.外设观察等待项);
        存在外设承接结果 = true;
        存在外设承接上行消息 = !外设承接结果.上行消息集.empty();
        if (存在外设承接上行消息) {
            响应.一步结果.任务管理上位输入已刷新 = true;
            响应.一步结果.任务管理治理触发 = true;
            for (auto& 上行消息 : 外设承接结果.上行消息集) {
                if (auto* 观察承接 =
                    std::get_if<结构_任务管理观察事实承接请求>(&上行消息.载荷)) {
                    const auto 任务主键 = 私有_任务主键(管理任务);
                    if (观察承接->消息头.发出者主键.empty()) {
                        观察承接->消息头.发出者主键 = "任务管理工作线程";
                    }
                    if (观察承接->消息头.任务主键.empty()) {
                        观察承接->消息头.任务主键 = 任务主键;
                    }
                    if (观察承接->消息头.任务管理任务主键.empty()) {
                        观察承接->消息头.任务管理任务主键 = 任务主键;
                    }
                    if (观察承接->消息头.步骤主键.empty()) {
                        观察承接->消息头.步骤主键 = 任务主键;
                    }
                    if (观察承接->消息头.产生时间 == 0) {
                        观察承接->消息头.产生时间 = now;
                    }
                    if (观察承接->来源需求ID.empty() && 工作项.来源需求) {
                        观察承接->来源需求ID =
                            reinterpret_cast<需求节点*>(工作项.来源需求)->获取主键();
                    }
                    if (观察承接->消息头.幂等键.empty()) {
                        观察承接->消息头.幂等键 =
                            "外设观察承接|任务=" + 任务主键
                            + "|等待项=" + std::to_string(观察承接->等待项ID)
                            + "|报告=" + std::to_string(观察承接->报告ID);
                    }
                    同步任务管理观察事实承接请求语义槽(*观察承接);
                    同步任务管理上行消息语义槽(上行消息);
                }
                响应.一步结果.上行消息集.push_back(std::move(上行消息));
            }
        }
    }

    有效输出->已处理 = true;
    有效输出->推进成功 = 响应.推进成功;
    有效输出->被门控阻断 = false;
    有效输出->已执行筹办 =
        本轮执行筹办
        && 响应.一步结果.存在任务推进回执;
    有效输出->已执行方法 = 响应.一步结果.已执行当前步骤方法;
    有效输出->任务完成 =
        响应.一步结果.治理结果.宿主任务新状态 == 枚举_任务状态::完成;
    有效输出->任务失败 =
        响应.一步结果.治理结果.宿主任务新状态 == 枚举_任务状态::失败
        || 响应.一步结果.治理结果.宿主任务新状态 == 枚举_任务状态::无法执行;
    有效输出->需要等待 =
        响应.一步结果.治理结果.宿主任务新状态 == 枚举_任务状态::等待中
        || 响应.一步结果.治理结果.宿主任务新状态 == 枚举_任务状态::挂起;
    有效输出->产生派生需求 = 私有_回报包含派生需求消息(响应);
    有效输出->建议进入收束 =
        响应.一步结果.治理结果.当前下一步去向 == 枚举_任务管理下一步去向::进入收束;
    有效输出->建议界面线程下一轮 =
        响应.一步结果.治理结果.当前下一步去向 == 枚举_任务管理下一步去向::进入运行
        || 响应.一步结果.治理结果.当前下一步去向 == 枚举_任务管理下一步去向::保持运行
        || 响应.一步结果.治理结果.当前下一步去向 == 枚举_任务管理下一步去向::回到重筹办
        || 响应.一步结果.治理结果.当前下一步去向 == 枚举_任务管理下一步去向::绑定方法;
    有效输出->建议自我线程重判 =
        有效输出->产生派生需求
        || 有效输出->任务完成
        || 存在外设承接上行消息;
    有效输出->最新任务控制态 = 响应.最新任务控制态;
    有效输出->最新任务局部运行态 = 响应.最新任务局部运行态;
    有效输出->治理结果 = 响应.一步结果.治理结果;
    有效输出->存在任务推进回执 = 响应.一步结果.存在任务推进回执;
    有效输出->任务推进回执 = 响应.一步结果.当前任务推进回执;
    有效输出->存在方法执行数据 = 响应.一步结果.存在当前步骤方法执行数据;
    有效输出->方法执行数据 = 响应.一步结果.当前步骤方法执行数据;
    有效输出->方法运行结果 = 响应.一步结果.当前步骤方法运行结果;
    if (本轮执行筹办 && 响应.一步结果.存在任务推进回执) {
        有效输出->存在任务筹办情况 = true;
        auto& 情况 = 有效输出->任务筹办情况;
        情况.有效 = true;
        情况.已执行筹办 = true;
        情况.筹办回执 = 响应.一步结果.当前任务推进回执;
        情况.方法运行结果 = 响应.一步结果.当前步骤方法运行结果;
        情况.结果场景 = 响应.一步结果.存在当前步骤方法执行数据
            ? 响应.一步结果.当前步骤方法执行数据.结果场景
            : nullptr;
        情况.建议任务状态 = 情况.筹办回执.建议任务状态;
        情况.建议任务阶段 = 情况.筹办回执.建议任务阶段;
        情况.诊断摘要 = 有效输出->摘要;
    }
    if (本轮执行方法
        && (响应.一步结果.存在当前步骤方法执行数据
            || 响应.一步结果.存在任务推进回执)) {
        有效输出->存在任务执行情况 = true;
        auto& 情况 = 有效输出->任务执行情况;
        情况.有效 = true;
        情况.已执行方法 = 响应.一步结果.已执行当前步骤方法;
        情况.执行回执 = 响应.一步结果.当前任务推进回执;
        情况.执行数据 = 响应.一步结果.当前步骤方法执行数据;
        情况.方法运行结果 = 响应.一步结果.当前步骤方法运行结果;
        情况.输出结果场景 = 响应.一步结果.存在当前步骤方法执行数据
            ? 响应.一步结果.当前步骤方法执行数据.结果场景
            : nullptr;
        情况.建议任务状态 = 响应.一步结果.存在任务推进回执
            ? 情况.执行回执.建议任务状态
            : 情况.执行数据.建议任务状态;
        情况.建议任务阶段 = 响应.一步结果.存在任务推进回执
            ? 情况.执行回执.建议任务阶段
            : 情况.执行数据.建议任务阶段;
        情况.诊断摘要 = 有效输出->摘要;
    }
    有效输出->推进事件列表 = std::move(响应.一步结果.推进事件列表);
    有效输出->上行消息集 = std::move(响应.一步结果.上行消息集);
    有效输出->下一步去向 = 响应.一步结果.治理结果.当前下一步去向;
    有效输出->最近总控结果 = 响应.一步结果.治理结果.最近总控结果;
    有效输出->任务管理上位输入已刷新 = 响应.一步结果.任务管理上位输入已刷新;
    有效输出->任务管理治理触发 = 响应.一步结果.任务管理治理触发;
    if (存在外设承接结果) {
        有效输出->存在外设消息承接结果 = true;
        有效输出->外设消息命中报告 = 外设承接结果.命中报告;
        有效输出->外设观察等待项ID = 外设承接结果.等待项ID;
        有效输出->外设观察报告ID = 外设承接结果.报告ID;
        有效输出->外设观察承接上行消息数 =
            static_cast<std::uint64_t>(外设承接结果.上行消息集.size());
        有效输出->外设消息承接摘要 =
            构造任务管理外设消息承接结果摘要(外设承接结果);
    }
    有效输出->等待原因 = 响应.最新任务局部运行态.当前等待原因;
    有效输出->摘要 = 有效输出->等待原因.empty()
        ? std::string("任务工作项已处理一轮")
        : 有效输出->等待原因;
    if (有效输出->存在任务筹办情况) {
        有效输出->任务筹办情况.诊断摘要 = 有效输出->摘要;
    }
    if (有效输出->存在任务执行情况) {
        有效输出->任务执行情况.诊断摘要 = 有效输出->摘要;
    }
    有效输出->错误码 = 本能动作运行结果值(有效输出->方法运行结果);

    {
        auto& 状态 = 私有_壳状态();
        std::lock_guard<std::mutex> 锁(状态.锁);
        状态.快照.正在执行 = false;
        状态.快照.累计处理工作项数 += 1;
        状态.快照.累计推进次数 += 1;
        if (有效输出->推进成功) {
            状态.快照.累计成功推进数 += 1;
        } else {
            状态.快照.累计失败数 += 1;
        }
        if (有效输出->产生派生需求) {
            状态.快照.累计派生需求数 += 1;
        }
        状态.快照.最近结束时间 = now;
        私有_刷新快照_已加锁(状态, 响应, 管理任务, now);
    }
    return 有效输出->推进成功;
}

bool 读取任务管理工作线程快照(结构_工作线程实例快照* 输出) noexcept
{
    if (!输出) {
        return false;
    }
    auto& 状态 = 私有_壳状态();
    std::lock_guard<std::mutex> 锁(状态.锁);
    *输出 = 状态.快照;
    return true;
}

bool 计算任务管理界面优先级结果(
    const 自我类& 自我对象,
    结构_界面优先级结果* 输出) noexcept
{
    if (!输出) {
        return false;
    }
    auto* 任务 = 自我对象.获取当前主任务();

    *输出 = {};
    输出->当前最高优先级任务 = 任务;
    if (!任务) {
        return false;
    }
    const auto 调度优先级 = 任务类::读取任务调度优先级(任务);
    输出->调度优先级 = 调度优先级 != 0
        ? 调度优先级
        : (任务类::读取任务基准优先级(任务) + 任务类::读取任务局部优先级偏移(任务));
    输出->是否可执行 =
        !任务类::任务状态已终结(任务类::读取任务状态(任务));

    if (auto* 需求 = reinterpret_cast<需求节点*>(任务->主信息.对应需求.指针)) {
        输出->是否安全方向任务 = 需求->主信息.安全权重 >= 需求->主信息.服务权重;
        输出->是否服务方向任务 = 需求->主信息.服务权重 > 需求->主信息.安全权重;
    }
    return true;
}

void 停止任务管理工作线程壳() noexcept
{
    auto& 状态 = 私有_壳状态();
    std::lock_guard<std::mutex> 锁(状态.锁);
    状态.工作线程壳已启动 = false;
    状态.快照.已启动 = false;
    状态.快照.正在执行 = false;
}

} // namespace 任务管理工作线程
